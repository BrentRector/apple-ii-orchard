  43  0000              ; -- External symbols --
  44  0000              ; WBOOTV / IOBYTE_ADDR / CDISK_ADDR / BDOS / TBUFF / TPA now come from cpm22.inc, the
  45  0000              ; single source of truth for the CP/M base page. They used to be re-declared here with
  46  0000              ; identical values, which is the duplicate-definition the repo forbids.
  47  0000              SLOT_INFO_BASE       EQU $F3B8               ; [DOC S&HD 2-26/2-27] $F3B8 is the Disk Count Byte (number of disk controller cards x2);
  48  0000                                                            ; the Card Type Table (SLTTYP) proper starts at $F3B9, with slot S's entry at $F3B8+S
  49  0000                                                            ; (S=1..7). The cold-boot scan indexes this base by E (E=1..7) to read each slot's detected
  50  0000                                                            ; card type. Card type values: 0=no ROM, 1=unknown ROM, 2=Disk II, 3=Apple Comms/CCS 7710A
  51  0000                                                            ; serial, 4=Apple High-Speed Serial / Videx Videoterm / M&R Sup-R-Term / Silentype, 5=Parallel.
  52  0000
  53  0000
  54  0000              ; -- Mid-instruction references (shown inline as cover+offset) --
  55  0000              ;   $FB05 -> CCP_LAUNCH+1       z80 skip idiom: enters the operand of $3E at $FB04
  56  0000              ;   $FB49 -> RPC_TRIGGER_STORE+1     shared instruction tail: $FB49 is reachable code inside the instruction at $FB48
  57  0000              ;   $FEEB -> BIOS_BOOT+1          shared instruction tail: $FEEB is reachable code inside the instruction at $FEEA
  58  0000              ;   $FEEC -> BIOS_BOOT+2          shared instruction tail: $FEEC is reachable code inside the instruction at $FEEA
  59  0000              ;   $FEFA -> DISK_DMAADR+2        shared instruction tail: $FEFA is reachable code inside the instruction at $FEF8
  60  0000              ;   $FEFC -> SECTOR_BLOCK_PATCH+1        shared instruction tail: $FEFC is reachable code inside the instruction at $FEFB
  61  0000              ;   $FF59 -> BIOS_BOOT_13+1       shared instruction tail: $FF59 is reachable code inside the instruction at $FF58
  62  0000
  63  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
  64  0000                  ORG $FA00
  65  FA00                  ENDIF
  66  FA00
  67  FA00              ; ----------------------------------------------------------------------
  68  FA00              ; BIOS_VECTOR (BOOT) -- the CP/M 2.2 BIOS entry jump vector (2.23, 60K, $FA00).
  69  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  70  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  71  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  72  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  73  FA00              ;   Note: 60K cold start is driven from the planted Z-80 reset; BIOS_BOOT ($FEEA)
  74  FA00              ;     NOP-s this $FA00 cold JP after its one run, so $FA03 (WBOOT) is the live
  75  FA00              ;     entry thereafter. See ../BOOT_AND_PATCHING.md section 3c. [RE]
  76  FA00              ; ----------------------------------------------------------------------
  77  FA00              BOOT:
  78  FA00 C3 EA FE             JP BIOS_BOOT
  79  FA03              WBOOT:
  80  FA03 C3 B8 FA             JP BIOS_WBOOT
  81  FA06              CONST:
  82  FA06 C3 10 FB             JP BIOS_CONST
  83  FA09              CONIN:
  84  FA09 C3 1A FB             JP BIOS_CONIN
  85  FA0C              CONOUT:
  86  FA0C C3 4D FB             JP CONOUT_DISPATCH
  87  FA0F              LIST:
  88  FA0F C3 70 FB             JP BIOS_LIST
  89  FA12              PUNCH:
  90  FA12 C3 7F FB             JP BIOS_PUNCH
  91  FA15              READER:
  92  FA15 C3 91 FB             JP BIOS_READER
  93  FA18              HOME:
  94  FA18 C3 75 FE             JP INIT_PASCAL_1_1_1
  95  FA1B              SELDSK:
  96  FA1B C3 97 FE             JP SELDSK_IMPL_1
  97  FA1E              SETTRK:
  98  FA1E C3 80 FE             JP SETTRK_STORE
  99  FA21              SETSEC:
 100  FA21 C3 F4 FB             JP BIOS_SETSEC
 101  FA24              SETDMA:
 102  FA24 C3 F9 FB             JP BIOS_SETDMA
 103  FA27              READ:
 104  FA27 C3 C6 FE             JP SELDSK_IMPL_3
 105  FA2A              WRITE:
 106  FA2A C3 CC FE             JP SELDSK_IMPL_4
 107  FA2D              ; ----------------------------------------------------------------------
 108  FA2D              ; LISTST -- entry 15: return the list device's ready status.
 109  FA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
 110  FA2D              ;   Algorithm: XOR A / RET. A is $00 whatever the printer is doing. Under the
 111  FA2D              ;     CP/M 2.2 convention $00 means NOT ready and $FF means ready, so this
 112  FA2D              ;     reports "not ready" unconditionally.
 113  FA2D              ;     That is the whole of what these two bytes support. WHO consults LISTST, and
 114  FA2D              ;     what they do with the answer, is NOT determinable from this image, and the
 115  FA2D              ;     SoftCard manual set in softcard/reference/ does not document LISTST at all
 116  FA2D              ;     -- so no claim is made here about callers or about anything blocking. Same two bytes in the 2.20-44K and 2.23-44K twins. [RE]
 117  FA2D              ; ----------------------------------------------------------------------
 118  FA2D              LISTST:
 119  FA2D AF                   XOR A
 120  FA2E C9                   RET
 121  FA2F 00                   DEFB    $00
 122  FA30              ; ----------------------------------------------------------------------
 123  FA30              ; SECTRAN -- logical-to-physical sector translate (no-op identity map).
 124  FA30              ;   In:  BC = logical sector, DE = translate-table addr (ignored).
 125  FA30              ;   Out: HL = BC (physical == logical).  Clobbers: HL.
 126  FA30              ;   Algorithm: LD H,B / LD L,C / RET.  The skew is applied off-image by the
 127  FA30              ;     disk producer, so the DPH XLT is null and SECTRAN is the identity. [RE]
 128  FA30              ; ----------------------------------------------------------------------
 129  FA30              SECTRAN:
 130  FA30 60                   LD H,B
 131  FA31 69                   LD L,C
 132  FA32 C9                   RET
 133  FA33              ; ----------------------------------------------------------------------
 134  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array: one 16-byte DPH per logical
 135  FA33              ;   drive 0..3. SELDSK returns DPH_TABLE + 16*drive (SELDSK_IMPL_1, $FEA9).
 136  FA33              ;   Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV, ALV. XLT = 0: no SECTRAN
 137  FA33              ;   translate (SECTRAN above is the identity; the disk producer applies the skew
 138  FA33              ;   off-image). All four drives share one DIRBUF and one DPB.
 139  FA33              ;   The per-drive strides are the DPB's own fields: CSV is CKS = 12 bytes, ALV is
 140  FA33              ;   DSM/8 + 1 = 139/8 + 1 = 18 bytes. [RE]
 141  FA33              ; ----------------------------------------------------------------------
 142  FA33              DPH_TABLE:
 143  FA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS ; drive 0
 143  FA37 00 00 00 00
 143  FA3B FD FE 73 FA
 143  FA3F C5 FF 7D FF
 144  FA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+18 ; drive 1
 144  FA47 00 00 00 00
 144  FA4B FD FE 73 FA
 144  FA4F D1 FF 8F FF
 145  FA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+36 ; drive 2
 145  FA57 00 00 00 00
 145  FA5B FD FE 73 FA
 145  FA5F DD FF A1 FF
 146  FA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+54 ; drive 3
 146  FA67 00 00 00 00
 146  FA6B FD FE 73 FA
 146  FA6F E9 FF B3 FF
 147  FA73              ; DPB -- the shared Disk Parameter Block; all four DPH entries above point here (the
 148  FA73              ;   $73,$FA pointer byte pair in each). Byte-for-byte the same 15 bytes as the 2.23-44K
 149  FA73              ;   twin's DPB, DSM included. Field names are Digital Research's CP/M 2.2 DPB names.
 150  FA73              ;   Not [DOC]-citable from THIS archive -- the SoftCard set bundles DRI's CP/M 2.2
 151  FA73              ;   *Reference Manual*, which documents only BDOS fn 31 (the call that RETURNS a DPB
 152  FA73              ;   pointer), not the block's layout. The layout IS normatively specified by a DRI manual
 153  FA73              ;   not in the box: the CP/M 2.2 *Alteration Guide* (1979), sec. Disk Parameter Tables.
 154  FA73              ;   SoftCard CP/M is licensed DRI CP/M 2.2, so that manual governs this block.
 155  FA73              ;   [DOC CPMAG "Disk Parameter Tables"]  NOTE: the Guide defines every field but NEVER
 156  FA73              ;   spells the acronyms out; the expansions below are the conventional readings. [?]
 157  FA73              DPB:
 158  FA73 20 00        SPT:    DEFW    $0020                    ; Sectors Per Track: counts 128-byte RECORDS, not 256-byte sectors -> 32
 159  FA75 03           BSH:    DEFB    $03                      ; Block SHift: log2(records per block) -> 8 records
 160  FA76 07           BLM:    DEFB    $07                      ; BLock Mask: (records per block) - 1 -> 1 KB blocks
 161  FA77 00           EXM:    DEFB    $00                      ; EXtent Mask
 162  FA78              ; DSM=$8B gives 140 blocks where the file area holds 128; the 2.20 twin's $7F gives 32 + 3 = 35
 163  FA78              ;   tracks exactly. The extra twelve are NOT phantom space: the 2.23 deblock
 164  FA78              ;   (CPMV223-44K/os/CPM_BootLoader_DiskXlate.asm, SM_NOFLUSH at $BCDA) folds any requested track
 165  FA78              ;   >= 35 back by 35, gated on the DPB's DSM byte being $8B. Block 128 -> track 35 -> 0;
 166  FA78              ;   block 139 -> track 37 -> 2. Twelve blocks = 12 KB = tracks 0,1,2 exactly, so blocks 128-139
 167  FA78              ;   ARE the reserved system tracks, addressable through the ordinary file system. The directory
 168  FA78              ;   entry (user $1F, lowercase "cp/m    sys", block map exactly 128-139) is what NAMES them, and
 169  FA78              ;   TWO shipped Microsoft tools write it: CPM60.COM (../CPM60_installer.asm) and COPY.COM /S.
 170  FA78              ;   On a DATA disk the aliasing is the point (12 KB of recovered storage); the entry exists to
 171  FA78              ;   protect a BOOT image. CONSEQUENCE: a disk carrying a boot image but no entry -- every
 172  FA78              ;   2.20-lineage system disk read under 2.23 -- lets the allocator hand out those blocks once
 173  FA78              ;   0-127 are full, and writing there SILENTLY OVERWRITES TRACKS 0-2 rather than failing. A
 174  FA78              ;   non-bootable data disk is not at risk. See docs/CPM_Disk_Creation.md. [RE]
 175  FA78 8B 00        DSM:    DEFW    $008B                    ; Disk Size Max: highest allocation block number: 139 -> 140 blocks
 176  FA7A 2F 00        DRM:    DEFW    $002F                    ; DiRectory Max: highest directory entry number: 47 -> 48 entries
 177  FA7C C0           AL0:    DEFB    $C0                      ; ALlocation bitmap, directory-reserved blocks, high byte -> 2
 178  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 179  FA7E 0C 00        CKS:    DEFW    $000C                    ; ChecKSum: directory checksum bytes
 180  FA80 03 00        OFF:    DEFW    $0003                    ; OFFset: reserved tracks before the file area
 181  FA82              ; [DOC S&HD 2-26/2-27] Cold-boot per-device init loop over the Card Type Table. The Card Type
 182  FA82              ;       Table (SLTTYP) starts at $F3B9, entry = $F3B8+S for slot S; $F3B8 itself is the Disk Count
 183  FA82              ;       Byte. The loop walks $F3B8+DE (DE=7..1 -> $F3BF..$F3B9), reading each slot's detected card
 184  FA82              ;       type and dispatching on it. (This is NOT the IOBYTE_ADDR table -- IOBYTE_ADDR is a single byte at $0003.)
 185  FA82              ; ----------------------------------------------------------------------
 186  FA82              ; PROBE_DEVICES -- cold/warm-boot per-device init loop over the Card Type Table.
 187  FA82              ;   In:  none (walks the SoftCard Card Type Table at z80 $F3B8..).
 188  FA82              ;   Out: config cells updated in place; each present card's init is called.
 189  FA82              ;   Clobbers: A,DE,HL.
 190  FA82              ;   Algorithm: for E = 7 down to 1, read SLTTYP[$F3B8+E]. Value 3 (serial) runs
 191  FA82              ;     SLOT_IO_ADDR then stamps the cell $03/$15; value 4 (Videx-class 80-col)
 192  FA82              ;     runs INIT_PASCAL_1_0 and reclaims the $C800 expansion-ROM window via
 193  FA82              ;     RPC_TRIGGER; value 6 (post-1980 Pascal-1.1 class) runs PLOT_CHAR_RPC
 194  FA82              ;     with the $0DD0 param. [DOC S&HD 2-26/2-27] SLTTYP base at $F3B9, entry
 195  FA82              ;     $F3B8+S; $F3B8 is the Disk Count Byte. Twin of the 2.23-44K PROBE_DEVICES. [RE]
 196  FA82              ; ----------------------------------------------------------------------
 197  FA82              PROBE_DEVICES:
 198  FA82 11 07 00             LD DE,$0007
 199  FA85              ; [DOC S&HD 2-26] Loop body: reads the slot's Card Type Table value at $F3B8+DE. Card type 3
 200  FA85              ;       (Apple Communications / CCS 7710A serial) runs its init and stamps the entry; card type 4
 201  FA85              ;       (Apple High-Speed Serial / Videx Videoterm / M&R Sup-R-Term) takes the decremented branch
 202  FA85              ;       below that reclaims the $C800 firmware window.
 203  FA85              SLOT_SCAN_INIT_1:
 204  FA85 21 B8 F3             LD HL,SLOT_INFO_BASE
 205  FA88 19                   ADD HL,DE
 206  FA89 7E                   LD A,(HL)
 207  FA8A D6 03                SUB $03
 208  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 209  FA8E CD 8A FE             CALL SLOT_IO_ADDR
 210  FA91 36 03                LD (HL),$03
 211  FA93 36 15                LD (HL),$15
 212  FA95              ; [DOC S&HD 2-26] Card-type-4 branch (Apple High-Speed Serial / Videx Videoterm / M&R Sup-R-Term):
 213  FA95              ;       runs INIT_PASCAL_1_0, then reclaims the shared $C800 expansion-ROM window (LD HL,$C800)
 214  FA95              ;       before continuing the per-slot Card Type Table scan. The card-type-2 sub-branch below
 215  FA95              ;       ($FAA3, CP $02 -> type-6) is the post-1980 Pascal-1.1 path NOT documented by the 2.20 manual.
 216  FA95              PROBE_DEVICES_CHK4:
 217  FA95 3D                   DEC A
 218  FA96 20 0B                JR NZ,SLOT_SCAN_INIT_3
 219  FA98 CD 83 FD             CALL INIT_PASCAL_1_0
 220  FA9B 21 00 C8             LD HL,$C800
 221  FA9E CD 45 FB             CALL RPC_TRIGGER
 222  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 223  FAA3              ; [AI] Card-type dispatch continuation: after SUB $03 then DEC A, a remaining value of $02 means the
 224  FAA3              ;       original Card Type Table byte was 6 -- the POST-1980 device-6 / Pascal-1.1 card class that
 225  FAA3              ;       the 2.20 manual does NOT document (2.23 added a $Cn0B Pascal-1.1 probe that reassigns the
 226  FAA3              ;       Videx from type 4 to type 6). Runs PLOT_CHAR_RPC with the $0DD0 parameter. Not manual-backed.
 227  FAA3              SLOT_SCAN_INIT_3:
 228  FAA3 FE 02                CP $02
 229  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 230  FAA7 21 D0 0D             LD HL,$0DD0
 231  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 232  FAAD              ; [DOC S&HD 2-26/2-27] Loop tail of the Card Type Table scan: decrements the slot index E and repeats
 233  FAAD              ;       for all seven Apple expansion slots (S=7..1), returning when done.
 234  FAAD              PROBE_DEVICES_NEXT:
 235  FAAD 1D                   DEC E
 236  FAAE 20 D5                JR NZ,SLOT_SCAN_INIT_1
 237  FAB0 C9                   RET
 238  FAB1              ; ----------------------------------------------------------------------
 239  FAB1              ; SLOT_E000_ADDR -- form a SoftCard I/O address from a device/offset index.
 240  FAB1              ;   In:  E = low offset within the I/O page.  A clobbered.
 241  FAB1              ;   Out: HL = ((E | $E0) << 8) -- an address in z80 $E000-$EFFF = Apple $C000-$CFFF.
 242  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 243  FAB1              ;     page; H = A.  Used to reach keyboard / soft switches / slot I/O.  Twin of the
 244  FAB1              ;     2.23-44K DEVICE_IO_BASE. [RE]
 245  FAB1              ; ----------------------------------------------------------------------
 246  FAB1              SLOT_E000_ADDR:
 247  FAB1 21 00 E0             LD HL,$E000
 248  FAB4 7B                   LD A,E
 249  FAB5 B4                   OR H
 250  FAB6 67                   LD H,A
 251  FAB7              RET_VECTOR:
 252  FAB7 C9                   RET
 253  FAB8              ; [AI] WBOOT (warm boot) entry: resets the Z-80 stack to $0080, re-establishes the 6502 console via
 254  FAB8              ;       RPC, rescans the slots, then reloads/relaunches the CCP. NOTE: the BDOS sentinel at $DC08
 255  FAB8              ;       and BDOS entry $DC06 are 60K-config absolute addresses -- a POST-1980 layout the 2.20 manual
 256  FAB8              ;       (44K/56K only) does NOT document; do not read a manual address into them.
 257  FAB8              ; ----------------------------------------------------------------------
 258  FAB8              ; BIOS_WBOOT (WBOOT) -- CP/M warm boot: re-init console, rebuild page zero, re-enter CCP.
 259  FAB8              ;   In:  none.  Out: does not return (enters the CCP at $D300).  Clobbers: all.
 260  FAB8              ;   Algorithm: SP = default DMA top ($0080); touch the 80-col soft switch (z80 $E051
 261  FAB8              ;     = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run PROBE_DEVICES.
 262  FAB8              ;     Test the resident BDOS sentinel at $DC08 ($DC present = BDOS image intact) to skip
 263  FAB8              ;     the reload; otherwise reload the system through a self-built $000B page-zero bridge.
 264  FAB8              ;   Note: 60K addresses ($DC06/$DC08 BDOS, $D307/$D74E CCP scratch, CCP entry $D300) are
 265  FAB8              ;     the POST-1980 Language-Card layout the 2.20 manual (44K/56K only) does NOT document;
 266  FAB8              ;     do not read a manual address into them. Twin of the 2.23-44K WBOOT (there $9C08/$9300). [RE]
 267  FAB8              ; ----------------------------------------------------------------------
 268  FAB8              BIOS_WBOOT:
 269  FAB8 31 80 00             LD SP,TBUFF
 270  FABB 3A 51 E0             LD A,($E051)
 271  FABE 21 00 0E             LD HL,$0E00
 272  FAC1 CD 45 FB             CALL RPC_TRIGGER
 273  FAC4 CD 82 FA             CALL PROBE_DEVICES
 274  FAC7 3A 08 DC             LD A,($DC08)
 275  FACA FE DC                CP $DC
 276  FACC 28 11                JR Z,PAGEZERO_REBUILD
 277  FACE              ; [DOC S&HD 2-24/2-25] Warm-boot RPC setup: stores the 6502 call target at A$VEC=$F3D0, then loads
 278  FACE              ;       the SoftCard location from Z$CPU=$F3DE (low byte 0, high byte $0ENH for slot N) -- a WRITE
 279  FACE              ;       through that address is the CPU switch back to the 6502. ($000B/$77 here is 60K-specific glue.)
 280  FACE 21 59 FF             LD HL,BIOS_BOOT_13+1
 281  FAD1 22 D0 F3             LD ($F3D0),HL
 282  FAD4 2A DE F3             LD HL,($F3DE)
 283  FAD7 3E 77                LD A,$77
 284  FAD9 32 0B 00             LD ($000B),A
 285  FADC C3 0B 00             JP $000B
 286  FADF              PAGEZERO_REBUILD:
 287  FADF AF                   XOR A
 288  FAE0 32 07 D3             LD ($D307),A
 289  FAE3              ; [AI] Cold-boot page-zero plant: writes JP WBOOT at $0000-$0002 and JP BDOS at $0005-$0007 (the
 290  FAE3              ;       $0000 warm-boot vector and $0005 BDOS entry are SHARED CP/M architecture). The BDOS target
 291  FAE3              ;       $DC06 stored at $0006 -- which also marks top-of-TPA -- is a 60K-config absolute address;
 292  FAE3              ;       the 2.20 manual (44K/56K only) does NOT document this POST-1980 layout, so it is not cited.
 293  FAE3              ; ----------------------------------------------------------------------
 294  FAE3              ; PAGEZERO_REBUILD_HOOKS -- rebuild page zero, then fall into the CCP relaunch.
 295  FAE3              ;   In:  none.  Out: falls into CCP_LAUNCH (CCP entry).  Clobbers: A,HL,BC.
 296  FAE3              ;   Algorithm: plant JP ($C3) at $0000 -> WBOOT (BIOS $FA03) and JP at $0005 -> BDOS
 297  FAE3              ;     ($DC06); clear the two self-modified cold-boot template cells (BOOT_TMPL_IOBYTE/
 298  FAE3              ;     DISK_HSTACT); re-issue SETDMA($0080). The $0000 warm-boot vector and $0005 BDOS
 299  FAE3              ;     entry are SHARED CP/M architecture; the BDOS target $DC06 (also the top-of-TPA
 300  FAE3              ;     marker at $0006) is a 60K-config absolute address, not manual-backed. Twin of
 301  FAE3              ;     the 2.23-44K PAGEZERO_REBUILD_HOOKS. [RE]
 302  FAE3              ; ----------------------------------------------------------------------
 303  FAE3              PAGEZERO_REBUILD_HOOKS:
 304  FAE3 AF                   XOR A
 305  FAE4 32 F6 FE             LD (BOOT_TMPL_IOBYTE),A
 306  FAE7 32 F1 FE             LD (DISK_HSTACT),A
 307  FAEA 3E C3                LD A,$C3
 308  FAEC 32 00 00             LD (WBOOTV),A
 309  FAEF 21 03 FA             LD HL,WBOOT
 310  FAF2 22 01 00             LD ($0001),HL
 311  FAF5 32 05 00             LD (BDOS),A
 312  FAF8 21 06 DC             LD HL,$DC06
 313  FAFB 22 06 00             LD ($0006),HL
 314  FAFE 01 80 00             LD BC,TBUFF
 315  FB01 CD F9 FB             CALL BIOS_SETDMA
 316  FB04              ; ----------------------------------------------------------------------
 317  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, enter the CCP.
 318  FB04              ;   In:  none.  Out: JP $D300 (CCP entry); no return.  Clobbers: A,C.
 319  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $D74E (self-modified operand at
 320  FB04              ;     CCP_LAUNCH+1), pass the current default drive (CDISK_ADDR, $0004) in C, and jump
 321  FB04              ;     to the 60K CCP at $D300 (the 44K twin CCP_LAUNCH entered $9300). [RE]
 322  FB04              ; ----------------------------------------------------------------------
 323  FB04              CCP_LAUNCH:
 324  FB04 3E 01                LD A,$01
 325  FB06 32 4E D7             LD ($D74E),A
 326  FB09 3A 04 00             LD A,(CDISK_ADDR)
 327  FB0C 4F                   LD C,A
 328  FB0D C3 00 D3             JP $D300
 329  FB10              ; [DOC S&HD 2-18/2-19] CONST (console status) BIOS entry: jumps through I/O Vector Table cell 1,
 330  FB10              ;       $F380 (Console Status) -- the routine returns A=$FF if a console character is ready, $00
 331  FB10              ;       otherwise. This cell normally points into the BIOS and is user-patchable.
 332  FB10              ; ----------------------------------------------------------------------
 333  FB10              ; BIOS_CONST (CONST) -- CP/M console status: A=$FF if a char is ready, else $00.
 334  FB10              ;   In:  none.  Out: A=$FF (ready)/$00 (not).  Clobbers: A,HL.
 335  FB10              ;   Algorithm: load the console-status handler from the SoftCard I/O Vector Table
 336  FB10              ;     Console Status cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced
 337  FB10              ;     handler, which returns the status in A. This cell is user-patchable.
 338  FB10              ;     [DOC S&HD 2-18/2-19] Twin of the 2.23-44K CONST. [RE]
 339  FB10              ; ----------------------------------------------------------------------
 340  FB10              BIOS_CONST:
 341  FB10 2A 80 F3             LD HL,($F380)
 342  FB13 E9                   JP (HL)
 343  FB14 3A                   DEFB    $3A
 344  FB15              CONST_VEC_PATCH:
 345  FB15 00 E0 17 9F          DEFB    $00,$E0,$17,$9F,$C9
 345  FB19 C9
 346  FB1A              ; [DOC S&HD 2-17] CONIN (console input) BIOS entry: reads a raw key via CONIN_DISPATCH_IOBYTE, masks the
 347  FB1A              ;       high bit (AND $7F), then walks the Keyboard Character Redefinition Table to translate it.
 348  FB1A              ;       Per the manual the table is at $F3AC; the code seeds HL=$F3AB and INC HL's to the first
 349  FB1A              ;       entry's "from" byte at $F3AC. Up to six 2-byte entries (from-ASCII, to-ASCII, both high bit
 350  FB1A              ;       clear); a byte with the high bit set terminates early (the JP M exit). Applies to TTY:/CRT:.
 351  FB1A              ; ----------------------------------------------------------------------
 352  FB1A              ; BIOS_CONIN (CONIN) -- read a console character: dispatch, then remap the key.
 353  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,HL.
 354  FB1A              ;   Algorithm: CALL CONIN_DISPATCH_IOBYTE to fetch a raw key (routed by the IOBYTE_ADDR CONSOLE
 355  FB1A              ;     field); AND $7F to 7-bit; then walk the Keyboard Character Redefinition Table.
 356  FB1A              ;     Per the manual the table is at $F3AC; the code seeds HL=$F3AB and INC HL's to the
 357  FB1A              ;     first entry. Up to six 2-byte entries (from-ASCII, to-ASCII); a high-bit-set byte
 358  FB1A              ;     terminates early (JP M). On a match returns the redefined 'to' byte, else the raw
 359  FB1A              ;     key. [DOC S&HD 2-17] Twin of the 2.23-44K CONIN remap wrapper. [RE]
 360  FB1A              ; ----------------------------------------------------------------------
 361  FB1A              BIOS_CONIN:
 362  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 363  FB1D E6 7F                AND $7F
 364  FB1F 21 AB F3             LD HL,$F3AB
 365  FB22 06 06                LD B,$06
 366  FB24 4F                   LD C,A
 367  FB25              ; [DOC S&HD 2-17] Keyboard-redefinition scan body: INC past to the "from" byte, test for the
 368  FB25              ;       high-bit-set terminator (JP M exits), else compare the input (in C) and on a match return
 369  FB25              ;       the redefined "to" byte (A=(HL)); loop up to six times via DJNZ.
 370  FB25              KEY_REMAP_SCAN:
 371  FB25 23                   INC HL
 372  FB26 7E                   LD A,(HL)
 373  FB27 23                   INC HL
 374  FB28 B7                   OR A
 375  FB29 FA 31 FB             JP M,KBD_STROBE_CLEAR
 376  FB2C B9                   CP C
 377  FB2D 7E                   LD A,(HL)
 378  FB2E C8                   RET Z
 379  FB2F 10 F4                DJNZ KEY_REMAP_SCAN
 380  FB31              KBD_STROBE_CLEAR:
 381  FB31 79                   LD A,C
 382  FB32 C9                   RET
 383  FB33 11 03 00 C3          DEFB    $11,$03,$00,$C3
 384  FB37              CONIN_HANDLER_VEC:
 385  FB37 39 FB 3A 00          DEFB    $39,$FB,$3A,$00,$E0,$17
 385  FB3B E0 17
 386  FB3D 30 FA                DEFW    SECTRAN
 387  FB3F 32 10 E0 3F          DEFB    $32,$10,$E0,$3F,$1F,$C9
 387  FB43 1F C9
 388  FB45              ; [DOC S&HD 2-24/2-25] RPC dispatch: stores the 6502 subroutine address (in HL) at A$VEC=$F3D0
 389  FB45              ;       (low-high) -- the Z-80->6502 call vector -- before the SoftCard CPU-switch is triggered.
 390  FB45              ;       (The actual switch is a WRITE through Z$CPU=$F3DE; A$VEC just holds the target.)
 391  FB45              ; ----------------------------------------------------------------------
 392  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z-80 RPC.
 393  FB45              ;   In:  HL = 6502 subroutine address; A = trigger value.  Out: per the 6502 service.
 394  FB45              ;   Algorithm: stash HL at A$VEC (z80 $F3D0 = Apple $03D0), the Z-80->6502 call vector,
 395  FB45              ;     then a store through the CPU-switch cell (RPC_TRIGGER_STORE) triggers the actual
 396  FB45              ;     switch. The store address (Z$CPU-derived) is self-modified at boot, so the store
 397  FB45              ;     site is RPC_TRIGGER_STORE+1. [DOC S&HD 2-24/2-25] Twin of the 2.23-44K RPC_TRIGGER. [RE]
 398  FB45              ; ----------------------------------------------------------------------
 399  FB45              RPC_TRIGGER:
 400  FB45 22 D0 F3             LD ($F3D0),HL
 401  FB48              RPC_TRIGGER_STORE:
 402  FB48 32 00 00             LD (WBOOTV),A
 403  FB4B C9                   RET
 404  FB4C              ; ----------------------------------------------------------------------
 405  FB4C              ; CONOUT_SET_C -- console-output entry that first saves the char into C.
 406  FB4C              ;   In:  A = character to emit.  Out: none.  Clobbers: A,C,HL.
 407  FB4C              ;   Algorithm: LD C,A, then fall into CONOUT_DISPATCH. The BIOS CONOUT jump-vector
 408  FB4C              ;     entry ($FA0C) targets CONOUT_DISPATCH+1 (skipping this LD C,A) when C is already
 409  FB4C              ;     set; callers that hold the char in A enter here instead. Twin of the 2.23-44K
 410  FB4C              ;     CONOUT_DISPATCH LD C,A prologue. [RE]
 411  FB4C              ; ----------------------------------------------------------------------
 412  FB4C              CONOUT_SET_C:
 413  FB4C 4F                   LD C,A
 414  FB4D              ; [DOC S&HD 2-18/2-19] CONOUT (console output) dispatch: masks the IOBYTE_ADDR CONSOLE field (bits 0-1).
 415  FB4D              ;       Value 2 = BAT: (RDR: in / LST: out), so console output is routed through I/O Vector Table
 416  FB4D              ;       List Output #1 ($F392); any other value falls through to the screen-function escape processor.
 417  FB4D              ; ----------------------------------------------------------------------
 418  FB4D              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE_ADDR.
 419  FB4D              ;   In:  C = character (from CONOUT_SET_C; the +1 jump-vector entry skips the LD C,A).
 420  FB4D              ;   Out: none.  Clobbers: A,C,HL.
 421  FB4D              ;   Algorithm: read IOBYTE_ADDR ($0003), mask the 2-bit CONSOLE field (AND $03). Value 2 =
 422  FB4D              ;     BAT: (RDR: in / LST: out), so output routes through I/O Vector Table List Output
 423  FB4D              ;     #1 ($F392) via CONOUT_UC1; any other value falls into the screen-function escape
 424  FB4D              ;     processor. [DOC S&HD 2-18/2-19] Twin of the 2.23-44K CONOUT_DISPATCH. [RE]
 425  FB4D              ; ----------------------------------------------------------------------
 426  FB4D              CONOUT_DISPATCH:
 427  FB4D 3A 03 00             LD A,(IOBYTE_ADDR)
 428  FB50 E6 03                AND $03
 429  FB52 FE 02                CP $02
 430  FB54 20 4B                JR NZ,CONOUT_ESC_PROC
 431  FB56              ; [DOC S&HD 2-18/2-19] Jumps through I/O Vector Table List Output #1 cell ($F392) -- used for the
 432  FB56              ;       BAT: console-output case above; the char in C is carried to the line-printer device.
 433  FB56              ; ----------------------------------------------------------------------
 434  FB56              ; CONOUT_UC1 -- console/list output via I/O Vector Table List Output #1 ($F392).
 435  FB56              ;   In:  C = character.  Out: none (JP (HL) into the handler).  Clobbers: A,HL.
 436  FB56              ;   Algorithm: load HL from the List Output #1 cell (z80 $F392 = Apple $0392) and
 437  FB56              ;     JP (HL). Used for the BAT: console-output case and the LPT: LIST case; the char
 438  FB56              ;     in C is carried to the line-printer device. [DOC S&HD 2-18/2-19] [RE]
 439  FB56              ; ----------------------------------------------------------------------
 440  FB56              CONOUT_UC1:
 441  FB56 2A 92 F3             LD HL,($F392)
 442  FB59 E9                   JP (HL)
 443  FB5A              ; [DOC S&HD 2-18/2-19] CONIN dispatch: masks the IOBYTE_ADDR CONSOLE field (bits 0-1). Value 2 (BAT:)
 444  FB5A              ;       -> Reader Input #1 cell $F38A; value 3 (UC1:) -> Console Input #2 cell $F384; values 0/1
 445  FB5A              ;       (TTY:/CRT:) -> Console Input #1 cell $F382. Each is a user-patchable I/O Vector Table cell.
 446  FB5A              ; ----------------------------------------------------------------------
 447  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE_ADDR CONSOLE field.
 448  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 449  FB5A              ;   Algorithm: read IOBYTE_ADDR, mask the CONSOLE field (AND $03). Value 2 (BAT:) -> Reader
 450  FB5A              ;     Input #1 cell $F38A; value 3 (UC1:) -> Console Input #2 cell $F384; values 0/1
 451  FB5A              ;     (TTY:/CRT:) -> Console Input #1 cell $F382; then JP (HL). Each is a user-patchable
 452  FB5A              ;     I/O Vector Table cell. Called by BIOS_CONIN and reused by BIOS_READER.
 453  FB5A              ;     [DOC S&HD 2-18/2-19] Twin of the 2.23-44K CONIN_DISPATCH_IOBYTE. [RE]
 454  FB5A              ; ----------------------------------------------------------------------
 455  FB5A              CONIN_DISPATCH_IOBYTE:
 456  FB5A 3A 03 00             LD A,(IOBYTE_ADDR)
 457  FB5D E6 03                AND $03
 458  FB5F FE 02                CP $02
 459  FB61 2A 84 F3             LD HL,($F384)
 460  FB64 28 06                JR Z,CONIN_UC1
 461  FB66 30 07                JR NC,CONIN_VEC_JP
 462  FB68              ; [DOC S&HD 2-18/2-19] TTY:/CRT: console input via I/O Vector Table Console Input #1 cell ($F382).
 463  FB68              ; ----------------------------------------------------------------------
 464  FB68              ; CONIN_TTY -- TTY:/CRT: console input via I/O Vector Table Console Input #1 ($F382).
 465  FB68              ;   In:  none.  Out: A = character (JP (HL) into the handler).  Clobbers: A,HL.
 466  FB68              ;   Algorithm: load HL from Console Input #1 (z80 $F382 = Apple $0382) and JP (HL).
 467  FB68              ;     Also the READER TTY:/CRT: target. [DOC S&HD 2-18/2-19] [RE]
 468  FB68              ; ----------------------------------------------------------------------
 469  FB68              CONIN_TTY:
 470  FB68 2A 82 F3             LD HL,($F382)
 471  FB6B E9                   JP (HL)
 472  FB6C              ; [DOC S&HD 2-18/2-19] BAT: console input via I/O Vector Table Reader Input #1 cell ($F38A).
 473  FB6C              ; ----------------------------------------------------------------------
 474  FB6C              ; CONIN_UC1 -- BAT:/PTR: input via I/O Vector Table Reader Input #1 ($F38A).
 475  FB6C              ;   In:  none.  Out: A = character (falls into CONIN_VEC_JP -> JP (HL)).  Clobbers: A,HL.
 476  FB6C              ;   Algorithm: load HL from Reader Input #1 (z80 $F38A = Apple $038A) and JP (HL) via
 477  FB6C              ;     CONIN_VEC_JP. Reused by BIOS_READER for the PTR: case. [DOC S&HD 2-18/2-19] [RE]
 478  FB6C              ; ----------------------------------------------------------------------
 479  FB6C              CONIN_UC1:
 480  FB6C 2A 8A F3             LD HL,($F38A)
 481  FB6F              CONIN_VEC_JP:
 482  FB6F E9                   JP (HL)
 483  FB70              ; [DOC S&HD 2-18/2-19] LIST (printer) output: masks the IOBYTE_ADDR LIST field (bits 6-7; 0=TTY:, 1=CRT:,
 484  FB70              ;       2=LPT:, 3=UL1:). TTY:/CRT: return null; LPT: ($80) routes via CONOUT_UC1; UL1: ($C0) jumps
 485  FB70              ;       through the List Output #2 cell ($F394). (List Output #1 is $F392.) Char in C -> list device.
 486  FB70              ; ----------------------------------------------------------------------
 487  FB70              ; BIOS_LIST (LIST) -- printer output, routed by the IOBYTE_ADDR LIST field (bits 6-7).
 488  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 489  FB70              ;   Algorithm: read IOBYTE_ADDR, mask the LIST field (AND $C0). TTY:/CRT: (<$80) return null
 490  FB70              ;     (DISPATCH_NODEV); LPT: ($80) routes via CONOUT_UC1; UL1: ($C0) jumps through List
 491  FB70              ;     Output #2 ($F394). (List Output #1 is $F392.) [DOC S&HD 2-18/2-19] Twin of the
 492  FB70              ;     2.23-44K LIST. [RE]
 493  FB70              ; ----------------------------------------------------------------------
 494  FB70              BIOS_LIST:
 495  FB70 3A 03 00             LD A,(IOBYTE_ADDR)
 496  FB73 E6 C0                AND $C0
 497  FB75 FE 80                CP $80
 498  FB77 38 27                JR C,DISPATCH_NODEV
 499  FB79 28 DB                JR Z,CONOUT_UC1
 500  FB7B 2A 94 F3             LD HL,($F394)
 501  FB7E E9                   JP (HL)
 502  FB7F              ; [DOC S&HD 2-18/2-19] PUNCH output: masks the IOBYTE_ADDR PUNCH field (bits 4-5). Value 1 (PTP:) ->
 503  FB7F              ;       Punch Output #1 cell ($F38E); higher values -> Punch Output #2 cell ($F390); value 0 (TTY:)
 504  FB7F              ;       returns null. The char in C is sent to the selected paper-tape-punch device.
 505  FB7F              ; ----------------------------------------------------------------------
 506  FB7F              ; BIOS_PUNCH (PUNCH) -- punch output, routed by the IOBYTE_ADDR PUNCH field (bits 4-5).
 507  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 508  FB7F              ;   Algorithm: read IOBYTE_ADDR, mask the PUNCH field (AND $30). TTY: (0) returns null
 509  FB7F              ;     (DISPATCH_NODEV); PTP: ($10) -> Punch Output #1 ($F38E) via CONIN_VEC_JP; higher
 510  FB7F              ;     values -> Punch Output #2 ($F390). The char in C goes to the paper-tape-punch
 511  FB7F              ;     device. [DOC S&HD 2-18/2-19] Twin of the 2.23-44K PUNCH. [RE]
 512  FB7F              ; ----------------------------------------------------------------------
 513  FB7F              BIOS_PUNCH:
 514  FB7F 3A 03 00             LD A,(IOBYTE_ADDR)
 515  FB82 E6 30                AND $30
 516  FB84 FE 10                CP $10
 517  FB86 38 18                JR C,DISPATCH_NODEV
 518  FB88 2A 8E F3             LD HL,($F38E)
 519  FB8B 28 E2                JR Z,CONIN_VEC_JP
 520  FB8D 2A 90 F3             LD HL,($F390)
 521  FB90 E9                   JP (HL)
 522  FB91              ; [DOC S&HD 2-18/2-19] READER input: masks the IOBYTE_ADDR READER field (bits 2-3; 0=TTY:, 1=CRT:,
 523  FB91              ;       2=PTR:, 3=UR2:). TTY:/CRT: -> CONIN_TTY (console input); PTR: ($08) -> CONIN_UC1; UR2: ($0C)
 524  FB91              ;       jumps through the Reader Input #2 cell ($F38C). (Reader Input #1 is $F38A.) Char returned in A.
 525  FB91              ; ----------------------------------------------------------------------
 526  FB91              ; BIOS_READER (READER) -- reader input, routed by the IOBYTE_ADDR READER field (bits 2-3).
 527  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 528  FB91              ;   Algorithm: read IOBYTE_ADDR, mask the READER field (AND $0C). TTY:/CRT: (<$08) -> CONIN_TTY;
 529  FB91              ;     PTR: ($08) -> CONIN_UC1; UR2: ($0C) jumps through Reader Input #2 ($F38C). (Reader
 530  FB91              ;     Input #1 is $F38A.) [DOC S&HD 2-18/2-19] Twin of the 2.23-44K READER. [RE]
 531  FB91              ; ----------------------------------------------------------------------
 532  FB91              BIOS_READER:
 533  FB91 3A 03 00             LD A,(IOBYTE_ADDR)
 534  FB94 E6 0C                AND $0C
 535  FB96 FE 08                CP $08
 536  FB98 38 CE                JR C,CONIN_TTY
 537  FB9A 28 D0                JR Z,CONIN_UC1
 538  FB9C 2A 8C F3             LD HL,($F38C)
 539  FB9F E9                   JP (HL)
 540  FBA0              ; ----------------------------------------------------------------------
 541  FBA0              ; DISPATCH_NODEV -- IOBYTE_ADDR field selects no physical device: fall into the filter.
 542  FBA0              ;   In:  reached with carry set (no-device).  Out: enters the screen-function processor
 543  FBA0              ;     (CONOUT_ESC_PROC) with the carry folded into a flag.  Clobbers: A,HL.
 544  FBA0              ;   Algorithm: SCF, then CONOUT_ESC_PROC's SBC A,A turns carry into a 0/$FF flag stored
 545  FBA0              ;     in COL_FLAG ($FEE4). Twin of the 2.23-44K DISPATCH_NODEV. [RE]
 546  FBA0              ; ----------------------------------------------------------------------
 547  FBA0              DISPATCH_NODEV:
 548  FBA0 37                   SCF
 549  FBA1              ; [DOC S&HD 2-14] Console-output screen-function processor. $F3A2 is the Hardware-table lead-in
 550  FBA1              ;       character (zero = no lead-in). Reached for the non-BAT: console path; tests the lead-in to
 551  FBA1              ;       decide whether a multi-byte screen-function sequence is being emitted.
 552  FBA1              ; ----------------------------------------------------------------------
 553  FBA1              ; CONOUT_ESC_PROC -- console-output screen-function / cursor-address processor.
 554  FBA1              ;   In:  C = character; the SBC A,A flag from the caller.  Out: emits or updates cursor
 555  FBA1              ;     state.  Clobbers: A,C,DE,HL.
 556  FBA1              ;   Algorithm: store the entry flag in COL_FLAG ($FEE4). [DOC S&HD 2-14] $F3A2 is the
 557  FBA1              ;     Hardware-table lead-in char (0 = none); if none, emit directly via CONSOLE_PUT_CHAR.
 558  FBA1              ;     Else clear bit 7 of C; if the pending-column counter (COL_PENDING, $FEE5) is nonzero,
 559  FBA1              ;     apply a config-driven column offset ($F396 = SXYOFF, the Software cursor XY offset,
 560  FBA1              ;     high bit selecting X/Y vs Y/X order), else fall into the sequence scanner. Twin of
 561  FBA1              ;     the 2.23-44K CONOUT_FILTER_NOEXPAND path. [RE]
 562  FBA1              ; ----------------------------------------------------------------------
 563  FBA1              CONOUT_ESC_PROC:
 564  FBA1 9F                   SBC A,A
 565  FBA2 21 A2 F3             LD HL,$F3A2
 566  FBA5 6E                   LD L,(HL)
 567  FBA6 2C                   INC L
 568  FBA7 CA A4 FC             JP Z,CONSOLE_PUT_CHAR
 569  FBAA 21 E4 FE             LD HL,COL_FLAG
 570  FBAD 77                   LD (HL),A
 571  FBAE CB B9                RES 7,C
 572  FBB0 23                   INC HL
 573  FBB1 7E                   LD A,(HL)
 574  FBB2 B7                   OR A
 575  FBB3 CA 56 FC             JP Z,CONOUT_SEQ_MATCH
 576  FBB6 35                   DEC (HL)
 577  FBB7              ; [DOC S&HD 2-14] Cursor-address coordinate handling: $F396 is SXYOFF, the Software cursor XY
 578  FBB7              ;       coordinate offset (range 0-127; high bit 0 => Y first then X, high bit 1 => X first then Y).
 579  FBB7 3A 96 F3             LD A,($F396)
 580  FBBA 21 ED FE             LD HL,BIOS_BOOT_1
 581  FBBD 28 0C                JR Z,COORD_SIGN_CHK
 582  FBBF B7                   OR A
 583  FBC0 F2 C6 FB             JP P,COORD_BIAS_SUB
 584  FBC3 2B                   DEC HL
 585  FBC4              ; ----------------------------------------------------------------------
 586  FBC4              ; COORD_MASK7 -- apply a signed config offset to the running column position.
 587  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 588  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 589  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude (COORD_BIAS_SUB entry skips
 590  FBC4              ;     the mask), subtract it from C, store the new column. Twin of the 2.23-44K
 591  FBC4              ;     COL_APPLY_OFFSET. [RE]
 592  FBC4              ; ----------------------------------------------------------------------
 593  FBC4              COORD_MASK7:
 594  FBC4 E6 7F                AND $7F
 595  FBC6              COORD_BIAS_SUB:
 596  FBC6 5F                   LD E,A
 597  FBC7 79                   LD A,C
 598  FBC8 93                   SUB E
 599  FBC9 77                   LD (HL),A
 600  FBCA C9                   RET
 601  FBCB              COORD_SIGN_CHK:
 602  FBCB B7                   OR A
 603  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH
 604  FBCF 2B                   DEC HL
 605  FBD0              ; ----------------------------------------------------------------------
 606  FBD0              ; COL_OFFSET_FROM_WIDTH -- derive the cursor screen coordinate and emit the move sequence.
 607  FBD0              ;   In:  C = column; the BOOT-overlaid base word at (BIOS_BOOT+2).  Out: emits the
 608  FBD0              ;     cursor-move via CONSOLE_PUT_CHAR.  Clobbers: A,B,C,DE,HL.
 609  FBD0              ;   Algorithm: CALL COORD_MASK7 to fold the column, load the base word (BIOS_BOOT+2 =
 610  FBD0              ;     the cold-boot LD SP operand reused as cursor scratch). [DOC S&HD 2-14] $F3A1 is
 611  FBD0              ;     the Hardware cursor XY offset (counterpart of SXYOFF=$F396); its high bit selects
 612  FBD0              ;     X/Y vs Y/X transmission order. Fold in the offset, ADD to form the address, emit
 613  FBD0              ;     with B=7 then B=$0A (CHAR_C_TO_SCREEN). Twin of the 2.23-44K COL_OFFSET_FROM_WIDTH. [RE]
 614  FBD0              ; ----------------------------------------------------------------------
 615  FBD0              COL_OFFSET_FROM_WIDTH:
 616  FBD0 CD C4 FB             CALL COORD_MASK7
 617  FBD3 2A EC FE             LD HL,(BIOS_BOOT+2)
 618  FBD6              ; [DOC S&HD 2-14] $F3A1 is the Hardware cursor XY coordinate offset (the hardware-table counterpart
 619  FBD6              ;       of SXYOFF=$F396); its high bit likewise selects X/Y vs Y/X transmission order to the terminal.
 620  FBD6 3A A1 F3             LD A,($F3A1)
 621  FBD9 B7                   OR A
 622  FBDA F2 E2 FB             JP P,EMIT_CURSOR_MOVE
 623  FBDD E6 7F                AND $7F
 624  FBDF 5D                   LD E,L
 625  FBE0 6C                   LD L,H
 626  FBE1 63                   LD H,E
 627  FBE2              EMIT_CURSOR_MOVE:
 628  FBE2 5F                   LD E,A
 629  FBE3 84                   ADD A,H
 630  FBE4 4F                   LD C,A
 631  FBE5 7B                   LD A,E
 632  FBE6 85                   ADD A,L
 633  FBE7 F5                   PUSH AF
 634  FBE8 06 07                LD B,$07
 635  FBEA CD A4 FC             CALL CONSOLE_PUT_CHAR
 636  FBED F1                   POP AF
 637  FBEE 06 0A                LD B,$0A
 638  FBF0              ; ----------------------------------------------------------------------
 639  FBF0              ; CHAR_C_TO_SCREEN -- tail: move A into C and tail-jump to the screen emitter.
 640  FBF0              ;   In:  A = char/code, B = mode/count code.  Out: JP CONSOLE_PUT_CHAR (no return).
 641  FBF0              ;   Clobbers: A,C.
 642  FBF0              ;   Algorithm: LD C,A / JP CONSOLE_PUT_CHAR. Twin of the 2.23-44K CHAR_C_TO_SCREEN. [RE]
 643  FBF0              ; ----------------------------------------------------------------------
 644  FBF0              CHAR_C_TO_SCREEN:
 645  FBF0 4F                   LD C,A
 646  FBF1 C3 A4 FC             JP CONSOLE_PUT_CHAR
 647  FBF4              ; ----------------------------------------------------------------------
 648  FBF4              ; BIOS_SETSEC (SETSEC) -- set the requested sector for the next disk I/O.
 649  FBF4              ;   In:  C = sector number.  Out: none.  Clobbers: A.
 650  FBF4              ;   Algorithm: store C into the seksec cell BIOS_BOOT+1 ($FEEB = the cold-boot LD SP
 651  FBF4              ;     operand low byte, reused post-boot as the requested-sector cell). The off-image
 652  FBF4              ;     RWTS/deblock is the consumer; this image only WRITES it. Twin of the 2.23-44K
 653  FBF4              ;     SETSEC. [RE]
 654  FBF4              ; ----------------------------------------------------------------------
 655  FBF4              BIOS_SETSEC:
 656  FBF4 79                   LD A,C
 657  FBF5 32 EB FE             LD (BIOS_BOOT+1),A
 658  FBF8 C9                   RET
 659  FBF9              ; ----------------------------------------------------------------------
 660  FBF9              ; BIOS_SETDMA (SETDMA) -- set the DMA (record transfer) address.
 661  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 662  FBF9              ;   Out: none.  Clobbers: none.
 663  FBF9              ;   Algorithm: store BC into the dmaadr cell (DISK_DMAADR+2 = $FEFA, the operand region
 664  FBF9              ;     of the cold-boot template store). The off-image deblock copy uses dmaadr as the
 665  FBF9              ;     host<->record transfer endpoint. Twin of the 2.23-44K SETDMA. [RE]
 666  FBF9              ; ----------------------------------------------------------------------
 667  FBF9              BIOS_SETDMA:
 668  FBF9 ED 43 FA FE          LD (DISK_DMAADR+2),BC
 669  FBFD C9                   RET
 670  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 671  FC56              ; ----------------------------------------------------------------------
 672  FC56              ; CONOUT_SEQ_MATCH -- scan the Software Screen Function Table for a control code.
 673  FC56              ;   In:  A/B = mode code; C = incoming char.  Out: emits a mapped function or the raw
 674  FC56              ;     char.  Clobbers: A,B,C,DE,HL.
 675  FC56              ;   Algorithm: read COL_STATE ($FEE6). [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the Software
 676  FC56              ;     function lead-in char (0 = none); if set and it matches C, mark pending ($80) and
 677  FC56              ;     return; else control codes (<=$1F) fall into the SSFTAB scan (SEQ_TBL_SCAN),
 678  FC56              ;     printables emit directly via CONSOLE_PUT_CHAR. Twin of the 2.23-44K SETDMA_1. [RE]
 679  FC56              ; ----------------------------------------------------------------------
 680  FC56              CONOUT_SEQ_MATCH:
 681  FC56 47                   LD B,A
 682  FC57 21 E6 FE             LD HL,COL_STATE
 683  FC5A 7E                   LD A,(HL)
 684  FC5B 5F                   LD E,A
 685  FC5C B7                   OR A
 686  FC5D 20 12                JR NZ,SEQ_TBL_SCAN
 687  FC5F              ; [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the Software function lead-in character (zero = no lead-in).
 688  FC5F              ;       If set and it matches the incoming byte (in C), a lead-in has been consumed: marks pending
 689  FC5F              ;       ($80) and returns; otherwise drops through to scan the Software Screen Function Table.
 690  FC5F 3A 97 F3             LD A,($F397)
 691  FC62 B7                   OR A
 692  FC63 28 06                JR Z,SEQ_PRINTABLE_CHK
 693  FC65 B9                   CP C
 694  FC66 20 03                JR NZ,SEQ_PRINTABLE_CHK
 695  FC68 36 80                LD (HL),$80
 696  FC6A C9                   RET
 697  FC6B              SEQ_PRINTABLE_CHK:
 698  FC6B 3E 1F                LD A,$1F
 699  FC6D B9                   CP C
 700  FC6E DA A4 FC             JP C,CONSOLE_PUT_CHAR
 701  FC71              ; [DOC S&HD 2-14/2-15] Scans the Software Screen Function Table for a matching control code. SSFTAB
 702  FC71              ;       (function #1) is at $F398; here HL=$F3A0 (function #9) and B=9 walks the 9 entries downward
 703  FC71              ;       to $F398, matching the incoming code against the 9 configurable screen functions. The
 704  FC71              ;       9-entry span $F398..$F3A0 implies fn#9 sits at $F3A0 (resolving the manual's fn8/fn9 ambiguity).
 705  FC71              ; ----------------------------------------------------------------------
 706  FC71              ; SEQ_TBL_SCAN -- match the incoming code against the 9 Software Screen Functions.
 707  FC71              ;   In:  C = control code, E = lead-in XOR mask.  Out: emits the matched function's
 708  FC71              ;     sequence or the raw char.  Clobbers: A,B,C,DE,HL.
 709  FC71              ;   Algorithm: [DOC S&HD 2-14/2-15] SSFTAB fn#1 is at $F398; HL=$F3A0 (fn#9), B=9 walks
 710  FC71              ;     the 9 entries downward to $F398, comparing each configured function code (XOR E)
 711  FC71              ;     against C. No match -> emit raw (CONSOLE_PUT_CHAR); match -> SEQ_EMIT_ENTRY. Twin
 712  FC71              ;     of the 2.23-44K SETDMA_3 SSFTAB scan. [RE]
 713  FC71              ; ----------------------------------------------------------------------
 714  FC71              SEQ_TBL_SCAN:
 715  FC71 21 A0 F3             LD HL,$F3A0
 716  FC74 06 09                LD B,$09
 717  FC76              CHECK_UNIT_DEFAULT_3:
 718  FC76 7E                   LD A,(HL)
 719  FC77 B7                   OR A
 720  FC78 28 04                JR Z,SEQ_TBL_NEXT
 721  FC7A AB                   XOR E
 722  FC7B B9                   CP C
 723  FC7C 28 05                JR Z,SEQ_EMIT_ENTRY
 724  FC7E              SEQ_TBL_NEXT:
 725  FC7E 2B                   DEC HL
 726  FC7F 10 F5                DJNZ CHECK_UNIT_DEFAULT_3
 727  FC81 18 21                JR CONSOLE_PUT_CHAR
 728  FC83              ; ----------------------------------------------------------------------
 729  FC83              ; SEQ_EMIT_ENTRY -- emit a matched screen function's replacement sequence.
 730  FC83              ;   In:  HL -> the matched SSFTAB entry; C carries state.  Out: emits via CONSOLE_PUT_CHAR;
 731  FC83              ;     may set the pending flag.  Clobbers: A,B,C,DE,HL.
 732  FC83              ;   Algorithm: index +$0B to the paired replacement byte; high bit set marks a hardware
 733  FC83              ;     lead-in ($F3A2, [DOC S&HD 2-14/2-15]) emitted ahead of the byte with B=7; then
 734  FC83              ;     SEQ_SET_PENDING may store $02 into COL_PENDING ($FEE5). Twin of the 2.23-44K
 735  FC83              ;     SETDMA_6/SETDMA_7. [RE]
 736  FC83              ; ----------------------------------------------------------------------
 737  FC83              SEQ_EMIT_ENTRY:
 738  FC83 11 0B 00             LD DE,$000B
 739  FC86 19                   ADD HL,DE
 740  FC87 7E                   LD A,(HL)
 741  FC88 B7                   OR A
 742  FC89 4F                   LD C,A
 743  FC8A F2 9A FC             JP P,SEQ_SET_PENDING
 744  FC8D E6 7F                AND $7F
 745  FC8F 4F                   LD C,A
 746  FC90 C5                   PUSH BC
 747  FC91              ; [DOC S&HD 2-14/2-15] Emits the matched function's Hardware-table lead-in: $F3A2 is the Hardware
 748  FC91              ;       lead-in character, sent ahead of the hardware screen-function byte to the terminal.
 749  FC91 3A A2 F3             LD A,($F3A2)
 750  FC94 06 07                LD B,$07
 751  FC96 CD F0 FB             CALL CHAR_C_TO_SCREEN
 752  FC99 C1                   POP BC
 753  FC9A              SEQ_SET_PENDING:
 754  FC9A 78                   LD A,B
 755  FC9B FE 07                CP $07
 756  FC9D 20 05                JR NZ,CONSOLE_PUT_CHAR
 757  FC9F 3E 02                LD A,$02
 758  FCA1 32 E5 FE             LD (COL_PENDING),A
 759  FCA4              ; [DOC S&HD 2-18/2-19] Console-output emit tail: loads HL from one of the two I/O Vector Table
 760  FCA4              ;       Console Output cells -- $F388 (Console Output #2) if the mode flag at COL_FLAG is 0, else
 761  FCA4              ;       $F386 (Console Output #1) -- and falls into the JP (HL). Output #1 serves TTY:/CRT:; Output
 762  FCA4              ;       #2 serves UC1:. These are user-patchable cells that carry the char in C to the console device.
 763  FCA4              ; ----------------------------------------------------------------------
 764  FCA4              ; CONSOLE_PUT_CHAR -- emit tail: JP (HL) into the selected Console Output vector.
 765  FCA4              ;   In:  C = character; COL_FLAG ($FEE4) selects the output cell.  Out: none (JP (HL)).
 766  FCA4              ;   Clobbers: A,HL.
 767  FCA4              ;   Algorithm: clear COL_STATE ($FEE6); load HL from one of the two I/O Vector Table
 768  FCA4              ;     Console Output cells -- $F388 (Output #2, UC1:) if COL_FLAG is 0, else $F386
 769  FCA4              ;     (Output #1, TTY:/CRT:) -- and JP (HL) (CONOUT_PHYS_JP). User-patchable cells that
 770  FCA4              ;     carry the char in C to the console device. [DOC S&HD 2-18/2-19] Twin of the
 771  FCA4              ;     2.23-44K SCREEN_EMIT. [RE]
 772  FCA4              ; ----------------------------------------------------------------------
 773  FCA4              CONSOLE_PUT_CHAR:
 774  FCA4 AF                   XOR A
 775  FCA5 32 E6 FE             LD (COL_STATE),A
 776  FCA8 3A E4 FE             LD A,(COL_FLAG)
 777  FCAB B7                   OR A
 778  FCAC 2A 88 F3             LD HL,($F388)
 779  FCAF 28 03                JR Z,CONOUT_PHYS_JP
 780  FCB1 2A 86 F3             LD HL,($F386)
 781  FCB4              ; [DOC S&HD 2-18/2-19] JP (HL) into the selected Console Output vector ($F386 #1 or $F388 #2)
 782  FCB4              ;       resolved above -- the user-patchable I/O Vector Table cell that drives console output.
 783  FCB4              CONOUT_PHYS_JP:
 784  FCB4 E9                   JP (HL)
 785  FCB5 11 03 00 C3          DEFB    $11,$03,$00,$C3
 786  FCB9              CONOUT_HANDLER_VEC:
 787  FCB9 BB FC 2A E7          DEFB    $BB,$FC,$2A,$E7,$FE,$3A,$E9,$FE,$77,$CD,$E2,$FC,$2A,$28,$F0,$3A
 787  FCBD FE 3A E9 FE
 787  FCC1 77 CD E2 FC
 787  FCC5 2A 28 F0 3A
 788  FCC9 24 F0 5F 16          DEFB    $24,$F0,$5F,$16,$F0,$19,$22,$E7,$FE,$7E,$32,$E9
 788  FCCD F0 19 22 E7
 788  FCD1 FE 7E 32 E9
 789  FCD5 FE FE                DEFW    BIOS_BOOT_8
 790  FCD7 E0 38 02 EE          DEFB    $E0,$38,$02,$EE,$20,$E6,$3F,$F6,$40,$77,$C9,$78,$B7,$28,$0B,$21
 790  FCDB 20 E6 3F F6
 790  FCDF 40 77 C9 78
 790  FCE3 B7 28 0B 21
 791  FCE7 45 FB                DEFW    RPC_TRIGGER

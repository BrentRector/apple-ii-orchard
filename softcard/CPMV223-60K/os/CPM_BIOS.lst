  16  0000              ;
  17  0000              ; ===========================================================================
  18  0000              ; 60K BIOS  -- the UNPATCHED TEMPLATE as shipped inside CPM60.COM
  19  0000              ; ===========================================================================
  20  0000              ; This is the BIOS exactly as it sits in the CPM60.COM installer payload (COM
  21  0000              ; offset 0x2600, ORG $FA00) and on the disk's system tracks. It is the canonical
  22  0000              ; *source* form: assembling it reproduces those 1536 bytes byte-for-byte, and it
  23  0000              ; is the BIOS input to the CPM60.COM build.
  24  0000              ;
  25  0000              ; It is NOT quite what a booted image shows. The 6502 boot loader only COPIES the
  26  0000              ; BIOS into the Language Card; it does not patch it. Instead the Z-80 cold-boot
  27  0000              ; routine BIOS_BOOT ($FEEA) runs ONCE at cold start and self-modifies ~a few dozen
  28  0000              ; bytes -- most visibly NOP-ing the $FA00 cold-boot JP here (JP BIOS_BOOT), since
  29  0000              ; on the 60K system cold start is driven from the planted Z-80 reset; it also
  30  0000              ; binds the console/RPC vectors ($FB37/$FCB9/$FB4A) to the installed card type.
  31  0000              ; After it runs, the one-shot cold-boot region ($FEEA-$FF8D) is dead and the
  32  0000              ; running system reuses it as scratch (so a captured snapshot shows ~147 bytes of
  33  0000              ; $E5/$FF fill there -- those are NOT patches). What each self-mod does and why is
  34  0000              ; catalogued in ../BOOT_AND_PATCHING.md section 3c. (BDOS is byte-identical in COM
  35  0000              ; and booted; the CCP's only delta was the private-stack scratch at $DB5C.)
  36  0000              ; ===========================================================================
  37  0000
  38  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
  39  0000                  DEVICE NOSLOT64K
  40  0000                  ENDIF
  41  0000
  42  0000              ; -- External symbols --
  43  0000              WBOOTV            EQU $0000               ; Warm-boot vector — JP WBOOT in BIOS. Touching it causes a CP/M warm boot.
  44  0000              IOBYTE_ADDR               EQU $0003               ; [DOC S&HD 2-18] IOBYTE_ADDR: logical-to-physical device map at $0003 -- four 2-bit fields,
  45  0000                                                            ; CONSOLE (bits 0-1), READER (bits 2-3), PUNCH (bits 4-5), LIST (bits 6-7); set via STAT or
  46  0000                                                            ; BDOS funcs 7/8. Each field's value selects which I/O Vector Table entry (#1 vs #2) is used.
  47  0000              CDISK_ADDR                EQU $0004               ; Current drive (low nibble: 0=A, 1=B, ..., 15=P) and current user (high nibble, 0-15).
  48  0000              BDOS             EQU $0005               ; BDOS call vector — JP BDOS_ENTRY. Programs use CALL $0005 to invoke BDOS. Word at $0006 is also the top-of-TPA marker.
  49  0000              TBUFF          EQU $0080               ; Default 128-byte DMA buffer. BDOS cold-init / DRV_ALLRESET (fn 13) set the DMA address here and WBOOT re-issues SETDMA($0080); sector/record I/O moves 128 bytes through it. At program load this same buffer doubles as the command tail: the first byte ($0080) holds the tail length (0-127) and the characters follow at $0081 (CMDLINE).
  50  0000              TPA            EQU $0100               ; Start of Transient Program Area. .COM files load here and execute starting at $0100.
  51  0000              SLOT_INFO_BASE       EQU $F3B8               ; [DOC S&HD 2-26/2-27] $F3B8 is the Disk Count Byte (number of disk controller cards x2);
  52  0000                                                            ; the Card Type Table (SLTTYP) proper starts at $F3B9, with slot S's entry at $F3B8+S
  53  0000                                                            ; (S=1..7). The cold-boot scan indexes this base by E (E=1..7) to read each slot's detected
  54  0000                                                            ; card type. Card type values: 0=no ROM, 1=unknown ROM, 2=Disk II, 3=Apple Comms/CCS 7710A
  55  0000                                                            ; serial, 4=Apple High-Speed Serial / Videx Videoterm / M&R Sup-R-Term / Silentype, 5=Parallel.
  56  0000
  57  0000
  58  0000              ; -- Mid-instruction references (shown inline as cover+offset) --
  59  0000              ;   $FB05 -> CCP_LAUNCH+1       z80 skip idiom: enters the operand of $3E at $FB04
  60  0000              ;   $FB49 -> RPC_TRIGGER_STORE+1     shared instruction tail: $FB49 is reachable code inside the instruction at $FB48
  61  0000              ;   $FEEB -> BIOS_BOOT+1          shared instruction tail: $FEEB is reachable code inside the instruction at $FEEA
  62  0000              ;   $FEEC -> BIOS_BOOT+2          shared instruction tail: $FEEC is reachable code inside the instruction at $FEEA
  63  0000              ;   $FEFA -> DISK_DMAADR+2        shared instruction tail: $FEFA is reachable code inside the instruction at $FEF8
  64  0000              ;   $FEFC -> SECTOR_BLOCK_PATCH+1        shared instruction tail: $FEFC is reachable code inside the instruction at $FEFB
  65  0000              ;   $FF59 -> BIOS_BOOT_13+1       shared instruction tail: $FF59 is reachable code inside the instruction at $FF58
  66  0000
  67  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
  68  0000                  ORG $FA00
  69  FA00                  ENDIF
  70  FA00
  71  FA00              ; ----------------------------------------------------------------------
  72  FA00              ; BIOS_VECTOR (BOOT) -- the CP/M 2.2 BIOS entry jump vector (2.23, 60K, $FA00).
  73  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  74  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  75  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  76  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  77  FA00              ;   Note: 60K cold start is driven from the planted Z-80 reset; BIOS_BOOT ($FEEA)
  78  FA00              ;     NOP-s this $FA00 cold JP after its one run, so $FA03 (WBOOT) is the live
  79  FA00              ;     entry thereafter. See ../BOOT_AND_PATCHING.md section 3c. [RE]
  80  FA00              ; ----------------------------------------------------------------------
  81  FA00              BOOT:
  82  FA00 C3 EA FE             JP BIOS_BOOT
  83  FA03              WBOOT:
  84  FA03 C3 B8 FA             JP BIOS_WBOOT
  85  FA06              CONST:
  86  FA06 C3 10 FB             JP BIOS_CONST
  87  FA09              CONIN:
  88  FA09 C3 1A FB             JP BIOS_CONIN
  89  FA0C              CONOUT:
  90  FA0C C3 4D FB             JP CONOUT_DISPATCH
  91  FA0F              LIST:
  92  FA0F C3 70 FB             JP BIOS_LIST
  93  FA12              PUNCH:
  94  FA12 C3 7F FB             JP BIOS_PUNCH
  95  FA15              READER:
  96  FA15 C3 91 FB             JP BIOS_READER
  97  FA18              HOME:
  98  FA18 C3 75 FE             JP INIT_PASCAL_1_1_1
  99  FA1B              SELDSK:
 100  FA1B C3 97 FE             JP SELDSK_IMPL_1
 101  FA1E              SETTRK:
 102  FA1E C3 80 FE             JP SETTRK_STORE
 103  FA21              SETSEC:
 104  FA21 C3 F4 FB             JP BIOS_SETSEC
 105  FA24              SETDMA:
 106  FA24 C3 F9 FB             JP BIOS_SETDMA
 107  FA27              READ:
 108  FA27 C3 C6 FE             JP SELDSK_IMPL_3
 109  FA2A              WRITE:
 110  FA2A C3 CC FE             JP SELDSK_IMPL_4
 111  FA2D              ; ----------------------------------------------------------------------
 112  FA2D              ; LISTST -- entry 15: return the list device's ready status.
 113  FA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
 114  FA2D              ;   Algorithm: XOR A / RET. A is $00 whatever the printer is doing. Under the
 115  FA2D              ;     CP/M 2.2 convention $00 means NOT ready and $FF means ready, so this
 116  FA2D              ;     reports "not ready" unconditionally.
 117  FA2D              ;     That is the whole of what these two bytes support. WHO consults LISTST, and
 118  FA2D              ;     what they do with the answer, is NOT determinable from this image, and the
 119  FA2D              ;     SoftCard manual set in softcard/reference/ does not document LISTST at all
 120  FA2D              ;     -- so no claim is made here about callers or about anything blocking. Same two bytes in the 2.20-44K and 2.23-44K twins. [RE]
 121  FA2D              ; ----------------------------------------------------------------------
 122  FA2D              LISTST:
 123  FA2D AF                   XOR A
 124  FA2E C9                   RET
 125  FA2F 00                   DEFB    $00
 126  FA30              ; ----------------------------------------------------------------------
 127  FA30              ; SECTRAN -- logical-to-physical sector translate (no-op identity map).
 128  FA30              ;   In:  BC = logical sector, DE = translate-table addr (ignored).
 129  FA30              ;   Out: HL = BC (physical == logical).  Clobbers: HL.
 130  FA30              ;   Algorithm: LD H,B / LD L,C / RET.  The skew is applied off-image by the
 131  FA30              ;     disk producer, so the DPH XLT is null and SECTRAN is the identity. [RE]
 132  FA30              ; ----------------------------------------------------------------------
 133  FA30              SECTRAN:
 134  FA30 60                   LD H,B
 135  FA31 69                   LD L,C
 136  FA32 C9                   RET
 137  FA33              ; ----------------------------------------------------------------------
 138  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array: one 16-byte DPH per logical
 139  FA33              ;   drive 0..3. SELDSK returns DPH_TABLE + 16*drive (SELDSK_IMPL_1, $FEA9).
 140  FA33              ;   Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV, ALV. XLT = 0: no SECTRAN
 141  FA33              ;   translate (SECTRAN above is the identity; the disk producer applies the skew
 142  FA33              ;   off-image). All four drives share one DIRBUF and one DPB.
 143  FA33              ;   The per-drive strides are the DPB's own fields: CSV is CKS = 12 bytes, ALV is
 144  FA33              ;   DSM/8 + 1 = 139/8 + 1 = 18 bytes. [RE]
 145  FA33              ; ----------------------------------------------------------------------
 146  FA33              DPH_TABLE:
 147  FA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS ; drive 0
 147  FA37 00 00 00 00
 147  FA3B FD FE 73 FA
 147  FA3F C5 FF 7D FF
 148  FA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+18 ; drive 1
 148  FA47 00 00 00 00
 148  FA4B FD FE 73 FA
 148  FA4F D1 FF 8F FF
 149  FA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+36 ; drive 2
 149  FA57 00 00 00 00
 149  FA5B FD FE 73 FA
 149  FA5F DD FF A1 FF
 150  FA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+54 ; drive 3
 150  FA67 00 00 00 00
 150  FA6B FD FE 73 FA
 150  FA6F E9 FF B3 FF
 151  FA73              ; DPB -- the shared Disk Parameter Block; all four DPH entries above point here (the
 152  FA73              ;   $73,$FA pointer byte pair in each). Byte-for-byte the same 15 bytes as the 2.23-44K
 153  FA73              ;   twin's DPB, DSM included. Field names are Digital Research's CP/M 2.2 DPB names.
 154  FA73              ;   Not [DOC]-citable from THIS archive -- the SoftCard set bundles DRI's CP/M 2.2
 155  FA73              ;   *Reference Manual*, which documents only BDOS fn 31 (the call that RETURNS a DPB
 156  FA73              ;   pointer), not the block's layout. The layout IS normatively specified by a DRI manual
 157  FA73              ;   not in the box: the CP/M 2.2 *Alteration Guide* (1979), sec. Disk Parameter Tables.
 158  FA73              ;   SoftCard CP/M is licensed DRI CP/M 2.2, so that manual governs this block.
 159  FA73              ;   [DOC CPMAG "Disk Parameter Tables"]  NOTE: the Guide defines every field but NEVER
 160  FA73              ;   spells the acronyms out; the expansions below are the conventional readings. [?]
 161  FA73              DPB:
 162  FA73 20 00        SPT:    DEFW    $0020                    ; Sectors Per Track: counts 128-byte RECORDS, not 256-byte sectors -> 32
 163  FA75 03           BSH:    DEFB    $03                      ; Block SHift: log2(records per block) -> 8 records
 164  FA76 07           BLM:    DEFB    $07                      ; BLock Mask: (records per block) - 1 -> 1 KB blocks
 165  FA77 00           EXM:    DEFB    $00                      ; EXtent Mask
 166  FA78              ; DSM=$8B gives 140 blocks where the file area holds 128; the 2.20 twin's $7F gives 32 + 3 = 35
 167  FA78              ;   tracks exactly. The extra twelve are NOT phantom space: the 2.23 deblock
 168  FA78              ;   (CPMV223-44K/os/CPM_BootLoader_DiskXlate.asm, SM_NOFLUSH at $BCDA) folds any requested track
 169  FA78              ;   >= 35 back by 35, gated on the DPB's DSM byte being $8B. Block 128 -> track 35 -> 0;
 170  FA78              ;   block 139 -> track 37 -> 2. Twelve blocks = 12 KB = tracks 0,1,2 exactly, so blocks 128-139
 171  FA78              ;   ARE the reserved system tracks, addressable through the ordinary file system. The directory
 172  FA78              ;   entry (user $1F, lowercase "cp/m    sys", block map exactly 128-139) is what NAMES them, and
 173  FA78              ;   TWO shipped Microsoft tools write it: CPM60.COM (../CPM60_installer.asm) and COPY.COM /S.
 174  FA78              ;   CONSEQUENCE: a disk with no such entry lets the allocator hand out those blocks once 0-127
 175  FA78              ;   are full, and writing there SILENTLY OVERWRITES TRACKS 0-2 rather than failing.
 176  FA78              ;   See docs/CPM_Disk_Creation.md. [RE]
 177  FA78 8B 00        DSM:    DEFW    $008B                    ; Disk Size Max: highest allocation block number: 139 -> 140 blocks
 178  FA7A 2F 00        DRM:    DEFW    $002F                    ; DiRectory Max: highest directory entry number: 47 -> 48 entries
 179  FA7C C0           AL0:    DEFB    $C0                      ; ALlocation bitmap, directory-reserved blocks, high byte -> 2
 180  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 181  FA7E 0C 00        CKS:    DEFW    $000C                    ; ChecKSum: directory checksum bytes
 182  FA80 03 00        OFF:    DEFW    $0003                    ; OFFset: reserved tracks before the file area
 183  FA82              ; [DOC S&HD 2-26/2-27] Cold-boot per-device init loop over the Card Type Table. The Card Type
 184  FA82              ;       Table (SLTTYP) starts at $F3B9, entry = $F3B8+S for slot S; $F3B8 itself is the Disk Count
 185  FA82              ;       Byte. The loop walks $F3B8+DE (DE=7..1 -> $F3BF..$F3B9), reading each slot's detected card
 186  FA82              ;       type and dispatching on it. (This is NOT the IOBYTE_ADDR table -- IOBYTE_ADDR is a single byte at $0003.)
 187  FA82              ; ----------------------------------------------------------------------
 188  FA82              ; PROBE_DEVICES -- cold/warm-boot per-device init loop over the Card Type Table.
 189  FA82              ;   In:  none (walks the SoftCard Card Type Table at z80 $F3B8..).
 190  FA82              ;   Out: config cells updated in place; each present card's init is called.
 191  FA82              ;   Clobbers: A,DE,HL.
 192  FA82              ;   Algorithm: for E = 7 down to 1, read SLTTYP[$F3B8+E]. Value 3 (serial) runs
 193  FA82              ;     SLOT_IO_ADDR then stamps the cell $03/$15; value 4 (Videx-class 80-col)
 194  FA82              ;     runs INIT_PASCAL_1_0 and reclaims the $C800 expansion-ROM window via
 195  FA82              ;     RPC_TRIGGER; value 6 (post-1980 Pascal-1.1 class) runs PLOT_CHAR_RPC
 196  FA82              ;     with the $0DD0 param. [DOC S&HD 2-26/2-27] SLTTYP base at $F3B9, entry
 197  FA82              ;     $F3B8+S; $F3B8 is the Disk Count Byte. Twin of the 2.23-44K PROBE_DEVICES. [RE]
 198  FA82              ; ----------------------------------------------------------------------
 199  FA82              PROBE_DEVICES:
 200  FA82 11 07 00             LD DE,$0007
 201  FA85              ; [DOC S&HD 2-26] Loop body: reads the slot's Card Type Table value at $F3B8+DE. Card type 3
 202  FA85              ;       (Apple Communications / CCS 7710A serial) runs its init and stamps the entry; card type 4
 203  FA85              ;       (Apple High-Speed Serial / Videx Videoterm / M&R Sup-R-Term) takes the decremented branch
 204  FA85              ;       below that reclaims the $C800 firmware window.
 205  FA85              SLOT_SCAN_INIT_1:
 206  FA85 21 B8 F3             LD HL,SLOT_INFO_BASE
 207  FA88 19                   ADD HL,DE
 208  FA89 7E                   LD A,(HL)
 209  FA8A D6 03                SUB $03
 210  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 211  FA8E CD 8A FE             CALL SLOT_IO_ADDR
 212  FA91 36 03                LD (HL),$03
 213  FA93 36 15                LD (HL),$15
 214  FA95              ; [DOC S&HD 2-26] Card-type-4 branch (Apple High-Speed Serial / Videx Videoterm / M&R Sup-R-Term):
 215  FA95              ;       runs INIT_PASCAL_1_0, then reclaims the shared $C800 expansion-ROM window (LD HL,$C800)
 216  FA95              ;       before continuing the per-slot Card Type Table scan. The card-type-2 sub-branch below
 217  FA95              ;       ($FAA3, CP $02 -> type-6) is the post-1980 Pascal-1.1 path NOT documented by the 2.20 manual.
 218  FA95              PROBE_DEVICES_CHK4:
 219  FA95 3D                   DEC A
 220  FA96 20 0B                JR NZ,SLOT_SCAN_INIT_3
 221  FA98 CD 83 FD             CALL INIT_PASCAL_1_0
 222  FA9B 21 00 C8             LD HL,$C800
 223  FA9E CD 45 FB             CALL RPC_TRIGGER
 224  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 225  FAA3              ; [AI] Card-type dispatch continuation: after SUB $03 then DEC A, a remaining value of $02 means the
 226  FAA3              ;       original Card Type Table byte was 6 -- the POST-1980 device-6 / Pascal-1.1 card class that
 227  FAA3              ;       the 2.20 manual does NOT document (2.23 added a $Cn0B Pascal-1.1 probe that reassigns the
 228  FAA3              ;       Videx from type 4 to type 6). Runs PLOT_CHAR_RPC with the $0DD0 parameter. Not manual-backed.
 229  FAA3              SLOT_SCAN_INIT_3:
 230  FAA3 FE 02                CP $02
 231  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 232  FAA7 21 D0 0D             LD HL,$0DD0
 233  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 234  FAAD              ; [DOC S&HD 2-26/2-27] Loop tail of the Card Type Table scan: decrements the slot index E and repeats
 235  FAAD              ;       for all seven Apple expansion slots (S=7..1), returning when done.
 236  FAAD              PROBE_DEVICES_NEXT:
 237  FAAD 1D                   DEC E
 238  FAAE 20 D5                JR NZ,SLOT_SCAN_INIT_1
 239  FAB0 C9                   RET
 240  FAB1              ; ----------------------------------------------------------------------
 241  FAB1              ; SLOT_E000_ADDR -- form a SoftCard I/O address from a device/offset index.
 242  FAB1              ;   In:  E = low offset within the I/O page.  A clobbered.
 243  FAB1              ;   Out: HL = ((E | $E0) << 8) -- an address in z80 $E000-$EFFF = Apple $C000-$CFFF.
 244  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 245  FAB1              ;     page; H = A.  Used to reach keyboard / soft switches / slot I/O.  Twin of the
 246  FAB1              ;     2.23-44K DEVICE_IO_BASE. [RE]
 247  FAB1              ; ----------------------------------------------------------------------
 248  FAB1              SLOT_E000_ADDR:
 249  FAB1 21 00 E0             LD HL,$E000
 250  FAB4 7B                   LD A,E
 251  FAB5 B4                   OR H
 252  FAB6 67                   LD H,A
 253  FAB7              RET_VECTOR:
 254  FAB7 C9                   RET
 255  FAB8              ; [AI] WBOOT (warm boot) entry: resets the Z-80 stack to $0080, re-establishes the 6502 console via
 256  FAB8              ;       RPC, rescans the slots, then reloads/relaunches the CCP. NOTE: the BDOS sentinel at $DC08
 257  FAB8              ;       and BDOS entry $DC06 are 60K-config absolute addresses -- a POST-1980 layout the 2.20 manual
 258  FAB8              ;       (44K/56K only) does NOT document; do not read a manual address into them.
 259  FAB8              ; ----------------------------------------------------------------------
 260  FAB8              ; BIOS_WBOOT (WBOOT) -- CP/M warm boot: re-init console, rebuild page zero, re-enter CCP.
 261  FAB8              ;   In:  none.  Out: does not return (enters the CCP at $D300).  Clobbers: all.
 262  FAB8              ;   Algorithm: SP = default DMA top ($0080); touch the 80-col soft switch (z80 $E051
 263  FAB8              ;     = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run PROBE_DEVICES.
 264  FAB8              ;     Test the resident BDOS sentinel at $DC08 ($DC present = BDOS image intact) to skip
 265  FAB8              ;     the reload; otherwise reload the system through a self-built $000B page-zero bridge.
 266  FAB8              ;   Note: 60K addresses ($DC06/$DC08 BDOS, $D307/$D74E CCP scratch, CCP entry $D300) are
 267  FAB8              ;     the POST-1980 Language-Card layout the 2.20 manual (44K/56K only) does NOT document;
 268  FAB8              ;     do not read a manual address into them. Twin of the 2.23-44K WBOOT (there $9C08/$9300). [RE]
 269  FAB8              ; ----------------------------------------------------------------------
 270  FAB8              BIOS_WBOOT:
 271  FAB8 31 80 00             LD SP,TBUFF
 272  FABB 3A 51 E0             LD A,($E051)
 273  FABE 21 00 0E             LD HL,$0E00
 274  FAC1 CD 45 FB             CALL RPC_TRIGGER
 275  FAC4 CD 82 FA             CALL PROBE_DEVICES
 276  FAC7 3A 08 DC             LD A,($DC08)
 277  FACA FE DC                CP $DC
 278  FACC 28 11                JR Z,PAGEZERO_REBUILD
 279  FACE              ; [DOC S&HD 2-24/2-25] Warm-boot RPC setup: stores the 6502 call target at A$VEC=$F3D0, then loads
 280  FACE              ;       the SoftCard location from Z$CPU=$F3DE (low byte 0, high byte $0ENH for slot N) -- a WRITE
 281  FACE              ;       through that address is the CPU switch back to the 6502. ($000B/$77 here is 60K-specific glue.)
 282  FACE 21 59 FF             LD HL,BIOS_BOOT_13+1
 283  FAD1 22 D0 F3             LD ($F3D0),HL
 284  FAD4 2A DE F3             LD HL,($F3DE)
 285  FAD7 3E 77                LD A,$77
 286  FAD9 32 0B 00             LD ($000B),A
 287  FADC C3 0B 00             JP $000B
 288  FADF              PAGEZERO_REBUILD:
 289  FADF AF                   XOR A
 290  FAE0 32 07 D3             LD ($D307),A
 291  FAE3              ; [AI] Cold-boot page-zero plant: writes JP WBOOT at $0000-$0002 and JP BDOS at $0005-$0007 (the
 292  FAE3              ;       $0000 warm-boot vector and $0005 BDOS entry are SHARED CP/M architecture). The BDOS target
 293  FAE3              ;       $DC06 stored at $0006 -- which also marks top-of-TPA -- is a 60K-config absolute address;
 294  FAE3              ;       the 2.20 manual (44K/56K only) does NOT document this POST-1980 layout, so it is not cited.
 295  FAE3              ; ----------------------------------------------------------------------
 296  FAE3              ; PAGEZERO_REBUILD_HOOKS -- rebuild page zero, then fall into the CCP relaunch.
 297  FAE3              ;   In:  none.  Out: falls into CCP_LAUNCH (CCP entry).  Clobbers: A,HL,BC.
 298  FAE3              ;   Algorithm: plant JP ($C3) at $0000 -> WBOOT (BIOS $FA03) and JP at $0005 -> BDOS
 299  FAE3              ;     ($DC06); clear the two self-modified cold-boot template cells (BOOT_TMPL_IOBYTE/
 300  FAE3              ;     DISK_HSTACT); re-issue SETDMA($0080). The $0000 warm-boot vector and $0005 BDOS
 301  FAE3              ;     entry are SHARED CP/M architecture; the BDOS target $DC06 (also the top-of-TPA
 302  FAE3              ;     marker at $0006) is a 60K-config absolute address, not manual-backed. Twin of
 303  FAE3              ;     the 2.23-44K PAGEZERO_REBUILD_HOOKS. [RE]
 304  FAE3              ; ----------------------------------------------------------------------
 305  FAE3              PAGEZERO_REBUILD_HOOKS:
 306  FAE3 AF                   XOR A
 307  FAE4 32 F6 FE             LD (BOOT_TMPL_IOBYTE),A
 308  FAE7 32 F1 FE             LD (DISK_HSTACT),A
 309  FAEA 3E C3                LD A,$C3
 310  FAEC 32 00 00             LD (WBOOTV),A
 311  FAEF 21 03 FA             LD HL,WBOOT
 312  FAF2 22 01 00             LD ($0001),HL
 313  FAF5 32 05 00             LD (BDOS),A
 314  FAF8 21 06 DC             LD HL,$DC06
 315  FAFB 22 06 00             LD ($0006),HL
 316  FAFE 01 80 00             LD BC,TBUFF
 317  FB01 CD F9 FB             CALL BIOS_SETDMA
 318  FB04              ; ----------------------------------------------------------------------
 319  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, enter the CCP.
 320  FB04              ;   In:  none.  Out: JP $D300 (CCP entry); no return.  Clobbers: A,C.
 321  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $D74E (self-modified operand at
 322  FB04              ;     CCP_LAUNCH+1), pass the current default drive (CDISK_ADDR, $0004) in C, and jump
 323  FB04              ;     to the 60K CCP at $D300 (the 44K twin CCP_LAUNCH entered $9300). [RE]
 324  FB04              ; ----------------------------------------------------------------------
 325  FB04              CCP_LAUNCH:
 326  FB04 3E 01                LD A,$01
 327  FB06 32 4E D7             LD ($D74E),A
 328  FB09 3A 04 00             LD A,(CDISK_ADDR)
 329  FB0C 4F                   LD C,A
 330  FB0D C3 00 D3             JP $D300
 331  FB10              ; [DOC S&HD 2-18/2-19] CONST (console status) BIOS entry: jumps through I/O Vector Table cell 1,
 332  FB10              ;       $F380 (Console Status) -- the routine returns A=$FF if a console character is ready, $00
 333  FB10              ;       otherwise. This cell normally points into the BIOS and is user-patchable.
 334  FB10              ; ----------------------------------------------------------------------
 335  FB10              ; BIOS_CONST (CONST) -- CP/M console status: A=$FF if a char is ready, else $00.
 336  FB10              ;   In:  none.  Out: A=$FF (ready)/$00 (not).  Clobbers: A,HL.
 337  FB10              ;   Algorithm: load the console-status handler from the SoftCard I/O Vector Table
 338  FB10              ;     Console Status cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced
 339  FB10              ;     handler, which returns the status in A. This cell is user-patchable.
 340  FB10              ;     [DOC S&HD 2-18/2-19] Twin of the 2.23-44K CONST. [RE]
 341  FB10              ; ----------------------------------------------------------------------
 342  FB10              BIOS_CONST:
 343  FB10 2A 80 F3             LD HL,($F380)
 344  FB13 E9                   JP (HL)
 345  FB14 3A                   DEFB    $3A
 346  FB15              CONST_VEC_PATCH:
 347  FB15 00 E0 17 9F          DEFB    $00,$E0,$17,$9F,$C9
 347  FB19 C9
 348  FB1A              ; [DOC S&HD 2-17] CONIN (console input) BIOS entry: reads a raw key via CONIN_DISPATCH_IOBYTE, masks the
 349  FB1A              ;       high bit (AND $7F), then walks the Keyboard Character Redefinition Table to translate it.
 350  FB1A              ;       Per the manual the table is at $F3AC; the code seeds HL=$F3AB and INC HL's to the first
 351  FB1A              ;       entry's "from" byte at $F3AC. Up to six 2-byte entries (from-ASCII, to-ASCII, both high bit
 352  FB1A              ;       clear); a byte with the high bit set terminates early (the JP M exit). Applies to TTY:/CRT:.
 353  FB1A              ; ----------------------------------------------------------------------
 354  FB1A              ; BIOS_CONIN (CONIN) -- read a console character: dispatch, then remap the key.
 355  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,HL.
 356  FB1A              ;   Algorithm: CALL CONIN_DISPATCH_IOBYTE to fetch a raw key (routed by the IOBYTE_ADDR CONSOLE
 357  FB1A              ;     field); AND $7F to 7-bit; then walk the Keyboard Character Redefinition Table.
 358  FB1A              ;     Per the manual the table is at $F3AC; the code seeds HL=$F3AB and INC HL's to the
 359  FB1A              ;     first entry. Up to six 2-byte entries (from-ASCII, to-ASCII); a high-bit-set byte
 360  FB1A              ;     terminates early (JP M). On a match returns the redefined 'to' byte, else the raw
 361  FB1A              ;     key. [DOC S&HD 2-17] Twin of the 2.23-44K CONIN remap wrapper. [RE]
 362  FB1A              ; ----------------------------------------------------------------------
 363  FB1A              BIOS_CONIN:
 364  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 365  FB1D E6 7F                AND $7F
 366  FB1F 21 AB F3             LD HL,$F3AB
 367  FB22 06 06                LD B,$06
 368  FB24 4F                   LD C,A
 369  FB25              ; [DOC S&HD 2-17] Keyboard-redefinition scan body: INC past to the "from" byte, test for the
 370  FB25              ;       high-bit-set terminator (JP M exits), else compare the input (in C) and on a match return
 371  FB25              ;       the redefined "to" byte (A=(HL)); loop up to six times via DJNZ.
 372  FB25              KEY_REMAP_SCAN:
 373  FB25 23                   INC HL
 374  FB26 7E                   LD A,(HL)
 375  FB27 23                   INC HL
 376  FB28 B7                   OR A
 377  FB29 FA 31 FB             JP M,KBD_STROBE_CLEAR
 378  FB2C B9                   CP C
 379  FB2D 7E                   LD A,(HL)
 380  FB2E C8                   RET Z
 381  FB2F 10 F4                DJNZ KEY_REMAP_SCAN
 382  FB31              KBD_STROBE_CLEAR:
 383  FB31 79                   LD A,C
 384  FB32 C9                   RET
 385  FB33 11 03 00 C3          DEFB    $11,$03,$00,$C3
 386  FB37              CONIN_HANDLER_VEC:
 387  FB37 39 FB 3A 00          DEFB    $39,$FB,$3A,$00,$E0,$17
 387  FB3B E0 17
 388  FB3D 30 FA                DEFW    SECTRAN
 389  FB3F 32 10 E0 3F          DEFB    $32,$10,$E0,$3F,$1F,$C9
 389  FB43 1F C9
 390  FB45              ; [DOC S&HD 2-24/2-25] RPC dispatch: stores the 6502 subroutine address (in HL) at A$VEC=$F3D0
 391  FB45              ;       (low-high) -- the Z-80->6502 call vector -- before the SoftCard CPU-switch is triggered.
 392  FB45              ;       (The actual switch is a WRITE through Z$CPU=$F3DE; A$VEC just holds the target.)
 393  FB45              ; ----------------------------------------------------------------------
 394  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z-80 RPC.
 395  FB45              ;   In:  HL = 6502 subroutine address; A = trigger value.  Out: per the 6502 service.
 396  FB45              ;   Algorithm: stash HL at A$VEC (z80 $F3D0 = Apple $03D0), the Z-80->6502 call vector,
 397  FB45              ;     then a store through the CPU-switch cell (RPC_TRIGGER_STORE) triggers the actual
 398  FB45              ;     switch. The store address (Z$CPU-derived) is self-modified at boot, so the store
 399  FB45              ;     site is RPC_TRIGGER_STORE+1. [DOC S&HD 2-24/2-25] Twin of the 2.23-44K RPC_TRIGGER. [RE]
 400  FB45              ; ----------------------------------------------------------------------
 401  FB45              RPC_TRIGGER:
 402  FB45 22 D0 F3             LD ($F3D0),HL
 403  FB48              RPC_TRIGGER_STORE:
 404  FB48 32 00 00             LD (WBOOTV),A
 405  FB4B C9                   RET
 406  FB4C              ; ----------------------------------------------------------------------
 407  FB4C              ; CONOUT_SET_C -- console-output entry that first saves the char into C.
 408  FB4C              ;   In:  A = character to emit.  Out: none.  Clobbers: A,C,HL.
 409  FB4C              ;   Algorithm: LD C,A, then fall into CONOUT_DISPATCH. The BIOS CONOUT jump-vector
 410  FB4C              ;     entry ($FA0C) targets CONOUT_DISPATCH+1 (skipping this LD C,A) when C is already
 411  FB4C              ;     set; callers that hold the char in A enter here instead. Twin of the 2.23-44K
 412  FB4C              ;     CONOUT_DISPATCH LD C,A prologue. [RE]
 413  FB4C              ; ----------------------------------------------------------------------
 414  FB4C              CONOUT_SET_C:
 415  FB4C 4F                   LD C,A
 416  FB4D              ; [DOC S&HD 2-18/2-19] CONOUT (console output) dispatch: masks the IOBYTE_ADDR CONSOLE field (bits 0-1).
 417  FB4D              ;       Value 2 = BAT: (RDR: in / LST: out), so console output is routed through I/O Vector Table
 418  FB4D              ;       List Output #1 ($F392); any other value falls through to the screen-function escape processor.
 419  FB4D              ; ----------------------------------------------------------------------
 420  FB4D              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE_ADDR.
 421  FB4D              ;   In:  C = character (from CONOUT_SET_C; the +1 jump-vector entry skips the LD C,A).
 422  FB4D              ;   Out: none.  Clobbers: A,C,HL.
 423  FB4D              ;   Algorithm: read IOBYTE_ADDR ($0003), mask the 2-bit CONSOLE field (AND $03). Value 2 =
 424  FB4D              ;     BAT: (RDR: in / LST: out), so output routes through I/O Vector Table List Output
 425  FB4D              ;     #1 ($F392) via CONOUT_UC1; any other value falls into the screen-function escape
 426  FB4D              ;     processor. [DOC S&HD 2-18/2-19] Twin of the 2.23-44K CONOUT_DISPATCH. [RE]
 427  FB4D              ; ----------------------------------------------------------------------
 428  FB4D              CONOUT_DISPATCH:
 429  FB4D 3A 03 00             LD A,(IOBYTE_ADDR)
 430  FB50 E6 03                AND $03
 431  FB52 FE 02                CP $02
 432  FB54 20 4B                JR NZ,CONOUT_ESC_PROC
 433  FB56              ; [DOC S&HD 2-18/2-19] Jumps through I/O Vector Table List Output #1 cell ($F392) -- used for the
 434  FB56              ;       BAT: console-output case above; the char in C is carried to the line-printer device.
 435  FB56              ; ----------------------------------------------------------------------
 436  FB56              ; CONOUT_UC1 -- console/list output via I/O Vector Table List Output #1 ($F392).
 437  FB56              ;   In:  C = character.  Out: none (JP (HL) into the handler).  Clobbers: A,HL.
 438  FB56              ;   Algorithm: load HL from the List Output #1 cell (z80 $F392 = Apple $0392) and
 439  FB56              ;     JP (HL). Used for the BAT: console-output case and the LPT: LIST case; the char
 440  FB56              ;     in C is carried to the line-printer device. [DOC S&HD 2-18/2-19] [RE]
 441  FB56              ; ----------------------------------------------------------------------
 442  FB56              CONOUT_UC1:
 443  FB56 2A 92 F3             LD HL,($F392)
 444  FB59 E9                   JP (HL)
 445  FB5A              ; [DOC S&HD 2-18/2-19] CONIN dispatch: masks the IOBYTE_ADDR CONSOLE field (bits 0-1). Value 2 (BAT:)
 446  FB5A              ;       -> Reader Input #1 cell $F38A; value 3 (UC1:) -> Console Input #2 cell $F384; values 0/1
 447  FB5A              ;       (TTY:/CRT:) -> Console Input #1 cell $F382. Each is a user-patchable I/O Vector Table cell.
 448  FB5A              ; ----------------------------------------------------------------------
 449  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE_ADDR CONSOLE field.
 450  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 451  FB5A              ;   Algorithm: read IOBYTE_ADDR, mask the CONSOLE field (AND $03). Value 2 (BAT:) -> Reader
 452  FB5A              ;     Input #1 cell $F38A; value 3 (UC1:) -> Console Input #2 cell $F384; values 0/1
 453  FB5A              ;     (TTY:/CRT:) -> Console Input #1 cell $F382; then JP (HL). Each is a user-patchable
 454  FB5A              ;     I/O Vector Table cell. Called by BIOS_CONIN and reused by BIOS_READER.
 455  FB5A              ;     [DOC S&HD 2-18/2-19] Twin of the 2.23-44K CONIN_DISPATCH_IOBYTE. [RE]
 456  FB5A              ; ----------------------------------------------------------------------
 457  FB5A              CONIN_DISPATCH_IOBYTE:
 458  FB5A 3A 03 00             LD A,(IOBYTE_ADDR)
 459  FB5D E6 03                AND $03
 460  FB5F FE 02                CP $02
 461  FB61 2A 84 F3             LD HL,($F384)
 462  FB64 28 06                JR Z,CONIN_UC1
 463  FB66 30 07                JR NC,CONIN_VEC_JP
 464  FB68              ; [DOC S&HD 2-18/2-19] TTY:/CRT: console input via I/O Vector Table Console Input #1 cell ($F382).
 465  FB68              ; ----------------------------------------------------------------------
 466  FB68              ; CONIN_TTY -- TTY:/CRT: console input via I/O Vector Table Console Input #1 ($F382).
 467  FB68              ;   In:  none.  Out: A = character (JP (HL) into the handler).  Clobbers: A,HL.
 468  FB68              ;   Algorithm: load HL from Console Input #1 (z80 $F382 = Apple $0382) and JP (HL).
 469  FB68              ;     Also the READER TTY:/CRT: target. [DOC S&HD 2-18/2-19] [RE]
 470  FB68              ; ----------------------------------------------------------------------
 471  FB68              CONIN_TTY:
 472  FB68 2A 82 F3             LD HL,($F382)
 473  FB6B E9                   JP (HL)
 474  FB6C              ; [DOC S&HD 2-18/2-19] BAT: console input via I/O Vector Table Reader Input #1 cell ($F38A).
 475  FB6C              ; ----------------------------------------------------------------------
 476  FB6C              ; CONIN_UC1 -- BAT:/PTR: input via I/O Vector Table Reader Input #1 ($F38A).
 477  FB6C              ;   In:  none.  Out: A = character (falls into CONIN_VEC_JP -> JP (HL)).  Clobbers: A,HL.
 478  FB6C              ;   Algorithm: load HL from Reader Input #1 (z80 $F38A = Apple $038A) and JP (HL) via
 479  FB6C              ;     CONIN_VEC_JP. Reused by BIOS_READER for the PTR: case. [DOC S&HD 2-18/2-19] [RE]
 480  FB6C              ; ----------------------------------------------------------------------
 481  FB6C              CONIN_UC1:
 482  FB6C 2A 8A F3             LD HL,($F38A)
 483  FB6F              CONIN_VEC_JP:
 484  FB6F E9                   JP (HL)
 485  FB70              ; [DOC S&HD 2-18/2-19] LIST (printer) output: masks the IOBYTE_ADDR LIST field (bits 6-7; 0=TTY:, 1=CRT:,
 486  FB70              ;       2=LPT:, 3=UL1:). TTY:/CRT: return null; LPT: ($80) routes via CONOUT_UC1; UL1: ($C0) jumps
 487  FB70              ;       through the List Output #2 cell ($F394). (List Output #1 is $F392.) Char in C -> list device.
 488  FB70              ; ----------------------------------------------------------------------
 489  FB70              ; BIOS_LIST (LIST) -- printer output, routed by the IOBYTE_ADDR LIST field (bits 6-7).
 490  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 491  FB70              ;   Algorithm: read IOBYTE_ADDR, mask the LIST field (AND $C0). TTY:/CRT: (<$80) return null
 492  FB70              ;     (DISPATCH_NODEV); LPT: ($80) routes via CONOUT_UC1; UL1: ($C0) jumps through List
 493  FB70              ;     Output #2 ($F394). (List Output #1 is $F392.) [DOC S&HD 2-18/2-19] Twin of the
 494  FB70              ;     2.23-44K LIST. [RE]
 495  FB70              ; ----------------------------------------------------------------------
 496  FB70              BIOS_LIST:
 497  FB70 3A 03 00             LD A,(IOBYTE_ADDR)
 498  FB73 E6 C0                AND $C0
 499  FB75 FE 80                CP $80
 500  FB77 38 27                JR C,DISPATCH_NODEV
 501  FB79 28 DB                JR Z,CONOUT_UC1
 502  FB7B 2A 94 F3             LD HL,($F394)
 503  FB7E E9                   JP (HL)
 504  FB7F              ; [DOC S&HD 2-18/2-19] PUNCH output: masks the IOBYTE_ADDR PUNCH field (bits 4-5). Value 1 (PTP:) ->
 505  FB7F              ;       Punch Output #1 cell ($F38E); higher values -> Punch Output #2 cell ($F390); value 0 (TTY:)
 506  FB7F              ;       returns null. The char in C is sent to the selected paper-tape-punch device.
 507  FB7F              ; ----------------------------------------------------------------------
 508  FB7F              ; BIOS_PUNCH (PUNCH) -- punch output, routed by the IOBYTE_ADDR PUNCH field (bits 4-5).
 509  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 510  FB7F              ;   Algorithm: read IOBYTE_ADDR, mask the PUNCH field (AND $30). TTY: (0) returns null
 511  FB7F              ;     (DISPATCH_NODEV); PTP: ($10) -> Punch Output #1 ($F38E) via CONIN_VEC_JP; higher
 512  FB7F              ;     values -> Punch Output #2 ($F390). The char in C goes to the paper-tape-punch
 513  FB7F              ;     device. [DOC S&HD 2-18/2-19] Twin of the 2.23-44K PUNCH. [RE]
 514  FB7F              ; ----------------------------------------------------------------------
 515  FB7F              BIOS_PUNCH:
 516  FB7F 3A 03 00             LD A,(IOBYTE_ADDR)
 517  FB82 E6 30                AND $30
 518  FB84 FE 10                CP $10
 519  FB86 38 18                JR C,DISPATCH_NODEV
 520  FB88 2A 8E F3             LD HL,($F38E)
 521  FB8B 28 E2                JR Z,CONIN_VEC_JP
 522  FB8D 2A 90 F3             LD HL,($F390)
 523  FB90 E9                   JP (HL)
 524  FB91              ; [DOC S&HD 2-18/2-19] READER input: masks the IOBYTE_ADDR READER field (bits 2-3; 0=TTY:, 1=CRT:,
 525  FB91              ;       2=PTR:, 3=UR2:). TTY:/CRT: -> CONIN_TTY (console input); PTR: ($08) -> CONIN_UC1; UR2: ($0C)
 526  FB91              ;       jumps through the Reader Input #2 cell ($F38C). (Reader Input #1 is $F38A.) Char returned in A.
 527  FB91              ; ----------------------------------------------------------------------
 528  FB91              ; BIOS_READER (READER) -- reader input, routed by the IOBYTE_ADDR READER field (bits 2-3).
 529  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 530  FB91              ;   Algorithm: read IOBYTE_ADDR, mask the READER field (AND $0C). TTY:/CRT: (<$08) -> CONIN_TTY;
 531  FB91              ;     PTR: ($08) -> CONIN_UC1; UR2: ($0C) jumps through Reader Input #2 ($F38C). (Reader
 532  FB91              ;     Input #1 is $F38A.) [DOC S&HD 2-18/2-19] Twin of the 2.23-44K READER. [RE]
 533  FB91              ; ----------------------------------------------------------------------
 534  FB91              BIOS_READER:
 535  FB91 3A 03 00             LD A,(IOBYTE_ADDR)
 536  FB94 E6 0C                AND $0C
 537  FB96 FE 08                CP $08
 538  FB98 38 CE                JR C,CONIN_TTY
 539  FB9A 28 D0                JR Z,CONIN_UC1
 540  FB9C 2A 8C F3             LD HL,($F38C)
 541  FB9F E9                   JP (HL)
 542  FBA0              ; ----------------------------------------------------------------------
 543  FBA0              ; DISPATCH_NODEV -- IOBYTE_ADDR field selects no physical device: fall into the filter.
 544  FBA0              ;   In:  reached with carry set (no-device).  Out: enters the screen-function processor
 545  FBA0              ;     (CONOUT_ESC_PROC) with the carry folded into a flag.  Clobbers: A,HL.
 546  FBA0              ;   Algorithm: SCF, then CONOUT_ESC_PROC's SBC A,A turns carry into a 0/$FF flag stored
 547  FBA0              ;     in COL_FLAG ($FEE4). Twin of the 2.23-44K DISPATCH_NODEV. [RE]
 548  FBA0              ; ----------------------------------------------------------------------
 549  FBA0              DISPATCH_NODEV:
 550  FBA0 37                   SCF
 551  FBA1              ; [DOC S&HD 2-14] Console-output screen-function processor. $F3A2 is the Hardware-table lead-in
 552  FBA1              ;       character (zero = no lead-in). Reached for the non-BAT: console path; tests the lead-in to
 553  FBA1              ;       decide whether a multi-byte screen-function sequence is being emitted.
 554  FBA1              ; ----------------------------------------------------------------------
 555  FBA1              ; CONOUT_ESC_PROC -- console-output screen-function / cursor-address processor.
 556  FBA1              ;   In:  C = character; the SBC A,A flag from the caller.  Out: emits or updates cursor
 557  FBA1              ;     state.  Clobbers: A,C,DE,HL.
 558  FBA1              ;   Algorithm: store the entry flag in COL_FLAG ($FEE4). [DOC S&HD 2-14] $F3A2 is the
 559  FBA1              ;     Hardware-table lead-in char (0 = none); if none, emit directly via CONSOLE_PUT_CHAR.
 560  FBA1              ;     Else clear bit 7 of C; if the pending-column counter (COL_PENDING, $FEE5) is nonzero,
 561  FBA1              ;     apply a config-driven column offset ($F396 = SXYOFF, the Software cursor XY offset,
 562  FBA1              ;     high bit selecting X/Y vs Y/X order), else fall into the sequence scanner. Twin of
 563  FBA1              ;     the 2.23-44K CONOUT_FILTER_NOEXPAND path. [RE]
 564  FBA1              ; ----------------------------------------------------------------------
 565  FBA1              CONOUT_ESC_PROC:
 566  FBA1 9F                   SBC A,A
 567  FBA2 21 A2 F3             LD HL,$F3A2
 568  FBA5 6E                   LD L,(HL)
 569  FBA6 2C                   INC L
 570  FBA7 CA A4 FC             JP Z,CONSOLE_PUT_CHAR
 571  FBAA 21 E4 FE             LD HL,COL_FLAG
 572  FBAD 77                   LD (HL),A
 573  FBAE CB B9                RES 7,C
 574  FBB0 23                   INC HL
 575  FBB1 7E                   LD A,(HL)
 576  FBB2 B7                   OR A
 577  FBB3 CA 56 FC             JP Z,CONOUT_SEQ_MATCH
 578  FBB6 35                   DEC (HL)
 579  FBB7              ; [DOC S&HD 2-14] Cursor-address coordinate handling: $F396 is SXYOFF, the Software cursor XY
 580  FBB7              ;       coordinate offset (range 0-127; high bit 0 => Y first then X, high bit 1 => X first then Y).
 581  FBB7 3A 96 F3             LD A,($F396)
 582  FBBA 21 ED FE             LD HL,BIOS_BOOT_1
 583  FBBD 28 0C                JR Z,COORD_SIGN_CHK
 584  FBBF B7                   OR A
 585  FBC0 F2 C6 FB             JP P,COORD_BIAS_SUB
 586  FBC3 2B                   DEC HL
 587  FBC4              ; ----------------------------------------------------------------------
 588  FBC4              ; COORD_MASK7 -- apply a signed config offset to the running column position.
 589  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 590  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 591  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude (COORD_BIAS_SUB entry skips
 592  FBC4              ;     the mask), subtract it from C, store the new column. Twin of the 2.23-44K
 593  FBC4              ;     COL_APPLY_OFFSET. [RE]
 594  FBC4              ; ----------------------------------------------------------------------
 595  FBC4              COORD_MASK7:
 596  FBC4 E6 7F                AND $7F
 597  FBC6              COORD_BIAS_SUB:
 598  FBC6 5F                   LD E,A
 599  FBC7 79                   LD A,C
 600  FBC8 93                   SUB E
 601  FBC9 77                   LD (HL),A
 602  FBCA C9                   RET
 603  FBCB              COORD_SIGN_CHK:
 604  FBCB B7                   OR A
 605  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH
 606  FBCF 2B                   DEC HL
 607  FBD0              ; ----------------------------------------------------------------------
 608  FBD0              ; COL_OFFSET_FROM_WIDTH -- derive the cursor screen coordinate and emit the move sequence.
 609  FBD0              ;   In:  C = column; the BOOT-overlaid base word at (BIOS_BOOT+2).  Out: emits the
 610  FBD0              ;     cursor-move via CONSOLE_PUT_CHAR.  Clobbers: A,B,C,DE,HL.
 611  FBD0              ;   Algorithm: CALL COORD_MASK7 to fold the column, load the base word (BIOS_BOOT+2 =
 612  FBD0              ;     the cold-boot LD SP operand reused as cursor scratch). [DOC S&HD 2-14] $F3A1 is
 613  FBD0              ;     the Hardware cursor XY offset (counterpart of SXYOFF=$F396); its high bit selects
 614  FBD0              ;     X/Y vs Y/X transmission order. Fold in the offset, ADD to form the address, emit
 615  FBD0              ;     with B=7 then B=$0A (CHAR_C_TO_SCREEN). Twin of the 2.23-44K COL_OFFSET_FROM_WIDTH. [RE]
 616  FBD0              ; ----------------------------------------------------------------------
 617  FBD0              COL_OFFSET_FROM_WIDTH:
 618  FBD0 CD C4 FB             CALL COORD_MASK7
 619  FBD3 2A EC FE             LD HL,(BIOS_BOOT+2)
 620  FBD6              ; [DOC S&HD 2-14] $F3A1 is the Hardware cursor XY coordinate offset (the hardware-table counterpart
 621  FBD6              ;       of SXYOFF=$F396); its high bit likewise selects X/Y vs Y/X transmission order to the terminal.
 622  FBD6 3A A1 F3             LD A,($F3A1)
 623  FBD9 B7                   OR A
 624  FBDA F2 E2 FB             JP P,EMIT_CURSOR_MOVE
 625  FBDD E6 7F                AND $7F
 626  FBDF 5D                   LD E,L
 627  FBE0 6C                   LD L,H
 628  FBE1 63                   LD H,E
 629  FBE2              EMIT_CURSOR_MOVE:
 630  FBE2 5F                   LD E,A
 631  FBE3 84                   ADD A,H
 632  FBE4 4F                   LD C,A
 633  FBE5 7B                   LD A,E
 634  FBE6 85                   ADD A,L
 635  FBE7 F5                   PUSH AF
 636  FBE8 06 07                LD B,$07
 637  FBEA CD A4 FC             CALL CONSOLE_PUT_CHAR
 638  FBED F1                   POP AF
 639  FBEE 06 0A                LD B,$0A
 640  FBF0              ; ----------------------------------------------------------------------
 641  FBF0              ; CHAR_C_TO_SCREEN -- tail: move A into C and tail-jump to the screen emitter.
 642  FBF0              ;   In:  A = char/code, B = mode/count code.  Out: JP CONSOLE_PUT_CHAR (no return).
 643  FBF0              ;   Clobbers: A,C.
 644  FBF0              ;   Algorithm: LD C,A / JP CONSOLE_PUT_CHAR. Twin of the 2.23-44K CHAR_C_TO_SCREEN. [RE]
 645  FBF0              ; ----------------------------------------------------------------------
 646  FBF0              CHAR_C_TO_SCREEN:
 647  FBF0 4F                   LD C,A
 648  FBF1 C3 A4 FC             JP CONSOLE_PUT_CHAR
 649  FBF4              ; ----------------------------------------------------------------------
 650  FBF4              ; BIOS_SETSEC (SETSEC) -- set the requested sector for the next disk I/O.
 651  FBF4              ;   In:  C = sector number.  Out: none.  Clobbers: A.
 652  FBF4              ;   Algorithm: store C into the seksec cell BIOS_BOOT+1 ($FEEB = the cold-boot LD SP
 653  FBF4              ;     operand low byte, reused post-boot as the requested-sector cell). The off-image
 654  FBF4              ;     RWTS/deblock is the consumer; this image only WRITES it. Twin of the 2.23-44K
 655  FBF4              ;     SETSEC. [RE]
 656  FBF4              ; ----------------------------------------------------------------------
 657  FBF4              BIOS_SETSEC:
 658  FBF4 79                   LD A,C
 659  FBF5 32 EB FE             LD (BIOS_BOOT+1),A
 660  FBF8 C9                   RET
 661  FBF9              ; ----------------------------------------------------------------------
 662  FBF9              ; BIOS_SETDMA (SETDMA) -- set the DMA (record transfer) address.
 663  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 664  FBF9              ;   Out: none.  Clobbers: none.
 665  FBF9              ;   Algorithm: store BC into the dmaadr cell (DISK_DMAADR+2 = $FEFA, the operand region
 666  FBF9              ;     of the cold-boot template store). The off-image deblock copy uses dmaadr as the
 667  FBF9              ;     host<->record transfer endpoint. Twin of the 2.23-44K SETDMA. [RE]
 668  FBF9              ; ----------------------------------------------------------------------
 669  FBF9              BIOS_SETDMA:
 670  FBF9 ED 43 FA FE          LD (DISK_DMAADR+2),BC
 671  FBFD C9                   RET
 672  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 673  FC56              ; ----------------------------------------------------------------------
 674  FC56              ; CONOUT_SEQ_MATCH -- scan the Software Screen Function Table for a control code.
 675  FC56              ;   In:  A/B = mode code; C = incoming char.  Out: emits a mapped function or the raw
 676  FC56              ;     char.  Clobbers: A,B,C,DE,HL.
 677  FC56              ;   Algorithm: read COL_STATE ($FEE6). [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the Software
 678  FC56              ;     function lead-in char (0 = none); if set and it matches C, mark pending ($80) and
 679  FC56              ;     return; else control codes (<=$1F) fall into the SSFTAB scan (SEQ_TBL_SCAN),
 680  FC56              ;     printables emit directly via CONSOLE_PUT_CHAR. Twin of the 2.23-44K SETDMA_1. [RE]
 681  FC56              ; ----------------------------------------------------------------------
 682  FC56              CONOUT_SEQ_MATCH:
 683  FC56 47                   LD B,A
 684  FC57 21 E6 FE             LD HL,COL_STATE
 685  FC5A 7E                   LD A,(HL)
 686  FC5B 5F                   LD E,A
 687  FC5C B7                   OR A
 688  FC5D 20 12                JR NZ,SEQ_TBL_SCAN
 689  FC5F              ; [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the Software function lead-in character (zero = no lead-in).
 690  FC5F              ;       If set and it matches the incoming byte (in C), a lead-in has been consumed: marks pending
 691  FC5F              ;       ($80) and returns; otherwise drops through to scan the Software Screen Function Table.
 692  FC5F 3A 97 F3             LD A,($F397)
 693  FC62 B7                   OR A
 694  FC63 28 06                JR Z,SEQ_PRINTABLE_CHK
 695  FC65 B9                   CP C
 696  FC66 20 03                JR NZ,SEQ_PRINTABLE_CHK
 697  FC68 36 80                LD (HL),$80
 698  FC6A C9                   RET
 699  FC6B              SEQ_PRINTABLE_CHK:
 700  FC6B 3E 1F                LD A,$1F
 701  FC6D B9                   CP C
 702  FC6E DA A4 FC             JP C,CONSOLE_PUT_CHAR
 703  FC71              ; [DOC S&HD 2-14/2-15] Scans the Software Screen Function Table for a matching control code. SSFTAB
 704  FC71              ;       (function #1) is at $F398; here HL=$F3A0 (function #9) and B=9 walks the 9 entries downward
 705  FC71              ;       to $F398, matching the incoming code against the 9 configurable screen functions. The
 706  FC71              ;       9-entry span $F398..$F3A0 implies fn#9 sits at $F3A0 (resolving the manual's fn8/fn9 ambiguity).
 707  FC71              ; ----------------------------------------------------------------------
 708  FC71              ; SEQ_TBL_SCAN -- match the incoming code against the 9 Software Screen Functions.
 709  FC71              ;   In:  C = control code, E = lead-in XOR mask.  Out: emits the matched function's
 710  FC71              ;     sequence or the raw char.  Clobbers: A,B,C,DE,HL.
 711  FC71              ;   Algorithm: [DOC S&HD 2-14/2-15] SSFTAB fn#1 is at $F398; HL=$F3A0 (fn#9), B=9 walks
 712  FC71              ;     the 9 entries downward to $F398, comparing each configured function code (XOR E)
 713  FC71              ;     against C. No match -> emit raw (CONSOLE_PUT_CHAR); match -> SEQ_EMIT_ENTRY. Twin
 714  FC71              ;     of the 2.23-44K SETDMA_3 SSFTAB scan. [RE]
 715  FC71              ; ----------------------------------------------------------------------
 716  FC71              SEQ_TBL_SCAN:
 717  FC71 21 A0 F3             LD HL,$F3A0
 718  FC74 06 09                LD B,$09
 719  FC76              CHECK_UNIT_DEFAULT_3:
 720  FC76 7E                   LD A,(HL)
 721  FC77 B7                   OR A
 722  FC78 28 04                JR Z,SEQ_TBL_NEXT
 723  FC7A AB                   XOR E
 724  FC7B B9                   CP C
 725  FC7C 28 05                JR Z,SEQ_EMIT_ENTRY
 726  FC7E              SEQ_TBL_NEXT:
 727  FC7E 2B                   DEC HL
 728  FC7F 10 F5                DJNZ CHECK_UNIT_DEFAULT_3
 729  FC81 18 21                JR CONSOLE_PUT_CHAR
 730  FC83              ; ----------------------------------------------------------------------
 731  FC83              ; SEQ_EMIT_ENTRY -- emit a matched screen function's replacement sequence.
 732  FC83              ;   In:  HL -> the matched SSFTAB entry; C carries state.  Out: emits via CONSOLE_PUT_CHAR;
 733  FC83              ;     may set the pending flag.  Clobbers: A,B,C,DE,HL.
 734  FC83              ;   Algorithm: index +$0B to the paired replacement byte; high bit set marks a hardware
 735  FC83              ;     lead-in ($F3A2, [DOC S&HD 2-14/2-15]) emitted ahead of the byte with B=7; then
 736  FC83              ;     SEQ_SET_PENDING may store $02 into COL_PENDING ($FEE5). Twin of the 2.23-44K
 737  FC83              ;     SETDMA_6/SETDMA_7. [RE]
 738  FC83              ; ----------------------------------------------------------------------
 739  FC83              SEQ_EMIT_ENTRY:
 740  FC83 11 0B 00             LD DE,$000B
 741  FC86 19                   ADD HL,DE
 742  FC87 7E                   LD A,(HL)
 743  FC88 B7                   OR A
 744  FC89 4F                   LD C,A
 745  FC8A F2 9A FC             JP P,SEQ_SET_PENDING
 746  FC8D E6 7F                AND $7F
 747  FC8F 4F                   LD C,A
 748  FC90 C5                   PUSH BC
 749  FC91              ; [DOC S&HD 2-14/2-15] Emits the matched function's Hardware-table lead-in: $F3A2 is the Hardware
 750  FC91              ;       lead-in character, sent ahead of the hardware screen-function byte to the terminal.
 751  FC91 3A A2 F3             LD A,($F3A2)
 752  FC94 06 07                LD B,$07
 753  FC96 CD F0 FB             CALL CHAR_C_TO_SCREEN
 754  FC99 C1                   POP BC
 755  FC9A              SEQ_SET_PENDING:
 756  FC9A 78                   LD A,B
 757  FC9B FE 07                CP $07
 758  FC9D 20 05                JR NZ,CONSOLE_PUT_CHAR
 759  FC9F 3E 02                LD A,$02
 760  FCA1 32 E5 FE             LD (COL_PENDING),A
 761  FCA4              ; [DOC S&HD 2-18/2-19] Console-output emit tail: loads HL from one of the two I/O Vector Table
 762  FCA4              ;       Console Output cells -- $F388 (Console Output #2) if the mode flag at COL_FLAG is 0, else
 763  FCA4              ;       $F386 (Console Output #1) -- and falls into the JP (HL). Output #1 serves TTY:/CRT:; Output
 764  FCA4              ;       #2 serves UC1:. These are user-patchable cells that carry the char in C to the console device.
 765  FCA4              ; ----------------------------------------------------------------------
 766  FCA4              ; CONSOLE_PUT_CHAR -- emit tail: JP (HL) into the selected Console Output vector.
 767  FCA4              ;   In:  C = character; COL_FLAG ($FEE4) selects the output cell.  Out: none (JP (HL)).
 768  FCA4              ;   Clobbers: A,HL.
 769  FCA4              ;   Algorithm: clear COL_STATE ($FEE6); load HL from one of the two I/O Vector Table
 770  FCA4              ;     Console Output cells -- $F388 (Output #2, UC1:) if COL_FLAG is 0, else $F386
 771  FCA4              ;     (Output #1, TTY:/CRT:) -- and JP (HL) (CONOUT_PHYS_JP). User-patchable cells that
 772  FCA4              ;     carry the char in C to the console device. [DOC S&HD 2-18/2-19] Twin of the
 773  FCA4              ;     2.23-44K SCREEN_EMIT. [RE]
 774  FCA4              ; ----------------------------------------------------------------------
 775  FCA4              CONSOLE_PUT_CHAR:
 776  FCA4 AF                   XOR A
 777  FCA5 32 E6 FE             LD (COL_STATE),A
 778  FCA8 3A E4 FE             LD A,(COL_FLAG)
 779  FCAB B7                   OR A
 780  FCAC 2A 88 F3             LD HL,($F388)
 781  FCAF 28 03                JR Z,CONOUT_PHYS_JP
 782  FCB1 2A 86 F3             LD HL,($F386)
 783  FCB4              ; [DOC S&HD 2-18/2-19] JP (HL) into the selected Console Output vector ($F386 #1 or $F388 #2)
 784  FCB4              ;       resolved above -- the user-patchable I/O Vector Table cell that drives console output.
 785  FCB4              CONOUT_PHYS_JP:
 786  FCB4 E9                   JP (HL)
 787  FCB5 11 03 00 C3          DEFB    $11,$03,$00,$C3
 788  FCB9              CONOUT_HANDLER_VEC:
 789  FCB9 BB FC 2A E7          DEFB    $BB,$FC,$2A,$E7,$FE,$3A,$E9,$FE,$77,$CD,$E2,$FC,$2A,$28,$F0,$3A
 789  FCBD FE 3A E9 FE
 789  FCC1 77 CD E2 FC
 789  FCC5 2A 28 F0 3A
 790  FCC9 24 F0 5F 16          DEFB    $24,$F0,$5F,$16,$F0,$19,$22,$E7,$FE,$7E,$32,$E9
 790  FCCD F0 19 22 E7
 790  FCD1 FE 7E 32 E9
 791  FCD5 FE FE                DEFW    BIOS_BOOT_8
 792  FCD7 E0 38 02 EE          DEFB    $E0,$38,$02,$EE,$20,$E6,$3F,$F6,$40,$77,$C9,$78,$B7,$28,$0B,$21
 792  FCDB 20 E6 3F F6

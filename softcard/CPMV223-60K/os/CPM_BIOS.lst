 800  FD0F 8A FE                DEFW    SLOT_IO_ADDR
 801  FD11 C6 8F CB 4E          DEFB    $C6,$8F,$CB,$4E,$28,$FC,$21,$2F,$F0,$36,$60,$2B,$36,$C0,$2B,$77

 804  FD54 7D FE 28 38          DEFB    $7D,$FE,$28,$38,$02,$2E,$00,$7C,$FE,$18,$38,$02,$26,$00,$22,$24
 804  FD58 02 2E 00 7C
 804  FD5C FE 18 38 02
 804  FD60 26 00 22 24

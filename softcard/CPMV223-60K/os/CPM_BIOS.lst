 882  FE75              ; ----------------------------------------------------------------------
 883  FE75              ; INIT_PASCAL_1_1_1 (HOME) -- BIOS jump-vector entry 8: seek the drive to track 0.
 884  FE75              ;   In:  none.  Out: none (falls into SETTRK's store with track 0).  Clobbers: A,C.
 885  FE75              ;   Algorithm: read the host-write-pending template cell (DISK_HSTWRT); if a write is
 886  FE75              ;     pending keep the host-active flag, else clear DISK_HSTACT; then fall into
 887  FE75              ;     INIT_PASCAL_1_1_3/_4 (SETTRK) with track 0. The actual head step happens later in
 888  FE75              ;     the off-image deblock path. Twin of the 2.23-44K HOME/SETTRK_STORE. [RE]
 889  FE75              ; ----------------------------------------------------------------------
 890  FE75              INIT_PASCAL_1_1_1:
 891  FE75 3A F2 FE             LD A,(DISK_HSTWRT)
 892  FE78 B7                   OR A
 893  FE79              INIT_PASCAL_1_1_2:
 894  FE79 20 03                JR NZ,INIT_PASCAL_1_1_3
 895  FE7B 32 F1 FE             LD (DISK_HSTACT),A
 896  FE7E              INIT_PASCAL_1_1_3:
 897  FE7E 0E 00                LD C,$00
 898  FE80              ; ----------------------------------------------------------------------
 899  FE80              ; SETTRK_STORE (SETTRK) -- BIOS jump-vector entry 10: set the requested track.
 900  FE80              ;   In:  C = track number.  Out: none.  Clobbers: A.
 901  FE80              ;   Algorithm: LD A,C then store into the sektrk cell BIOS_BOOT ($FEEA = the cold-boot
 902  FE80              ;     LD SP operand byte reused post-boot as sektrk). HOME enters this common tail with
 903  FE80              ;     track 0. Twin of the 2.23-44K SETTRK_STORE tail. [RE]
 904  FE80              ; ----------------------------------------------------------------------
 905  FE80              SETTRK_STORE:
 906  FE80 79                   LD A,C
 907  FE81 32 EA FE             LD (BIOS_BOOT),A
 908  FE84 C9                   RET
 909  FE85              ; ----------------------------------------------------------------------
 910  FE85              ; SLOT_IO_ADDR_W -- map a slot/drive index to the Apple $C080 write/control-bank base.
 911  FE85              ;   In:  E = slot/drive index (0..15).  Out: HL = $E080 + (E<<4).  Clobbers: A,L.
 912  FE85              ;   Algorithm: load z80 $E080 = Apple $C080, then fall into the shared index scaler
 913  FE85              ;     (SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR_W. [RE]
 914  FE85              ; ----------------------------------------------------------------------
 915  FE85              SLOT_IO_ADDR_W:
 916  FE85 21 80 E0             LD HL,$E080
 917  FE88 18 03                JR SLOT_IO_SCALE_E
 918  FE8A              ; ----------------------------------------------------------------------
 919  FE8A              ; SLOT_IO_ADDR -- map a slot/drive index to the Apple $C08E slot-I/O base.
 920  FE8A              ;   In:  E = slot/drive index (0..15).  Out: HL = $E08E + (E<<4).  Clobbers: A,L.
 921  FE8A              ;   Algorithm: load z80 $E08E = Apple $C08E, then fall into the shared index scaler
 922  FE8A              ;     (SLOT_IO_SCALE_E -> SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR. [RE]
 923  FE8A              ; ----------------------------------------------------------------------
 924  FE8A              SLOT_IO_ADDR:
 925  FE8A 21 8E E0             LD HL,$E08E
 926  FE8D              SLOT_IO_SCALE_E:
 927  FE8D 7B                   LD A,E
 928  FE8E              ; ----------------------------------------------------------------------
 929  FE8E              ; SLOT_IOBASE_CALC -- shift the index left by 4 and add to L (index a 16-byte block).
 930  FE8E              ;   In:  A = index (via SLOT_IO_SCALE_E from E), L = base low byte.  Out: L += A*16;
 931  FE8E              ;     A preserved.  Clobbers: A,L.
 932  FE8E              ;   Algorithm: ADD A,A x4 (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET. Shared by
 933  FE8E              ;     SLOT_IO_ADDR_W/_8E and by SELDSK (DPH-table index) and PROBE_DEVICES. Twin of the
 934  FE8E              ;     2.23-44K SLOT_IO_SCALE. [RE]
 935  FE8E              ; ----------------------------------------------------------------------
 936  FE8E              SLOT_IOBASE_CALC:
 937  FE8E 87                   ADD A,A
 938  FE8F 87                   ADD A,A
 939  FE90 87                   ADD A,A
 940  FE91 87                   ADD A,A
 941  FE92 F5                   PUSH AF
 942  FE93 85                   ADD A,L
 943  FE94 6F                   LD L,A
 944  FE95 F1                   POP AF
 945  FE96 C9                   RET
 946  FE97              ; ----------------------------------------------------------------------
 947  FE97              ; SELDSK_IMPL_1 (SELDSK) -- BIOS jump-vector entry 9: select the disk drive.
 948  FE97              ;   In:  C = disk number (0-based).  Out: HL = DPH address for drive C, or HL=0 if out
 949  FE97              ;     of range.  Clobbers: A,DE,HL.
 950  FE97              ;   Algorithm: DE -> the sekdsk build site (BIOS_BOOT_2, an install-template cell reused
 951  FE97              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
 952  FE97              ;     block (z80 $F3B8 = Apple $03B8, the Disk Count Byte); if C >= count return HL=0
 953  FE97              ;     (SELDSK_BAD_DRIVE). Else record the disk number, index DPH_TABLE by C*16 (CALL
 954  FE97              ;     SLOT_IOBASE_CALC), pull a per-drive disk-parameter byte and self-modify the install
 955  FE97              ;     template SECTOR_BLOCK_PATCH+1 with it. [DOC S&HD 2-26/2-27] Twin of the 2.23-44K SELDSK. [RE]
 956  FE97              ; ----------------------------------------------------------------------
 957  FE97              SELDSK_IMPL_1:
 958  FE97 11 EE FE             LD DE,BIOS_BOOT_2
 959  FE9A 21 04 00             LD HL,CDISK_ADDR
 960  FE9D 3A B8 F3             LD A,(SLOT_INFO_BASE)
 961  FEA0 3D                   DEC A
 962  FEA1 B9                   CP C
 963  FEA2 38 1D                JR C,SELDSK_BAD_DRIVE
 964  FEA4 7E                   LD A,(HL)
 965  FEA5 12                   LD (DE),A
 966  FEA6 13                   INC DE
 967  FEA7 79                   LD A,C
 968  FEA8 12                   LD (DE),A
 969  FEA9 21 33 FA             LD HL,DPH_TABLE
 970  FEAC CD 8E FE             CALL SLOT_IOBASE_CALC
 971  FEAF E5                   PUSH HL
 972  FEB0 11 0A 00             LD DE,$000A
 973  FEB3 19                   ADD HL,DE
 974  FEB4 5E                   LD E,(HL)
 975  FEB5 23                   INC HL
 976  FEB6 56                   LD D,(HL)
 977  FEB7 21 05 00             LD HL,BDOS
 978  FEBA 19                   ADD HL,DE
 979  FEBB 7E                   LD A,(HL)
 980  FEBC 32 FC FE             LD (SECTOR_BLOCK_PATCH+1),A
 981  FEBF E1                   POP HL
 982  FEC0 C9                   RET
 983  FEC1              ; ----------------------------------------------------------------------
 984  FEC1              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH).
 985  FEC1              ;   In:  DE -> sekdsk build site.  Out: HL=0.  Clobbers: A,L.
 986  FEC1              ;   Algorithm: restore the prior sekdsk byte, then LD L,$00 signals an invalid drive to
 987  FEC1              ;     the BDOS. Twin of the 2.23-44K SELDSK_BAD_DRIVE. [RE]
 988  FEC1              ; ----------------------------------------------------------------------
 989  FEC1              SELDSK_BAD_DRIVE:
 990  FEC1 1A                   LD A,(DE)
 991  FEC2 77                   LD (HL),A
 992  FEC3 2E 00                LD L,$00
 993  FEC5 C9                   RET
 994  FEC6              ; ----------------------------------------------------------------------
 995  FEC6              ; SELDSK_IMPL_3 (READ) -- BIOS jump-vector entry 13: read one 128-byte record.
 996  FEC6              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
 997  FEC6              ;   Algorithm: stash A at $E08B (a 6502-side RPC param cell = Apple $C08B), then OFF-IMAGE
 998  FEC6              ;     tail-jump to the deblock/RWTS read core at $B247 (below the BIOS, in the 60K
 999  FEC6              ;     system-image region). Unlike the 2.20 twin, the 2.23 BIOS does NOT carry the deblock
1000  FEC6              ;     in-image; READ/WRITE delegate to the $B2xx host-sector routines. [RE]
1001  FEC6              ; ----------------------------------------------------------------------
1002  FEC6              SELDSK_IMPL_3:
1003  FEC6 32 8B E0             LD ($E08B),A
1004  FEC9 C3 47 B2             JP $B247
1005  FECC              ; ----------------------------------------------------------------------
1006  FECC              ; SELDSK_IMPL_4 (WRITE) -- BIOS jump-vector entry 14: write one 128-byte record.
1007  FECC              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
1008  FECC              ;   Algorithm: stash A at $E08B (Apple $C08B RPC param), then OFF-IMAGE tail-jump to the
1009  FECC              ;     deblock/RWTS write core at $B257 (60K system-image region below the BIOS). Same
1010  FECC              ;     off-image RWTS delegation as SELDSK_IMPL_3 (READ). [RE]
1011  FECC              ; ----------------------------------------------------------------------
1012  FECC              SELDSK_IMPL_4:
1013  FECC 32 8B E0             LD ($E08B),A
1014  FECF C3 57 B2             JP $B257
1015  FED2 CD                   DEFB    $CD
1016  FED3 45 FB                DEFW    RPC_TRIGGER
1017  FED5 32 8B E0 C9          DEFB    $32,$8B,$E0,$C9,$32,$83,$E0,$2A,$0D,$DC,$E9,$32,$83,$E0,$C9
1017  FED9 32 83 E0 2A
1017  FEDD 0D DC E9 32
1017  FEE1 83 E0 C9
1018  FEE4              COL_FLAG:
1019  FEE4 00                   DEFB    $00
1020  FEE5              COL_PENDING:
1021  FEE5 00                   DEFB    $00
1022  FEE6              COL_STATE:
1023  FEE6 00 E9 FE 00          DEFB    $00,$E9,$FE,$00
1024  FEEA              ; ----------------------------------------------------------------------
1025  FEEA              ; BIOS_BOOT -- Z-80 cold-boot init: runs ONCE, then self-modifies ~a few dozen bytes.
1026  FEEA              ;   In:  entered once at cold start (the 60K reset-plant JPs here).  Out: enters the CCP
1027  FEEA              ;     via the sign-on tail; never re-executed.  Clobbers: all.
1028  FEEA              ;   Algorithm: set SP=$0100; NOP the $FA00 cold JP; load the default IOBYTE_ADDR ($95) into
1029  FEEA              ;     $0003; bind Z$CPU ($F3DE) into RPC_TRIGGER_STORE+1; clear CDISK_ADDR; install console/list/
1030  FEEA              ;     punch/reader handlers by Card Type Table class (device-6=Pascal-1.1, 5=parallel,
1031  FEEA              ;     4=Videx patches the status vector); re-run PROBE_DEVICES; clear screen; print banner.
1032  FEEA              ;   DUAL USE: the 'LD SP,$0100' operand bytes are reused post-boot as sektrk (BIOS_BOOT),
1033  FEEA              ;     seksec (BIOS_BOOT+1) and a cursor word (BIOS_BOOT+2). After it runs, $FEEA-$FF8D is
1034  FEEA              ;     dead scratch; the ~6 self-mods are cataloged in ../BOOT_AND_PATCHING.md section 3c.
1035  FEEA              ;     [DOC S&HD 2-24/2-25, 2-26/2-27] Twin of the 2.23-44K install engine. [RE]
1036  FEEA              ; ----------------------------------------------------------------------
1037  FEEA              BIOS_BOOT:
1038  FEEA 31 00 01             LD SP,TPA
1039  FEED              BIOS_BOOT_1:
1040  FEED AF                   XOR A
1041  FEEE              BIOS_BOOT_2:
1042  FEEE 21 00 FA             LD HL,BOOT
1043  FEF1              DISK_HSTACT:
1044  FEF1 77                   LD (HL),A
1045  FEF2              DISK_HSTWRT:
1046  FEF2 23                   INC HL
1047  FEF3 77                   LD (HL),A
1048  FEF4 23                   INC HL
1049  FEF5 77                   LD (HL),A
1050  FEF6              BOOT_TMPL_IOBYTE:
1051  FEF6 3E 95                LD A,$95
1052  FEF8              DISK_DMAADR:
1053  FEF8 32 03 00             LD (IOBYTE_ADDR),A
1054  FEFB              ; [DOC S&HD 2-24/2-25] Loads the SoftCard location from Z$CPU=$F3DE and binds it into the RPC
1055  FEFB              ;       dispatcher (patching RPC_TRIGGER_STORE+1) so subsequent 6502 calls switch via the right slot.
1056  FEFB              SECTOR_BLOCK_PATCH:
1057  FEFB 2A DE F3             LD HL,($F3DE)
1058  FEFE              BIOS_BOOT_8:
1059  FEFE 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1060  FF01 AF                   XOR A
1061  FF02 32 04 00             LD (CDISK_ADDR),A
1062  FF05              ; [DOC S&HD 2-26/2-27] Reads the slot-3 (console) Card Type Table entry at $F3BB ($F3B8+3). [AI] The
1063  FF05              ;       CP $06 test selects the POST-1980 device-6 / Pascal-1.1 console class (a 2.23 extension the
1064  FF05              ;       2.20 manual does NOT document; in 2.20 the Videx is type 4). On a match it points the
1065  FF05              ;       [DOC S&HD 2-18] I/O Vector Table Console Status cell ($F380) at the slot-3 console handler.
1066  FF05 3A BB F3             LD A,($F3BB)
1067  FF08 FE 06                CP $06
1068  FF0A 20 0A                JR NZ,DEV_INSTALL_LIST
1069  FF0C 21 99 FD             LD HL,CONST_SLOT3_TBL
1070  FF0F 22 80 F3             LD ($F380),HL
1071  FF12 D6 03                SUB $03
1072  FF14 18 13                JR DEV_INSTALL_PUNCH
1073  FF16              ; [DOC S&HD 2-26/2-27] Non-device-6 console path: dispatches on the slot-3 Card Type value. Value 5
1074  FF16              ;       (Apple Parallel Printer) skips ahead; values >=3 (serial / Videx-class / device-4) fall
1075  FF16              ;       through to install the console handlers; value 4 patches the slot-3 console-status vector below.
1076  FF16              DEV_INSTALL_LIST:
1077  FF16 FE 05                CP $05
1078  FF18 28 22                JR Z,BIOS_BOOT_11
1079  FF1A D6 03                SUB $03
1080  FF1C 38 1E                JR C,BIOS_BOOT_11
1081  FF1E 20 09                JR NZ,DEV_INSTALL_PUNCH
1082  FF20 21 15 FB             LD HL,CONST_VEC_PATCH
1083  FF23 36 BE                LD (HL),$BE
1084  FF25 23                   INC HL
1085  FF26 23                   INC HL
1086  FF27 36 1F                LD (HL),$1F
1087  FF29              DEV_INSTALL_PUNCH:
1088  FF29 F5                   PUSH AF
1089  FF2A CD 9D FF             CALL DEV_HANDLER_LOOKUP
1090  FF2D F1                   POP AF
1091  FF2E 22 B9 FC             LD (CONOUT_HANDLER_VEC),HL
1092  FF31 CD 98 FF             CALL GET_CONIN_HANDLER
1093  FF34 22 37 FB             LD (CONIN_HANDLER_VEC),HL
1094  FF37 3E 03                LD A,$03
1095  FF39 32 05 FB             LD (CCP_LAUNCH+1),A
1096  FF3C              ; [DOC S&HD 2-26/2-27] Reads the slot-1 Card Type Table entry at $F3B9 (SLTTYP base = slot 1, per
1097  FF3C              ;       Slot Function Assignments the LST: line-printer slot). For a recognized output card (value
1098  FF3C              ;       >=3 after SUB $03) it resolves and installs that card's output handler for the list device.
1099  FF3C              BIOS_BOOT_11:
1100  FF3C 3A B9 F3             LD A,($F3B9)
1101  FF3F D6 03                SUB $03
1102  FF41 38 06                JR C,INSTALL_DONE_DEVICES
1103  FF43 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1104  FF46 22 59 FE             LD (READER_HANDLER_TBL),HL
1105  FF49              ; [DOC S&HD 2-26/2-27] Reads the slot-2 Card Type Table entry at $F3BA ($F3B8+2) -- per Slot
1106  FF49              ;       Function Assignments the general-purpose PUN:/RDR: slot. For a recognized output card it
1107  FF49              ;       installs the punch handler; the value also drives the reader-handler selection below.
1108  FF49              INSTALL_DONE_DEVICES:
1109  FF49 3A BA F3             LD A,($F3BA)
1110  FF4C D6 03                SUB $03
1111  FF4E 38 14                JR C,BIOS_BOOT_14
1112  FF50 F5                   PUSH AF
1113  FF51 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1114  FF54 22 6D FE             LD (PUNCH_HANDLER_TBL),HL
1115  FF57 F1                   POP AF
1116  FF58              BIOS_BOOT_13:
1117  FF58 FE 02                CP $02
1118  FF5A 28 08                JR Z,BIOS_BOOT_14
1119  FF5C CD 98 FF             CALL GET_CONIN_HANDLER
1120  FF5F 22 73 FE             LD (AUX_DEV_VEC),HL
1121  FF62 18 0B                JR BIOS_BOOT_15
1122  FF64              BIOS_BOOT_14:
1123  FF64 21 3E 1A             LD HL,$1A3E
1124  FF67 22 72 FE             LD (AUX_DEV_STUB),HL
1125  FF6A 3E C9                LD A,$C9
1126  FF6C 32 74 FE             LD (AUX_DEV_VEC_HI),A
1127  FF6F              ; [DOC S&HD 2-14/2-15] Rescans the slots, then reads $F398 -- SSFTAB function #1, Clear Screen, the
1128  FF6F              ;       first entry of the Software Screen Function Table -- and emits it to home/clear the console
1129  FF6F              ;       before printing the sign-on banner.
1130  FF6F              BIOS_BOOT_15:
1131  FF6F CD 82 FA             CALL PROBE_DEVICES
1132  FF72 3A 98 F3             LD A,($F398)
1133  FF75 CD A8 FF             CALL BANNER_PUT_CHAR
1134  FF78 21 B7 FF             LD HL,SIGNON_BANNER
1135  FF7B              SIGNON_BANNER_LOOP:
1136  FF7B 7E                   LD A,(HL)
1137  FF7C B7                   OR A
1138  FF7D              BIOS_BOOT_17:
1139  FF7D CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1140  FF80 E5                   PUSH HL
1141  FF81 CD 4C FB             CALL CONOUT_SET_C
1142  FF84 E1                   POP HL
1143  FF85 23                   INC HL
1144  FF86 18 F3                JR SIGNON_BANNER_LOOP
1145  FF88              CONOUT_VEC_TABLE:
1146  FF88 0E FD 71 FD          DEFB    $0E,$FD,$71,$FD,$5B,$FE,$A9,$FD
1146  FF8C 5B FE A9 FD
1147  FF90              CONIN_VEC_TABLE:
1148  FF90 4B FE C1 FD          DEFB    $4B,$FE,$C1,$FD,$B7,$FD,$B7,$FD
1148  FF94 B7 FD B7 FD
1149  FF98              ; ----------------------------------------------------------------------
1150  FF98              ; GET_CONIN_HANDLER -- fetch a console-input handler address from CONIN_VEC_TABLE.
1151  FF98              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1152  FF98              ;   Algorithm: HL = CONIN_VEC_TABLE base, then fall into the shared index tail
1153  FF98              ;     (HANDLER_TBL_INDEX: HL += A*2; load the word). Twin of the 2.23-44K
1154  FF98              ;     DEV_HANDLER_LOOKUP_B family. [RE]
1155  FF98              ; ----------------------------------------------------------------------
1156  FF98              GET_CONIN_HANDLER:
1157  FF98 21 90 FF             LD HL,CONIN_VEC_TABLE
1158  FF9B 18 03                JR HANDLER_TBL_INDEX
1159  FF9D              ; ----------------------------------------------------------------------
1160  FF9D              ; DEV_HANDLER_LOOKUP -- fetch a console-output handler address from CONOUT_VEC_TABLE.
1161  FF9D              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1162  FF9D              ;   Algorithm: HL = CONOUT_VEC_TABLE base, fall into HANDLER_TBL_INDEX (HL += A*2; load
1163  FF9D              ;     the 16-bit word low-then-high). Twin of the 2.23-44K DEV_HANDLER_LOOKUP. [RE]
1164  FF9D              ; ----------------------------------------------------------------------
1165  FF9D              DEV_HANDLER_LOOKUP:
1166  FF9D 21 88 FF             LD HL,CONOUT_VEC_TABLE
1167  FFA0              HANDLER_TBL_INDEX:
1168  FFA0 87                   ADD A,A
1169  FFA1              HANDLER_TBL_FETCH:
1170  FFA1 85                   ADD A,L
1171  FFA2 6F                   LD L,A
1172  FFA3 7E                   LD A,(HL)
1173  FFA4 2C                   INC L
1174  FFA5 66                   LD H,(HL)
1175  FFA6 6F                   LD L,A
1176  FFA7 C9                   RET
1177  FFA8              ; [AI] Banner character emitter: if the byte is positive (high bit clear) it outputs it directly; if
1178  FFA8              ;       negative it first emits the software lead-in. [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the
1179  FFA8              ;       Software function lead-in character, sent ahead of the byte for the high-bit-set case.
1180  FFA8              ; ----------------------------------------------------------------------
1181  FFA8              ; BANNER_PUT_CHAR -- emit one sign-on byte, optionally preceded by a lead-in char.
1182  FFA8              ;   In:  A = byte/flag.  Out: prints via CONOUT_SET_C.  Clobbers: A,HL.
1183  FFA8              ;   Algorithm: if A is positive (bit7 clear) tail-jump to emit it directly
1184  FFA8              ;     (BANNER_EMIT_CHAR); if negative, first emit the software lead-in char from config
1185  FFA8              ;     $F397 (SFLDIN, [DOC S&HD 2-14/2-15]) via CONOUT_SET_C, then emit A. Twin of the
1186  FFA8              ;     2.23-44K SIGNON_EMIT. [RE]
1187  FFA8              ; ----------------------------------------------------------------------
1188  FFA8              BANNER_PUT_CHAR:
1189  FFA8 B7                   OR A
1190  FFA9 F2 B4 FF             JP P,BANNER_EMIT_CHAR
1191  FFAC F5                   PUSH AF
1192  FFAD              BANNER_PUT_ATTR:
1193  FFAD 3A 97 F3             LD A,($F397)
1194  FFB0 CD 4C FB             CALL CONOUT_SET_C
1195  FFB3              BANNER_RESTORE_A:
1196  FFB3 F1                   POP AF
1197  FFB4              BANNER_EMIT_CHAR:
1198  FFB4 C3 4C FB             JP CONOUT_SET_C
1199  FFB7              ; [AI] Cold-boot sign-on banner emitted by the loop above: "Softcard CP/M / 60K Ver. 2.23 / (c)
1200  FFB7              ;       1980,1982 Microsoft". This is the POST-1980 60K / 2.23 variant; the 2.20 manual documents only
1201  FFB7              ;       the "APPLE II CP/M / 44K vers. 2.2X / (C) 1980 MICROSOFT" 44K/56K banner (S&HD 1-8), so the
1202  FFB7              ;       "60K"/"2.23"/"1982" tokens here are version-specific, not manual-backed.
1203  FFB7              SIGNON_BANNER:
1204  FFB7 0D 0A 0A 0A          DEFB    $0D,$0A,$0A,$0A,$20,$20,$20,$20,$20,$53,$6F,$66,$74,$63,$61,$72
1204  FFBB 20 20 20 20
1204  FFBF 20 53 6F 66
1204  FFC3 74 63 61 72
1205  FFC7 64 20 43 50          DEFB    "d CP/M"                 ; string
1205  FFCB 2F 4D
1206  FFCD 0D                   DEFB    $0D                      ; terminator
1207  FFCE 0A 20 20 20          DEFB    $0A,$20,$20,$20,$20,$20,$36,$30,$4B,$20,$56,$65,$72,$2E,$20,$32
1207  FFD2 20 20 36 30
1207  FFD6 4B 20 56 65
1207  FFDA 72 2E 20 32
1208  FFDE 2E 32 33 0D          DEFB    $2E,$32,$33,$0D,$0A,$28,$63,$29,$20,$31,$39,$38,$30,$2C,$31,$39
1208  FFE2 0A 28 63 29
1208  FFE6 20 31 39 38
1208  FFEA 30 2C 31 39
1209  FFEE 38 32 20 4D          DEFB    "82 Microsoft"           ; string
1209  FFF2 69 63 72 6F
1209  FFF6 73 6F 66 74
1210  FFFA 0D                   DEFB    $0D                      ; terminator
1211  FFFB 0A 0D 0A             DEFB    $0A,$0D,$0A
1212  FFFE 00 FA                DEFW    BOOT
1213  0000
1214  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1215  0000
1216  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
1217  0000                  ; Image size from its bracketing labels, not a magic length, as in the 2.23-44K twin:
1218  0000                  ; an overrun fails the build here instead of being silently truncated by SAVEBIN.
1219  0000                  ; $FA00 = the ORG base; the subtraction wraps because the image ends at $10000.
1220  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1221  0000                  ENDIF
1222  0000
1223  0000              ; ----------------------------------------------------------------------
1224  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEFD-$FFF4.
1225  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above (the region the file
1226  0000              ;   header describes as dead after BIOS_BOOT has run). It runs once at cold start; only
1227  0000              ;   afterwards does the disk system reuse them as the buffers DPH_TABLE hands out. The
1228  0000              ;   two tenants are never live at the same time.
1229  0000              ;
1230  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1231  0000              ;   at the overlay base, then one label per field with its extent carried in the
1232  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1233  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1234  0000              ;   the image. Under the CPM60.COM master link this file is assembled inside a
1235  0000              ;   DISP $FA00 block, where sjasmplus moves only the displacement address and leaves
1236  0000              ;   the physical output pointer alone, so the ORGs are safe there too.
1237  0000              ;
1238  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1239  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1240  0000              ;   cold boot has finished. Same shape and names as the 2.20-44K and 2.23-44K twins;
1241  0000              ;   only the addresses differ. [RE]
1242  0000              ; ----------------------------------------------------------------------
1243  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1244  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1245  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1246  0000              CSV_SIZE     EQU 12                   ; = CKS
1247  0000
1248  0000                      ORG $FEFD                     ; the one given: where the author placed the overlay
1249  FEFD              DIRBUF:                               ; shared directory buffer, one per system
1250  FEFD                      ORG DIRBUF + DIRBUF_SIZE
1251  FF7D              ALV_VECTORS:                          ; per-drive allocation vectors ($FF7D..)
1252  FF7D                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1253  FFC5              CSV_VECTORS:                          ; per-drive checksum vectors ($FFC5..)
1254  FFC5                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1255  FFF5              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFF5)
1256  FFF5
1257  FFF5                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1258  FFF5                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1259  FFF5                  ASSERT ALV_VECTORS == $FF7D
1260  FFF5                  ASSERT CSV_VECTORS == $FFC5
1261  FFF5                  ASSERT BIOS_SCRATCH_END == $FFF5
1262  FFF5
# file closed: CPM_BIOS.asm

 858  FDF6 A4 F5 90 F5
 859  FDFA 60 00 00 00          DEFB    $60,$00,$00,$00,$00,$00,$4C,$09,$0E,$8D,$8B,$C0,$4C,$13,$D4,$8D
 859  FDFE 00 00 4C 09
 859  FE02 0E 8D 8B C0
 859  FE06 4C 13 D4 8D
 860  FE0A 8B C0 4C F7          DEFB    $8B,$C0,$4C,$F7,$D1,$A9,$01,$20,$EF,$0D,$20,$26,$0E,$48,$A0,$0E

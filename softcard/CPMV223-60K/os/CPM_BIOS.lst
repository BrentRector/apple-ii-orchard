 862  FE6D              PUNCH_HANDLER_TBL:
 863  FE6D 68 FE 11 02          DEFB    $68,$FE,$11,$02,$00
 863  FE71 00
 864  FE72              AUX_DEV_STUB:
 865  FE72 C3                   DEFB    $C3
 866  FE73              AUX_DEV_VEC:
 867  FE73 00                   DEFB    $00
 868  FE74              AUX_DEV_VEC_HI:
 869  FE74 00                   DEFB    $00
 870  FE75              ; ----------------------------------------------------------------------
 871  FE75              ; INIT_PASCAL_1_1_1 (HOME) -- BIOS jump-vector entry 8: seek the drive to track 0.
 872  FE75              ;   In:  none.  Out: none (falls into SETTRK's store with track 0).  Clobbers: A,C.
 873  FE75              ;   Algorithm: read the host-write-pending template cell (DISK_HSTWRT); if a write is
 874  FE75              ;     pending keep the host-active flag, else clear DISK_HSTACT; then fall into
 875  FE75              ;     INIT_PASCAL_1_1_3/_4 (SETTRK) with track 0. The actual head step happens later in
 876  FE75              ;     the off-image deblock path. Twin of the 2.23-44K HOME/SETTRK_STORE. [RE]
 877  FE75              ; ----------------------------------------------------------------------
 878  FE75              INIT_PASCAL_1_1_1:
 879  FE75 3A F2 FE             LD A,(DISK_HSTWRT)
 880  FE78 B7                   OR A
 881  FE79              INIT_PASCAL_1_1_2:
 882  FE79 20 03                JR NZ,INIT_PASCAL_1_1_3
 883  FE7B 32 F1 FE             LD (DISK_HSTACT),A
 884  FE7E              INIT_PASCAL_1_1_3:
 885  FE7E 0E 00                LD C,$00
 886  FE80              ; ----------------------------------------------------------------------
 887  FE80              ; SETTRK_STORE (SETTRK) -- BIOS jump-vector entry 10: set the requested track.
 888  FE80              ;   In:  C = track number.  Out: none.  Clobbers: A.
 889  FE80              ;   Algorithm: LD A,C then store into the sektrk cell BIOS_BOOT ($FEEA = the cold-boot
 890  FE80              ;     LD SP operand byte reused post-boot as sektrk). HOME enters this common tail with
 891  FE80              ;     track 0. Twin of the 2.23-44K SETTRK_STORE tail. [RE]
 892  FE80              ; ----------------------------------------------------------------------
 893  FE80              SETTRK_STORE:
 894  FE80 79                   LD A,C
 895  FE81 32 EA FE             LD (BIOS_BOOT),A
 896  FE84 C9                   RET
 897  FE85              ; ----------------------------------------------------------------------
 898  FE85              ; SLOT_IO_ADDR_W -- map a slot/drive index to the Apple $C080 write/control-bank base.
 899  FE85              ;   In:  E = slot/drive index (0..15).  Out: HL = $E080 + (E<<4).  Clobbers: A,L.
 900  FE85              ;   Algorithm: load z80 $E080 = Apple $C080, then fall into the shared index scaler
 901  FE85              ;     (SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR_W. [RE]
 902  FE85              ; ----------------------------------------------------------------------
 903  FE85              SLOT_IO_ADDR_W:
 904  FE85 21 80 E0             LD HL,$E080
 905  FE88 18 03                JR SLOT_IO_SCALE_E
 906  FE8A              ; ----------------------------------------------------------------------
 907  FE8A              ; SLOT_IO_ADDR -- map a slot/drive index to the Apple $C08E slot-I/O base.
 908  FE8A              ;   In:  E = slot/drive index (0..15).  Out: HL = $E08E + (E<<4).  Clobbers: A,L.
 909  FE8A              ;   Algorithm: load z80 $E08E = Apple $C08E, then fall into the shared index scaler
 910  FE8A              ;     (SLOT_IO_SCALE_E -> SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR. [RE]
 911  FE8A              ; ----------------------------------------------------------------------
 912  FE8A              SLOT_IO_ADDR:
 913  FE8A 21 8E E0             LD HL,$E08E
 914  FE8D              SLOT_IO_SCALE_E:
 915  FE8D 7B                   LD A,E
 916  FE8E              ; ----------------------------------------------------------------------
 917  FE8E              ; SLOT_IOBASE_CALC -- shift the index left by 4 and add to L (index a 16-byte block).
 918  FE8E              ;   In:  A = index (via SLOT_IO_SCALE_E from E), L = base low byte.  Out: L += A*16;
 919  FE8E              ;     A preserved.  Clobbers: A,L.
 920  FE8E              ;   Algorithm: ADD A,A x4 (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET. Shared by
 921  FE8E              ;     SLOT_IO_ADDR_W/_8E and by SELDSK (DPH-table index) and PROBE_DEVICES. Twin of the
 922  FE8E              ;     2.23-44K SLOT_IO_SCALE. [RE]
 923  FE8E              ; ----------------------------------------------------------------------
 924  FE8E              SLOT_IOBASE_CALC:
 925  FE8E 87                   ADD A,A
 926  FE8F 87                   ADD A,A
 927  FE90 87                   ADD A,A
 928  FE91 87                   ADD A,A
 929  FE92 F5                   PUSH AF
 930  FE93 85                   ADD A,L
 931  FE94 6F                   LD L,A
 932  FE95 F1                   POP AF
 933  FE96 C9                   RET
 934  FE97              ; ----------------------------------------------------------------------
 935  FE97              ; SELDSK_IMPL_1 (SELDSK) -- BIOS jump-vector entry 9: select the disk drive.
 936  FE97              ;   In:  C = disk number (0-based).  Out: HL = DPH address for drive C, or HL=0 if out
 937  FE97              ;     of range.  Clobbers: A,DE,HL.
 938  FE97              ;   Algorithm: DE -> the sekdsk build site (BIOS_BOOT_2, an install-template cell reused
 939  FE97              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
 940  FE97              ;     block (z80 $F3B8 = Apple $03B8, the Disk Count Byte); if C >= count return HL=0
 941  FE97              ;     (SELDSK_BAD_DRIVE). Else record the disk number, index DPH_TABLE by C*16 (CALL
 942  FE97              ;     SLOT_IOBASE_CALC), pull a per-drive disk-parameter byte and self-modify the install
 943  FE97              ;     template SECTOR_BLOCK_PATCH+1 with it. [DOC S&HD 2-26/2-27] Twin of the 2.23-44K SELDSK. [RE]
 944  FE97              ; ----------------------------------------------------------------------
 945  FE97              SELDSK_IMPL_1:
 946  FE97 11 EE FE             LD DE,BIOS_BOOT_2
 947  FE9A 21 04 00             LD HL,CDISK_ADDR
 948  FE9D 3A B8 F3             LD A,(SLOT_INFO_BASE)
 949  FEA0 3D                   DEC A
 950  FEA1 B9                   CP C
 951  FEA2 38 1D                JR C,SELDSK_BAD_DRIVE
 952  FEA4 7E                   LD A,(HL)
 953  FEA5 12                   LD (DE),A
 954  FEA6 13                   INC DE
 955  FEA7 79                   LD A,C
 956  FEA8 12                   LD (DE),A
 957  FEA9 21 33 FA             LD HL,DPH_TABLE
 958  FEAC CD 8E FE             CALL SLOT_IOBASE_CALC
 959  FEAF E5                   PUSH HL
 960  FEB0 11 0A 00             LD DE,$000A
 961  FEB3 19                   ADD HL,DE
 962  FEB4 5E                   LD E,(HL)
 963  FEB5 23                   INC HL
 964  FEB6 56                   LD D,(HL)
 965  FEB7 21 05 00             LD HL,BDOS
 966  FEBA 19                   ADD HL,DE
 967  FEBB 7E                   LD A,(HL)
 968  FEBC 32 FC FE             LD (SECTOR_BLOCK_PATCH+1),A
 969  FEBF E1                   POP HL
 970  FEC0 C9                   RET
 971  FEC1              ; ----------------------------------------------------------------------
 972  FEC1              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH).
 973  FEC1              ;   In:  DE -> sekdsk build site.  Out: HL=0.  Clobbers: A,L.
 974  FEC1              ;   Algorithm: restore the prior sekdsk byte, then LD L,$00 signals an invalid drive to
 975  FEC1              ;     the BDOS. Twin of the 2.23-44K SELDSK_BAD_DRIVE. [RE]
 976  FEC1              ; ----------------------------------------------------------------------
 977  FEC1              SELDSK_BAD_DRIVE:
 978  FEC1 1A                   LD A,(DE)
 979  FEC2 77                   LD (HL),A
 980  FEC3 2E 00                LD L,$00
 981  FEC5 C9                   RET
 982  FEC6              ; ----------------------------------------------------------------------
 983  FEC6              ; SELDSK_IMPL_3 (READ) -- BIOS jump-vector entry 13: read one 128-byte record.
 984  FEC6              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
 985  FEC6              ;   Algorithm: stash A at $E08B (a 6502-side RPC param cell = Apple $C08B), then OFF-IMAGE
 986  FEC6              ;     tail-jump to the deblock/RWTS read core at $B247 (below the BIOS, in the 60K
 987  FEC6              ;     system-image region). Unlike the 2.20 twin, the 2.23 BIOS does NOT carry the deblock
 988  FEC6              ;     in-image; READ/WRITE delegate to the $B2xx host-sector routines. [RE]
 989  FEC6              ; ----------------------------------------------------------------------
 990  FEC6              SELDSK_IMPL_3:
 991  FEC6 32 8B E0             LD ($E08B),A
 992  FEC9 C3 47 B2             JP $B247
 993  FECC              ; ----------------------------------------------------------------------
 994  FECC              ; SELDSK_IMPL_4 (WRITE) -- BIOS jump-vector entry 14: write one 128-byte record.
 995  FECC              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
 996  FECC              ;   Algorithm: stash A at $E08B (Apple $C08B RPC param), then OFF-IMAGE tail-jump to the
 997  FECC              ;     deblock/RWTS write core at $B257 (60K system-image region below the BIOS). Same
 998  FECC              ;     off-image RWTS delegation as SELDSK_IMPL_3 (READ). [RE]
 999  FECC              ; ----------------------------------------------------------------------
1000  FECC              SELDSK_IMPL_4:
1001  FECC 32 8B E0             LD ($E08B),A
1002  FECF C3 57 B2             JP $B257
1003  FED2 CD                   DEFB    $CD
1004  FED3 45 FB                DEFW    RPC_TRIGGER
1005  FED5 32 8B E0 C9          DEFB    $32,$8B,$E0,$C9,$32,$83,$E0,$2A,$0D,$DC,$E9,$32,$83,$E0,$C9
1005  FED9 32 83 E0 2A
1005  FEDD 0D DC E9 32
1005  FEE1 83 E0 C9
1006  FEE4              COL_FLAG:
1007  FEE4 00                   DEFB    $00
1008  FEE5              COL_PENDING:
1009  FEE5 00                   DEFB    $00
1010  FEE6              COL_STATE:
1011  FEE6 00 E9 FE 00          DEFB    $00,$E9,$FE,$00
1012  FEEA              ; ----------------------------------------------------------------------
1013  FEEA              ; BIOS_BOOT -- Z-80 cold-boot init: runs ONCE, then self-modifies ~a few dozen bytes.
1014  FEEA              ;   In:  entered once at cold start (the 60K reset-plant JPs here).  Out: enters the CCP
1015  FEEA              ;     via the sign-on tail; never re-executed.  Clobbers: all.
1016  FEEA              ;   Algorithm: set SP=$0100; NOP the $FA00 cold JP; load the default IOBYTE_ADDR ($95) into
1017  FEEA              ;     $0003; bind Z$CPU ($F3DE) into RPC_TRIGGER_STORE+1; clear CDISK_ADDR; install console/list/
1018  FEEA              ;     punch/reader handlers by Card Type Table class (device-6=Pascal-1.1, 5=parallel,
1019  FEEA              ;     4=Videx patches the status vector); re-run PROBE_DEVICES; clear screen; print banner.
1020  FEEA              ;   DUAL USE: the 'LD SP,$0100' operand bytes are reused post-boot as sektrk (BIOS_BOOT),
1021  FEEA              ;     seksec (BIOS_BOOT+1) and a cursor word (BIOS_BOOT+2). After it runs, $FEEA-$FF8D is
1022  FEEA              ;     dead scratch; the ~6 self-mods are cataloged in ../BOOT_AND_PATCHING.md section 3c.
1023  FEEA              ;     [DOC S&HD 2-24/2-25, 2-26/2-27] Twin of the 2.23-44K install engine. [RE]
1024  FEEA              ; ----------------------------------------------------------------------
1025  FEEA              BIOS_BOOT:
1026  FEEA 31 00 01             LD SP,TPA
1027  FEED              BIOS_BOOT_1:
1028  FEED AF                   XOR A
1029  FEEE              BIOS_BOOT_2:
1030  FEEE 21 00 FA             LD HL,BOOT
1031  FEF1              DISK_HSTACT:
1032  FEF1 77                   LD (HL),A
1033  FEF2              DISK_HSTWRT:
1034  FEF2 23                   INC HL
1035  FEF3 77                   LD (HL),A
1036  FEF4 23                   INC HL
1037  FEF5 77                   LD (HL),A
1038  FEF6              BOOT_TMPL_IOBYTE:
1039  FEF6 3E 95                LD A,$95
1040  FEF8              DISK_DMAADR:
1041  FEF8 32 03 00             LD (IOBYTE_ADDR),A
1042  FEFB              ; [DOC S&HD 2-24/2-25] Loads the SoftCard location from Z$CPU=$F3DE and binds it into the RPC
1043  FEFB              ;       dispatcher (patching RPC_TRIGGER_STORE+1) so subsequent 6502 calls switch via the right slot.
1044  FEFB              SECTOR_BLOCK_PATCH:
1045  FEFB 2A DE F3             LD HL,($F3DE)
1046  FEFE              BIOS_BOOT_8:
1047  FEFE 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1048  FF01 AF                   XOR A
1049  FF02 32 04 00             LD (CDISK_ADDR),A
1050  FF05              ; [DOC S&HD 2-26/2-27] Reads the slot-3 (console) Card Type Table entry at $F3BB ($F3B8+3). [AI] The
1051  FF05              ;       CP $06 test selects the POST-1980 device-6 / Pascal-1.1 console class (a 2.23 extension the
1052  FF05              ;       2.20 manual does NOT document; in 2.20 the Videx is type 4). On a match it points the
1053  FF05              ;       [DOC S&HD 2-18] I/O Vector Table Console Status cell ($F380) at the slot-3 console handler.
1054  FF05 3A BB F3             LD A,($F3BB)
1055  FF08 FE 06                CP $06
1056  FF0A 20 0A                JR NZ,DEV_INSTALL_LIST
1057  FF0C 21 99 FD             LD HL,CONST_SLOT3_TBL
1058  FF0F 22 80 F3             LD ($F380),HL
1059  FF12 D6 03                SUB $03
1060  FF14 18 13                JR DEV_INSTALL_PUNCH
1061  FF16              ; [DOC S&HD 2-26/2-27] Non-device-6 console path: dispatches on the slot-3 Card Type value. Value 5
1062  FF16              ;       (Apple Parallel Printer) skips ahead; values >=3 (serial / Videx-class / device-4) fall
1063  FF16              ;       through to install the console handlers; value 4 patches the slot-3 console-status vector below.
1064  FF16              DEV_INSTALL_LIST:
1065  FF16 FE 05                CP $05
1066  FF18 28 22                JR Z,BIOS_BOOT_11
1067  FF1A D6 03                SUB $03
1068  FF1C 38 1E                JR C,BIOS_BOOT_11
1069  FF1E 20 09                JR NZ,DEV_INSTALL_PUNCH
1070  FF20 21 15 FB             LD HL,CONST_VEC_PATCH
1071  FF23 36 BE                LD (HL),$BE
1072  FF25 23                   INC HL
1073  FF26 23                   INC HL
1074  FF27 36 1F                LD (HL),$1F
1075  FF29              DEV_INSTALL_PUNCH:
1076  FF29 F5                   PUSH AF
1077  FF2A CD 9D FF             CALL DEV_HANDLER_LOOKUP
1078  FF2D F1                   POP AF
1079  FF2E 22 B9 FC             LD (CONOUT_HANDLER_VEC),HL
1080  FF31 CD 98 FF             CALL GET_CONIN_HANDLER
1081  FF34 22 37 FB             LD (CONIN_HANDLER_VEC),HL
1082  FF37 3E 03                LD A,$03
1083  FF39 32 05 FB             LD (CCP_LAUNCH+1),A
1084  FF3C              ; [DOC S&HD 2-26/2-27] Reads the slot-1 Card Type Table entry at $F3B9 (SLTTYP base = slot 1, per
1085  FF3C              ;       Slot Function Assignments the LST: line-printer slot). For a recognized output card (value
1086  FF3C              ;       >=3 after SUB $03) it resolves and installs that card's output handler for the list device.
1087  FF3C              BIOS_BOOT_11:
1088  FF3C 3A B9 F3             LD A,($F3B9)
1089  FF3F D6 03                SUB $03
1090  FF41 38 06                JR C,INSTALL_DONE_DEVICES
1091  FF43 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1092  FF46 22 59 FE             LD (READER_HANDLER_TBL),HL
1093  FF49              ; [DOC S&HD 2-26/2-27] Reads the slot-2 Card Type Table entry at $F3BA ($F3B8+2) -- per Slot
1094  FF49              ;       Function Assignments the general-purpose PUN:/RDR: slot. For a recognized output card it
1095  FF49              ;       installs the punch handler; the value also drives the reader-handler selection below.
1096  FF49              INSTALL_DONE_DEVICES:
1097  FF49 3A BA F3             LD A,($F3BA)
1098  FF4C D6 03                SUB $03
1099  FF4E 38 14                JR C,BIOS_BOOT_14
1100  FF50 F5                   PUSH AF
1101  FF51 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1102  FF54 22 6D FE             LD (PUNCH_HANDLER_TBL),HL
1103  FF57 F1                   POP AF
1104  FF58              BIOS_BOOT_13:
1105  FF58 FE 02                CP $02
1106  FF5A 28 08                JR Z,BIOS_BOOT_14
1107  FF5C CD 98 FF             CALL GET_CONIN_HANDLER
1108  FF5F 22 73 FE             LD (AUX_DEV_VEC),HL
1109  FF62 18 0B                JR BIOS_BOOT_15
1110  FF64              BIOS_BOOT_14:
1111  FF64 21 3E 1A             LD HL,$1A3E
1112  FF67 22 72 FE             LD (AUX_DEV_STUB),HL
1113  FF6A 3E C9                LD A,$C9
1114  FF6C 32 74 FE             LD (AUX_DEV_VEC_HI),A
1115  FF6F              ; [DOC S&HD 2-14/2-15] Rescans the slots, then reads $F398 -- SSFTAB function #1, Clear Screen, the
1116  FF6F              ;       first entry of the Software Screen Function Table -- and emits it to home/clear the console
1117  FF6F              ;       before printing the sign-on banner.
1118  FF6F              BIOS_BOOT_15:
1119  FF6F CD 82 FA             CALL PROBE_DEVICES
1120  FF72 3A 98 F3             LD A,($F398)
1121  FF75 CD A8 FF             CALL BANNER_PUT_CHAR
1122  FF78 21 B7 FF             LD HL,SIGNON_BANNER
1123  FF7B              SIGNON_BANNER_LOOP:
1124  FF7B 7E                   LD A,(HL)
1125  FF7C B7                   OR A
1126  FF7D              BIOS_BOOT_17:
1127  FF7D CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1128  FF80 E5                   PUSH HL
1129  FF81 CD 4C FB             CALL CONOUT_SET_C
1130  FF84 E1                   POP HL
1131  FF85 23                   INC HL
1132  FF86 18 F3                JR SIGNON_BANNER_LOOP
1133  FF88              CONOUT_VEC_TABLE:
1134  FF88 0E FD 71 FD          DEFB    $0E,$FD,$71,$FD,$5B,$FE,$A9,$FD
1134  FF8C 5B FE A9 FD
1135  FF90              CONIN_VEC_TABLE:
1136  FF90 4B FE C1 FD          DEFB    $4B,$FE,$C1,$FD,$B7,$FD,$B7,$FD
1136  FF94 B7 FD B7 FD
1137  FF98              ; ----------------------------------------------------------------------
1138  FF98              ; GET_CONIN_HANDLER -- fetch a console-input handler address from CONIN_VEC_TABLE.
1139  FF98              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1140  FF98              ;   Algorithm: HL = CONIN_VEC_TABLE base, then fall into the shared index tail
1141  FF98              ;     (HANDLER_TBL_INDEX: HL += A*2; load the word). Twin of the 2.23-44K
1142  FF98              ;     DEV_HANDLER_LOOKUP_B family. [RE]
1143  FF98              ; ----------------------------------------------------------------------
1144  FF98              GET_CONIN_HANDLER:
1145  FF98 21 90 FF             LD HL,CONIN_VEC_TABLE
1146  FF9B 18 03                JR HANDLER_TBL_INDEX
1147  FF9D              ; ----------------------------------------------------------------------
1148  FF9D              ; DEV_HANDLER_LOOKUP -- fetch a console-output handler address from CONOUT_VEC_TABLE.
1149  FF9D              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1150  FF9D              ;   Algorithm: HL = CONOUT_VEC_TABLE base, fall into HANDLER_TBL_INDEX (HL += A*2; load
1151  FF9D              ;     the 16-bit word low-then-high). Twin of the 2.23-44K DEV_HANDLER_LOOKUP. [RE]
1152  FF9D              ; ----------------------------------------------------------------------
1153  FF9D              DEV_HANDLER_LOOKUP:
1154  FF9D 21 88 FF             LD HL,CONOUT_VEC_TABLE
1155  FFA0              HANDLER_TBL_INDEX:
1156  FFA0 87                   ADD A,A
1157  FFA1              HANDLER_TBL_FETCH:
1158  FFA1 85                   ADD A,L
1159  FFA2 6F                   LD L,A
1160  FFA3 7E                   LD A,(HL)
1161  FFA4 2C                   INC L
1162  FFA5 66                   LD H,(HL)
1163  FFA6 6F                   LD L,A
1164  FFA7 C9                   RET
1165  FFA8              ; [AI] Banner character emitter: if the byte is positive (high bit clear) it outputs it directly; if
1166  FFA8              ;       negative it first emits the software lead-in. [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the
1167  FFA8              ;       Software function lead-in character, sent ahead of the byte for the high-bit-set case.
1168  FFA8              ; ----------------------------------------------------------------------
1169  FFA8              ; BANNER_PUT_CHAR -- emit one sign-on byte, optionally preceded by a lead-in char.
1170  FFA8              ;   In:  A = byte/flag.  Out: prints via CONOUT_SET_C.  Clobbers: A,HL.
1171  FFA8              ;   Algorithm: if A is positive (bit7 clear) tail-jump to emit it directly
1172  FFA8              ;     (BANNER_EMIT_CHAR); if negative, first emit the software lead-in char from config
1173  FFA8              ;     $F397 (SFLDIN, [DOC S&HD 2-14/2-15]) via CONOUT_SET_C, then emit A. Twin of the
1174  FFA8              ;     2.23-44K SIGNON_EMIT. [RE]
1175  FFA8              ; ----------------------------------------------------------------------
1176  FFA8              BANNER_PUT_CHAR:
1177  FFA8 B7                   OR A
1178  FFA9 F2 B4 FF             JP P,BANNER_EMIT_CHAR
1179  FFAC F5                   PUSH AF
1180  FFAD              BANNER_PUT_ATTR:
1181  FFAD 3A 97 F3             LD A,($F397)
1182  FFB0 CD 4C FB             CALL CONOUT_SET_C
1183  FFB3              BANNER_RESTORE_A:
1184  FFB3 F1                   POP AF
1185  FFB4              BANNER_EMIT_CHAR:
1186  FFB4 C3 4C FB             JP CONOUT_SET_C
1187  FFB7              ; [AI] Cold-boot sign-on banner emitted by the loop above: "Softcard CP/M / 60K Ver. 2.23 / (c)
1188  FFB7              ;       1980,1982 Microsoft". This is the POST-1980 60K / 2.23 variant; the 2.20 manual documents only
1189  FFB7              ;       the "APPLE II CP/M / 44K vers. 2.2X / (C) 1980 MICROSOFT" 44K/56K banner (S&HD 1-8), so the
1190  FFB7              ;       "60K"/"2.23"/"1982" tokens here are version-specific, not manual-backed.
1191  FFB7              SIGNON_BANNER:
1192  FFB7 0D 0A 0A 0A          DEFB    $0D,$0A,$0A,$0A,$20,$20,$20,$20,$20,$53,$6F,$66,$74,$63,$61,$72
1192  FFBB 20 20 20 20
1192  FFBF 20 53 6F 66
1192  FFC3 74 63 61 72
1193  FFC7 64 20 43 50          DEFB    "d CP/M"                 ; string
1193  FFCB 2F 4D
1194  FFCD 0D                   DEFB    $0D                      ; terminator
1195  FFCE 0A 20 20 20          DEFB    $0A,$20,$20,$20,$20,$20,$36,$30,$4B,$20,$56,$65,$72,$2E,$20,$32
1195  FFD2 20 20 36 30
1195  FFD6 4B 20 56 65
1195  FFDA 72 2E 20 32
1196  FFDE 2E 32 33 0D          DEFB    $2E,$32,$33,$0D,$0A,$28,$63,$29,$20,$31,$39,$38,$30,$2C,$31,$39
1196  FFE2 0A 28 63 29
1196  FFE6 20 31 39 38
1196  FFEA 30 2C 31 39
1197  FFEE 38 32 20 4D          DEFB    "82 Microsoft"           ; string
1197  FFF2 69 63 72 6F
1197  FFF6 73 6F 66 74
1198  FFFA 0D                   DEFB    $0D                      ; terminator
1199  FFFB 0A 0D 0A             DEFB    $0A,$0D,$0A
1200  FFFE 00 FA                DEFW    BOOT
1201  0000
1202  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1203  0000
1204  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
1205  0000                  ; Image size from its bracketing labels, not a magic length, as in the 2.23-44K twin:
1206  0000                  ; an overrun fails the build here instead of being silently truncated by SAVEBIN.
1207  0000                  ; $FA00 = the ORG base; the subtraction wraps because the image ends at $10000.
1208  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1209  0000                  ENDIF
1210  0000
1211  0000              ; ----------------------------------------------------------------------
1212  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEFD-$FFF4.
1213  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above (the region the file
1214  0000              ;   header describes as dead after BIOS_BOOT has run). It runs once at cold start; only
1215  0000              ;   afterwards does the disk system reuse them as the buffers DPH_TABLE hands out. The
1216  0000              ;   two tenants are never live at the same time.
1217  0000              ;
1218  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1219  0000              ;   at the overlay base, then one label per field with its extent carried in the
1220  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1221  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1222  0000              ;   the image. Under the CPM60.COM master link this file is assembled inside a
1223  0000              ;   DISP $FA00 block, where sjasmplus moves only the displacement address and leaves
1224  0000              ;   the physical output pointer alone, so the ORGs are safe there too.
1225  0000              ;
1226  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1227  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1228  0000              ;   cold boot has finished. Same shape and names as the 2.20-44K and 2.23-44K twins;
1229  0000              ;   only the addresses differ. [RE]
1230  0000              ; ----------------------------------------------------------------------
1231  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1232  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1233  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1234  0000              CSV_SIZE     EQU 12                   ; = CKS
1235  0000
1236  0000                      ORG $FEFD                     ; the one given: where the author placed the overlay
1237  FEFD              DIRBUF:                               ; shared directory buffer, one per system
1238  FEFD                      ORG DIRBUF + DIRBUF_SIZE
1239  FF7D              ALV_VECTORS:                          ; per-drive allocation vectors ($FF7D..)
1240  FF7D                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1241  FFC5              CSV_VECTORS:                          ; per-drive checksum vectors ($FFC5..)
1242  FFC5                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1243  FFF5              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFF5)
1244  FFF5
1245  FFF5                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1246  FFF5                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1247  FFF5                  ASSERT ALV_VECTORS == $FF7D
1248  FFF5                  ASSERT CSV_VECTORS == $FFC5
1249  FFF5                  ASSERT BIOS_SCRATCH_END == $FFF5
1250  FFF5
# file closed: CPM_BIOS.asm

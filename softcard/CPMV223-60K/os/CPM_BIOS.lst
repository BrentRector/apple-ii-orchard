 802  FD0F 8A FE                DEFW    SLOT_IO_ADDR
 803  FD11 C6 8F CB 4E          DEFB    $C6,$8F,$CB,$4E,$28,$FC,$21,$2F,$F0,$36,$60,$2B,$36,$C0,$2B,$77
 803  FD15 28 FC 21 2F
 803  FD19 F0 36 60 2B
 803  FD1D 36 C0 2B 77
 804  FD21 2B 36 8D 62          DEFB    $2B,$36,$8D,$62,$C3,$7C,$FD,$3E,$FF,$01,$3E,$3F,$32,$32,$F0,$E1

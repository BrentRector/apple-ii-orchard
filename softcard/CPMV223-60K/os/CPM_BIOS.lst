 866  FE4C 8A FE                DEFW    SLOT_IO_ADDR
 867  FE4E 7E 1F 30 FC          DEFB    $7E,$1F,$30,$FC,$2C,$7E,$C9,$11,$01,$00,$C3
 867  FE52 2C 7E C9 11
 867  FE56 01 00 C3
 868  FE59              READER_HANDLER_TBL:
 869  FE59 68 FE CD             DEFB    $68,$FE,$CD
 870  FE5C B1 FA                DEFW    SLOT_E000_ADDR
 871  FE5E 2E C1 7E 17          DEFB    $2E,$C1,$7E,$17,$38,$FC,$CD

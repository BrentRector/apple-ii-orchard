 888  FE75              ; ----------------------------------------------------------------------
 889  FE75              ; INIT_PASCAL_1_1_1 (HOME) -- BIOS jump-vector entry 8: seek the drive to track 0.
 890  FE75              ;   In:  none.  Out: none (falls into SETTRK's store with track 0).  Clobbers: A,C.
 891  FE75              ;   Algorithm: read the host-write-pending template cell (DISK_HSTWRT); if a write is
 892  FE75              ;     pending keep the host-active flag, else clear DISK_HSTACT; then fall into
 893  FE75              ;     INIT_PASCAL_1_1_3/_4 (SETTRK) with track 0. The actual head step happens later in
 894  FE75              ;     the off-image deblock path. Twin of the 2.23-44K HOME/SETTRK_STORE. [RE]
 895  FE75              ; ----------------------------------------------------------------------
 896  FE75              INIT_PASCAL_1_1_1:
 897  FE75 3A F2 FE             LD A,(DISK_HSTWRT)
 898  FE78 B7                   OR A
 899  FE79              INIT_PASCAL_1_1_2:
 900  FE79 20 03                JR NZ,INIT_PASCAL_1_1_3
 901  FE7B 32 F1 FE             LD (DISK_HSTACT),A
 902  FE7E              INIT_PASCAL_1_1_3:
 903  FE7E 0E 00                LD C,$00
 904  FE80              ; ----------------------------------------------------------------------
 905  FE80              ; SETTRK_STORE (SETTRK) -- BIOS jump-vector entry 10: set the requested track.
 906  FE80              ;   In:  C = track number.  Out: none.  Clobbers: A.
 907  FE80              ;   Algorithm: LD A,C then store into the sektrk cell BIOS_BOOT ($FEEA = the cold-boot
 908  FE80              ;     LD SP operand byte reused post-boot as sektrk). HOME enters this common tail with
 909  FE80              ;     track 0. Twin of the 2.23-44K SETTRK_STORE tail. [RE]
 910  FE80              ; ----------------------------------------------------------------------
 911  FE80              SETTRK_STORE:
 912  FE80 79                   LD A,C
 913  FE81 32 EA FE             LD (BIOS_BOOT),A
 914  FE84 C9                   RET
 915  FE85              ; ----------------------------------------------------------------------
 916  FE85              ; SLOT_IO_ADDR_W -- map a slot/drive index to the Apple $C080 write/control-bank base.
 917  FE85              ;   In:  E = slot/drive index (0..15).  Out: HL = $E080 + (E<<4).  Clobbers: A,L.
 918  FE85              ;   Algorithm: load z80 $E080 = Apple $C080, then fall into the shared index scaler
 919  FE85              ;     (SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR_W. [RE]
 920  FE85              ; ----------------------------------------------------------------------
 921  FE85              SLOT_IO_ADDR_W:
 922  FE85 21 80 E0             LD HL,$E080
 923  FE88 18 03                JR SLOT_IO_SCALE_E
 924  FE8A              ; ----------------------------------------------------------------------
 925  FE8A              ; SLOT_IO_ADDR -- map a slot/drive index to the Apple $C08E slot-I/O base.
 926  FE8A              ;   In:  E = slot/drive index (0..15).  Out: HL = $E08E + (E<<4).  Clobbers: A,L.
 927  FE8A              ;   Algorithm: load z80 $E08E = Apple $C08E, then fall into the shared index scaler
 928  FE8A              ;     (SLOT_IO_SCALE_E -> SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR. [RE]
 929  FE8A              ; ----------------------------------------------------------------------
 930  FE8A              SLOT_IO_ADDR:
 931  FE8A 21 8E E0             LD HL,$E08E
 932  FE8D              SLOT_IO_SCALE_E:
 933  FE8D 7B                   LD A,E
 934  FE8E              ; ----------------------------------------------------------------------
 935  FE8E              ; SLOT_IOBASE_CALC -- shift the index left by 4 and add to L (index a 16-byte block).
 936  FE8E              ;   In:  A = index (via SLOT_IO_SCALE_E from E), L = base low byte.  Out: L += A*16;
 937  FE8E              ;     A preserved.  Clobbers: A,L.
 938  FE8E              ;   Algorithm: ADD A,A x4 (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET. Shared by
 939  FE8E              ;     SLOT_IO_ADDR_W/_8E and by SELDSK (DPH-table index) and PROBE_DEVICES. Twin of the
 940  FE8E              ;     2.23-44K SLOT_IO_SCALE. [RE]
 941  FE8E              ; ----------------------------------------------------------------------
 942  FE8E              SLOT_IOBASE_CALC:
 943  FE8E 87                   ADD A,A
 944  FE8F 87                   ADD A,A
 945  FE90 87                   ADD A,A
 946  FE91 87                   ADD A,A
 947  FE92 F5                   PUSH AF
 948  FE93 85                   ADD A,L
 949  FE94 6F                   LD L,A
 950  FE95 F1                   POP AF
 951  FE96 C9                   RET
 952  FE97              ; ----------------------------------------------------------------------
 953  FE97              ; SELDSK_IMPL_1 (SELDSK) -- BIOS jump-vector entry 9: select the disk drive.
 954  FE97              ;   In:  C = disk number (0-based).  Out: HL = DPH address for drive C, or HL=0 if out
 955  FE97              ;     of range.  Clobbers: A,DE,HL.
 956  FE97              ;   Algorithm: DE -> the sekdsk build site (BIOS_BOOT_2, an install-template cell reused
 957  FE97              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
 958  FE97              ;     block (z80 $F3B8 = Apple $03B8, the Disk Count Byte); if C >= count return HL=0
 959  FE97              ;     (SELDSK_BAD_DRIVE). Else record the disk number, index DPH_TABLE by C*16 (CALL
 960  FE97              ;     SLOT_IOBASE_CALC), pull a per-drive disk-parameter byte and self-modify the install
 961  FE97              ;     template SECTOR_BLOCK_PATCH+1 with it. [DOC S&HD 2-26/2-27] Twin of the 2.23-44K SELDSK. [RE]
 962  FE97              ; ----------------------------------------------------------------------
 963  FE97              SELDSK_IMPL_1:
 964  FE97 11 EE FE             LD DE,BIOS_BOOT_2
 965  FE9A 21 04 00             LD HL,CDISK_ADDR
 966  FE9D 3A B8 F3             LD A,(SLOT_INFO_BASE)
 967  FEA0 3D                   DEC A
 968  FEA1 B9                   CP C
 969  FEA2 38 1D                JR C,SELDSK_BAD_DRIVE
 970  FEA4 7E                   LD A,(HL)
 971  FEA5 12                   LD (DE),A
 972  FEA6 13                   INC DE
 973  FEA7 79                   LD A,C
 974  FEA8 12                   LD (DE),A
 975  FEA9 21 33 FA             LD HL,DPH_TABLE
 976  FEAC CD 8E FE             CALL SLOT_IOBASE_CALC
 977  FEAF E5                   PUSH HL
 978  FEB0 11 0A 00             LD DE,$000A
 979  FEB3 19                   ADD HL,DE
 980  FEB4 5E                   LD E,(HL)
 981  FEB5 23                   INC HL
 982  FEB6 56                   LD D,(HL)
 983  FEB7 21 05 00             LD HL,BDOS
 984  FEBA 19                   ADD HL,DE
 985  FEBB 7E                   LD A,(HL)
 986  FEBC 32 FC FE             LD (SECTOR_BLOCK_PATCH+1),A
 987  FEBF E1                   POP HL
 988  FEC0 C9                   RET
 989  FEC1              ; ----------------------------------------------------------------------
 990  FEC1              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH).
 991  FEC1              ;   In:  DE -> sekdsk build site.  Out: HL=0.  Clobbers: A,L.
 992  FEC1              ;   Algorithm: restore the prior sekdsk byte, then LD L,$00 signals an invalid drive to
 993  FEC1              ;     the BDOS. Twin of the 2.23-44K SELDSK_BAD_DRIVE. [RE]
 994  FEC1              ; ----------------------------------------------------------------------
 995  FEC1              SELDSK_BAD_DRIVE:
 996  FEC1 1A                   LD A,(DE)
 997  FEC2 77                   LD (HL),A
 998  FEC3 2E 00                LD L,$00
 999  FEC5 C9                   RET
1000  FEC6              ; ----------------------------------------------------------------------
1001  FEC6              ; SELDSK_IMPL_3 (READ) -- BIOS jump-vector entry 13: read one 128-byte record.
1002  FEC6              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
1003  FEC6              ;   Algorithm: stash A at $E08B (a 6502-side RPC param cell = Apple $C08B), then OFF-IMAGE
1004  FEC6              ;     tail-jump to the deblock/RWTS read core at $B247 (below the BIOS, in the 60K
1005  FEC6              ;     system-image region). Unlike the 2.20 twin, the 2.23 BIOS does NOT carry the deblock
1006  FEC6              ;     in-image; READ/WRITE delegate to the $B2xx host-sector routines. [RE]
1007  FEC6              ; ----------------------------------------------------------------------
1008  FEC6              SELDSK_IMPL_3:
1009  FEC6 32 8B E0             LD ($E08B),A
1010  FEC9 C3 47 B2             JP $B247
1011  FECC              ; ----------------------------------------------------------------------
1012  FECC              ; SELDSK_IMPL_4 (WRITE) -- BIOS jump-vector entry 14: write one 128-byte record.
1013  FECC              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
1014  FECC              ;   Algorithm: stash A at $E08B (Apple $C08B RPC param), then OFF-IMAGE tail-jump to the
1015  FECC              ;     deblock/RWTS write core at $B257 (60K system-image region below the BIOS). Same
1016  FECC              ;     off-image RWTS delegation as SELDSK_IMPL_3 (READ). [RE]
1017  FECC              ; ----------------------------------------------------------------------
1018  FECC              SELDSK_IMPL_4:
1019  FECC 32 8B E0             LD ($E08B),A
1020  FECF C3 57 B2             JP $B257
1021  FED2 CD                   DEFB    $CD
1022  FED3 45 FB                DEFW    RPC_TRIGGER
1023  FED5 32 8B E0 C9          DEFB    $32,$8B,$E0,$C9,$32,$83,$E0,$2A,$0D,$DC,$E9,$32,$83,$E0,$C9
1023  FED9 32 83 E0 2A
1023  FEDD 0D DC E9 32
1023  FEE1 83 E0 C9
1024  FEE4              COL_FLAG:
1025  FEE4 00                   DEFB    $00
1026  FEE5              COL_PENDING:
1027  FEE5 00                   DEFB    $00
1028  FEE6              COL_STATE:
1029  FEE6 00 E9 FE 00          DEFB    $00,$E9,$FE,$00
1030  FEEA              ; ----------------------------------------------------------------------
1031  FEEA              ; BIOS_BOOT -- Z-80 cold-boot init: runs ONCE, then self-modifies ~a few dozen bytes.
1032  FEEA              ;   In:  entered once at cold start (the 60K reset-plant JPs here).  Out: enters the CCP
1033  FEEA              ;     via the sign-on tail; never re-executed.  Clobbers: all.
1034  FEEA              ;   Algorithm: set SP=$0100; NOP the $FA00 cold JP; load the default IOBYTE_ADDR ($95) into
1035  FEEA              ;     $0003; bind Z$CPU ($F3DE) into RPC_TRIGGER_STORE+1; clear CDISK_ADDR; install console/list/
1036  FEEA              ;     punch/reader handlers by Card Type Table class (device-6=Pascal-1.1, 5=parallel,
1037  FEEA              ;     4=Videx patches the status vector); re-run PROBE_DEVICES; clear screen; print banner.
1038  FEEA              ;   DUAL USE: the 'LD SP,$0100' operand bytes are reused post-boot as sektrk (BIOS_BOOT),
1039  FEEA              ;     seksec (BIOS_BOOT+1) and a cursor word (BIOS_BOOT+2). After it runs, $FEEA-$FF8D is
1040  FEEA              ;     dead scratch; the ~6 self-mods are cataloged in ../BOOT_AND_PATCHING.md section 3c.
1041  FEEA              ;     [DOC S&HD 2-24/2-25, 2-26/2-27] Twin of the 2.23-44K install engine. [RE]
1042  FEEA              ; ----------------------------------------------------------------------
1043  FEEA              BIOS_BOOT:
1044  FEEA 31 00 01             LD SP,TPA
1045  FEED              BIOS_BOOT_1:
1046  FEED AF                   XOR A
1047  FEEE              BIOS_BOOT_2:
1048  FEEE 21 00 FA             LD HL,BOOT
1049  FEF1              DISK_HSTACT:
1050  FEF1 77                   LD (HL),A
1051  FEF2              DISK_HSTWRT:
1052  FEF2 23                   INC HL
1053  FEF3 77                   LD (HL),A
1054  FEF4 23                   INC HL
1055  FEF5 77                   LD (HL),A
1056  FEF6              BOOT_TMPL_IOBYTE:
1057  FEF6 3E 95                LD A,$95
1058  FEF8              DISK_DMAADR:
1059  FEF8 32 03 00             LD (IOBYTE_ADDR),A
1060  FEFB              ; [DOC S&HD 2-24/2-25] Loads the SoftCard location from Z$CPU=$F3DE and binds it into the RPC
1061  FEFB              ;       dispatcher (patching RPC_TRIGGER_STORE+1) so subsequent 6502 calls switch via the right slot.
1062  FEFB              SECTOR_BLOCK_PATCH:
1063  FEFB 2A DE F3             LD HL,($F3DE)
1064  FEFE              BIOS_BOOT_8:
1065  FEFE 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1066  FF01 AF                   XOR A
1067  FF02 32 04 00             LD (CDISK_ADDR),A
1068  FF05              ; [DOC S&HD 2-26/2-27] Reads the slot-3 (console) Card Type Table entry at $F3BB ($F3B8+3). [AI] The
1069  FF05              ;       CP $06 test selects the POST-1980 device-6 / Pascal-1.1 console class (a 2.23 extension the
1070  FF05              ;       2.20 manual does NOT document; in 2.20 the Videx is type 4). On a match it points the
1071  FF05              ;       [DOC S&HD 2-18] I/O Vector Table Console Status cell ($F380) at the slot-3 console handler.
1072  FF05 3A BB F3             LD A,($F3BB)
1073  FF08 FE 06                CP $06
1074  FF0A 20 0A                JR NZ,DEV_INSTALL_LIST
1075  FF0C 21 99 FD             LD HL,CONST_SLOT3_TBL
1076  FF0F 22 80 F3             LD ($F380),HL
1077  FF12 D6 03                SUB $03
1078  FF14 18 13                JR DEV_INSTALL_PUNCH
1079  FF16              ; [DOC S&HD 2-26/2-27] Non-device-6 console path: dispatches on the slot-3 Card Type value. Value 5
1080  FF16              ;       (Apple Parallel Printer) skips ahead; values >=3 (serial / Videx-class / device-4) fall
1081  FF16              ;       through to install the console handlers; value 4 patches the slot-3 console-status vector below.
1082  FF16              DEV_INSTALL_LIST:
1083  FF16 FE 05                CP $05
1084  FF18 28 22                JR Z,BIOS_BOOT_11
1085  FF1A D6 03                SUB $03
1086  FF1C 38 1E                JR C,BIOS_BOOT_11
1087  FF1E 20 09                JR NZ,DEV_INSTALL_PUNCH
1088  FF20 21 15 FB             LD HL,CONST_VEC_PATCH
1089  FF23 36 BE                LD (HL),$BE
1090  FF25 23                   INC HL
1091  FF26 23                   INC HL
1092  FF27 36 1F                LD (HL),$1F
1093  FF29              DEV_INSTALL_PUNCH:
1094  FF29 F5                   PUSH AF
1095  FF2A CD 9D FF             CALL DEV_HANDLER_LOOKUP
1096  FF2D F1                   POP AF
1097  FF2E 22 B9 FC             LD (CONOUT_HANDLER_VEC),HL
1098  FF31 CD 98 FF             CALL GET_CONIN_HANDLER
1099  FF34 22 37 FB             LD (CONIN_HANDLER_VEC),HL
1100  FF37 3E 03                LD A,$03
1101  FF39 32 05 FB             LD (CCP_LAUNCH+1),A
1102  FF3C              ; [DOC S&HD 2-26/2-27] Reads the slot-1 Card Type Table entry at $F3B9 (SLTTYP base = slot 1, per
1103  FF3C              ;       Slot Function Assignments the LST: line-printer slot). For a recognized output card (value
1104  FF3C              ;       >=3 after SUB $03) it resolves and installs that card's output handler for the list device.
1105  FF3C              BIOS_BOOT_11:
1106  FF3C 3A B9 F3             LD A,($F3B9)
1107  FF3F D6 03                SUB $03
1108  FF41 38 06                JR C,INSTALL_DONE_DEVICES
1109  FF43 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1110  FF46 22 59 FE             LD (READER_HANDLER_TBL),HL
1111  FF49              ; [DOC S&HD 2-26/2-27] Reads the slot-2 Card Type Table entry at $F3BA ($F3B8+2) -- per Slot
1112  FF49              ;       Function Assignments the general-purpose PUN:/RDR: slot. For a recognized output card it
1113  FF49              ;       installs the punch handler; the value also drives the reader-handler selection below.
1114  FF49              INSTALL_DONE_DEVICES:
1115  FF49 3A BA F3             LD A,($F3BA)
1116  FF4C D6 03                SUB $03
1117  FF4E 38 14                JR C,BIOS_BOOT_14
1118  FF50 F5                   PUSH AF
1119  FF51 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1120  FF54 22 6D FE             LD (PUNCH_HANDLER_TBL),HL
1121  FF57 F1                   POP AF
1122  FF58              BIOS_BOOT_13:
1123  FF58 FE 02                CP $02
1124  FF5A 28 08                JR Z,BIOS_BOOT_14
1125  FF5C CD 98 FF             CALL GET_CONIN_HANDLER
1126  FF5F 22 73 FE             LD (AUX_DEV_VEC),HL
1127  FF62 18 0B                JR BIOS_BOOT_15
1128  FF64              BIOS_BOOT_14:
1129  FF64 21 3E 1A             LD HL,$1A3E
1130  FF67 22 72 FE             LD (AUX_DEV_STUB),HL
1131  FF6A 3E C9                LD A,$C9
1132  FF6C 32 74 FE             LD (AUX_DEV_VEC_HI),A
1133  FF6F              ; [DOC S&HD 2-14/2-15] Rescans the slots, then reads $F398 -- SSFTAB function #1, Clear Screen, the
1134  FF6F              ;       first entry of the Software Screen Function Table -- and emits it to home/clear the console
1135  FF6F              ;       before printing the sign-on banner.
1136  FF6F              BIOS_BOOT_15:
1137  FF6F CD 82 FA             CALL PROBE_DEVICES
1138  FF72 3A 98 F3             LD A,($F398)
1139  FF75 CD A8 FF             CALL BANNER_PUT_CHAR
1140  FF78 21 B7 FF             LD HL,SIGNON_BANNER
1141  FF7B              SIGNON_BANNER_LOOP:
1142  FF7B 7E                   LD A,(HL)
1143  FF7C B7                   OR A
1144  FF7D              BIOS_BOOT_17:
1145  FF7D CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1146  FF80 E5                   PUSH HL
1147  FF81 CD 4C FB             CALL CONOUT_SET_C
1148  FF84 E1                   POP HL
1149  FF85 23                   INC HL
1150  FF86 18 F3                JR SIGNON_BANNER_LOOP
1151  FF88              CONOUT_VEC_TABLE:
1152  FF88 0E FD 71 FD          DEFB    $0E,$FD,$71,$FD,$5B,$FE,$A9,$FD
1152  FF8C 5B FE A9 FD
1153  FF90              CONIN_VEC_TABLE:
1154  FF90 4B FE C1 FD          DEFB    $4B,$FE,$C1,$FD,$B7,$FD,$B7,$FD
1154  FF94 B7 FD B7 FD
1155  FF98              ; ----------------------------------------------------------------------
1156  FF98              ; GET_CONIN_HANDLER -- fetch a console-input handler address from CONIN_VEC_TABLE.
1157  FF98              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1158  FF98              ;   Algorithm: HL = CONIN_VEC_TABLE base, then fall into the shared index tail
1159  FF98              ;     (HANDLER_TBL_INDEX: HL += A*2; load the word). Twin of the 2.23-44K
1160  FF98              ;     DEV_HANDLER_LOOKUP_B family. [RE]
1161  FF98              ; ----------------------------------------------------------------------
1162  FF98              GET_CONIN_HANDLER:
1163  FF98 21 90 FF             LD HL,CONIN_VEC_TABLE
1164  FF9B 18 03                JR HANDLER_TBL_INDEX
1165  FF9D              ; ----------------------------------------------------------------------
1166  FF9D              ; DEV_HANDLER_LOOKUP -- fetch a console-output handler address from CONOUT_VEC_TABLE.
1167  FF9D              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1168  FF9D              ;   Algorithm: HL = CONOUT_VEC_TABLE base, fall into HANDLER_TBL_INDEX (HL += A*2; load
1169  FF9D              ;     the 16-bit word low-then-high). Twin of the 2.23-44K DEV_HANDLER_LOOKUP. [RE]
1170  FF9D              ; ----------------------------------------------------------------------
1171  FF9D              DEV_HANDLER_LOOKUP:
1172  FF9D 21 88 FF             LD HL,CONOUT_VEC_TABLE
1173  FFA0              HANDLER_TBL_INDEX:
1174  FFA0 87                   ADD A,A
1175  FFA1              HANDLER_TBL_FETCH:
1176  FFA1 85                   ADD A,L
1177  FFA2 6F                   LD L,A
1178  FFA3 7E                   LD A,(HL)
1179  FFA4 2C                   INC L
1180  FFA5 66                   LD H,(HL)
1181  FFA6 6F                   LD L,A
1182  FFA7 C9                   RET
1183  FFA8              ; [AI] Banner character emitter: if the byte is positive (high bit clear) it outputs it directly; if
1184  FFA8              ;       negative it first emits the software lead-in. [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the
1185  FFA8              ;       Software function lead-in character, sent ahead of the byte for the high-bit-set case.
1186  FFA8              ; ----------------------------------------------------------------------
1187  FFA8              ; BANNER_PUT_CHAR -- emit one sign-on byte, optionally preceded by a lead-in char.
1188  FFA8              ;   In:  A = byte/flag.  Out: prints via CONOUT_SET_C.  Clobbers: A,HL.
1189  FFA8              ;   Algorithm: if A is positive (bit7 clear) tail-jump to emit it directly
1190  FFA8              ;     (BANNER_EMIT_CHAR); if negative, first emit the software lead-in char from config
1191  FFA8              ;     $F397 (SFLDIN, [DOC S&HD 2-14/2-15]) via CONOUT_SET_C, then emit A. Twin of the
1192  FFA8              ;     2.23-44K SIGNON_EMIT. [RE]
1193  FFA8              ; ----------------------------------------------------------------------
1194  FFA8              BANNER_PUT_CHAR:
1195  FFA8 B7                   OR A
1196  FFA9 F2 B4 FF             JP P,BANNER_EMIT_CHAR
1197  FFAC F5                   PUSH AF
1198  FFAD              BANNER_PUT_ATTR:
1199  FFAD 3A 97 F3             LD A,($F397)
1200  FFB0 CD 4C FB             CALL CONOUT_SET_C
1201  FFB3              BANNER_RESTORE_A:
1202  FFB3 F1                   POP AF
1203  FFB4              BANNER_EMIT_CHAR:
1204  FFB4 C3 4C FB             JP CONOUT_SET_C
1205  FFB7              ; [AI] Cold-boot sign-on banner emitted by the loop above: "Softcard CP/M / 60K Ver. 2.23 / (c)
1206  FFB7              ;       1980,1982 Microsoft". This is the POST-1980 60K / 2.23 variant; the 2.20 manual documents only
1207  FFB7              ;       the "APPLE II CP/M / 44K vers. 2.2X / (C) 1980 MICROSOFT" 44K/56K banner (S&HD 1-8), so the
1208  FFB7              ;       "60K"/"2.23"/"1982" tokens here are version-specific, not manual-backed.
1209  FFB7              SIGNON_BANNER:
1210  FFB7 0D 0A 0A 0A          DEFB    $0D,$0A,$0A,$0A,$20,$20,$20,$20,$20,$53,$6F,$66,$74,$63,$61,$72
1210  FFBB 20 20 20 20
1210  FFBF 20 53 6F 66
1210  FFC3 74 63 61 72
1211  FFC7 64 20 43 50          DEFB    "d CP/M"                 ; string
1211  FFCB 2F 4D
1212  FFCD 0D                   DEFB    $0D                      ; terminator
1213  FFCE 0A 20 20 20          DEFB    $0A,$20,$20,$20,$20,$20,$36,$30,$4B,$20,$56,$65,$72,$2E,$20,$32
1213  FFD2 20 20 36 30
1213  FFD6 4B 20 56 65
1213  FFDA 72 2E 20 32
1214  FFDE 2E 32 33 0D          DEFB    $2E,$32,$33,$0D,$0A,$28,$63,$29,$20,$31,$39,$38,$30,$2C,$31,$39
1214  FFE2 0A 28 63 29
1214  FFE6 20 31 39 38
1214  FFEA 30 2C 31 39
1215  FFEE 38 32 20 4D          DEFB    "82 Microsoft"           ; string
1215  FFF2 69 63 72 6F
1215  FFF6 73 6F 66 74
1216  FFFA 0D                   DEFB    $0D                      ; terminator
1217  FFFB 0A 0D 0A             DEFB    $0A,$0D,$0A
1218  FFFE 00 FA                DEFW    BOOT
1219  0000
1220  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1221  0000
1222  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
1223  0000                  ; Image size from its bracketing labels, not a magic length, as in the 2.23-44K twin:
1224  0000                  ; an overrun fails the build here instead of being silently truncated by SAVEBIN.
1225  0000                  ; $FA00 = the ORG base; the subtraction wraps because the image ends at $10000.
1226  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1227  0000                  ENDIF
1228  0000
1229  0000              ; ----------------------------------------------------------------------
1230  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEFD-$FFF4.
1231  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above (the region the file
1232  0000              ;   header describes as dead after BIOS_BOOT has run). It runs once at cold start; only
1233  0000              ;   afterwards does the disk system reuse them as the buffers DPH_TABLE hands out. The
1234  0000              ;   two tenants are never live at the same time.
1235  0000              ;
1236  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1237  0000              ;   at the overlay base, then one label per field with its extent carried in the
1238  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1239  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1240  0000              ;   the image. Under the CPM60.COM master link this file is assembled inside a
1241  0000              ;   DISP $FA00 block, where sjasmplus moves only the displacement address and leaves
1242  0000              ;   the physical output pointer alone, so the ORGs are safe there too.
1243  0000              ;
1244  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1245  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1246  0000              ;   cold boot has finished. Same shape and names as the 2.20-44K and 2.23-44K twins;
1247  0000              ;   only the addresses differ. [RE]
1248  0000              ; ----------------------------------------------------------------------
1249  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1250  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1251  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1252  0000              CSV_SIZE     EQU 12                   ; = CKS
1253  0000
1254  0000                      ORG $FEFD                     ; the one given: where the author placed the overlay
1255  FEFD              DIRBUF:                               ; shared directory buffer, one per system
1256  FEFD                      ORG DIRBUF + DIRBUF_SIZE
1257  FF7D              ALV_VECTORS:                          ; per-drive allocation vectors ($FF7D..)
1258  FF7D                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1259  FFC5              CSV_VECTORS:                          ; per-drive checksum vectors ($FFC5..)
1260  FFC5                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1261  FFF5              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFF5)
1262  FFF5
1263  FFF5                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1264  FFF5                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1265  FFF5                  ASSERT ALV_VECTORS == $FF7D
1266  FFF5                  ASSERT CSV_VECTORS == $FFC5
1267  FFF5                  ASSERT BIOS_SCRATCH_END == $FFF5
1268  FFF5
# file closed: CPM_BIOS.asm

 813  FD74 21 78 F6 19          DEFB    $21,$78,$F6,$19,$71,$21,$AA,$C9,$79,$32,$45,$F0,$C3
 813  FD78 71 21 AA C9
 813  FD7C 79 32 45 F0
 813  FD80 C3
 814  FD81 45 FB                DEFW    RPC_TRIGGER
 815  FD83              ; [DOC S&HD 2-24/2-25] Card init that stages 6502 RPC register-pass cells before a SoftCard call:
 816  FD83              ;       $F047 is cell $47 (6502 X register pass area) and $F046 is cell $46 (6502 Y register pass
 817  FD83              ;       area). The full RPC set is $45=A, $46=Y, $47=X, $48=P, $49=6502 SP-on-exit (Y precedes X).
 818  FD83              ; ----------------------------------------------------------------------
 819  FD83              ; INIT_PASCAL_1_0 -- stage the 6502 RPC register-pass cells for a Videx-class card init.
 820  FD83              ;   In:  E = slot index.  Out: A = a card firmware byte; RPC cells staged.  Clobbers: A,HL.
 821  FD83              ;   Algorithm: CALL SLOT_IO_ADDR_W for the card I/O base; stash it in $F6F8 and RPC cell
 822  FD83              ;     $47 ($F047 = 6502 X pass area); read a card byte at $EFFF; SLOT_E000_ADDR + SUB $20
 823  FD83              ;     into RPC cell $46 ($F046 = 6502 Y pass area). [DOC S&HD 2-24/2-25] The full RPC set
 824  FD83              ;     is $45=A, $46=Y, $47=X, $48=P, $49=6502 SP-on-exit. Twin of the 2.23-44K
 825  FD83              ;     SET_SCREEN_BASE. [RE]
 826  FD83              ; ----------------------------------------------------------------------
 827  FD83              INIT_PASCAL_1_0:
 828  FD83 CD 85 FE             CALL SLOT_IO_ADDR_W
 829  FD86 32 F8 F6             LD ($F6F8),A
 830  FD89 32 47 F0             LD ($F047),A
 831  FD8C 3A FF EF             LD A,($EFFF)
 832  FD8F CD B1 FA             CALL SLOT_E000_ADDR
 833  FD92 D6 20                SUB $20
 834  FD94 32 46 F0             LD ($F046),A
 835  FD97 7E                   LD A,(HL)
 836  FD98 C9                   RET
 837  FD99              CONST_SLOT3_TBL:
 838  FD99 21 1D 0E 1E          DEFB    $21,$1D,$0E,$1E,$03,$3E,$01,$CD,$AD,$FD,$3A,$48,$F0,$1F,$9F,$C9
 838  FD9D 03 3E 01 CD
 838  FDA1 AD FD 3A 48
 838  FDA5 F0 1F 9F C9
 839  FDA9 21 E1 0D 79          DEFB    $21,$E1,$0D,$79,$32,$45,$F0
 839  FDAD 32 45 F0
 840  FDB0              ; [AI] Pascal-1.1 card initializer (the POST-1980 device-6 class the 2.20 manual does NOT cover).
 841  FDB0              ;       [DOC S&HD 2-24/2-25] The cell it stages, $F047, is RPC cell $47 (6502 X register pass area);
 842  FDB0              ;       it then triggers the SoftCard call via RPC_TRIGGER. The Pascal-1.1 / device-6 dispatch
 843  FDB0              ;       itself is a 2.23-era extension, not manual-backed.
 844  FDB0              ; ----------------------------------------------------------------------
 845  FDB0              ; PLOT_CHAR_RPC -- Pascal-1.1 / device-6 card initializer (post-1980 class).
 846  FDB0              ;   In:  E = a card parameter byte.  Out: fires the SoftCard call.  Clobbers: A.
 847  FDB0              ;   Algorithm: store E into RPC cell $47 ($F047 = 6502 X register pass area,
 848  FDB0              ;     [DOC S&HD 2-24/2-25]) then tail-jump to RPC_TRIGGER to run the 6502 service.
 849  FDB0              ;     The device-6 / Pascal-1.1 dispatch is a 2.23-era extension the 2.20 manual does
 850  FDB0              ;     NOT document. Twin of the 2.23-44K PLOT_CHAR_RPC family. [RE]
 851  FDB0              ; ----------------------------------------------------------------------
 852  FDB0              PLOT_CHAR_RPC:
 853  FDB0 7B                   LD A,E
 854  FDB1 32 47 F0             LD ($F047),A
 855  FDB4 C3 45 FB             JP RPC_TRIGGER
 856  FDB7 21 0F 0E CD          DEFB    $21,$0F,$0E,$CD
 857  FDBB B0 FD                DEFW    PLOT_CHAR_RPC
 858  FDBD 3A 45 F0 C9          DEFB    $3A,$45,$F0,$C9,$CD
 858  FDC1 CD
 859  FDC2 83 FD                DEFW    INIT_PASCAL_1_0
 860  FDC4 21 4D C8 CD          DEFB    $21,$4D,$C8,$CD
 861  FDC8 45 FB                DEFW    RPC_TRIGGER
 862  FDCA 21 78 F6 19          DEFB    $21,$78,$F6,$19,$7E,$C9,$48,$20,$26,$0E,$A0,$0D,$B1,$F6,$85,$F6
 862  FDCE 7E C9 48 20
 862  FDD2 26 0E A0 0D
 862  FDD6 B1 F6 85 F6
 863  FDDA AC F8 06 68          DEFB    $AC,$F8,$06,$68,$6C,$F6,$00,$48,$A9,$00,$20,$EF,$0D,$20,$26,$0E
 863  FDDE 6C F6 00 48
 863  FDE2 A9 00 20 EF
 863  FDE6 0D 20 26 0E
 864  FDEA A0 0F 4C D6          DEFB    $A0,$0F,$4C,$D6,$0D,$84,$F5,$48,$20,$1D,$0E,$68,$A4,$F5,$90,$F5
 864  FDEE 0D 84 F5 48

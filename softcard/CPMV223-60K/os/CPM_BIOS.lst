 861  FE1E 20 26 0E A0
 861  FE22 10 4C D6 0D
 861  FE26 98 09 C0 AA
 862  FE2A 98 0A 0A 0A          DEFB    $98,$0A,$0A,$0A,$0A,$A8,$8C,$F8,$06,$A9,$00,$85,$F6,$86,$F7

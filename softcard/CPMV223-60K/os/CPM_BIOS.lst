 810  FD81 45 FB                DEFW    RPC_TRIGGER
 811  FD83              ; [DOC S&HD 2-24/2-25] Card init that stages 6502 RPC register-pass cells before a SoftCard call:
 812  FD83              ;       $F047 is cell $47 (6502 X register pass area) and $F046 is cell $46 (6502 Y register pass
 813  FD83              ;       area). The full RPC set is $45=A, $46=Y, $47=X, $48=P, $49=6502 SP-on-exit (Y precedes X).
 814  FD83              ; ----------------------------------------------------------------------
 815  FD83              ; INIT_PASCAL_1_0 -- stage the 6502 RPC register-pass cells for a Videx-class card init.
 816  FD83              ;   In:  E = slot index.  Out: A = a card firmware byte; RPC cells staged.  Clobbers: A,HL.
 817  FD83              ;   Algorithm: CALL SLOT_IO_ADDR_W for the card I/O base; stash it in $F6F8 and RPC cell
 818  FD83              ;     $47 ($F047 = 6502 X pass area); read a card byte at $EFFF; SLOT_E000_ADDR + SUB $20
 819  FD83              ;     into RPC cell $46 ($F046 = 6502 Y pass area). [DOC S&HD 2-24/2-25] The full RPC set
 820  FD83              ;     is $45=A, $46=Y, $47=X, $48=P, $49=6502 SP-on-exit. Twin of the 2.23-44K
 821  FD83              ;     SET_SCREEN_BASE. [RE]
 822  FD83              ; ----------------------------------------------------------------------
 823  FD83              INIT_PASCAL_1_0:
 824  FD83 CD 85 FE             CALL SLOT_IO_ADDR_W
 825  FD86 32 F8 F6             LD ($F6F8),A
 826  FD89 32 47 F0             LD ($F047),A
 827  FD8C 3A FF EF             LD A,($EFFF)
 828  FD8F CD B1 FA             CALL SLOT_E000_ADDR
 829  FD92 D6 20                SUB $20
 830  FD94 32 46 F0             LD ($F046),A
 831  FD97 7E                   LD A,(HL)
 832  FD98 C9                   RET
 833  FD99              CONST_SLOT3_TBL:
 834  FD99 21 1D 0E 1E          DEFB    $21,$1D,$0E,$1E,$03,$3E,$01,$CD,$AD,$FD,$3A,$48,$F0,$1F,$9F,$C9
 834  FD9D 03 3E 01 CD
 834  FDA1 AD FD 3A 48
 834  FDA5 F0 1F 9F C9
 835  FDA9 21 E1 0D 79          DEFB    $21,$E1,$0D,$79,$32,$45,$F0
 835  FDAD 32 45 F0
 836  FDB0              ; [AI] Pascal-1.1 card initializer (the POST-1980 device-6 class the 2.20 manual does NOT cover).
 837  FDB0              ;       [DOC S&HD 2-24/2-25] The cell it stages, $F047, is RPC cell $47 (6502 X register pass area);
 838  FDB0              ;       it then triggers the SoftCard call via RPC_TRIGGER. The Pascal-1.1 / device-6 dispatch
 839  FDB0              ;       itself is a 2.23-era extension, not manual-backed.
 840  FDB0              ; ----------------------------------------------------------------------
 841  FDB0              ; PLOT_CHAR_RPC -- Pascal-1.1 / device-6 card initializer (post-1980 class).
 842  FDB0              ;   In:  E = a card parameter byte.  Out: fires the SoftCard call.  Clobbers: A.
 843  FDB0              ;   Algorithm: store E into RPC cell $47 ($F047 = 6502 X register pass area,
 844  FDB0              ;     [DOC S&HD 2-24/2-25]) then tail-jump to RPC_TRIGGER to run the 6502 service.
 845  FDB0              ;     The device-6 / Pascal-1.1 dispatch is a 2.23-era extension the 2.20 manual does
 846  FDB0              ;     NOT document. Twin of the 2.23-44K PLOT_CHAR_RPC family. [RE]
 847  FDB0              ; ----------------------------------------------------------------------
 848  FDB0              PLOT_CHAR_RPC:
 849  FDB0 7B                   LD A,E
 850  FDB1 32 47 F0             LD ($F047),A
 851  FDB4 C3 45 FB             JP RPC_TRIGGER
 852  FDB7 21 0F 0E CD          DEFB    $21,$0F,$0E,$CD
 853  FDBB B0 FD                DEFW    PLOT_CHAR_RPC
 854  FDBD 3A 45 F0 C9          DEFB    $3A,$45,$F0,$C9,$CD
 854  FDC1 CD
 855  FDC2 83 FD                DEFW    INIT_PASCAL_1_0
 856  FDC4 21 4D C8 CD          DEFB    $21,$4D,$C8,$CD
 857  FDC8 45 FB                DEFW    RPC_TRIGGER
 858  FDCA 21 78 F6 19          DEFB    $21,$78,$F6,$19,$7E,$C9,$48,$20,$26,$0E,$A0,$0D,$B1,$F6,$85,$F6
 858  FDCE 7E C9 48 20
 858  FDD2 26 0E A0 0D
 858  FDD6 B1 F6 85 F6
 859  FDDA AC F8 06 68          DEFB    $AC,$F8,$06,$68,$6C,$F6,$00,$48,$A9,$00,$20,$EF,$0D,$20,$26,$0E
 859  FDDE 6C F6 00 48
 859  FDE2 A9 00 20 EF
 859  FDE6 0D 20 26 0E
 860  FDEA A0 0F 4C D6          DEFB    $A0,$0F,$4C,$D6,$0D,$84,$F5,$48,$20,$1D,$0E,$68,$A4,$F5,$90,$F5
 860  FDEE 0D 84 F5 48
 860  FDF2 20 1D 0E 68
 860  FDF6 A4 F5 90 F5
 861  FDFA 60 00 00 00          DEFB    $60,$00,$00,$00,$00,$00,$4C,$09,$0E,$8D,$8B,$C0,$4C,$13,$D4,$8D
 861  FDFE 00 00 4C 09
 861  FE02 0E 8D 8B C0
 861  FE06 4C 13 D4 8D
 862  FE0A 8B C0 4C F7          DEFB    $8B,$C0,$4C,$F7,$D1,$A9,$01,$20,$EF,$0D,$20,$26,$0E,$48,$A0,$0E
 862  FE0E D1 A9 01 20
 862  FE12 EF 0D 20 26
 862  FE16 0E 48 A0 0E
 863  FE1A 4C D6 0D 48          DEFB    $4C,$D6,$0D,$48,$20,$26,$0E,$A0,$10,$4C,$D6,$0D,$98,$09,$C0,$AA
 863  FE1E 20 26 0E A0
 863  FE22 10 4C D6 0D
 863  FE26 98 09 C0 AA
 864  FE2A 98 0A 0A 0A          DEFB    $98,$0A,$0A,$0A,$0A,$A8,$8C,$F8,$06,$A9,$00,$85,$F6,$86,$F7
 864  FE2E 0A A8 8C F8
 864  FE32 06 A9 00 85
 864  FE36 F6 86 F7
 865  FE39 AD FF                DEFW    BANNER_PUT_ATTR
 866  FE3B CF B1 F6 60          DEFB    $CF,$B1,$F6,$60,$A5,$48,$48,$A5,$45,$A6,$46,$A4,$47,$28,$58,$60
 866  FE3F A5 48 48 A5
 866  FE43 45 A6 46 A4
 866  FE47 47 28 58 60
 867  FE4B CD                   DEFB    $CD
 868  FE4C 8A FE                DEFW    SLOT_IO_ADDR
 869  FE4E 7E 1F 30 FC          DEFB    $7E,$1F,$30,$FC,$2C,$7E,$C9,$11,$01,$00,$C3
 869  FE52 2C 7E C9 11
 869  FE56 01 00 C3
 870  FE59              READER_HANDLER_TBL:
 871  FE59 68 FE CD             DEFB    $68,$FE,$CD
 872  FE5C B1 FA                DEFW    SLOT_E000_ADDR
 873  FE5E 2E C1 7E 17          DEFB    $2E,$C1,$7E,$17,$38,$FC,$CD
 873  FE62 38 FC CD
 874  FE65 85 FE                DEFW    SLOT_IO_ADDR_W
 875  FE67 71 C9 11 02          DEFB    $71,$C9,$11,$02,$00,$C3
 875  FE6B 00 C3
 876  FE6D              PUNCH_HANDLER_TBL:
 877  FE6D 68 FE 11 02          DEFB    $68,$FE,$11,$02,$00
 877  FE71 00
 878  FE72              AUX_DEV_STUB:
 879  FE72 C3                   DEFB    $C3
 880  FE73              AUX_DEV_VEC:
 881  FE73 00                   DEFB    $00
 882  FE74              AUX_DEV_VEC_HI:
 883  FE74 00                   DEFB    $00
 884  FE75              ; ----------------------------------------------------------------------
 885  FE75              ; INIT_PASCAL_1_1_1 (HOME) -- BIOS jump-vector entry 8: seek the drive to track 0.
 886  FE75              ;   In:  none.  Out: none (falls into SETTRK's store with track 0).  Clobbers: A,C.
 887  FE75              ;   Algorithm: read the host-write-pending template cell (DISK_HSTWRT); if a write is
 888  FE75              ;     pending keep the host-active flag, else clear DISK_HSTACT; then fall into
 889  FE75              ;     INIT_PASCAL_1_1_3/_4 (SETTRK) with track 0. The actual head step happens later in
 890  FE75              ;     the off-image deblock path. Twin of the 2.23-44K HOME/SETTRK_STORE. [RE]
 891  FE75              ; ----------------------------------------------------------------------
 892  FE75              INIT_PASCAL_1_1_1:
 893  FE75 3A F2 FE             LD A,(DISK_HSTWRT)
 894  FE78 B7                   OR A
 895  FE79              INIT_PASCAL_1_1_2:
 896  FE79 20 03                JR NZ,INIT_PASCAL_1_1_3
 897  FE7B 32 F1 FE             LD (DISK_HSTACT),A
 898  FE7E              INIT_PASCAL_1_1_3:
 899  FE7E 0E 00                LD C,$00
 900  FE80              ; ----------------------------------------------------------------------
 901  FE80              ; SETTRK_STORE (SETTRK) -- BIOS jump-vector entry 10: set the requested track.
 902  FE80              ;   In:  C = track number.  Out: none.  Clobbers: A.
 903  FE80              ;   Algorithm: LD A,C then store into the sektrk cell BIOS_BOOT ($FEEA = the cold-boot
 904  FE80              ;     LD SP operand byte reused post-boot as sektrk). HOME enters this common tail with
 905  FE80              ;     track 0. Twin of the 2.23-44K SETTRK_STORE tail. [RE]
 906  FE80              ; ----------------------------------------------------------------------
 907  FE80              SETTRK_STORE:
 908  FE80 79                   LD A,C
 909  FE81 32 EA FE             LD (BIOS_BOOT),A
 910  FE84 C9                   RET
 911  FE85              ; ----------------------------------------------------------------------
 912  FE85              ; SLOT_IO_ADDR_W -- map a slot/drive index to the Apple $C080 write/control-bank base.
 913  FE85              ;   In:  E = slot/drive index (0..15).  Out: HL = $E080 + (E<<4).  Clobbers: A,L.
 914  FE85              ;   Algorithm: load z80 $E080 = Apple $C080, then fall into the shared index scaler
 915  FE85              ;     (SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR_W. [RE]
 916  FE85              ; ----------------------------------------------------------------------
 917  FE85              SLOT_IO_ADDR_W:
 918  FE85 21 80 E0             LD HL,$E080
 919  FE88 18 03                JR SLOT_IO_SCALE_E
 920  FE8A              ; ----------------------------------------------------------------------
 921  FE8A              ; SLOT_IO_ADDR -- map a slot/drive index to the Apple $C08E slot-I/O base.
 922  FE8A              ;   In:  E = slot/drive index (0..15).  Out: HL = $E08E + (E<<4).  Clobbers: A,L.
 923  FE8A              ;   Algorithm: load z80 $E08E = Apple $C08E, then fall into the shared index scaler
 924  FE8A              ;     (SLOT_IO_SCALE_E -> SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR. [RE]
 925  FE8A              ; ----------------------------------------------------------------------
 926  FE8A              SLOT_IO_ADDR:
 927  FE8A 21 8E E0             LD HL,$E08E
 928  FE8D              SLOT_IO_SCALE_E:
 929  FE8D 7B                   LD A,E
 930  FE8E              ; ----------------------------------------------------------------------
 931  FE8E              ; SLOT_IOBASE_CALC -- shift the index left by 4 and add to L (index a 16-byte block).
 932  FE8E              ;   In:  A = index (via SLOT_IO_SCALE_E from E), L = base low byte.  Out: L += A*16;
 933  FE8E              ;     A preserved.  Clobbers: A,L.
 934  FE8E              ;   Algorithm: ADD A,A x4 (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET. Shared by
 935  FE8E              ;     SLOT_IO_ADDR_W/_8E and by SELDSK (DPH-table index) and PROBE_DEVICES. Twin of the
 936  FE8E              ;     2.23-44K SLOT_IO_SCALE. [RE]
 937  FE8E              ; ----------------------------------------------------------------------
 938  FE8E              SLOT_IOBASE_CALC:
 939  FE8E 87                   ADD A,A
 940  FE8F 87                   ADD A,A
 941  FE90 87                   ADD A,A
 942  FE91 87                   ADD A,A
 943  FE92 F5                   PUSH AF
 944  FE93 85                   ADD A,L
 945  FE94 6F                   LD L,A
 946  FE95 F1                   POP AF
 947  FE96 C9                   RET
 948  FE97              ; ----------------------------------------------------------------------
 949  FE97              ; SELDSK_IMPL_1 (SELDSK) -- BIOS jump-vector entry 9: select the disk drive.
 950  FE97              ;   In:  C = disk number (0-based).  Out: HL = DPH address for drive C, or HL=0 if out
 951  FE97              ;     of range.  Clobbers: A,DE,HL.
 952  FE97              ;   Algorithm: DE -> the sekdsk build site (BIOS_BOOT_2, an install-template cell reused
 953  FE97              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
 954  FE97              ;     block (z80 $F3B8 = Apple $03B8, the Disk Count Byte); if C >= count return HL=0
 955  FE97              ;     (SELDSK_BAD_DRIVE). Else record the disk number, index DPH_TABLE by C*16 (CALL
 956  FE97              ;     SLOT_IOBASE_CALC), pull a per-drive disk-parameter byte and self-modify the install
 957  FE97              ;     template SECTOR_BLOCK_PATCH+1 with it. [DOC S&HD 2-26/2-27] Twin of the 2.23-44K SELDSK. [RE]
 958  FE97              ; ----------------------------------------------------------------------
 959  FE97              SELDSK_IMPL_1:
 960  FE97 11 EE FE             LD DE,BIOS_BOOT_2
 961  FE9A 21 04 00             LD HL,CDISK_ADDR
 962  FE9D 3A B8 F3             LD A,(SLOT_INFO_BASE)
 963  FEA0 3D                   DEC A
 964  FEA1 B9                   CP C
 965  FEA2 38 1D                JR C,SELDSK_BAD_DRIVE
 966  FEA4 7E                   LD A,(HL)
 967  FEA5 12                   LD (DE),A
 968  FEA6 13                   INC DE
 969  FEA7 79                   LD A,C
 970  FEA8 12                   LD (DE),A
 971  FEA9 21 33 FA             LD HL,DPH_TABLE
 972  FEAC CD 8E FE             CALL SLOT_IOBASE_CALC
 973  FEAF E5                   PUSH HL
 974  FEB0 11 0A 00             LD DE,DPH_LAYOUT.DPB    ; DPH+10 -> this drive's DPB
 975  FEB3 19                   ADD HL,DE
 976  FEB4 5E                   LD E,(HL)
 977  FEB5 23                   INC HL
 978  FEB6 56                   LD D,(HL)
 979  FEB7 21 05 00             LD HL,BDOS
 980  FEBA 19                   ADD HL,DE
 981  FEBB 7E                   LD A,(HL)
 982  FEBC 32 FC FE             LD (SECTOR_BLOCK_PATCH+1),A
 983  FEBF E1                   POP HL
 984  FEC0 C9                   RET
 985  FEC1              ; ----------------------------------------------------------------------
 986  FEC1              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH).
 987  FEC1              ;   In:  DE -> sekdsk build site.  Out: HL=0.  Clobbers: A,L.
 988  FEC1              ;   Algorithm: restore the prior sekdsk byte, then LD L,$00 signals an invalid drive to
 989  FEC1              ;     the BDOS. Twin of the 2.23-44K SELDSK_BAD_DRIVE. [RE]
 990  FEC1              ; ----------------------------------------------------------------------
 991  FEC1              SELDSK_BAD_DRIVE:
 992  FEC1 1A                   LD A,(DE)
 993  FEC2 77                   LD (HL),A
 994  FEC3 2E 00                LD L,$00
 995  FEC5 C9                   RET
 996  FEC6              ; ----------------------------------------------------------------------
 997  FEC6              ; SELDSK_IMPL_3 (READ) -- BIOS jump-vector entry 13: read one 128-byte record.
 998  FEC6              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
 999  FEC6              ;   Algorithm: stash A at $E08B (a 6502-side RPC param cell = Apple $C08B), then OFF-IMAGE
1000  FEC6              ;     tail-jump to the deblock/RWTS read core at $B247 (below the BIOS, in the 60K
1001  FEC6              ;     system-image region). Unlike the 2.20 twin, the 2.23 BIOS does NOT carry the deblock
1002  FEC6              ;     in-image; READ/WRITE delegate to the $B2xx host-sector routines. [RE]
1003  FEC6              ; ----------------------------------------------------------------------
1004  FEC6              SELDSK_IMPL_3:
1005  FEC6 32 8B E0             LD ($E08B),A
1006  FEC9 C3 47 B2             JP $B247
1007  FECC              ; ----------------------------------------------------------------------
1008  FECC              ; SELDSK_IMPL_4 (WRITE) -- BIOS jump-vector entry 14: write one 128-byte record.
1009  FECC              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
1010  FECC              ;   Algorithm: stash A at $E08B (Apple $C08B RPC param), then OFF-IMAGE tail-jump to the
1011  FECC              ;     deblock/RWTS write core at $B257 (60K system-image region below the BIOS). Same
1012  FECC              ;     off-image RWTS delegation as SELDSK_IMPL_3 (READ). [RE]
1013  FECC              ; ----------------------------------------------------------------------
1014  FECC              SELDSK_IMPL_4:
1015  FECC 32 8B E0             LD ($E08B),A
1016  FECF C3 57 B2             JP $B257
1017  FED2 CD                   DEFB    $CD
1018  FED3 45 FB                DEFW    RPC_TRIGGER
1019  FED5 32 8B E0 C9          DEFB    $32,$8B,$E0,$C9,$32,$83,$E0,$2A,$0D,$DC,$E9,$32,$83,$E0,$C9
1019  FED9 32 83 E0 2A
1019  FEDD 0D DC E9 32
1019  FEE1 83 E0 C9
1020  FEE4              COL_FLAG:
1021  FEE4 00                   DEFB    $00
1022  FEE5              COL_PENDING:
1023  FEE5 00                   DEFB    $00
1024  FEE6              COL_STATE:
1025  FEE6 00 E9 FE 00          DEFB    $00,$E9,$FE,$00
1026  FEEA              ; ----------------------------------------------------------------------
1027  FEEA              ; BIOS_BOOT -- Z-80 cold-boot init: runs ONCE, then self-modifies ~a few dozen bytes.
1028  FEEA              ;   In:  entered once at cold start (the 60K reset-plant JPs here).  Out: enters the CCP
1029  FEEA              ;     via the sign-on tail; never re-executed.  Clobbers: all.
1030  FEEA              ;   Algorithm: set SP=$0100; NOP the $FA00 cold JP; load the default IOBYTE_ADDR ($95) into
1031  FEEA              ;     $0003; bind Z$CPU ($F3DE) into RPC_TRIGGER_STORE+1; clear CDISK_ADDR; install console/list/
1032  FEEA              ;     punch/reader handlers by Card Type Table class (device-6=Pascal-1.1, 5=parallel,
1033  FEEA              ;     4=Videx patches the status vector); re-run PROBE_DEVICES; clear screen; print banner.
1034  FEEA              ;   DUAL USE: the 'LD SP,$0100' operand bytes are reused post-boot as sektrk (BIOS_BOOT),
1035  FEEA              ;     seksec (BIOS_BOOT+1) and a cursor word (BIOS_BOOT+2). After it runs, $FEEA-$FF8D is
1036  FEEA              ;     dead scratch; the ~6 self-mods are cataloged in ../BOOT_AND_PATCHING.md section 3c.
1037  FEEA              ;     [DOC S&HD 2-24/2-25, 2-26/2-27] Twin of the 2.23-44K install engine. [RE]
1038  FEEA              ; ----------------------------------------------------------------------
1039  FEEA              BIOS_BOOT:
1040  FEEA 31 00 01             LD SP,TPA
1041  FEED              BIOS_BOOT_1:
1042  FEED AF                   XOR A
1043  FEEE              BIOS_BOOT_2:
1044  FEEE 21 00 FA             LD HL,BOOT
1045  FEF1              DISK_HSTACT:
1046  FEF1 77                   LD (HL),A
1047  FEF2              DISK_HSTWRT:
1048  FEF2 23                   INC HL
1049  FEF3 77                   LD (HL),A
1050  FEF4 23                   INC HL
1051  FEF5 77                   LD (HL),A
1052  FEF6              BOOT_TMPL_IOBYTE:
1053  FEF6 3E 95                LD A,$95
1054  FEF8              DISK_DMAADR:
1055  FEF8 32 03 00             LD (IOBYTE_ADDR),A
1056  FEFB              ; [DOC S&HD 2-24/2-25] Loads the SoftCard location from Z$CPU=$F3DE and binds it into the RPC
1057  FEFB              ;       dispatcher (patching RPC_TRIGGER_STORE+1) so subsequent 6502 calls switch via the right slot.
1058  FEFB              SECTOR_BLOCK_PATCH:
1059  FEFB 2A DE F3             LD HL,($F3DE)
1060  FEFE              BIOS_BOOT_8:
1061  FEFE 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1062  FF01 AF                   XOR A
1063  FF02 32 04 00             LD (CDISK_ADDR),A
1064  FF05              ; [DOC S&HD 2-26/2-27] Reads the slot-3 (console) Card Type Table entry at $F3BB ($F3B8+3). [AI] The
1065  FF05              ;       CP $06 test selects the POST-1980 device-6 / Pascal-1.1 console class (a 2.23 extension the
1066  FF05              ;       2.20 manual does NOT document; in 2.20 the Videx is type 4). On a match it points the
1067  FF05              ;       [DOC S&HD 2-18] I/O Vector Table Console Status cell ($F380) at the slot-3 console handler.
1068  FF05 3A BB F3             LD A,($F3BB)
1069  FF08 FE 06                CP $06
1070  FF0A 20 0A                JR NZ,DEV_INSTALL_LIST
1071  FF0C 21 99 FD             LD HL,CONST_SLOT3_TBL
1072  FF0F 22 80 F3             LD ($F380),HL
1073  FF12 D6 03                SUB $03
1074  FF14 18 13                JR DEV_INSTALL_PUNCH
1075  FF16              ; [DOC S&HD 2-26/2-27] Non-device-6 console path: dispatches on the slot-3 Card Type value. Value 5
1076  FF16              ;       (Apple Parallel Printer) skips ahead; values >=3 (serial / Videx-class / device-4) fall
1077  FF16              ;       through to install the console handlers; value 4 patches the slot-3 console-status vector below.
1078  FF16              DEV_INSTALL_LIST:
1079  FF16 FE 05                CP $05
1080  FF18 28 22                JR Z,BIOS_BOOT_11
1081  FF1A D6 03                SUB $03
1082  FF1C 38 1E                JR C,BIOS_BOOT_11
1083  FF1E 20 09                JR NZ,DEV_INSTALL_PUNCH
1084  FF20 21 15 FB             LD HL,CONST_VEC_PATCH
1085  FF23 36 BE                LD (HL),$BE
1086  FF25 23                   INC HL
1087  FF26 23                   INC HL
1088  FF27 36 1F                LD (HL),$1F
1089  FF29              DEV_INSTALL_PUNCH:
1090  FF29 F5                   PUSH AF
1091  FF2A CD 9D FF             CALL DEV_HANDLER_LOOKUP
1092  FF2D F1                   POP AF
1093  FF2E 22 B9 FC             LD (CONOUT_HANDLER_VEC),HL
1094  FF31 CD 98 FF             CALL GET_CONIN_HANDLER
1095  FF34 22 37 FB             LD (CONIN_HANDLER_VEC),HL
1096  FF37 3E 03                LD A,$03
1097  FF39 32 05 FB             LD (CCP_LAUNCH+1),A
1098  FF3C              ; [DOC S&HD 2-26/2-27] Reads the slot-1 Card Type Table entry at $F3B9 (SLTTYP base = slot 1, per
1099  FF3C              ;       Slot Function Assignments the LST: line-printer slot). For a recognized output card (value
1100  FF3C              ;       >=3 after SUB $03) it resolves and installs that card's output handler for the list device.
1101  FF3C              BIOS_BOOT_11:
1102  FF3C 3A B9 F3             LD A,($F3B9)
1103  FF3F D6 03                SUB $03
1104  FF41 38 06                JR C,INSTALL_DONE_DEVICES
1105  FF43 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1106  FF46 22 59 FE             LD (READER_HANDLER_TBL),HL
1107  FF49              ; [DOC S&HD 2-26/2-27] Reads the slot-2 Card Type Table entry at $F3BA ($F3B8+2) -- per Slot
1108  FF49              ;       Function Assignments the general-purpose PUN:/RDR: slot. For a recognized output card it
1109  FF49              ;       installs the punch handler; the value also drives the reader-handler selection below.
1110  FF49              INSTALL_DONE_DEVICES:
1111  FF49 3A BA F3             LD A,($F3BA)
1112  FF4C D6 03                SUB $03
1113  FF4E 38 14                JR C,BIOS_BOOT_14
1114  FF50 F5                   PUSH AF
1115  FF51 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1116  FF54 22 6D FE             LD (PUNCH_HANDLER_TBL),HL
1117  FF57 F1                   POP AF
1118  FF58              BIOS_BOOT_13:
1119  FF58 FE 02                CP $02
1120  FF5A 28 08                JR Z,BIOS_BOOT_14
1121  FF5C CD 98 FF             CALL GET_CONIN_HANDLER
1122  FF5F 22 73 FE             LD (AUX_DEV_VEC),HL
1123  FF62 18 0B                JR BIOS_BOOT_15
1124  FF64              BIOS_BOOT_14:
1125  FF64 21 3E 1A             LD HL,$1A3E
1126  FF67 22 72 FE             LD (AUX_DEV_STUB),HL
1127  FF6A 3E C9                LD A,$C9
1128  FF6C 32 74 FE             LD (AUX_DEV_VEC_HI),A
1129  FF6F              ; [DOC S&HD 2-14/2-15] Rescans the slots, then reads $F398 -- SSFTAB function #1, Clear Screen, the
1130  FF6F              ;       first entry of the Software Screen Function Table -- and emits it to home/clear the console
1131  FF6F              ;       before printing the sign-on banner.
1132  FF6F              BIOS_BOOT_15:
1133  FF6F CD 82 FA             CALL PROBE_DEVICES
1134  FF72 3A 98 F3             LD A,($F398)
1135  FF75 CD A8 FF             CALL BANNER_PUT_CHAR
1136  FF78 21 B7 FF             LD HL,SIGNON_BANNER
1137  FF7B              SIGNON_BANNER_LOOP:
1138  FF7B 7E                   LD A,(HL)
1139  FF7C B7                   OR A
1140  FF7D              BIOS_BOOT_17:
1141  FF7D CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1142  FF80 E5                   PUSH HL
1143  FF81 CD 4C FB             CALL CONOUT_SET_C
1144  FF84 E1                   POP HL
1145  FF85 23                   INC HL
1146  FF86 18 F3                JR SIGNON_BANNER_LOOP
1147  FF88              CONOUT_VEC_TABLE:
1148  FF88 0E FD 71 FD          DEFB    $0E,$FD,$71,$FD,$5B,$FE,$A9,$FD
1148  FF8C 5B FE A9 FD
1149  FF90              CONIN_VEC_TABLE:
1150  FF90 4B FE C1 FD          DEFB    $4B,$FE,$C1,$FD,$B7,$FD,$B7,$FD
1150  FF94 B7 FD B7 FD
1151  FF98              ; ----------------------------------------------------------------------
1152  FF98              ; GET_CONIN_HANDLER -- fetch a console-input handler address from CONIN_VEC_TABLE.
1153  FF98              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1154  FF98              ;   Algorithm: HL = CONIN_VEC_TABLE base, then fall into the shared index tail
1155  FF98              ;     (HANDLER_TBL_INDEX: HL += A*2; load the word). Twin of the 2.23-44K
1156  FF98              ;     DEV_HANDLER_LOOKUP_B family. [RE]
1157  FF98              ; ----------------------------------------------------------------------
1158  FF98              GET_CONIN_HANDLER:
1159  FF98 21 90 FF             LD HL,CONIN_VEC_TABLE
1160  FF9B 18 03                JR HANDLER_TBL_INDEX
1161  FF9D              ; ----------------------------------------------------------------------
1162  FF9D              ; DEV_HANDLER_LOOKUP -- fetch a console-output handler address from CONOUT_VEC_TABLE.
1163  FF9D              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1164  FF9D              ;   Algorithm: HL = CONOUT_VEC_TABLE base, fall into HANDLER_TBL_INDEX (HL += A*2; load
1165  FF9D              ;     the 16-bit word low-then-high). Twin of the 2.23-44K DEV_HANDLER_LOOKUP. [RE]
1166  FF9D              ; ----------------------------------------------------------------------
1167  FF9D              DEV_HANDLER_LOOKUP:
1168  FF9D 21 88 FF             LD HL,CONOUT_VEC_TABLE
1169  FFA0              HANDLER_TBL_INDEX:
1170  FFA0 87                   ADD A,A
1171  FFA1              HANDLER_TBL_FETCH:
1172  FFA1 85                   ADD A,L
1173  FFA2 6F                   LD L,A
1174  FFA3 7E                   LD A,(HL)
1175  FFA4 2C                   INC L
1176  FFA5 66                   LD H,(HL)
1177  FFA6 6F                   LD L,A
1178  FFA7 C9                   RET
1179  FFA8              ; [AI] Banner character emitter: if the byte is positive (high bit clear) it outputs it directly; if
1180  FFA8              ;       negative it first emits the software lead-in. [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the
1181  FFA8              ;       Software function lead-in character, sent ahead of the byte for the high-bit-set case.
1182  FFA8              ; ----------------------------------------------------------------------
1183  FFA8              ; BANNER_PUT_CHAR -- emit one sign-on byte, optionally preceded by a lead-in char.
1184  FFA8              ;   In:  A = byte/flag.  Out: prints via CONOUT_SET_C.  Clobbers: A,HL.
1185  FFA8              ;   Algorithm: if A is positive (bit7 clear) tail-jump to emit it directly
1186  FFA8              ;     (BANNER_EMIT_CHAR); if negative, first emit the software lead-in char from config
1187  FFA8              ;     $F397 (SFLDIN, [DOC S&HD 2-14/2-15]) via CONOUT_SET_C, then emit A. Twin of the
1188  FFA8              ;     2.23-44K SIGNON_EMIT. [RE]
1189  FFA8              ; ----------------------------------------------------------------------
1190  FFA8              BANNER_PUT_CHAR:
1191  FFA8 B7                   OR A
1192  FFA9 F2 B4 FF             JP P,BANNER_EMIT_CHAR
1193  FFAC F5                   PUSH AF
1194  FFAD              BANNER_PUT_ATTR:
1195  FFAD 3A 97 F3             LD A,($F397)
1196  FFB0 CD 4C FB             CALL CONOUT_SET_C
1197  FFB3              BANNER_RESTORE_A:
1198  FFB3 F1                   POP AF
1199  FFB4              BANNER_EMIT_CHAR:
1200  FFB4 C3 4C FB             JP CONOUT_SET_C
1201  FFB7              ; [AI] Cold-boot sign-on banner emitted by the loop above: "Softcard CP/M / 60K Ver. 2.23 / (c)
1202  FFB7              ;       1980,1982 Microsoft". This is the POST-1980 60K / 2.23 variant; the 2.20 manual documents only
1203  FFB7              ;       the "APPLE II CP/M / 44K vers. 2.2X / (C) 1980 MICROSOFT" 44K/56K banner (S&HD 1-8), so the
1204  FFB7              ;       "60K"/"2.23"/"1982" tokens here are version-specific, not manual-backed.
1205  FFB7              SIGNON_BANNER:
1206  FFB7 0D 0A 0A 0A          DEFB    $0D,$0A,$0A,$0A,$20,$20,$20,$20,$20,$53,$6F,$66,$74,$63,$61,$72
1206  FFBB 20 20 20 20
1206  FFBF 20 53 6F 66
1206  FFC3 74 63 61 72
1207  FFC7 64 20 43 50          DEFB    "d CP/M"                 ; string
1207  FFCB 2F 4D
1208  FFCD 0D                   DEFB    $0D                      ; terminator
1209  FFCE 0A 20 20 20          DEFB    $0A,$20,$20,$20,$20,$20,$36,$30,$4B,$20,$56,$65,$72,$2E,$20,$32
1209  FFD2 20 20 36 30
1209  FFD6 4B 20 56 65
1209  FFDA 72 2E 20 32
1210  FFDE 2E 32 33 0D          DEFB    $2E,$32,$33,$0D,$0A,$28,$63,$29,$20,$31,$39,$38,$30,$2C,$31,$39
1210  FFE2 0A 28 63 29
1210  FFE6 20 31 39 38
1210  FFEA 30 2C 31 39
1211  FFEE 38 32 20 4D          DEFB    "82 Microsoft"           ; string
1211  FFF2 69 63 72 6F
1211  FFF6 73 6F 66 74
1212  FFFA 0D                   DEFB    $0D                      ; terminator
1213  FFFB 0A 0D 0A             DEFB    $0A,$0D,$0A
1214  FFFE 00 FA                DEFW    BOOT
1215  0000
1216  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1217  0000
1218  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
1219  0000                  ; Image size from its bracketing labels, not a magic length, as in the 2.23-44K twin:
1220  0000                  ; an overrun fails the build here instead of being silently truncated by SAVEBIN.
1221  0000                  ; $FA00 = the ORG base; the subtraction wraps because the image ends at $10000.
1222  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1223  0000                  ENDIF
1224  0000
1225  0000              ; ----------------------------------------------------------------------
1226  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEFD-$FFF4.
1227  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above (the region the file
1228  0000              ;   header describes as dead after BIOS_BOOT has run). It runs once at cold start; only
1229  0000              ;   afterwards does the disk system reuse them as the buffers DPH_TABLE hands out. The
1230  0000              ;   two tenants are never live at the same time.
1231  0000              ;
1232  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1233  0000              ;   at the overlay base, then one label per field with its extent carried in the
1234  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1235  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1236  0000              ;   the image. Under the CPM60.COM master link this file is assembled inside a
1237  0000              ;   DISP $FA00 block, where sjasmplus moves only the displacement address and leaves
1238  0000              ;   the physical output pointer alone, so the ORGs are safe there too.
1239  0000              ;
1240  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1241  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1242  0000              ;   cold boot has finished. Same shape and names as the 2.20-44K and 2.23-44K twins;
1243  0000              ;   only the addresses differ. [RE]
1244  0000              ; ----------------------------------------------------------------------
1245  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1246  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1247  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1248  0000              CSV_SIZE     EQU 12                   ; = CKS
1249  0000
1250  0000                      ORG $FEFD                     ; the one given: where the author placed the overlay
1251  FEFD              DIRBUF:                               ; shared directory buffer, one per system
1252  FEFD                      ORG DIRBUF + DIRBUF_SIZE
1253  FF7D              ALV_VECTORS:                          ; per-drive allocation vectors ($FF7D..)
1254  FF7D                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1255  FFC5              CSV_VECTORS:                          ; per-drive checksum vectors ($FFC5..)
1256  FFC5                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1257  FFF5              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFF5)
1258  FFF5
1259  FFF5                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1260  FFF5                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1261  FFF5                  ASSERT ALV_VECTORS == $FF7D
1262  FFF5                  ASSERT CSV_VECTORS == $FFC5
1263  FFF5                  ASSERT BIOS_SCRATCH_END == $FFF5
1264  FFF5
# file closed: CPM_BIOS.asm

 870  FE72 C3                   DEFB    $C3
 871  FE73              AUX_DEV_VEC:
 872  FE73 00                   DEFB    $00
 873  FE74              AUX_DEV_VEC_HI:
 874  FE74 00                   DEFB    $00
 875  FE75              ; ----------------------------------------------------------------------
 876  FE75              ; INIT_PASCAL_1_1_1 (HOME) -- BIOS jump-vector entry 8: seek the drive to track 0.
 877  FE75              ;   In:  none.  Out: none (falls into SETTRK's store with track 0).  Clobbers: A,C.
 878  FE75              ;   Algorithm: read the host-write-pending template cell (DISK_HSTWRT); if a write is
 879  FE75              ;     pending keep the host-active flag, else clear DISK_HSTACT; then fall into
 880  FE75              ;     INIT_PASCAL_1_1_3/_4 (SETTRK) with track 0. The actual head step happens later in
 881  FE75              ;     the off-image deblock path. Twin of the 2.23-44K HOME/SETTRK_STORE. [RE]
 882  FE75              ; ----------------------------------------------------------------------
 883  FE75              INIT_PASCAL_1_1_1:
 884  FE75 3A F2 FE             LD A,(DISK_HSTWRT)
 885  FE78 B7                   OR A
 886  FE79              INIT_PASCAL_1_1_2:
 887  FE79 20 03                JR NZ,INIT_PASCAL_1_1_3
 888  FE7B 32 F1 FE             LD (DISK_HSTACT),A
 889  FE7E              INIT_PASCAL_1_1_3:
 890  FE7E 0E 00                LD C,$00
 891  FE80              ; ----------------------------------------------------------------------
 892  FE80              ; SETTRK_STORE (SETTRK) -- BIOS jump-vector entry 10: set the requested track.
 893  FE80              ;   In:  C = track number.  Out: none.  Clobbers: A.
 894  FE80              ;   Algorithm: LD A,C then store into the sektrk cell BIOS_BOOT ($FEEA = the cold-boot
 895  FE80              ;     LD SP operand byte reused post-boot as sektrk). HOME enters this common tail with
 896  FE80              ;     track 0. Twin of the 2.23-44K SETTRK_STORE tail. [RE]
 897  FE80              ; ----------------------------------------------------------------------
 898  FE80              SETTRK_STORE:
 899  FE80 79                   LD A,C
 900  FE81 32 EA FE             LD (BIOS_BOOT),A
 901  FE84 C9                   RET
 902  FE85              ; ----------------------------------------------------------------------
 903  FE85              ; SLOT_IO_ADDR_W -- map a slot/drive index to the Apple $C080 write/control-bank base.
 904  FE85              ;   In:  E = slot/drive index (0..15).  Out: HL = $E080 + (E<<4).  Clobbers: A,L.
 905  FE85              ;   Algorithm: load z80 $E080 = Apple $C080, then fall into the shared index scaler
 906  FE85              ;     (SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR_W. [RE]
 907  FE85              ; ----------------------------------------------------------------------
 908  FE85              SLOT_IO_ADDR_W:
 909  FE85 21 80 E0             LD HL,$E080
 910  FE88 18 03                JR SLOT_IO_SCALE_E
 911  FE8A              ; ----------------------------------------------------------------------
 912  FE8A              ; SLOT_IO_ADDR -- map a slot/drive index to the Apple $C08E slot-I/O base.
 913  FE8A              ;   In:  E = slot/drive index (0..15).  Out: HL = $E08E + (E<<4).  Clobbers: A,L.
 914  FE8A              ;   Algorithm: load z80 $E08E = Apple $C08E, then fall into the shared index scaler
 915  FE8A              ;     (SLOT_IO_SCALE_E -> SLOT_IOBASE_CALC). Twin of the 2.23-44K SLOT_IO_ADDR. [RE]
 916  FE8A              ; ----------------------------------------------------------------------
 917  FE8A              SLOT_IO_ADDR:
 918  FE8A 21 8E E0             LD HL,$E08E
 919  FE8D              SLOT_IO_SCALE_E:
 920  FE8D 7B                   LD A,E
 921  FE8E              ; ----------------------------------------------------------------------
 922  FE8E              ; SLOT_IOBASE_CALC -- shift the index left by 4 and add to L (index a 16-byte block).
 923  FE8E              ;   In:  A = index (via SLOT_IO_SCALE_E from E), L = base low byte.  Out: L += A*16;
 924  FE8E              ;     A preserved.  Clobbers: A,L.
 925  FE8E              ;   Algorithm: ADD A,A x4 (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET. Shared by
 926  FE8E              ;     SLOT_IO_ADDR_W/_8E and by SELDSK (DPH-table index) and PROBE_DEVICES. Twin of the
 927  FE8E              ;     2.23-44K SLOT_IO_SCALE. [RE]
 928  FE8E              ; ----------------------------------------------------------------------
 929  FE8E              SLOT_IOBASE_CALC:
 930  FE8E 87                   ADD A,A
 931  FE8F 87                   ADD A,A
 932  FE90 87                   ADD A,A
 933  FE91 87                   ADD A,A
 934  FE92 F5                   PUSH AF
 935  FE93 85                   ADD A,L
 936  FE94 6F                   LD L,A
 937  FE95 F1                   POP AF
 938  FE96 C9                   RET
 939  FE97              ; ----------------------------------------------------------------------
 940  FE97              ; SELDSK_IMPL_1 (SELDSK) -- BIOS jump-vector entry 9: select the disk drive.
 941  FE97              ;   In:  C = disk number (0-based).  Out: HL = DPH address for drive C, or HL=0 if out
 942  FE97              ;     of range.  Clobbers: A,DE,HL.
 943  FE97              ;   Algorithm: DE -> the sekdsk build site (BIOS_BOOT_2, an install-template cell reused
 944  FE97              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
 945  FE97              ;     block (z80 $F3B8 = Apple $03B8, the Disk Count Byte); if C >= count return HL=0
 946  FE97              ;     (SELDSK_BAD_DRIVE). Else record the disk number, index DPH_TABLE by C*16 (CALL
 947  FE97              ;     SLOT_IOBASE_CALC), pull a per-drive disk-parameter byte and self-modify the install
 948  FE97              ;     template SECTOR_BLOCK_PATCH+1 with it. [DOC S&HD 2-26/2-27] Twin of the 2.23-44K SELDSK. [RE]
 949  FE97              ; ----------------------------------------------------------------------
 950  FE97              SELDSK_IMPL_1:
 951  FE97 11 EE FE             LD DE,BIOS_BOOT_2
 952  FE9A 21 04 00             LD HL,CDISK_ADDR
 953  FE9D 3A B8 F3             LD A,(SLOT_INFO_BASE)
 954  FEA0 3D                   DEC A
 955  FEA1 B9                   CP C
 956  FEA2 38 1D                JR C,SELDSK_BAD_DRIVE
 957  FEA4 7E                   LD A,(HL)
 958  FEA5 12                   LD (DE),A
 959  FEA6 13                   INC DE
 960  FEA7 79                   LD A,C
 961  FEA8 12                   LD (DE),A
 962  FEA9 21 33 FA             LD HL,DPH_TABLE
 963  FEAC CD 8E FE             CALL SLOT_IOBASE_CALC
 964  FEAF E5                   PUSH HL
 965  FEB0 11 0A 00             LD DE,$000A
 966  FEB3 19                   ADD HL,DE
 967  FEB4 5E                   LD E,(HL)
 968  FEB5 23                   INC HL
 969  FEB6 56                   LD D,(HL)
 970  FEB7 21 05 00             LD HL,BDOS
 971  FEBA 19                   ADD HL,DE
 972  FEBB 7E                   LD A,(HL)
 973  FEBC 32 FC FE             LD (SECTOR_BLOCK_PATCH+1),A
 974  FEBF E1                   POP HL
 975  FEC0 C9                   RET
 976  FEC1              ; ----------------------------------------------------------------------
 977  FEC1              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH).
 978  FEC1              ;   In:  DE -> sekdsk build site.  Out: HL=0.  Clobbers: A,L.
 979  FEC1              ;   Algorithm: restore the prior sekdsk byte, then LD L,$00 signals an invalid drive to
 980  FEC1              ;     the BDOS. Twin of the 2.23-44K SELDSK_BAD_DRIVE. [RE]
 981  FEC1              ; ----------------------------------------------------------------------
 982  FEC1              SELDSK_BAD_DRIVE:
 983  FEC1 1A                   LD A,(DE)
 984  FEC2 77                   LD (HL),A
 985  FEC3 2E 00                LD L,$00
 986  FEC5 C9                   RET
 987  FEC6              ; ----------------------------------------------------------------------
 988  FEC6              ; SELDSK_IMPL_3 (READ) -- BIOS jump-vector entry 13: read one 128-byte record.
 989  FEC6              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
 990  FEC6              ;   Algorithm: stash A at $E08B (a 6502-side RPC param cell = Apple $C08B), then OFF-IMAGE
 991  FEC6              ;     tail-jump to the deblock/RWTS read core at $B247 (below the BIOS, in the 60K
 992  FEC6              ;     system-image region). Unlike the 2.20 twin, the 2.23 BIOS does NOT carry the deblock
 993  FEC6              ;     in-image; READ/WRITE delegate to the $B2xx host-sector routines. [RE]
 994  FEC6              ; ----------------------------------------------------------------------
 995  FEC6              SELDSK_IMPL_3:
 996  FEC6 32 8B E0             LD ($E08B),A
 997  FEC9 C3 47 B2             JP $B247
 998  FECC              ; ----------------------------------------------------------------------
 999  FECC              ; SELDSK_IMPL_4 (WRITE) -- BIOS jump-vector entry 14: write one 128-byte record.
1000  FECC              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set.  Out: A=0 ok / 1 error.
1001  FECC              ;   Algorithm: stash A at $E08B (Apple $C08B RPC param), then OFF-IMAGE tail-jump to the
1002  FECC              ;     deblock/RWTS write core at $B257 (60K system-image region below the BIOS). Same
1003  FECC              ;     off-image RWTS delegation as SELDSK_IMPL_3 (READ). [RE]
1004  FECC              ; ----------------------------------------------------------------------
1005  FECC              SELDSK_IMPL_4:
1006  FECC 32 8B E0             LD ($E08B),A
1007  FECF C3 57 B2             JP $B257
1008  FED2 CD                   DEFB    $CD
1009  FED3 45 FB                DEFW    RPC_TRIGGER
1010  FED5 32 8B E0 C9          DEFB    $32,$8B,$E0,$C9,$32,$83,$E0,$2A,$0D,$DC,$E9,$32,$83,$E0,$C9
1010  FED9 32 83 E0 2A
1010  FEDD 0D DC E9 32
1010  FEE1 83 E0 C9
1011  FEE4              COL_FLAG:
1012  FEE4 00                   DEFB    $00
1013  FEE5              COL_PENDING:
1014  FEE5 00                   DEFB    $00
1015  FEE6              COL_STATE:
1016  FEE6 00 E9 FE 00          DEFB    $00,$E9,$FE,$00
1017  FEEA              ; ----------------------------------------------------------------------
1018  FEEA              ; BIOS_BOOT -- Z-80 cold-boot init: runs ONCE, then self-modifies ~a few dozen bytes.
1019  FEEA              ;   In:  entered once at cold start (the 60K reset-plant JPs here).  Out: enters the CCP
1020  FEEA              ;     via the sign-on tail; never re-executed.  Clobbers: all.
1021  FEEA              ;   Algorithm: set SP=$0100; NOP the $FA00 cold JP; load the default IOBYTE_ADDR ($95) into
1022  FEEA              ;     $0003; bind Z$CPU ($F3DE) into RPC_TRIGGER_STORE+1; clear CDISK_ADDR; install console/list/
1023  FEEA              ;     punch/reader handlers by Card Type Table class (device-6=Pascal-1.1, 5=parallel,
1024  FEEA              ;     4=Videx patches the status vector); re-run PROBE_DEVICES; clear screen; print banner.
1025  FEEA              ;   DUAL USE: the 'LD SP,$0100' operand bytes are reused post-boot as sektrk (BIOS_BOOT),
1026  FEEA              ;     seksec (BIOS_BOOT+1) and a cursor word (BIOS_BOOT+2). After it runs, $FEEA-$FF8D is
1027  FEEA              ;     dead scratch; the ~6 self-mods are cataloged in ../BOOT_AND_PATCHING.md section 3c.
1028  FEEA              ;     [DOC S&HD 2-24/2-25, 2-26/2-27] Twin of the 2.23-44K install engine. [RE]
1029  FEEA              ; ----------------------------------------------------------------------
1030  FEEA              BIOS_BOOT:
1031  FEEA 31 00 01             LD SP,TPA
1032  FEED              BIOS_BOOT_1:
1033  FEED AF                   XOR A
1034  FEEE              BIOS_BOOT_2:
1035  FEEE 21 00 FA             LD HL,BOOT
1036  FEF1              DISK_HSTACT:
1037  FEF1 77                   LD (HL),A
1038  FEF2              DISK_HSTWRT:
1039  FEF2 23                   INC HL
1040  FEF3 77                   LD (HL),A
1041  FEF4 23                   INC HL
1042  FEF5 77                   LD (HL),A
1043  FEF6              BOOT_TMPL_IOBYTE:
1044  FEF6 3E 95                LD A,$95
1045  FEF8              DISK_DMAADR:
1046  FEF8 32 03 00             LD (IOBYTE_ADDR),A
1047  FEFB              ; [DOC S&HD 2-24/2-25] Loads the SoftCard location from Z$CPU=$F3DE and binds it into the RPC
1048  FEFB              ;       dispatcher (patching RPC_TRIGGER_STORE+1) so subsequent 6502 calls switch via the right slot.
1049  FEFB              SECTOR_BLOCK_PATCH:
1050  FEFB 2A DE F3             LD HL,($F3DE)
1051  FEFE              BIOS_BOOT_8:
1052  FEFE 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1053  FF01 AF                   XOR A
1054  FF02 32 04 00             LD (CDISK_ADDR),A
1055  FF05              ; [DOC S&HD 2-26/2-27] Reads the slot-3 (console) Card Type Table entry at $F3BB ($F3B8+3). [AI] The
1056  FF05              ;       CP $06 test selects the POST-1980 device-6 / Pascal-1.1 console class (a 2.23 extension the
1057  FF05              ;       2.20 manual does NOT document; in 2.20 the Videx is type 4). On a match it points the
1058  FF05              ;       [DOC S&HD 2-18] I/O Vector Table Console Status cell ($F380) at the slot-3 console handler.
1059  FF05 3A BB F3             LD A,($F3BB)
1060  FF08 FE 06                CP $06
1061  FF0A 20 0A                JR NZ,DEV_INSTALL_LIST
1062  FF0C 21 99 FD             LD HL,CONST_SLOT3_TBL
1063  FF0F 22 80 F3             LD ($F380),HL
1064  FF12 D6 03                SUB $03
1065  FF14 18 13                JR DEV_INSTALL_PUNCH
1066  FF16              ; [DOC S&HD 2-26/2-27] Non-device-6 console path: dispatches on the slot-3 Card Type value. Value 5
1067  FF16              ;       (Apple Parallel Printer) skips ahead; values >=3 (serial / Videx-class / device-4) fall
1068  FF16              ;       through to install the console handlers; value 4 patches the slot-3 console-status vector below.
1069  FF16              DEV_INSTALL_LIST:
1070  FF16 FE 05                CP $05
1071  FF18 28 22                JR Z,BIOS_BOOT_11
1072  FF1A D6 03                SUB $03
1073  FF1C 38 1E                JR C,BIOS_BOOT_11
1074  FF1E 20 09                JR NZ,DEV_INSTALL_PUNCH
1075  FF20 21 15 FB             LD HL,CONST_VEC_PATCH
1076  FF23 36 BE                LD (HL),$BE
1077  FF25 23                   INC HL
1078  FF26 23                   INC HL
1079  FF27 36 1F                LD (HL),$1F
1080  FF29              DEV_INSTALL_PUNCH:
1081  FF29 F5                   PUSH AF
1082  FF2A CD 9D FF             CALL DEV_HANDLER_LOOKUP
1083  FF2D F1                   POP AF
1084  FF2E 22 B9 FC             LD (CONOUT_HANDLER_VEC),HL
1085  FF31 CD 98 FF             CALL GET_CONIN_HANDLER
1086  FF34 22 37 FB             LD (CONIN_HANDLER_VEC),HL
1087  FF37 3E 03                LD A,$03
1088  FF39 32 05 FB             LD (CCP_LAUNCH+1),A
1089  FF3C              ; [DOC S&HD 2-26/2-27] Reads the slot-1 Card Type Table entry at $F3B9 (SLTTYP base = slot 1, per
1090  FF3C              ;       Slot Function Assignments the LST: line-printer slot). For a recognized output card (value
1091  FF3C              ;       >=3 after SUB $03) it resolves and installs that card's output handler for the list device.
1092  FF3C              BIOS_BOOT_11:
1093  FF3C 3A B9 F3             LD A,($F3B9)
1094  FF3F D6 03                SUB $03
1095  FF41 38 06                JR C,INSTALL_DONE_DEVICES
1096  FF43 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1097  FF46 22 59 FE             LD (READER_HANDLER_TBL),HL
1098  FF49              ; [DOC S&HD 2-26/2-27] Reads the slot-2 Card Type Table entry at $F3BA ($F3B8+2) -- per Slot
1099  FF49              ;       Function Assignments the general-purpose PUN:/RDR: slot. For a recognized output card it
1100  FF49              ;       installs the punch handler; the value also drives the reader-handler selection below.
1101  FF49              INSTALL_DONE_DEVICES:
1102  FF49 3A BA F3             LD A,($F3BA)
1103  FF4C D6 03                SUB $03
1104  FF4E 38 14                JR C,BIOS_BOOT_14
1105  FF50 F5                   PUSH AF
1106  FF51 CD 9D FF             CALL DEV_HANDLER_LOOKUP
1107  FF54 22 6D FE             LD (PUNCH_HANDLER_TBL),HL
1108  FF57 F1                   POP AF
1109  FF58              BIOS_BOOT_13:
1110  FF58 FE 02                CP $02
1111  FF5A 28 08                JR Z,BIOS_BOOT_14
1112  FF5C CD 98 FF             CALL GET_CONIN_HANDLER
1113  FF5F 22 73 FE             LD (AUX_DEV_VEC),HL
1114  FF62 18 0B                JR BIOS_BOOT_15
1115  FF64              BIOS_BOOT_14:
1116  FF64 21 3E 1A             LD HL,$1A3E
1117  FF67 22 72 FE             LD (AUX_DEV_STUB),HL
1118  FF6A 3E C9                LD A,$C9
1119  FF6C 32 74 FE             LD (AUX_DEV_VEC_HI),A
1120  FF6F              ; [DOC S&HD 2-14/2-15] Rescans the slots, then reads $F398 -- SSFTAB function #1, Clear Screen, the
1121  FF6F              ;       first entry of the Software Screen Function Table -- and emits it to home/clear the console
1122  FF6F              ;       before printing the sign-on banner.
1123  FF6F              BIOS_BOOT_15:
1124  FF6F CD 82 FA             CALL PROBE_DEVICES
1125  FF72 3A 98 F3             LD A,($F398)
1126  FF75 CD A8 FF             CALL BANNER_PUT_CHAR
1127  FF78 21 B7 FF             LD HL,SIGNON_BANNER
1128  FF7B              SIGNON_BANNER_LOOP:
1129  FF7B 7E                   LD A,(HL)
1130  FF7C B7                   OR A
1131  FF7D              BIOS_BOOT_17:
1132  FF7D CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1133  FF80 E5                   PUSH HL
1134  FF81 CD 4C FB             CALL CONOUT_SET_C
1135  FF84 E1                   POP HL
1136  FF85 23                   INC HL
1137  FF86 18 F3                JR SIGNON_BANNER_LOOP
1138  FF88              CONOUT_VEC_TABLE:
1139  FF88 0E FD 71 FD          DEFB    $0E,$FD,$71,$FD,$5B,$FE,$A9,$FD
1139  FF8C 5B FE A9 FD
1140  FF90              CONIN_VEC_TABLE:
1141  FF90 4B FE C1 FD          DEFB    $4B,$FE,$C1,$FD,$B7,$FD,$B7,$FD
1141  FF94 B7 FD B7 FD
1142  FF98              ; ----------------------------------------------------------------------
1143  FF98              ; GET_CONIN_HANDLER -- fetch a console-input handler address from CONIN_VEC_TABLE.
1144  FF98              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1145  FF98              ;   Algorithm: HL = CONIN_VEC_TABLE base, then fall into the shared index tail
1146  FF98              ;     (HANDLER_TBL_INDEX: HL += A*2; load the word). Twin of the 2.23-44K
1147  FF98              ;     DEV_HANDLER_LOOKUP_B family. [RE]
1148  FF98              ; ----------------------------------------------------------------------
1149  FF98              GET_CONIN_HANDLER:
1150  FF98 21 90 FF             LD HL,CONIN_VEC_TABLE
1151  FF9B 18 03                JR HANDLER_TBL_INDEX
1152  FF9D              ; ----------------------------------------------------------------------
1153  FF9D              ; DEV_HANDLER_LOOKUP -- fetch a console-output handler address from CONOUT_VEC_TABLE.
1154  FF9D              ;   In:  A = card-class index (0-based).  Out: HL = handler address.  Clobbers: A,HL.
1155  FF9D              ;   Algorithm: HL = CONOUT_VEC_TABLE base, fall into HANDLER_TBL_INDEX (HL += A*2; load
1156  FF9D              ;     the 16-bit word low-then-high). Twin of the 2.23-44K DEV_HANDLER_LOOKUP. [RE]
1157  FF9D              ; ----------------------------------------------------------------------
1158  FF9D              DEV_HANDLER_LOOKUP:
1159  FF9D 21 88 FF             LD HL,CONOUT_VEC_TABLE
1160  FFA0              HANDLER_TBL_INDEX:
1161  FFA0 87                   ADD A,A
1162  FFA1              HANDLER_TBL_FETCH:
1163  FFA1 85                   ADD A,L
1164  FFA2 6F                   LD L,A
1165  FFA3 7E                   LD A,(HL)
1166  FFA4 2C                   INC L
1167  FFA5 66                   LD H,(HL)
1168  FFA6 6F                   LD L,A
1169  FFA7 C9                   RET
1170  FFA8              ; [AI] Banner character emitter: if the byte is positive (high bit clear) it outputs it directly; if
1171  FFA8              ;       negative it first emits the software lead-in. [DOC S&HD 2-14/2-15] $F397 is SFLDIN, the
1172  FFA8              ;       Software function lead-in character, sent ahead of the byte for the high-bit-set case.
1173  FFA8              ; ----------------------------------------------------------------------
1174  FFA8              ; BANNER_PUT_CHAR -- emit one sign-on byte, optionally preceded by a lead-in char.
1175  FFA8              ;   In:  A = byte/flag.  Out: prints via CONOUT_SET_C.  Clobbers: A,HL.
1176  FFA8              ;   Algorithm: if A is positive (bit7 clear) tail-jump to emit it directly
1177  FFA8              ;     (BANNER_EMIT_CHAR); if negative, first emit the software lead-in char from config
1178  FFA8              ;     $F397 (SFLDIN, [DOC S&HD 2-14/2-15]) via CONOUT_SET_C, then emit A. Twin of the
1179  FFA8              ;     2.23-44K SIGNON_EMIT. [RE]
1180  FFA8              ; ----------------------------------------------------------------------
1181  FFA8              BANNER_PUT_CHAR:
1182  FFA8 B7                   OR A
1183  FFA9 F2 B4 FF             JP P,BANNER_EMIT_CHAR
1184  FFAC F5                   PUSH AF
1185  FFAD              BANNER_PUT_ATTR:
1186  FFAD 3A 97 F3             LD A,($F397)
1187  FFB0 CD 4C FB             CALL CONOUT_SET_C
1188  FFB3              BANNER_RESTORE_A:
1189  FFB3 F1                   POP AF
1190  FFB4              BANNER_EMIT_CHAR:
1191  FFB4 C3 4C FB             JP CONOUT_SET_C
1192  FFB7              ; [AI] Cold-boot sign-on banner emitted by the loop above: "Softcard CP/M / 60K Ver. 2.23 / (c)
1193  FFB7              ;       1980,1982 Microsoft". This is the POST-1980 60K / 2.23 variant; the 2.20 manual documents only
1194  FFB7              ;       the "APPLE II CP/M / 44K vers. 2.2X / (C) 1980 MICROSOFT" 44K/56K banner (S&HD 1-8), so the
1195  FFB7              ;       "60K"/"2.23"/"1982" tokens here are version-specific, not manual-backed.
1196  FFB7              SIGNON_BANNER:
1197  FFB7 0D 0A 0A 0A          DEFB    $0D,$0A,$0A,$0A,$20,$20,$20,$20,$20,$53,$6F,$66,$74,$63,$61,$72
1197  FFBB 20 20 20 20
1197  FFBF 20 53 6F 66
1197  FFC3 74 63 61 72
1198  FFC7 64 20 43 50          DEFB    "d CP/M"                 ; string
1198  FFCB 2F 4D
1199  FFCD 0D                   DEFB    $0D                      ; terminator
1200  FFCE 0A 20 20 20          DEFB    $0A,$20,$20,$20,$20,$20,$36,$30,$4B,$20,$56,$65,$72,$2E,$20,$32
1200  FFD2 20 20 36 30
1200  FFD6 4B 20 56 65
1200  FFDA 72 2E 20 32
1201  FFDE 2E 32 33 0D          DEFB    $2E,$32,$33,$0D,$0A,$28,$63,$29,$20,$31,$39,$38,$30,$2C,$31,$39
1201  FFE2 0A 28 63 29
1201  FFE6 20 31 39 38
1201  FFEA 30 2C 31 39
1202  FFEE 38 32 20 4D          DEFB    "82 Microsoft"           ; string
1202  FFF2 69 63 72 6F
1202  FFF6 73 6F 66 74
1203  FFFA 0D                   DEFB    $0D                      ; terminator
1204  FFFB 0A 0D 0A             DEFB    $0A,$0D,$0A
1205  FFFE 00 FA                DEFW    BOOT
1206  0000
1207  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1208  0000
1209  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
1210  0000                  ; Image size from its bracketing labels, not a magic length, as in the 2.23-44K twin:
1211  0000                  ; an overrun fails the build here instead of being silently truncated by SAVEBIN.
1212  0000                  ; $FA00 = the ORG base; the subtraction wraps because the image ends at $10000.
1213  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1214  0000                  ENDIF
1215  0000
1216  0000              ; ----------------------------------------------------------------------
1217  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEFD-$FFF4.
1218  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above (the region the file
1219  0000              ;   header describes as dead after BIOS_BOOT has run). It runs once at cold start; only
1220  0000              ;   afterwards does the disk system reuse them as the buffers DPH_TABLE hands out. The
1221  0000              ;   two tenants are never live at the same time.
1222  0000              ;
1223  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1224  0000              ;   at the overlay base, then one label per field with its extent carried in the
1225  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1226  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1227  0000              ;   the image. Under the CPM60.COM master link this file is assembled inside a
1228  0000              ;   DISP $FA00 block, where sjasmplus moves only the displacement address and leaves
1229  0000              ;   the physical output pointer alone, so the ORGs are safe there too.
1230  0000              ;
1231  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1232  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1233  0000              ;   cold boot has finished. Same shape and names as the 2.20-44K and 2.23-44K twins;
1234  0000              ;   only the addresses differ. [RE]
1235  0000              ; ----------------------------------------------------------------------
1236  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1237  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1238  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1239  0000              CSV_SIZE     EQU 12                   ; = CKS
1240  0000
1241  0000                      ORG $FEFD                     ; the one given: where the author placed the overlay
1242  FEFD              DIRBUF:                               ; shared directory buffer, one per system
1243  FEFD                      ORG DIRBUF + DIRBUF_SIZE
1244  FF7D              ALV_VECTORS:                          ; per-drive allocation vectors ($FF7D..)
1245  FF7D                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1246  FFC5              CSV_VECTORS:                          ; per-drive checksum vectors ($FFC5..)
1247  FFC5                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1248  FFF5              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFF5)
1249  FFF5
1250  FFF5                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1251  FFF5                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1252  FFF5                  ASSERT ALV_VECTORS == $FF7D

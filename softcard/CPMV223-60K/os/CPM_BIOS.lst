 812  FD81 45 FB                DEFW    RPC_TRIGGER
 813  FD83              ; [DOC S&HD 2-24/2-25] Card init that stages 6502 RPC register-pass cells before a SoftCard call:
 814  FD83              ;       $F047 is cell $47 (6502 X register pass area) and $F046 is cell $46 (6502 Y register pass
 815  FD83              ;       area). The full RPC set is $45=A, $46=Y, $47=X, $48=P, $49=6502 SP-on-exit (Y precedes X).
 816  FD83              ; ----------------------------------------------------------------------
 817  FD83              ; INIT_PASCAL_1_0 -- stage the 6502 RPC register-pass cells for a Videx-class card init.
 818  FD83              ;   In:  E = slot index.  Out: A = a card firmware byte; RPC cells staged.  Clobbers: A,HL.
 819  FD83              ;   Algorithm: CALL SLOT_IO_ADDR_W for the card I/O base; stash it in $F6F8 and RPC cell
 820  FD83              ;     $47 ($F047 = 6502 X pass area); read a card byte at $EFFF; SLOT_E000_ADDR + SUB $20
 821  FD83              ;     into RPC cell $46 ($F046 = 6502 Y pass area). [DOC S&HD 2-24/2-25] The full RPC set
 822  FD83              ;     is $45=A, $46=Y, $47=X, $48=P, $49=6502 SP-on-exit. Twin of the 2.23-44K
 823  FD83              ;     SET_SCREEN_BASE. [RE]
 824  FD83              ; ----------------------------------------------------------------------
 825  FD83              INIT_PASCAL_1_0:
 826  FD83 CD 85 FE             CALL SLOT_IO_ADDR_W
 827  FD86 32 F8 F6             LD ($F6F8),A
 828  FD89 32 47 F0             LD ($F047),A
 829  FD8C 3A FF EF             LD A,($EFFF)
 830  FD8F CD B1 FA             CALL SLOT_E000_ADDR
 831  FD92 D6 20                SUB $20
 832  FD94 32 46 F0             LD ($F046),A
 833  FD97 7E                   LD A,(HL)
 834  FD98 C9                   RET
 835  FD99              CONST_SLOT3_TBL:
 836  FD99 21 1D 0E 1E          DEFB    $21,$1D,$0E,$1E,$03,$3E,$01,$CD,$AD,$FD,$3A,$48,$F0,$1F,$9F,$C9
 836  FD9D 03 3E 01 CD
 836  FDA1 AD FD 3A 48
 836  FDA5 F0 1F 9F C9
 837  FDA9 21 E1 0D 79          DEFB    $21,$E1,$0D,$79,$32,$45,$F0
 837  FDAD 32 45 F0
 838  FDB0              ; [AI] Pascal-1.1 card initializer (the POST-1980 device-6 class the 2.20 manual does NOT cover).
 839  FDB0              ;       [DOC S&HD 2-24/2-25] The cell it stages, $F047, is RPC cell $47 (6502 X register pass area);
 840  FDB0              ;       it then triggers the SoftCard call via RPC_TRIGGER. The Pascal-1.1 / device-6 dispatch
 841  FDB0              ;       itself is a 2.23-era extension, not manual-backed.
 842  FDB0              ; ----------------------------------------------------------------------
 843  FDB0              ; PLOT_CHAR_RPC -- Pascal-1.1 / device-6 card initializer (post-1980 class).
 844  FDB0              ;   In:  E = a card parameter byte.  Out: fires the SoftCard call.  Clobbers: A.
 845  FDB0              ;   Algorithm: store E into RPC cell $47 ($F047 = 6502 X register pass area,
 846  FDB0              ;     [DOC S&HD 2-24/2-25]) then tail-jump to RPC_TRIGGER to run the 6502 service.
 847  FDB0              ;     The device-6 / Pascal-1.1 dispatch is a 2.23-era extension the 2.20 manual does
 848  FDB0              ;     NOT document. Twin of the 2.23-44K PLOT_CHAR_RPC family. [RE]
 849  FDB0              ; ----------------------------------------------------------------------
 850  FDB0              PLOT_CHAR_RPC:
 851  FDB0 7B                   LD A,E
 852  FDB1 32 47 F0             LD ($F047),A
 853  FDB4 C3 45 FB             JP RPC_TRIGGER
 854  FDB7 21 0F 0E CD          DEFB    $21,$0F,$0E,$CD
 855  FDBB B0 FD                DEFW    PLOT_CHAR_RPC
 856  FDBD 3A 45 F0 C9          DEFB    $3A,$45,$F0,$C9,$CD
 856  FDC1 CD
 857  FDC2 83 FD                DEFW    INIT_PASCAL_1_0
 858  FDC4 21 4D C8 CD          DEFB    $21,$4D,$C8,$CD
 859  FDC8 45 FB                DEFW    RPC_TRIGGER
 860  FDCA 21 78 F6 19          DEFB    $21,$78,$F6,$19,$7E,$C9,$48,$20,$26,$0E,$A0,$0D,$B1,$F6,$85,$F6
 860  FDCE 7E C9 48 20
 860  FDD2 26 0E A0 0D
 860  FDD6 B1 F6 85 F6
 861  FDDA AC F8 06 68          DEFB    $AC,$F8,$06,$68,$6C,$F6,$00,$48,$A9,$00,$20,$EF,$0D,$20,$26,$0E

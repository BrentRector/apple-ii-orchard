 220  DD06              ; ----------------------------------------------------------------------
 221  DD06              ; CON_GETC_OR_RAW -- return the 1-char type-ahead if present, else read raw console input.
 222  DD06              ;   In: CON_PENDING_CHAR = pending look-ahead char (0 if none).
 223  DD06              ;   Out: A = next console character; CON_PENDING_CHAR cleared if it supplied the byte.
 224  DD06              ;   Clobbers: AF, HL.
 225  DD06              ;   Algorithm: if CON_PENDING_CHAR nonzero, consume it (write 0 back) and return; otherwise
 226  DD06              ;              tail-jump to the BIOS CONIN vector ($FA09) for a fresh key.
 227  DD06              ;   [RE] Single-byte console un-get buffer used by the line editor and F_CONIN_H. Twin of the
 228  DD06              ;        44K CON_GETC_OR_RAW (identical logic; runs in the upper LC bank here).
 229  DD06              ; ----------------------------------------------------------------------
 230  DD06              CON_GETC_OR_RAW:
 231  DD06 21 DC DE             LD HL,CON_PENDING_CHAR
 232  DD09 7E                   LD A,(HL)
 233  DD0A 36 00                LD (HL),$00
 234  DD0C B7                   OR A
 235  DD0D C0                   RET NZ
 236  DD0E C3 09 FA             JP CONIN
 237  DD11              ; ----------------------------------------------------------------------
 238  DD11              ; F_CONIN_RAW -- read one console char, echoing it unless it is a control char.
 239  DD11              ;   In: none.  Out: A = character read.  Clobbers: AF, BC, HL.
 240  DD11              ;   Algorithm: fetch a char (CON_GETC_OR_RAW); test it with LC_BANK1_CALL_ISCTRL (banks the
 241  DD11              ;              lower LC in and calls IS_CTRL_CHAR at $B5C0); on carry (unhandled control) skip
 242  DD11              ;              the echo; otherwise echo the char via F_CONOUT_H, preserving it in A.
 243  DD11              ;   [RE] Backs BDOS function 1 (Console Input with echo). Twin of the 44K F_CONIN_RAW; the
 244  DD11              ;        60K wraps the IS_CTRL_CHAR test in a bank trampoline because that helper lives in the
 245  DD11              ;        lower LC bank.
 246  DD11              ; ----------------------------------------------------------------------
 247  DD11              F_CONIN_RAW:
 248  DD11 CD 06 DD             CALL CON_GETC_OR_RAW
 249  DD14 CD 36 DF             CALL LC_BANK1_CALL_ISCTRL
 250  DD17 D8                   RET C
 251  DD18 F5                   PUSH AF
 252  DD19 4F                   LD C,A
 253  DD1A CD 7D DD             CALL F_CONOUT_H
 254  DD1D F1                   POP AF
 255  DD1E C9                   RET
 256  DD1F              ; ----------------------------------------------------------------------
 257  DD1F              ; CON_POLL_STATUS -- console-status poll that also traps Ctrl-S/Ctrl-C while idle.
 258  DD1F              ;   In: CON_PENDING_CHAR = type-ahead char (nonzero => a key is already pending).
 259  DD1F              ;   Out: A = 1 if a character is ready, 0 if not.  Clobbers: AF.
 260  DD1F              ;   Algorithm: if a char is already buffered, report ready; else call the BIOS console-status
 261  DD1F              ;              vector (CONST $FA06) and mask bit 0. If a key is down, peek it (CONIN $FA09):
 262  DD1F              ;              Ctrl-S ($13) stalls -- the follow-up key Ctrl-C ($03) warm-boots via JP 0; any
 263  DD1F              ;              other key is stashed in CON_PENDING_CHAR (CON_POLL_STASH) and reported ready.
 264  DD1F              ;   [RE] Backs the BDOS console-status / flow-control behaviour. Twin of the 44K CON_POLL_STATUS.
 265  DD1F              ; ----------------------------------------------------------------------
 266  DD1F              CON_POLL_STATUS:
 267  DD1F 3A DC DE             LD A,(CON_PENDING_CHAR)
 268  DD22 B7                   OR A
 269  DD23 20 1A                JR NZ,CON_STATUS_READY
 270  DD25 CD 06 FA             CALL CONST
 271  DD28 E6 01                AND $01
 272  DD2A              ; CON_POLL_STATUS_1 -- fall-through re-entry inside CON_POLL_STATUS: RET Z when no key is down,
 273  DD2A              ;   else read and test the pending key. Not a separate call target (dead auto-name kept local).
 274  DD2A              ;   [RE] Local of CON_POLL_STATUS.
 275  DD2A              CON_POLL_STATUS_1:
 276  DD2A C8                   RET Z
 277  DD2B CD 09 FA             CALL CONIN
 278  DD2E FE 13                CP $13
 279  DD30 20 0A                JR NZ,CON_POLL_STASH
 280  DD32 CD 09 FA             CALL CONIN
 281  DD35 FE 03                CP $03
 282  DD37 CA 00 00             JP Z,WBOOTV
 283  DD3A AF                   XOR A
 284  DD3B C9                   RET
 285  DD3C              ; ----------------------------------------------------------------------
 286  DD3C              ; CON_POLL_STASH -- stash the just-read key as type-ahead and report 'ready'.
 287  DD3C              ;   In: A = key character to hold.  Out: A = 1 (ready).  Clobbers: A.
 288  DD3C              ;   Algorithm: store A into CON_PENDING_CHAR, then fall into the A:=1 tail (CON_STATUS_READY).
 289  DD3C              ;   [RE] Twin of the 44K CON_POLL_STASH.
 290  DD3C              ; ----------------------------------------------------------------------
 291  DD3C              CON_POLL_STASH:
 292  DD3C 32 DC DE             LD (CON_PENDING_CHAR),A
 293  DD3F              ; ----------------------------------------------------------------------
 294  DD3F              ; CON_STATUS_READY -- return A=1, the 'character is ready' status result.
 295  DD3F              ;   In: none.  Out: A=1.  Clobbers: A.  [RE] Shared tail of CON_POLL_STATUS (44K twin).
 296  DD3F              ; ----------------------------------------------------------------------
 297  DD3F              CON_STATUS_READY:
 298  DD3F 3E 01                LD A,$01
 299  DD41 C9                   RET
 300  DD42              ; ----------------------------------------------------------------------
 301  DD42              ; CON_PUT_COL -- output one char to the console, tracking column and honouring Ctrl-S.
 302  DD42              ;   In: C = character to print.
 303  DD42              ;   Out: char sent to console (and to the list device if CON_LIST_ECHO set); the column cell is
 304  DD42              ;        updated for the char.  Clobbers: AF, HL (BC preserved across the BIOS calls).
 305  DD42              ;   Algorithm: unless the redisplay-suppress flag (CON_SAVED_COL) is set, poll for Ctrl-S/Ctrl-C
 306  DD42              ;              (CON_POLL_STATUS) then send C to the BIOS CONOUT ($FA0C) and, if CON_LIST_ECHO is
 307  DD42              ;              set, to the BIOS LIST ($FA0F). Then fall into LC_BANK1_CALL_TRACKCOL to update the
 308  DD42              ;              column via the lower-bank CON_TRACK_COL ($B5D5).
 309  DD42              ;   [RE] Core char output + column bookkeeping. Twin of the 44K CON_PUT_COL; column tracking is
 310  DD42              ;        split into the lower LC bank here.
 311  DD42              ; ----------------------------------------------------------------------
 312  DD42              CON_PUT_COL:
 313  DD42 3A D8 DE             LD A,(CON_SAVED_COL)
 314  DD45 B7                   OR A
 315  DD46 20 13                JR NZ,LC_BANK1_CALL_TRACKCOL
 316  DD48 C5                   PUSH BC
 317  DD49 CD 1F DD             CALL CON_POLL_STATUS
 318  DD4C C1                   POP BC
 319  DD4D C5                   PUSH BC
 320  DD4E CD 0C FA             CALL CONOUT
 321  DD51 C1                   POP BC
 322  DD52 C5                   PUSH BC
 323  DD53              ; CON_PUT_COL_LIST -- fall-through inside CON_PUT_COL: if CON_LIST_ECHO is set, mirror the char
 324  DD53              ;   to the BIOS LIST device ($FA0F). Not a separate call target (dead auto-name kept local).
 325  DD53              ;   [RE] Local of CON_PUT_COL.
 326  DD53              CON_PUT_COL_LIST:
 327  DD53 3A DB DE             LD A,(CON_LIST_ECHO)
 328  DD56 B7                   OR A
 329  DD57 C4 0F FA             CALL NZ,LIST
 330  DD5A C1                   POP BC
 331  DD5B              ; ----------------------------------------------------------------------
 332  DD5B              ; LC_BANK1_CALL_TRACKCOL -- bank the lower LC in and update the console column counter.
 333  DD5B              ;   In: C = char just emitted.  Out: CON_COL adjusted; bank2 restored on return.
 334  DD5B              ;   Clobbers: AF, HL (per CON_TRACK_COL).
 335  DD5B              ;   Algorithm: LD (LC_BANK1),A selects LC read/write bank1 (Apple $C08B) so the lower-bank code
 336  DD5B              ;              at $B5D5 is visible, CALL CON_TRACK_COL (CON_TRACK_COL), then JP LC_BANK2_RET to restore
 337  DD5B              ;              bank2 and RET.
 338  DD5B              ;   [RE] 60K bank-switch trampoline (no 44K counterpart -- 44K tracks the column inline).
 339  DD5B              ; ----------------------------------------------------------------------
 340  DD5B              LC_BANK1_CALL_TRACKCOL:
 341  DD5B 32 8B E0             LD (LC_BANK1),A
 342  DD5E CD D5 B5             CALL CON_TRACK_COL
 343  DD61 C3 81 DF             JP LC_BANK2_RET
 344  DD64 32                   DEFB    $32
 345  DD65 83 E0                DEFW    LC_BANK2
 346  DD67 FE 0A C0 36          DEFB    $FE,$0A,$C0,$36,$00,$C9
 346  DD6B 00 C9
 347  DD6D              ; ----------------------------------------------------------------------
 348  DD6D              ; CON_PUT_VISIBLE -- output a char, expanding non-tab control codes as '^X'.
 349  DD6D              ;   In: C = character.  Out: char(s) sent via CON_PUT_COL / F_CONOUT_H.  Clobbers: AF.
 350  DD6D              ;   Algorithm: test the char with LC_BANK1_CALL_ISCTRL (lower-bank IS_CTRL_CHAR); if it is a
 351  DD6D              ;              handled char (carry clear) print it normally through F_CONOUT_H; otherwise emit
 352  DD6D              ;              '^' ($5E) via CON_PUT_COL then the char OR'd with $40, so e.g. Ctrl-A shows '^A'.
 353  DD6D              ;   [RE] Visible-control echo used by the line editor's buffer redisplay. Twin of 44K
 354  DD6D              ;        CON_PUT_VISIBLE.
 355  DD6D              ; ----------------------------------------------------------------------
 356  DD6D              CON_PUT_VISIBLE:
 357  DD6D 79                   LD A,C
 358  DD6E CD 36 DF             CALL LC_BANK1_CALL_ISCTRL
 359  DD71 30 0A                JR NC,F_CONOUT_H
 360  DD73 F5                   PUSH AF
 361  DD74 0E 5E                LD C,$5E
 362  DD76 CD 42 DD             CALL CON_PUT_COL
 363  DD79 F1                   POP AF
 364  DD7A F6 40                OR $40
 365  DD7C 4F                   LD C,A
 366  DD7D              ; ----------------------------------------------------------------------
 367  DD7D              ; F_CONOUT_H -- BDOS console-output handler (function 2) with tab expansion.
 368  DD7D              ;   In: C = character to print.  Out: character emitted; TAB expands to the next 8-column stop.
 369  DD7D              ;   Clobbers: AF.
 370  DD7D              ;   Algorithm: if C != TAB ($09) just print it via CON_PUT_COL; if TAB, fall into CONOUT_TAB_FILL
 371  DD7D              ;              to emit spaces until CON_COL is a multiple of 8.
 372  DD7D              ;   [DOC CPMREF 3-44] BDOS function 2 (Console Output). Twin of 44K F_CONOUT_H; dispatch fn 2.
 373  DD7D              ; ----------------------------------------------------------------------
 374  DD7D              F_CONOUT_H:
 375  DD7D 79                   LD A,C
 376  DD7E FE 09                CP $09
 377  DD80 20 C0                JR NZ,CON_PUT_COL
 378  DD82              ; ----------------------------------------------------------------------
 379  DD82              ; CONOUT_TAB_FILL -- emit spaces until the column reaches the next 8-stop (tab expand).
 380  DD82              ;   In: CON_COL = current column.  Out: spaces printed until (column & 7)==0.  Clobbers: AF, C.
 381  DD82              ;   Algorithm: output a space via CON_PUT_COL, re-read CON_COL, loop while low 3 bits are set.
 382  DD82              ;   [RE] Tab-expansion loop of F_CONOUT_H (44K twin).
 383  DD82              ; ----------------------------------------------------------------------
 384  DD82              CONOUT_TAB_FILL:
 385  DD82 0E 20                LD C,$20
 386  DD84 CD 42 DD             CALL CON_PUT_COL
 387  DD87 3A DA DE             LD A,(CON_COL)
 388  DD8A E6 07                AND $07
 389  DD8C 20 F4                JR NZ,CONOUT_TAB_FILL
 390  DD8E C9                   RET
 391  DD8F              ; ----------------------------------------------------------------------
 392  DD8F              ; CON_BACKSPACE -- erase the last echoed character (BS, space, BS).
 393  DD8F              ;   In: none.  Out: cursor moved left one cell, char blanked on screen.  Clobbers: AF, C.
 394  DD8F              ;   Algorithm: emit BS via CON_BS_OUT, then a space to the BIOS CONOUT ($FA0C), then fall into
 395  DD8F              ;              CON_BS_OUT for the trailing BS so the previous glyph is overwritten with a blank.
 396  DD8F              ;   [RE] Twin of the 44K CON_BACKSPACE (44K's CON_ERASE_CHAR before de-aliasing).
 397  DD8F              ; ----------------------------------------------------------------------
 398  DD8F              CON_BACKSPACE:
 399  DD8F CD 97 DD             CALL CON_BS_OUT
 400  DD92 0E 20                LD C,$20
 401  DD94 CD 0C FA             CALL CONOUT
 402  DD97              ; ----------------------------------------------------------------------
 403  DD97              ; CON_BS_OUT -- send a single backspace ($08) to the console.
 404  DD97              ;   In: none.  Out: BS emitted via the BIOS CONOUT vector ($FA0C).  Clobbers: C.
 405  DD97              ;   [RE] Tail-call helper; also the leading and trailing BS of CON_BACKSPACE. Twin of 44K
 406  DD97              ;        CON_BS_OUT.
 407  DD97              ; ----------------------------------------------------------------------
 408  DD97              CON_BS_OUT:
 409  DD97 0E 08                LD C,$08
 410  DD99 C3 0C FA             JP CONOUT
 411  DD9C              ; ----------------------------------------------------------------------
 412  DD9C              ; CON_RETYPE_LINE -- echo '#' + CR/LF and reposition for a line-kill / retype (Ctrl-U/Ctrl-R).
 413  DD9C              ;   In: CON_COL = current column; CON_LINE_START_COL = line-start column.
 414  DD9C              ;   Out: '#' printed on a fresh line; cursor advanced with spaces back to the start column.
 415  DD9C              ;   Clobbers: AF, C, HL.
 416  DD9C              ;   Algorithm: print '#' ($23) via CON_PUT_COL, CON_CRLF, then fall into CON_RETYPE_LOOP to emit
 417  DD9C              ;              spaces until CON_COL reaches CON_LINE_START_COL.
 418  DD9C              ;   [RE] Twin of the 44K CON_RETYPE_LINE (60K's CON_LINE_KILL auto-name).
 419  DD9C              ; ----------------------------------------------------------------------
 420  DD9C              CON_RETYPE_LINE:
 421  DD9C 0E 23                LD C,$23
 422  DD9E CD 42 DD             CALL CON_PUT_COL
 423  DDA1 CD B3 DD             CALL CON_CRLF
 424  DDA4              ; ----------------------------------------------------------------------
 425  DDA4              ; CON_RETYPE_LOOP -- advance the cursor with spaces until the column matches the start count.
 426  DDA4              ;   In: CON_LINE_START_COL = target column; CON_COL = current column.
 427  DDA4              ;   Out: spaces emitted until CON_COL >= CON_LINE_START_COL.  Clobbers: AF, C, HL.
 428  DDA4              ;   Algorithm: while CON_COL < CON_LINE_START_COL, emit a space via CON_PUT_COL and loop.
 429  DDA4              ;   [RE] Re-echo loop of CON_RETYPE_LINE (44K twin).
 430  DDA4              ; ----------------------------------------------------------------------
 431  DDA4              CON_RETYPE_LOOP:
 432  DDA4 3A DA DE             LD A,(CON_COL)
 433  DDA7 21 D9 DE             LD HL,CON_LINE_START_COL
 434  DDAA BE                   CP (HL)
 435  DDAB D0                   RET NC
 436  DDAC 0E 20                LD C,$20
 437  DDAE CD 42 DD             CALL CON_PUT_COL
 438  DDB1 18 F1                JR CON_RETYPE_LOOP
 439  DDB3              CON_CRLF:
 440  DDB3 0E 0D                LD C,$0D
 441  DDB5 CD 42 DD             CALL CON_PUT_COL
 442  DDB8 0E 0A                LD C,$0A
 443  DDBA 18 86                JR CON_PUT_COL
 444  DDBC              ; [DOC CPMREF 3-44] Print String helper (BDOS fn 9 body): writes successive characters from the
 445  DDBC              ;       buffer addressed by BC to the console until the '$' terminator ($24) is reached.
 446  DDBC              ; ----------------------------------------------------------------------
 447  DDBC              ; CON_PRINT_STR -- print a '$'-terminated string to the console.
 448  DDBC              ;   In: BC = pointer to the string; terminated by '$' ($24).
 449  DDBC              ;   Out: each char emitted via F_CONOUT_H until '$' is reached.  Clobbers: AF, BC, C.
 450  DDBC              ;   Algorithm: load (BC); if '$' return; else advance BC, output the char via F_CONOUT_H
 451  DDBC              ;              (preserving BC), and loop.
 452  DDBC              ;   [DOC CPMREF 3-44] Backs BDOS function 9 (Print String) and the BDOS error banner. Twin of
 453  DDBC              ;        the 44K CON_PRINT_STR.
 454  DDBC              ; ----------------------------------------------------------------------
 455  DDBC              CON_PRINT_STR:
 456  DDBC 0A                   LD A,(BC)
 457  DDBD FE 24                CP $24                           ; '$' string terminator
 458  DDBF C8                   RET Z
 459  DDC0 03                   INC BC
 460  DDC1 C5                   PUSH BC
 461  DDC2 4F                   LD C,A
 462  DDC3 CD 7D DD             CALL F_CONOUT_H
 463  DDC6 C1                   POP BC
 464  DDC7 18 F3                JR CON_PRINT_STR
 465  DDC9              ; [DOC CPMREF 3-44] Read Console Buffer (BDOS fn 10): edited line input into the buffer pointed
 466  DDC9              ;       to by DE. The first buffer byte is the maximum count (mx) read here into C; the second
 467  DDC9              ;       byte (nc) receives the resulting character count; the typed characters follow. Implements
 468  DDC9              ;       the CP/M line editor (ctl-H/rubout backspace, ctl-X line-kill, ctl-R retype, ctl-E phys
 469  DDC9              ;       EOL, ctl-P printer echo, ctl-C reboot), terminating on CR ($0D) or LF ($0A).
 470  DDC9              ; ----------------------------------------------------------------------
 471  DDC9              ; F_READCONBUF_H -- BDOS buffered console line input (function 10) with editing.
 472  DDC9              ;   In: BDOS_PARAM_PTR -> the read buffer (byte0 = max length, byte1 = returned count, data...).
 473  DDC9              ;   Out: the buffer filled with the edited line; byte1 set to the char count.
 474  DDC9              ;   Clobbers: AF, BC, DE, HL.
 475  DDC9              ;   Algorithm: seed the echoed-count (CON_LINE_START_COL) from CON_COL; read chars one at a time
 476  DDC9              ;              (CON_GETC_OR_RAW, masked to 7 bits) and dispatch the editing controls: CR/LF
 477  DDC9              ;              terminate; BS/DEL delete; Ctrl-E new line; Ctrl-P printer toggle; Ctrl-X erase
 478  DDC9              ;              line; Ctrl-U abandon ('#'); Ctrl-R retype; other chars stored. Ends by writing the
 479  DDC9              ;              count and a CR.
 480  DDC9              ;   [DOC CPMREF 3-44] Classic CP/M 2.2 line editor (Read Console Buffer). Twin of 44K
 481  DDC9              ;        F_READCONBUF_H; dispatch fn 10.
 482  DDC9              ; ----------------------------------------------------------------------
 483  DDC9              F_READCONBUF_H:
 484  DDC9 3A DA DE             LD A,(CON_COL)
 485  DDCC 32 D9 DE             LD (CON_LINE_START_COL),A
 486  DDCF 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
 487  DDD2 4E                   LD C,(HL)                        ; 4E    mx = buffer max count (first byte)
 488  DDD3 23                   INC HL
 489  DDD4 E5                   PUSH HL
 490  DDD5 06 00                LD B,$00
 491  DDD7              ; ----------------------------------------------------------------------
 492  DDD7              ; READBUF_NEXT -- top of the line-editor read loop: save state and fetch a char.
 493  DDD7              ;   In: B = count so far, HL -> buffer position.
 494  DDD7              ;   Out: falls into READBUF_GETC with BC/HL preserved on the stack.  Clobbers: stack.
 495  DDD7              ;   [RE] Per-keystroke loop head of F_READCONBUF_H (44K twin).
 496  DDD7              ; ----------------------------------------------------------------------
 497  DDD7              READBUF_NEXT:
 498  DDD7 C5                   PUSH BC
 499  DDD8 E5                   PUSH HL
 500  DDD9              ; ----------------------------------------------------------------------
 501  DDD9              ; READBUF_GETC -- read and classify the next edit character.
 502  DDD9              ;   In: stacked BC/HL = saved count and buffer pointer.
 503  DDD9              ;   Out: A = 7-bit char; control codes dispatched to the appropriate editor handler.
 504  DDD9              ;   Clobbers: AF, BC, HL.
 505  DDD9              ;   Algorithm: CON_GETC_OR_RAW, mask to 7 bits, restore BC/HL, then chain CP/JP tests: CR/LF ->
 506  DDD9              ;              READBUF_DONE; BS -> back up one char (READBUF_REDISPLAY path); else fall to the
 507  DDD9              ;              DEL/control handlers.
 508  DDD9              ;   [RE] Keystroke dispatcher inside F_READCONBUF_H (44K twin).
 509  DDD9              ; ----------------------------------------------------------------------
 510  DDD9              READBUF_GETC:
 511  DDD9 CD 06 DD             CALL CON_GETC_OR_RAW
 512  DDDC E6 7F                AND $7F
 513  DDDE E1                   POP HL
 514  DDDF C1                   POP BC
 515  DDE0 FE 0D                CP $0D
 516  DDE2 CA 95 DE             JP Z,READBUF_DONE
 517  DDE5 FE 0A                CP $0A
 518  DDE7 CA 95 DE             JP Z,READBUF_DONE
 519  DDEA FE 08                CP $08
 520  DDEC 20 0D                JR NZ,READBUF_DEL
 521  DDEE 78                   LD A,B
 522  DDEF B7                   OR A
 523  DDF0 28 E5                JR Z,READBUF_NEXT
 524  DDF2 05                   DEC B
 525  DDF3 3A DA DE             LD A,(CON_COL)
 526  DDF6 32 D8 DE             LD (CON_SAVED_COL),A
 527  DDF9 18 4D                JR READBUF_REDISPLAY
 528  DDFB              ; ----------------------------------------------------------------------
 529  DDFB              ; READBUF_DEL -- handle DEL ($7F) as a destructive rubout of the previous char.
 530  DDFB              ;   In: A = char, B = count, HL -> buffer position.
 531  DDFB              ;   Out: if buffer nonempty, last char fetched for re-echo and pointer/count backed up; empty
 532  DDFB              ;        buffer just re-loops.  Clobbers: AF, B, HL.
 533  DDFB              ;   [RE] DELETE-key path of the line editor (44K twin).
 534  DDFB              ; ----------------------------------------------------------------------
 535  DDFB              READBUF_DEL:
 536  DDFB FE 7F                CP $7F
 537  DDFD 20 09                JR NZ,READBUF_CTRL_E
 538  DDFF 78                   LD A,B
 539  DE00 B7                   OR A
 540  DE01 28 D4                JR Z,READBUF_NEXT
 541  DE03 7E                   LD A,(HL)
 542  DE04 05                   DEC B
 543  DE05 2B                   DEC HL
 544  DE06 18 76                JR READBUF_STORE_ECHO
 545  DE08              ; ----------------------------------------------------------------------
 546  DE08              ; READBUF_CTRL_E -- handle Ctrl-E ($05): physical CR/LF without ending the line.
 547  DE08              ;   In: A = char, BC/HL = editor state.  Out: cursor moved to a new line, echoed-count reset;
 548  DE08              ;       editing continues.  Clobbers: AF.
 549  DE08              ;   Algorithm: on Ctrl-E print CR/LF (CON_CRLF), zero CON_LINE_START_COL, resume at READBUF_GETC;
 550  DE08              ;              otherwise fall through to READBUF_CTRL_P.
 551  DE08              ;   [RE] 44K twin.
 552  DE08              ; ----------------------------------------------------------------------
 553  DE08              READBUF_CTRL_E:
 554  DE08 FE 05                CP $05
 555  DE0A 20 0B                JR NZ,READBUF_CTRL_P
 556  DE0C C5                   PUSH BC
 557  DE0D E5                   PUSH HL
 558  DE0E CD B3 DD             CALL CON_CRLF
 559  DE11 AF                   XOR A
 560  DE12 32 D9 DE             LD (CON_LINE_START_COL),A
 561  DE15 18 C2                JR READBUF_GETC
 562  DE17              ; ----------------------------------------------------------------------
 563  DE17              ; READBUF_CTRL_P -- handle Ctrl-P ($10): toggle the printer (list-device) echo flag.
 564  DE17              ;   In: A = char.  Out: CON_LIST_ECHO flipped between 0 and 1; editing continues.
 565  DE17              ;   Clobbers: AF, HL.
 566  DE17              ;   Algorithm: on Ctrl-P compute 1 - CON_LIST_ECHO to toggle, then loop (READBUF_NEXT);
 567  DE17              ;              otherwise fall through to READBUF_CTRL_X.
 568  DE17              ;   [RE] 44K twin.
 569  DE17              ; ----------------------------------------------------------------------
 570  DE17              READBUF_CTRL_P:
 571  DE17 FE 10                CP $10
 572  DE19 20 0B                JR NZ,READBUF_CTRL_X
 573  DE1B E5                   PUSH HL
 574  DE1C 21 DB DE             LD HL,CON_LIST_ECHO
 575  DE1F 3E 01                LD A,$01
 576  DE21 96                   SUB (HL)
 577  DE22 77                   LD (HL),A
 578  DE23 E1                   POP HL
 579  DE24 18 B1                JR READBUF_NEXT
 580  DE26              ; ----------------------------------------------------------------------
 581  DE26              ; READBUF_CTRL_X -- handle Ctrl-X ($18): erase the whole input line.
 582  DE26              ;   In: A = char; CON_COL = column; CON_LINE_START_COL = start column.
 583  DE26              ;   Out: all echoed chars backspaced away and the buffer emptied; editing restarts.
 584  DE26              ;   Clobbers: AF, HL.
 585  DE26              ;   Algorithm: on Ctrl-X drop the buffer pointer and fall into READBUF_ERASE_LOOP; else fall to
 586  DE26              ;              READBUF_CTRL_U.
 587  DE26              ;   [RE] 44K twin.
 588  DE26              ; ----------------------------------------------------------------------
 589  DE26              READBUF_CTRL_X:
 590  DE26 FE 18                CP $18
 591  DE28 20 10                JR NZ,READBUF_CTRL_U
 592  DE2A E1                   POP HL
 593  DE2B              ; ----------------------------------------------------------------------
 594  DE2B              ; READBUF_ERASE_LOOP -- backspace-erase characters back to the line start.
 595  DE2B              ;   In: CON_LINE_START_COL = start column, CON_COL = current column.
 596  DE2B              ;   Out: console column reduced to the start; chars visually erased; restarts F_READCONBUF_H.
 597  DE2B              ;   Clobbers: AF, HL.
 598  DE2B              ;   Algorithm: while CON_COL > CON_LINE_START_COL, decrement it and CON_BACKSPACE; then restart
 599  DE2B              ;              the read with an empty buffer.
 600  DE2B              ;   [RE] 44K twin.
 601  DE2B              ; ----------------------------------------------------------------------
 602  DE2B              READBUF_ERASE_LOOP:
 603  DE2B 3A D9 DE             LD A,(CON_LINE_START_COL)
 604  DE2E 21 DA DE             LD HL,CON_COL
 605  DE31 BE                   CP (HL)
 606  DE32 30 95                JR NC,F_READCONBUF_H
 607  DE34 35                   DEC (HL)
 608  DE35 CD 8F DD             CALL CON_BACKSPACE
 609  DE38 18 F1                JR READBUF_ERASE_LOOP
 610  DE3A              ; ----------------------------------------------------------------------
 611  DE3A              ; READBUF_CTRL_U -- handle Ctrl-U ($15): abandon the line, show '#', restart.
 612  DE3A              ;   In: A = char.  Out: '#' printed, fresh line started, buffer reset (restarts F_READCONBUF_H).
 613  DE3A              ;   Clobbers: AF, HL.
 614  DE3A              ;   Algorithm: on Ctrl-U call CON_RETYPE_LINE ('#'+CRLF) and restart the read; otherwise fall to
 615  DE3A              ;              READBUF_CTRL_R.
 616  DE3A              ;   [RE] 44K twin.
 617  DE3A              ; ----------------------------------------------------------------------
 618  DE3A              READBUF_CTRL_U:
 619  DE3A FE 15                CP $15
 620  DE3C 20 06                JR NZ,READBUF_CTRL_R
 621  DE3E CD 9C DD             CALL CON_RETYPE_LINE
 622  DE41 E1                   POP HL
 623  DE42 18 85                JR F_READCONBUF_H
 624  DE44              ; ----------------------------------------------------------------------
 625  DE44              ; READBUF_CTRL_R -- handle Ctrl-R ($12): retype the current line, else store the char.
 626  DE44              ;   In: A = char, B = count, HL -> buffer.
 627  DE44              ;   Out: Ctrl-R reprints the buffer (falls into READBUF_REDISPLAY); any other char jumps to the
 628  DE44              ;        store path (READBUF_STORE).  Clobbers: AF.
 629  DE44              ;   [RE] 44K twin.
 630  DE44              ; ----------------------------------------------------------------------
 631  DE44              READBUF_CTRL_R:
 632  DE44 FE 12                CP $12
 633  DE46 20 33                JR NZ,READBUF_STORE
 634  DE48              ; ----------------------------------------------------------------------
 635  DE48              ; READBUF_REDISPLAY -- reprint the buffered line after a retype/delete.
 636  DE48              ;   In: B = char count; buffer pointer on stack (HL).
 637  DE48              ;   Out: '#'/CRLF emitted then each buffered char re-echoed via CON_PUT_VISIBLE.
 638  DE48              ;   Clobbers: AF, BC, HL.
 639  DE48              ;   Algorithm: CON_RETYPE_LINE for the marker, then walk the buffer (READBUF_REDISPLAY_LOOP)
 640  DE48              ;              re-echoing each stored char with CON_PUT_VISIBLE (controls show as '^X').
 641  DE48              ;   [RE] Used by Ctrl-R and after a backspace. 44K twin.
 642  DE48              ; ----------------------------------------------------------------------
 643  DE48              READBUF_REDISPLAY:
 644  DE48 C5                   PUSH BC
 645  DE49 CD 9C DD             CALL CON_RETYPE_LINE
 646  DE4C C1                   POP BC
 647  DE4D E1                   POP HL
 648  DE4E E5                   PUSH HL
 649  DE4F C5                   PUSH BC
 650  DE50              ; ----------------------------------------------------------------------
 651  DE50              ; READBUF_REDISPLAY_LOOP -- re-echo each buffered character.
 652  DE50              ;   In: B = remaining count, HL -> buffer position.
 653  DE50              ;   Out: every buffered char emitted via CON_PUT_VISIBLE.  Clobbers: AF, BC, C, HL.
 654  DE50              ;   Algorithm: while B != 0, advance HL, load the char, CON_PUT_VISIBLE it, decrement B; on
 655  DE50              ;              exhaustion fall into READBUF_REPOS.
 656  DE50              ;   [RE] 44K twin.
 657  DE50              ; ----------------------------------------------------------------------
 658  DE50              READBUF_REDISPLAY_LOOP:
 659  DE50 78                   LD A,B
 660  DE51 B7                   OR A
 661  DE52 28 0C                JR Z,READBUF_REPOS
 662  DE54 23                   INC HL
 663  DE55 4E                   LD C,(HL)
 664  DE56 05                   DEC B
 665  DE57 C5                   PUSH BC
 666  DE58 E5                   PUSH HL
 667  DE59 CD 6D DD             CALL CON_PUT_VISIBLE
 668  DE5C E1                   POP HL
 669  DE5D C1                   POP BC
 670  DE5E 18 F0                JR READBUF_REDISPLAY_LOOP
 671  DE60              ; ----------------------------------------------------------------------
 672  DE60              ; READBUF_REPOS -- after redisplay, backspace the cursor to the edit position.
 673  DE60              ;   In: CON_SAVED_COL = saved column to restore to, CON_COL = current column.
 674  DE60              ;   Out: cursor moved back so further typing continues at the right spot.  Clobbers: AF, HL.
 675  DE60              ;   Algorithm: if no saved position (CON_SAVED_COL==0) resume at READBUF_GETC; else compute how
 676  DE60              ;              far past the target the cursor is (CON_SAVED_COL := saved - column) and fall into
 677  DE60              ;              READBUF_REPOS_LOOP.
 678  DE60              ;   [RE] Cursor-reposition step after a Ctrl-R / delete redisplay. 44K twin.
 679  DE60              ; ----------------------------------------------------------------------
 680  DE60              READBUF_REPOS:
 681  DE60 E5                   PUSH HL
 682  DE61 3A D8 DE             LD A,(CON_SAVED_COL)
 683  DE64 B7                   OR A
 684  DE65 CA D9 DD             JP Z,READBUF_GETC
 685  DE68 21 DA DE             LD HL,CON_COL
 686  DE6B 96                   SUB (HL)
 687  DE6C 32 D8 DE             LD (CON_SAVED_COL),A
 688  DE6F              ; ----------------------------------------------------------------------
 689  DE6F              ; READBUF_REPOS_LOOP -- backspace the cursor by the computed cell count.
 690  DE6F              ;   In: CON_SAVED_COL = number of cells to back up.
 691  DE6F              ;   Out: cursor repositioned; loop ends and the editor reads the next char (READBUF_GETC).
 692  DE6F              ;   Clobbers: AF, HL.
 693  DE6F              ;   Algorithm: CON_BACKSPACE, decrement CON_SAVED_COL, repeat until zero, then resume input.
 694  DE6F              ;   [RE] 44K twin.
 695  DE6F              ; ----------------------------------------------------------------------
 696  DE6F              READBUF_REPOS_LOOP:
 697  DE6F CD 8F DD             CALL CON_BACKSPACE
 698  DE72 21 D8 DE             LD HL,CON_SAVED_COL
 699  DE75 35                   DEC (HL)
 700  DE76 20 F7                JR NZ,READBUF_REPOS_LOOP
 701  DE78 C3 D9 DD             JP READBUF_GETC
 702  DE7B              ; ----------------------------------------------------------------------
 703  DE7B              ; READBUF_STORE -- store an ordinary character into the input buffer.
 704  DE7B              ;   In: A = char to store, B = count, HL -> next buffer slot.
 705  DE7B              ;   Out: char written, count incremented; falls into READBUF_STORE_ECHO.  Clobbers: AF, B, HL.
 706  DE7B              ;   Algorithm: write the char at ++HL, bump B, then fall into the echo/limit check.
 707  DE7B              ;   [RE] Line editor's character-store path. 44K twin.
 708  DE7B              ; ----------------------------------------------------------------------
 709  DE7B              READBUF_STORE:
 710  DE7B 23                   INC HL
 711  DE7C 77                   LD (HL),A
 712  DE7D 04                   INC B
 713  DE7E              ; ----------------------------------------------------------------------
 714  DE7E              ; READBUF_STORE_ECHO -- echo the stored char and enforce the buffer length limit.
 715  DE7E              ;   In: A = char, B = count, C = buffer max length.
 716  DE7E              ;   Out: char echoed; if count reached the max (or a degenerate max) the line terminates,
 717  DE7E              ;        otherwise reading continues.  Clobbers: AF, BC, HL.
 718  DE7E              ;   Algorithm: echo via CON_PUT_VISIBLE; reload the buffer max; if the max byte is 1 (degenerate)
 719  DE7E              ;              warm-boot (JP 0); if count == max terminate (READBUF_LIMIT), else loop.
 720  DE7E              ;   [RE] 44K twin. [?] exact degenerate-max semantics beyond 'terminate when full' UNKNOWN.
 721  DE7E              ; ----------------------------------------------------------------------
 722  DE7E              READBUF_STORE_ECHO:
 723  DE7E C5                   PUSH BC
 724  DE7F E5                   PUSH HL
 725  DE80 4F                   LD C,A
 726  DE81 CD 6D DD             CALL CON_PUT_VISIBLE
 727  DE84 E1                   POP HL
 728  DE85 C1                   POP BC
 729  DE86 7E                   LD A,(HL)
 730  DE87 FE 03                CP $03
 731  DE89 78                   LD A,B
 732  DE8A 20 05                JR NZ,READBUF_LIMIT
 733  DE8C FE 01                CP $01
 734  DE8E CA 00 00             JP Z,WBOOTV
 735  DE91              ; ----------------------------------------------------------------------
 736  DE91              ; READBUF_LIMIT -- compare the count to the buffer max and continue or finish.
 737  DE91              ;   In: A = count (B), C = buffer maximum length.
 738  DE91              ;   Out: if count < max keep reading (READBUF_NEXT), else fall into READBUF_DONE.
 739  DE91              ;   Clobbers: AF.
 740  DE91              ;   Algorithm: CP C; if count < max (carry) loop, else finish. [RE] 44K twin.
 741  DE91              ; ----------------------------------------------------------------------
 742  DE91              READBUF_LIMIT:
 743  DE91 B9                   CP C
 744  DE92 DA D7 DD             JP C,READBUF_NEXT
 745  DE95              ; ----------------------------------------------------------------------
 746  DE95              ; READBUF_DONE -- finish the input line: store the count and emit a CR.
 747  DE95              ;   In: stacked HL -> buffer count byte; B = final character count.
 748  DE95              ;   Out: count written into the buffer; CR echoed; returns to the BDOS caller.
 749  DE95              ;   Clobbers: AF, C, HL.
 750  DE95              ;   Algorithm: pop the buffer pointer, store B as the returned count, then tail-call CON_PUT_COL
 751  DE95              ;              with CR ($0D) to close the input line.
 752  DE95              ;   [RE] Reached on CR/LF/buffer-full. 44K twin.
 753  DE95              ; ----------------------------------------------------------------------
 754  DE95              READBUF_DONE:
 755  DE95 E1                   POP HL
 756  DE96 70                   LD (HL),B
 757  DE97 0E 0D                LD C,$0D
 758  DE99 C3 42 DD             JP CON_PUT_COL
 759  DE9C              ; [DOC CPMREF 3-44] Console Input (BDOS fn 1): reads one character from the console (with echo,
 760  DE9C              ;       tab expansion, and ctl-S/ctl-P handling) and returns it in A.
 761  DE9C              ; ----------------------------------------------------------------------
 762  DE9C              ; F_CONIN_H -- BDOS function 1 handler: console input with echo, returned in A.
 763  DE9C              ;   In: none.  Out: BDOS result (BDOS_RETVAL) = char read.  Clobbers: AF, BC, HL.
 764  DE9C              ;   Algorithm: read+echo via F_CONIN_RAW, then store the char through BDOS_RET_RESULT.
 765  DE9C              ;   [DOC CPMREF 3-44] Dispatch-table entry for function 1. Twin of 44K F_CONIN_H.
 766  DE9C              ; ----------------------------------------------------------------------
 767  DE9C              F_CONIN_H:
 768  DE9C CD 11 DD             CALL F_CONIN_RAW
 769  DE9F 18 2F                JR BDOS_RET_RESULT
 770  DEA1              ; [DOC CPMREF 3-44] Reader Input (BDOS fn 3): returns one character from the logical RDR: device
 771  DEA1              ;       (BIOS READER entry) in A.
 772  DEA1              ; ----------------------------------------------------------------------
 773  DEA1              ; F_READERIN_H -- BDOS function 3 handler: read from the reader (RDR/AUX) device.
 774  DEA1              ;   In: none.  Out: BDOS result (BDOS_RETVAL) = byte from the BIOS READER vector.  Clobbers: AF.
 775  DEA1              ;   Algorithm: call the BIOS reader-input vector (READER $FA15), store the byte via
 776  DEA1              ;              BDOS_RET_RESULT.
 777  DEA1              ;   [DOC CPMREF 3-44] Dispatch entry for function 3 (Reader Input). Twin of 44K F_READERIN_H.
 778  DEA1              ; ----------------------------------------------------------------------
 779  DEA1              F_READERIN_H:
 780  DEA1 CD 15 FA             CALL READER
 781  DEA4 18 2A                JR BDOS_RET_RESULT
 782  DEA6              ; [DOC CPMREF 3-44] Direct Console I/O (BDOS fn 6): if E=$FF (here C=$FF, INC->$00) it returns an
 783  DEA6              ;       input char or $00-status; otherwise E is a character sent raw to the console (no ctl-S/ctl-P
 784  DEA6              ;       processing). The E=$FE status form is a CP/M extension; this build handles it via the second
 785  DEA6              ;       INC (C=$FE).
 786  DEA6              ; ----------------------------------------------------------------------
 787  DEA6              ; F_DIRECTIO_H -- BDOS function 6 handler: direct console I/O.
 788  DEA6              ;   In: C = subfunction ($FF = input/status, $FE = status only, else = output char).
 789  DEA6              ;   Out: input/status results via BDOS_RET_RESULT; output sent raw to the console.  Clobbers: AF.
 790  DEA6              ;   Algorithm: C==$FF (INC A -> Z) -> DIRECTIO_INPUT; C==$FE (second INC A -> Z) -> raw BIOS
 791  DEA6              ;              CONST ($FA06); otherwise send C to BIOS CONOUT ($FA0C), bypassing editor and flow
 792  DEA6              ;              control.
 793  DEA6              ;   [DOC CPMREF 3-44] Dispatch entry for function 6 (Direct Console I/O). Twin of 44K
 794  DEA6              ;        F_DIRECTIO_H.
 795  DEA6              ; ----------------------------------------------------------------------
 796  DEA6              F_DIRECTIO_H:
 797  DEA6 79                   LD A,C
 798  DEA7 3C                   INC A                            ; 3C    C=$FF (input request) -> Z
 799  DEA8 28 07                JR Z,DIRECTIO_INPUT
 800  DEAA 3C                   INC A                            ; 3C    C=$FE (status request) -> Z
 801  DEAB CA 06 FA             JP Z,CONST
 802  DEAE C3 0C FA             JP CONOUT                        ; otherwise output the raw character
 803  DEB1              ; ----------------------------------------------------------------------
 804  DEB1              ; DIRECTIO_INPUT -- direct console input subfunction of function 6.
 805  DEB1              ;   In: none.  Out: BDOS result = char if one is ready, else 0; no echo, no flow control.
 806  DEB1              ;   Clobbers: AF.
 807  DEB1              ;   Algorithm: poll raw BIOS CONST ($FA06); if no key, return 0 via BDOS_EXIT_RESTORE; if a key
 808  DEB1              ;              is ready read it raw (CONIN $FA09) and store via BDOS_RET_RESULT.
 809  DEB1              ;   [RE] 44K twin (DIRECTIO_INPUT); this is direct console input, not an FCB/directory routine.
 810  DEB1              ; ----------------------------------------------------------------------
 811  DEB1              DIRECTIO_INPUT:
 812  DEB1 CD 06 FA             CALL CONST
 813  DEB4 B7                   OR A
 814  DEB5 CA 63 DF             JP Z,BDOS_EXIT_RESTORE           ; no char ready -> return $00
 815  DEB8 CD 09 FA             CALL CONIN
 816  DEBB 18 13                JR BDOS_RET_RESULT
 817  DEBD              ; [DOC CPMREF 3-50] Get I/O Byte (BDOS fn 7): returns the current IOBYTE_ADDR ($0003) in A.
 818  DEBD              ; ----------------------------------------------------------------------
 819  DEBD              ; F_GETIOB_H -- BDOS function 7 handler: get the I/O byte (IOBYTE_ADDR).
 820  DEBD              ;   In: none.  Out: BDOS result = the IOBYTE_ADDR at fixed address $0003.  Clobbers: AF.
 821  DEBD              ;   Algorithm: load (IOBYTE_ADDR) and return it via BDOS_RET_RESULT.
 822  DEBD              ;   [DOC CPMREF 3-50] Dispatch entry for function 7. Twin of 44K F_GETIOB_H.
 823  DEBD              ; ----------------------------------------------------------------------
 824  DEBD              F_GETIOB_H:
 825  DEBD 3A 03 00             LD A,(IOBYTE_ADDR)
 826  DEC0 18 0E                JR BDOS_RET_RESULT
 827  DEC2              ; [DOC CPMREF 3-51] Set I/O Byte (BDOS fn 8): stores E (passed in C here) into the IOBYTE_ADDR ($0003).
 828  DEC2              ; ----------------------------------------------------------------------
 829  DEC2              ; F_SETIOB_H -- BDOS function 8 handler: set the I/O byte (IOBYTE_ADDR).
 830  DEC2              ;   In: C = new IOBYTE_ADDR value.  Out: (IOBYTE_ADDR) = C.  Clobbers: HL.
 831  DEC2              ;   Algorithm: store C into the fixed IOBYTE_ADDR cell at $0003 and return.
 832  DEC2              ;   [DOC CPMREF 3-51] Dispatch entry for function 8. Twin of 44K F_SETIOB_H.
 833  DEC2              ; ----------------------------------------------------------------------
 834  DEC2              F_SETIOB_H:
 835  DEC2 21 03 00             LD HL,IOBYTE_ADDR
 836  DEC5 71                   LD (HL),C
 837  DEC6 C9                   RET
 838  DEC7              ; [DOC CPMREF 3-44] Print String (BDOS fn 9): DE addresses a '$'-terminated string; move it into BC
 839  DEC7              ;       and fall into the CON_PRINT_STR helper to emit it to the console.
 840  DEC7              ; ----------------------------------------------------------------------
 841  DEC7              ; F_PRINTSTR_H -- BDOS function 9 handler: print a '$'-terminated string.
 842  DEC7              ;   In: DE = pointer to the string.  Out: string echoed up to the '$'.  Clobbers: AF, BC.
 843  DEC7              ;   Algorithm: move DE into BC and tail-call CON_PRINT_STR.
 844  DEC7              ;   [DOC CPMREF 3-44] Dispatch entry for function 9. Twin of 44K F_PRINTSTR_H.
 845  DEC7              ; ----------------------------------------------------------------------
 846  DEC7              F_PRINTSTR_H:
 847  DEC7 EB                   EX DE,HL
 848  DEC8 4D                   LD C,L
 849  DEC9 44                   LD B,H
 850  DECA C3 BC DD             JP CON_PRINT_STR
 851  DECD              ; [DOC CPMREF 3-44] Get Console Status (BDOS fn 11): returns A=$FF if a console character is ready,
 852  DECD              ;       $00 otherwise (also services the ctl-S pause / ctl-C warm-boot break check).
 853  DECD              ; ----------------------------------------------------------------------
 854  DECD              ; F_CONSTAT_H -- BDOS function 11 handler: get console status.
 855  DECD              ;   In: none.  Out: BDOS result = 1 if a console char is ready, else 0.  Clobbers: AF.
 856  DECD              ;   Algorithm: CON_POLL_STATUS to test readiness (handling Ctrl-S/Ctrl-C), then fall into
 857  DECD              ;              BDOS_RET_RESULT to store the 0/1 status.
 858  DECD              ;   [DOC CPMREF 3-44] Dispatch entry for function 11. Twin of 44K F_CONSTAT_H.
 859  DECD              ; ----------------------------------------------------------------------
 860  DECD              F_CONSTAT_H:
 861  DECD CD 1F DD             CALL CON_POLL_STATUS
 862  DED0              ; Stores the byte result in A into the BDOS return-value cell (read back into A=L,B=H on BDOS exit).
 863  DED0              ; ----------------------------------------------------------------------
 864  DED0              ; BDOS_RET_RESULT -- store A as the BDOS function return value and return.
 865  DED0              ;   In: A = result byte.  Out: BDOS_RETVAL (low byte) = A.  Clobbers: none beyond the cell.
 866  DED0              ;   Algorithm: write A to BDOS_RETVAL; the handler then RETs through the pushed bank-out epilogue
 867  DED0              ;              (BDOS_BANK_OUT_EPILOG). Common tail of the console handlers.
 868  DED0              ;   [RE] The BDOS result sink read back on exit (A=L, B=H). Twin of 44K BDOS_RET_RESULT.
 869  DED0              ; ----------------------------------------------------------------------
 870  DED0              BDOS_RET_RESULT:
 871  DED0 32 13 DF             LD (BDOS_RETVAL),A
 872  DED3              ; ----------------------------------------------------------------------
 873  DED3              ; BDOS_RET_NOP -- bare RET; the dispatch-table target for the no-op functions 38 and 39.
 874  DED3              ;   In/Out: none.  Clobbers: none.
 875  DED3              ;   [RE] SoftCard extension slots 38/39 do nothing (matches the 44K $9F04 RET). The following
 876  DED3              ;        DEFB $3E,$01,$18,$F8 is the unlabeled 'A:=1; JR BDOS_RET_RESULT' fragment (BDOS_RET_ONE
 877  DED3              ;        in the 44K twin), reached only by fall-through/JR, not by name here.
 878  DED3              ; ----------------------------------------------------------------------
 879  DED3              BDOS_RET_NOP:
 880  DED3 C9                   RET
 881  DED4 3E 01 18 F8          DEFB    $3E,$01,$18,$F8
 882  DED8              ; ----------------------------------------------------------------------
 883  DED8              ; CON_SAVED_COL -- saved cursor column for line-editor redisplay/reposition; also a
 884  DED8              ;   'suppress status-poll/echo' flag inside CON_PUT_COL (nonzero => skip poll+echo).
 885  DED8              ;   [RE] BDOS console state byte; zero when not repositioning. Twin of 44K CON_SAVED_COL
 886  DED8              ;        (60K auto-named CON_CRLF_30).
 887  DED8              ; ----------------------------------------------------------------------
 888  DED8              CON_SAVED_COL:
 889  DED8 00                   DEFB    $00
 890  DED9              ; ----------------------------------------------------------------------
 891  DED9              ; CON_LINE_START_COL -- column at the start of the current input line (echoed-count base).
 892  DED9              ;   [RE] Used by the line editor to know how far back Ctrl-X / DEL may erase. Twin of 44K
 893  DED9              ;        CON_LINE_START_COL.
 894  DED9              ; ----------------------------------------------------------------------
 895  DED9              CON_LINE_START_COL:
 896  DED9 00                   DEFB    $00
 897  DEDA              ; ----------------------------------------------------------------------
 898  DEDA              ; CON_COL -- current console output column counter.
 899  DEDA              ;   [RE] Incremented per printable char, reset by LF; drives tab expansion and editing. Twin of
 900  DEDA              ;        44K CON_COL.
 901  DEDA              ; ----------------------------------------------------------------------
 902  DEDA              CON_COL:
 903  DEDA 00                   DEFB    $00
 904  DEDB              ; ----------------------------------------------------------------------
 905  DEDB              ; CON_LIST_ECHO -- printer (list device) echo flag; nonzero => mirror console output to LIST.
 906  DEDB              ;   [RE] Toggled by the line editor's Ctrl-P (READBUF_CTRL_P). Twin of 44K CON_LIST_ECHO.
 907  DEDB              ; ----------------------------------------------------------------------
 908  DEDB              CON_LIST_ECHO:
 909  DEDB 00                   DEFB    $00
 910  DEDC              ; ----------------------------------------------------------------------
 911  DEDC              ; CON_PENDING_CHAR -- 1-byte console type-ahead / un-get buffer (0 = empty).
 912  DEDC              ;   [RE] Filled by CON_POLL_STATUS, consumed by CON_GETC_OR_RAW. Twin of 44K CON_PENDING_CHAR.
 913  DEDC              ; ----------------------------------------------------------------------
 914  DEDC              CON_PENDING_CHAR:
 915  DEDC 00                   DEFB    $00
 916  DEDD              BDOS_SAVED_SP:
 917  DEDD 00 00 00...          DEFS    50, $00                  ; fill
 918  DF0F              ; ----------------------------------------------------------------------
 919  DF0F              ; BDOS_STACK_TOP -- top of the BDOS private stack (SP loaded here on entry).
 920  DF0F              ;   [RE] BDOS_ENTRY does LD SP,BDOS_STACK_TOP before dispatching; the preceding DEFS reserves the
 921  DF0F              ;        stack slack below it. Twin of 44K BDOS_STACK_TOP (60K auto-named BDOS_STACK).
 922  DF0F              ; ----------------------------------------------------------------------
 923  DF0F              BDOS_STACK_TOP:
 924  DF0F 00                   DEFB    $00
 925  DF10              ; ----------------------------------------------------------------------
 926  DF10              ; BDOS_CUR_DRIVE -- the drive the BDOS is currently operating on (0=A..15=P).
 927  DF10              ;   [RE] Set by the drive-select path and read all over the file system. Twin of the 44K
 928  DF10              ;        BDOS_CUR_DRIVE at $9F42; this is that cell relocated by the upper-bank +$3FCE.
 929  DF10              ; ----------------------------------------------------------------------
 930  DF10              BDOS_CUR_DRIVE:
 931  DF10 00                   DEFB    $00
 932  DF11              ; ----------------------------------------------------------------------
 933  DF11              ; BDOS_PARAM_PTR -- saved DE parameter pointer from the BDOS call (FCB / DMA / buffer). 16-bit.
 934  DF11              ;   [RE] BDOS_ENTRY stashes the incoming DE here; consumers reload it as the operand pointer
 935  DF11              ;        (e.g. the dispatcher and F_READCONBUF_H). Twin of 44K BDOS_PARAM_PTR.
 936  DF11              ; ----------------------------------------------------------------------
 937  DF11              BDOS_PARAM_PTR:
 938  DF11 00 00                DEFB    $00,$00
 939  DF13              ; ----------------------------------------------------------------------
 940  DF13              ; BDOS_RETVAL -- BDOS function return value (16-bit: low byte = A result, high = B).
 941  DF13              ;   [RE] Pre-seeded to 0 on entry; written by BDOS_RET_RESULT; loaded back into HL (A=L, B=H) by
 942  DF13              ;        BDOS_LOAD_RESULT on exit. Twin of 44K BDOS_RETVAL. The bytes after the 2-byte cell begin
 943  DF13              ;        the $DF15 error-vector jump helper (LD HL,$DC0B / LD E,(HL)/INC HL/LD D,(HL)/EX DE,HL/
 944  DF13              ;        bank2 / JP (HL)) that dispatches the BDOS_ERROR reporter addresses at $DC09/$DC0B.
 945  DF13              ; ----------------------------------------------------------------------
 946  DF13              BDOS_RETVAL:
 947  DF13 00 00 21 0B          DEFB    $00,$00,$21,$0B,$DC,$5E,$23,$56,$EB,$32
 947  DF17 DC 5E 23 56
 947  DF1B EB 32
 948  DF1D 83 E0                DEFW    LC_BANK2
 949  DF1F E9 32                DEFB    $E9,$32
 950  DF21 83 E0                DEFW    LC_BANK2
 951  DF23 CD 27 FA 18          DEFB    $CD,$27,$FA,$18,$06,$32
 951  DF27 06 32
 952  DF29 83 E0                DEFW    LC_BANK2
 953  DF2B CD 2A FA B7          DEFB    $CD,$2A,$FA,$B7,$28,$10,$21,$09,$DC,$18,$E2
 953  DF2F 28 10 21 09
 953  DF33 DC 18 E2
 954  DF36              ; ----------------------------------------------------------------------
 955  DF36              ; LC_BANK1_CALL_ISCTRL -- bank the lower LC in and call IS_CTRL_CHAR ($B5C0).
 956  DF36              ;   In: A = character to classify.  Out: per IS_CTRL_CHAR -- carry set if A is a control char the
 957  DF36              ;        line editor must expand (A < ' ' and not CR/LF/TAB/BS); the lower-bank tail restores
 958  DF36              ;        bank2 and returns.  Clobbers: AF, flags.
 959  DF36              ;   Algorithm: LD (LC_BANK1),A selects LC bank1 (Apple $C08B) so the classifier at $B5C0 is
 960  DF36              ;              visible, then JP IS_CTRL_CHAR (IS_CTRL_CHAR); that routine ends with JP LC_BANK2_RET to
 961  DF36              ;              bank2 back in and RET to the upper-bank caller.
 962  DF36              ;   [RE] 60K bank-switch trampoline (no 44K counterpart -- 44K calls IS_CTRL_CHAR directly).
 963  DF36              ; ----------------------------------------------------------------------
 964  DF36              LC_BANK1_CALL_ISCTRL:
 965  DF36 32 8B E0             LD (LC_BANK1),A
 966  DF39 C3 C0 B5             JP IS_CTRL_CHAR
 967  DF3C 32                   DEFB    $32
 968  DF3D 83 E0                DEFW    LC_BANK2
 969  DF3F ED B0 32             DEFB    $ED,$B0,$32
 970  DF42 8B E0                DEFW    LC_BANK1
 971  DF44 C9                   DEFB    $C9
 972  DF45              BDOS_BANK_OUT_EPILOG:
 973  DF45 32                   DEFB    $32
 974  DF46 8B E0                DEFW    LC_BANK1
 975  DF48 3A EB BF B7          DEFB    $3A,$EB,$BF,$B7,$28,$15,$2A
 975  DF4C 28 15 2A
 976  DF4F 11 DF                DEFW    BDOS_PARAM_PTR
 977  DF51 36 00 3A ED          DEFB    $36,$00,$3A,$ED,$BF,$B7,$28,$0A,$77,$3A,$EC,$BF,$32,$E3,$BF,$CD
 977  DF55 BF B7 28 0A
 977  DF59 77 3A EC BF
 977  DF5D 32 E3 BF CD
 978  DF61 47 BE                DEFB    $47,$BE
 979  DF63              BDOS_EXIT_RESTORE:
 980  DF63 32 83 E0             LD (LC_BANK2),A
 981  DF66 3A 87 DF             LD A,(DEFERRED_COPY_FLAG)
 982  DF69 B7                   OR A
 983  DF6A 28 0C                JR Z,BDOS_LOAD_RESULT
 984  DF6C ED 5B 85 DF          LD DE,(DEFERRED_COPY_DST)
 985  DF70 21 88 DF             LD HL,DEFERRED_COPY_BUF
 986  DF73 01 24 00             LD BC,$0024
 987  DF76 ED B0                LDIR
 988  DF78              ; [DOC CPMREF 3-44] BDOS return: load the result word into HL, then set A=L and B=H so callers see
 989  DF78              ;       byte results in A and word results in HL per the standard CP/M return convention.
 990  DF78              ; ----------------------------------------------------------------------
 991  DF78              ; BDOS_LOAD_RESULT -- load the BDOS result and restore the caller's stack on exit.
 992  DF78              ;   In: BDOS_RETVAL = result word; BDOS_SAVED_SP = caller SP.
 993  DF78              ;   Out: HL = result, A = L (byte result), B = H (word high); SP restored; falls into
 994  DF78              ;        LC_BANK2_RET to bank2 back in and RET to the $0005 caller.  Clobbers: AF, BC, HL, SP.
 995  DF78              ;   Algorithm: LD HL,(BDOS_RETVAL); LD A,L; LD B,H; LD SP,(BDOS_SAVED_SP); fall into LC_BANK2_RET.
 996  DF78              ;   [DOC CPMREF 3-44] Standard CP/M return convention (A=L, HL=word). Reached from
 997  DF78              ;        BDOS_EXIT_RESTORE after the optional deferred copy-back. 60K-specific epilogue tail.
 998  DF78              ; ----------------------------------------------------------------------
 999  DF78              BDOS_LOAD_RESULT:
1000  DF78 2A 13 DF             LD HL,(BDOS_RETVAL)
1001  DF7B 7D                   LD A,L                           ; 7D    A = L (byte result)
1002  DF7C 44                   LD B,H                           ; 44    B = H (high half of word result)
1003  DF7D ED 7B DD DE          LD SP,(BDOS_SAVED_SP)            ; restore caller's stack pointer
1004  DF81              LC_BANK2_RET:
1005  DF81 32 83 E0             LD (LC_BANK2),A
1006  DF84 C9                   RET
1007  DF85              ; ----------------------------------------------------------------------
1008  DF85              ; DEFERRED_COPY_DST -- 16-bit destination pointer for the pending exit copy-back. DATA.
1009  DF85              ;   [RE] When DEFERRED_COPY_FLAG is set, BDOS_EXIT_RESTORE LDIRs $24 (36) bytes from
1010  DF85              ;        DEFERRED_COPY_BUF to the address held here, then clears the flag. Believed to be the
1011  DF85              ;        saved search-FCB write-back target the manual notes for Search-First/Next. [?] exact
1012  DF85              ;        producer UNKNOWN (set by a lower-bank $Bxxx handler). 60K-specific cell.
1013  DF85              ; ----------------------------------------------------------------------
1014  DF85              DEFERRED_COPY_DST:
1015  DF85 00 00                DEFB    $00,$00
1016  DF87              ; ----------------------------------------------------------------------
1017  DF87              ; DEFERRED_COPY_FLAG -- 1-byte 'copy-back pending' flag for the BDOS exit path. DATA.
1018  DF87              ;   [RE] Cleared on entry (BDOS_ENTRY, $DC30); if nonzero at exit, BDOS_EXIT_RESTORE performs the
1019  DF87              ;        deferred 36-byte LDIR (DEFERRED_COPY_BUF -> DEFERRED_COPY_DST). Set by a lower-bank
1020  DF87              ;        handler. 60K-specific cell. [?] exact producer UNKNOWN.
1021  DF87              ; ----------------------------------------------------------------------
1022  DF87              DEFERRED_COPY_FLAG:
1023  DF87 00                   DEFB    $00
1024  DF88              ; ----------------------------------------------------------------------
1025  DF88              ; DEFERRED_COPY_BUF -- 36-byte staging buffer (LDIR source) for the deferred exit copy-back. DATA.
1026  DF88              ;   [RE] BDOS_EXIT_RESTORE copies these $24 bytes to DEFERRED_COPY_DST when DEFERRED_COPY_FLAG is
1027  DF88              ;        set. Sized 36 = a 32-byte directory FCB image plus a few control bytes. The 6502 bytes
1028  DF88              ;        that follow at $DFAC-$DFEB are an out-of-band payload past this cell, not part of it.
1029  DF88              ;        60K-specific buffer. [?] exact contents/producer UNKNOWN.
1030  DF88              ; ----------------------------------------------------------------------
1031  DF88              DEFERRED_COPY_BUF:
1032  DF88 00 00 00...          DEFS    36, $00                  ; fill
1033  DFAC 8D 83 C0 A2          DEFB    $8D,$83,$C0,$A2,$AC,$2C,$A2,$AA,$88,$B1,$3E,$4A,$3E,$56,$0B,$4A
1033  DFB0 AC 2C A2 AA
1033  DFB4 88 B1 3E 4A
1033  DFB8 3E 56 0B 4A
1034  DFBC 3E 56 0B 99          DEFB    $3E,$56,$0B,$99,$00,$09,$E8,$D0,$EF,$98,$D0,$EA,$4C,$E5,$FF,$8D
1034  DFC0 00 09 E8 D0
1034  DFC4 EF 98 D0 EA
1034  DFC8 4C E5 FF 8D
1035  DFCC 83 C0 A0 00          DEFB    $83,$C0,$A0,$00,$A2,$56,$CA,$30,$FB,$B9,$00,$09,$5E,$00,$0C,$2A
1035  DFD0 A2 56 CA 30
1035  DFD4 FB B9 00 09
1035  DFD8 5E 00 0C 2A
1036  DFDC 5E 00 0C 2A          DEFB    $5E,$00,$0C,$2A,$91,$3E,$C8,$D0,$ED,$8D,$8B,$C0,$60,$00,$00,$00
1036  DFE0 91 3E C8 D0
1036  DFE4 ED 8D 8B C0
1036  DFE8 60 00 00 00
1037  DFEC 00 00 00...          DEFS    20, $00                  ; fill
1038  E000              ; ===========================================================================
1039  E000              ; LOWER LC BANK -- the FCB/file/directory/disk machinery (run $B5C0-$BFBF).
1040  E000              ; Stored contiguously in the BDOS image at $E000-$E9FF but RUN in the Language
1041  E000              ; Card low mirror (Apple $D5C0-$DFFF, bank 1): the cold-boot relocator copies
1042  E000              ; these pages down there, so the CPU executes them at $B5C0-$BFBF (= storage
1043  E000              ; -$2A40). DISP makes every in-image label resolve to its true $Bxxx run address
1044  E000              ; while the bytes are emitted at their $E0xx image position. The dispatcher at
1045  E000              ; $DC11 banks this half in (LC_BANK1) before an indexed JP (HL) reaches a handler
1046  E000              ; here; the $BFC0-$BFFF scratch these routines use is live RAM, past the image.
1047  E000              ; sjasmplus can't nest DISP, so close the upper-bank $DC00 DISP first (linked
1048  E000              ; build only; the standalone build reached here under a plain ORG $DC00).
1049  E000              ; ===========================================================================
1050  E000                  IFDEF CPM60_LINK
1051  E000 ~                ENT                ; close the upper-bank DISP $DC00 (linked build)
1052  E000                  ENDIF
1053  E000                  DISP $B5C0
1054  B5C0              ; ----------------------------------------------------------------------
1055  B5C0              ; IS_CTRL_CHAR -- classify A as a printable/control character for the console echo path.
1056  B5C0              ;   In: A = character to test.
1057  B5C0              ;   Out: carry set when A is a control character that the line editor must expand (below space and
1058  B5C0              ;        not one of CR/LF/TAB/BS); carry clear for CR/LF/TAB/BS and for printable chars (>= space).
1059  B5C0              ;   Clobbers: A,flags (the tail-JP LC_BANK2_RET = upper-bank LC_BANK2_RET banks bank2 back in and returns).
1060  B5C0              ;   Algorithm: compare A against CR($0D)/LF($0A)/TAB($09)/BS($08) (each a non-control 'pass'), then
1061  B5C0              ;       CP $20; JP LC_BANK2_RET leaves carry = (A < $20) for the remaining control chars. Lives in the lower
1062  B5C0              ;       LC bank; the upper-bank echo caller reaches it via LC_BANK1_CALL_ISCTRL ($DF36).
1063  B5C0              ;   [RE] control-char discriminator for CON_PUT_VISIBLE (^X caret display). [?]
1064  B5C0              ; ----------------------------------------------------------------------
1065  B5C0              IS_CTRL_CHAR:
1066  B5C0 FE 0D                CP $0D
1067  B5C2 28 0E                JR Z,IS_CTRL_CHAR_TAIL
1068  B5C4 FE 0A                CP $0A
1069  B5C6 28 0A                JR Z,IS_CTRL_CHAR_TAIL
1070  B5C8 FE 09                CP $09
1071  B5CA 28 06                JR Z,IS_CTRL_CHAR_TAIL
1072  B5CC FE 08                CP $08
1073  B5CE 28 02                JR Z,IS_CTRL_CHAR_TAIL
1074  B5D0 FE 20                CP $20
1075  B5D2              IS_CTRL_CHAR_TAIL:
1076  B5D2 C3 81 DF             JP LC_BANK2_RET
1077  B5D5              ; ----------------------------------------------------------------------
1078  B5D5              ; CON_TRACK_COL -- update the console column counter (CON_COL=$DEDA) for one output char.
1079  B5D5              ;   In: C = character being emitted.
1080  B5D5              ;   Out: the column cell $DEDA advanced for a printable char, decremented for a backspace, and left
1081  B5D5              ;        unchanged for rubout ($7F) or when already at column 0.  Clobbers: A,HL,flags.
1082  B5D5              ;   Algorithm: HL := $DEDA (upper-bank CON_COL); RET on rubout; INC the column, but if the char is
1083  B5D5              ;       a control code (< space) undo it, and for BS ($08) tail to $DD64 (the upper-bank column-fix
1084  B5D5              ;       stub) to also DEC. Runs in the lower LC bank; called from LC_BANK1_CALL_TRACKCOL via CALL CON_TRACK_COL.
1085  B5D5              ;   [RE] column tracker feeding TAB expansion and line-edit backspace. [?]
1086  B5D5              ; ----------------------------------------------------------------------
1087  B5D5              CON_TRACK_COL:
1088  B5D5 79                   LD A,C
1089  B5D6 21 DA DE             LD HL,CON_COL
1090  B5D9 FE 7F                CP $7F
1091  B5DB C8                   RET Z
1092  B5DC 34                   INC (HL)
1093  B5DD FE 20                CP $20
1094  B5DF D0                   RET NC
1095  B5E0 35                   DEC (HL)
1096  B5E1 7E                   LD A,(HL)
1097  B5E2 B7                   OR A
1098  B5E3 C8                   RET Z
1099  B5E4 79                   LD A,C
1100  B5E5 FE 08                CP $08
1101  B5E7 C2 64 DD             JP NZ,$DD64
1102  B5EA 35                   DEC (HL)
1103  B5EB C9                   RET
1104  B5EC              ; ----------------------------------------------------------------------
1105  B5EC              ; SELDSK_DPB_FETCH -- SELDSK the current drive and cache its Disk Parameter Block fields locally.
1106  B5EC              ;   In: current drive at $DF10 (BDOS upper-bank current-drive cell).
1107  B5EC              ;   Out: Z (A=0) if the BIOS returned a null DPH (drive not present); else A=$FF and the DPB fields
1108  B5EC              ;        are unpacked into the $BFxx work cells (translate ptr $BFC0, block-shift/mask/EXM into
1109  B5EC              ;        $BFC2..$BFC6, the DPB word block $BFC6.. copied from the DPB, ALLOC-vec ptr region, etc.).
1110  B5EC              ;   Clobbers: A,BC,DE,HL,flags.
1111  B5EC              ;   Algorithm: A := (current drive $DF10); C := A; CALL BIOS SELDSK ($FA1B) -> HL = DPH; return Z if
1112  B5EC              ;       HL is 0; walk the DPH to the DPB, stash the XLT/DPB pointers into the $BFC0-$BFC6 work cells,
1113  B5EC              ;       LDIR the 8-byte DPB header and the 15-byte second block into $BFC6/$BFCE, set the block-width
1114  B5EC              ;       flag $BFEA from DSM's high byte, and return A=$FF.
1115  B5EC              ;   [RE] 60K equivalent of the 44K SELDSK/DPB-unpack; the DPB scratch lives in the LC low page ($BFxx
1116  B5EC              ;        here, vs the 44K $A9xx). [?] exact cell roles cross-checked against the 44K twin.
1117  B5EC              ; ----------------------------------------------------------------------
1118  B5EC              SELDSK_DPB_FETCH:
1119  B5EC 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
1120  B5EF 4F                   LD C,A
1121  B5F0 CD 1B FA             CALL SELDSK
1122  B5F3 7C                   LD A,H
1123  B5F4 B5                   OR L
1124  B5F5 C8                   RET Z
1125  B5F6 5E                   LD E,(HL)
1126  B5F7 23                   INC HL
1127  B5F8 56                   LD D,(HL)
1128  B5F9 23                   INC HL
1129  B5FA 22 C0 BF             LD (DPB_WORK_PTR0),HL
1130  B5FD 23                   INC HL
1131  B5FE 23                   INC HL
1132  B5FF 22 C2 BF             LD (DEBLOCK_HSTREC_PTR0),HL
1133  B602 23                   INC HL
1134  B603 23                   INC HL
1135  B604 22 C4 BF             LD (DEBLOCK_HSTREC_PTR1),HL
1136  B607 23                   INC HL
1137  B608 23                   INC HL
1138  B609 ED 53 DD BF          LD (DPB_XLT_PTR),DE
1139  B60D 11 C6 BF             LD DE,DIRBUF_PTR
1140  B610 01 08 00             LD BC,$0008
1141  B613 ED B0                LDIR
1142  B615 2A C8 BF             LD HL,(DPB_PTR)
1143  B618 11 CE BF             LD DE,DPB_SPT
1144  B61B 01 0F 00             LD BC,$000F
1145  B61E ED B0                LDIR
1146  B620 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
1147  B623 7C                   LD A,H
1148  B624 21 EA BF             LD HL,BLOCK_WIDTH_FLAG
1149  B627 36 FF                LD (HL),$FF
1150  B629 B7                   OR A
1151  B62A 28 02                JR Z,SELDSK_DPB_FETCH_1
1152  B62C 36 00                LD (HL),$00
1153  B62E              SELDSK_DPB_FETCH_1:
1154  B62E 3E FF                LD A,$FF
1155  B630 B7                   OR A
1156  B631 C9                   RET
1157  B632              ; ----------------------------------------------------------------------
1158  B632              ; DISK_HOME_CLEAR_SCAN -- HOME the drive and reset the directory-scan record/position work cells.
1159  B632              ;   In: DPB scratch pointers at $BFC2 (record-count work word ptr) and $BFC4 (scan-position word ptr).
1160  B632              ;   Out: the BIOS head is homed and the two 16-bit work cells addressed by (DEBLOCK_HSTREC_PTR0) and (DEBLOCK_HSTREC_PTR1) are
1161  B632              ;        zeroed, restarting a directory sweep from record 0.  Clobbers: A,HL,flags.
1162  B632              ;   Algorithm: CALL BIOS HOME ($FA18); A := 0; zero the word at (DEBLOCK_HSTREC_PTR0) and the word at (DEBLOCK_HSTREC_PTR1).
1163  B632              ;   [RE] scan-reset run at the start of ALLOC_VECTOR_BUILD and each DIR_SEARCH_FIRST. [?]
1164  B632              ; ----------------------------------------------------------------------
1165  B632              DISK_HOME_CLEAR_SCAN:
1166  B632 CD 18 FA             CALL HOME
1167  B635 AF                   XOR A
1168  B636 2A C2 BF             LD HL,(DEBLOCK_HSTREC_PTR0)
1169  B639 77                   LD (HL),A
1170  B63A 23                   INC HL
1171  B63B 77                   LD (HL),A
1172  B63C 2A C4 BF             LD HL,(DEBLOCK_HSTREC_PTR1)
1173  B63F 77                   LD (HL),A
1174  B640 23                   INC HL
1175  B641 77                   LD (HL),A
1176  B642 C9                   RET
1177  B643              ; ----------------------------------------------------------------------
1178  B643              ; REC_DIV4_SETUP -- derive the 128-byte disk record (CUR_RECORD >> 2) that holds the current dir entry.
1179  B643              ;   In: CUR_RECORD = 16-bit current directory-entry index at $BFF7.
1180  B643              ;   Out: the record number CUR_RECORD/4 stored into the two deblock work words $BFF2 and $BFF9.
1181  B643              ;   Clobbers: A,BC,HL,flags.
1182  B643              ;   Algorithm: HL := (CUR_RECORD $BFF7); C := 2; SHR_HL_C (>>2 = four 32-byte entries per 128-byte
1183  B643              ;       record); store HL to $BFF2 and $BFF9; fall into RECORD_TO_TRACK.
1184  B643              ;   [RE] CP/M packs four 32-byte directory entries per 128-byte record; this picks the record. [?]
1185  B643              ; ----------------------------------------------------------------------
1186  B643              REC_DIV4_SETUP:
1187  B643 2A F7 BF             LD HL,(CUR_RECORD)
1188  B646 0E 02                LD C,$02
1189  B648 CD 5F B7             CALL SHR_HL_C
1190  B64B 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
1191  B64E 22 F9 BF             LD (REC_CACHE),HL
1192  B651              ; ----------------------------------------------------------------------
1193  B651              ; RECORD_TO_TRACK -- translate the target logical record into a physical track/sector and program the BIOS.
1194  B651              ;   In: the record word at $BFF2; DPB fields cached in the $BFxx work cells (sectors-per-track word
1195  B651              ;       (DPB_SPT), track-offset (DPB_XLT_PTR), skew-table (DPB_OFF)).
1196  B651              ;   Out: BIOS SETTRK/SETSEC set for the record via the BIOS SECTRAN/step vectors; track/sector work
1197  B651              ;        cells ($BFC2/$BFC4) updated.  Clobbers: A,BC,DE,HL,flags.
1198  B651              ;   Algorithm: subtract whole tracks (sectors-per-track) from the record to get track# and
1199  B651              ;       sector-within-track, add the DPB track offset, program the BIOS via the $FAxx SET* vectors,
1200  B651              ;       and SECTRAN the sector through the skew table (DPB_OFF) before SETSEC.
1201  B651              ;   [RE] the 60K record->track/sector deblock; DPB geometry read from the LC low-page work cells.
1202  B651              ;        [?] cross-checked against the 44K RECORD_TO_TRACK twin.
1203  B651              ; ----------------------------------------------------------------------
1204  B651              RECORD_TO_TRACK:
1205  B651 21 F2 BF             LD HL,CUR_BLOCK_NUMBER
1206  B654 4E                   LD C,(HL)
1207  B655 23                   INC HL
1208  B656 46                   LD B,(HL)
1209  B657 2A C4 BF             LD HL,(DEBLOCK_HSTREC_PTR1)
1210  B65A 5E                   LD E,(HL)
1211  B65B 23                   INC HL
1212  B65C 56                   LD D,(HL)
1213  B65D 2A C2 BF             LD HL,(DEBLOCK_HSTREC_PTR0)
1214  B660 7E                   LD A,(HL)
1215  B661 23                   INC HL
1216  B662 66                   LD H,(HL)
1217  B663 6F                   LD L,A
1218  B664              RECORD_TO_TRACK_1:
1219  B664 79                   LD A,C
1220  B665 93                   SUB E
1221  B666 78                   LD A,B
1222  B667 9A                   SBC A,D
1223  B668 30 0E                JR NC,RECORD_TO_TRACK_2
1224  B66A E5                   PUSH HL
1225  B66B 2A CE BF             LD HL,(DPB_SPT)
1226  B66E 7B                   LD A,E
1227  B66F 95                   SUB L
1228  B670 5F                   LD E,A
1229  B671 7A                   LD A,D
1230  B672 9C                   SBC A,H
1231  B673 57                   LD D,A
1232  B674 E1                   POP HL
1233  B675 2B                   DEC HL
1234  B676 18 EC                JR RECORD_TO_TRACK_1
1235  B678              RECORD_TO_TRACK_2:
1236  B678 E5                   PUSH HL
1237  B679 2A CE BF             LD HL,(DPB_SPT)
1238  B67C 19                   ADD HL,DE
1239  B67D 38 0B                JR C,RECORD_TO_TRACK_3
1240  B67F 79                   LD A,C
1241  B680 95                   SUB L
1242  B681 78                   LD A,B
1243  B682 9C                   SBC A,H
1244  B683 38 05                JR C,RECORD_TO_TRACK_3
1245  B685 EB                   EX DE,HL
1246  B686 E1                   POP HL
1247  B687 23                   INC HL
1248  B688 18 EE                JR RECORD_TO_TRACK_2
1249  B68A              RECORD_TO_TRACK_3:
1250  B68A E1                   POP HL
1251  B68B C5                   PUSH BC
1252  B68C D5                   PUSH DE
1253  B68D E5                   PUSH HL
1254  B68E EB                   EX DE,HL
1255  B68F 2A DB BF             LD HL,(DPB_OFF)
1256  B692 19                   ADD HL,DE
1257  B693 44                   LD B,H
1258  B694 4D                   LD C,L
1259  B695 CD 1E FA             CALL SETTRK
1260  B698 D1                   POP DE
1261  B699 2A C2 BF             LD HL,(DEBLOCK_HSTREC_PTR0)
1262  B69C 73                   LD (HL),E
1263  B69D 23                   INC HL
1264  B69E 72                   LD (HL),D
1265  B69F D1                   POP DE
1266  B6A0 2A C4 BF             LD HL,(DEBLOCK_HSTREC_PTR1)
1267  B6A3 73                   LD (HL),E
1268  B6A4 23                   INC HL
1269  B6A5 72                   LD (HL),D
1270  B6A6 C1                   POP BC
1271  B6A7 79                   LD A,C
1272  B6A8 93                   SUB E
1273  B6A9 4F                   LD C,A
1274  B6AA 78                   LD A,B
1275  B6AB 9A                   SBC A,D
1276  B6AC 47                   LD B,A
1277  B6AD 2A DD BF             LD HL,(DPB_XLT_PTR)
1278  B6B0 EB                   EX DE,HL
1279  B6B1 CD 30 FA             CALL SECTRAN
1280  B6B4 4D                   LD C,L
1281  B6B5 44                   LD B,H
1282  B6B6 C3 21 FA             JP SETSEC
1283  B6B9              ; ----------------------------------------------------------------------
1284  B6B9              ; REC_BLOCK_SHIFT_6 -- combine the FCB extent's low block-map bits with the record-in-block bits.
1285  B6B9              ;   In: DPB block-shift BSH at $BFD0; the record-low and extent-low work bytes at $BFF0 / $BFEF.
1286  B6B9              ;   Out: A = the composite index used by FCB_BLOCKMAP_INDEX_10 to pick the block-map slot.
1287  B6B9              ;   Clobbers: A,B,C,flags.
1288  B6B9              ;   Algorithm: shift the record byte (FCB_CURREC) right (8 - BSH) times, shift the extent byte (FCB_EXTENT_MASKED)
1289  B6B9              ;       left BSH times, and add them to form the block-map slot index.
1290  B6B9              ;   [RE] 60K deblock helper computing the FCB allocation-map slot from record + extent. [?]
1291  B6B9              ; ----------------------------------------------------------------------
1292  B6B9              REC_BLOCK_SHIFT_6:
1293  B6B9 21 D0 BF             LD HL,DPB_BSH
1294  B6BC 4E                   LD C,(HL)
1295  B6BD 3A F0 BF             LD A,(FCB_CURREC)
1296  B6C0              REC_BLOCK_SHIFT_6_1:
1297  B6C0 B7                   OR A
1298  B6C1 1F                   RRA
1299  B6C2 0D                   DEC C
1300  B6C3 20 FB                JR NZ,REC_BLOCK_SHIFT_6_1
1301  B6C5 47                   LD B,A
1302  B6C6 3E 08                LD A,$08
1303  B6C8 96                   SUB (HL)
1304  B6C9 4F                   LD C,A
1305  B6CA 3A EF BF             LD A,(FCB_EXTENT_MASKED)
1306  B6CD              REC_BLOCK_SHIFT_6_2:
1307  B6CD 0D                   DEC C
1308  B6CE 28 04                JR Z,REC_BLOCK_SHIFT_6_3
1309  B6D0 B7                   OR A
1310  B6D1 17                   RLA
1311  B6D2 18 F9                JR REC_BLOCK_SHIFT_6_2
1312  B6D4              REC_BLOCK_SHIFT_6_3:
1313  B6D4 80                   ADD A,B
1314  B6D5 C9                   RET
1315  B6D6              ; ----------------------------------------------------------------------
1316  B6D6              ; FCB_BLOCKMAP_INDEX_10 -- fetch the disk block number from the FCB allocation map at slot BC.
1317  B6D6              ;   In: BC = slot index; current FCB pointer at $DF11 (upper-bank CURFCB cell); block-width flag $BFEA.
1318  B6D6              ;   Out: HL = the block (group) number stored at FCB+$10+slot (8-bit map) or the 16-bit word there
1319  B6D6              ;        (16-bit map, when $BFEA=0).  Clobbers: A,DE,HL,flags.
1320  B6D6              ;   Algorithm: HL := (CURFCB $DF11) + $10 + BC; if $BFEA (narrow) nonzero read one byte (H:=0), else
1321  B6D6              ;       add BC again and read the 16-bit word.
1322  B6D6              ;   [RE] reads an FCB block-map entry; $BFEA selects 8-bit vs 16-bit block numbers. [DOC CP/M 2.2 FCB]
1323  B6D6              ; ----------------------------------------------------------------------
1324  B6D6              FCB_BLOCKMAP_INDEX_10:
1325  B6D6 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1326  B6D9 11 10 00             LD DE,$0010
1327  B6DC 19                   ADD HL,DE
1328  B6DD 09                   ADD HL,BC
1329  B6DE 3A EA BF             LD A,(BLOCK_WIDTH_FLAG)
1330  B6E1 B7                   OR A
1331  B6E2 28 04                JR Z,FCB_BLOCKMAP_INDEX_10_1
1332  B6E4 6E                   LD L,(HL)
1333  B6E5 26 00                LD H,$00
1334  B6E7 C9                   RET
1335  B6E8              FCB_BLOCKMAP_INDEX_10_1:
1336  B6E8 09                   ADD HL,BC
1337  B6E9 5E                   LD E,(HL)
1338  B6EA 23                   INC HL
1339  B6EB 56                   LD D,(HL)
1340  B6EC EB                   EX DE,HL
1341  B6ED C9                   RET
1342  B6EE              ; ----------------------------------------------------------------------
1343  B6EE              ; REC_TO_BLOCK_14 -- map the current record to its disk block number via the FCB allocation map.
1344  B6EE              ;   In: the record/extent work bytes ($BFF0/$BFEF) and current FCB (BDOS_PARAM_PTR).
1345  B6EE              ;   Out: the block number for this record stored into the block work word $BFF2 (0 = unallocated).
1346  B6EE              ;   Clobbers: A,BC,HL,flags.
1347  B6EE              ;   Algorithm: REC_BLOCK_SHIFT_6 forms the block-map slot in A; C:=A,B:=0; FCB_BLOCKMAP_INDEX_10
1348  B6EE              ;       reads that slot's block number; store to $BFF2.
1349  B6EE              ;   [RE] 60K record->block lookup; feeds BLOCK_IS_ZERO_16 / BLOCK_BASE_RECORD_17. [?]
1350  B6EE              ; ----------------------------------------------------------------------
1351  B6EE              REC_TO_BLOCK_14:
1352  B6EE CD B9 B6             CALL REC_BLOCK_SHIFT_6
1353  B6F1 4F                   LD C,A
1354  B6F2 06 00                LD B,$00
1355  B6F4 CD D6 B6             CALL FCB_BLOCKMAP_INDEX_10
1356  B6F7 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
1357  B6FA C9                   RET
1358  B6FB              ; ----------------------------------------------------------------------
1359  B6FB              ; BLOCK_IS_ZERO_16 -- test whether the current record's block (CUR_BLOCK_NUMBER) is unallocated.
1360  B6FB              ;   In: block work word at $BFF2.
1361  B6FB              ;   Out: A = L, Z set when the 16-bit block number is 0 (no block yet allocated for this record).
1362  B6FB              ;   Clobbers: A,HL,flags.
1363  B6FB              ;   Algorithm: HL := (CUR_BLOCK_NUMBER); A := L OR H; RET (Z <=> block==0).
1364  B6FB              ;   [RE] the read/write core branches on Z here to decide allocate-vs-use. [?]
1365  B6FB              ; ----------------------------------------------------------------------
1366  B6FB              BLOCK_IS_ZERO_16:
1367  B6FB 2A F2 BF             LD HL,(CUR_BLOCK_NUMBER)
1368  B6FE 7D                   LD A,L
1369  B6FF B4                   OR H
1370  B700 C9                   RET
1371  B701              ; ----------------------------------------------------------------------
1372  B701              ; BLOCK_BASE_RECORD_17 -- compute the absolute base record of the current block plus the in-block record.
1373  B701              ;   In: DPB block-shift BSH at $BFD0, block-mask BLM at $BFD1; block number at $BFF2; record-low $BFF0.
1374  B701              ;   Out: $BFF4 = block# << BSH (the block's first record); $BFF2 = that base OR (record & BLM) = the
1375  B701              ;        exact physical record.  Clobbers: A,C,HL,flags.
1376  B701              ;   Algorithm: HL := block (CUR_BLOCK_NUMBER); ADD HL,HL BSH times to get the base record (stored $BFF4); then OR
1377  B701              ;       in (record-low $BFF0 AND BLM $BFD1) and store the physical record back to $BFF2.
1378  B701              ;   [RE] block-number -> physical-record fold used before RECORD_TO_TRACK. [?]
1379  B701              ; ----------------------------------------------------------------------
1380  B701              BLOCK_BASE_RECORD_17:
1381  B701 3A D0 BF             LD A,(DPB_BSH)
1382  B704 2A F2 BF             LD HL,(CUR_BLOCK_NUMBER)
1383  B707              BLOCK_BASE_RECORD_17_1:
1384  B707 29                   ADD HL,HL
1385  B708 3D                   DEC A
1386  B709 20 FC                JR NZ,BLOCK_BASE_RECORD_17_1
1387  B70B 22 F4 BF             LD (BLOCK_BASE_RECORD),HL
1388  B70E 3A D1 BF             LD A,(DPB_BLM)
1389  B711 4F                   LD C,A
1390  B712 3A F0 BF             LD A,(FCB_CURREC)
1391  B715 A1                   AND C
1392  B716 B5                   OR L
1393  B717 6F                   LD L,A
1394  B718 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
1395  B71B C9                   RET
1396  B71C              ; ----------------------------------------------------------------------
1397  B71C              ; FCB_PTR_EXTENT -- point HL at the FCB's extent byte (FCB+$0C, the EX field).
1398  B71C              ;   In: current FCB pointer at $DF11 (upper-bank CURFCB cell).
1399  B71C              ;   Out: HL = CURFCB + $0C (the extent-number byte).  Clobbers: DE,HL.
1400  B71C              ;   Algorithm: HL := (BDOS_PARAM_PTR) + $000C.
1401  B71C              ;   [RE] FCB byte 12 = EX (extent number) per CP/M 2.2 FCB layout. [DOC CP/M 2.2 FCB]
1402  B71C              ; ----------------------------------------------------------------------
1403  B71C              FCB_PTR_EXTENT:
1404  B71C 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1405  B71F 11 0C 00             LD DE,$000C
1406  B722 19                   ADD HL,DE
1407  B723 C9                   RET
1408  B724              ; ----------------------------------------------------------------------
1409  B724              ; FCB_PTR_RC_CR -- point DE at the FCB record-count byte (FCB+$0F) and HL at the current-record byte (FCB+$20).
1410  B724              ;   In: current FCB pointer at $DF11.
1411  B724              ;   Out: DE = CURFCB + $0F (RC, record count in the extent); HL = CURFCB + $20 (CR, current record).
1412  B724              ;   Clobbers: DE,HL.
1413  B724              ;   Algorithm: DE := (BDOS_PARAM_PTR) + $0F; HL := DE + $11 (= FCB + $20).
1414  B724              ;   [RE] FCB byte 15 = RC, byte 32 = CR per CP/M 2.2 FCB layout. [DOC CP/M 2.2 FCB]
1415  B724              ; ----------------------------------------------------------------------
1416  B724              FCB_PTR_RC_CR:
1417  B724 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1418  B727 11 0F 00             LD DE,$000F
1419  B72A 19                   ADD HL,DE
1420  B72B EB                   EX DE,HL
1421  B72C 21 11 00             LD HL,$0011
1422  B72F 19                   ADD HL,DE
1423  B730 C9                   RET
1424  B731              ; ----------------------------------------------------------------------
1425  B731              ; FCB_PRIME_FIELDS -- load the current FCB's CR / RC / EX fields into the $BFxx deblock work bytes.
1426  B731              ;   In: current FCB (BDOS_PARAM_PTR); DPB EXM mask at $BFD2.
1427  B731              ;   Out: $BFF0 = CR (current record, FCB+$20); $BFEE = RC (record count, FCB+$0F); $BFEF = EX (extent,
1428  B731              ;        FCB+$0C) masked with EXM.  Clobbers: A,DE,HL.
1429  B731              ;   Algorithm: FCB_PTR_RC_CR gets the RC/CR pointers; copy CR->$BFF0 and RC->$BFEE; FCB_PTR_EXTENT
1430  B731              ;       gets &EX; store (EX AND EXM $BFD2) -> $BFEF.
1431  B731              ;   [RE] primes the working record/extent bytes the read/write core operates on. [?]
1432  B731              ; ----------------------------------------------------------------------
1433  B731              FCB_PRIME_FIELDS:
1434  B731 CD 24 B7             CALL FCB_PTR_RC_CR
1435  B734 7E                   LD A,(HL)
1436  B735 32 F0 BF             LD (FCB_CURREC),A
1437  B738 EB                   EX DE,HL
1438  B739 7E                   LD A,(HL)
1439  B73A 32 EE BF             LD (FCB_RECCOUNT),A
1440  B73D CD 1C B7             CALL FCB_PTR_EXTENT
1441  B740 3A D2 BF             LD A,(DPB_EXM)
1442  B743 A6                   AND (HL)
1443  B744 32 EF BF             LD (FCB_EXTENT_MASKED),A
1444  B747 C9                   RET
1445  B748              ; ----------------------------------------------------------------------
1446  B748              ; FCB_WRITEBACK_REC -- write the working record/record-count bytes back into the current FCB.
1447  B748              ;   In: working CR byte $BFF0, working RC byte $BFEE; write-type flag WRITE_TYPE=$BFE2.
1448  B748              ;   Out: FCB CR (FCB+$20) := $BFF0 (+1 unless WRITE_TYPE=2 zero-fill); FCB RC (FCB+$0F) := $BFEE.
1449  B748              ;   Clobbers: A,C,DE,HL.
1450  B748              ;   Algorithm: FCB_PTR_RC_CR gets the pointers; C := 1 unless WRITE_TYPE (WRITE_TYPE_FLAG)==2 (then 0); store
1451  B748              ;       (CR $BFF0 + C) to the FCB CR byte and RC $BFEE to the FCB RC byte.
1452  B748              ;   [RE] post-I/O FCB position commit; WRITE_TYPE=2 (WRITEZF) does not advance CR. [?]
1453  B748              ; ----------------------------------------------------------------------
1454  B748              FCB_WRITEBACK_REC:
1455  B748 CD 24 B7             CALL FCB_PTR_RC_CR
1456  B74B 3A E2 BF             LD A,(WRITE_TYPE_FLAG)
1457  B74E FE 02                CP $02
1458  B750 20 01                JR NZ,FCB_WRITEBACK_REC_1
1459  B752 AF                   XOR A
1460  B753              FCB_WRITEBACK_REC_1:
1461  B753 4F                   LD C,A
1462  B754 3A F0 BF             LD A,(FCB_CURREC)
1463  B757 81                   ADD A,C
1464  B758 77                   LD (HL),A
1465  B759 EB                   EX DE,HL
1466  B75A 3A EE BF             LD A,(FCB_RECCOUNT)
1467  B75D 77                   LD (HL),A
1468  B75E C9                   RET
1469  B75F              ; ----------------------------------------------------------------------
1470  B75F              ; SHR_HL_C -- logical-shift HL right by C bit positions.
1471  B75F              ;   In: HL = value; C = shift count (0 leaves HL unchanged).
1472  B75F              ;   Out: HL >>= C.  Clobbers: C,HL (C decremented to 0).
1473  B75F              ;   Algorithm: INC C / loop { DEC C; ret if zero; SRL H; RR L }.
1474  B75F              ;   [RE] generic unsigned right-shift helper (record/4, drive-bit extraction). Mirror of SHL_HL_C.
1475  B75F              ; ----------------------------------------------------------------------
1476  B75F              SHR_HL_C:
1477  B75F 0C                   INC C
1478  B760              SHR_HL_C_1:
1479  B760 0D                   DEC C
1480  B761 C8                   RET Z
1481  B762 CB 3C                SRL H
1482  B764 CB 1D                RR L
1483  B766 18 F8                JR SHR_HL_C_1
1484  B768              ; ----------------------------------------------------------------------
1485  B768              ; DIR_CHECKSUM -- compute the 128-byte additive checksum of the directory buffer.
1486  B768              ;   In: the directory buffer pointer at $BFC6 (DIRBUF ptr).
1487  B768              ;   Out: A = 8-bit sum of the 128 bytes.  Clobbers: A,C,HL.
1488  B768              ;   Algorithm: C=$80 count, HL=(DIRBUF ptr $BFC6), A=0; loop ADD A,(HL)/INC HL/DEC C until C==0.
1489  B768              ;   [RE] canonical CP/M directory-checksum routine (detects media swap). [DOC CP/M 2.2 ALG]
1490  B768              ; ----------------------------------------------------------------------
1491  B768              DIR_CHECKSUM:
1492  B768 0E 80                LD C,$80
1493  B76A 2A C6 BF             LD HL,(DIRBUF_PTR)
1494  B76D AF                   XOR A
1495  B76E              DIR_CHECKSUM_LOOP:
1496  B76E 86                   ADD A,(HL)
1497  B76F 23                   INC HL
1498  B770 0D                   DEC C
1499  B771 20 FB                JR NZ,DIR_CHECKSUM_LOOP
1500  B773 C9                   RET
1501  B774              ; ----------------------------------------------------------------------
1502  B774              ; SHL_HL_C -- logical-shift HL left by C bit positions.
1503  B774              ;   In: HL = value; C = shift count (0 leaves HL unchanged).
1504  B774              ;   Out: HL <<= C.  Clobbers: C,HL (C decremented to 0).
1505  B774              ;   Algorithm: INC C / loop { DEC C; ret if zero; ADD HL,HL }.
1506  B774              ;   [RE] generic unsigned left-shift helper (e.g. building a 1<<n drive-bit mask).
1507  B774              ; ----------------------------------------------------------------------
1508  B774              SHL_HL_C:
1509  B774 0C                   INC C
1510  B775              SHL_HL_C_LOOP:
1511  B775 0D                   DEC C
1512  B776 C8                   RET Z
1513  B777 29                   ADD HL,HL
1514  B778 18 FB                JR SHL_HL_C_LOOP
1515  B77A              ; ----------------------------------------------------------------------
1516  B77A              ; DRIVE_BIT_OR_INTO_VECTOR -- OR the current drive's single-bit mask into a 16-bit vector.
1517  B77A              ;   In: BC = existing 16-bit vector (preserved); current drive at $DF10.
1518  B77A              ;       (HL on entry is IGNORED; it is overwritten with $0001.)
1519  B77A              ;   Out: HL = BC OR (1 << current_drive).  Clobbers: A,HL (BC saved/restored).
1520  B77A              ;   Algorithm: PUSH BC; C := current drive (BDOS_CUR_DRIVE); HL := 1; SHL_HL_C to form 1<<drive; POP BC;
1521  B77A              ;       L := C OR L, H := B OR H.
1522  B77A              ;   [RE] sets the current drive's bit in whatever vector the caller passes in BC (R/O and login
1523  B77A              ;   setters). [?]
1524  B77A              ; ----------------------------------------------------------------------
1525  B77A              DRIVE_BIT_OR_INTO_VECTOR:
1526  B77A C5                   PUSH BC
1527  B77B 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
1528  B77E 4F                   LD C,A
1529  B77F 21 01 00             LD HL,$0001
1530  B782 CD 74 B7             CALL SHL_HL_C
1531  B785 C1                   POP BC
1532  B786 79                   LD A,C
1533  B787 B5                   OR L
1534  B788 6F                   LD L,A
1535  B789 78                   LD A,B
1536  B78A B4                   OR H
1537  B78B 67                   LD H,A
1538  B78C C9                   RET
1539  B78D              ; ----------------------------------------------------------------------
1540  B78D              ; DRIVE_BIT_TEST -- test whether the current drive's bit is set in the read-only drive vector.
1541  B78D              ;   In: the 16-bit R/O vector at DRV_LOGIN_VECTOR ($BFBA, the read-only vector set by the
1542  B78D              ;       Write-Protect-Disk handler BDOS_F_SETRO); current drive at $DF10.
1543  B78D              ;   Out: A = 1 if the current drive's R/O bit is set, else 0; Z reflects the result.  Clobbers: A,C,HL.
1544  B78D              ;   Algorithm: load the vector (DRV_LOGIN_VECTOR), shift right by the drive number to bring its bit to bit 0, AND $01.
1545  B78D              ;   [RE] CHECK_DRIVE_READONLY raises the R/O error when this bit is set, proving the vector is the
1546  B78D              ;        read-only vector, not the login vector. [?] cell-name kept as DRV_LOGIN_VECTOR per the 44K twin.
1547  B78D              ; ----------------------------------------------------------------------
1548  B78D              DRIVE_BIT_TEST:
1549  B78D 2A BA BF             LD HL,(DRV_LOGIN_VECTOR)
1550  B790 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
1551  B793 4F                   LD C,A
1552  B794 CD 5F B7             CALL SHR_HL_C
1553  B797 7D                   LD A,L
1554  B798 E6 01                AND $01
1555  B79A C9                   RET
1556  B79B              ; ----------------------------------------------------------------------
1557  B79B              ; BDOS_F_SETRO -- BDOS function 28 (Write Protect Disk): set the current drive's R/O bit.
1558  B79B              ;   In: the R/O drive vector at DRV_LOGIN_VECTOR (DRV_LOGIN_VECTOR); current drive at $DF10; the directory
1559  B79B              ;       record-count limit word at (DPB_REC_PTR); a 16-bit working cell addressed by (DPB_WORK_PTR0).
1560  B79B              ;   Out: the R/O vector has the current drive's bit set; the word at (DPB_WORK_PTR0) := (record limit)+1.
1561  B79B              ;   Clobbers: A,BC,DE,HL.
1562  B79B              ;   Algorithm: load the R/O vector (DRV_LOGIN_VECTOR) into BC, set the current-drive bit via
1563  B79B              ;       DRIVE_BIT_OR_INTO_VECTOR, store it back; then store ((word at $BFD5)+1) into the cell at (DPB_WORK_PTR0).
1564  B79B              ;   [RE] this is the fn-28 entry ($DC8B->$B79B) in the dispatch table, confirming Write-Protect-Disk.
1565  B79B              ;        [?] reason for caching the record-limit+1 UNKNOWN.
1566  B79B              ; ----------------------------------------------------------------------
1567  B79B              BDOS_F_SETRO:
1568  B79B 21 BA BF             LD HL,DRV_LOGIN_VECTOR
1569  B79E 4E                   LD C,(HL)
1570  B79F 23                   INC HL
1571  B7A0 46                   LD B,(HL)
1572  B7A1 CD 7A B7             CALL DRIVE_BIT_OR_INTO_VECTOR
1573  B7A4 22 BA BF             LD (DRV_LOGIN_VECTOR),HL
1574  B7A7 2A D5 BF             LD HL,(DPB_REC_PTR)
1575  B7AA 23                   INC HL
1576  B7AB EB                   EX DE,HL
1577  B7AC 2A C0 BF             LD HL,(DPB_WORK_PTR0)
1578  B7AF 73                   LD (HL),E
1579  B7B0 23                   INC HL
1580  B7B1 72                   LD (HL),D
1581  B7B2 C9                   RET
1582  B7B3              ; ----------------------------------------------------------------------
1583  B7B3              ; FCB_RO_FLAG_TEST -- raise the file-R/O error if the matched directory entry is read-only.
1584  B7B3              ;   In: the DIRBUF ptr (DIRBUF_PTR) and entry byte-offset (DEBLOCK_BYTE_OFF) locate the matched entry (via
1585  B7B3              ;       FCB_BUF_PTR_ADD_OFFSET).
1586  B7B3              ;   Out: returns normally if writable; otherwise jumps to the BDOS error vector (no return; loads the
1587  B7B3              ;        file-R/O error record at $DC0F and dispatches via $DF18).  Clobbers: A,DE,HL.
1588  B7B3              ;   Algorithm: point at the entry, advance to byte +9 (the first type byte t1', whose bit 7 is the R/O
1589  B7B3              ;       attribute), RLA to shift bit 7 into carry; RET NC if clear, else load HL=$DC0F (file-R/O error
1590  B7B3              ;       block) and JP $DF18 (the BDOS error dispatch trampoline).
1591  B7B3              ;   [RE] CP/M file R/O attribute = bit 7 of directory-entry byte 9 (t1'). [DOC CP/M 2.2 FCB]
1592  B7B3              ; ----------------------------------------------------------------------
1593  B7B3              FCB_RO_FLAG_TEST:
1594  B7B3 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
1595  B7B6              ; ----------------------------------------------------------------------
1596  B7B6              ; CHECK_DIRENT_READONLY_INNER -- inner entry of FCB_RO_FLAG_TEST (HL already on the directory entry). [RE]
1597  B7B6              ; ----------------------------------------------------------------------
1598  B7B6              CHECK_DIRENT_READONLY_INNER:
1599  B7B6 11 09 00             LD DE,$0009
1600  B7B9 19                   ADD HL,DE
1601  B7BA 7E                   LD A,(HL)
1602  B7BB 17                   RLA
1603  B7BC D0                   RET NC
1604  B7BD 21 0F DC             LD HL,$DC0F
1605  B7C0 C3 18 DF             JP $DF18
1606  B7C3              ; ----------------------------------------------------------------------
1607  B7C3              ; CHECK_DRIVE_READONLY -- raise the disk-R/O error if the current drive is write-protected.
1608  B7C3              ;   In: the current drive context (DRIVE_BIT_TEST reads the R/O drive vector at $BFBA).
1609  B7C3              ;   Out: returns if writable; otherwise jumps to the BDOS error vector (no return; loads the disk-R/O
1610  B7C3              ;        error record at $DC0D and dispatches via $DF18).  Clobbers: A,C,HL.
1611  B7C3              ;   Algorithm: CALL DRIVE_BIT_TEST; RET Z if clear (writable), else HL := $DC0D (disk-R/O error block)
1612  B7C3              ;       and JP $DF18 (the BDOS error dispatch trampoline).
1613  B7C3              ;   [RE] guards writes against a write-protected disk. [?]
1614  B7C3              ; ----------------------------------------------------------------------
1615  B7C3              CHECK_DRIVE_READONLY:
1616  B7C3 CD 8D B7             CALL DRIVE_BIT_TEST
1617  B7C6 C8                   RET Z
1618  B7C7 21 0D DC             LD HL,$DC0D
1619  B7CA C3 18 DF             JP $DF18
1620  B7CD              ; ----------------------------------------------------------------------
1621  B7CD              ; FCB_BUF_PTR_ADD_OFFSET -- compute a pointer to the matched directory entry inside the directory buffer.
1622  B7CD              ;   In: DIRBUF ptr at $BFC6; the entry byte-offset at $BFF6.
1623  B7CD              ;   Out: HL = (DIRBUF ptr) + offset.  Clobbers: A,HL.
1624  B7CD              ;   Algorithm: load the buffer base (DIRBUF_PTR), load the 8-bit entry offset (DEBLOCK_BYTE_OFF), add it to L with carry
1625  B7CD              ;       into H (falls into DIRENT_PTR_ADD).
1626  B7CD              ;   [RE] locates the directory entry just matched by a BDOS directory search. [?]
1627  B7CD              ; ----------------------------------------------------------------------
1628  B7CD              FCB_BUF_PTR_ADD_OFFSET:
1629  B7CD 2A C6 BF             LD HL,(DIRBUF_PTR)
1630  B7D0 3A F6 BF             LD A,(DEBLOCK_BYTE_OFF)
1631  B7D3              ; ----------------------------------------------------------------------
1632  B7D3              ; DIRENT_PTR_ADD -- add the 8-bit directory-entry offset in A to HL (carry into H). [RE]
1633  B7D3              ; ----------------------------------------------------------------------
1634  B7D3              DIRENT_PTR_ADD:
1635  B7D3 85                   ADD A,L
1636  B7D4 6F                   LD L,A
1637  B7D5 D0                   RET NC
1638  B7D6 24                   INC H
1639  B7D7 C9                   RET
1640  B7D8              ; ----------------------------------------------------------------------
1641  B7D8              ; FCB_GET_S2 -- point HL at FCB byte 14 (the S2 / extent-high field) of the current FCB.
1642  B7D8              ;   In: current FCB pointer at $DF11 (upper-bank CURFCB cell).
1643  B7D8              ;   Out: HL = (CURFCB $DF11) + $000E (FCB+14, the S2 byte); A = its current value.  Clobbers: A,DE,HL.
1644  B7D8              ;   Algorithm: HL := base + $0E, read (HL) into A.
1645  B7D8              ;   [RE] FCB byte 14 = S2 (extent-high / module count) per CP/M 2.2 FCB layout. [DOC CP/M 2.2 FCB]
1646  B7D8              ; ----------------------------------------------------------------------
1647  B7D8              FCB_GET_S2:
1648  B7D8 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1649  B7DB 11 0E 00             LD DE,$000E
1650  B7DE 19                   ADD HL,DE
1651  B7DF 7E                   LD A,(HL)
1652  B7E0 C9                   RET
1653  B7E1              ; ----------------------------------------------------------------------
1654  B7E1              ; F_MAKE_OPEN_PREP -- shared Open/Make preamble: reset the random-record scratch, clear S2, log in the FCB drive.
1655  B7E1              ;   In: caller's FCB (DE set by the dispatcher; RANDREC_FIELD_RESET stages it into the scratch FCB).
1656  B7E1              ;   Out: the random-record scratch FCB primed, the FCB S2 byte cleared, and the FCB's drive selected
1657  B7E1              ;        (FCB_LOGIN_SELECT).  Clobbers: A,BC,DE,HL.
1658  B7E1              ;   Algorithm: CALL RANDREC_FIELD_RESET; CALL CLEAR_FCB_S2; CALL FCB_LOGIN_SELECT; RET.
1659  B7E1              ;   [RE] common front end of BDOS_F_OPEN (fn 15) and BDOS_F_MAKE (fn 22). [?]
1660  B7E1              ; ----------------------------------------------------------------------
1661  B7E1              F_MAKE_OPEN_PREP:
1662  B7E1 CD A3 BF             CALL RANDREC_FIELD_RESET
1663  B7E4 CD EB B7             CALL CLEAR_FCB_S2
1664  B7E7 CD 77 BE             CALL FCB_LOGIN_SELECT
1665  B7EA C9                   RET
1666  B7EB              ; ----------------------------------------------------------------------
1667  B7EB              ; CLEAR_FCB_S2 -- zero the S2 (byte 14) field of the current FCB.
1668  B7EB              ;   In: the current FCB (via FCB_GET_S2).  Out: FCB byte 14 = 0.  Clobbers: A,DE,HL.
1669  B7EB              ;   Algorithm: get the S2 pointer, store 0.
1670  B7EB              ;   [RE] resets the extent-high/S2 field. [DOC CP/M 2.2 FCB]
1671  B7EB              ; ----------------------------------------------------------------------
1672  B7EB              CLEAR_FCB_S2:
1673  B7EB CD D8 B7             CALL FCB_GET_S2
1674  B7EE 36 00                LD (HL),$00
1675  B7F0 C9                   RET
1676  B7F1              ; ----------------------------------------------------------------------
1677  B7F1              ; MARK_FCB_S2_HIGHBIT -- set bit 7 of the FCB S2 (byte 14) field.
1678  B7F1              ;   In: the current FCB (via FCB_GET_S2, which also returns A = the current S2 value).
1679  B7F1              ;   Out: FCB byte 14 |= $80.  Clobbers: A,DE,HL.
1680  B7F1              ;   Algorithm: get the S2 pointer (A = current S2), OR $80, store back.
1681  B7F1              ;   [RE] in CP/M 2.2 the high bit of S2 flags the FCB as written / needing a directory update at close.
1682  B7F1              ;        [DOC CP/M 2.2 FCB]
1683  B7F1              ; ----------------------------------------------------------------------
1684  B7F1              MARK_FCB_S2_HIGHBIT:
1685  B7F1 CD D8 B7             CALL FCB_GET_S2
1686  B7F4 F6 80                OR $80
1687  B7F6 77                   LD (HL),A
1688  B7F7 C9                   RET
1689  B7F8              ; ----------------------------------------------------------------------
1690  B7F8              ; CMP_CURREC_VS_WORKPTR -- compare the current record number against the working record cell.
1691  B7F8              ;   In: CUR_RECORD = 16-bit current record at $BFF7; the working-record word pointer at (DPB_WORK_PTR0).
1692  B7F8              ;   Out: HL = address of the working value's high byte; flags = (CUR_RECORD - working value);
1693  B7F8              ;        CARRY SET when CUR_RECORD < the working value.  Clobbers: A,DE,HL.
1694  B7F8              ;   Algorithm: DE := (CUR_RECORD $BFF7), HL := (word at $BFC0); subtract low byte then high byte,
1695  B7F8              ;       leaving HL on the high byte; no value is stored.
1696  B7F8              ;   [RE] RECPTR_INC_STORE uses this: on NC it bumps and stores CUR_RECORD+1, extending the high-water
1697  B7F8              ;   count. [?]
1698  B7F8              ; ----------------------------------------------------------------------
1699  B7F8              CMP_CURREC_VS_WORKPTR:
1700  B7F8 2A F7 BF             LD HL,(CUR_RECORD)
1701  B7FB EB                   EX DE,HL
1702  B7FC 2A C0 BF             LD HL,(DPB_WORK_PTR0)
1703  B7FF 7B                   LD A,E
1704  B800 96                   SUB (HL)
1705  B801 23                   INC HL
1706  B802 7A                   LD A,D
1707  B803 9E                   SBC A,(HL)
1708  B804 C9                   RET
1709  B805              ; ----------------------------------------------------------------------
1710  B805              ; RECPTR_INC_STORE -- if the current record is at/past the stored high-water count, bump it one past.
1711  B805              ;   In: CUR_RECORD = record just processed (CUR_RECORD); the working record-count word via (DPB_WORK_PTR0).
1712  B805              ;   Out: if CUR_RECORD >= cell, cell := CUR_RECORD+1; else unchanged. DE = CUR_RECORD(+1 if updated);
1713  B805              ;        HL in cell.  Clobbers: A,DE,HL,flags.
1714  B805              ;   Algorithm: CMP_CURREC_VS_WORKPTR; RET C (CUR_RECORD < count, leave it); else DE:=CUR_RECORD+1 and
1715  B805              ;       write it HIGH byte first (LD (HL),D), DEC HL, then LOW byte (LD (HL),E).
1716  B805              ;   [RE] classic CP/M 2.2 extent record-count bump; keeps the FCB high-water one past the last accessed.
1717  B805              ; ----------------------------------------------------------------------
1718  B805              RECPTR_INC_STORE:
1719  B805 CD F8 B7             CALL CMP_CURREC_VS_WORKPTR
1720  B808 D8                   RET C
1721  B809 13                   INC DE
1722  B80A 72                   LD (HL),D
1723  B80B 2B                   DEC HL
1724  B80C 73                   LD (HL),E
1725  B80D C9                   RET
1726  B80E              ; ----------------------------------------------------------------------
1727  B80E              ; SUB16_DE_HL -- 16-bit subtract HL := DE - HL.
1728  B80E              ;   In: DE = minuend, HL = subtrahend.
1729  B80E              ;   Out: HL = DE - HL; carry set on borrow (DE < HL unsigned).  Clobbers: HL,flags. DE preserved.
1730  B80E              ;   Algorithm: EX DE,HL; OR A (clear carry); SBC HL,DE.
1731  B80E              ;   [RE] general BDOS 16-bit compare/difference helper used by the record scan and seek logic.
1732  B80E              ; ----------------------------------------------------------------------
1733  B80E              SUB16_DE_HL:
1734  B80E EB                   EX DE,HL
1735  B80F B7                   OR A
1736  B810 ED 52                SBC HL,DE
1737  B812 C9                   RET
1738  B813              ; ----------------------------------------------------------------------
1739  B813              ; RECORD_SCAN_BODY -- scan to the target byte in the cached directory record, then store or compare A there.
1740  B813              ;   In: C = mode (INC C wraps to 0 => store mode, else compare); the scan cursor $BFF9 and limit $BFD9;
1741  B813              ;       the entry byte-offset via $BFCA/$BFF9; A = byte to store/compare; DIRBUF holds the record.
1742  B813              ;   Out: store mode writes A. Compare: Z on match; if no match and CUR_RECORD is past the stored count
1743  B813              ;        it flags the drive R/O (BDOS_F_SETRO). NC if the scan cursor did not pass the limit.
1744  B813              ;   Clobbers: A,BC,DE,HL,flags.
1745  B813              ;   Algorithm: DE:=scan cursor (REC_CACHE), HL:=limit (REC_SCAN_PTR); SUB16_DE_HL; RET NC if the cursor passed.
1746  B813              ;       Else DIR_CHECKSUM, add the offset (REC_BYTE_OFFSET) to $BFF9 to address the target byte. INC C: if it
1747  B813              ;       wrapped to 0, store A; else CP (HL), RET Z on match; on mismatch CMP_CURREC_VS_WORKPTR; RET NC
1748  B813              ;       if within count, else BDOS_F_SETRO.
1749  B813              ;   [RE] heart of the directory record scan/checksum loop in the BDOS deblocking layer.
1750  B813              ; ----------------------------------------------------------------------
1751  B813              RECORD_SCAN_BODY:
1752  B813 0E FF                LD C,$FF
1753  B815              RECORD_SCAN_BODY_1:
1754  B815 2A F9 BF             LD HL,(REC_CACHE)
1755  B818 EB                   EX DE,HL
1756  B819 2A D9 BF             LD HL,(REC_SCAN_PTR)
1757  B81C CD 0E B8             CALL SUB16_DE_HL
1758  B81F D0                   RET NC
1759  B820 C5                   PUSH BC
1760  B821 CD 68 B7             CALL DIR_CHECKSUM
1761  B824 2A CA BF             LD HL,(REC_BYTE_OFFSET)
1762  B827 EB                   EX DE,HL
1763  B828 2A F9 BF             LD HL,(REC_CACHE)
1764  B82B 19                   ADD HL,DE
1765  B82C C1                   POP BC
1766  B82D 0C                   INC C
1767  B82E 28 0A                JR Z,RECORD_SCAN_BODY_2
1768  B830 BE                   CP (HL)
1769  B831 C8                   RET Z
1770  B832 CD F8 B7             CALL CMP_CURREC_VS_WORKPTR
1771  B835 D0                   RET NC
1772  B836 CD 9B B7             CALL BDOS_F_SETRO
1773  B839 C9                   RET
1774  B83A              RECORD_SCAN_BODY_2:
1775  B83A 77                   LD (HL),A
1776  B83B C9                   RET
1777  B83C              ; ----------------------------------------------------------------------
1778  B83C              ; DIR_RECORD_WRITE -- checksum-verify then write the directory buffer to disk as a record, and refresh the user buffer.
1779  B83C              ;   In: directory buffer (via DIRBUF ptr $BFC6) and the BDOS deblock state set up by the caller.
1780  B83C              ;   Out: the record is written to disk (with the R/O-on-tamper check); user DMA restored; errors raised
1781  B83C              ;        via the checked disk-write path.  Clobbers: A,BC,DE,HL,flags.
1782  B83C              ;   Algorithm: RECORD_SCAN_BODY runs the scan in store mode (re-checksums DIRBUF, sets the drive R/O on
1783  B83C              ;       a tamper mismatch). SET_DMA_TO_DISK_BUF aims the BIOS DMA at DIRBUF; C=1 selects the directory
1784  B83C              ;       write type; CALL $DF28 (the lower-LC checked-write trampoline) issues the BIOS WRITE; JR into
1785  B83C              ;       RESTORE_USER_DMA restores the user DMA.
1786  B83C              ;   [RE] directory-record write path; C=1 is the CP/M deblock directory-write code.
1787  B83C              ; ----------------------------------------------------------------------
1788  B83C              DIR_RECORD_WRITE:
1789  B83C CD 13 B8             CALL RECORD_SCAN_BODY
1790  B83F CD 54 B8             CALL SET_DMA_TO_DISK_BUF
1791  B842 0E 01                LD C,$01
1792  B844 CD 28 DF             CALL $DF28
1793  B847 18 06                JR RESTORE_USER_DMA
1794  B849              ; ----------------------------------------------------------------------
1795  B849              ; DIR_RECORD_READ -- read a directory record from disk into the directory buffer, then restore the user DMA.
1796  B849              ;   In: BDOS deblock state set up by the caller.
1797  B849              ;   Out: DIRBUF filled from disk; user DMA restored.  Clobbers: A,BC,DE,HL,flags.
1798  B849              ;   Algorithm: SET_DMA_TO_DISK_BUF, CALL $DF20 (the lower-LC checked-read trampoline: BIOS READ +
1799  B849              ;       error check), then fall through into RESTORE_USER_DMA.
1800  B849              ;   [RE] directory-record read path; pairs with DIR_RECORD_WRITE.
1801  B849              ; ----------------------------------------------------------------------
1802  B849              DIR_RECORD_READ:
1803  B849 CD 54 B8             CALL SET_DMA_TO_DISK_BUF
1804  B84C CD 20 DF             CALL $DF20
1805  B84F              ; ----------------------------------------------------------------------
1806  B84F              ; RESTORE_USER_DMA -- restore the BIOS DMA address to the user's DMA buffer.
1807  B84F              ;   In: the DMA_ADDR cell at $BFBE holds the user DMA address.
1808  B84F              ;   Out: BIOS DMA set to (DMA_ADDR) via the BIOS SETDMA vector ($FA24).  Clobbers: BC,HL,flags.
1809  B84F              ;   Algorithm: HL := $BFBE (address of the DMA_ADDR cell), then load the word and JP BIOS SETDMA.
1810  B84F              ;   [RE] used after directory I/O to put DMA back to the application buffer.
1811  B84F              ; ----------------------------------------------------------------------
1812  B84F              RESTORE_USER_DMA:
1813  B84F 21 BE BF             LD HL,DMA_ADDR
1814  B852 18 03                JR SET_DMA_FROM_CELL
1815  B854              ; ----------------------------------------------------------------------
1816  B854              ; SET_DMA_TO_DISK_BUF -- point the BIOS DMA at the directory/disk buffer (DIRBUF).
1817  B854              ;   In: the DIRBUF ptr cell at $BFC6 holds the directory buffer address.
1818  B854              ;   Out: BIOS DMA set to (DIRBUF ptr) via the BIOS SETDMA vector ($FA24).  Clobbers: BC,HL,flags.
1819  B854              ;   Algorithm: HL := $BFC6 (address of the DIRBUF ptr cell); load the word and JP BIOS SETDMA.
1820  B854              ;   [RE] companion to RESTORE_USER_DMA; aims I/O at the OS directory buffer.
1821  B854              ; ----------------------------------------------------------------------
1822  B854              SET_DMA_TO_DISK_BUF:
1823  B854 21 C6 BF             LD HL,DIRBUF_PTR
1824  B857              SET_DMA_FROM_CELL:
1825  B857 4E                   LD C,(HL)
1826  B858 23                   INC HL
1827  B859 46                   LD B,(HL)
1828  B85A C3 24 FA             JP SETDMA
1829  B85D              SET_DMA_TO_DISK_BUF_2:
1830  B85D 2A C6 BF             LD HL,(DIRBUF_PTR)
1831  B860 ED 5B BE BF          LD DE,(DMA_ADDR)
1832  B864 01 80 00             LD BC,$0080
1833  B867 CD 3C DF             CALL $DF3C
1834  B86A C9                   RET
1835  B86B              ; ----------------------------------------------------------------------
1836  B86B              ; CUR_RECORD_BYTES_EQUAL -- test whether the low and high bytes of the 16-bit CUR_RECORD cell (CUR_RECORD) are equal.
1837  B86B              ;   In: CUR_RECORD = a 16-bit cell ($BFF7 low, $BFF8 high).
1838  B86B              ;   Out: if the two bytes differ, NZ with A = the low byte; if equal, A = low byte + 1.  Clobbers: A,HL,flags.
1839  B86B              ;   Algorithm: HL -> low byte (CUR_RECORD); A := (HL); INC HL; CP (HL); RET NZ if they differ; else INC A and RET.
1840  B86B              ;   [RE] deblock helper comparing the two halves of CUR_RECORD; called widely as an end-of-scan test.
1841  B86B              ;        The exact role of the equal/INC result is UNKNOWN from these bytes alone (callers consume Z).
1842  B86B              ; ----------------------------------------------------------------------
1843  B86B              CUR_RECORD_BYTES_EQUAL:
1844  B86B 21 F7 BF             LD HL,CUR_RECORD
1845  B86E 7E                   LD A,(HL)
1846  B86F 23                   INC HL
1847  B870 BE                   CP (HL)
1848  B871 C0                   RET NZ
1849  B872 3C                   INC A
1850  B873 C9                   RET
1851  B874              ; ----------------------------------------------------------------------
1852  B874              ; INVALIDATE_CUR_RECORD -- mark the cached record pointer invalid (CUR_RECORD := $FFFF).
1853  B874              ;   In: none.  Out: CUR_RECORD cell (CUR_RECORD) = $FFFF.  Clobbers: HL.
1854  B874              ;   Algorithm: HL := $FFFF; store to $BFF7; RET.
1855  B874              ;   [RE] forces the next deblock access to reload, since $FFFF can never equal a real record number.
1856  B874              ; ----------------------------------------------------------------------
1857  B874              INVALIDATE_CUR_RECORD:
1858  B874 21 FF FF             LD HL,$FFFF
1859  B877 22 F7 BF             LD (CUR_RECORD),HL
1860  B87A C9                   RET
1861  B87B              ; ----------------------------------------------------------------------
1862  B87B              ; DIR_READ_NEXT -- advance the directory record pointer and read the next 32-byte directory entry.
1863  B87B              ;   In: CUR_RECORD (CUR_RECORD) = last directory record index processed; the directory-record limit word at (DPB_REC_PTR).
1864  B87B              ;   Out: on a fresh 128-byte-record boundary the record is read into DIRBUF and the entry byte-offset
1865  B87B              ;        (DEBLOCK_BYTE_OFF) set to 0/32/64/96; at end of directory CUR_RECORD is invalidated ($FFFF).
1866  B87B              ;   Clobbers: A,BC,DE,HL,flags.
1867  B87B              ;   Algorithm: increment CUR_RECORD; SUB16_DE_HL against the limit (DPB_REC_PTR); if past the limit ->
1868  B87B              ;       INVALIDATE_CUR_RECORD; else offset := (CUR_RECORD & 3) << 5 into $BFF6, and on offset 0 compute
1869  B87B              ;       the disk record (REC_DIV4_SETUP) and DIR_RECORD_READ it into DIRBUF, then re-enter the scan.
1870  B87B              ;   [RE] canonical CP/M 2.2 read-next-directory-entry sequencer (four 32-byte entries per record).
1871  B87B              ; ----------------------------------------------------------------------
1872  B87B              DIR_READ_NEXT:
1873  B87B 2A D5 BF             LD HL,(DPB_REC_PTR)
1874  B87E EB                   EX DE,HL
1875  B87F 2A F7 BF             LD HL,(CUR_RECORD)
1876  B882 23                   INC HL
1877  B883 22 F7 BF             LD (CUR_RECORD),HL
1878  B886 CD 0E B8             CALL SUB16_DE_HL
1879  B889 30 02                JR NC,DIR_RECORD_DEBLOCK
1880  B88B 18 E7                JR INVALIDATE_CUR_RECORD
1881  B88D              DIR_RECORD_DEBLOCK:
1882  B88D 3A F7 BF             LD A,(CUR_RECORD)
1883  B890 E6 03                AND $03
1884  B892 06 05                LD B,$05
1885  B894              DIR_DEBLOCK_SHIFT:
1886  B894 87                   ADD A,A
1887  B895 10 FD                DJNZ DIR_DEBLOCK_SHIFT
1888  B897 32 F6 BF             LD (DEBLOCK_BYTE_OFF),A
1889  B89A B7                   OR A
1890  B89B C0                   RET NZ
1891  B89C C5                   PUSH BC
1892  B89D CD 43 B6             CALL REC_DIV4_SETUP
1893  B8A0 CD 49 B8             CALL DIR_RECORD_READ
1894  B8A3 C1                   POP BC
1895  B8A4 C3 15 B8             JP RECORD_SCAN_BODY_1
1896  B8A7              ; ----------------------------------------------------------------------
1897  B8A7              ; ALLOC_BIT_GET -- fetch the allocation-vector bit for a given disk block, returning it in carry.
1898  B8A7              ;   In: BC = block (group) number; the allocation-vector base pointer at (ALLOC_VEC_PTR).
1899  B8A7              ;   Out: carry/high bit of A = current allocation state; A = the allocation byte rotated so the wanted
1900  B8A7              ;        bit is in the MSB; HL = address of that byte; D = E = bit index.  Clobbers: A,BC,DE,HL,flags.
1901  B8A7              ;   Algorithm: D=E=(block & 7)+1 = 1-based bit index (rotate count); byte index = block >> 3; add to the
1902  B8A7              ;       ALLOC-vec base (ALLOC_VEC_PTR); load the byte and rotate left by the bit index so the selected bit lands
1903  B8A7              ;       in carry/MSB.
1904  B8A7              ;   [RE] canonical CP/M 2.2 getmod: read one allocation bit from the bit-vector.
1905  B8A7              ; ----------------------------------------------------------------------
1906  B8A7              ALLOC_BIT_GET:
1907  B8A7 79                   LD A,C
1908  B8A8 E6 07                AND $07
1909  B8AA 3C                   INC A
1910  B8AB 5F                   LD E,A
1911  B8AC 57                   LD D,A
1912  B8AD 79                   LD A,C
1913  B8AE 0F                   RRCA
1914  B8AF 0F                   RRCA
1915  B8B0 0F                   RRCA
1916  B8B1 E6 1F                AND $1F
1917  B8B3 4F                   LD C,A
1918  B8B4 78                   LD A,B
1919  B8B5 87                   ADD A,A
1920  B8B6 87                   ADD A,A
1921  B8B7 87                   ADD A,A
1922  B8B8 87                   ADD A,A
1923  B8B9 87                   ADD A,A
1924  B8BA B1                   OR C
1925  B8BB 4F                   LD C,A
1926  B8BC 78                   LD A,B
1927  B8BD 0F                   RRCA
1928  B8BE 0F                   RRCA
1929  B8BF 0F                   RRCA
1930  B8C0 E6 1F                AND $1F
1931  B8C2 47                   LD B,A
1932  B8C3 2A CC BF             LD HL,(ALLOC_VEC_PTR)
1933  B8C6 09                   ADD HL,BC
1934  B8C7 7E                   LD A,(HL)
1935  B8C8              ALLOC_BIT_ROTATE:
1936  B8C8 07                   RLCA
1937  B8C9 1D                   DEC E
1938  B8CA 20 FC                JR NZ,ALLOC_BIT_ROTATE
1939  B8CC C9                   RET
1940  B8CD              ; ----------------------------------------------------------------------
1941  B8CD              ; ALLOC_BIT_WRITE -- write one block's allocation-vector bit to a caller-supplied value.
1942  B8CD              ;   In: BC = block (group) number; E = the bit value to store (1 = in use, 0 = free).
1943  B8CD              ;   Out: that block's bit in the allocation vector is set to E. Clobbers: A,BC,DE,HL,flags.
1944  B8CD              ;   Algorithm: PUSH DE saves the caller's value FIRST, because ALLOC_BIT_GET overwrites both
1945  B8CD              ;       D and E with the bit index. ALLOC_BIT_GET returns the byte left-rotated so the target
1946  B8CD              ;       bit is the LSB, HL pointing at it, and D = the rotate count. AND $FE clears that bit,
1947  B8CD              ;       POP BC recovers the saved pair so C is the caller's value, and OR C writes it in;
1948  B8CD              ;       ALLOC_BIT_RESTORE rotates back D times and stores.
1949  B8CD              ;   The bit is NOT forced to 1 -- this is the one primitive for both directions, and which
1950  B8CD              ;   direction it performs is entirely the caller's C. An earlier annotation here read "OR in 1
1951  B8CD              ;   to set the target bit", which made the delete path look like it contradicted its own
1952  B8CD              ;   comment. It does not: F_DELETE passes C=0 and frees, ALLOC_VECTOR_BUILD passes C=1. [RE]
1953  B8CD              ; ----------------------------------------------------------------------
1954  B8CD              ALLOC_BIT_WRITE:
1955  B8CD D5                   PUSH DE
1956  B8CE CD A7 B8             CALL ALLOC_BIT_GET
1957  B8D1 E6 FE                AND $FE
1958  B8D3 C1                   POP BC
1959  B8D4 B1                   OR C
1960  B8D5              ; ----------------------------------------------------------------------
1961  B8D5              ; ALLOC_BIT_RESTORE -- rotate the allocation byte right D times to restore alignment, then store it back. [RE]
1962  B8D5              ; ----------------------------------------------------------------------
1963  B8D5              ALLOC_BIT_RESTORE:
1964  B8D5 0F                   RRCA
1965  B8D6 15                   DEC D
1966  B8D7 20 FC                JR NZ,ALLOC_BIT_RESTORE
1967  B8D9 77                   LD (HL),A
1968  B8DA C9                   RET
1969  B8DB              ; ----------------------------------------------------------------------
1970  B8DB              ; ALLOC_FROM_FCB -- apply a directory entry's block map to the allocation vector.
1971  B8DB              ;   In: C = the bit value to write for each block (1 = in use, 0 = free); it is stashed by
1972  B8DB              ;       PUSH BC and recirculated through DE each iteration, reaching ALLOC_BIT_WRITE in E.
1973  B8DB              ;       In: the entry byte-offset (DEBLOCK_BYTE_OFF) positions HL on the current 32-byte directory entry; block-width
1974  B8DB              ;       flag $BFEA selects 8-bit (non-zero, DSM<256) vs 16-bit (zero) block numbers; entry holds a
1975  B8DB              ;       16-byte block map at offset $10; max block DSM at (MAX_BLOCK_DSM).
1976  B8DB              ;   Out: every non-zero, in-range block of this entry has its allocation bit set to the
1977  B8DB              ;        CALLER'S value -- C=1 marks them in use (directory rebuild), C=0 frees them
1978  B8DB              ;        (F_DELETE). The routine itself is direction-agnostic. Clobbers: A,BC,DE,HL,flags.
1979  B8DB              ;   Algorithm: point HL at the block map (entry+$10); iterate 16 (8-bit) or 8 (16-bit) pointers; read
1980  B8DB              ;       each block number; if non-zero and <= max block (MAX_BLOCK_DSM), mark it allocated via ALLOC_BIT_WRITE.
1981  B8DB              ;   [RE] canonical CP/M 2.2 directory-entry allocation-map application used when rebuilding the alloc vector.
1982  B8DB              ; ----------------------------------------------------------------------
1983  B8DB              ALLOC_FROM_FCB:
1984  B8DB CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
1985  B8DE 11 10 00             LD DE,$0010
1986  B8E1 19                   ADD HL,DE
1987  B8E2 C5                   PUSH BC
1988  B8E3 0E 11                LD C,$11
1989  B8E5              ALLOC_FROM_FCB_LOOP:
1990  B8E5 D1                   POP DE
1991  B8E6 0D                   DEC C
1992  B8E7 C8                   RET Z
1993  B8E8 D5                   PUSH DE
1994  B8E9 3A EA BF             LD A,(BLOCK_WIDTH_FLAG)
1995  B8EC B7                   OR A
1996  B8ED 28 07                JR Z,ALLOC_FROM_FCB_WIDE
1997  B8EF C5                   PUSH BC
1998  B8F0 E5                   PUSH HL
1999  B8F1 4E                   LD C,(HL)
2000  B8F2 06 00                LD B,$00
2001  B8F4 18 06                JR ALLOC_FROM_FCB_CHECK
2002  B8F6              ALLOC_FROM_FCB_WIDE:
2003  B8F6 0D                   DEC C
2004  B8F7 C5                   PUSH BC
2005  B8F8 4E                   LD C,(HL)
2006  B8F9 23                   INC HL
2007  B8FA 46                   LD B,(HL)
2008  B8FB E5                   PUSH HL
2009  B8FC              ALLOC_FROM_FCB_CHECK:
2010  B8FC 79                   LD A,C
2011  B8FD B0                   OR B
2012  B8FE 28 0A                JR Z,ALLOC_FROM_FCB_NEXT
2013  B900 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
2014  B903 7D                   LD A,L
2015  B904 91                   SUB C
2016  B905 7C                   LD A,H
2017  B906 98                   SBC A,B
2018  B907 D4 CD B8             CALL NC,ALLOC_BIT_WRITE
2019  B90A              ALLOC_FROM_FCB_NEXT:
2020  B90A E1                   POP HL
2021  B90B 23                   INC HL
2022  B90C C1                   POP BC
2023  B90D 18 D6                JR ALLOC_FROM_FCB_LOOP
2024  B90F              ; ----------------------------------------------------------------------
2025  B90F              ; ALLOC_VECTOR_BUILD -- rebuild the drive's allocation bit-vector by scanning the entire directory.
2026  B90F              ;   In: selected drive's DPB fields (max block DSM at $BFD3, directory-reserved-blocks word at $BFD7,
2027  B90F              ;       ALLOC-vec base at $BFCC).
2028  B90F              ;   Out: allocation vector fully populated: reserved directory blocks plus every block referenced by a
2029  B90F              ;        non-deleted directory entry are marked used.  Clobbers: A,BC,DE,HL,flags.
2030  B90F              ;   Algorithm: zero the allocation vector across its whole length ((DSM+1)/8 bytes); seed the reserved
2031  B90F              ;       directory blocks (ALLOC_END_PTR); reset the scan workspace to read from the start (DISK_HOME_CLEAR_SCAN);
2032  B90F              ;       for each entry skip deleted ($E5) ones, run a special-entry check against the current user
2033  B90F              ;       (BDOS_STACK_TOP) / '$' ($24) name byte (storing into the result cell $DF13), and ALLOC_FROM_FCB to mark
2034  B90F              ;       its blocks; advance until the directory is exhausted.
2035  B90F              ;   [RE] canonical CP/M 2.2 drive-init allocation-vector builder, invoked on drive selection / reset.
2036  B90F              ;   [?] the user-byte / '$' name-byte special-entry path's exact intent is UNKNOWN.
2037  B90F              ; ----------------------------------------------------------------------
2038  B90F              ALLOC_VECTOR_BUILD:
2039  B90F 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
2040  B912 0E 03                LD C,$03
2041  B914 CD 5F B7             CALL SHR_HL_C
2042  B917 23                   INC HL
2043  B918 44                   LD B,H
2044  B919 4D                   LD C,L
2045  B91A 2A CC BF             LD HL,(ALLOC_VEC_PTR)
2046  B91D              ALLOC_VECTOR_CLEAR_LOOP:
2047  B91D 36 00                LD (HL),$00
2048  B91F 23                   INC HL
2049  B920 0B                   DEC BC
2050  B921 78                   LD A,B
2051  B922 B1                   OR C
2052  B923 20 F8                JR NZ,ALLOC_VECTOR_CLEAR_LOOP
2053  B925 2A D7 BF             LD HL,(ALLOC_END_PTR)
2054  B928 EB                   EX DE,HL
2055  B929 2A CC BF             LD HL,(ALLOC_VEC_PTR)
2056  B92C 73                   LD (HL),E
2057  B92D 23                   INC HL
2058  B92E 72                   LD (HL),D
2059  B92F CD 32 B6             CALL DISK_HOME_CLEAR_SCAN
2060  B932 2A C0 BF             LD HL,(DPB_WORK_PTR0)
2061  B935 36 03                LD (HL),$03
2062  B937 23                   INC HL
2063  B938 36 00                LD (HL),$00
2064  B93A CD 74 B8             CALL INVALIDATE_CUR_RECORD
2065  B93D              ALLOC_VECTOR_SCAN_LOOP:
2066  B93D 0E FF                LD C,$FF
2067  B93F CD 7B B8             CALL DIR_READ_NEXT
2068  B942 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2069  B945 C8                   RET Z
2070  B946 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2071  B949 3E E5                LD A,$E5
2072  B94B BE                   CP (HL)
2073  B94C 28 EF                JR Z,ALLOC_VECTOR_SCAN_LOOP
2074  B94E 3A 0F DF             LD A,(BDOS_STACK_TOP)
2075  B951 BE                   CP (HL)
2076  B952 20 0A                JR NZ,ALLOC_VECTOR_SCAN_MARK
2077  B954 23                   INC HL
2078  B955 7E                   LD A,(HL)
2079  B956 D6 24                SUB $24
2080  B958 20 04                JR NZ,ALLOC_VECTOR_SCAN_MARK
2081  B95A 3D                   DEC A
2082  B95B 32 13 DF             LD (BDOS_RETVAL),A
2083  B95E              ALLOC_VECTOR_SCAN_MARK:
2084  B95E 0E 01                LD C,$01
2085  B960 CD DB B8             CALL ALLOC_FROM_FCB
2086  B963 CD 05 B8             CALL RECPTR_INC_STORE
2087  B966 C3 3D B9             JP ALLOC_VECTOR_SCAN_LOOP
2088  B969              ; ----------------------------------------------------------------------
2089  B969              ; DIR_RETURN_MATCH_FLAG -- return the saved directory-search match status as the BDOS result.
2090  B969              ;   In: the directory match flag at $BFE1 ($FF=no match, else the 0..3 entry index).
2091  B969              ;   Out: A = (DIR_MATCH_FLAG); stored to the BDOS result byte via the common result-store path ($DED0).  Clobbers: A.
2092  B969              ;   Algorithm: load the cached search-match flag (DIR_MATCH_FLAG) and JP BDOS_RET_RESULT (the upper-bank BDOS_RET_RESULT).
2093  B969              ;   [RE] common return tail of F_DELETE_HND / F_RENAME_HND / F_ATTRIB_HND.
2094  B969              ; ----------------------------------------------------------------------
2095  B969              DIR_RETURN_MATCH_FLAG:
2096  B969 3A E1 BF             LD A,(DIR_MATCH_FLAG)
2097  B96C C3 D0 DE             JP BDOS_RET_RESULT
2098  B96F              ; ----------------------------------------------------------------------
2099  B96F              ; FCB_EXTENT_COMPARE -- compare two FCB extent bytes under the drive's extent mask.
2100  B96F              ;   In: C = one extent byte; A = the other extent byte; DPB EXM mask at $BFD2.
2101  B96F              ;   Out: A,flags = ((A & ~mask) - (C & ~mask)) & $1F; Z set when the high extent fields match.  Clobbers: A (BC/AF saved+restored).
2102  B96F              ;   Algorithm: complement EXM (DPB_EXM), AND it into both extent bytes (dropping the masked low bits),
2103  B96F              ;       subtract, keep five bits, and test for equality.
2104  B96F              ;   [RE]
2105  B96F              ; ----------------------------------------------------------------------
2106  B96F              FCB_EXTENT_COMPARE:
2107  B96F C5                   PUSH BC
2108  B970 F5                   PUSH AF
2109  B971 3A D2 BF             LD A,(DPB_EXM)
2110  B974 2F                   CPL
2111  B975 47                   LD B,A
2112  B976 79                   LD A,C
2113  B977 A0                   AND B
2114  B978 4F                   LD C,A
2115  B979 F1                   POP AF
2116  B97A A0                   AND B
2117  B97B 91                   SUB C
2118  B97C E6 1F                AND $1F
2119  B97E C1                   POP BC
2120  B97F C9                   RET
2121  B980              ; ----------------------------------------------------------------------
2122  B980              ; DIR_SEARCH_FIRST -- begin a directory scan for the current FCB, comparing C bytes per entry.
2123  B980              ;   In: C = number of FCB bytes to match ($0C=name+type, $0F=incl. extent); current FCB at $DF11.
2124  B980              ;   Out: falls through into BDOS_DIR_SCAN_NEXT, which returns the within-record entry index 0..3 or $FF.
2125  B980              ;   Clobbers: A,B,C,D,E,H,L,flags.
2126  B980              ;   Algorithm: set the match flag $BFE1=$FF, store the compare length (DIR_CMP_LEN) and search-FCB pointer
2127  B980              ;       (DIR_FCB_PTR), reset the record counter to -1 (INVALIDATE_CUR_RECORD), rewind/clear the scan state
2128  B980              ;       (DISK_HOME_CLEAR_SCAN), then run the first pass.
2129  B980              ;   [RE]
2130  B980              ; ----------------------------------------------------------------------
2131  B980              DIR_SEARCH_FIRST:
2132  B980 3E FF                LD A,$FF
2133  B982 32 E1 BF             LD (DIR_MATCH_FLAG),A
2134  B985 21 E5 BF             LD HL,DIR_CMP_LEN
2135  B988 71                   LD (HL),C
2136  B989 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2137  B98C 22 E6 BF             LD (DIR_FCB_PTR),HL
2138  B98F CD 74 B8             CALL INVALIDATE_CUR_RECORD
2139  B992 CD 32 B6             CALL DISK_HOME_CLEAR_SCAN
2140  B995              ; ----------------------------------------------------------------------
2141  B995              ; BDOS_DIR_SCAN_NEXT -- advance through directory entries until one matches the search FCB.
2142  B995              ;   In: search-FCB pointer at $BFE6; compare length at $BFE5.
2143  B995              ;   Out: A = matching entry index (0..3, stored to result cell $DF13) on success; not-found via the
2144  B995              ;        $FF result path.  Clobbers: A,B,C,D,E,H,L,flags.
2145  B995              ;   Algorithm: step to the next directory record (DIR_READ_NEXT); if the counter passed the directory
2146  B995              ;       limit -> not found; otherwise treat erased ($E5) entries specially and bound-check
2147  B995              ;       (CMP_CURREC_VS_WORKPTR), then compare C bytes per entry (with '?' $3F wildcards and EXM-masked
2148  B995              ;       extent compare); on full match -> return the index, else loop to the next entry/record.
2149  B995              ;   [RE] standard CP/M 2.2 directory search-next with '?' wildcards.
2150  B995              ; ----------------------------------------------------------------------
2151  B995              BDOS_DIR_SCAN_NEXT:
2152  B995 0E 00                LD C,$00
2153  B997 CD 7B B8             CALL DIR_READ_NEXT
2154  B99A CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2155  B99D 28 52                JR Z,DIR_NO_MATCH
2156  B99F 2A E6 BF             LD HL,(DIR_FCB_PTR)
2157  B9A2 EB                   EX DE,HL
2158  B9A3 1A                   LD A,(DE)
2159  B9A4 FE E5                CP $E5
2160  B9A6 28 07                JR Z,BDOS_DIR_SCAN_NEXT_CMP
2161  B9A8 D5                   PUSH DE
2162  B9A9 CD F8 B7             CALL CMP_CURREC_VS_WORKPTR
2163  B9AC D1                   POP DE
2164  B9AD 30 42                JR NC,DIR_NO_MATCH
2165  B9AF              BDOS_DIR_SCAN_NEXT_CMP:
2166  B9AF CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2167  B9B2 3A E5 BF             LD A,(DIR_CMP_LEN)
2168  B9B5 4F                   LD C,A
2169  B9B6 06 00                LD B,$00
2170  B9B8              DIR_CMP_BYTE_LOOP:
2171  B9B8 79                   LD A,C
2172  B9B9 B7                   OR A
2173  B9BA 28 24                JR Z,DIR_MATCH_FOUND
2174  B9BC 1A                   LD A,(DE)
2175  B9BD FE 3F                CP $3F
2176  B9BF 28 19                JR Z,DIR_CMP_ADVANCE
2177  B9C1 78                   LD A,B
2178  B9C2 FE 0D                CP $0D
2179  B9C4 28 14                JR Z,DIR_CMP_ADVANCE
2180  B9C6 FE 0C                CP $0C
2181  B9C8 1A                   LD A,(DE)
2182  B9C9 28 07                JR Z,DIR_CMP_EXTENT
2183  B9CB 96                   SUB (HL)
2184  B9CC E6 7F                AND $7F
2185  B9CE 20 C5                JR NZ,BDOS_DIR_SCAN_NEXT
2186  B9D0 18 08                JR DIR_CMP_ADVANCE
2187  B9D2              DIR_CMP_EXTENT:
2188  B9D2 C5                   PUSH BC
2189  B9D3 4E                   LD C,(HL)
2190  B9D4 CD 6F B9             CALL FCB_EXTENT_COMPARE
2191  B9D7 C1                   POP BC
2192  B9D8 20 BB                JR NZ,BDOS_DIR_SCAN_NEXT
2193  B9DA              DIR_CMP_ADVANCE:
2194  B9DA 13                   INC DE
2195  B9DB 23                   INC HL
2196  B9DC 04                   INC B
2197  B9DD 0D                   DEC C
2198  B9DE 18 D8                JR DIR_CMP_BYTE_LOOP
2199  B9E0              DIR_MATCH_FOUND:
2200  B9E0 3A F7 BF             LD A,(CUR_RECORD)
2201  B9E3 E6 03                AND $03
2202  B9E5 32 13 DF             LD (BDOS_RETVAL),A
2203  B9E8 21 E1 BF             LD HL,DIR_MATCH_FLAG
2204  B9EB 7E                   LD A,(HL)
2205  B9EC 17                   RLA
2206  B9ED D0                   RET NC
2207  B9EE AF                   XOR A
2208  B9EF 77                   LD (HL),A
2209  B9F0 C9                   RET
2210  B9F1              DIR_NO_MATCH:
2211  B9F1 CD 74 B8             CALL INVALIDATE_CUR_RECORD
2212  B9F4 3E FF                LD A,$FF
2213  B9F6 C3 D0 DE             JP BDOS_RET_RESULT
2214  B9F9              ; ----------------------------------------------------------------------
2215  B9F9              ; F_DELETE_HND -- delete every directory entry matching the FCB (worker for BDOS function 19).
2216  B9F9              ;   In: current FCB at $DF11 (may contain '?' wildcards).
2217  B9F9              ;   Out: matching directory entries marked erased ($E5), their blocks freed, and written back.
2218  B9F9              ;   Clobbers: A,B,C,D,E,H,L,flags.
2219  B9F9              ;   Algorithm: CHECK_DRIVE_READONLY, DIR_SEARCH_FIRST on 12 FCB bytes (name+type), then loop: for each
2220  B9F9              ;       match test the R/O flag (FCB_RO_FLAG_TEST), stamp the entry byte $E5, free its blocks
2221  B9F9              ;       (ALLOC_FROM_FCB with C=0), DIR_RECORD_WRITE, BDOS_DIR_SCAN_NEXT.
2222  B9F9              ;   [RE] CP/M 2.2 F_DELETE.
2223  B9F9              ; ----------------------------------------------------------------------
2224  B9F9              F_DELETE_HND:
2225  B9F9 CD C3 B7             CALL CHECK_DRIVE_READONLY
2226  B9FC 0E 0C                LD C,$0C
2227  B9FE CD 80 B9             CALL DIR_SEARCH_FIRST
2228  BA01              F_DELETE_LOOP:
2229  BA01 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2230  BA04 C8                   RET Z
2231  BA05 CD B3 B7             CALL FCB_RO_FLAG_TEST
2232  BA08 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2233  BA0B 36 E5                LD (HL),$E5
2234  BA0D 0E 00                LD C,$00
2235  BA0F CD DB B8             CALL ALLOC_FROM_FCB
2236  BA12 CD 3C B8             CALL DIR_RECORD_WRITE
2237  BA15 CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
2238  BA18 18 E7                JR F_DELETE_LOOP
2239  BA1A              ; ----------------------------------------------------------------------
2240  BA1A              ; ALLOC_GET_BLOCK -- find/allocate a disk block near a starting block, marking it used.
2241  BA1A              ;   In: BC = starting block number (passed by the write core when extending a file); max block DSM at (MAX_BLOCK_DSM).
2242  BA1A              ;   Out: HL = the block number actually claimed (0 if none free); its allocation-vector bit set.  Clobbers: A,B,C,D,E,H,L,flags.
2243  BA1A              ;   Algorithm: copy the start block to DE, scan downward then upward testing each block's allocation bit
2244  BA1A              ;       (ALLOC_BIT_GET), bounded by max block (MAX_BLOCK_DSM); mark the chosen block used (ALLOC_BIT_RESTORE)
2245  BA1A              ;       and return it, or 0 when no block can be allocated.
2246  BA1A              ;   [RE] allocation-vector block search/allocate.
2247  BA1A              ; ----------------------------------------------------------------------
2248  BA1A              ALLOC_GET_BLOCK:
2249  BA1A 50                   LD D,B
2250  BA1B 59                   LD E,C
2251  BA1C              ALLOC_SCAN_DOWN:
2252  BA1C 79                   LD A,C
2253  BA1D B0                   OR B
2254  BA1E 28 0B                JR Z,ALLOC_SCAN_UP
2255  BA20 0B                   DEC BC
2256  BA21 D5                   PUSH DE
2257  BA22 C5                   PUSH BC
2258  BA23 CD A7 B8             CALL ALLOC_BIT_GET
2259  BA26 1F                   RRA
2260  BA27 30 1A                JR NC,ALLOC_MARK_DONE
2261  BA29 C1                   POP BC
2262  BA2A D1                   POP DE
2263  BA2B              ALLOC_SCAN_UP:
2264  BA2B 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
2265  BA2E 7B                   LD A,E
2266  BA2F 95                   SUB L
2267  BA30 7A                   LD A,D
2268  BA31 9C                   SBC A,H
2269  BA32 30 17                JR NC,ALLOC_SCAN_FINISH
2270  BA34 13                   INC DE
2271  BA35 C5                   PUSH BC
2272  BA36 D5                   PUSH DE
2273  BA37 42                   LD B,D
2274  BA38 4B                   LD C,E
2275  BA39 CD A7 B8             CALL ALLOC_BIT_GET
2276  BA3C 1F                   RRA
2277  BA3D 30 04                JR NC,ALLOC_MARK_DONE
2278  BA3F D1                   POP DE
2279  BA40 C1                   POP BC
2280  BA41 18 D9                JR ALLOC_SCAN_DOWN
2281  BA43              ALLOC_MARK_DONE:
2282  BA43 17                   RLA
2283  BA44 3C                   INC A
2284  BA45 CD D5 B8             CALL ALLOC_BIT_RESTORE
2285  BA48 E1                   POP HL
2286  BA49 D1                   POP DE
2287  BA4A C9                   RET
2288  BA4B              ALLOC_SCAN_FINISH:
2289  BA4B 79                   LD A,C
2290  BA4C B0                   OR B
2291  BA4D 20 CD                JR NZ,ALLOC_SCAN_DOWN
2292  BA4F 21 00 00             LD HL,$0000
2293  BA52 C9                   RET
2294  BA53              ; ----------------------------------------------------------------------
2295  BA53              ; FCB_WRITE_DIR_ENTRY -- copy the whole 32-byte FCB image into the matched directory entry and write it.
2296  BA53              ;   In: current FCB at $DF11; sets C=0 (FCB offset 0), E=$20 (32 bytes).
2297  BA53              ;   Out: directory record holding this entry written back to disk.  Clobbers: A,B,C,D,E,H,L,flags.
2298  BA53              ;   Algorithm: set up a full-32-byte copy at FCB offset 0 and fall into FCB_COPY_TO_DIR.
2299  BA53              ;   [RE]
2300  BA53              ; ----------------------------------------------------------------------
2301  BA53              FCB_WRITE_DIR_ENTRY:
2302  BA53 0E 00                LD C,$00
2303  BA55 1E 20                LD E,$20
2304  BA57              ; ----------------------------------------------------------------------
2305  BA57              ; FCB_COPY_TO_DIR -- copy E FCB bytes (from offset C) into the matched directory entry.
2306  BA57              ;   In: C = FCB byte offset; E = byte count; current FCB at $DF11; current matched dir entry.
2307  BA57              ;   Out: directory buffer updated, then the record written via FCB_FLUSH_DIR.  Clobbers: A,B,C,D,E,H,L,flags.
2308  BA57              ;   Algorithm: form a source pointer at FCB+C ($DF11 + C), point HL at the directory entry slot
2309  BA57              ;       (FCB_BUF_PTR_ADD_OFFSET), block-copy E bytes, then fall into FCB_FLUSH_DIR to commit the record.
2310  BA57              ;   [RE]
2311  BA57              ; ----------------------------------------------------------------------
2312  BA57              FCB_COPY_TO_DIR:
2313  BA57 D5                   PUSH DE
2314  BA58 06 00                LD B,$00
2315  BA5A 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2316  BA5D 09                   ADD HL,BC
2317  BA5E EB                   EX DE,HL
2318  BA5F CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2319  BA62 C1                   POP BC
2320  BA63 06 00                LD B,$00
2321  BA65 EB                   EX DE,HL
2322  BA66 ED B0                LDIR
2323  BA68              ; ----------------------------------------------------------------------
2324  BA68              ; FCB_FLUSH_DIR -- position to the directory record and write it back.
2325  BA68              ;   In: current directory record state from the preceding match.  Out: the directory record written to disk.
2326  BA68              ;   Clobbers: A,B,C,D,E,H,L,flags.
2327  BA68              ;   Algorithm: REC_DIV4_SETUP positions on the 128-byte record holding the entry, then tail-jump to
2328  BA68              ;       DIR_RECORD_WRITE.
2329  BA68              ;   [RE]
2330  BA68              ; ----------------------------------------------------------------------
2331  BA68              FCB_FLUSH_DIR:
2332  BA68 CD 43 B6             CALL REC_DIV4_SETUP
2333  BA6B C3 3C B8             JP DIR_RECORD_WRITE
2334  BA6E              ; ----------------------------------------------------------------------
2335  BA6E              ; F_RENAME_HND -- rename a file: replace matching directory entries with the new name (worker for BDOS fn 23).
2336  BA6E              ;   In: current FCB at $DF11 whose bytes 0..15 are the old name and bytes 16..31 the new name.
2337  BA6E              ;   Out: every matching directory entry rewritten with the new name; read-only entries rejected.
2338  BA6E              ;   Clobbers: A,B,C,D,E,H,L,flags.
2339  BA6E              ;   Algorithm: CHECK_DRIVE_READONLY, DIR_SEARCH_FIRST on 12 bytes of the old name, copy the FCB drive
2340  BA6E              ;       byte (offset 0) into the new-name half (offset 16) so both target the same drive, then loop:
2341  BA6E              ;       R/O-test each match and FCB_COPY_TO_DIR of 12 bytes from FCB offset $10 into the entry.
2342  BA6E              ;   [RE] CP/M 2.2 F_RENAME.
2343  BA6E              ; ----------------------------------------------------------------------
2344  BA6E              F_RENAME_HND:
2345  BA6E CD C3 B7             CALL CHECK_DRIVE_READONLY
2346  BA71 0E 0C                LD C,$0C
2347  BA73 CD 80 B9             CALL DIR_SEARCH_FIRST
2348  BA76 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2349  BA79 7E                   LD A,(HL)
2350  BA7A 11 10 00             LD DE,$0010
2351  BA7D 19                   ADD HL,DE
2352  BA7E 77                   LD (HL),A
2353  BA7F              F_RENAME_LOOP:
2354  BA7F CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2355  BA82 C8                   RET Z
2356  BA83 CD B3 B7             CALL FCB_RO_FLAG_TEST
2357  BA86 0E 10                LD C,$10
2358  BA88 1E 0C                LD E,$0C
2359  BA8A CD 57 BA             CALL FCB_COPY_TO_DIR
2360  BA8D CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
2361  BA90 18 ED                JR F_RENAME_LOOP
2362  BA92              ; ----------------------------------------------------------------------
2363  BA92              ; F_ATTRIB_HND -- set file attributes from the FCB into matching directory entries (worker for BDOS fn 30).
2364  BA92              ;   In: current FCB at $DF11 carrying the attribute high bits in the name/type bytes.
2365  BA92              ;   Out: every matching directory entry's first 12 bytes rewritten with the FCB's attribute bits.
2366  BA92              ;   Clobbers: A,B,C,D,E,H,L,flags.
2367  BA92              ;   Algorithm: DIR_SEARCH_FIRST on 12 bytes, then loop FCB_COPY_TO_DIR of the 12 name/type bytes (with
2368  BA92              ;       attribute high bits) from FCB offset 0 into each matched entry and write the record.
2369  BA92              ;   [RE] CP/M 2.2 F_ATTRIB.
2370  BA92              ; ----------------------------------------------------------------------
2371  BA92              F_ATTRIB_HND:
2372  BA92 0E 0C                LD C,$0C
2373  BA94 CD 80 B9             CALL DIR_SEARCH_FIRST
2374  BA97              F_ATTRIB_LOOP:
2375  BA97 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2376  BA9A C8                   RET Z
2377  BA9B 0E 00                LD C,$00
2378  BA9D 1E 0C                LD E,$0C
2379  BA9F CD 57 BA             CALL FCB_COPY_TO_DIR
2380  BAA2 CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
2381  BAA5 18 F0                JR F_ATTRIB_LOOP
2382  BAA7              ; ----------------------------------------------------------------------
2383  BAA7              ; FILE_OPEN_SEARCH -- search-first for the FCB's extent and merge the directory entry into the FCB.
2384  BAA7              ;   In: current FCB at $DF11. Core of BDOS_F_OPEN (fn 15) and the random-record extent-positioning path.
2385  BAA7              ;   Out: on match, the matched entry is merged into the FCB (record-count fields filled, FILE_SIZE_FROM_EXTENT);
2386  BAA7              ;        on no match returns Z with no merge.  Clobbers: A,B,C,D,E,H,L,flags.
2387  BAA7              ;   Algorithm: DIR_SEARCH_FIRST on 15 bytes (name+type+extent); CUR_RECORD_BYTES_EQUAL; if not found
2388  BAA7              ;       return Z; otherwise fall through into FILE_SIZE_FROM_EXTENT to copy the entry into the FCB and set the
2389  BAA7              ;       record count.
2390  BAA7              ;   [RE] CP/M 2.2 F_OPEN core / extent locate-and-merge.
2391  BAA7              ; ----------------------------------------------------------------------
2392  BAA7              FILE_OPEN_SEARCH:
2393  BAA7 0E 0F                LD C,$0F
2394  BAA9 CD 80 B9             CALL DIR_SEARCH_FIRST
2395  BAAC CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2396  BAAF C8                   RET Z
2397  BAB0              ; ----------------------------------------------------------------------
2398  BAB0              ; FILE_SIZE_FROM_EXTENT -- merge a matched directory entry into the FCB and update its record count.
2399  BAB0              ;   In: HL positioned via FCB_PTR_EXTENT on the FCB extent byte; current FCB at $DF11; the matched dir entry.
2400  BAB0              ;   Out: the 32-byte entry copied into the FCB image; the FCB's record-count byte (offset $0F) set to $00
2401  BAB0              ;        if this extent is below the current one, RC if equal, $80 if above; S2 'written' bit set.
2402  BAB0              ;   Clobbers: A,B,C,D,E,H,L,flags.
2403  BAB0              ;   Algorithm: save the FCB extent byte; FCB_BUF_PTR_ADD_OFFSET -> the dir entry; LDIR 32 bytes into the
2404  BAB0              ;       FCB (BDOS_PARAM_PTR); MARK_FCB_S2_HIGHBIT; read dir-entry EX (offset $0C) and RC (offset $0F), compare
2405  BAB0              ;       against the saved FCB extent, and store the chosen record-count byte at FCB+$0F.
2406  BAB0              ;   [RE] used by both F_OPEN (FILE_OPEN_SEARCH) and F_SIZE. Twin of the 44K FILE_SIZE_FROM_EXTENT.
2407  BAB0              ; ----------------------------------------------------------------------
2408  BAB0              FILE_SIZE_FROM_EXTENT:
2409  BAB0 CD 1C B7             CALL FCB_PTR_EXTENT
2410  BAB3 7E                   LD A,(HL)
2411  BAB4 F5                   PUSH AF
2412  BAB5 E5                   PUSH HL
2413  BAB6 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2414  BAB9 ED 5B 11 DF          LD DE,(BDOS_PARAM_PTR)
2415  BABD 01 20 00             LD BC,$0020
2416  BAC0 D5                   PUSH DE
2417  BAC1 ED B0                LDIR
2418  BAC3 CD F1 B7             CALL MARK_FCB_S2_HIGHBIT
2419  BAC6 D1                   POP DE
2420  BAC7 21 0C 00             LD HL,$000C
2421  BACA 19                   ADD HL,DE
2422  BACB 4E                   LD C,(HL)
2423  BACC 21 0F 00             LD HL,$000F
2424  BACF 19                   ADD HL,DE
2425  BAD0 46                   LD B,(HL)
2426  BAD1 E1                   POP HL
2427  BAD2 F1                   POP AF
2428  BAD3 77                   LD (HL),A
2429  BAD4 79                   LD A,C
2430  BAD5 BE                   CP (HL)
2431  BAD6 78                   LD A,B
2432  BAD7 28 06                JR Z,FILE_SIZE_STORE
2433  BAD9 3E 00                LD A,$00
2434  BADB 38 02                JR C,FILE_SIZE_STORE
2435  BADD 3E 80                LD A,$80
2436  BADF              FILE_SIZE_STORE:
2437  BADF 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2438  BAE2 11 0F 00             LD DE,$000F
2439  BAE5 19                   ADD HL,DE
2440  BAE6 77                   LD (HL),A
2441  BAE7 C9                   RET
2442  BAE8              ; ----------------------------------------------------------------------
2443  BAE8              ; FCB_WORD_FILL_IF_ZERO -- copy a 16-bit word from (DE) to (HL) only when (HL) is currently zero.
2444  BAE8              ;   In: HL -> destination word; DE -> source word.
2445  BAE8              ;   Out: if the destination word was 0, it is overwritten with the source word; DE,HL preserved.  Clobbers: A,flags.
2446  BAE8              ;   Algorithm: OR the two destination bytes; if non-zero return unchanged; otherwise copy both source
2447  BAE8              ;       bytes across, restoring DE/HL to their entry values.
2448  BAE8              ;   [RE] allocation-word merge helper used during F_CLOSE_HND.
2449  BAE8              ; ----------------------------------------------------------------------
2450  BAE8              FCB_WORD_FILL_IF_ZERO:
2451  BAE8 7E                   LD A,(HL)
2452  BAE9 23                   INC HL
2453  BAEA B6                   OR (HL)
2454  BAEB 2B                   DEC HL
2455  BAEC C0                   RET NZ
2456  BAED 1A                   LD A,(DE)
2457  BAEE 77                   LD (HL),A
2458  BAEF 13                   INC DE
2459  BAF0 23                   INC HL
2460  BAF1 1A                   LD A,(DE)
2461  BAF2 77                   LD (HL),A
2462  BAF3 1B                   DEC DE
2463  BAF4 2B                   DEC HL
2464  BAF5 C9                   RET
2465  BAF6              ; ----------------------------------------------------------------------
2466  BAF6              ; F_CLOSE_HND -- close a file: merge the in-memory FCB into its directory entry (worker for BDOS fn 16).
2467  BAF6              ;   In: current FCB at $DF11. Also used internally to flush an extent.
2468  BAF6              ;   Out: directory entry updated with this FCB's allocation map / record count; result byte (BDOS_RETVAL) set.
2469  BAF6              ;   Clobbers: A,B,C,D,E,H,L,flags.
2470  BAF6              ;   Algorithm: zero the result byte (BDOS_RETVAL) and record state, verify the drive is selected (DRIVE_BIT_TEST)
2471  BAF6              ;       and the FCB S2 high bit is clear; DIR_SEARCH_FIRST on the extent (15 bytes); if found, merge the
2472  BAF6              ;       FCB's 16-byte allocation map into the entry (filling zero words via FCB_WORD_FILL_IF_ZERO, keeping
2473  BAF6              ;       the larger record count) then flush (FCB_FLUSH_DIR).
2474  BAF6              ;   [RE] CP/M 2.2 F_CLOSE.
2475  BAF6              ; ----------------------------------------------------------------------
2476  BAF6              F_CLOSE_HND:
2477  BAF6 AF                   XOR A
2478  BAF7 32 13 DF             LD (BDOS_RETVAL),A
2479  BAFA 32 F7 BF             LD (CUR_RECORD),A
2480  BAFD 32 F8 BF             LD (CUR_RECORD_HI),A
2481  BB00 CD 8D B7             CALL DRIVE_BIT_TEST
2482  BB03 C0                   RET NZ
2483  BB04 CD D8 B7             CALL FCB_GET_S2
2484  BB07 E6 80                AND $80
2485  BB09 C0                   RET NZ
2486  BB0A 0E 0F                LD C,$0F
2487  BB0C CD 80 B9             CALL DIR_SEARCH_FIRST
2488  BB0F CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2489  BB12 C8                   RET Z
2490  BB13 01 10 00             LD BC,$0010
2491  BB16 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2492  BB19 09                   ADD HL,BC
2493  BB1A EB                   EX DE,HL
2494  BB1B 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2495  BB1E 09                   ADD HL,BC
2496  BB1F 0E 10                LD C,$10
2497  BB21              FCB_MERGE_MAP_LOOP:
2498  BB21 3A EA BF             LD A,(BLOCK_WIDTH_FLAG)
2499  BB24 B7                   OR A
2500  BB25 28 10                JR Z,FCB_MERGE_WORD
2501  BB27 7E                   LD A,(HL)
2502  BB28 B7                   OR A
2503  BB29 1A                   LD A,(DE)

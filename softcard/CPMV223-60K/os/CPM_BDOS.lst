  14  0000              ;
  15  0000              ; ===========================================================================
  16  0000              ; 60K BDOS  -- CP/M 2.2 BDOS adapted to the Apple II Language Card (LC)
  17  0000              ; ===========================================================================
  18  0000              ; This is the standard CP/M 2.2 BDOS (serial BD16000 / 14D40, identical to the
  19  0000              ; 44K sysimg_223 BDOS) but RELOCATED and BANK-WOVEN for the 60K LC system.
  20  0000              ;
  21  0000              ; STRUCTURE (standard CP/M 2.2 BDOS layout, all present):
  22  0000              ;   $DC00  BD 16 00 01 4D 40   serial number (== 44K BDOS, unchanged)
  23  0000              ;   $DC06  C3 11 DC            JP BDOS_ENTRY   = BDOS primary entry (== 44K JP $9C11)
  24  0000              ;   $DC09  jump/vector quad ($DCA5,$DCB2,$DCB7,$DCBC)
  25  0000              ;   $DC11  dispatch preamble (see DELTA below)
  26  0000              ;   $DC53  41-entry function-pointer table (BDOS funcs 0..40 / $00..$28)
  27  0000              ;   ...    FCB / file primitives, directory, disk I/O, console redirection.
  28  0000              ;
  29  0000              ; LANGUAGE-CARD WINDOW MAP (running system):
  30  0000              ;   Z-80 $Bxxx..$DFFF  -> Apple $Dxxx..$FFFF  (the 16K Language Card)
  31  0000              ;     so Z-80 $DCxx -> Apple $FCxx (UPPER LC),  Z-80 $Bxxx -> Apple $Dxxx (LOWER LC)
  32  0000              ;   Z-80 $E08B/$E083   -> Apple $C08B/$C083    (LC soft-switches in the I/O window)
  33  0000              ;     $C08B = read-RAM / write-RAM, bank1     $C083 = read-RAM / write-RAM, bank2
  34  0000              ;
  35  0000              ; THE SPLIT (dispatch table at $DC53, 41 entries):
  36  0000              ;   - 11 funcs live in the UPPER LC at $DCxx-$DFxx  (Apple $FCxx-$FFxx) -- the
  37  0000              ;     same window the dispatcher itself occupies; these are the BIOS-adjacent
  38  0000              ;     console/line-edit/search helpers.
  39  0000              ;   -  3 entries are delegated straight to the BIOS at $FA03/$FA0F/$FA12
  40  0000              ;     (WBOOT + 2 console BIOS calls).
  41  0000              ;   - 27 funcs live in the LOWER LC at $Bxxx (Apple $Dxxx) -- the bulk of the
  42  0000              ;     FCB/file/directory/disk machinery was relocated DOWN into the lower bank.
  43  0000              ;   BDOS scratch/zero-page-equivalent variables sit at $BFxx (Apple $DFxx);
  44  0000              ;     referenced ~130 times across the body.
  45  0000              ;
  46  0000              ; LANGUAGE-CARD BANK-SWITCH ACCESSES (13 total, all WRITES; no ROM-read modes):
  47  0000              ;   $DC11  LD ($E08B),A   entry: bank-in LC (Apple $C08B)
  48  0000              ;   $DC3F  LD ($E083),A   funcs <12: select bank2 (Apple $C083)
  49  0000              ;   $DD5B  LD ($E08B),A   $DD64  LD ($E083),A   (helper bank flip)
  50  0000              ;   $DF1C/$DF20/$DF28     LD ($E083),A   (lower-LC trampoline glue)
  51  0000              ;   $DF36  LD ($E08B),A   $DF3C  LD ($E083),A
  52  0000              ;   $DF41/$DF45  LD ($E08B),A           (epilogue: bank-out / restore on exit)
  53  0000              ;   $DF63  LD ($E083),A   $DF81  LD ($E083),A
  54  0000              ;   => 5x $E08B (Apple $C08B), 8x $E083 (Apple $C083).
  55  0000              ;
  56  0000              ; DISPATCH-PREAMBLE DELTA vs 44K BDOS (sysimg_223 off 0xD00, entry $9C11):
  57  0000              ;   44K $9C11:  EB            EX DE,HL
  58  0000              ;               22 43 9F      LD ($9F43),HL    ; save DE param, NO banking
  59  0000              ;               ... 32 E0 A9 / 32 DE A9        ; plain RAM scratch ($A9xx)
  60  0000              ;   60K $DC11:  32 8B E0      LD ($E08B),A     ; <-- inserted LC BANK-IN first
  61  0000              ;               ED 53 11 DF   LD (BDOS_PARAM_PTR),DE    ; save DE param (LC scratch)
  62  0000              ;               32 E3 BF      LD (DRV_SELECT_ARG),A     ; mirror to lower-LC scratch
  63  0000              ;               ... 31 0F DF  LD SP,BDOS_USER_NUM      ; private stack in LC
  64  0000              ;               21 45 DF / E5 PUSH $DF45       ; return -> bank-OUT epilogue
  65  0000              ;               FE 0C / 32 83 E0  (func<12) LD ($E083),A  ; bank2 select
  66  0000              ;   Both keep the SAME func-count guard (CP $29 = 41 functions) and the same
  67  0000              ;   table-indexed JP (HL).  The 60K version simply wraps every call in a
  68  0000              ;   bank-in (entry) / bank-out ($DF45 epilogue) envelope and scatters the body
  69  0000              ;   across the two LC banks; the 44K version runs entirely in flat RAM.
  70  0000              ; ===========================================================================
  71  0000
  72  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
  73  0000                  DEVICE NOSLOT64K
  74  0000                  INCLUDE "cpm22.inc"          ; CP/M 2.2 ABI + the DIRECTORY_ENTRY / FCB structures
# file opened: cpm22.inc
   1+ 0000              ; cpm22.inc -- canonical Digital Research CP/M 2.2 definitions shared by SoftCard
   2+ 0000              ; CP/M sources.  Defined ONCE here and INCLUDEd by each source rather than re-deriving
   3+ 0000              ; magic numbers per file.  EQUs are zero-width, so including this is byte-identical.
   4+ 0000              ; This is the OS/ABI counterpart to apple_softcard.inc (which holds the Apple/SoftCard
   5+ 0000              ; HARDWARE externals); keep the two concerns separate.
   6+ 0000              ;
   7+ 0000              ; Source: CP/M 2.2 Interface Guide / "CP/M Reference Manual" [DOC CPMREF] (in the
   8+ 0000              ; archive at softcard/reference/softcard-cpm-archive/manuals/transcribed/).
   9+ 0000              ;
  10+ 0000              ; NOTE on the base page: $0000 (warm-boot JP) and $0005 (BDOS JP) are implementation
  11+ 0000              ; LABELS inside the BIOS/CCP/BDOS modules but CALL TARGETS in transient programs.  The
  12+ 0000              ; cell EQUs below are for the transient-program (caller) view; an OS module that DEFINES
  13+ 0000              ; these vectors as its own labels should not also pull in this base-page section.
  14+ 0000
  15+ 0000              ; ---- base page (transient-program view) ----------------------------------------
  16+ 0000                  IFNDEF CPM22_INC
  17+ 0000                  DEFINE CPM22_INC
  18+ 0000
  19+ 0000              WBOOTV      EQU $0000      ; warm-boot vector: JP WBOOT (a CALL/JP $0000 restarts CP/M)
  20+ 0000              IOBYTE_ADDR EQU $0003      ; [DOC S&HD 2-18] logical<->physical device map: four 2-bit
  21+ 0000                                         ;   fields, CONSOLE (0-1), READER (2-3), PUNCH (4-5), LIST
  22+ 0000                                         ;   (6-7); set via STAT or BDOS fns 7/8. Each field selects
  23+ 0000                                         ;   which I/O Vector Table entry (#1 or #2) is used.
  24+ 0000              CDISK_ADDR  EQU $0004      ; current drive (low nibble) / user (high nibble)
  25+ 0000              BDOS        EQU $0005      ; BDOS entry vector: CALL BDOS with C=function, DE=arg
  26+ 0000              RST2_VEC    EQU $0010      ; Z-80 RST 2 ($10) restart vector (8 bytes); CP/M leaves it for the app/debugger
  27+ 0000              RST4_VEC    EQU $0020      ; Z-80 RST 4 ($20) restart vector (8 bytes); CP/M leaves it for the app/debugger
  28+ 0000              TFCB        EQU $005C      ; default FCB parsed from the command tail
  29+ 0000              TFCB2       EQU $006C      ; second parsed FCB (overlaps TFCB+16)
  30+ 0000              TBUFF       EQU $0080      ; default DMA buffer (128 B); also the command-tail buffer
  31+ 0000              CMDLINE     EQU $0081      ; command-tail characters (TBUFF+1): $0080 = length, $0081+ = the upper-cased tail
  32+ 0000              TPA         EQU $0100      ; transient program area / load address
  33+ 0000
  34+ 0000              ; ---- BDOS function numbers (register C) ----------------------------------------
  35+ 0000              P_TERMCPM   EQU 0          ; [DOC CPMREF "System Reset"] system reset (return to CCP)
  36+ 0000              C_READ      EQU 1          ; [DOC CPMREF "CONSOLE INPUT"] console input (echoed) -> A
  37+ 0000              C_WRITE     EQU 2          ; [DOC CPMREF "CONSOLE OUTPUT"] console output (E = char)
  38+ 0000              A_READ      EQU 3          ; [DOC CPMREF "READER INPUT"] reader (AUX) input -> A
  39+ 0000              A_WRITE     EQU 4          ; [DOC CPMREF "PUNCH OUTPUT"] punch (AUX) output (E = char)
  40+ 0000              L_WRITE     EQU 5          ; [DOC CPMREF "LIST OUTPUT"] list (printer) output (E = char)
  41+ 0000              C_RAWIO     EQU 6          ; [DOC CPMREF "DIRECT CONSOLE I/O"] direct console I/O (E=$FF read / else write)
  42+ 0000              A_STATIN    EQU 7          ; [DOC CPMREF "GET I/O BYTE"] get IOBYTE -> A
  43+ 0000              A_STATOUT   EQU 8          ; [DOC CPMREF "SET I/O BYTE"] set IOBYTE (E = value)
  44+ 0000              C_WRITESTR  EQU 9          ; [DOC CPMREF "PRINT STRING"] print '$'-terminated string (DE -> string)
  45+ 0000              C_READSTR   EQU 10         ; [DOC CPMREF "READ CONSOLE BUFFER"] buffered console line input (DE -> buffer)
  46+ 0000              C_STAT      EQU 11         ; [DOC CPMREF "GET CONSOLE STATUS"] console status -> A (0 = none ready)
  47+ 0000              S_BDOSVER   EQU 12         ; [DOC CPMREF "RETURN VERSION NUMBER"] return BDOS version -> HL
  48+ 0000              DRV_ALLRESET EQU 13        ; [DOC CPMREF "RESET DISK SYSTEM"] reset disk system
  49+ 0000              DRV_SET     EQU 14         ; [DOC CPMREF "SELECT DISK"] select drive (E = 0=A..15=P)
  50+ 0000              F_OPEN      EQU 15         ; [DOC CPMREF "OPEN FILE"] open file (DE -> FCB)
  51+ 0000              F_CLOSE     EQU 16         ; [DOC CPMREF "CLOSE FILE"] close file (DE -> FCB)
  52+ 0000              F_SFIRST    EQU 17         ; [DOC CPMREF "SEARCH FOR FIRST"] search for first (DE -> FCB)
  53+ 0000              F_SNEXT     EQU 18         ; [DOC CPMREF "SEARCH FOR NEXT"] search for next
  54+ 0000              F_DELETE    EQU 19         ; [DOC CPMREF "DELETE FILE"] delete file (DE -> FCB)
  55+ 0000              F_READ      EQU 20         ; [DOC CPMREF "READ SEQUENTIAL"] read sequential (DE -> FCB)
  56+ 0000              F_WRITE     EQU 21         ; [DOC CPMREF "WRITE SEQUENTIAL"] write sequential (DE -> FCB)
  57+ 0000              F_MAKE      EQU 22         ; [DOC CPMREF "MAKE FILE"] create file (DE -> FCB)
  58+ 0000              F_RENAME    EQU 23         ; [DOC CPMREF "RENAME FILE"] rename file (DE -> FCB)
  59+ 0000              DRV_LOGINVEC EQU 24        ; [DOC CPMREF "RETURN LOGIN VECTOR"] return login vector -> HL
  60+ 0000              DRV_GET     EQU 25         ; [DOC CPMREF "RETURN CURRENT DISK"] return current drive -> A
  61+ 0000              F_DMAOFF    EQU 26         ; [DOC CPMREF "SET DMA ADDRESS"] set DMA address (DE)
  62+ 0000              DRV_ALLOCVEC EQU 27        ; [DOC CPMREF "GET ADDR (ALLOC)"] return allocation vector -> HL
  63+ 0000              DRV_SETRO   EQU 28         ; [DOC CPMREF "WRITE PROTECT DISK"] write-protect current drive
  64+ 0000              DRV_ROVEC   EQU 29         ; [DOC CPMREF "GET READ/ONLY VECTOR"] return read-only vector -> HL
  65+ 0000              F_ATTRIB    EQU 30         ; [DOC CPMREF "SET FILE ATTRIBUTES"] set file attributes (DE -> FCB)
  66+ 0000              DRV_DPB     EQU 31         ; [DOC CPMREF "GET ADDR (DISK PARMS)"] return DPB address -> HL
  67+ 0000              F_USERNUM   EQU 32         ; [DOC CPMREF "SET/GET USER CODE"] get/set user number (E=$FF get / else set)
  68+ 0000              F_READRAND  EQU 33         ; [DOC CPMREF "READ RANDOM"] read random (DE -> FCB)
  69+ 0000              F_WRITERAND EQU 34         ; [DOC CPMREF "WRITE RANDOM"] write random (DE -> FCB)
  70+ 0000              F_SIZE      EQU 35         ; [DOC CPMREF "COMPUTE FILE SIZE"] compute file size (DE -> FCB)
  71+ 0000              F_RANDREC   EQU 36         ; [DOC CPMREF "SET RANDOM RECORD"] set random record (DE -> FCB)
  72+ 0000              DRV_RESET   EQU 37         ; [?] no titled entry in the bundled Reference Manual. reset drives (DE = drive vector)
  73+ 0000              F_WRITEZF   EQU 40         ; [?] no titled entry in the bundled Reference Manual. write random with zero fill (DE -> FCB)

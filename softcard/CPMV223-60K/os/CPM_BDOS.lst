  77  0000              ; -- External symbols --
  78  0000              ; WBOOTV and IOBYTE_ADDR come from cpm22.inc, the single source of truth for the CP/M base
  79  0000              ; page. They used to be re-declared here with identical values; the fuller IOBYTE wording
  80  0000              ; that lived here, including its [DOC S&HD 2-18] citation, now lives in the header.
  81  0000              WBOOT                EQU $FA03               ; BIOS entry 1  -- warm boot (on SoftCard 2.23: jumps to $FAB8)
  82  0000              CONST                EQU $FA06               ; BIOS entry 2  -- console status
  83  0000              CONIN                EQU $FA09               ; BIOS entry 3  -- console input
  84  0000              CONOUT               EQU $FA0C               ; BIOS entry 4  -- console output
  85  0000              LIST                 EQU $FA0F               ; BIOS entry 5  -- printer (LIST device) output
  86  0000              PUNCH                EQU $FA12               ; BIOS entry 6  -- punch device output
  87  0000              READER               EQU $FA15               ; BIOS entry 7  -- reader device input
  88  0000              HOME                 EQU $FA18               ; BIOS entry 8  -- seek drive to track 0
  89  0000              SELDSK               EQU $FA1B               ; BIOS entry 9  -- select drive, returns its DPH
  90  0000              SETTRK               EQU $FA1E               ; BIOS entry 10 -- set track for the next access
  91  0000              SETSEC               EQU $FA21               ; BIOS entry 11 -- set sector for the next access
  92  0000              SETDMA               EQU $FA24               ; BIOS entry 12 -- set the DMA (transfer) address
  93  0000              READ                 EQU $FA27               ; BIOS entry 13 -- read one 128-byte record
  94  0000              WRITE                EQU $FA2A               ; BIOS entry 14 -- write one 128-byte record
  95  0000              SECTRAN              EQU $FA30               ; BIOS entry 16 -- logical-to-physical sector translate
  96  0000              ; -- Language-Card bank-select soft switches (Z-80 $E08x -> Apple $C08x I/O window) --
  97  0000              LC_BANK1             EQU $E08B               ; select LC read/write RAM, bank 1 (Apple $C08B)
  98  0000              LC_BANK2             EQU $E083               ; select LC read/write RAM, bank 2 (Apple $C083)
  99  0000
 100  0000                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
 101  0000                  ORG $DC00
 102  DC00                  ELSE
 103  DC00 ~                DISP $DC00         ; linked: upper-bank labels at run $DC00, emit at the master's file pos
 104  DC00                  ENDIF
 105  DC00
 106  DC00              BDOS_IMAGE_HEADER:
 107  DC00 BD                   CP L
 108  DC01 16 00                LD D,$00
 109  DC03 01 4D 40             LD BC,$404D
 110  DC06 C3 11 DC             JP BDOS_ENTRY
 111  DC09 A5 DC                DEFW    BDOS_ERROR
 112  DC0B B2 DC B7 DC          DEFB    $B2,$DC,$B7,$DC,$BC,$DC
 112  DC0F BC DC
 113  DC11              ; [DOC CPMREF 3-44] BDOS primary entry. Callers reach it via the JP at $0005 (the word at $0006 is
 114  DC11              ;       this entry / top of TPA). Function # is in C and the info address (or single byte) in DE/E.
 115  DC11              ;       Per the manual the BDOS switches to its own local stack on each call (here BDOS_USER_NUM), and
 116  DC11              ;       a zero value is returned when the function number is out of range. The LC_RDWR_* bank
 117  DC11              ;       accesses and LC scratch ($BFxx) are this 60K build's Language-Card wrapper, not manual facts.
 118  DC11              BDOS_ENTRY:
 119  DC11 32 8B E0             LD (LC_BANK1),A
 120  DC14 ED 53 11 DF          LD (BDOS_PARAM_PTR),DE           ; save the DE info-address parameter
 121  DC18 7B                   LD A,E
 122  DC19 32 E3 BF             LD (DRV_SELECT_ARG),A
 123  DC1C 21 00 00             LD HL,WBOOTV
 124  DC1F 22 13 DF             LD (BDOS_RETVAL),HL              ; pre-seed return value = 0 (out-of-range default)
 125  DC22 ED 73 DD DE          LD (BDOS_SAVED_SP),SP            ; save caller's stack pointer
 126  DC26 31 0F DF             LD SP,BDOS_USER_NUM             ; switch to the BDOS local stack
 127  DC29 AF                   XOR A
 128  DC2A 32 ED BF             LD (DRV_SAVED_FCB_BYTE),A
 129  DC2D 32 EB BF             LD (DRV_RESTORE_FLAG),A
 130  DC30 32 87 DF             LD (DEFERRED_COPY_FLAG),A
 131  DC33 21 45 DF             LD HL,BDOS_BANK_OUT_EPILOG
 132  DC36 E5                   PUSH HL
 133  DC37 79                   LD A,C                           ; 79    A = function number
 134  DC38 FE 29                CP $29                           ; range check (41 dispatch entries; CP/M 2.2 defines 0-36)
 135  DC3A D0                   RET NC                           ; D0    out of range -> return the pre-seeded zero
 136  DC3B FE 0C                CP $0C
 137  DC3D 30 03                JR NC,BDOS_ENTRY_1
 138  DC3F 32 83 E0             LD (LC_BANK2),A
 139  DC42              BDOS_ENTRY_1:
 140  DC42 4B                   LD C,E
 141  DC43 21 53 DC             LD HL,BDOS_DISPATCH_TBL
 142  DC46 5F                   LD E,A
 143  DC47 16 00                LD D,$00
 144  DC49 19                   ADD HL,DE
 145  DC4A 19                   ADD HL,DE
 146  DC4B 5E                   LD E,(HL)
 147  DC4C 23                   INC HL
 148  DC4D 56                   LD D,(HL)
 149  DC4E 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
 150  DC51 EB                   EX DE,HL
 151  DC52 E9                   JP (HL)
 152  DC53              ; [DOC CPMREF 3-44/3-76] BDOS function-pointer dispatch table, indexed by the function
 153  DC53              ;       number passed in C (entry N = function N, two bytes each). The CP/M 2.2 BDOS defines
 154  DC53              ;       functions 0-36 ($00-$24); entries 37-40 ($25-$28) have no manual-defined function in
 155  DC53              ;       CP/M 2.2 (the 41-entry / CP $29 guard is this 60K build's table size, not a manual fact).
 156  DC53              ;       Call convention: function # in C, info address (or single byte) in DE/E; byte results
 157  DC53              ;       in A, word results in HL, with A=L and B=H on return.
 158  DC53              BDOS_DISPATCH_TBL:
 159  DC53 03 FA                DEFW    WBOOT                    ; fn 0  System Reset (warm boot; re-login drive A)
 160  DC55 9C DE                DEFW    F_CONIN_H                ; fn 1  Console Input  -> A=char (echoed)
 161  DC57 7D DD                DEFW    F_CONOUT_H               ; fn 2  Console Output (E=char; expands tabs)
 162  DC59 A1 DE                DEFW    F_READERIN_H             ; fn 3  Reader Input (RDR:) -> A=char
 163  DC5B 12 FA                DEFW    PUNCH                    ; fn 4  Punch Output (PUN:; E=char)
 164  DC5D 0F FA                DEFW    LIST                     ; fn 5  List Output (LST:; E=char)
 165  DC5F A6 DE                DEFW    F_DIRECTIO_H             ; fn 6  Direct Console I/O (E=$FF in / char out; raw)
 166  DC61 BD DE                DEFW    F_GETIOB_H               ; fn 7  Get I/O Byte -> A=IOBYTE_ADDR ($0003)
 167  DC63 C2 DE                DEFW    F_SETIOB_H               ; fn 8  Set I/O Byte (E=IOBYTE_ADDR)
 168  DC65 C7 DE                DEFW    F_PRINTSTR_H             ; fn 9  Print String (DE='$'-terminated)
 169  DC67 C9 DD                DEFW    F_READCONBUF_H           ; fn 10 Read Console Buffer (DE=buffer; line editor)
 170  DC69 CD DE                DEFW    F_CONSTAT_H              ; fn 11 Get Console Status -> A=$FF/$00
 171  DC6B A3 BE                DEFW    $BEA3                    ; fn 12 Return Version Number -> HL ($0022 for 2.2)
 172  DC6D A8 BE                DEFW    $BEA8                    ; fn 13 Reset Disk System (all R/W, select A, DMA=$0080)
 173  DC6F 47 BE                DEFW    $BE47                    ; fn 14 Select Disk (E=0..15 = A..P)
 174  DC71 C0 BE                DEFW    $BEC0                    ; fn 15 Open File (DE=FCB) -> A=dir code/$FF
 175  DC73 C6 BE                DEFW    $BEC6                    ; fn 16 Close File (DE=FCB) -> A=dir code/$FF
 176  DC75 CC BE                DEFW    $BECC                    ; fn 17 Search for First (DE=FCB) -> A=dir code
 177  DC77 EB BE                DEFW    $BEEB                    ; fn 18 Search for Next -> A=dir code (255=no more)
 178  DC79 FC BE                DEFW    $BEFC                    ; fn 19 Delete File (DE=FCB) -> A=dir code/255
 179  DC7B 05 BF                DEFW    $BF05                    ; fn 20 Read Sequential (DE=FCB) -> A=err (0 ok)
 180  DC7D 0B BF                DEFW    $BF0B                    ; fn 21 Write Sequential (DE=FCB) -> A=err (0 ok)
 181  DC7F 11 BF                DEFW    $BF11                    ; fn 22 Make File (DE=FCB) -> A=dir code/$FF
 182  DC81 17 BF                DEFW    $BF17                    ; fn 23 Rename File (DE=FCB) -> A=dir code/$FF
 183  DC83 20 BF                DEFW    $BF20                    ; fn 24 Return Login Vector -> HL=login bit-vector
 184  DC85 25 BF                DEFW    $BF25                    ; fn 25 Return Current Disk -> A=current disk (0-15)
 185  DC87 2B BF                DEFW    $BF2B                    ; fn 26 Set DMA Address (DE=DMA addr; default $0080)
 186  DC89 32 BF                DEFW    $BF32                    ; fn 27 Get Addr (Alloc) -> HL=ALLOC vector base
 187  DC8B 9B B7                DEFW    $B79B                    ; fn 28 Write Protect Disk (temp R/O, current drive)
 188  DC8D 37 BF                DEFW    $BF37                    ; fn 29 Get R/O Vector -> HL=R/O bit-vector
 189  DC8F 3C BF                DEFW    $BF3C                    ; fn 30 Set File Attributes (DE=FCB; sets t1' R/O, t2' SYS)
 190  DC91 45 BF                DEFW    $BF45                    ; fn 31 Get Addr (Disk Parms) -> HL=DPB address
 191  DC93 4C BF                DEFW    $BF4C                    ; fn 32 Set/Get User Code (E=$FF get / code set)
 192  DC95 5F BF                DEFW    $BF5F                    ; fn 33 Read Random (DE=FCB) -> A=return code
 193  DC97 65 BF                DEFW    $BF65                    ; fn 34 Write Random (DE=FCB) -> A=return code (+05 dir full)
 194  DC99 6B BF                DEFW    $BF6B                    ; fn 35 Compute File Size (DE=FCB) -> r0,r1,r2 set
 195  DC9B 31 BE                DEFW    $BE31                    ; fn 36 Set Random Record (DE=FCB) -> r0,r1,r2 set
 196  DC9D 71 BF                DEFW    $BF71                    ; fn 37 -- not a CP/M 2.2 manual function (version-specific entry)
 197  DC9F D3 DE                DEFW    BDOS_RET_NOP             ; fn 38 -- not a CP/M 2.2 manual function; stub -> RET (BDOS_RET_NOP)
 198  DCA1 D3 DE                DEFW    BDOS_RET_NOP             ; fn 39 -- not a CP/M 2.2 manual function; stub -> RET (BDOS_RET_NOP)
 199  DCA3 92 BF                DEFW    $BF92                    ; fn 40 -- not a CP/M 2.2 manual function (version-specific entry)
 200  DCA5              ; [DOC CPMREF 3-36/3-37] BDOS run-time error reporter. Prints "Bdos Err On x: <error>"
 201  DCA5              ;       where x is the drive letter and <error> is one of BAD SECTOR (controller R/W error),
 202  DCA5              ;       SELECT (drive outside the valid range; reboots after console input), or R/O (write to
 203  DCA5              ;       a read-only / changed disk; warm start after console input). The error code in C
 204  DCA5              ;       selects which message: the embedded $-terminated strings are "Bdos Err On  : $" ($DCC5),
 205  DCA5              ;       "Bad Sector$" ($DCD0), "Select$" ($DCDB), "File R/O$" ($DCE2); $C6 $41 = ADD A,'A'
 206  DCA5              ;       converts the drive number to its letter.
 207  DCA5              BDOS_ERROR:
 208  DCA5 21 D5 DC CD          DEFB    $21,$D5,$DC,$CD,$F0,$DC,$FE,$03,$C2,$41,$DF,$18,$10,$21,$E0,$DC
 208  DCA9 F0 DC FE 03
 208  DCAD C2 41 DF 18
 208  DCB1 10 21 E0 DC
 209  DCB5 18 08 21 EC          DEFB    $18,$08,$21,$EC,$DC,$18,$03,$21,$E7,$DC,$CD,$F0,$DC,$C3,$00,$00
 209  DCB9 DC 18 03 21
 209  DCBD E7 DC CD F0
 209  DCC1 DC C3 00 00
 210  DCC5 42 64 6F 73          DEFB    $42,$64,$6F,$73,$20,$45,$72,$72,$20,$4F,$6E,$20,$20,$3A,$20,$24 ; "Bdos Err On  : $"
 210  DCC9 20 45 72 72
 210  DCCD 20 4F 6E 20
 210  DCD1 20 3A 20 24
 211  DCD5 42 61 64 20          DEFB    $42,$61,$64,$20,$53,$65,$63,$74,$6F,$72,$24,$53,$65,$6C,$65,$63 ; "Bad Sector$" "Selec"
 211  DCD9 53 65 63 74
 211  DCDD 6F 72 24 53
 211  DCE1 65 6C 65 63
 212  DCE5 74 24 46 69          DEFB    $74,$24,$46,$69,$6C,$65,$20,$52,$2F,$4F,$24,$E5,$CD ; "t$" "File R/O$"
 212  DCE9 6C 65 20 52
 212  DCED 2F 4F 24 E5
 212  DCF1 CD
 213  DCF2 B3 DD                DEFW    CON_CRLF
 214  DCF4 3A 10 DF C6          DEFB    $3A,$10,$DF,$C6,$41,$32,$D1,$DC,$01,$C5,$DC,$CD
 214  DCF8 41 32 D1 DC
 214  DCFC 01 C5 DC CD
 215  DD00 BC DD                DEFW    CON_PRINT_STR
 216  DD02 C1 CD                DEFB    $C1,$CD
 217  DD04 BC DD                DEFW    CON_PRINT_STR
 218  DD06              ; ----------------------------------------------------------------------
 219  DD06              ; CON_GETC_OR_RAW -- return the 1-char type-ahead if present, else read raw console input.
 220  DD06              ;   In: CON_PENDING_CHAR = pending look-ahead char (0 if none).
 221  DD06              ;   Out: A = next console character; CON_PENDING_CHAR cleared if it supplied the byte.
 222  DD06              ;   Clobbers: AF, HL.
 223  DD06              ;   Algorithm: if CON_PENDING_CHAR nonzero, consume it (write 0 back) and return; otherwise
 224  DD06              ;              tail-jump to the BIOS CONIN vector ($FA09) for a fresh key.
 225  DD06              ;   [RE] Single-byte console un-get buffer used by the line editor and F_CONIN_H. Twin of the
 226  DD06              ;        44K CON_GETC_OR_RAW (identical logic; runs in the upper LC bank here).
 227  DD06              ; ----------------------------------------------------------------------
 228  DD06              CON_GETC_OR_RAW:
 229  DD06 21 DC DE             LD HL,CON_PENDING_CHAR
 230  DD09 7E                   LD A,(HL)
 231  DD0A 36 00                LD (HL),$00
 232  DD0C B7                   OR A
 233  DD0D C0                   RET NZ
 234  DD0E C3 09 FA             JP CONIN
 235  DD11              ; ----------------------------------------------------------------------
 236  DD11              ; F_CONIN_RAW -- read one console char, echoing it unless it is a control char.
 237  DD11              ;   In: none.  Out: A = character read.  Clobbers: AF, BC, HL.
 238  DD11              ;   Algorithm: fetch a char (CON_GETC_OR_RAW); test it with LC_BANK1_CALL_ISCTRL (banks the
 239  DD11              ;              lower LC in and calls IS_CTRL_CHAR at $B5C0); on carry (unhandled control) skip
 240  DD11              ;              the echo; otherwise echo the char via F_CONOUT_H, preserving it in A.
 241  DD11              ;   [RE] Backs BDOS function 1 (Console Input with echo). Twin of the 44K F_CONIN_RAW; the
 242  DD11              ;        60K wraps the IS_CTRL_CHAR test in a bank trampoline because that helper lives in the
 243  DD11              ;        lower LC bank.
 244  DD11              ; ----------------------------------------------------------------------
 245  DD11              F_CONIN_RAW:
 246  DD11 CD 06 DD             CALL CON_GETC_OR_RAW
 247  DD14 CD 36 DF             CALL LC_BANK1_CALL_ISCTRL
 248  DD17 D8                   RET C
 249  DD18 F5                   PUSH AF
 250  DD19 4F                   LD C,A
 251  DD1A CD 7D DD             CALL F_CONOUT_H
 252  DD1D F1                   POP AF
 253  DD1E C9                   RET
 254  DD1F              ; ----------------------------------------------------------------------
 255  DD1F              ; CON_POLL_STATUS -- console-status poll that also traps Ctrl-S/Ctrl-C while idle.
 256  DD1F              ;   In: CON_PENDING_CHAR = type-ahead char (nonzero => a key is already pending).
 257  DD1F              ;   Out: A = 1 if a character is ready, 0 if not.  Clobbers: AF.
 258  DD1F              ;   Algorithm: if a char is already buffered, report ready; else call the BIOS console-status
 259  DD1F              ;              vector (CONST $FA06) and mask bit 0. If a key is down, peek it (CONIN $FA09):
 260  DD1F              ;              Ctrl-S ($13) stalls -- the follow-up key Ctrl-C ($03) warm-boots via JP 0; any
 261  DD1F              ;              other key is stashed in CON_PENDING_CHAR (CON_POLL_STASH) and reported ready.
 262  DD1F              ;   [RE] Backs the BDOS console-status / flow-control behaviour. Twin of the 44K CON_POLL_STATUS.
 263  DD1F              ; ----------------------------------------------------------------------
 264  DD1F              CON_POLL_STATUS:
 265  DD1F 3A DC DE             LD A,(CON_PENDING_CHAR)
 266  DD22 B7                   OR A
 267  DD23 20 1A                JR NZ,CON_STATUS_READY
 268  DD25 CD 06 FA             CALL CONST
 269  DD28 E6 01                AND $01
 270  DD2A              ; CON_POLL_STATUS_1 -- fall-through re-entry inside CON_POLL_STATUS: RET Z when no key is down,
 271  DD2A              ;   else read and test the pending key. Not a separate call target (dead auto-name kept local).
 272  DD2A              ;   [RE] Local of CON_POLL_STATUS.
 273  DD2A              CON_POLL_STATUS_1:
 274  DD2A C8                   RET Z
 275  DD2B CD 09 FA             CALL CONIN
 276  DD2E FE 13                CP $13
 277  DD30 20 0A                JR NZ,CON_POLL_STASH
 278  DD32 CD 09 FA             CALL CONIN
 279  DD35 FE 03                CP $03
 280  DD37 CA 00 00             JP Z,WBOOTV
 281  DD3A AF                   XOR A
 282  DD3B C9                   RET
 283  DD3C              ; ----------------------------------------------------------------------
 284  DD3C              ; CON_POLL_STASH -- stash the just-read key as type-ahead and report 'ready'.
 285  DD3C              ;   In: A = key character to hold.  Out: A = 1 (ready).  Clobbers: A.
 286  DD3C              ;   Algorithm: store A into CON_PENDING_CHAR, then fall into the A:=1 tail (CON_STATUS_READY).
 287  DD3C              ;   [RE] Twin of the 44K CON_POLL_STASH.
 288  DD3C              ; ----------------------------------------------------------------------
 289  DD3C              CON_POLL_STASH:
 290  DD3C 32 DC DE             LD (CON_PENDING_CHAR),A
 291  DD3F              ; ----------------------------------------------------------------------
 292  DD3F              ; CON_STATUS_READY -- return A=1, the 'character is ready' status result.
 293  DD3F              ;   In: none.  Out: A=1.  Clobbers: A.  [RE] Shared tail of CON_POLL_STATUS (44K twin).
 294  DD3F              ; ----------------------------------------------------------------------
 295  DD3F              CON_STATUS_READY:
 296  DD3F 3E 01                LD A,$01
 297  DD41 C9                   RET
 298  DD42              ; ----------------------------------------------------------------------
 299  DD42              ; CON_PUT_COL -- output one char to the console, tracking column and honouring Ctrl-S.
 300  DD42              ;   In: C = character to print.
 301  DD42              ;   Out: char sent to console (and to the list device if CON_LIST_ECHO set); the column cell is
 302  DD42              ;        updated for the char.  Clobbers: AF, HL (BC preserved across the BIOS calls).
 303  DD42              ;   Algorithm: unless the redisplay-suppress flag (CON_SAVED_COL) is set, poll for Ctrl-S/Ctrl-C
 304  DD42              ;              (CON_POLL_STATUS) then send C to the BIOS CONOUT ($FA0C) and, if CON_LIST_ECHO is
 305  DD42              ;              set, to the BIOS LIST ($FA0F). Then fall into LC_BANK1_CALL_TRACKCOL to update the
 306  DD42              ;              column via the lower-bank CON_TRACK_COL ($B5D5).
 307  DD42              ;   [RE] Core char output + column bookkeeping. Twin of the 44K CON_PUT_COL; column tracking is
 308  DD42              ;        split into the lower LC bank here.
 309  DD42              ; ----------------------------------------------------------------------
 310  DD42              CON_PUT_COL:
 311  DD42 3A D8 DE             LD A,(CON_SAVED_COL)
 312  DD45 B7                   OR A
 313  DD46 20 13                JR NZ,LC_BANK1_CALL_TRACKCOL
 314  DD48 C5                   PUSH BC
 315  DD49 CD 1F DD             CALL CON_POLL_STATUS
 316  DD4C C1                   POP BC
 317  DD4D C5                   PUSH BC
 318  DD4E CD 0C FA             CALL CONOUT
 319  DD51 C1                   POP BC
 320  DD52 C5                   PUSH BC
 321  DD53              ; CON_PUT_COL_LIST -- fall-through inside CON_PUT_COL: if CON_LIST_ECHO is set, mirror the char
 322  DD53              ;   to the BIOS LIST device ($FA0F). Not a separate call target (dead auto-name kept local).
 323  DD53              ;   [RE] Local of CON_PUT_COL.
 324  DD53              CON_PUT_COL_LIST:
 325  DD53 3A DB DE             LD A,(CON_LIST_ECHO)
 326  DD56 B7                   OR A
 327  DD57 C4 0F FA             CALL NZ,LIST
 328  DD5A C1                   POP BC
 329  DD5B              ; ----------------------------------------------------------------------
 330  DD5B              ; LC_BANK1_CALL_TRACKCOL -- bank the lower LC in and update the console column counter.
 331  DD5B              ;   In: C = char just emitted.  Out: CON_COL adjusted; bank2 restored on return.
 332  DD5B              ;   Clobbers: AF, HL (per CON_TRACK_COL).
 333  DD5B              ;   Algorithm: LD (LC_BANK1),A selects LC read/write bank1 (Apple $C08B) so the lower-bank code
 334  DD5B              ;              at $B5D5 is visible, CALL CON_TRACK_COL (CON_TRACK_COL), then JP LC_BANK2_RET to restore
 335  DD5B              ;              bank2 and RET.
 336  DD5B              ;   [RE] 60K bank-switch trampoline (no 44K counterpart -- 44K tracks the column inline).
 337  DD5B              ; ----------------------------------------------------------------------
 338  DD5B              LC_BANK1_CALL_TRACKCOL:
 339  DD5B 32 8B E0             LD (LC_BANK1),A
 340  DD5E CD D5 B5             CALL CON_TRACK_COL
 341  DD61 C3 81 DF             JP LC_BANK2_RET
 342  DD64 32                   DEFB    $32
 343  DD65 83 E0                DEFW    LC_BANK2
 344  DD67 FE 0A C0 36          DEFB    $FE,$0A,$C0,$36,$00,$C9
 344  DD6B 00 C9
 345  DD6D              ; ----------------------------------------------------------------------
 346  DD6D              ; CON_PUT_VISIBLE -- output a char, expanding non-tab control codes as '^X'.
 347  DD6D              ;   In: C = character.  Out: char(s) sent via CON_PUT_COL / F_CONOUT_H.  Clobbers: AF.
 348  DD6D              ;   Algorithm: test the char with LC_BANK1_CALL_ISCTRL (lower-bank IS_CTRL_CHAR); if it is a
 349  DD6D              ;              handled char (carry clear) print it normally through F_CONOUT_H; otherwise emit
 350  DD6D              ;              '^' ($5E) via CON_PUT_COL then the char OR'd with $40, so e.g. Ctrl-A shows '^A'.
 351  DD6D              ;   [RE] Visible-control echo used by the line editor's buffer redisplay. Twin of 44K
 352  DD6D              ;        CON_PUT_VISIBLE.
 353  DD6D              ; ----------------------------------------------------------------------
 354  DD6D              CON_PUT_VISIBLE:
 355  DD6D 79                   LD A,C
 356  DD6E CD 36 DF             CALL LC_BANK1_CALL_ISCTRL
 357  DD71 30 0A                JR NC,F_CONOUT_H
 358  DD73 F5                   PUSH AF
 359  DD74 0E 5E                LD C,$5E
 360  DD76 CD 42 DD             CALL CON_PUT_COL
 361  DD79 F1                   POP AF
 362  DD7A F6 40                OR $40
 363  DD7C 4F                   LD C,A
 364  DD7D              ; ----------------------------------------------------------------------
 365  DD7D              ; F_CONOUT_H -- BDOS console-output handler (function 2) with tab expansion.
 366  DD7D              ;   In: C = character to print.  Out: character emitted; TAB expands to the next 8-column stop.
 367  DD7D              ;   Clobbers: AF.
 368  DD7D              ;   Algorithm: if C != TAB ($09) just print it via CON_PUT_COL; if TAB, fall into CONOUT_TAB_FILL
 369  DD7D              ;              to emit spaces until CON_COL is a multiple of 8.
 370  DD7D              ;   [DOC CPMREF 3-44] BDOS function 2 (Console Output). Twin of 44K F_CONOUT_H; dispatch fn 2.
 371  DD7D              ; ----------------------------------------------------------------------
 372  DD7D              F_CONOUT_H:
 373  DD7D 79                   LD A,C
 374  DD7E FE 09                CP $09
 375  DD80 20 C0                JR NZ,CON_PUT_COL
 376  DD82              ; ----------------------------------------------------------------------
 377  DD82              ; CONOUT_TAB_FILL -- emit spaces until the column reaches the next 8-stop (tab expand).
 378  DD82              ;   In: CON_COL = current column.  Out: spaces printed until (column & 7)==0.  Clobbers: AF, C.
 379  DD82              ;   Algorithm: output a space via CON_PUT_COL, re-read CON_COL, loop while low 3 bits are set.
 380  DD82              ;   [RE] Tab-expansion loop of F_CONOUT_H (44K twin).
 381  DD82              ; ----------------------------------------------------------------------
 382  DD82              CONOUT_TAB_FILL:
 383  DD82 0E 20                LD C,$20
 384  DD84 CD 42 DD             CALL CON_PUT_COL
 385  DD87 3A DA DE             LD A,(CON_COL)
 386  DD8A E6 07                AND $07
 387  DD8C 20 F4                JR NZ,CONOUT_TAB_FILL
 388  DD8E C9                   RET
 389  DD8F              ; ----------------------------------------------------------------------
 390  DD8F              ; CON_BACKSPACE -- erase the last echoed character (BS, space, BS).
 391  DD8F              ;   In: none.  Out: cursor moved left one cell, char blanked on screen.  Clobbers: AF, C.
 392  DD8F              ;   Algorithm: emit BS via CON_BS_OUT, then a space to the BIOS CONOUT ($FA0C), then fall into
 393  DD8F              ;              CON_BS_OUT for the trailing BS so the previous glyph is overwritten with a blank.
 394  DD8F              ;   [RE] Twin of the 44K CON_BACKSPACE (44K's CON_ERASE_CHAR before de-aliasing).
 395  DD8F              ; ----------------------------------------------------------------------
 396  DD8F              CON_BACKSPACE:
 397  DD8F CD 97 DD             CALL CON_BS_OUT
 398  DD92 0E 20                LD C,$20
 399  DD94 CD 0C FA             CALL CONOUT
 400  DD97              ; ----------------------------------------------------------------------
 401  DD97              ; CON_BS_OUT -- send a single backspace ($08) to the console.
 402  DD97              ;   In: none.  Out: BS emitted via the BIOS CONOUT vector ($FA0C).  Clobbers: C.
 403  DD97              ;   [RE] Tail-call helper; also the leading and trailing BS of CON_BACKSPACE. Twin of 44K
 404  DD97              ;        CON_BS_OUT.
 405  DD97              ; ----------------------------------------------------------------------
 406  DD97              CON_BS_OUT:
 407  DD97 0E 08                LD C,$08
 408  DD99 C3 0C FA             JP CONOUT
 409  DD9C              ; ----------------------------------------------------------------------
 410  DD9C              ; CON_RETYPE_LINE -- echo '#' + CR/LF and reposition for a line-kill / retype (Ctrl-U/Ctrl-R).
 411  DD9C              ;   In: CON_COL = current column; CON_LINE_START_COL = line-start column.
 412  DD9C              ;   Out: '#' printed on a fresh line; cursor advanced with spaces back to the start column.
 413  DD9C              ;   Clobbers: AF, C, HL.
 414  DD9C              ;   Algorithm: print '#' ($23) via CON_PUT_COL, CON_CRLF, then fall into CON_RETYPE_LOOP to emit
 415  DD9C              ;              spaces until CON_COL reaches CON_LINE_START_COL.
 416  DD9C              ;   [RE] Twin of the 44K CON_RETYPE_LINE (60K's CON_LINE_KILL auto-name).
 417  DD9C              ; ----------------------------------------------------------------------
 418  DD9C              CON_RETYPE_LINE:
 419  DD9C 0E 23                LD C,$23
 420  DD9E CD 42 DD             CALL CON_PUT_COL
 421  DDA1 CD B3 DD             CALL CON_CRLF
 422  DDA4              ; ----------------------------------------------------------------------
 423  DDA4              ; CON_RETYPE_LOOP -- advance the cursor with spaces until the column matches the start count.
 424  DDA4              ;   In: CON_LINE_START_COL = target column; CON_COL = current column.
 425  DDA4              ;   Out: spaces emitted until CON_COL >= CON_LINE_START_COL.  Clobbers: AF, C, HL.
 426  DDA4              ;   Algorithm: while CON_COL < CON_LINE_START_COL, emit a space via CON_PUT_COL and loop.
 427  DDA4              ;   [RE] Re-echo loop of CON_RETYPE_LINE (44K twin).
 428  DDA4              ; ----------------------------------------------------------------------
 429  DDA4              CON_RETYPE_LOOP:
 430  DDA4 3A DA DE             LD A,(CON_COL)
 431  DDA7 21 D9 DE             LD HL,CON_LINE_START_COL
 432  DDAA BE                   CP (HL)
 433  DDAB D0                   RET NC
 434  DDAC 0E 20                LD C,$20
 435  DDAE CD 42 DD             CALL CON_PUT_COL
 436  DDB1 18 F1                JR CON_RETYPE_LOOP
 437  DDB3              CON_CRLF:
 438  DDB3 0E 0D                LD C,$0D
 439  DDB5 CD 42 DD             CALL CON_PUT_COL
 440  DDB8 0E 0A                LD C,$0A
 441  DDBA 18 86                JR CON_PUT_COL
 442  DDBC              ; [DOC CPMREF 3-44] Print String helper (BDOS fn 9 body): writes successive characters from the
 443  DDBC              ;       buffer addressed by BC to the console until the '$' terminator ($24) is reached.
 444  DDBC              ; ----------------------------------------------------------------------
 445  DDBC              ; CON_PRINT_STR -- print a '$'-terminated string to the console.
 446  DDBC              ;   In: BC = pointer to the string; terminated by '$' ($24).
 447  DDBC              ;   Out: each char emitted via F_CONOUT_H until '$' is reached.  Clobbers: AF, BC, C.
 448  DDBC              ;   Algorithm: load (BC); if '$' return; else advance BC, output the char via F_CONOUT_H
 449  DDBC              ;              (preserving BC), and loop.
 450  DDBC              ;   [DOC CPMREF 3-44] Backs BDOS function 9 (Print String) and the BDOS error banner. Twin of
 451  DDBC              ;        the 44K CON_PRINT_STR.
 452  DDBC              ; ----------------------------------------------------------------------
 453  DDBC              CON_PRINT_STR:
 454  DDBC 0A                   LD A,(BC)
 455  DDBD FE 24                CP $24                           ; '$' string terminator
 456  DDBF C8                   RET Z
 457  DDC0 03                   INC BC
 458  DDC1 C5                   PUSH BC
 459  DDC2 4F                   LD C,A
 460  DDC3 CD 7D DD             CALL F_CONOUT_H
 461  DDC6 C1                   POP BC
 462  DDC7 18 F3                JR CON_PRINT_STR
 463  DDC9              ; [DOC CPMREF 3-44] Read Console Buffer (BDOS fn 10): edited line input into the buffer pointed
 464  DDC9              ;       to by DE. The first buffer byte is the maximum count (mx) read here into C; the second
 465  DDC9              ;       byte (nc) receives the resulting character count; the typed characters follow. Implements
 466  DDC9              ;       the CP/M line editor (ctl-H/rubout backspace, ctl-X line-kill, ctl-R retype, ctl-E phys
 467  DDC9              ;       EOL, ctl-P printer echo, ctl-C reboot), terminating on CR ($0D) or LF ($0A).
 468  DDC9              ; ----------------------------------------------------------------------
 469  DDC9              ; F_READCONBUF_H -- BDOS buffered console line input (function 10) with editing.
 470  DDC9              ;   In: BDOS_PARAM_PTR -> the read buffer (byte0 = max length, byte1 = returned count, data...).
 471  DDC9              ;   Out: the buffer filled with the edited line; byte1 set to the char count.
 472  DDC9              ;   Clobbers: AF, BC, DE, HL.
 473  DDC9              ;   Algorithm: seed the echoed-count (CON_LINE_START_COL) from CON_COL; read chars one at a time
 474  DDC9              ;              (CON_GETC_OR_RAW, masked to 7 bits) and dispatch the editing controls: CR/LF
 475  DDC9              ;              terminate; BS/DEL delete; Ctrl-E new line; Ctrl-P printer toggle; Ctrl-X erase
 476  DDC9              ;              line; Ctrl-U abandon ('#'); Ctrl-R retype; other chars stored. Ends by writing the
 477  DDC9              ;              count and a CR.
 478  DDC9              ;   [DOC CPMREF 3-44] Classic CP/M 2.2 line editor (Read Console Buffer). Twin of 44K
 479  DDC9              ;        F_READCONBUF_H; dispatch fn 10.
 480  DDC9              ; ----------------------------------------------------------------------
 481  DDC9              F_READCONBUF_H:
 482  DDC9 3A DA DE             LD A,(CON_COL)
 483  DDCC 32 D9 DE             LD (CON_LINE_START_COL),A
 484  DDCF 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
 485  DDD2 4E                   LD C,(HL)                        ; 4E    mx = buffer max count (first byte)
 486  DDD3 23                   INC HL
 487  DDD4 E5                   PUSH HL
 488  DDD5 06 00                LD B,$00
 489  DDD7              ; ----------------------------------------------------------------------
 490  DDD7              ; READBUF_NEXT -- top of the line-editor read loop: save state and fetch a char.
 491  DDD7              ;   In: B = count so far, HL -> buffer position.
 492  DDD7              ;   Out: falls into READBUF_GETC with BC/HL preserved on the stack.  Clobbers: stack.
 493  DDD7              ;   [RE] Per-keystroke loop head of F_READCONBUF_H (44K twin).
 494  DDD7              ; ----------------------------------------------------------------------
 495  DDD7              READBUF_NEXT:
 496  DDD7 C5                   PUSH BC
 497  DDD8 E5                   PUSH HL
 498  DDD9              ; ----------------------------------------------------------------------
 499  DDD9              ; READBUF_GETC -- read and classify the next edit character.
 500  DDD9              ;   In: stacked BC/HL = saved count and buffer pointer.
 501  DDD9              ;   Out: A = 7-bit char; control codes dispatched to the appropriate editor handler.
 502  DDD9              ;   Clobbers: AF, BC, HL.
 503  DDD9              ;   Algorithm: CON_GETC_OR_RAW, mask to 7 bits, restore BC/HL, then chain CP/JP tests: CR/LF ->
 504  DDD9              ;              READBUF_DONE; BS -> back up one char (READBUF_REDISPLAY path); else fall to the
 505  DDD9              ;              DEL/control handlers.
 506  DDD9              ;   [RE] Keystroke dispatcher inside F_READCONBUF_H (44K twin).
 507  DDD9              ; ----------------------------------------------------------------------
 508  DDD9              READBUF_GETC:
 509  DDD9 CD 06 DD             CALL CON_GETC_OR_RAW
 510  DDDC E6 7F                AND $7F
 511  DDDE E1                   POP HL
 512  DDDF C1                   POP BC
 513  DDE0 FE 0D                CP $0D
 514  DDE2 CA 95 DE             JP Z,READBUF_DONE
 515  DDE5 FE 0A                CP $0A
 516  DDE7 CA 95 DE             JP Z,READBUF_DONE
 517  DDEA FE 08                CP $08
 518  DDEC 20 0D                JR NZ,READBUF_DEL
 519  DDEE 78                   LD A,B
 520  DDEF B7                   OR A
 521  DDF0 28 E5                JR Z,READBUF_NEXT
 522  DDF2 05                   DEC B
 523  DDF3 3A DA DE             LD A,(CON_COL)
 524  DDF6 32 D8 DE             LD (CON_SAVED_COL),A
 525  DDF9 18 4D                JR READBUF_REDISPLAY
 526  DDFB              ; ----------------------------------------------------------------------
 527  DDFB              ; READBUF_DEL -- handle DEL ($7F) as a destructive rubout of the previous char.
 528  DDFB              ;   In: A = char, B = count, HL -> buffer position.
 529  DDFB              ;   Out: if buffer nonempty, last char fetched for re-echo and pointer/count backed up; empty
 530  DDFB              ;        buffer just re-loops.  Clobbers: AF, B, HL.
 531  DDFB              ;   [RE] DELETE-key path of the line editor (44K twin).
 532  DDFB              ; ----------------------------------------------------------------------
 533  DDFB              READBUF_DEL:
 534  DDFB FE 7F                CP $7F
 535  DDFD 20 09                JR NZ,READBUF_CTRL_E
 536  DDFF 78                   LD A,B
 537  DE00 B7                   OR A
 538  DE01 28 D4                JR Z,READBUF_NEXT
 539  DE03 7E                   LD A,(HL)
 540  DE04 05                   DEC B
 541  DE05 2B                   DEC HL
 542  DE06 18 76                JR READBUF_STORE_ECHO
 543  DE08              ; ----------------------------------------------------------------------
 544  DE08              ; READBUF_CTRL_E -- handle Ctrl-E ($05): physical CR/LF without ending the line.
 545  DE08              ;   In: A = char, BC/HL = editor state.  Out: cursor moved to a new line, echoed-count reset;
 546  DE08              ;       editing continues.  Clobbers: AF.
 547  DE08              ;   Algorithm: on Ctrl-E print CR/LF (CON_CRLF), zero CON_LINE_START_COL, resume at READBUF_GETC;
 548  DE08              ;              otherwise fall through to READBUF_CTRL_P.
 549  DE08              ;   [RE] 44K twin.
 550  DE08              ; ----------------------------------------------------------------------
 551  DE08              READBUF_CTRL_E:
 552  DE08 FE 05                CP $05
 553  DE0A 20 0B                JR NZ,READBUF_CTRL_P
 554  DE0C C5                   PUSH BC
 555  DE0D E5                   PUSH HL
 556  DE0E CD B3 DD             CALL CON_CRLF
 557  DE11 AF                   XOR A
 558  DE12 32 D9 DE             LD (CON_LINE_START_COL),A
 559  DE15 18 C2                JR READBUF_GETC
 560  DE17              ; ----------------------------------------------------------------------
 561  DE17              ; READBUF_CTRL_P -- handle Ctrl-P ($10): toggle the printer (list-device) echo flag.
 562  DE17              ;   In: A = char.  Out: CON_LIST_ECHO flipped between 0 and 1; editing continues.
 563  DE17              ;   Clobbers: AF, HL.
 564  DE17              ;   Algorithm: on Ctrl-P compute 1 - CON_LIST_ECHO to toggle, then loop (READBUF_NEXT);
 565  DE17              ;              otherwise fall through to READBUF_CTRL_X.
 566  DE17              ;   [RE] 44K twin.
 567  DE17              ; ----------------------------------------------------------------------
 568  DE17              READBUF_CTRL_P:
 569  DE17 FE 10                CP $10
 570  DE19 20 0B                JR NZ,READBUF_CTRL_X
 571  DE1B E5                   PUSH HL
 572  DE1C 21 DB DE             LD HL,CON_LIST_ECHO
 573  DE1F 3E 01                LD A,$01
 574  DE21 96                   SUB (HL)
 575  DE22 77                   LD (HL),A
 576  DE23 E1                   POP HL
 577  DE24 18 B1                JR READBUF_NEXT
 578  DE26              ; ----------------------------------------------------------------------
 579  DE26              ; READBUF_CTRL_X -- handle Ctrl-X ($18): erase the whole input line.
 580  DE26              ;   In: A = char; CON_COL = column; CON_LINE_START_COL = start column.
 581  DE26              ;   Out: all echoed chars backspaced away and the buffer emptied; editing restarts.
 582  DE26              ;   Clobbers: AF, HL.
 583  DE26              ;   Algorithm: on Ctrl-X drop the buffer pointer and fall into READBUF_ERASE_LOOP; else fall to
 584  DE26              ;              READBUF_CTRL_U.
 585  DE26              ;   [RE] 44K twin.
 586  DE26              ; ----------------------------------------------------------------------
 587  DE26              READBUF_CTRL_X:
 588  DE26 FE 18                CP $18
 589  DE28 20 10                JR NZ,READBUF_CTRL_U
 590  DE2A E1                   POP HL
 591  DE2B              ; ----------------------------------------------------------------------
 592  DE2B              ; READBUF_ERASE_LOOP -- backspace-erase characters back to the line start.
 593  DE2B              ;   In: CON_LINE_START_COL = start column, CON_COL = current column.
 594  DE2B              ;   Out: console column reduced to the start; chars visually erased; restarts F_READCONBUF_H.
 595  DE2B              ;   Clobbers: AF, HL.
 596  DE2B              ;   Algorithm: while CON_COL > CON_LINE_START_COL, decrement it and CON_BACKSPACE; then restart
 597  DE2B              ;              the read with an empty buffer.
 598  DE2B              ;   [RE] 44K twin.
 599  DE2B              ; ----------------------------------------------------------------------
 600  DE2B              READBUF_ERASE_LOOP:
 601  DE2B 3A D9 DE             LD A,(CON_LINE_START_COL)
 602  DE2E 21 DA DE             LD HL,CON_COL
 603  DE31 BE                   CP (HL)
 604  DE32 30 95                JR NC,F_READCONBUF_H
 605  DE34 35                   DEC (HL)
 606  DE35 CD 8F DD             CALL CON_BACKSPACE
 607  DE38 18 F1                JR READBUF_ERASE_LOOP
 608  DE3A              ; ----------------------------------------------------------------------
 609  DE3A              ; READBUF_CTRL_U -- handle Ctrl-U ($15): abandon the line, show '#', restart.
 610  DE3A              ;   In: A = char.  Out: '#' printed, fresh line started, buffer reset (restarts F_READCONBUF_H).
 611  DE3A              ;   Clobbers: AF, HL.
 612  DE3A              ;   Algorithm: on Ctrl-U call CON_RETYPE_LINE ('#'+CRLF) and restart the read; otherwise fall to
 613  DE3A              ;              READBUF_CTRL_R.
 614  DE3A              ;   [RE] 44K twin.
 615  DE3A              ; ----------------------------------------------------------------------
 616  DE3A              READBUF_CTRL_U:
 617  DE3A FE 15                CP $15
 618  DE3C 20 06                JR NZ,READBUF_CTRL_R
 619  DE3E CD 9C DD             CALL CON_RETYPE_LINE
 620  DE41 E1                   POP HL
 621  DE42 18 85                JR F_READCONBUF_H
 622  DE44              ; ----------------------------------------------------------------------
 623  DE44              ; READBUF_CTRL_R -- handle Ctrl-R ($12): retype the current line, else store the char.
 624  DE44              ;   In: A = char, B = count, HL -> buffer.
 625  DE44              ;   Out: Ctrl-R reprints the buffer (falls into READBUF_REDISPLAY); any other char jumps to the
 626  DE44              ;        store path (READBUF_STORE).  Clobbers: AF.
 627  DE44              ;   [RE] 44K twin.
 628  DE44              ; ----------------------------------------------------------------------
 629  DE44              READBUF_CTRL_R:
 630  DE44 FE 12                CP $12
 631  DE46 20 33                JR NZ,READBUF_STORE
 632  DE48              ; ----------------------------------------------------------------------
 633  DE48              ; READBUF_REDISPLAY -- reprint the buffered line after a retype/delete.
 634  DE48              ;   In: B = char count; buffer pointer on stack (HL).
 635  DE48              ;   Out: '#'/CRLF emitted then each buffered char re-echoed via CON_PUT_VISIBLE.
 636  DE48              ;   Clobbers: AF, BC, HL.
 637  DE48              ;   Algorithm: CON_RETYPE_LINE for the marker, then walk the buffer (READBUF_REDISPLAY_LOOP)
 638  DE48              ;              re-echoing each stored char with CON_PUT_VISIBLE (controls show as '^X').
 639  DE48              ;   [RE] Used by Ctrl-R and after a backspace. 44K twin.
 640  DE48              ; ----------------------------------------------------------------------
 641  DE48              READBUF_REDISPLAY:
 642  DE48 C5                   PUSH BC
 643  DE49 CD 9C DD             CALL CON_RETYPE_LINE
 644  DE4C C1                   POP BC
 645  DE4D E1                   POP HL
 646  DE4E E5                   PUSH HL
 647  DE4F C5                   PUSH BC
 648  DE50              ; ----------------------------------------------------------------------
 649  DE50              ; READBUF_REDISPLAY_LOOP -- re-echo each buffered character.
 650  DE50              ;   In: B = remaining count, HL -> buffer position.
 651  DE50              ;   Out: every buffered char emitted via CON_PUT_VISIBLE.  Clobbers: AF, BC, C, HL.
 652  DE50              ;   Algorithm: while B != 0, advance HL, load the char, CON_PUT_VISIBLE it, decrement B; on
 653  DE50              ;              exhaustion fall into READBUF_REPOS.
 654  DE50              ;   [RE] 44K twin.
 655  DE50              ; ----------------------------------------------------------------------
 656  DE50              READBUF_REDISPLAY_LOOP:
 657  DE50 78                   LD A,B
 658  DE51 B7                   OR A
 659  DE52 28 0C                JR Z,READBUF_REPOS
 660  DE54 23                   INC HL
 661  DE55 4E                   LD C,(HL)
 662  DE56 05                   DEC B
 663  DE57 C5                   PUSH BC
 664  DE58 E5                   PUSH HL
 665  DE59 CD 6D DD             CALL CON_PUT_VISIBLE
 666  DE5C E1                   POP HL
 667  DE5D C1                   POP BC
 668  DE5E 18 F0                JR READBUF_REDISPLAY_LOOP
 669  DE60              ; ----------------------------------------------------------------------
 670  DE60              ; READBUF_REPOS -- after redisplay, backspace the cursor to the edit position.
 671  DE60              ;   In: CON_SAVED_COL = saved column to restore to, CON_COL = current column.
 672  DE60              ;   Out: cursor moved back so further typing continues at the right spot.  Clobbers: AF, HL.
 673  DE60              ;   Algorithm: if no saved position (CON_SAVED_COL==0) resume at READBUF_GETC; else compute how
 674  DE60              ;              far past the target the cursor is (CON_SAVED_COL := saved - column) and fall into
 675  DE60              ;              READBUF_REPOS_LOOP.
 676  DE60              ;   [RE] Cursor-reposition step after a Ctrl-R / delete redisplay. 44K twin.
 677  DE60              ; ----------------------------------------------------------------------
 678  DE60              READBUF_REPOS:
 679  DE60 E5                   PUSH HL
 680  DE61 3A D8 DE             LD A,(CON_SAVED_COL)
 681  DE64 B7                   OR A
 682  DE65 CA D9 DD             JP Z,READBUF_GETC
 683  DE68 21 DA DE             LD HL,CON_COL
 684  DE6B 96                   SUB (HL)
 685  DE6C 32 D8 DE             LD (CON_SAVED_COL),A
 686  DE6F              ; ----------------------------------------------------------------------
 687  DE6F              ; READBUF_REPOS_LOOP -- backspace the cursor by the computed cell count.
 688  DE6F              ;   In: CON_SAVED_COL = number of cells to back up.
 689  DE6F              ;   Out: cursor repositioned; loop ends and the editor reads the next char (READBUF_GETC).
 690  DE6F              ;   Clobbers: AF, HL.
 691  DE6F              ;   Algorithm: CON_BACKSPACE, decrement CON_SAVED_COL, repeat until zero, then resume input.
 692  DE6F              ;   [RE] 44K twin.
 693  DE6F              ; ----------------------------------------------------------------------
 694  DE6F              READBUF_REPOS_LOOP:
 695  DE6F CD 8F DD             CALL CON_BACKSPACE
 696  DE72 21 D8 DE             LD HL,CON_SAVED_COL
 697  DE75 35                   DEC (HL)
 698  DE76 20 F7                JR NZ,READBUF_REPOS_LOOP
 699  DE78 C3 D9 DD             JP READBUF_GETC
 700  DE7B              ; ----------------------------------------------------------------------
 701  DE7B              ; READBUF_STORE -- store an ordinary character into the input buffer.
 702  DE7B              ;   In: A = char to store, B = count, HL -> next buffer slot.
 703  DE7B              ;   Out: char written, count incremented; falls into READBUF_STORE_ECHO.  Clobbers: AF, B, HL.
 704  DE7B              ;   Algorithm: write the char at ++HL, bump B, then fall into the echo/limit check.
 705  DE7B              ;   [RE] Line editor's character-store path. 44K twin.
 706  DE7B              ; ----------------------------------------------------------------------
 707  DE7B              READBUF_STORE:
 708  DE7B 23                   INC HL
 709  DE7C 77                   LD (HL),A
 710  DE7D 04                   INC B
 711  DE7E              ; ----------------------------------------------------------------------
 712  DE7E              ; READBUF_STORE_ECHO -- echo the stored char and enforce the buffer length limit.
 713  DE7E              ;   In: A = char, B = count, C = buffer max length.
 714  DE7E              ;   Out: char echoed; if count reached the max (or a degenerate max) the line terminates,
 715  DE7E              ;        otherwise reading continues.  Clobbers: AF, BC, HL.
 716  DE7E              ;   Algorithm: echo via CON_PUT_VISIBLE; reload the buffer max; if the max byte is 1 (degenerate)
 717  DE7E              ;              warm-boot (JP 0); if count == max terminate (READBUF_LIMIT), else loop.
 718  DE7E              ;   [RE] 44K twin. [?] exact degenerate-max semantics beyond 'terminate when full' UNKNOWN.
 719  DE7E              ; ----------------------------------------------------------------------
 720  DE7E              READBUF_STORE_ECHO:
 721  DE7E C5                   PUSH BC
 722  DE7F E5                   PUSH HL
 723  DE80 4F                   LD C,A
 724  DE81 CD 6D DD             CALL CON_PUT_VISIBLE
 725  DE84 E1                   POP HL
 726  DE85 C1                   POP BC
 727  DE86 7E                   LD A,(HL)
 728  DE87 FE 03                CP $03
 729  DE89 78                   LD A,B
 730  DE8A 20 05                JR NZ,READBUF_LIMIT
 731  DE8C FE 01                CP $01
 732  DE8E CA 00 00             JP Z,WBOOTV
 733  DE91              ; ----------------------------------------------------------------------
 734  DE91              ; READBUF_LIMIT -- compare the count to the buffer max and continue or finish.
 735  DE91              ;   In: A = count (B), C = buffer maximum length.
 736  DE91              ;   Out: if count < max keep reading (READBUF_NEXT), else fall into READBUF_DONE.
 737  DE91              ;   Clobbers: AF.
 738  DE91              ;   Algorithm: CP C; if count < max (carry) loop, else finish. [RE] 44K twin.
 739  DE91              ; ----------------------------------------------------------------------
 740  DE91              READBUF_LIMIT:
 741  DE91 B9                   CP C
 742  DE92 DA D7 DD             JP C,READBUF_NEXT
 743  DE95              ; ----------------------------------------------------------------------
 744  DE95              ; READBUF_DONE -- finish the input line: store the count and emit a CR.
 745  DE95              ;   In: stacked HL -> buffer count byte; B = final character count.
 746  DE95              ;   Out: count written into the buffer; CR echoed; returns to the BDOS caller.
 747  DE95              ;   Clobbers: AF, C, HL.
 748  DE95              ;   Algorithm: pop the buffer pointer, store B as the returned count, then tail-call CON_PUT_COL
 749  DE95              ;              with CR ($0D) to close the input line.
 750  DE95              ;   [RE] Reached on CR/LF/buffer-full. 44K twin.
 751  DE95              ; ----------------------------------------------------------------------
 752  DE95              READBUF_DONE:
 753  DE95 E1                   POP HL
 754  DE96 70                   LD (HL),B
 755  DE97 0E 0D                LD C,$0D
 756  DE99 C3 42 DD             JP CON_PUT_COL
 757  DE9C              ; [DOC CPMREF 3-44] Console Input (BDOS fn 1): reads one character from the console (with echo,
 758  DE9C              ;       tab expansion, and ctl-S/ctl-P handling) and returns it in A.
 759  DE9C              ; ----------------------------------------------------------------------
 760  DE9C              ; F_CONIN_H -- BDOS function 1 handler: console input with echo, returned in A.
 761  DE9C              ;   In: none.  Out: BDOS result (BDOS_RETVAL) = char read.  Clobbers: AF, BC, HL.
 762  DE9C              ;   Algorithm: read+echo via F_CONIN_RAW, then store the char through BDOS_RET_RESULT.
 763  DE9C              ;   [DOC CPMREF 3-44] Dispatch-table entry for function 1. Twin of 44K F_CONIN_H.
 764  DE9C              ; ----------------------------------------------------------------------
 765  DE9C              F_CONIN_H:
 766  DE9C CD 11 DD             CALL F_CONIN_RAW
 767  DE9F 18 2F                JR BDOS_RET_RESULT
 768  DEA1              ; [DOC CPMREF 3-44] Reader Input (BDOS fn 3): returns one character from the logical RDR: device
 769  DEA1              ;       (BIOS READER entry) in A.
 770  DEA1              ; ----------------------------------------------------------------------
 771  DEA1              ; F_READERIN_H -- BDOS function 3 handler: read from the reader (RDR/AUX) device.
 772  DEA1              ;   In: none.  Out: BDOS result (BDOS_RETVAL) = byte from the BIOS READER vector.  Clobbers: AF.
 773  DEA1              ;   Algorithm: call the BIOS reader-input vector (READER $FA15), store the byte via
 774  DEA1              ;              BDOS_RET_RESULT.
 775  DEA1              ;   [DOC CPMREF 3-44] Dispatch entry for function 3 (Reader Input). Twin of 44K F_READERIN_H.
 776  DEA1              ; ----------------------------------------------------------------------
 777  DEA1              F_READERIN_H:
 778  DEA1 CD 15 FA             CALL READER
 779  DEA4 18 2A                JR BDOS_RET_RESULT
 780  DEA6              ; [DOC CPMREF 3-44] Direct Console I/O (BDOS fn 6): if E=$FF (here C=$FF, INC->$00) it returns an
 781  DEA6              ;       input char or $00-status; otherwise E is a character sent raw to the console (no ctl-S/ctl-P
 782  DEA6              ;       processing). The E=$FE status form is a CP/M extension; this build handles it via the second
 783  DEA6              ;       INC (C=$FE).
 784  DEA6              ; ----------------------------------------------------------------------
 785  DEA6              ; F_DIRECTIO_H -- BDOS function 6 handler: direct console I/O.
 786  DEA6              ;   In: C = subfunction ($FF = input/status, $FE = status only, else = output char).
 787  DEA6              ;   Out: input/status results via BDOS_RET_RESULT; output sent raw to the console.  Clobbers: AF.
 788  DEA6              ;   Algorithm: C==$FF (INC A -> Z) -> DIRECTIO_INPUT; C==$FE (second INC A -> Z) -> raw BIOS
 789  DEA6              ;              CONST ($FA06); otherwise send C to BIOS CONOUT ($FA0C), bypassing editor and flow
 790  DEA6              ;              control.
 791  DEA6              ;   [DOC CPMREF 3-44] Dispatch entry for function 6 (Direct Console I/O). Twin of 44K
 792  DEA6              ;        F_DIRECTIO_H.
 793  DEA6              ; ----------------------------------------------------------------------
 794  DEA6              F_DIRECTIO_H:
 795  DEA6 79                   LD A,C
 796  DEA7 3C                   INC A                            ; 3C    C=$FF (input request) -> Z
 797  DEA8 28 07                JR Z,DIRECTIO_INPUT
 798  DEAA 3C                   INC A                            ; 3C    C=$FE (status request) -> Z
 799  DEAB CA 06 FA             JP Z,CONST
 800  DEAE C3 0C FA             JP CONOUT                        ; otherwise output the raw character
 801  DEB1              ; ----------------------------------------------------------------------
 802  DEB1              ; DIRECTIO_INPUT -- direct console input subfunction of function 6.
 803  DEB1              ;   In: none.  Out: BDOS result = char if one is ready, else 0; no echo, no flow control.
 804  DEB1              ;   Clobbers: AF.
 805  DEB1              ;   Algorithm: poll raw BIOS CONST ($FA06); if no key, return 0 via BDOS_EXIT_RESTORE; if a key
 806  DEB1              ;              is ready read it raw (CONIN $FA09) and store via BDOS_RET_RESULT.
 807  DEB1              ;   [RE] 44K twin (DIRECTIO_INPUT); this is direct console input, not an FCB/directory routine.
 808  DEB1              ; ----------------------------------------------------------------------
 809  DEB1              DIRECTIO_INPUT:
 810  DEB1 CD 06 FA             CALL CONST
 811  DEB4 B7                   OR A
 812  DEB5 CA 63 DF             JP Z,BDOS_EXIT_RESTORE           ; no char ready -> return $00
 813  DEB8 CD 09 FA             CALL CONIN
 814  DEBB 18 13                JR BDOS_RET_RESULT
 815  DEBD              ; [DOC CPMREF 3-50] Get I/O Byte (BDOS fn 7): returns the current IOBYTE_ADDR ($0003) in A.
 816  DEBD              ; ----------------------------------------------------------------------
 817  DEBD              ; F_GETIOB_H -- BDOS function 7 handler: get the I/O byte (IOBYTE_ADDR).
 818  DEBD              ;   In: none.  Out: BDOS result = the IOBYTE_ADDR at fixed address $0003.  Clobbers: AF.
 819  DEBD              ;   Algorithm: load (IOBYTE_ADDR) and return it via BDOS_RET_RESULT.
 820  DEBD              ;   [DOC CPMREF 3-50] Dispatch entry for function 7. Twin of 44K F_GETIOB_H.
 821  DEBD              ; ----------------------------------------------------------------------
 822  DEBD              F_GETIOB_H:
 823  DEBD 3A 03 00             LD A,(IOBYTE_ADDR)
 824  DEC0 18 0E                JR BDOS_RET_RESULT
 825  DEC2              ; [DOC CPMREF 3-51] Set I/O Byte (BDOS fn 8): stores E (passed in C here) into the IOBYTE_ADDR ($0003).
 826  DEC2              ; ----------------------------------------------------------------------
 827  DEC2              ; F_SETIOB_H -- BDOS function 8 handler: set the I/O byte (IOBYTE_ADDR).
 828  DEC2              ;   In: C = new IOBYTE_ADDR value.  Out: (IOBYTE_ADDR) = C.  Clobbers: HL.
 829  DEC2              ;   Algorithm: store C into the fixed IOBYTE_ADDR cell at $0003 and return.
 830  DEC2              ;   [DOC CPMREF 3-51] Dispatch entry for function 8. Twin of 44K F_SETIOB_H.
 831  DEC2              ; ----------------------------------------------------------------------
 832  DEC2              F_SETIOB_H:
 833  DEC2 21 03 00             LD HL,IOBYTE_ADDR
 834  DEC5 71                   LD (HL),C
 835  DEC6 C9                   RET
 836  DEC7              ; [DOC CPMREF 3-44] Print String (BDOS fn 9): DE addresses a '$'-terminated string; move it into BC
 837  DEC7              ;       and fall into the CON_PRINT_STR helper to emit it to the console.
 838  DEC7              ; ----------------------------------------------------------------------
 839  DEC7              ; F_PRINTSTR_H -- BDOS function 9 handler: print a '$'-terminated string.
 840  DEC7              ;   In: DE = pointer to the string.  Out: string echoed up to the '$'.  Clobbers: AF, BC.
 841  DEC7              ;   Algorithm: move DE into BC and tail-call CON_PRINT_STR.
 842  DEC7              ;   [DOC CPMREF 3-44] Dispatch entry for function 9. Twin of 44K F_PRINTSTR_H.
 843  DEC7              ; ----------------------------------------------------------------------
 844  DEC7              F_PRINTSTR_H:
 845  DEC7 EB                   EX DE,HL
 846  DEC8 4D                   LD C,L
 847  DEC9 44                   LD B,H
 848  DECA C3 BC DD             JP CON_PRINT_STR
 849  DECD              ; [DOC CPMREF 3-44] Get Console Status (BDOS fn 11): returns A=$FF if a console character is ready,
 850  DECD              ;       $00 otherwise (also services the ctl-S pause / ctl-C warm-boot break check).
 851  DECD              ; ----------------------------------------------------------------------
 852  DECD              ; F_CONSTAT_H -- BDOS function 11 handler: get console status.
 853  DECD              ;   In: none.  Out: BDOS result = 1 if a console char is ready, else 0.  Clobbers: AF.
 854  DECD              ;   Algorithm: CON_POLL_STATUS to test readiness (handling Ctrl-S/Ctrl-C), then fall into
 855  DECD              ;              BDOS_RET_RESULT to store the 0/1 status.
 856  DECD              ;   [DOC CPMREF 3-44] Dispatch entry for function 11. Twin of 44K F_CONSTAT_H.
 857  DECD              ; ----------------------------------------------------------------------
 858  DECD              F_CONSTAT_H:
 859  DECD CD 1F DD             CALL CON_POLL_STATUS
 860  DED0              ; Stores the byte result in A into the BDOS return-value cell (read back into A=L,B=H on BDOS exit).
 861  DED0              ; ----------------------------------------------------------------------
 862  DED0              ; BDOS_RET_RESULT -- store A as the BDOS function return value and return.
 863  DED0              ;   In: A = result byte.  Out: BDOS_RETVAL (low byte) = A.  Clobbers: none beyond the cell.
 864  DED0              ;   Algorithm: write A to BDOS_RETVAL; the handler then RETs through the pushed bank-out epilogue
 865  DED0              ;              (BDOS_BANK_OUT_EPILOG). Common tail of the console handlers.
 866  DED0              ;   [RE] The BDOS result sink read back on exit (A=L, B=H). Twin of 44K BDOS_RET_RESULT.
 867  DED0              ; ----------------------------------------------------------------------
 868  DED0              BDOS_RET_RESULT:
 869  DED0 32 13 DF             LD (BDOS_RETVAL),A
 870  DED3              ; ----------------------------------------------------------------------
 871  DED3              ; BDOS_RET_NOP -- bare RET; the dispatch-table target for the no-op functions 38 and 39.
 872  DED3              ;   In/Out: none.  Clobbers: none.
 873  DED3              ;   [RE] SoftCard extension slots 38/39 do nothing (matches the 44K $9F04 RET). The following
 874  DED3              ;        DEFB $3E,$01,$18,$F8 is the unlabeled 'A:=1; JR BDOS_RET_RESULT' fragment (BDOS_RET_ONE
 875  DED3              ;        in the 44K twin), reached only by fall-through/JR, not by name here.
 876  DED3              ; ----------------------------------------------------------------------
 877  DED3              BDOS_RET_NOP:
 878  DED3 C9                   RET
 879  DED4 3E 01 18 F8          DEFB    $3E,$01,$18,$F8
 880  DED8              ; ----------------------------------------------------------------------
 881  DED8              ; CON_SAVED_COL -- saved cursor column for line-editor redisplay/reposition; also a
 882  DED8              ;   'suppress status-poll/echo' flag inside CON_PUT_COL (nonzero => skip poll+echo).
 883  DED8              ;   [RE] BDOS console state byte; zero when not repositioning. Twin of 44K CON_SAVED_COL
 884  DED8              ;        (60K auto-named CON_CRLF_30).
 885  DED8              ; ----------------------------------------------------------------------
 886  DED8              CON_SAVED_COL:
 887  DED8 00                   DEFB    $00
 888  DED9              ; ----------------------------------------------------------------------
 889  DED9              ; CON_LINE_START_COL -- column at the start of the current input line (echoed-count base).
 890  DED9              ;   [RE] Used by the line editor to know how far back Ctrl-X / DEL may erase. Twin of 44K
 891  DED9              ;        CON_LINE_START_COL.
 892  DED9              ; ----------------------------------------------------------------------
 893  DED9              CON_LINE_START_COL:
 894  DED9 00                   DEFB    $00
 895  DEDA              ; ----------------------------------------------------------------------
 896  DEDA              ; CON_COL -- current console output column counter.
 897  DEDA              ;   [RE] Incremented per printable char, reset by LF; drives tab expansion and editing. Twin of
 898  DEDA              ;        44K CON_COL.
 899  DEDA              ; ----------------------------------------------------------------------
 900  DEDA              CON_COL:
 901  DEDA 00                   DEFB    $00
 902  DEDB              ; ----------------------------------------------------------------------
 903  DEDB              ; CON_LIST_ECHO -- printer (list device) echo flag; nonzero => mirror console output to LIST.
 904  DEDB              ;   [RE] Toggled by the line editor's Ctrl-P (READBUF_CTRL_P). Twin of 44K CON_LIST_ECHO.
 905  DEDB              ; ----------------------------------------------------------------------
 906  DEDB              CON_LIST_ECHO:
 907  DEDB 00                   DEFB    $00
 908  DEDC              ; ----------------------------------------------------------------------
 909  DEDC              ; CON_PENDING_CHAR -- 1-byte console type-ahead / un-get buffer (0 = empty).
 910  DEDC              ;   [RE] Filled by CON_POLL_STATUS, consumed by CON_GETC_OR_RAW. Twin of 44K CON_PENDING_CHAR.
 911  DEDC              ; ----------------------------------------------------------------------
 912  DEDC              CON_PENDING_CHAR:
 913  DEDC 00                   DEFB    $00
 914  DEDD              BDOS_SAVED_SP:
 915  DEDD 00 00 00...          DEFS    50, $00                  ; fill
 916  DF0F              ; ----------------------------------------------------------------------
 917  DF0F              ; BDOS_USER_NUM -- top of the BDOS private stack (SP loaded here on entry).
 918  DF0F              ;   [RE] BDOS_ENTRY does LD SP,BDOS_USER_NUM before dispatching; the preceding DEFS reserves the
 919  DF0F              ;        stack slack below it. Twin of 44K BDOS_USER_NUM (60K auto-named BDOS_STACK).
 920  DF0F              ; ----------------------------------------------------------------------
 921  DF0F              BDOS_USER_NUM:
 922  DF0F 00                   DEFB    $00
 923  DF10              ; ----------------------------------------------------------------------
 924  DF10              ; BDOS_CUR_DRIVE -- the drive the BDOS is currently operating on (0=A..15=P).
 925  DF10              ;   [RE] Set by the drive-select path and read all over the file system. Twin of the 44K
 926  DF10              ;        BDOS_CUR_DRIVE at $9F42; this is that cell relocated by the upper-bank +$3FCE.
 927  DF10              ; ----------------------------------------------------------------------
 928  DF10              BDOS_CUR_DRIVE:
 929  DF10 00                   DEFB    $00
 930  DF11              ; ----------------------------------------------------------------------
 931  DF11              ; BDOS_PARAM_PTR -- saved DE parameter pointer from the BDOS call (FCB / DMA / buffer). 16-bit.
 932  DF11              ;   [RE] BDOS_ENTRY stashes the incoming DE here; consumers reload it as the operand pointer
 933  DF11              ;        (e.g. the dispatcher and F_READCONBUF_H). Twin of 44K BDOS_PARAM_PTR.
 934  DF11              ; ----------------------------------------------------------------------
 935  DF11              BDOS_PARAM_PTR:
 936  DF11 00 00                DEFB    $00,$00
 937  DF13              ; ----------------------------------------------------------------------
 938  DF13              ; BDOS_RETVAL -- BDOS function return value (16-bit: low byte = A result, high = B).
 939  DF13              ;   [RE] Pre-seeded to 0 on entry; written by BDOS_RET_RESULT; loaded back into HL (A=L, B=H) by
 940  DF13              ;        BDOS_LOAD_RESULT on exit. Twin of 44K BDOS_RETVAL. The bytes after the 2-byte cell begin
 941  DF13              ;        the $DF15 error-vector jump helper (LD HL,$DC0B / LD E,(HL)/INC HL/LD D,(HL)/EX DE,HL/
 942  DF13              ;        bank2 / JP (HL)) that dispatches the BDOS_ERROR reporter addresses at $DC09/$DC0B.
 943  DF13              ; ----------------------------------------------------------------------
 944  DF13              BDOS_RETVAL:
 945  DF13 00 00 21 0B          DEFB    $00,$00,$21,$0B,$DC,$5E,$23,$56,$EB,$32
 945  DF17 DC 5E 23 56
 945  DF1B EB 32
 946  DF1D 83 E0                DEFW    LC_BANK2
 947  DF1F E9 32                DEFB    $E9,$32
 948  DF21 83 E0                DEFW    LC_BANK2
 949  DF23 CD 27 FA 18          DEFB    $CD,$27,$FA,$18,$06,$32
 949  DF27 06 32
 950  DF29 83 E0                DEFW    LC_BANK2
 951  DF2B CD 2A FA B7          DEFB    $CD,$2A,$FA,$B7,$28,$10,$21,$09,$DC,$18,$E2
 951  DF2F 28 10 21 09
 951  DF33 DC 18 E2
 952  DF36              ; ----------------------------------------------------------------------
 953  DF36              ; LC_BANK1_CALL_ISCTRL -- bank the lower LC in and call IS_CTRL_CHAR ($B5C0).
 954  DF36              ;   In: A = character to classify.  Out: per IS_CTRL_CHAR -- carry set if A is a control char the
 955  DF36              ;        line editor must expand (A < ' ' and not CR/LF/TAB/BS); the lower-bank tail restores
 956  DF36              ;        bank2 and returns.  Clobbers: AF, flags.
 957  DF36              ;   Algorithm: LD (LC_BANK1),A selects LC bank1 (Apple $C08B) so the classifier at $B5C0 is
 958  DF36              ;              visible, then JP IS_CTRL_CHAR (IS_CTRL_CHAR); that routine ends with JP LC_BANK2_RET to
 959  DF36              ;              bank2 back in and RET to the upper-bank caller.
 960  DF36              ;   [RE] 60K bank-switch trampoline (no 44K counterpart -- 44K calls IS_CTRL_CHAR directly).
 961  DF36              ; ----------------------------------------------------------------------
 962  DF36              LC_BANK1_CALL_ISCTRL:
 963  DF36 32 8B E0             LD (LC_BANK1),A
 964  DF39 C3 C0 B5             JP IS_CTRL_CHAR
 965  DF3C 32                   DEFB    $32
 966  DF3D 83 E0                DEFW    LC_BANK2
 967  DF3F ED B0 32             DEFB    $ED,$B0,$32
 968  DF42 8B E0                DEFW    LC_BANK1
 969  DF44 C9                   DEFB    $C9
 970  DF45              BDOS_BANK_OUT_EPILOG:
 971  DF45 32                   DEFB    $32
 972  DF46 8B E0                DEFW    LC_BANK1
 973  DF48 3A EB BF B7          DEFB    $3A,$EB,$BF,$B7,$28,$15,$2A
 973  DF4C 28 15 2A
 974  DF4F 11 DF                DEFW    BDOS_PARAM_PTR
 975  DF51 36 00 3A ED          DEFB    $36,$00,$3A,$ED,$BF,$B7,$28,$0A,$77,$3A,$EC,$BF,$32,$E3,$BF,$CD
 975  DF55 BF B7 28 0A
 975  DF59 77 3A EC BF
 975  DF5D 32 E3 BF CD
 976  DF61 47 BE                DEFB    $47,$BE
 977  DF63              BDOS_EXIT_RESTORE:
 978  DF63 32 83 E0             LD (LC_BANK2),A
 979  DF66 3A 87 DF             LD A,(DEFERRED_COPY_FLAG)
 980  DF69 B7                   OR A
 981  DF6A 28 0C                JR Z,BDOS_LOAD_RESULT
 982  DF6C ED 5B 85 DF          LD DE,(DEFERRED_COPY_DST)
 983  DF70 21 88 DF             LD HL,DEFERRED_COPY_BUF
 984  DF73 01 24 00             LD BC,$0024
 985  DF76 ED B0                LDIR
 986  DF78              ; [DOC CPMREF 3-44] BDOS return: load the result word into HL, then set A=L and B=H so callers see
 987  DF78              ;       byte results in A and word results in HL per the standard CP/M return convention.
 988  DF78              ; ----------------------------------------------------------------------
 989  DF78              ; BDOS_LOAD_RESULT -- load the BDOS result and restore the caller's stack on exit.
 990  DF78              ;   In: BDOS_RETVAL = result word; BDOS_SAVED_SP = caller SP.
 991  DF78              ;   Out: HL = result, A = L (byte result), B = H (word high); SP restored; falls into
 992  DF78              ;        LC_BANK2_RET to bank2 back in and RET to the $0005 caller.  Clobbers: AF, BC, HL, SP.
 993  DF78              ;   Algorithm: LD HL,(BDOS_RETVAL); LD A,L; LD B,H; LD SP,(BDOS_SAVED_SP); fall into LC_BANK2_RET.
 994  DF78              ;   [DOC CPMREF 3-44] Standard CP/M return convention (A=L, HL=word). Reached from
 995  DF78              ;        BDOS_EXIT_RESTORE after the optional deferred copy-back. 60K-specific epilogue tail.
 996  DF78              ; ----------------------------------------------------------------------
 997  DF78              BDOS_LOAD_RESULT:
 998  DF78 2A 13 DF             LD HL,(BDOS_RETVAL)
 999  DF7B 7D                   LD A,L                           ; 7D    A = L (byte result)
1000  DF7C 44                   LD B,H                           ; 44    B = H (high half of word result)
1001  DF7D ED 7B DD DE          LD SP,(BDOS_SAVED_SP)            ; restore caller's stack pointer
1002  DF81              LC_BANK2_RET:
1003  DF81 32 83 E0             LD (LC_BANK2),A
1004  DF84 C9                   RET
1005  DF85              ; ----------------------------------------------------------------------
1006  DF85              ; DEFERRED_COPY_DST -- 16-bit destination pointer for the pending exit copy-back. DATA.
1007  DF85              ;   [RE] When DEFERRED_COPY_FLAG is set, BDOS_EXIT_RESTORE LDIRs $24 (36) bytes from
1008  DF85              ;        DEFERRED_COPY_BUF to the address held here, then clears the flag. Believed to be the
1009  DF85              ;        saved search-FCB write-back target the manual notes for Search-First/Next. [?] exact
1010  DF85              ;        producer UNKNOWN (set by a lower-bank $Bxxx handler). 60K-specific cell.
1011  DF85              ; ----------------------------------------------------------------------
1012  DF85              DEFERRED_COPY_DST:
1013  DF85 00 00                DEFB    $00,$00
1014  DF87              ; ----------------------------------------------------------------------
1015  DF87              ; DEFERRED_COPY_FLAG -- 1-byte 'copy-back pending' flag for the BDOS exit path. DATA.
1016  DF87              ;   [RE] Cleared on entry (BDOS_ENTRY, $DC30); if nonzero at exit, BDOS_EXIT_RESTORE performs the
1017  DF87              ;        deferred 36-byte LDIR (DEFERRED_COPY_BUF -> DEFERRED_COPY_DST). Set by a lower-bank
1018  DF87              ;        handler. 60K-specific cell. [?] exact producer UNKNOWN.
1019  DF87              ; ----------------------------------------------------------------------
1020  DF87              DEFERRED_COPY_FLAG:
1021  DF87 00                   DEFB    $00
1022  DF88              ; ----------------------------------------------------------------------
1023  DF88              ; DEFERRED_COPY_BUF -- 36-byte staging buffer (LDIR source) for the deferred exit copy-back. DATA.
1024  DF88              ;   [RE] BDOS_EXIT_RESTORE copies these $24 bytes to DEFERRED_COPY_DST when DEFERRED_COPY_FLAG is
1025  DF88              ;        set. Sized 36 = a 32-byte directory FCB image plus a few control bytes. The 6502 bytes
1026  DF88              ;        that follow at $DFAC-$DFEB are an out-of-band payload past this cell, not part of it.
1027  DF88              ;        60K-specific buffer. [?] exact contents/producer UNKNOWN.
1028  DF88              ; ----------------------------------------------------------------------
1029  DF88              DEFERRED_COPY_BUF:
1030  DF88 00 00 00...          DEFS    36, $00                  ; fill
1031  DFAC 8D 83 C0 A2          DEFB    $8D,$83,$C0,$A2,$AC,$2C,$A2,$AA,$88,$B1,$3E,$4A,$3E,$56,$0B,$4A
1031  DFB0 AC 2C A2 AA
1031  DFB4 88 B1 3E 4A
1031  DFB8 3E 56 0B 4A
1032  DFBC 3E 56 0B 99          DEFB    $3E,$56,$0B,$99,$00,$09,$E8,$D0,$EF,$98,$D0,$EA,$4C,$E5,$FF,$8D
1032  DFC0 00 09 E8 D0
1032  DFC4 EF 98 D0 EA
1032  DFC8 4C E5 FF 8D
1033  DFCC 83 C0 A0 00          DEFB    $83,$C0,$A0,$00,$A2,$56,$CA,$30,$FB,$B9,$00,$09,$5E,$00,$0C,$2A
1033  DFD0 A2 56 CA 30
1033  DFD4 FB B9 00 09
1033  DFD8 5E 00 0C 2A
1034  DFDC 5E 00 0C 2A          DEFB    $5E,$00,$0C,$2A,$91,$3E,$C8,$D0,$ED,$8D,$8B,$C0,$60,$00,$00,$00
1034  DFE0 91 3E C8 D0
1034  DFE4 ED 8D 8B C0
1034  DFE8 60 00 00 00
1035  DFEC 00 00 00...          DEFS    20, $00                  ; fill
1036  E000              ; ===========================================================================
1037  E000              ; LOWER LC BANK -- the FCB/file/directory/disk machinery (run $B5C0-$BFBF).
1038  E000              ; Stored contiguously in the BDOS image at $E000-$E9FF but RUN in the Language
1039  E000              ; Card low mirror (Apple $D5C0-$DFFF, bank 1): the cold-boot relocator copies
1040  E000              ; these pages down there, so the CPU executes them at $B5C0-$BFBF (= storage
1041  E000              ; -$2A40). DISP makes every in-image label resolve to its true $Bxxx run address
1042  E000              ; while the bytes are emitted at their $E0xx image position. The dispatcher at
1043  E000              ; $DC11 banks this half in (LC_BANK1) before an indexed JP (HL) reaches a handler
1044  E000              ; here; the $BFC0-$BFFF scratch these routines use is live RAM, past the image.
1045  E000              ; sjasmplus can't nest DISP, so close the upper-bank $DC00 DISP first (linked
1046  E000              ; build only; the standalone build reached here under a plain ORG $DC00).
1047  E000              ; ===========================================================================
1048  E000                  IFDEF CPM60_LINK
1049  E000 ~                ENT                ; close the upper-bank DISP $DC00 (linked build)
1050  E000                  ENDIF
1051  E000                  DISP $B5C0
1052  B5C0              ; ----------------------------------------------------------------------
1053  B5C0              ; IS_CTRL_CHAR -- classify A as a printable/control character for the console echo path.
1054  B5C0              ;   In: A = character to test.
1055  B5C0              ;   Out: carry set when A is a control character that the line editor must expand (below space and
1056  B5C0              ;        not one of CR/LF/TAB/BS); carry clear for CR/LF/TAB/BS and for printable chars (>= space).
1057  B5C0              ;   Clobbers: A,flags (the tail-JP LC_BANK2_RET = upper-bank LC_BANK2_RET banks bank2 back in and returns).
1058  B5C0              ;   Algorithm: compare A against CR($0D)/LF($0A)/TAB($09)/BS($08) (each a non-control 'pass'), then
1059  B5C0              ;       CP $20; JP LC_BANK2_RET leaves carry = (A < $20) for the remaining control chars. Lives in the lower
1060  B5C0              ;       LC bank; the upper-bank echo caller reaches it via LC_BANK1_CALL_ISCTRL ($DF36).
1061  B5C0              ;   [RE] control-char discriminator for CON_PUT_VISIBLE (^X caret display).
1062  B5C0              ; ----------------------------------------------------------------------
1063  B5C0              IS_CTRL_CHAR:
1064  B5C0 FE 0D                CP $0D
1065  B5C2 28 0E                JR Z,IS_CTRL_CHAR_TAIL
1066  B5C4 FE 0A                CP $0A
1067  B5C6 28 0A                JR Z,IS_CTRL_CHAR_TAIL
1068  B5C8 FE 09                CP $09
1069  B5CA 28 06                JR Z,IS_CTRL_CHAR_TAIL
1070  B5CC FE 08                CP $08
1071  B5CE 28 02                JR Z,IS_CTRL_CHAR_TAIL
1072  B5D0 FE 20                CP $20
1073  B5D2              IS_CTRL_CHAR_TAIL:
1074  B5D2 C3 81 DF             JP LC_BANK2_RET
1075  B5D5              ; ----------------------------------------------------------------------
1076  B5D5              ; CON_TRACK_COL -- update the console column counter (CON_COL=$DEDA) for one output char.
1077  B5D5              ;   In: C = character being emitted.
1078  B5D5              ;   Out: the column cell $DEDA advanced for a printable char, decremented for a backspace, and left
1079  B5D5              ;        unchanged for rubout ($7F) or when already at column 0.  Clobbers: A,HL,flags.
1080  B5D5              ;   Algorithm: HL := $DEDA (upper-bank CON_COL); RET on rubout; INC the column, but if the char is
1081  B5D5              ;       a control code (< space) undo it, and for BS ($08) tail to $DD64 (the upper-bank column-fix
1082  B5D5              ;       stub) to also DEC. Runs in the lower LC bank; called from LC_BANK1_CALL_TRACKCOL via CALL CON_TRACK_COL.
1083  B5D5              ;   [RE] column tracker feeding TAB expansion and line-edit backspace.
1084  B5D5              ; ----------------------------------------------------------------------
1085  B5D5              CON_TRACK_COL:
1086  B5D5 79                   LD A,C
1087  B5D6 21 DA DE             LD HL,CON_COL
1088  B5D9 FE 7F                CP $7F
1089  B5DB C8                   RET Z
1090  B5DC 34                   INC (HL)
1091  B5DD FE 20                CP $20
1092  B5DF D0                   RET NC
1093  B5E0 35                   DEC (HL)
1094  B5E1 7E                   LD A,(HL)
1095  B5E2 B7                   OR A
1096  B5E3 C8                   RET Z
1097  B5E4 79                   LD A,C
1098  B5E5 FE 08                CP $08
1099  B5E7 C2 64 DD             JP NZ,$DD64
1100  B5EA 35                   DEC (HL)
1101  B5EB C9                   RET
1102  B5EC              ; ----------------------------------------------------------------------
1103  B5EC              ; SELDSK_DPB_FETCH -- SELDSK the current drive and cache its Disk Parameter Block fields locally.
1104  B5EC              ;   In: current drive at $DF10 (BDOS upper-bank current-drive cell).
1105  B5EC              ;   Out: Z (A=0) if the BIOS returned a null DPH (drive not present); else A=$FF and the DPB fields
1106  B5EC              ;        are unpacked into the $BFxx work cells (translate ptr $BFC0, block-shift/mask/EXM into
1107  B5EC              ;        $BFC2..$BFC6, the DPB word block $BFC6.. copied from the DPB, ALLOC-vec ptr region, etc.).
1108  B5EC              ;   Clobbers: A,BC,DE,HL,flags.
1109  B5EC              ;   Algorithm: A := (current drive $DF10); C := A; CALL BIOS SELDSK ($FA1B) -> HL = DPH; return Z if
1110  B5EC              ;       HL is 0; walk the DPH to the DPB, stash the XLT/DPB pointers into the $BFC0-$BFC6 work cells,
1111  B5EC              ;       LDIR the 8-byte DPB header and the 15-byte second block into $BFC6/$BFCE, set the block-width
1112  B5EC              ;       flag $BFEA from DSM's high byte, and return A=$FF.
1113  B5EC              ;   [RE] 60K equivalent of the 44K SELDSK/DPB-unpack; the DPB scratch lives in the LC low page ($BFxx
1114  B5EC              ;        here, vs the 44K $A9xx). [?] exact cell roles cross-checked against the 44K twin.
1115  B5EC              ; ----------------------------------------------------------------------
1116  B5EC              SELDSK_DPB_FETCH:
1117  B5EC 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
1118  B5EF 4F                   LD C,A
1119  B5F0 CD 1B FA             CALL SELDSK
1120  B5F3 7C                   LD A,H
1121  B5F4 B5                   OR L
1122  B5F5 C8                   RET Z
1123  B5F6 5E                   LD E,(HL)
1124  B5F7 23                   INC HL
1125  B5F8 56                   LD D,(HL)
1126  B5F9 23                   INC HL
1127  B5FA 22 C0 BF             LD (DPB_WORK_PTR0),HL
1128  B5FD 23                   INC HL
1129  B5FE 23                   INC HL
1130  B5FF 22 C2 BF             LD (DEBLOCK_HSTREC_PTR0),HL
1131  B602 23                   INC HL
1132  B603 23                   INC HL
1133  B604 22 C4 BF             LD (DEBLOCK_HSTREC_PTR1),HL
1134  B607 23                   INC HL
1135  B608 23                   INC HL
1136  B609 ED 53 DD BF          LD (DPB_XLT_PTR),DE
1137  B60D 11 C6 BF             LD DE,DIRBUF_PTR
1138  B610 01 08 00             LD BC,$0008
1139  B613 ED B0                LDIR
1140  B615 2A C8 BF             LD HL,(DPB_PTR)
1141  B618 11 CE BF             LD DE,DPB_SPT
1142  B61B 01 0F 00             LD BC,$000F
1143  B61E ED B0                LDIR
1144  B620 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
1145  B623 7C                   LD A,H
1146  B624 21 EA BF             LD HL,BLOCK_WIDTH_FLAG
1147  B627 36 FF                LD (HL),$FF
1148  B629 B7                   OR A
1149  B62A 28 02                JR Z,SELDSK_DPB_FETCH_1
1150  B62C 36 00                LD (HL),$00
1151  B62E              SELDSK_DPB_FETCH_1:
1152  B62E 3E FF                LD A,$FF
1153  B630 B7                   OR A
1154  B631 C9                   RET
1155  B632              ; ----------------------------------------------------------------------
1156  B632              ; DISK_HOME_CLEAR_SCAN -- HOME the drive and reset the directory-scan record/position work cells.
1157  B632              ;   In: DPB scratch pointers at $BFC2 (record-count work word ptr) and $BFC4 (scan-position word ptr).
1158  B632              ;   Out: the BIOS head is homed and the two 16-bit work cells addressed by (DEBLOCK_HSTREC_PTR0) and (DEBLOCK_HSTREC_PTR1) are
1159  B632              ;        zeroed, restarting a directory sweep from record 0.  Clobbers: A,HL,flags.
1160  B632              ;   Algorithm: CALL BIOS HOME ($FA18); A := 0; zero the word at (DEBLOCK_HSTREC_PTR0) and the word at (DEBLOCK_HSTREC_PTR1).
1161  B632              ;   [RE] scan-reset run at the start of ALLOC_VECTOR_BUILD and each DIR_SEARCH_FIRST.
1162  B632              ; ----------------------------------------------------------------------
1163  B632              DISK_HOME_CLEAR_SCAN:
1164  B632 CD 18 FA             CALL HOME
1165  B635 AF                   XOR A
1166  B636 2A C2 BF             LD HL,(DEBLOCK_HSTREC_PTR0)
1167  B639 77                   LD (HL),A
1168  B63A 23                   INC HL
1169  B63B 77                   LD (HL),A
1170  B63C 2A C4 BF             LD HL,(DEBLOCK_HSTREC_PTR1)
1171  B63F 77                   LD (HL),A
1172  B640 23                   INC HL
1173  B641 77                   LD (HL),A
1174  B642 C9                   RET
1175  B643              ; ----------------------------------------------------------------------
1176  B643              ; REC_DIV4_SETUP -- derive the 128-byte disk record (CUR_RECORD >> 2) that holds the current dir entry.
1177  B643              ;   In: CUR_RECORD = 16-bit current directory-entry index at $BFF7.
1178  B643              ;   Out: the record number CUR_RECORD/4 stored into the two deblock work words $BFF2 and $BFF9.
1179  B643              ;   Clobbers: A,BC,HL,flags.
1180  B643              ;   Algorithm: HL := (CUR_RECORD $BFF7); C := 2; SHR_HL_C (>>2 = four 32-byte entries per 128-byte
1181  B643              ;       record); store HL to $BFF2 and $BFF9; fall into RECORD_TO_TRACK.
1182  B643              ;   [RE] CP/M packs four 32-byte directory entries per 128-byte record; this picks the record.
1183  B643              ; ----------------------------------------------------------------------
1184  B643              REC_DIV4_SETUP:
1185  B643 2A F7 BF             LD HL,(CUR_RECORD)
1186  B646 0E 02                LD C,$02
1187  B648 CD 5F B7             CALL SHR_HL_C
1188  B64B 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
1189  B64E 22 F9 BF             LD (REC_CACHE),HL
1190  B651              ; ----------------------------------------------------------------------
1191  B651              ; RECORD_TO_TRACK -- translate the target logical record into a physical track/sector and program the BIOS.
1192  B651              ;   In: the record word at $BFF2; DPB fields cached in the $BFxx work cells (sectors-per-track word
1193  B651              ;       (DPB_SPT), track-offset (DPB_XLT_PTR), skew-table (DPB_OFF)).
1194  B651              ;   Out: BIOS SETTRK/SETSEC set for the record via the BIOS SECTRAN/step vectors; track/sector work
1195  B651              ;        cells ($BFC2/$BFC4) updated.  Clobbers: A,BC,DE,HL,flags.
1196  B651              ;   Algorithm: subtract whole tracks (sectors-per-track) from the record to get track# and
1197  B651              ;       sector-within-track, add the DPB track offset, program the BIOS via the $FAxx SET* vectors,
1198  B651              ;       and SECTRAN the sector through the skew table (DPB_OFF) before SETSEC.
1199  B651              ;   [RE] the 60K record->track/sector deblock; DPB geometry read from the LC low-page work cells.
1200  B651              ;        Cross-checked against the 44K RECORD_TO_TRACK twin, so this is [RE] grade.
1201  B651              ; ----------------------------------------------------------------------
1202  B651              RECORD_TO_TRACK:
1203  B651 21 F2 BF             LD HL,CUR_BLOCK_NUMBER
1204  B654 4E                   LD C,(HL)
1205  B655 23                   INC HL
1206  B656 46                   LD B,(HL)
1207  B657 2A C4 BF             LD HL,(DEBLOCK_HSTREC_PTR1)
1208  B65A 5E                   LD E,(HL)
1209  B65B 23                   INC HL
1210  B65C 56                   LD D,(HL)
1211  B65D 2A C2 BF             LD HL,(DEBLOCK_HSTREC_PTR0)
1212  B660 7E                   LD A,(HL)
1213  B661 23                   INC HL
1214  B662 66                   LD H,(HL)
1215  B663 6F                   LD L,A
1216  B664              RECORD_TO_TRACK_1:
1217  B664 79                   LD A,C
1218  B665 93                   SUB E
1219  B666 78                   LD A,B
1220  B667 9A                   SBC A,D
1221  B668 30 0E                JR NC,RECORD_TO_TRACK_2
1222  B66A E5                   PUSH HL
1223  B66B 2A CE BF             LD HL,(DPB_SPT)
1224  B66E 7B                   LD A,E
1225  B66F 95                   SUB L
1226  B670 5F                   LD E,A
1227  B671 7A                   LD A,D
1228  B672 9C                   SBC A,H
1229  B673 57                   LD D,A
1230  B674 E1                   POP HL
1231  B675 2B                   DEC HL
1232  B676 18 EC                JR RECORD_TO_TRACK_1
1233  B678              RECORD_TO_TRACK_2:
1234  B678 E5                   PUSH HL
1235  B679 2A CE BF             LD HL,(DPB_SPT)
1236  B67C 19                   ADD HL,DE
1237  B67D 38 0B                JR C,RECORD_TO_TRACK_3
1238  B67F 79                   LD A,C
1239  B680 95                   SUB L
1240  B681 78                   LD A,B
1241  B682 9C                   SBC A,H
1242  B683 38 05                JR C,RECORD_TO_TRACK_3
1243  B685 EB                   EX DE,HL
1244  B686 E1                   POP HL
1245  B687 23                   INC HL
1246  B688 18 EE                JR RECORD_TO_TRACK_2
1247  B68A              RECORD_TO_TRACK_3:
1248  B68A E1                   POP HL
1249  B68B C5                   PUSH BC
1250  B68C D5                   PUSH DE
1251  B68D E5                   PUSH HL
1252  B68E EB                   EX DE,HL
1253  B68F 2A DB BF             LD HL,(DPB_OFF)
1254  B692 19                   ADD HL,DE
1255  B693 44                   LD B,H
1256  B694 4D                   LD C,L
1257  B695 CD 1E FA             CALL SETTRK
1258  B698 D1                   POP DE
1259  B699 2A C2 BF             LD HL,(DEBLOCK_HSTREC_PTR0)
1260  B69C 73                   LD (HL),E
1261  B69D 23                   INC HL
1262  B69E 72                   LD (HL),D
1263  B69F D1                   POP DE
1264  B6A0 2A C4 BF             LD HL,(DEBLOCK_HSTREC_PTR1)
1265  B6A3 73                   LD (HL),E
1266  B6A4 23                   INC HL
1267  B6A5 72                   LD (HL),D
1268  B6A6 C1                   POP BC
1269  B6A7 79                   LD A,C
1270  B6A8 93                   SUB E
1271  B6A9 4F                   LD C,A
1272  B6AA 78                   LD A,B
1273  B6AB 9A                   SBC A,D
1274  B6AC 47                   LD B,A
1275  B6AD 2A DD BF             LD HL,(DPB_XLT_PTR)
1276  B6B0 EB                   EX DE,HL
1277  B6B1 CD 30 FA             CALL SECTRAN
1278  B6B4 4D                   LD C,L
1279  B6B5 44                   LD B,H
1280  B6B6 C3 21 FA             JP SETSEC
1281  B6B9              ; ----------------------------------------------------------------------
1282  B6B9              ; REC_BLOCK_SHIFT_6 -- combine the FCB extent's low block-map bits with the record-in-block bits.
1283  B6B9              ;   In: DPB block-shift BSH at $BFD0; the record-low and extent-low work bytes at $BFF0 / $BFEF.
1284  B6B9              ;   Out: A = the composite index used by FCB_BLOCKMAP_INDEX_10 to pick the block-map slot.
1285  B6B9              ;   Clobbers: A,B,C,flags.
1286  B6B9              ;   Algorithm: shift the record byte (FCB_CURREC) right (8 - BSH) times, shift the extent byte (FCB_EXTENT_MASKED)
1287  B6B9              ;       left BSH times, and add them to form the block-map slot index.
1288  B6B9              ;   [RE] 60K deblock helper computing the FCB allocation-map slot from record + extent.
1289  B6B9              ; ----------------------------------------------------------------------
1290  B6B9              REC_BLOCK_SHIFT_6:
1291  B6B9 21 D0 BF             LD HL,DPB_BSH
1292  B6BC 4E                   LD C,(HL)
1293  B6BD 3A F0 BF             LD A,(FCB_CURREC)
1294  B6C0              REC_BLOCK_SHIFT_6_1:
1295  B6C0 B7                   OR A
1296  B6C1 1F                   RRA
1297  B6C2 0D                   DEC C
1298  B6C3 20 FB                JR NZ,REC_BLOCK_SHIFT_6_1
1299  B6C5 47                   LD B,A
1300  B6C6 3E 08                LD A,$08
1301  B6C8 96                   SUB (HL)
1302  B6C9 4F                   LD C,A
1303  B6CA 3A EF BF             LD A,(FCB_EXTENT_MASKED)
1304  B6CD              REC_BLOCK_SHIFT_6_2:
1305  B6CD 0D                   DEC C
1306  B6CE 28 04                JR Z,REC_BLOCK_SHIFT_6_3
1307  B6D0 B7                   OR A
1308  B6D1 17                   RLA
1309  B6D2 18 F9                JR REC_BLOCK_SHIFT_6_2
1310  B6D4              REC_BLOCK_SHIFT_6_3:
1311  B6D4 80                   ADD A,B
1312  B6D5 C9                   RET
1313  B6D6              ; ----------------------------------------------------------------------
1314  B6D6              ; FCB_BLOCKMAP_INDEX_10 -- fetch the disk block number from the FCB allocation map at slot BC.
1315  B6D6              ;   In: BC = slot index; current FCB pointer at $DF11 (upper-bank CURFCB cell); block-width flag $BFEA.
1316  B6D6              ;   Out: HL = the block (group) number stored at FCB+$10+slot (8-bit map) or the 16-bit word there
1317  B6D6              ;        (16-bit map, when $BFEA=0).  Clobbers: A,DE,HL,flags.
1318  B6D6              ;   Algorithm: HL := (CURFCB $DF11) + $10 + BC; if $BFEA (narrow) nonzero read one byte (H:=0), else
1319  B6D6              ;       add BC again and read the 16-bit word.
1320  B6D6              ;   [RE] reads an FCB block-map entry; $BFEA selects 8-bit vs 16-bit block numbers. [DOC CP/M 2.2 FCB]
1321  B6D6              ; ----------------------------------------------------------------------
1322  B6D6              FCB_BLOCKMAP_INDEX_10:
1323  B6D6 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1324  B6D9                      ; the FCB's allocation map
1325  B6D9 11 10 00             LD DE,FCB.DIRECTORY_ENTRY.AL
1326  B6DC 19                   ADD HL,DE
1327  B6DD 09                   ADD HL,BC
1328  B6DE 3A EA BF             LD A,(BLOCK_WIDTH_FLAG)
1329  B6E1 B7                   OR A
1330  B6E2 28 04                JR Z,FCB_BLOCKMAP_INDEX_10_1
1331  B6E4 6E                   LD L,(HL)
1332  B6E5 26 00                LD H,$00
1333  B6E7 C9                   RET
1334  B6E8              FCB_BLOCKMAP_INDEX_10_1:
1335  B6E8 09                   ADD HL,BC
1336  B6E9 5E                   LD E,(HL)
1337  B6EA 23                   INC HL
1338  B6EB 56                   LD D,(HL)
1339  B6EC EB                   EX DE,HL
1340  B6ED C9                   RET
1341  B6EE              ; ----------------------------------------------------------------------
1342  B6EE              ; REC_TO_BLOCK_14 -- map the current record to its disk block number via the FCB allocation map.
1343  B6EE              ;   In: the record/extent work bytes ($BFF0/$BFEF) and current FCB (BDOS_PARAM_PTR).
1344  B6EE              ;   Out: the block number for this record stored into the block work word $BFF2 (0 = unallocated).
1345  B6EE              ;   Clobbers: A,BC,HL,flags.
1346  B6EE              ;   Algorithm: REC_BLOCK_SHIFT_6 forms the block-map slot in A; C:=A,B:=0; FCB_BLOCKMAP_INDEX_10
1347  B6EE              ;       reads that slot's block number; store to $BFF2.
1348  B6EE              ;   [RE] 60K record->block lookup; feeds BLOCK_IS_ZERO_16 / BLOCK_BASE_RECORD_17.
1349  B6EE              ; ----------------------------------------------------------------------
1350  B6EE              REC_TO_BLOCK_14:
1351  B6EE CD B9 B6             CALL REC_BLOCK_SHIFT_6
1352  B6F1 4F                   LD C,A
1353  B6F2 06 00                LD B,$00
1354  B6F4 CD D6 B6             CALL FCB_BLOCKMAP_INDEX_10
1355  B6F7 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
1356  B6FA C9                   RET
1357  B6FB              ; ----------------------------------------------------------------------
1358  B6FB              ; BLOCK_IS_ZERO_16 -- test whether the current record's block (CUR_BLOCK_NUMBER) is unallocated.
1359  B6FB              ;   In: block work word at $BFF2.
1360  B6FB              ;   Out: A = L, Z set when the 16-bit block number is 0 (no block yet allocated for this record).
1361  B6FB              ;   Clobbers: A,HL,flags.
1362  B6FB              ;   Algorithm: HL := (CUR_BLOCK_NUMBER); A := L OR H; RET (Z <=> block==0).
1363  B6FB              ;   [RE] the read/write core branches on Z here to decide allocate-vs-use.
1364  B6FB              ; ----------------------------------------------------------------------
1365  B6FB              BLOCK_IS_ZERO_16:
1366  B6FB 2A F2 BF             LD HL,(CUR_BLOCK_NUMBER)
1367  B6FE 7D                   LD A,L
1368  B6FF B4                   OR H
1369  B700 C9                   RET
1370  B701              ; ----------------------------------------------------------------------
1371  B701              ; BLOCK_BASE_RECORD_17 -- compute the absolute base record of the current block plus the in-block record.
1372  B701              ;   In: DPB block-shift BSH at $BFD0, block-mask BLM at $BFD1; block number at $BFF2; record-low $BFF0.
1373  B701              ;   Out: $BFF4 = block# << BSH (the block's first record); $BFF2 = that base OR (record & BLM) = the
1374  B701              ;        exact physical record.  Clobbers: A,C,HL,flags.
1375  B701              ;   Algorithm: HL := block (CUR_BLOCK_NUMBER); ADD HL,HL BSH times to get the base record (stored $BFF4); then OR
1376  B701              ;       in (record-low $BFF0 AND BLM $BFD1) and store the physical record back to $BFF2.
1377  B701              ;   [RE] block-number -> physical-record fold used before RECORD_TO_TRACK.
1378  B701              ; ----------------------------------------------------------------------
1379  B701              BLOCK_BASE_RECORD_17:
1380  B701 3A D0 BF             LD A,(DPB_BSH)
1381  B704 2A F2 BF             LD HL,(CUR_BLOCK_NUMBER)
1382  B707              BLOCK_BASE_RECORD_17_1:
1383  B707 29                   ADD HL,HL
1384  B708 3D                   DEC A
1385  B709 20 FC                JR NZ,BLOCK_BASE_RECORD_17_1
1386  B70B 22 F4 BF             LD (BLOCK_BASE_RECORD),HL
1387  B70E 3A D1 BF             LD A,(DPB_BLM)
1388  B711 4F                   LD C,A
1389  B712 3A F0 BF             LD A,(FCB_CURREC)
1390  B715 A1                   AND C
1391  B716 B5                   OR L
1392  B717 6F                   LD L,A
1393  B718 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
1394  B71B C9                   RET
1395  B71C              ; ----------------------------------------------------------------------
1396  B71C              ; FCB_PTR_EXTENT -- point HL at the FCB's extent byte (FCB+$0C, the EX field).
1397  B71C              ;   In: current FCB pointer at $DF11 (upper-bank CURFCB cell).
1398  B71C              ;   Out: HL = CURFCB + $0C (the extent-number byte).  Clobbers: DE,HL.
1399  B71C              ;   Algorithm: HL := (BDOS_PARAM_PTR) + $000C.
1400  B71C              ;   [RE] FCB byte 12 = EX (extent number) per CP/M 2.2 FCB layout. [DOC CP/M 2.2 FCB]
1401  B71C              ; ----------------------------------------------------------------------
1402  B71C              FCB_PTR_EXTENT:
1403  B71C 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1404  B71F 11 0C 00             LD DE,FCB.DIRECTORY_ENTRY.EX
1405  B722 19                   ADD HL,DE
1406  B723 C9                   RET
1407  B724              ; ----------------------------------------------------------------------
1408  B724              ; FCB_PTR_RC_CR -- point DE at the FCB record-count byte (FCB+$0F) and HL at the current-record byte (FCB+$20).
1409  B724              ;   In: current FCB pointer at $DF11.
1410  B724              ;   Out: DE = CURFCB + $0F (RC, record count in the extent); HL = CURFCB + $20 (CR, current record).
1411  B724              ;   Clobbers: DE,HL.
1412  B724              ;   Algorithm: DE := (BDOS_PARAM_PTR) + $0F; HL := DE + $11 (= FCB + $20).
1413  B724              ;   [RE] FCB byte 15 = RC, byte 32 = CR per CP/M 2.2 FCB layout. [DOC CP/M 2.2 FCB]
1414  B724              ; ----------------------------------------------------------------------
1415  B724              FCB_PTR_RC_CR:
1416  B724 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1417  B727 11 0F 00             LD DE,FCB.DIRECTORY_ENTRY.RC
1418  B72A 19                   ADD HL,DE
1419  B72B EB                   EX DE,HL
1420  B72C 21 11 00             LD HL,FCB.CR - FCB.DIRECTORY_ENTRY.RC
1421  B72F 19                   ADD HL,DE
1422  B730 C9                   RET
1423  B731              ; ----------------------------------------------------------------------
1424  B731              ; FCB_PRIME_FIELDS -- load the current FCB's CR / RC / EX fields into the $BFxx deblock work bytes.
1425  B731              ;   In: current FCB (BDOS_PARAM_PTR); DPB EXM mask at $BFD2.
1426  B731              ;   Out: $BFF0 = CR (current record, FCB+$20); $BFEE = RC (record count, FCB+$0F); $BFEF = EX (extent,
1427  B731              ;        FCB+$0C) masked with EXM.  Clobbers: A,DE,HL.
1428  B731              ;   Algorithm: FCB_PTR_RC_CR gets the RC/CR pointers; copy CR->$BFF0 and RC->$BFEE; FCB_PTR_EXTENT
1429  B731              ;       gets &EX; store (EX AND EXM $BFD2) -> $BFEF.
1430  B731              ;   [RE] primes the working record/extent bytes the read/write core operates on.
1431  B731              ; ----------------------------------------------------------------------
1432  B731              FCB_PRIME_FIELDS:
1433  B731 CD 24 B7             CALL FCB_PTR_RC_CR
1434  B734 7E                   LD A,(HL)
1435  B735 32 F0 BF             LD (FCB_CURREC),A
1436  B738 EB                   EX DE,HL
1437  B739 7E                   LD A,(HL)
1438  B73A 32 EE BF             LD (FCB_RECCOUNT),A
1439  B73D CD 1C B7             CALL FCB_PTR_EXTENT
1440  B740 3A D2 BF             LD A,(DPB_EXM)
1441  B743 A6                   AND (HL)
1442  B744 32 EF BF             LD (FCB_EXTENT_MASKED),A
1443  B747 C9                   RET
1444  B748              ; ----------------------------------------------------------------------
1445  B748              ; FCB_WRITEBACK_REC -- write the working record/record-count bytes back into the current FCB.
1446  B748              ;   In: working CR byte $BFF0, working RC byte $BFEE; write-type flag WRITE_TYPE=$BFE2.
1447  B748              ;   Out: FCB CR (FCB+$20) := $BFF0 (+1 unless WRITE_TYPE=2 zero-fill); FCB RC (FCB+$0F) := $BFEE.
1448  B748              ;   Clobbers: A,C,DE,HL.
1449  B748              ;   Algorithm: FCB_PTR_RC_CR gets the pointers; C := 1 unless WRITE_TYPE (WRITE_TYPE_FLAG)==2 (then 0); store
1450  B748              ;       (CR $BFF0 + C) to the FCB CR byte and RC $BFEE to the FCB RC byte.
1451  B748              ;   [RE] post-I/O FCB position commit; WRITE_TYPE=2 (WRITEZF) does not advance CR.
1452  B748              ; ----------------------------------------------------------------------
1453  B748              FCB_WRITEBACK_REC:
1454  B748 CD 24 B7             CALL FCB_PTR_RC_CR
1455  B74B 3A E2 BF             LD A,(WRITE_TYPE_FLAG)
1456  B74E FE 02                CP ACCESS_RAND_ZF
1457  B750 20 01                JR NZ,FCB_WRITEBACK_REC_1
1458  B752 AF                   XOR A
1459  B753              FCB_WRITEBACK_REC_1:
1460  B753 4F                   LD C,A
1461  B754 3A F0 BF             LD A,(FCB_CURREC)
1462  B757 81                   ADD A,C
1463  B758 77                   LD (HL),A
1464  B759 EB                   EX DE,HL
1465  B75A 3A EE BF             LD A,(FCB_RECCOUNT)
1466  B75D 77                   LD (HL),A
1467  B75E C9                   RET
1468  B75F              ; ----------------------------------------------------------------------
1469  B75F              ; SHR_HL_C -- logical-shift HL right by C bit positions.
1470  B75F              ;   In: HL = value; C = shift count (0 leaves HL unchanged).
1471  B75F              ;   Out: HL >>= C.  Clobbers: C,HL (C decremented to 0).
1472  B75F              ;   Algorithm: INC C / loop { DEC C; ret if zero; SRL H; RR L }.
1473  B75F              ;   [RE] generic unsigned right-shift helper (record/4, drive-bit extraction). Mirror of SHL_HL_C.
1474  B75F              ; ----------------------------------------------------------------------
1475  B75F              SHR_HL_C:
1476  B75F 0C                   INC C
1477  B760              SHR_HL_C_1:
1478  B760 0D                   DEC C
1479  B761 C8                   RET Z
1480  B762 CB 3C                SRL H
1481  B764 CB 1D                RR L
1482  B766 18 F8                JR SHR_HL_C_1
1483  B768              ; ----------------------------------------------------------------------
1484  B768              ; DIR_CHECKSUM -- compute the 128-byte additive checksum of the directory buffer.
1485  B768              ;   In: the directory buffer pointer at $BFC6 (DIRBUF ptr).
1486  B768              ;   Out: A = 8-bit sum of the 128 bytes.  Clobbers: A,C,HL.
1487  B768              ;   Algorithm: C=$80 count, HL=(DIRBUF ptr $BFC6), A=0; loop ADD A,(HL)/INC HL/DEC C until C==0.
1488  B768              ;   [RE] canonical CP/M directory-checksum routine (detects media swap). [DOC CP/M 2.2 ALG]
1489  B768              ; ----------------------------------------------------------------------
1490  B768              DIR_CHECKSUM:
1491  B768 0E 80                LD C,$80
1492  B76A 2A C6 BF             LD HL,(DIRBUF_PTR)
1493  B76D AF                   XOR A
1494  B76E              DIR_CHECKSUM_LOOP:
1495  B76E 86                   ADD A,(HL)
1496  B76F 23                   INC HL
1497  B770 0D                   DEC C
1498  B771 20 FB                JR NZ,DIR_CHECKSUM_LOOP
1499  B773 C9                   RET
1500  B774              ; ----------------------------------------------------------------------
1501  B774              ; SHL_HL_C -- logical-shift HL left by C bit positions.
1502  B774              ;   In: HL = value; C = shift count (0 leaves HL unchanged).
1503  B774              ;   Out: HL <<= C.  Clobbers: C,HL (C decremented to 0).
1504  B774              ;   Algorithm: INC C / loop { DEC C; ret if zero; ADD HL,HL }.
1505  B774              ;   [RE] generic unsigned left-shift helper (e.g. building a 1<<n drive-bit mask).
1506  B774              ; ----------------------------------------------------------------------
1507  B774              SHL_HL_C:
1508  B774 0C                   INC C
1509  B775              SHL_HL_C_LOOP:
1510  B775 0D                   DEC C
1511  B776 C8                   RET Z
1512  B777 29                   ADD HL,HL
1513  B778 18 FB                JR SHL_HL_C_LOOP
1514  B77A              ; ----------------------------------------------------------------------
1515  B77A              ; DRIVE_BIT_OR_INTO_VECTOR -- OR the current drive's single-bit mask into a 16-bit vector.
1516  B77A              ;   In: BC = existing 16-bit vector (preserved); current drive at $DF10.
1517  B77A              ;       (HL on entry is IGNORED; it is overwritten with $0001.)
1518  B77A              ;   Out: HL = BC OR (1 << current_drive).  Clobbers: A,HL (BC saved/restored).
1519  B77A              ;   Algorithm: PUSH BC; C := current drive (BDOS_CUR_DRIVE); HL := 1; SHL_HL_C to form 1<<drive; POP BC;
1520  B77A              ;       L := C OR L, H := B OR H.
1521  B77A              ;   [RE] sets the current drive's bit in whatever vector the caller passes in BC (R/O and login
1522  B77A              ;   setters).
1523  B77A              ; ----------------------------------------------------------------------
1524  B77A              DRIVE_BIT_OR_INTO_VECTOR:
1525  B77A C5                   PUSH BC
1526  B77B 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
1527  B77E 4F                   LD C,A
1528  B77F 21 01 00             LD HL,$0001
1529  B782 CD 74 B7             CALL SHL_HL_C
1530  B785 C1                   POP BC
1531  B786 79                   LD A,C
1532  B787 B5                   OR L
1533  B788 6F                   LD L,A
1534  B789 78                   LD A,B
1535  B78A B4                   OR H
1536  B78B 67                   LD H,A
1537  B78C C9                   RET
1538  B78D              ; ----------------------------------------------------------------------
1539  B78D              ; DRIVE_BIT_TEST -- test whether the current drive's bit is set in the read-only drive vector.
1540  B78D              ;   In: the 16-bit R/O vector at DRV_LOGIN_VECTOR ($BFBA, the read-only vector set by the
1541  B78D              ;       Write-Protect-Disk handler BDOS_F_SETRO); current drive at $DF10.
1542  B78D              ;   Out: A = 1 if the current drive's R/O bit is set, else 0; Z reflects the result.  Clobbers: A,C,HL.
1543  B78D              ;   Algorithm: load the vector (DRV_LOGIN_VECTOR), shift right by the drive number to bring its bit to bit 0, AND $01.
1544  B78D              ;   [RE] CHECK_DRIVE_READONLY raises the R/O error when this bit is set, proving the vector is the
1545  B78D              ;        read-only vector, not the login vector. [?] cell-name kept as DRV_LOGIN_VECTOR per the 44K twin.
1546  B78D              ; ----------------------------------------------------------------------
1547  B78D              DRIVE_BIT_TEST:
1548  B78D 2A BA BF             LD HL,(DRV_LOGIN_VECTOR)
1549  B790 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
1550  B793 4F                   LD C,A
1551  B794 CD 5F B7             CALL SHR_HL_C
1552  B797 7D                   LD A,L
1553  B798 E6 01                AND $01
1554  B79A C9                   RET
1555  B79B              ; ----------------------------------------------------------------------
1556  B79B              ; BDOS_F_SETRO -- BDOS function 28 (Write Protect Disk): set the current drive's R/O bit.
1557  B79B              ;   In: the R/O drive vector at DRV_LOGIN_VECTOR (DRV_LOGIN_VECTOR); current drive at $DF10; the directory
1558  B79B              ;       record-count limit word at (DPB_REC_PTR); a 16-bit working cell addressed by (DPB_WORK_PTR0).
1559  B79B              ;   Out: the R/O vector has the current drive's bit set; the word at (DPB_WORK_PTR0) := (record limit)+1.
1560  B79B              ;   Clobbers: A,BC,DE,HL.
1561  B79B              ;   Algorithm: load the R/O vector (DRV_LOGIN_VECTOR) into BC, set the current-drive bit via
1562  B79B              ;       DRIVE_BIT_OR_INTO_VECTOR, store it back; then store ((word at $BFD5)+1) into the cell at (DPB_WORK_PTR0).
1563  B79B              ;   [RE] this is the fn-28 entry ($DC8B->$B79B) in the dispatch table, confirming Write-Protect-Disk.
1564  B79B              ;        [?] reason for caching the record-limit+1 UNKNOWN.
1565  B79B              ; ----------------------------------------------------------------------
1566  B79B              BDOS_F_SETRO:
1567  B79B 21 BA BF             LD HL,DRV_LOGIN_VECTOR
1568  B79E 4E                   LD C,(HL)
1569  B79F 23                   INC HL
1570  B7A0 46                   LD B,(HL)
1571  B7A1 CD 7A B7             CALL DRIVE_BIT_OR_INTO_VECTOR
1572  B7A4 22 BA BF             LD (DRV_LOGIN_VECTOR),HL
1573  B7A7 2A D5 BF             LD HL,(DPB_REC_PTR)
1574  B7AA 23                   INC HL
1575  B7AB EB                   EX DE,HL
1576  B7AC 2A C0 BF             LD HL,(DPB_WORK_PTR0)
1577  B7AF 73                   LD (HL),E
1578  B7B0 23                   INC HL
1579  B7B1 72                   LD (HL),D
1580  B7B2 C9                   RET
1581  B7B3              ; ----------------------------------------------------------------------
1582  B7B3              ; FCB_RO_FLAG_TEST -- raise the file-R/O error if the matched directory entry is read-only.
1583  B7B3              ;   In: the DIRBUF ptr (DIRBUF_PTR) and entry byte-offset (DEBLOCK_BYTE_OFF) locate the matched entry (via
1584  B7B3              ;       FCB_BUF_PTR_ADD_OFFSET).
1585  B7B3              ;   Out: returns normally if writable; otherwise jumps to the BDOS error vector (no return; loads the
1586  B7B3              ;        file-R/O error record at $DC0F and dispatches via $DF18).  Clobbers: A,DE,HL.
1587  B7B3              ;   Algorithm: point at the entry, advance to byte +9 (the first type byte t1', whose bit 7 is the R/O
1588  B7B3              ;       attribute), RLA to shift bit 7 into carry; RET NC if clear, else load HL=$DC0F (file-R/O error
1589  B7B3              ;       block) and JP $DF18 (the BDOS error dispatch trampoline).
1590  B7B3              ;   [RE] CP/M file R/O attribute = bit 7 of directory-entry byte 9 (t1'). [DOC CP/M 2.2 FCB]
1591  B7B3              ; ----------------------------------------------------------------------
1592  B7B3              FCB_RO_FLAG_TEST:
1593  B7B3 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
1594  B7B6              ; ----------------------------------------------------------------------
1595  B7B6              ; CHECK_DIRENT_READONLY_INNER -- inner entry of FCB_RO_FLAG_TEST (HL already on the directory entry). [RE]
1596  B7B6              ; ----------------------------------------------------------------------
1597  B7B6              CHECK_DIRENT_READONLY_INNER:
1598  B7B6 11 09 00             LD DE,DIRECTORY_ENTRY.FT
1599  B7B9 19                   ADD HL,DE
1600  B7BA 7E                   LD A,(HL)
1601  B7BB 17                   RLA
1602  B7BC D0                   RET NC
1603  B7BD 21 0F DC             LD HL,$DC0F
1604  B7C0 C3 18 DF             JP $DF18
1605  B7C3              ; ----------------------------------------------------------------------
1606  B7C3              ; CHECK_DRIVE_READONLY -- raise the disk-R/O error if the current drive is write-protected.
1607  B7C3              ;   In: the current drive context (DRIVE_BIT_TEST reads the R/O drive vector at $BFBA).
1608  B7C3              ;   Out: returns if writable; otherwise jumps to the BDOS error vector (no return; loads the disk-R/O
1609  B7C3              ;        error record at $DC0D and dispatches via $DF18).  Clobbers: A,C,HL.
1610  B7C3              ;   Algorithm: CALL DRIVE_BIT_TEST; RET Z if clear (writable), else HL := $DC0D (disk-R/O error block)
1611  B7C3              ;       and JP $DF18 (the BDOS error dispatch trampoline).
1612  B7C3              ;   [RE] guards writes against a write-protected disk.
1613  B7C3              ; ----------------------------------------------------------------------
1614  B7C3              CHECK_DRIVE_READONLY:
1615  B7C3 CD 8D B7             CALL DRIVE_BIT_TEST
1616  B7C6 C8                   RET Z
1617  B7C7 21 0D DC             LD HL,$DC0D
1618  B7CA C3 18 DF             JP $DF18
1619  B7CD              ; ----------------------------------------------------------------------
1620  B7CD              ; FCB_BUF_PTR_ADD_OFFSET -- compute a pointer to the matched directory entry inside the directory buffer.
1621  B7CD              ;   In: DIRBUF ptr at $BFC6; the entry byte-offset at $BFF6.
1622  B7CD              ;   Out: HL = (DIRBUF ptr) + offset.  Clobbers: A,HL.
1623  B7CD              ;   Algorithm: load the buffer base (DIRBUF_PTR), load the 8-bit entry offset (DEBLOCK_BYTE_OFF), add it to L with carry
1624  B7CD              ;       into H (falls into DIRENT_PTR_ADD).
1625  B7CD              ;   [RE] locates the directory entry just matched by a BDOS directory search.
1626  B7CD              ; ----------------------------------------------------------------------
1627  B7CD              FCB_BUF_PTR_ADD_OFFSET:
1628  B7CD 2A C6 BF             LD HL,(DIRBUF_PTR)
1629  B7D0 3A F6 BF             LD A,(DEBLOCK_BYTE_OFF)
1630  B7D3              ; ----------------------------------------------------------------------
1631  B7D3              ; DIRENT_PTR_ADD -- add the 8-bit directory-entry offset in A to HL (carry into H). [RE]
1632  B7D3              ; ----------------------------------------------------------------------
1633  B7D3              DIRENT_PTR_ADD:
1634  B7D3 85                   ADD A,L
1635  B7D4 6F                   LD L,A
1636  B7D5 D0                   RET NC
1637  B7D6 24                   INC H
1638  B7D7 C9                   RET
1639  B7D8              ; ----------------------------------------------------------------------
1640  B7D8              ; FCB_GET_S2 -- point HL at FCB byte 14 (the S2 / extent-high field) of the current FCB.
1641  B7D8              ;   In: current FCB pointer at $DF11 (upper-bank CURFCB cell).
1642  B7D8              ;   Out: HL = (CURFCB $DF11) + $000E (FCB+14, the S2 byte); A = its current value.  Clobbers: A,DE,HL.
1643  B7D8              ;   Algorithm: HL := base + $0E, read (HL) into A.
1644  B7D8              ;   [RE] FCB byte 14 = S2 (extent-high / module count) per CP/M 2.2 FCB layout. [DOC CP/M 2.2 FCB]
1645  B7D8              ; ----------------------------------------------------------------------
1646  B7D8              FCB_GET_S2:
1647  B7D8 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
1648  B7DB 11 0E 00             LD DE,FCB.DIRECTORY_ENTRY.S2
1649  B7DE 19                   ADD HL,DE
1650  B7DF 7E                   LD A,(HL)
1651  B7E0 C9                   RET
1652  B7E1              ; ----------------------------------------------------------------------
1653  B7E1              ; F_MAKE_OPEN_PREP -- shared Open/Make preamble: reset the random-record scratch, clear S2, log in the FCB drive.
1654  B7E1              ;   In: caller's FCB (DE set by the dispatcher; RANDREC_FIELD_RESET stages it into the scratch FCB).
1655  B7E1              ;   Out: the random-record scratch FCB primed, the FCB S2 byte cleared, and the FCB's drive selected
1656  B7E1              ;        (FCB_LOGIN_SELECT).  Clobbers: A,BC,DE,HL.
1657  B7E1              ;   Algorithm: CALL RANDREC_FIELD_RESET; CALL CLEAR_FCB_S2; CALL FCB_LOGIN_SELECT; RET.
1658  B7E1              ;   [RE] common front end of BDOS_F_OPEN (fn 15) and BDOS_F_MAKE (fn 22).
1659  B7E1              ; ----------------------------------------------------------------------
1660  B7E1              F_MAKE_OPEN_PREP:
1661  B7E1 CD A3 BF             CALL RANDREC_FIELD_RESET
1662  B7E4 CD EB B7             CALL CLEAR_FCB_S2
1663  B7E7 CD 77 BE             CALL FCB_LOGIN_SELECT
1664  B7EA C9                   RET
1665  B7EB              ; ----------------------------------------------------------------------
1666  B7EB              ; CLEAR_FCB_S2 -- zero the S2 (byte 14) field of the current FCB.
1667  B7EB              ;   In: the current FCB (via FCB_GET_S2).  Out: FCB byte 14 = 0.  Clobbers: A,DE,HL.
1668  B7EB              ;   Algorithm: get the S2 pointer, store 0.
1669  B7EB              ;   [RE] resets the extent-high/S2 field. [DOC CP/M 2.2 FCB]
1670  B7EB              ; ----------------------------------------------------------------------
1671  B7EB              CLEAR_FCB_S2:
1672  B7EB CD D8 B7             CALL FCB_GET_S2
1673  B7EE 36 00                LD (HL),$00
1674  B7F0 C9                   RET
1675  B7F1              ; ----------------------------------------------------------------------
1676  B7F1              ; MARK_FCB_S2_HIGHBIT -- set bit 7 of the FCB S2 (byte 14) field.
1677  B7F1              ;   In: the current FCB (via FCB_GET_S2, which also returns A = the current S2 value).
1678  B7F1              ;   Out: FCB byte 14 |= $80.  Clobbers: A,DE,HL.
1679  B7F1              ;   Algorithm: get the S2 pointer (A = current S2), OR $80, store back.
1680  B7F1              ;   [RE] in CP/M 2.2 the high bit of S2 flags the FCB as written / needing a directory update at close.
1681  B7F1              ;        [DOC CP/M 2.2 FCB]
1682  B7F1              ; ----------------------------------------------------------------------
1683  B7F1              MARK_FCB_S2_HIGHBIT:
1684  B7F1 CD D8 B7             CALL FCB_GET_S2
1685  B7F4 F6 80                OR $80
1686  B7F6 77                   LD (HL),A
1687  B7F7 C9                   RET
1688  B7F8              ; ----------------------------------------------------------------------
1689  B7F8              ; CMP_CURREC_VS_WORKPTR -- compare the current record number against the working record cell.
1690  B7F8              ;   In: CUR_RECORD = 16-bit current record at $BFF7; the working-record word pointer at (DPB_WORK_PTR0).
1691  B7F8              ;   Out: HL = address of the working value's high byte; flags = (CUR_RECORD - working value);
1692  B7F8              ;        CARRY SET when CUR_RECORD < the working value.  Clobbers: A,DE,HL.
1693  B7F8              ;   Algorithm: DE := (CUR_RECORD $BFF7), HL := (word at $BFC0); subtract low byte then high byte,
1694  B7F8              ;       leaving HL on the high byte; no value is stored.
1695  B7F8              ;   [RE] RECPTR_INC_STORE uses this: on NC it bumps and stores CUR_RECORD+1, extending the high-water
1696  B7F8              ;   count.
1697  B7F8              ; ----------------------------------------------------------------------
1698  B7F8              CMP_CURREC_VS_WORKPTR:
1699  B7F8 2A F7 BF             LD HL,(CUR_RECORD)
1700  B7FB EB                   EX DE,HL
1701  B7FC 2A C0 BF             LD HL,(DPB_WORK_PTR0)
1702  B7FF 7B                   LD A,E
1703  B800 96                   SUB (HL)
1704  B801 23                   INC HL
1705  B802 7A                   LD A,D
1706  B803 9E                   SBC A,(HL)
1707  B804 C9                   RET
1708  B805              ; ----------------------------------------------------------------------
1709  B805              ; RECPTR_INC_STORE -- if the current record is at/past the stored high-water count, bump it one past.
1710  B805              ;   In: CUR_RECORD = record just processed (CUR_RECORD); the working record-count word via (DPB_WORK_PTR0).
1711  B805              ;   Out: if CUR_RECORD >= cell, cell := CUR_RECORD+1; else unchanged. DE = CUR_RECORD(+1 if updated);
1712  B805              ;        HL in cell.  Clobbers: A,DE,HL,flags.
1713  B805              ;   Algorithm: CMP_CURREC_VS_WORKPTR; RET C (CUR_RECORD < count, leave it); else DE:=CUR_RECORD+1 and
1714  B805              ;       write it HIGH byte first (LD (HL),D), DEC HL, then LOW byte (LD (HL),E).
1715  B805              ;   [RE] classic CP/M 2.2 extent record-count bump; keeps the FCB high-water one past the last accessed.
1716  B805              ; ----------------------------------------------------------------------
1717  B805              RECPTR_INC_STORE:
1718  B805 CD F8 B7             CALL CMP_CURREC_VS_WORKPTR
1719  B808 D8                   RET C
1720  B809 13                   INC DE
1721  B80A 72                   LD (HL),D
1722  B80B 2B                   DEC HL
1723  B80C 73                   LD (HL),E
1724  B80D C9                   RET
1725  B80E              ; ----------------------------------------------------------------------
1726  B80E              ; SUB16_DE_HL -- 16-bit subtract HL := DE - HL.
1727  B80E              ;   In: DE = minuend, HL = subtrahend.
1728  B80E              ;   Out: HL = DE - HL; carry set on borrow (DE < HL unsigned).  Clobbers: HL,flags. DE preserved.
1729  B80E              ;   Algorithm: EX DE,HL; OR A (clear carry); SBC HL,DE.
1730  B80E              ;   [RE] general BDOS 16-bit compare/difference helper used by the record scan and seek logic.
1731  B80E              ; ----------------------------------------------------------------------
1732  B80E              SUB16_DE_HL:
1733  B80E EB                   EX DE,HL
1734  B80F B7                   OR A
1735  B810 ED 52                SBC HL,DE
1736  B812 C9                   RET
1737  B813              ; ----------------------------------------------------------------------
1738  B813              ; RECORD_SCAN_BODY -- scan to the target byte in the cached directory record, then store or compare A there.
1739  B813              ;   In: C = mode (INC C wraps to 0 => store mode, else compare); the scan cursor $BFF9 and limit $BFD9;
1740  B813              ;       the entry byte-offset via $BFCA/$BFF9; A = byte to store/compare; DIRBUF holds the record.
1741  B813              ;   Out: store mode writes A. Compare: Z on match; if no match and CUR_RECORD is past the stored count
1742  B813              ;        it flags the drive R/O (BDOS_F_SETRO). NC if the scan cursor did not pass the limit.
1743  B813              ;   Clobbers: A,BC,DE,HL,flags.
1744  B813              ;   Algorithm: DE:=scan cursor (REC_CACHE), HL:=limit (REC_SCAN_PTR); SUB16_DE_HL; RET NC if the cursor passed.
1745  B813              ;       Else DIR_CHECKSUM, add the offset (REC_BYTE_OFFSET) to $BFF9 to address the target byte. INC C: if it
1746  B813              ;       wrapped to 0, store A; else CP (HL), RET Z on match; on mismatch CMP_CURREC_VS_WORKPTR; RET NC
1747  B813              ;       if within count, else BDOS_F_SETRO.
1748  B813              ;   [RE] heart of the directory record scan/checksum loop in the BDOS deblocking layer.
1749  B813              ; ----------------------------------------------------------------------
1750  B813              RECORD_SCAN_BODY:
1751  B813 0E FF                LD C,$FF
1752  B815              RECORD_SCAN_BODY_1:
1753  B815 2A F9 BF             LD HL,(REC_CACHE)
1754  B818 EB                   EX DE,HL
1755  B819 2A D9 BF             LD HL,(REC_SCAN_PTR)
1756  B81C CD 0E B8             CALL SUB16_DE_HL
1757  B81F D0                   RET NC
1758  B820 C5                   PUSH BC
1759  B821 CD 68 B7             CALL DIR_CHECKSUM
1760  B824 2A CA BF             LD HL,(REC_BYTE_OFFSET)
1761  B827 EB                   EX DE,HL
1762  B828 2A F9 BF             LD HL,(REC_CACHE)
1763  B82B 19                   ADD HL,DE
1764  B82C C1                   POP BC
1765  B82D 0C                   INC C
1766  B82E 28 0A                JR Z,RECORD_SCAN_BODY_2
1767  B830 BE                   CP (HL)
1768  B831 C8                   RET Z
1769  B832 CD F8 B7             CALL CMP_CURREC_VS_WORKPTR
1770  B835 D0                   RET NC
1771  B836 CD 9B B7             CALL BDOS_F_SETRO
1772  B839 C9                   RET
1773  B83A              RECORD_SCAN_BODY_2:
1774  B83A 77                   LD (HL),A
1775  B83B C9                   RET
1776  B83C              ; ----------------------------------------------------------------------
1777  B83C              ; DIR_RECORD_WRITE -- checksum-verify then write the directory buffer to disk as a record, and refresh the user buffer.
1778  B83C              ;   In: directory buffer (via DIRBUF ptr $BFC6) and the BDOS deblock state set up by the caller.
1779  B83C              ;   Out: the record is written to disk (with the R/O-on-tamper check); user DMA restored; errors raised
1780  B83C              ;        via the checked disk-write path.  Clobbers: A,BC,DE,HL,flags.
1781  B83C              ;   Algorithm: RECORD_SCAN_BODY runs the scan in store mode (re-checksums DIRBUF, sets the drive R/O on
1782  B83C              ;       a tamper mismatch). SET_DMA_TO_DISK_BUF aims the BIOS DMA at DIRBUF; C=1 selects the directory
1783  B83C              ;       write type; CALL $DF28 (the lower-LC checked-write trampoline) issues the BIOS WRITE; JR into
1784  B83C              ;       RESTORE_USER_DMA restores the user DMA.
1785  B83C              ;   [RE] directory-record write path; C=1 is the CP/M deblock directory-write code.
1786  B83C              ; ----------------------------------------------------------------------
1787  B83C              DIR_RECORD_WRITE:
1788  B83C CD 13 B8             CALL RECORD_SCAN_BODY
1789  B83F CD 54 B8             CALL SET_DMA_TO_DISK_BUF
1790  B842 0E 01                LD C,$01
1791  B844 CD 28 DF             CALL $DF28
1792  B847 18 06                JR RESTORE_USER_DMA
1793  B849              ; ----------------------------------------------------------------------
1794  B849              ; DIR_RECORD_READ -- read a directory record from disk into the directory buffer, then restore the user DMA.
1795  B849              ;   In: BDOS deblock state set up by the caller.
1796  B849              ;   Out: DIRBUF filled from disk; user DMA restored.  Clobbers: A,BC,DE,HL,flags.
1797  B849              ;   Algorithm: SET_DMA_TO_DISK_BUF, CALL $DF20 (the lower-LC checked-read trampoline: BIOS READ +
1798  B849              ;       error check), then fall through into RESTORE_USER_DMA.
1799  B849              ;   [RE] directory-record read path; pairs with DIR_RECORD_WRITE.
1800  B849              ; ----------------------------------------------------------------------
1801  B849              DIR_RECORD_READ:
1802  B849 CD 54 B8             CALL SET_DMA_TO_DISK_BUF
1803  B84C CD 20 DF             CALL $DF20
1804  B84F              ; ----------------------------------------------------------------------
1805  B84F              ; RESTORE_USER_DMA -- restore the BIOS DMA address to the user's DMA buffer.
1806  B84F              ;   In: the DMA_ADDR cell at $BFBE holds the user DMA address.
1807  B84F              ;   Out: BIOS DMA set to (DMA_ADDR) via the BIOS SETDMA vector ($FA24).  Clobbers: BC,HL,flags.
1808  B84F              ;   Algorithm: HL := $BFBE (address of the DMA_ADDR cell), then load the word and JP BIOS SETDMA.
1809  B84F              ;   [RE] used after directory I/O to put DMA back to the application buffer.
1810  B84F              ; ----------------------------------------------------------------------
1811  B84F              RESTORE_USER_DMA:
1812  B84F 21 BE BF             LD HL,DMA_ADDR
1813  B852 18 03                JR SET_DMA_FROM_CELL
1814  B854              ; ----------------------------------------------------------------------
1815  B854              ; SET_DMA_TO_DISK_BUF -- point the BIOS DMA at the directory/disk buffer (DIRBUF).
1816  B854              ;   In: the DIRBUF ptr cell at $BFC6 holds the directory buffer address.
1817  B854              ;   Out: BIOS DMA set to (DIRBUF ptr) via the BIOS SETDMA vector ($FA24).  Clobbers: BC,HL,flags.
1818  B854              ;   Algorithm: HL := $BFC6 (address of the DIRBUF ptr cell); load the word and JP BIOS SETDMA.
1819  B854              ;   [RE] companion to RESTORE_USER_DMA; aims I/O at the OS directory buffer.
1820  B854              ; ----------------------------------------------------------------------
1821  B854              SET_DMA_TO_DISK_BUF:
1822  B854 21 C6 BF             LD HL,DIRBUF_PTR
1823  B857              SET_DMA_FROM_CELL:
1824  B857 4E                   LD C,(HL)
1825  B858 23                   INC HL
1826  B859 46                   LD B,(HL)
1827  B85A C3 24 FA             JP SETDMA
1828  B85D              SET_DMA_TO_DISK_BUF_2:
1829  B85D 2A C6 BF             LD HL,(DIRBUF_PTR)
1830  B860 ED 5B BE BF          LD DE,(DMA_ADDR)
1831  B864 01 80 00             LD BC,$0080
1832  B867 CD 3C DF             CALL $DF3C
1833  B86A C9                   RET
1834  B86B              ; ----------------------------------------------------------------------
1835  B86B              ; CUR_RECORD_BYTES_EQUAL -- test whether the low and high bytes of the 16-bit CUR_RECORD cell (CUR_RECORD) are equal.
1836  B86B              ;   In: CUR_RECORD = a 16-bit cell ($BFF7 low, $BFF8 high).
1837  B86B              ;   Out: if the two bytes differ, NZ with A = the low byte; if equal, A = low byte + 1.  Clobbers: A,HL,flags.
1838  B86B              ;   Algorithm: HL -> low byte (CUR_RECORD); A := (HL); INC HL; CP (HL); RET NZ if they differ; else INC A and RET.
1839  B86B              ;   [RE] deblock helper comparing the two halves of CUR_RECORD; called widely as an end-of-scan test.
1840  B86B              ;        The exact role of the equal/INC result is UNKNOWN from these bytes alone (callers consume Z).
1841  B86B              ; ----------------------------------------------------------------------
1842  B86B              CUR_RECORD_BYTES_EQUAL:
1843  B86B 21 F7 BF             LD HL,CUR_RECORD
1844  B86E 7E                   LD A,(HL)
1845  B86F 23                   INC HL
1846  B870 BE                   CP (HL)
1847  B871 C0                   RET NZ
1848  B872 3C                   INC A
1849  B873 C9                   RET
1850  B874              ; ----------------------------------------------------------------------
1851  B874              ; INVALIDATE_CUR_RECORD -- mark the cached record pointer invalid (CUR_RECORD := $FFFF).
1852  B874              ;   In: none.  Out: CUR_RECORD cell (CUR_RECORD) = $FFFF.  Clobbers: HL.
1853  B874              ;   Algorithm: HL := $FFFF; store to $BFF7; RET.
1854  B874              ;   [RE] forces the next deblock access to reload, since $FFFF can never equal a real record number.
1855  B874              ; ----------------------------------------------------------------------
1856  B874              INVALIDATE_CUR_RECORD:
1857  B874 21 FF FF             LD HL,$FFFF
1858  B877 22 F7 BF             LD (CUR_RECORD),HL
1859  B87A C9                   RET
1860  B87B              ; ----------------------------------------------------------------------
1861  B87B              ; DIR_READ_NEXT -- advance the directory record pointer and read the next 32-byte directory entry.
1862  B87B              ;   In: CUR_RECORD (CUR_RECORD) = last directory record index processed; the directory-record limit word at (DPB_REC_PTR).
1863  B87B              ;   Out: on a fresh 128-byte-record boundary the record is read into DIRBUF and the entry byte-offset
1864  B87B              ;        (DEBLOCK_BYTE_OFF) set to 0/32/64/96; at end of directory CUR_RECORD is invalidated ($FFFF).
1865  B87B              ;   Clobbers: A,BC,DE,HL,flags.
1866  B87B              ;   Algorithm: increment CUR_RECORD; SUB16_DE_HL against the limit (DPB_REC_PTR); if past the limit ->
1867  B87B              ;       INVALIDATE_CUR_RECORD; else offset := (CUR_RECORD & 3) << 5 into $BFF6, and on offset 0 compute
1868  B87B              ;       the disk record (REC_DIV4_SETUP) and DIR_RECORD_READ it into DIRBUF, then re-enter the scan.
1869  B87B              ;   [RE] canonical CP/M 2.2 read-next-directory-entry sequencer (four 32-byte entries per record).
1870  B87B              ; ----------------------------------------------------------------------
1871  B87B              DIR_READ_NEXT:
1872  B87B 2A D5 BF             LD HL,(DPB_REC_PTR)
1873  B87E EB                   EX DE,HL
1874  B87F 2A F7 BF             LD HL,(CUR_RECORD)
1875  B882 23                   INC HL
1876  B883 22 F7 BF             LD (CUR_RECORD),HL
1877  B886 CD 0E B8             CALL SUB16_DE_HL
1878  B889 30 02                JR NC,DIR_RECORD_DEBLOCK
1879  B88B 18 E7                JR INVALIDATE_CUR_RECORD
1880  B88D              DIR_RECORD_DEBLOCK:
1881  B88D 3A F7 BF             LD A,(CUR_RECORD)
1882  B890 E6 03                AND $03
1883  B892 06 05                LD B,$05
1884  B894              DIR_DEBLOCK_SHIFT:
1885  B894 87                   ADD A,A
1886  B895 10 FD                DJNZ DIR_DEBLOCK_SHIFT
1887  B897 32 F6 BF             LD (DEBLOCK_BYTE_OFF),A
1888  B89A B7                   OR A
1889  B89B C0                   RET NZ
1890  B89C C5                   PUSH BC
1891  B89D CD 43 B6             CALL REC_DIV4_SETUP
1892  B8A0 CD 49 B8             CALL DIR_RECORD_READ
1893  B8A3 C1                   POP BC
1894  B8A4 C3 15 B8             JP RECORD_SCAN_BODY_1
1895  B8A7              ; ----------------------------------------------------------------------
1896  B8A7              ; ALLOC_BIT_GET -- fetch the allocation-vector bit for a given disk block, returning it in carry.
1897  B8A7              ;   In: BC = block (group) number; the allocation-vector base pointer at (ALLOC_VEC_PTR).
1898  B8A7              ;   Out: carry/high bit of A = current allocation state; A = the allocation byte rotated so the wanted
1899  B8A7              ;        bit is in the MSB; HL = address of that byte; D = E = bit index.  Clobbers: A,BC,DE,HL,flags.
1900  B8A7              ;   Algorithm: D=E=(block & 7)+1 = 1-based bit index (rotate count); byte index = block >> 3; add to the
1901  B8A7              ;       ALLOC-vec base (ALLOC_VEC_PTR); load the byte and rotate left by the bit index so the selected bit lands
1902  B8A7              ;       in carry/MSB.
1903  B8A7              ;   [RE] canonical CP/M 2.2 getmod: read one allocation bit from the bit-vector.
1904  B8A7              ; ----------------------------------------------------------------------
1905  B8A7              ALLOC_BIT_GET:
1906  B8A7 79                   LD A,C
1907  B8A8 E6 07                AND $07
1908  B8AA 3C                   INC A
1909  B8AB 5F                   LD E,A
1910  B8AC 57                   LD D,A
1911  B8AD 79                   LD A,C
1912  B8AE 0F                   RRCA
1913  B8AF 0F                   RRCA
1914  B8B0 0F                   RRCA
1915  B8B1 E6 1F                AND $1F
1916  B8B3 4F                   LD C,A
1917  B8B4 78                   LD A,B
1918  B8B5 87                   ADD A,A
1919  B8B6 87                   ADD A,A
1920  B8B7 87                   ADD A,A
1921  B8B8 87                   ADD A,A
1922  B8B9 87                   ADD A,A
1923  B8BA B1                   OR C
1924  B8BB 4F                   LD C,A
1925  B8BC 78                   LD A,B
1926  B8BD 0F                   RRCA
1927  B8BE 0F                   RRCA
1928  B8BF 0F                   RRCA
1929  B8C0 E6 1F                AND $1F
1930  B8C2 47                   LD B,A
1931  B8C3 2A CC BF             LD HL,(ALLOC_VEC_PTR)
1932  B8C6 09                   ADD HL,BC
1933  B8C7 7E                   LD A,(HL)
1934  B8C8              ALLOC_BIT_ROTATE:
1935  B8C8 07                   RLCA
1936  B8C9 1D                   DEC E
1937  B8CA 20 FC                JR NZ,ALLOC_BIT_ROTATE
1938  B8CC C9                   RET
1939  B8CD              ; ----------------------------------------------------------------------
1940  B8CD              ; ALLOC_BIT_WRITE -- write one block's allocation-vector bit to a caller-supplied value.
1941  B8CD              ;   In: BC = block (group) number; E = the bit value to store (1 = in use, 0 = free).
1942  B8CD              ;   Out: that block's bit in the allocation vector is set to E. Clobbers: A,BC,DE,HL,flags.
1943  B8CD              ;   Algorithm: PUSH DE saves the caller's value FIRST, because ALLOC_BIT_GET overwrites both
1944  B8CD              ;       D and E with the bit index. ALLOC_BIT_GET returns the byte left-rotated so the target
1945  B8CD              ;       bit is the LSB, HL pointing at it, and D = the rotate count. AND $FE clears that bit,
1946  B8CD              ;       POP BC recovers the saved pair so C is the caller's value, and OR C writes it in;
1947  B8CD              ;       ALLOC_BIT_RESTORE rotates back D times and stores.
1948  B8CD              ;   The bit is NOT forced to 1 -- this is the one primitive for both directions, and which
1949  B8CD              ;   direction it performs is entirely the caller's C. An earlier annotation here read "OR in 1
1950  B8CD              ;   to set the target bit", which made the delete path look like it contradicted its own
1951  B8CD              ;   comment. It does not: F_DELETE passes C=0 and frees, ALLOC_VECTOR_BUILD passes C=1. [RE]
1952  B8CD              ; ----------------------------------------------------------------------
1953  B8CD              ALLOC_BIT_WRITE:
1954  B8CD D5                   PUSH DE
1955  B8CE CD A7 B8             CALL ALLOC_BIT_GET
1956  B8D1 E6 FE                AND $FE
1957  B8D3 C1                   POP BC
1958  B8D4 B1                   OR C
1959  B8D5              ; ----------------------------------------------------------------------
1960  B8D5              ; ALLOC_BIT_RESTORE -- rotate the allocation byte right D times to restore alignment, then store it back. [RE]
1961  B8D5              ; ----------------------------------------------------------------------
1962  B8D5              ALLOC_BIT_RESTORE:
1963  B8D5 0F                   RRCA
1964  B8D6 15                   DEC D
1965  B8D7 20 FC                JR NZ,ALLOC_BIT_RESTORE
1966  B8D9 77                   LD (HL),A
1967  B8DA C9                   RET
1968  B8DB              ; ----------------------------------------------------------------------
1969  B8DB              ; ALLOC_FROM_FCB -- apply a directory entry's block map to the allocation vector.
1970  B8DB              ;   In: C = the bit value to write for each block (1 = in use, 0 = free); it is stashed by
1971  B8DB              ;       PUSH BC and recirculated through DE each iteration, reaching ALLOC_BIT_WRITE in E.
1972  B8DB              ;       In: the entry byte-offset (DEBLOCK_BYTE_OFF) positions HL on the current 32-byte directory entry; block-width
1973  B8DB              ;       flag $BFEA selects 8-bit (non-zero, DSM<256) vs 16-bit (zero) block numbers; entry holds a
1974  B8DB              ;       16-byte block map at offset $10; max block DSM at (MAX_BLOCK_DSM).
1975  B8DB              ;   Out: every non-zero, in-range block of this entry has its allocation bit set to the
1976  B8DB              ;        CALLER'S value -- C=1 marks them in use (directory rebuild), C=0 frees them
1977  B8DB              ;        (F_DELETE). The routine itself is direction-agnostic. Clobbers: A,BC,DE,HL,flags.
1978  B8DB              ;   Algorithm: point HL at the block map (entry+$10); iterate 16 (8-bit) or 8 (16-bit) pointers; read
1979  B8DB              ;       each block number; if non-zero and <= max block (MAX_BLOCK_DSM), mark it allocated via ALLOC_BIT_WRITE.
1980  B8DB              ;   [RE] canonical CP/M 2.2 directory-entry allocation-map application used when rebuilding the alloc vector.
1981  B8DB              ; ----------------------------------------------------------------------
1982  B8DB              ALLOC_FROM_FCB:
1983  B8DB CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
1984  B8DE                      ; a DIRECTORY ENTRY in DIRBUF, not a user FCB: the routine's name is a misnomer,
1985  B8DE                      ; which is what the struct path says here.
1986  B8DE 11 10 00             LD DE,DIRECTORY_ENTRY.AL
1987  B8E1 19                   ADD HL,DE
1988  B8E2 C5                   PUSH BC
1989  B8E3 0E 11                LD C,$11
1990  B8E5              ALLOC_FROM_FCB_LOOP:
1991  B8E5 D1                   POP DE
1992  B8E6 0D                   DEC C
1993  B8E7 C8                   RET Z
1994  B8E8 D5                   PUSH DE
1995  B8E9 3A EA BF             LD A,(BLOCK_WIDTH_FLAG)
1996  B8EC B7                   OR A
1997  B8ED 28 07                JR Z,ALLOC_FROM_FCB_WIDE
1998  B8EF C5                   PUSH BC
1999  B8F0 E5                   PUSH HL
2000  B8F1 4E                   LD C,(HL)
2001  B8F2 06 00                LD B,$00
2002  B8F4 18 06                JR ALLOC_FROM_FCB_CHECK
2003  B8F6              ALLOC_FROM_FCB_WIDE:
2004  B8F6 0D                   DEC C
2005  B8F7 C5                   PUSH BC
2006  B8F8 4E                   LD C,(HL)
2007  B8F9 23                   INC HL
2008  B8FA 46                   LD B,(HL)
2009  B8FB E5                   PUSH HL
2010  B8FC              ALLOC_FROM_FCB_CHECK:
2011  B8FC 79                   LD A,C
2012  B8FD B0                   OR B
2013  B8FE 28 0A                JR Z,ALLOC_FROM_FCB_NEXT
2014  B900 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
2015  B903 7D                   LD A,L
2016  B904 91                   SUB C
2017  B905 7C                   LD A,H
2018  B906 98                   SBC A,B
2019  B907 D4 CD B8             CALL NC,ALLOC_BIT_WRITE
2020  B90A              ALLOC_FROM_FCB_NEXT:
2021  B90A E1                   POP HL
2022  B90B 23                   INC HL
2023  B90C C1                   POP BC
2024  B90D 18 D6                JR ALLOC_FROM_FCB_LOOP
2025  B90F              ; ----------------------------------------------------------------------
2026  B90F              ; ALLOC_VECTOR_BUILD -- rebuild the drive's allocation bit-vector by scanning the entire directory.
2027  B90F              ;   In: selected drive's DPB fields (max block DSM at $BFD3, directory-reserved-blocks word at $BFD7,
2028  B90F              ;       ALLOC-vec base at $BFCC).
2029  B90F              ;   Out: allocation vector fully populated: reserved directory blocks plus every block referenced by a
2030  B90F              ;        non-deleted directory entry are marked used.  Clobbers: A,BC,DE,HL,flags.
2031  B90F              ;   Algorithm: zero the allocation vector across its whole length ((DSM+1)/8 bytes); seed the reserved
2032  B90F              ;       directory blocks (ALLOC_END_PTR); reset the scan workspace to read from the start (DISK_HOME_CLEAR_SCAN);
2033  B90F              ;       for each entry skip deleted ($E5) ones, run the '$' SUBMIT probe against the current user
2034  B90F              ;       (BDOS_USER_NUM) / '$' ($24) name byte (storing into the result cell $DF13), and ALLOC_FROM_FCB to mark
2035  B90F              ;       its blocks; advance until the directory is exhausted.
2036  B90F              ;   [RE] canonical CP/M 2.2 drive-init allocation-vector builder, invoked on drive selection / reset.
2037  B90F              ;   The user-byte / '$' name-byte path sets the BDOS result to $FF when the current user has a
2038  B90F              ;   file whose name begins with '$'. That is DRI's documented fn 13 (Reset Disk System)
2039  B90F              ;   behaviour, which the CCP uses to notice $$$.SUB and resume a SUBMIT batch. Standard DRI
2040  B90F              ;   code, identical in the 2.20 and 2.23 BDOSes; see the 44K twin's header. [RE]
2041  B90F              ; ----------------------------------------------------------------------
2042  B90F              ALLOC_VECTOR_BUILD:
2043  B90F 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
2044  B912 0E 03                LD C,$03
2045  B914 CD 5F B7             CALL SHR_HL_C
2046  B917 23                   INC HL
2047  B918 44                   LD B,H
2048  B919 4D                   LD C,L
2049  B91A 2A CC BF             LD HL,(ALLOC_VEC_PTR)
2050  B91D              ALLOC_VECTOR_CLEAR_LOOP:
2051  B91D 36 00                LD (HL),$00
2052  B91F 23                   INC HL
2053  B920 0B                   DEC BC
2054  B921 78                   LD A,B
2055  B922 B1                   OR C
2056  B923 20 F8                JR NZ,ALLOC_VECTOR_CLEAR_LOOP
2057  B925 2A D7 BF             LD HL,(ALLOC_END_PTR)
2058  B928 EB                   EX DE,HL
2059  B929 2A CC BF             LD HL,(ALLOC_VEC_PTR)
2060  B92C 73                   LD (HL),E
2061  B92D 23                   INC HL
2062  B92E 72                   LD (HL),D
2063  B92F CD 32 B6             CALL DISK_HOME_CLEAR_SCAN
2064  B932 2A C0 BF             LD HL,(DPB_WORK_PTR0)
2065  B935 36 03                LD (HL),$03
2066  B937 23                   INC HL
2067  B938 36 00                LD (HL),$00
2068  B93A CD 74 B8             CALL INVALIDATE_CUR_RECORD
2069  B93D              ALLOC_VECTOR_SCAN_LOOP:
2070  B93D 0E FF                LD C,$FF
2071  B93F CD 7B B8             CALL DIR_READ_NEXT
2072  B942 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2073  B945 C8                   RET Z
2074  B946 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2075  B949 3E E5                LD A,$E5
2076  B94B BE                   CP (HL)
2077  B94C 28 EF                JR Z,ALLOC_VECTOR_SCAN_LOOP
2078  B94E 3A 0F DF             LD A,(BDOS_USER_NUM)
2079  B951 BE                   CP (HL)
2080  B952 20 0A                JR NZ,ALLOC_VECTOR_SCAN_MARK
2081  B954 23                   INC HL
2082  B955 7E                   LD A,(HL)
2083  B956 D6 24                SUB $24
2084  B958 20 04                JR NZ,ALLOC_VECTOR_SCAN_MARK
2085  B95A 3D                   DEC A
2086  B95B 32 13 DF             LD (BDOS_RETVAL),A
2087  B95E              ALLOC_VECTOR_SCAN_MARK:
2088  B95E 0E 01                LD C,$01
2089  B960 CD DB B8             CALL ALLOC_FROM_FCB
2090  B963 CD 05 B8             CALL RECPTR_INC_STORE
2091  B966 C3 3D B9             JP ALLOC_VECTOR_SCAN_LOOP
2092  B969              ; ----------------------------------------------------------------------
2093  B969              ; DIR_RETURN_MATCH_FLAG -- return the saved directory-search match status as the BDOS result.
2094  B969              ;   In: the directory match flag at $BFE1 ($FF=no match, else the 0..3 entry index).
2095  B969              ;   Out: A = (DIR_MATCH_FLAG); stored to the BDOS result byte via the common result-store path ($DED0).  Clobbers: A.
2096  B969              ;   Algorithm: load the cached search-match flag (DIR_MATCH_FLAG) and JP BDOS_RET_RESULT (the upper-bank BDOS_RET_RESULT).
2097  B969              ;   [RE] common return tail of F_DELETE_HND / F_RENAME_HND / F_ATTRIB_HND.
2098  B969              ; ----------------------------------------------------------------------
2099  B969              DIR_RETURN_MATCH_FLAG:
2100  B969 3A E1 BF             LD A,(DIR_MATCH_FLAG)
2101  B96C C3 D0 DE             JP BDOS_RET_RESULT
2102  B96F              ; ----------------------------------------------------------------------
2103  B96F              ; FCB_EXTENT_COMPARE -- compare two FCB extent bytes under the drive's extent mask.
2104  B96F              ;   In: C = one extent byte; A = the other extent byte; DPB EXM mask at $BFD2.
2105  B96F              ;   Out: A,flags = ((A & ~mask) - (C & ~mask)) & $1F; Z set when the high extent fields match.  Clobbers: A (BC/AF saved+restored).
2106  B96F              ;   Algorithm: complement EXM (DPB_EXM), AND it into both extent bytes (dropping the masked low bits),
2107  B96F              ;       subtract, keep five bits, and test for equality.
2108  B96F              ;   [RE]
2109  B96F              ; ----------------------------------------------------------------------
2110  B96F              FCB_EXTENT_COMPARE:
2111  B96F C5                   PUSH BC
2112  B970 F5                   PUSH AF
2113  B971 3A D2 BF             LD A,(DPB_EXM)
2114  B974 2F                   CPL
2115  B975 47                   LD B,A
2116  B976 79                   LD A,C
2117  B977 A0                   AND B
2118  B978 4F                   LD C,A
2119  B979 F1                   POP AF
2120  B97A A0                   AND B
2121  B97B 91                   SUB C
2122  B97C E6 1F                AND $1F
2123  B97E C1                   POP BC
2124  B97F C9                   RET
2125  B980              ; ----------------------------------------------------------------------
2126  B980              ; DIR_SEARCH_FIRST -- begin a directory scan for the current FCB, comparing C bytes per entry.
2127  B980              ;   In: C = number of FCB bytes to match ($0C=name+type, $0F=incl. extent); current FCB at $DF11.
2128  B980              ;   Out: falls through into BDOS_DIR_SCAN_NEXT, which returns the within-record entry index 0..3 or $FF.
2129  B980              ;   Clobbers: A,B,C,D,E,H,L,flags.
2130  B980              ;   Algorithm: set the match flag $BFE1=$FF, store the compare length (DIR_CMP_LEN) and search-FCB pointer
2131  B980              ;       (DIR_FCB_PTR), reset the record counter to -1 (INVALIDATE_CUR_RECORD), rewind/clear the scan state
2132  B980              ;       (DISK_HOME_CLEAR_SCAN), then run the first pass.
2133  B980              ;   [RE]
2134  B980              ; ----------------------------------------------------------------------
2135  B980              DIR_SEARCH_FIRST:
2136  B980 3E FF                LD A,$FF
2137  B982 32 E1 BF             LD (DIR_MATCH_FLAG),A
2138  B985 21 E5 BF             LD HL,DIR_CMP_LEN
2139  B988 71                   LD (HL),C
2140  B989 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2141  B98C 22 E6 BF             LD (DIR_FCB_PTR),HL
2142  B98F CD 74 B8             CALL INVALIDATE_CUR_RECORD
2143  B992 CD 32 B6             CALL DISK_HOME_CLEAR_SCAN
2144  B995              ; ----------------------------------------------------------------------
2145  B995              ; BDOS_DIR_SCAN_NEXT -- advance through directory entries until one matches the search FCB.
2146  B995              ;   In: search-FCB pointer at $BFE6; compare length at $BFE5.
2147  B995              ;   Out: A = matching entry index (0..3, stored to result cell $DF13) on success; not-found via the
2148  B995              ;        $FF result path.  Clobbers: A,B,C,D,E,H,L,flags.
2149  B995              ;   Algorithm: step to the next directory record (DIR_READ_NEXT); if the counter passed the directory
2150  B995              ;       limit -> not found; otherwise treat erased ($E5) entries specially and bound-check
2151  B995              ;       (CMP_CURREC_VS_WORKPTR), then compare C bytes per entry (with '?' $3F wildcards and EXM-masked
2152  B995              ;       extent compare); on full match -> return the index, else loop to the next entry/record.
2153  B995              ;   [RE] standard CP/M 2.2 directory search-next with '?' wildcards.
2154  B995              ; ----------------------------------------------------------------------
2155  B995              BDOS_DIR_SCAN_NEXT:
2156  B995 0E 00                LD C,$00
2157  B997 CD 7B B8             CALL DIR_READ_NEXT
2158  B99A CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2159  B99D 28 52                JR Z,DIR_NO_MATCH
2160  B99F 2A E6 BF             LD HL,(DIR_FCB_PTR)
2161  B9A2 EB                   EX DE,HL
2162  B9A3 1A                   LD A,(DE)
2163  B9A4 FE E5                CP $E5
2164  B9A6 28 07                JR Z,BDOS_DIR_SCAN_NEXT_CMP
2165  B9A8 D5                   PUSH DE
2166  B9A9 CD F8 B7             CALL CMP_CURREC_VS_WORKPTR
2167  B9AC D1                   POP DE
2168  B9AD 30 42                JR NC,DIR_NO_MATCH
2169  B9AF              BDOS_DIR_SCAN_NEXT_CMP:
2170  B9AF CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2171  B9B2 3A E5 BF             LD A,(DIR_CMP_LEN)
2172  B9B5 4F                   LD C,A
2173  B9B6 06 00                LD B,$00
2174  B9B8              DIR_CMP_BYTE_LOOP:
2175  B9B8 79                   LD A,C
2176  B9B9 B7                   OR A
2177  B9BA 28 24                JR Z,DIR_MATCH_FOUND
2178  B9BC 1A                   LD A,(DE)
2179  B9BD FE 3F                CP $3F
2180  B9BF 28 19                JR Z,DIR_CMP_ADVANCE
2181  B9C1 78                   LD A,B
2182  B9C2 FE 0D                CP $0D
2183  B9C4 28 14                JR Z,DIR_CMP_ADVANCE
2184  B9C6 FE 0C                CP $0C
2185  B9C8 1A                   LD A,(DE)
2186  B9C9 28 07                JR Z,DIR_CMP_EXTENT
2187  B9CB 96                   SUB (HL)
2188  B9CC E6 7F                AND $7F
2189  B9CE 20 C5                JR NZ,BDOS_DIR_SCAN_NEXT
2190  B9D0 18 08                JR DIR_CMP_ADVANCE
2191  B9D2              DIR_CMP_EXTENT:
2192  B9D2 C5                   PUSH BC
2193  B9D3 4E                   LD C,(HL)
2194  B9D4 CD 6F B9             CALL FCB_EXTENT_COMPARE
2195  B9D7 C1                   POP BC
2196  B9D8 20 BB                JR NZ,BDOS_DIR_SCAN_NEXT
2197  B9DA              DIR_CMP_ADVANCE:
2198  B9DA 13                   INC DE
2199  B9DB 23                   INC HL
2200  B9DC 04                   INC B
2201  B9DD 0D                   DEC C
2202  B9DE 18 D8                JR DIR_CMP_BYTE_LOOP
2203  B9E0              DIR_MATCH_FOUND:
2204  B9E0 3A F7 BF             LD A,(CUR_RECORD)
2205  B9E3 E6 03                AND $03
2206  B9E5 32 13 DF             LD (BDOS_RETVAL),A
2207  B9E8 21 E1 BF             LD HL,DIR_MATCH_FLAG
2208  B9EB 7E                   LD A,(HL)
2209  B9EC 17                   RLA
2210  B9ED D0                   RET NC
2211  B9EE AF                   XOR A
2212  B9EF 77                   LD (HL),A
2213  B9F0 C9                   RET
2214  B9F1              DIR_NO_MATCH:
2215  B9F1 CD 74 B8             CALL INVALIDATE_CUR_RECORD
2216  B9F4 3E FF                LD A,$FF
2217  B9F6 C3 D0 DE             JP BDOS_RET_RESULT
2218  B9F9              ; ----------------------------------------------------------------------
2219  B9F9              ; F_DELETE_HND -- delete every directory entry matching the FCB (worker for BDOS function 19).
2220  B9F9              ;   In: current FCB at $DF11 (may contain '?' wildcards).
2221  B9F9              ;   Out: matching directory entries marked erased ($E5), their blocks freed, and written back.
2222  B9F9              ;   Clobbers: A,B,C,D,E,H,L,flags.
2223  B9F9              ;   Algorithm: CHECK_DRIVE_READONLY, DIR_SEARCH_FIRST on 12 FCB bytes (name+type), then loop: for each
2224  B9F9              ;       match test the R/O flag (FCB_RO_FLAG_TEST), stamp the entry byte $E5, free its blocks
2225  B9F9              ;       (ALLOC_FROM_FCB with C=0), DIR_RECORD_WRITE, BDOS_DIR_SCAN_NEXT.
2226  B9F9              ;   [RE] CP/M 2.2 F_DELETE.
2227  B9F9              ; ----------------------------------------------------------------------
2228  B9F9              F_DELETE_HND:
2229  B9F9 CD C3 B7             CALL CHECK_DRIVE_READONLY
2230  B9FC 0E 0C                LD C,$0C
2231  B9FE CD 80 B9             CALL DIR_SEARCH_FIRST
2232  BA01              F_DELETE_LOOP:
2233  BA01 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2234  BA04 C8                   RET Z
2235  BA05 CD B3 B7             CALL FCB_RO_FLAG_TEST
2236  BA08 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2237  BA0B 36 E5                LD (HL),$E5
2238  BA0D 0E 00                LD C,$00
2239  BA0F CD DB B8             CALL ALLOC_FROM_FCB
2240  BA12 CD 3C B8             CALL DIR_RECORD_WRITE
2241  BA15 CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
2242  BA18 18 E7                JR F_DELETE_LOOP
2243  BA1A              ; ----------------------------------------------------------------------
2244  BA1A              ; ALLOC_GET_BLOCK -- find/allocate a disk block near a starting block, marking it used.
2245  BA1A              ;   In: BC = starting block number (passed by the write core when extending a file); max block DSM at (MAX_BLOCK_DSM).
2246  BA1A              ;   Out: HL = the block number actually claimed (0 if none free); its allocation-vector bit set.  Clobbers: A,B,C,D,E,H,L,flags.
2247  BA1A              ;   Algorithm: copy the start block to DE, scan downward then upward testing each block's allocation bit
2248  BA1A              ;       (ALLOC_BIT_GET), bounded by max block (MAX_BLOCK_DSM); mark the chosen block used (ALLOC_BIT_RESTORE)
2249  BA1A              ;       and return it, or 0 when no block can be allocated.
2250  BA1A              ;   [RE] allocation-vector block search/allocate.
2251  BA1A              ; ----------------------------------------------------------------------
2252  BA1A              ALLOC_GET_BLOCK:
2253  BA1A 50                   LD D,B
2254  BA1B 59                   LD E,C
2255  BA1C              ALLOC_SCAN_DOWN:
2256  BA1C 79                   LD A,C
2257  BA1D B0                   OR B
2258  BA1E 28 0B                JR Z,ALLOC_SCAN_UP
2259  BA20 0B                   DEC BC
2260  BA21 D5                   PUSH DE
2261  BA22 C5                   PUSH BC
2262  BA23 CD A7 B8             CALL ALLOC_BIT_GET
2263  BA26 1F                   RRA
2264  BA27 30 1A                JR NC,ALLOC_MARK_DONE
2265  BA29 C1                   POP BC
2266  BA2A D1                   POP DE
2267  BA2B              ALLOC_SCAN_UP:
2268  BA2B 2A D3 BF             LD HL,(MAX_BLOCK_DSM)
2269  BA2E 7B                   LD A,E
2270  BA2F 95                   SUB L
2271  BA30 7A                   LD A,D
2272  BA31 9C                   SBC A,H
2273  BA32 30 17                JR NC,ALLOC_SCAN_FINISH
2274  BA34 13                   INC DE
2275  BA35 C5                   PUSH BC
2276  BA36 D5                   PUSH DE
2277  BA37 42                   LD B,D
2278  BA38 4B                   LD C,E
2279  BA39 CD A7 B8             CALL ALLOC_BIT_GET
2280  BA3C 1F                   RRA
2281  BA3D 30 04                JR NC,ALLOC_MARK_DONE
2282  BA3F D1                   POP DE
2283  BA40 C1                   POP BC
2284  BA41 18 D9                JR ALLOC_SCAN_DOWN
2285  BA43              ALLOC_MARK_DONE:
2286  BA43 17                   RLA
2287  BA44 3C                   INC A
2288  BA45 CD D5 B8             CALL ALLOC_BIT_RESTORE
2289  BA48 E1                   POP HL
2290  BA49 D1                   POP DE
2291  BA4A C9                   RET
2292  BA4B              ALLOC_SCAN_FINISH:
2293  BA4B 79                   LD A,C
2294  BA4C B0                   OR B
2295  BA4D 20 CD                JR NZ,ALLOC_SCAN_DOWN
2296  BA4F 21 00 00             LD HL,$0000
2297  BA52 C9                   RET
2298  BA53              ; ----------------------------------------------------------------------
2299  BA53              ; FCB_WRITE_DIR_ENTRY -- copy the whole 32-byte FCB image into the matched directory entry and write it.
2300  BA53              ;   In: current FCB at $DF11; sets C=0 (FCB offset 0), E=$20 (32 bytes).
2301  BA53              ;   Out: directory record holding this entry written back to disk.  Clobbers: A,B,C,D,E,H,L,flags.
2302  BA53              ;   Algorithm: set up a full-32-byte copy at FCB offset 0 and fall into FCB_COPY_TO_DIR.
2303  BA53              ;   [RE]
2304  BA53              ; ----------------------------------------------------------------------
2305  BA53              FCB_WRITE_DIR_ENTRY:
2306  BA53 0E 00                LD C,$00
2307  BA55 1E 20                LD E,$20
2308  BA57              ; ----------------------------------------------------------------------
2309  BA57              ; FCB_COPY_TO_DIR -- copy E FCB bytes (from offset C) into the matched directory entry.
2310  BA57              ;   In: C = FCB byte offset; E = byte count; current FCB at $DF11; current matched dir entry.
2311  BA57              ;   Out: directory buffer updated, then the record written via FCB_FLUSH_DIR.  Clobbers: A,B,C,D,E,H,L,flags.
2312  BA57              ;   Algorithm: form a source pointer at FCB+C ($DF11 + C), point HL at the directory entry slot
2313  BA57              ;       (FCB_BUF_PTR_ADD_OFFSET), block-copy E bytes, then fall into FCB_FLUSH_DIR to commit the record.
2314  BA57              ;   [RE]
2315  BA57              ; ----------------------------------------------------------------------
2316  BA57              FCB_COPY_TO_DIR:
2317  BA57 D5                   PUSH DE
2318  BA58 06 00                LD B,$00
2319  BA5A 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2320  BA5D 09                   ADD HL,BC
2321  BA5E EB                   EX DE,HL
2322  BA5F CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2323  BA62 C1                   POP BC
2324  BA63 06 00                LD B,$00
2325  BA65 EB                   EX DE,HL
2326  BA66 ED B0                LDIR
2327  BA68              ; ----------------------------------------------------------------------
2328  BA68              ; FCB_FLUSH_DIR -- position to the directory record and write it back.
2329  BA68              ;   In: current directory record state from the preceding match.  Out: the directory record written to disk.
2330  BA68              ;   Clobbers: A,B,C,D,E,H,L,flags.
2331  BA68              ;   Algorithm: REC_DIV4_SETUP positions on the 128-byte record holding the entry, then tail-jump to
2332  BA68              ;       DIR_RECORD_WRITE.
2333  BA68              ;   [RE]
2334  BA68              ; ----------------------------------------------------------------------
2335  BA68              FCB_FLUSH_DIR:
2336  BA68 CD 43 B6             CALL REC_DIV4_SETUP
2337  BA6B C3 3C B8             JP DIR_RECORD_WRITE
2338  BA6E              ; ----------------------------------------------------------------------
2339  BA6E              ; F_RENAME_HND -- rename a file: replace matching directory entries with the new name (worker for BDOS fn 23).
2340  BA6E              ;   In: current FCB at $DF11 whose bytes 0..15 are the old name and bytes 16..31 the new name.
2341  BA6E              ;   Out: every matching directory entry rewritten with the new name; read-only entries rejected.
2342  BA6E              ;   Clobbers: A,B,C,D,E,H,L,flags.
2343  BA6E              ;   Algorithm: CHECK_DRIVE_READONLY, DIR_SEARCH_FIRST on 12 bytes of the old name, copy the FCB drive
2344  BA6E              ;       byte (offset 0) into the new-name half (offset 16) so both target the same drive, then loop:
2345  BA6E              ;       R/O-test each match and FCB_COPY_TO_DIR of 12 bytes from FCB offset $10 into the entry.
2346  BA6E              ;   [RE] CP/M 2.2 F_RENAME.
2347  BA6E              ; ----------------------------------------------------------------------
2348  BA6E              F_RENAME_HND:
2349  BA6E CD C3 B7             CALL CHECK_DRIVE_READONLY
2350  BA71 0E 0C                LD C,$0C
2351  BA73 CD 80 B9             CALL DIR_SEARCH_FIRST
2352  BA76 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2353  BA79 7E                   LD A,(HL)
2354  BA7A                      ; offset 16: the NEW-name half of a rename FCB. F_RENAME overloads bytes 16-31 as a
2355  BA7A                      ; second filename, so this is NOT the allocation map despite the identical offset.
2356  BA7A 11 10 00             LD DE,$0010
2357  BA7D 19                   ADD HL,DE
2358  BA7E 77                   LD (HL),A
2359  BA7F              F_RENAME_LOOP:
2360  BA7F CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2361  BA82 C8                   RET Z
2362  BA83 CD B3 B7             CALL FCB_RO_FLAG_TEST
2363  BA86 0E 10                LD C,$10
2364  BA88 1E 0C                LD E,$0C
2365  BA8A CD 57 BA             CALL FCB_COPY_TO_DIR
2366  BA8D CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
2367  BA90 18 ED                JR F_RENAME_LOOP
2368  BA92              ; ----------------------------------------------------------------------
2369  BA92              ; F_ATTRIB_HND -- set file attributes from the FCB into matching directory entries (worker for BDOS fn 30).
2370  BA92              ;   In: current FCB at $DF11 carrying the attribute high bits in the name/type bytes.
2371  BA92              ;   Out: every matching directory entry's first 12 bytes rewritten with the FCB's attribute bits.
2372  BA92              ;   Clobbers: A,B,C,D,E,H,L,flags.
2373  BA92              ;   Algorithm: DIR_SEARCH_FIRST on 12 bytes, then loop FCB_COPY_TO_DIR of the 12 name/type bytes (with
2374  BA92              ;       attribute high bits) from FCB offset 0 into each matched entry and write the record.
2375  BA92              ;   [RE] CP/M 2.2 F_ATTRIB.
2376  BA92              ; ----------------------------------------------------------------------
2377  BA92              F_ATTRIB_HND:
2378  BA92 0E 0C                LD C,$0C
2379  BA94 CD 80 B9             CALL DIR_SEARCH_FIRST
2380  BA97              F_ATTRIB_LOOP:
2381  BA97 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2382  BA9A C8                   RET Z
2383  BA9B 0E 00                LD C,$00
2384  BA9D 1E 0C                LD E,$0C
2385  BA9F CD 57 BA             CALL FCB_COPY_TO_DIR
2386  BAA2 CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
2387  BAA5 18 F0                JR F_ATTRIB_LOOP
2388  BAA7              ; ----------------------------------------------------------------------
2389  BAA7              ; FILE_OPEN_SEARCH -- search-first for the FCB's extent and merge the directory entry into the FCB.
2390  BAA7              ;   In: current FCB at $DF11. Core of BDOS_F_OPEN (fn 15) and the random-record extent-positioning path.
2391  BAA7              ;   Out: on match, the matched entry is merged into the FCB (record-count fields filled, FILE_SIZE_FROM_EXTENT);
2392  BAA7              ;        on no match returns Z with no merge.  Clobbers: A,B,C,D,E,H,L,flags.
2393  BAA7              ;   Algorithm: DIR_SEARCH_FIRST on 15 bytes (name+type+extent); CUR_RECORD_BYTES_EQUAL; if not found
2394  BAA7              ;       return Z; otherwise fall through into FILE_SIZE_FROM_EXTENT to copy the entry into the FCB and set the
2395  BAA7              ;       record count.
2396  BAA7              ;   [RE] CP/M 2.2 F_OPEN core / extent locate-and-merge.
2397  BAA7              ; ----------------------------------------------------------------------
2398  BAA7              FILE_OPEN_SEARCH:
2399  BAA7 0E 0F                LD C,$0F
2400  BAA9 CD 80 B9             CALL DIR_SEARCH_FIRST
2401  BAAC CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2402  BAAF C8                   RET Z
2403  BAB0              ; ----------------------------------------------------------------------
2404  BAB0              ; FILE_SIZE_FROM_EXTENT -- merge a matched directory entry into the FCB and update its record count.
2405  BAB0              ;   In: HL positioned via FCB_PTR_EXTENT on the FCB extent byte; current FCB at $DF11; the matched dir entry.
2406  BAB0              ;   Out: the 32-byte entry copied into the FCB image; the FCB's record-count byte (offset $0F) set to $00
2407  BAB0              ;        if this extent is below the current one, RC if equal, $80 if above; S2 'written' bit set.
2408  BAB0              ;   Clobbers: A,B,C,D,E,H,L,flags.
2409  BAB0              ;   Algorithm: save the FCB extent byte; FCB_BUF_PTR_ADD_OFFSET -> the dir entry; LDIR 32 bytes into the
2410  BAB0              ;       FCB (BDOS_PARAM_PTR); MARK_FCB_S2_HIGHBIT; read dir-entry EX (offset $0C) and RC (offset $0F), compare
2411  BAB0              ;       against the saved FCB extent, and store the chosen record-count byte at FCB+$0F.
2412  BAB0              ;   [RE] used by both F_OPEN (FILE_OPEN_SEARCH) and F_SIZE. Twin of the 44K FILE_SIZE_FROM_EXTENT.
2413  BAB0              ; ----------------------------------------------------------------------
2414  BAB0              FILE_SIZE_FROM_EXTENT:
2415  BAB0 CD 1C B7             CALL FCB_PTR_EXTENT
2416  BAB3 7E                   LD A,(HL)
2417  BAB4 F5                   PUSH AF
2418  BAB5 E5                   PUSH HL
2419  BAB6 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2420  BAB9 ED 5B 11 DF          LD DE,(BDOS_PARAM_PTR)
2421  BABD 01 20 00             LD BC,$0020
2422  BAC0 D5                   PUSH DE
2423  BAC1 ED B0                LDIR
2424  BAC3 CD F1 B7             CALL MARK_FCB_S2_HIGHBIT
2425  BAC6 D1                   POP DE
2426  BAC7 21 0C 00             LD HL,DIRECTORY_ENTRY.EX
2427  BACA 19                   ADD HL,DE
2428  BACB 4E                   LD C,(HL)
2429  BACC 21 0F 00             LD HL,DIRECTORY_ENTRY.RC
2430  BACF 19                   ADD HL,DE
2431  BAD0 46                   LD B,(HL)
2432  BAD1 E1                   POP HL
2433  BAD2 F1                   POP AF
2434  BAD3 77                   LD (HL),A
2435  BAD4 79                   LD A,C
2436  BAD5 BE                   CP (HL)
2437  BAD6 78                   LD A,B
2438  BAD7 28 06                JR Z,FILE_SIZE_STORE
2439  BAD9 3E 00                LD A,$00
2440  BADB 38 02                JR C,FILE_SIZE_STORE
2441  BADD 3E 80                LD A,$80
2442  BADF              FILE_SIZE_STORE:
2443  BADF 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2444  BAE2 11 0F 00             LD DE,FCB.DIRECTORY_ENTRY.RC
2445  BAE5 19                   ADD HL,DE
2446  BAE6 77                   LD (HL),A
2447  BAE7 C9                   RET
2448  BAE8              ; ----------------------------------------------------------------------
2449  BAE8              ; FCB_WORD_FILL_IF_ZERO -- copy a 16-bit word from (DE) to (HL) only when (HL) is currently zero.
2450  BAE8              ;   In: HL -> destination word; DE -> source word.
2451  BAE8              ;   Out: if the destination word was 0, it is overwritten with the source word; DE,HL preserved.  Clobbers: A,flags.
2452  BAE8              ;   Algorithm: OR the two destination bytes; if non-zero return unchanged; otherwise copy both source
2453  BAE8              ;       bytes across, restoring DE/HL to their entry values.
2454  BAE8              ;   [RE] allocation-word merge helper used during F_CLOSE_HND.
2455  BAE8              ; ----------------------------------------------------------------------
2456  BAE8              FCB_WORD_FILL_IF_ZERO:
2457  BAE8 7E                   LD A,(HL)
2458  BAE9 23                   INC HL
2459  BAEA B6                   OR (HL)
2460  BAEB 2B                   DEC HL
2461  BAEC C0                   RET NZ
2462  BAED 1A                   LD A,(DE)
2463  BAEE 77                   LD (HL),A
2464  BAEF 13                   INC DE
2465  BAF0 23                   INC HL
2466  BAF1 1A                   LD A,(DE)
2467  BAF2 77                   LD (HL),A
2468  BAF3 1B                   DEC DE
2469  BAF4 2B                   DEC HL
2470  BAF5 C9                   RET
2471  BAF6              ; ----------------------------------------------------------------------
2472  BAF6              ; F_CLOSE_HND -- close a file: merge the in-memory FCB into its directory entry (worker for BDOS fn 16).
2473  BAF6              ;   In: current FCB at $DF11. Also used internally to flush an extent.
2474  BAF6              ;   Out: directory entry updated with this FCB's allocation map / record count; result byte (BDOS_RETVAL) set.
2475  BAF6              ;   Clobbers: A,B,C,D,E,H,L,flags.
2476  BAF6              ;   Algorithm: zero the result byte (BDOS_RETVAL) and record state, verify the drive is selected (DRIVE_BIT_TEST)
2477  BAF6              ;       and the FCB S2 high bit is clear; DIR_SEARCH_FIRST on the extent (15 bytes); if found, merge the
2478  BAF6              ;       FCB's 16-byte allocation map into the entry (filling zero words via FCB_WORD_FILL_IF_ZERO, keeping
2479  BAF6              ;       the larger record count) then flush (FCB_FLUSH_DIR).
2480  BAF6              ;   [RE] CP/M 2.2 F_CLOSE.
2481  BAF6              ; ----------------------------------------------------------------------
2482  BAF6              F_CLOSE_HND:
2483  BAF6 AF                   XOR A
2484  BAF7 32 13 DF             LD (BDOS_RETVAL),A
2485  BAFA 32 F7 BF             LD (CUR_RECORD),A
2486  BAFD 32 F8 BF             LD (CUR_RECORD_HI),A
2487  BB00 CD 8D B7             CALL DRIVE_BIT_TEST
2488  BB03 C0                   RET NZ
2489  BB04 CD D8 B7             CALL FCB_GET_S2
2490  BB07 E6 80                AND $80
2491  BB09 C0                   RET NZ
2492  BB0A 0E 0F                LD C,$0F
2493  BB0C CD 80 B9             CALL DIR_SEARCH_FIRST
2494  BB0F CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2495  BB12 C8                   RET Z
2496  BB13                      ; The allocation map, +$10 into BOTH structures. BC is set once and reused for a
2497  BB13                      ; DIRECTORY ENTRY (via FCB_BUF_PTR_ADD_OFFSET) and then for the FCB, which is
2498  BB13                      ; correct precisely because an FCB embeds a directory entry at offset 0, so
2499  BB13                      ; DIRECTORY_ENTRY.AL and FCB.DIRECTORY_ENTRY.AL are the same number. The two
2500  BB13                      ; pointers are then compared map byte by map byte.
2501  BB13 01 10 00             LD BC,DIRECTORY_ENTRY.AL
2502  BB16 CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
2503  BB19 09                   ADD HL,BC
2504  BB1A EB                   EX DE,HL
2505  BB1B 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2506  BB1E 09                   ADD HL,BC
2507  BB1F 0E 10                LD C,$10
2508  BB21              FCB_MERGE_MAP_LOOP:
2509  BB21 3A EA BF             LD A,(BLOCK_WIDTH_FLAG)
2510  BB24 B7                   OR A
2511  BB25 28 10                JR Z,FCB_MERGE_WORD
2512  BB27 7E                   LD A,(HL)
2513  BB28 B7                   OR A
2514  BB29 1A                   LD A,(DE)
2515  BB2A 20 01                JR NZ,F_CLOSE_HND_2
2516  BB2C 77                   LD (HL),A
2517  BB2D              F_CLOSE_HND_2:
2518  BB2D B7                   OR A
2519  BB2E 20 02                JR NZ,F_CLOSE_HND_3
2520  BB30 7E                   LD A,(HL)
2521  BB31 12                   LD (DE),A
2522  BB32              F_CLOSE_HND_3:
2523  BB32 BE                   CP (HL)
2524  BB33 20 35                JR NZ,FCB_DEC_RESULT
2525  BB35 18 13                JR FCB_MERGE_NEXT
2526  BB37              FCB_MERGE_WORD:
2527  BB37 CD E8 BA             CALL FCB_WORD_FILL_IF_ZERO
2528  BB3A EB                   EX DE,HL
2529  BB3B CD E8 BA             CALL FCB_WORD_FILL_IF_ZERO
2530  BB3E EB                   EX DE,HL
2531  BB3F 1A                   LD A,(DE)
2532  BB40 BE                   CP (HL)
2533  BB41 20 27                JR NZ,FCB_DEC_RESULT
2534  BB43 13                   INC DE
2535  BB44 23                   INC HL
2536  BB45 1A                   LD A,(DE)
2537  BB46 BE                   CP (HL)
2538  BB47 20 21                JR NZ,FCB_DEC_RESULT
2539  BB49 0D                   DEC C
2540  BB4A              FCB_MERGE_NEXT:
2541  BB4A 13                   INC DE
2542  BB4B 23                   INC HL
2543  BB4C 0D                   DEC C
2544  BB4D 20 D2                JR NZ,FCB_MERGE_MAP_LOOP
2545  BB4F                      ; Back up from the END of the entry to EX. TRACED, both statically and at runtime:
2546  BB4F                      ; the map loop leaves the pointers at base+32 on BOTH paths (the 8-bit path does one
2547  BB4F                      ; INC HL and one DEC C per slot, 16 slots; the 16-bit path does two of each per slot,
2548  BB4F                      ; 8 slots), so -20 reaches offset 12, which is EX -- NOT the record count at 15.
2549  BB4F                      ; Verified in the emulator: at this instruction HL-20 == BDOS_PARAM_PTR+12 exactly,
2550  BB4F                      ; and the byte there matched the FCB's EX and not its RC. An earlier comment here
2551  BB4F                      ; called it "the record-count field", the same EX/RC confusion corrected elsewhere
2552  BB4F                      ; in this file. The +3 step further down then moves EX -> RC, which is only coherent
2553  BB4F                      ; if this landing really is EX.
2554  BB4F                      ; (The 16-bit path is unreachable on SoftCard hardware: every DSM here is <= 139, so
2555  BB4F                      ; block numbers are always 8-bit. It is traced above for completeness, not observed.)
2556  BB4F 01 EC FF             LD BC,DIRECTORY_ENTRY.EX - DIRECTORY_ENTRY
2557  BB52 09                   ADD HL,BC
2558  BB53 EB                   EX DE,HL
2559  BB54 09                   ADD HL,BC
2560  BB55 1A                   LD A,(DE)
2561  BB56 BE                   CP (HL)
2562  BB57 38 09                JR C,FCB_MERGE_FINISH
2563  BB59 77                   LD (HL),A
2564  BB5A                      ; step from EX to RC, as arithmetic on the field names
2565  BB5A 01 03 00             LD BC,DIRECTORY_ENTRY.RC - DIRECTORY_ENTRY.EX
2566  BB5D 09                   ADD HL,BC
2567  BB5E EB                   EX DE,HL
2568  BB5F 09                   ADD HL,BC
2569  BB60 7E                   LD A,(HL)
2570  BB61 12                   LD (DE),A
2571  BB62              FCB_MERGE_FINISH:
2572  BB62 3E FF                LD A,$FF
2573  BB64 32 DF BF             LD (DIR_DIRTY_FLAG),A
2574  BB67 C3 68 BA             JP FCB_FLUSH_DIR
2575  BB6A              FCB_DEC_RESULT:
2576  BB6A 21 13 DF             LD HL,BDOS_RETVAL
2577  BB6D 35                   DEC (HL)
2578  BB6E C9                   RET
2579  BB6F              ; ----------------------------------------------------------------------
2580  BB6F              ; DIR_MAKE_ENTRY -- find a free directory slot and create a new (empty) entry for the FCB (worker for BDOS fn 22).
2581  BB6F              ;   In: current FCB at $DF11.
2582  BB6F              ;   Out: a free directory slot located and initialized for this file; returns Z if no slot is free.
2583  BB6F              ;   Clobbers: A,B,C,D,E,H,L,flags.
2584  BB6F              ;   Algorithm: CHECK_DRIVE_READONLY, temporarily redirect the FCB pointer (BDOS_PARAM_PTR) to the scratch
2585  BB6F              ;       EMPTY_DIR_FCB and DIR_SEARCH_FIRST in mode 1 for an empty ($E5) slot, restore the FCB pointer; on
2586  BB6F              ;       success zero 17 bytes of the entry's record/allocation area (from offset $0F), clear the S1 byte
2587  BB6F              ;       (offset $0D), advance the record pointer (RECPTR_INC_STORE), write the new entry
2588  BB6F              ;       (FCB_WRITE_DIR_ENTRY), and set the FCB S2 'written' flag.
2589  BB6F              ;   [RE] make-directory-entry helper.
2590  BB6F              ; ----------------------------------------------------------------------
2591  BB6F              DIR_MAKE_ENTRY:
2592  BB6F CD C3 B7             CALL CHECK_DRIVE_READONLY
2593  BB72 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2594  BB75 E5                   PUSH HL
2595  BB76 21 B9 BF             LD HL,EMPTY_DIR_FCB
2596  BB79 22 11 DF             LD (BDOS_PARAM_PTR),HL
2597  BB7C 0E 01                LD C,$01
2598  BB7E CD 80 B9             CALL DIR_SEARCH_FIRST
2599  BB81 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2600  BB84 E1                   POP HL
2601  BB85 22 11 DF             LD (BDOS_PARAM_PTR),HL
2602  BB88 C8                   RET Z
2603  BB89 EB                   EX DE,HL
2604  BB8A 21 0F 00             LD HL,DIRECTORY_ENTRY.RC
2605  BB8D 19                   ADD HL,DE
2606  BB8E 0E 11                LD C,$11
2607  BB90 AF                   XOR A
2608  BB91              DIR_ZERO_ALLOC:
2609  BB91 77                   LD (HL),A
2610  BB92 23                   INC HL
2611  BB93 0D                   DEC C
2612  BB94 20 FB                JR NZ,DIR_ZERO_ALLOC
2613  BB96 21 0D 00             LD HL,DIRECTORY_ENTRY.S1
2614  BB99 19                   ADD HL,DE
2615  BB9A 77                   LD (HL),A
2616  BB9B CD 05 B8             CALL RECPTR_INC_STORE
2617  BB9E CD 53 BA             CALL FCB_WRITE_DIR_ENTRY
2618  BBA1 C3 F1 B7             JP MARK_FCB_S2_HIGHBIT
2619  BBA4              ; ----------------------------------------------------------------------
2620  BBA4              ; FCB_ADVANCE_RECORD -- advance the FCB to the next record/extent for sequential access.
2621  BBA4              ;   In: current FCB at $DF11; DPB EXM mask at $BFD2; the dir-changed flag $BFDF.
2622  BBA4              ;   Out: FCB EXTENT fields stepped (EX at offset $0C, S2 at $0E on wrap); new extent opened or
2623  BBA4              ;        created as needed; result $DF13. (The body below already named these correctly; the
2624  BBA4              ;        two 44K twins called offset $0C the current-record byte, which it is not.)
2625  BBA4              ;   Clobbers: A,B,C,D,E,H,L,flags.
2626  BBA4              ;   Algorithm: clear the dir-changed flag (DIR_DIRTY_FLAG), flush the current extent (F_CLOSE_HND), bump the FCB
2627  BBA4              ;       extent byte (offset $0C) mod 32; on wrap step the S2 module (offset $0E); otherwise use the EXM
2628  BBA4              ;       mask (DPB_EXM) and the dir-changed flag to decide between re-opening the current extent
2629  BBA4              ;       (FILE_OPEN_SEARCH / DIR_MAKE_ENTRY) or merging the just-flushed one (FILE_SIZE_FROM_EXTENT).
2630  BBA4              ;   [RE] sequential-access record/extent advance.
2631  BBA4              ; ----------------------------------------------------------------------
2632  BBA4              FCB_ADVANCE_RECORD:
2633  BBA4 AF                   XOR A
2634  BBA5 32 DF BF             LD (DIR_DIRTY_FLAG),A
2635  BBA8 CD F6 BA             CALL F_CLOSE_HND
2636  BBAB CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2637  BBAE C8                   RET Z
2638  BBAF 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2639  BBB2                      ; EX, the extent number's low 5 bits (CR lives at FCB.CR, not here)
2640  BBB2 01 0C 00             LD BC,FCB.DIRECTORY_ENTRY.EX
2641  BBB5 09                   ADD HL,BC
2642  BBB6 7E                   LD A,(HL)
2643  BBB7 3C                   INC A
2644  BBB8 E6 1F                AND $1F
2645  BBBA 77                   LD (HL),A
2646  BBBB 28 0D                JR Z,FCB_NEXT_EXTENT
2647  BBBD 47                   LD B,A
2648  BBBE 3A D2 BF             LD A,(DPB_EXM)
2649  BBC1 A0                   AND B
2650  BBC2 21 DF BF             LD HL,DIR_DIRTY_FLAG
2651  BBC5 A6                   AND (HL)
2652  BBC6 28 0C                JR Z,FCB_ADVANCE_RECORD_2
2653  BBC8 18 24                JR FCB_ADVANCE_RECORD_3
2654  BBCA              FCB_NEXT_EXTENT:
2655  BBCA                      ; step from EX to S2, as arithmetic on the field names
2656  BBCA 01 02 00             LD BC,FCB.DIRECTORY_ENTRY.S2 - FCB.DIRECTORY_ENTRY.EX
2657  BBCD 09                   ADD HL,BC
2658  BBCE 34                   INC (HL)
2659  BBCF 7E                   LD A,(HL)
2660  BBD0 E6 0F                AND $0F
2661  BBD2 28 24                JR Z,FCB_ADVANCE_RECORD_5
2662  BBD4              FCB_ADVANCE_RECORD_2:
2663  BBD4 0E 0F                LD C,$0F
2664  BBD6 CD 80 B9             CALL DIR_SEARCH_FIRST
2665  BBD9 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2666  BBDC 20 10                JR NZ,FCB_ADVANCE_RECORD_3
2667  BBDE 3A E0 BF             LD A,(RW_DIRECTION_FLAG)
2668  BBE1 3C                   INC A
2669  BBE2 28 14                JR Z,FCB_ADVANCE_RECORD_5
2670  BBE4 CD 6F BB             CALL DIR_MAKE_ENTRY
2671  BBE7 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2672  BBEA 28 0C                JR Z,FCB_ADVANCE_RECORD_5
2673  BBEC 18 03                JR FCB_ADVANCE_RECORD_4
2674  BBEE              FCB_ADVANCE_RECORD_3:
2675  BBEE CD B0 BA             CALL FILE_SIZE_FROM_EXTENT
2676  BBF1              FCB_ADVANCE_RECORD_4:
2677  BBF1 CD 31 B7             CALL FCB_PRIME_FIELDS
2678  BBF4 AF                   XOR A
2679  BBF5 C3 D0 DE             JP BDOS_RET_RESULT
2680  BBF8              FCB_ADVANCE_RECORD_5:
2681  BBF8 CD D4 DE             CALL $DED4
2682  BBFB C3 F1 B7             JP MARK_FCB_S2_HIGHBIT
2683  BBFE              ; ----------------------------------------------------------------------
2684  BBFE              ; FILE_WRITE_SEQ -- sequential-write entry into the shared read/deblock core (reached from BDOS_F_READ_SEQ).
2685  BBFE              ;   In: current FCB at $DF11.
2686  BBFE              ;   Out: enters FILE_READ_RECORD with the write-type flag set for a sequential operation.
2687  BBFE              ;   Clobbers: A,B,C,D,E,H,L,flags.
2688  BBFE              ;   Algorithm: set the write-type flag WRITE_TYPE=$BFE2 := 1 (sequential) then fall into FILE_READ_RECORD.
2689  BBFE              ;   [RE] NOTE the dispatch is crossed in this 60K build: BDOS_F_READ_SEQ (fn 20) jumps here and this
2690  BBFE              ;        entry feeds the read/deblock core. Twin of the 44K FILE_READ_SEQ (mode-flag set + fall-through).
2691  BBFE              ; ----------------------------------------------------------------------
2692  BBFE              FILE_WRITE_SEQ:
2693  BBFE 3E 01                LD A,ACCESS_SEQ
2694  BC00 32 E2 BF             LD (WRITE_TYPE_FLAG),A
2695  BC03              ; ----------------------------------------------------------------------
2696  BC03              ; FILE_READ_RECORD -- read the FCB's current record into the DMA buffer (shared read core).
2697  BC03              ;   In: current FCB at $DF11; record/extent fields set. Shared by the sequential and random read paths.
2698  BC03              ;   Out: the record's sector read and de-blocked to the DMA address; result = 0/error via $DED0/$DED4.
2699  BC03              ;   Clobbers: A,B,C,D,E,H,L,flags.
2700  BC03              ;   Algorithm: set the direction flag $BFE0=$FF (read), FCB_PRIME_FIELDS, compare the working CR (FCB_CURREC)
2701  BC03              ;       against the extent's record count (FCB_RECCOUNT); at the $80 boundary advance to the next extent
2702  BC03              ;       (FCB_ADVANCE_RECORD), else REC_TO_BLOCK_14 / BLOCK_IS_ZERO_16 / BLOCK_BASE_RECORD_17 /
2703  BC03              ;       RECORD_TO_TRACK and read the sector (CALL $DF20).
2704  BC03              ;   [RE] CP/M 2.2 read core.
2705  BC03              ; ----------------------------------------------------------------------
2706  BC03              FILE_READ_RECORD:
2707  BC03 3E FF                LD A,$FF
2708  BC05 32 E0 BF             LD (RW_DIRECTION_FLAG),A
2709  BC08 CD 31 B7             CALL FCB_PRIME_FIELDS
2710  BC0B 3A F0 BF             LD A,(FCB_CURREC)
2711  BC0E 21 EE BF             LD HL,FCB_RECCOUNT
2712  BC11 BE                   CP (HL)
2713  BC12 38 11                JR C,FILE_READ_RECORD_1
2714  BC14 FE 80                CP $80
2715  BC16 20 21                JR NZ,FILE_READ_RECORD_2
2716  BC18 CD A4 BB             CALL FCB_ADVANCE_RECORD
2717  BC1B AF                   XOR A
2718  BC1C 32 F0 BF             LD (FCB_CURREC),A
2719  BC1F 3A 13 DF             LD A,(BDOS_RETVAL)
2720  BC22 B7                   OR A
2721  BC23 20 14                JR NZ,FILE_READ_RECORD_2
2722  BC25              FILE_READ_RECORD_1:
2723  BC25 CD EE B6             CALL REC_TO_BLOCK_14
2724  BC28 CD FB B6             CALL BLOCK_IS_ZERO_16
2725  BC2B 28 0C                JR Z,FILE_READ_RECORD_2
2726  BC2D CD 01 B7             CALL BLOCK_BASE_RECORD_17
2727  BC30 CD 51 B6             CALL RECORD_TO_TRACK
2728  BC33 CD 20 DF             CALL $DF20
2729  BC36 C3 48 B7             JP FCB_WRITEBACK_REC
2730  BC39              FILE_READ_RECORD_2:
2731  BC39 C3 D4 DE             JP $DED4
2732  BC3C              ; ----------------------------------------------------------------------
2733  BC3C              ; FILE_READ_SEQ -- sequential-write entry into the shared write core (reached from BDOS_F_WRITE_SEQ).
2734  BC3C              ;   In: current FCB at $DF11; DMA buffer holds the record.
2735  BC3C              ;   Out: enters BDOS_WRITE with the write-type flag set for a sequential operation.
2736  BC3C              ;   Clobbers: A,B,C,D,E,H,L,flags.
2737  BC3C              ;   Algorithm: set the write-type flag WRITE_TYPE=$BFE2 := 1 (sequential) then fall into BDOS_WRITE.
2738  BC3C              ;   [RE] NOTE the dispatch is crossed in this 60K build: BDOS_F_WRITE_SEQ (fn 21) jumps here and this
2739  BC3C              ;        entry feeds the write core. Twin of the 44K FILE_WRITE_SEQ (mode-flag set + fall-through).
2740  BC3C              ; ----------------------------------------------------------------------
2741  BC3C              FILE_READ_SEQ:
2742  BC3C 3E 01                LD A,ACCESS_SEQ
2743  BC3E 32 E2 BF             LD (WRITE_TYPE_FLAG),A
2744  BC41              ; ----------------------------------------------------------------------
2745  BC41              ; BDOS_WRITE -- BDOS WRITE primitive (fn 21 F_WRITE / fn 34 F_WRITERAND / fn 40 F_WRITEZF target). Write
2746  BC41              ; the current record of the open file, allocating and deblocking disk blocks as needed.
2747  BC41              ;   In: current FCB at $DF11; the working record/record-count bytes primed by FCB_PRIME_FIELDS; DMA holds
2748  BC41              ;       the caller's record; WRITE_TYPE=$BFE2 = write type (1=sequential, 2=zero-fill/random); result
2749  BC41              ;       cell $DF13 = seek create/extend mode flag.
2750  BC41              ;   Out: A = BDOS return code (0=OK, 2=disk full) via the result cell $DF13 / $DED0; FCB allocation map /
2751  BC41              ;        record count updated; host sector written.  Clobbers: A,BC,DE,HL,flags.
2752  BC41              ;   Algorithm: clear the direction flag (RW_DIRECTION_FLAG); reject the record if the working CR (FCB_CURREC) >= 128
2753  BC41              ;       (extent full). REC_TO_BLOCK_14 / BLOCK_IS_ZERO_16: if the block is already allocated branch to
2754  BC41              ;       the write phase; else fetch the previous slot's block as a hint (FCB_BLOCKMAP_INDEX_10) and
2755  BC41              ;       ALLOC_GET_BLOCK a fresh block, store it into the FCB allocation slot (8- or 16-bit per $BFEA),
2756  BC41              ;       zero-fill new blocks when WRITE_TYPE=2, then RECORD_TO_TRACK and write (CALL $DF28), updating the
2757  BC41              ;       extent record count and CR via FCB_WRITEBACK_REC. Mirrors the standard CP/M 2.2 BDOS write. [RE]
2758  BC41              ; ----------------------------------------------------------------------
2759  BC41              BDOS_WRITE:
2760  BC41 3E 00                LD A,$00
2761  BC43 32 E0 BF             LD (RW_DIRECTION_FLAG),A
2762  BC46 CD C3 B7             CALL CHECK_DRIVE_READONLY
2763  BC49 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2764  BC4C CD B6 B7             CALL CHECK_DIRENT_READONLY_INNER
2765  BC4F CD 31 B7             CALL FCB_PRIME_FIELDS
2766  BC52 3A F0 BF             LD A,(FCB_CURREC)
2767  BC55 FE 80                CP $80
2768  BC57 D2 D4 DE             JP NC,$DED4
2769  BC5A CD EE B6             CALL REC_TO_BLOCK_14
2770  BC5D CD FB B6             CALL BLOCK_IS_ZERO_16
2771  BC60 0E 00                LD C,$00
2772  BC62 20 43                JR NZ,BDOS_WRITE_PHASE
2773  BC64 CD B9 B6             CALL REC_BLOCK_SHIFT_6
2774  BC67 32 E4 BF             LD (ALLOC_SLOT_INDEX),A
2775  BC6A 01 00 00             LD BC,$0000
2776  BC6D B7                   OR A
2777  BC6E 28 07                JR Z,BDOS_WRITE_ALLOCBLK
2778  BC70 4F                   LD C,A
2779  BC71 0B                   DEC BC
2780  BC72 CD D6 B6             CALL FCB_BLOCKMAP_INDEX_10
2781  BC75 44                   LD B,H
2782  BC76 4D                   LD C,L
2783  BC77              BDOS_WRITE_ALLOCBLK:
2784  BC77 CD 1A BA             CALL ALLOC_GET_BLOCK
2785  BC7A 7D                   LD A,L
2786  BC7B B4                   OR H
2787  BC7C 20 05                JR NZ,BDOS_WRITE_STOREBLK
2788  BC7E 3E 02                LD A,$02
2789  BC80 C3 D0 DE             JP BDOS_RET_RESULT

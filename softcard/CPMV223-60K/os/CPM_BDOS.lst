 108  DC00              BDOS_IMAGE_HEADER:
 109  DC00 BD                   CP L
 110  DC01 16 00                LD D,$00
 111  DC03 01 4D 40             LD BC,$404D
 112  DC06 C3 11 DC             JP BDOS_ENTRY
 113  DC09 A5 DC                DEFW    BDOS_ERROR
 114  DC0B B2 DC B7 DC          DEFB    $B2,$DC,$B7,$DC,$BC,$DC
 114  DC0F BC DC
 115  DC11              ; [DOC CPMREF 3-44] BDOS primary entry. Callers reach it via the JP at $0005 (the word at $0006 is
 116  DC11              ;       this entry / top of TPA). Function # is in C and the info address (or single byte) in DE/E.
 117  DC11              ;       Per the manual the BDOS switches to its own local stack on each call (here BDOS_STACK_TOP), and
 118  DC11              ;       a zero value is returned when the function number is out of range. The LC_RDWR_* bank
 119  DC11              ;       accesses and LC scratch ($BFxx) are this 60K build's Language-Card wrapper, not manual facts.
 120  DC11              BDOS_ENTRY:
 121  DC11 32 8B E0             LD (LC_BANK1),A
 122  DC14 ED 53 11 DF          LD (BDOS_PARAM_PTR),DE           ; save the DE info-address parameter
 123  DC18 7B                   LD A,E
 124  DC19 32 E3 BF             LD (DRV_SELECT_ARG),A
 125  DC1C 21 00 00             LD HL,WBOOTV
 126  DC1F 22 13 DF             LD (BDOS_RETVAL),HL              ; pre-seed return value = 0 (out-of-range default)
 127  DC22 ED 73 DD DE          LD (BDOS_SAVED_SP),SP            ; save caller's stack pointer
 128  DC26 31 0F DF             LD SP,BDOS_STACK_TOP             ; switch to the BDOS local stack
 129  DC29 AF                   XOR A
 130  DC2A 32 ED BF             LD (DRV_SAVED_FCB_BYTE),A
 131  DC2D 32 EB BF             LD (DRV_RESTORE_FLAG),A
 132  DC30 32 87 DF             LD (DEFERRED_COPY_FLAG),A
 133  DC33 21 45 DF             LD HL,BDOS_BANK_OUT_EPILOG
 134  DC36 E5                   PUSH HL
 135  DC37 79                   LD A,C                           ; 79    A = function number
 136  DC38 FE 29                CP $29                           ; range check (41 dispatch entries; CP/M 2.2 defines 0-36)
 137  DC3A D0                   RET NC                           ; D0    out of range -> return the pre-seeded zero
 138  DC3B FE 0C                CP $0C
 139  DC3D 30 03                JR NC,BDOS_ENTRY_1
 140  DC3F 32 83 E0             LD (LC_BANK2),A
 141  DC42              BDOS_ENTRY_1:
 142  DC42 4B                   LD C,E
 143  DC43 21 53 DC             LD HL,BDOS_DISPATCH_TBL
 144  DC46 5F                   LD E,A
 145  DC47 16 00                LD D,$00
 146  DC49 19                   ADD HL,DE
 147  DC4A 19                   ADD HL,DE
 148  DC4B 5E                   LD E,(HL)
 149  DC4C 23                   INC HL
 150  DC4D 56                   LD D,(HL)
 151  DC4E 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
 152  DC51 EB                   EX DE,HL
 153  DC52 E9                   JP (HL)
 154  DC53              ; [DOC CPMREF 3-44/3-76] BDOS function-pointer dispatch table, indexed by the function
 155  DC53              ;       number passed in C (entry N = function N, two bytes each). The CP/M 2.2 BDOS defines
 156  DC53              ;       functions 0-36 ($00-$24); entries 37-40 ($25-$28) have no manual-defined function in
 157  DC53              ;       CP/M 2.2 (the 41-entry / CP $29 guard is this 60K build's table size, not a manual fact).
 158  DC53              ;       Call convention: function # in C, info address (or single byte) in DE/E; byte results
 159  DC53              ;       in A, word results in HL, with A=L and B=H on return.
 160  DC53              BDOS_DISPATCH_TBL:
 161  DC53 03 FA                DEFW    WBOOT                    ; fn 0  System Reset (warm boot; re-login drive A)
 162  DC55 9C DE                DEFW    F_CONIN_H                ; fn 1  Console Input  -> A=char (echoed)
 163  DC57 7D DD                DEFW    F_CONOUT_H               ; fn 2  Console Output (E=char; expands tabs)
 164  DC59 A1 DE                DEFW    F_READERIN_H             ; fn 3  Reader Input (RDR:) -> A=char
 165  DC5B 12 FA                DEFW    PUNCH                    ; fn 4  Punch Output (PUN:; E=char)
 166  DC5D 0F FA                DEFW    LIST                     ; fn 5  List Output (LST:; E=char)
 167  DC5F A6 DE                DEFW    F_DIRECTIO_H             ; fn 6  Direct Console I/O (E=$FF in / char out; raw)
 168  DC61 BD DE                DEFW    F_GETIOB_H               ; fn 7  Get I/O Byte -> A=IOBYTE_ADDR ($0003)
 169  DC63 C2 DE                DEFW    F_SETIOB_H               ; fn 8  Set I/O Byte (E=IOBYTE_ADDR)
 170  DC65 C7 DE                DEFW    F_PRINTSTR_H             ; fn 9  Print String (DE='$'-terminated)
 171  DC67 C9 DD                DEFW    F_READCONBUF_H           ; fn 10 Read Console Buffer (DE=buffer; line editor)
 172  DC69 CD DE                DEFW    F_CONSTAT_H              ; fn 11 Get Console Status -> A=$FF/$00
 173  DC6B A3 BE                DEFW    $BEA3                    ; fn 12 Return Version Number -> HL ($0022 for 2.2)
 174  DC6D A8 BE                DEFW    $BEA8                    ; fn 13 Reset Disk System (all R/W, select A, DMA=$0080)
 175  DC6F 47 BE                DEFW    $BE47                    ; fn 14 Select Disk (E=0..15 = A..P)
 176  DC71 C0 BE                DEFW    $BEC0                    ; fn 15 Open File (DE=FCB) -> A=dir code/$FF
 177  DC73 C6 BE                DEFW    $BEC6                    ; fn 16 Close File (DE=FCB) -> A=dir code/$FF
 178  DC75 CC BE                DEFW    $BECC                    ; fn 17 Search for First (DE=FCB) -> A=dir code
 179  DC77 EB BE                DEFW    $BEEB                    ; fn 18 Search for Next -> A=dir code (255=no more)
 180  DC79 FC BE                DEFW    $BEFC                    ; fn 19 Delete File (DE=FCB) -> A=dir code/255
 181  DC7B 05 BF                DEFW    $BF05                    ; fn 20 Read Sequential (DE=FCB) -> A=err (0 ok)
 182  DC7D 0B BF                DEFW    $BF0B                    ; fn 21 Write Sequential (DE=FCB) -> A=err (0 ok)
 183  DC7F 11 BF                DEFW    $BF11                    ; fn 22 Make File (DE=FCB) -> A=dir code/$FF
 184  DC81 17 BF                DEFW    $BF17                    ; fn 23 Rename File (DE=FCB) -> A=dir code/$FF
 185  DC83 20 BF                DEFW    $BF20                    ; fn 24 Return Login Vector -> HL=login bit-vector
 186  DC85 25 BF                DEFW    $BF25                    ; fn 25 Return Current Disk -> A=current disk (0-15)
 187  DC87 2B BF                DEFW    $BF2B                    ; fn 26 Set DMA Address (DE=DMA addr; default $0080)
 188  DC89 32 BF                DEFW    $BF32                    ; fn 27 Get Addr (Alloc) -> HL=ALLOC vector base
 189  DC8B 9B B7                DEFW    $B79B                    ; fn 28 Write Protect Disk (temp R/O, current drive)
 190  DC8D 37 BF                DEFW    $BF37                    ; fn 29 Get R/O Vector -> HL=R/O bit-vector
 191  DC8F 3C BF                DEFW    $BF3C                    ; fn 30 Set File Attributes (DE=FCB; sets t1' R/O, t2' SYS)
 192  DC91 45 BF                DEFW    $BF45                    ; fn 31 Get Addr (Disk Parms) -> HL=DPB address
 193  DC93 4C BF                DEFW    $BF4C                    ; fn 32 Set/Get User Code (E=$FF get / code set)
 194  DC95 5F BF                DEFW    $BF5F                    ; fn 33 Read Random (DE=FCB) -> A=return code
 195  DC97 65 BF                DEFW    $BF65                    ; fn 34 Write Random (DE=FCB) -> A=return code (+05 dir full)
 196  DC99 6B BF                DEFW    $BF6B                    ; fn 35 Compute File Size (DE=FCB) -> r0,r1,r2 set
 197  DC9B 31 BE                DEFW    $BE31                    ; fn 36 Set Random Record (DE=FCB) -> r0,r1,r2 set
 198  DC9D 71 BF                DEFW    $BF71                    ; fn 37 -- not a CP/M 2.2 manual function (version-specific entry)
 199  DC9F D3 DE                DEFW    BDOS_RET_NOP             ; fn 38 -- not a CP/M 2.2 manual function; stub -> RET (BDOS_RET_NOP)
 200  DCA1 D3 DE                DEFW    BDOS_RET_NOP             ; fn 39 -- not a CP/M 2.2 manual function; stub -> RET (BDOS_RET_NOP)
 201  DCA3 92 BF                DEFW    $BF92                    ; fn 40 -- not a CP/M 2.2 manual function (version-specific entry)
 202  DCA5              ; [DOC CPMREF 3-36/3-37] BDOS run-time error reporter. Prints "Bdos Err On x: <error>"
 203  DCA5              ;       where x is the drive letter and <error> is one of BAD SECTOR (controller R/W error),
 204  DCA5              ;       SELECT (drive outside the valid range; reboots after console input), or R/O (write to
 205  DCA5              ;       a read-only / changed disk; warm start after console input). The error code in C
 206  DCA5              ;       selects which message: the embedded $-terminated strings are "Bdos Err On  : $" ($DCC5),
 207  DCA5              ;       "Bad Sector$" ($DCD0), "Select$" ($DCDB), "File R/O$" ($DCE2); $C6 $41 = ADD A,'A'
 208  DCA5              ;       converts the drive number to its letter.
 209  DCA5              BDOS_ERROR:
 210  DCA5 21 D5 DC CD          DEFB    $21,$D5,$DC,$CD,$F0,$DC,$FE,$03,$C2,$41,$DF,$18,$10,$21,$E0,$DC
 210  DCA9 F0 DC FE 03
 210  DCAD C2 41 DF 18
 210  DCB1 10 21 E0 DC
 211  DCB5 18 08 21 EC          DEFB    $18,$08,$21,$EC,$DC,$18,$03,$21,$E7,$DC,$CD,$F0,$DC,$C3,$00,$00
 211  DCB9 DC 18 03 21
 211  DCBD E7 DC CD F0
 211  DCC1 DC C3 00 00
 212  DCC5 42 64 6F 73          DEFB    $42,$64,$6F,$73,$20,$45,$72,$72,$20,$4F,$6E,$20,$20,$3A,$20,$24 ; "Bdos Err On  : $"
 212  DCC9 20 45 72 72
 212  DCCD 20 4F 6E 20
 212  DCD1 20 3A 20 24
 213  DCD5 42 61 64 20          DEFB    $42,$61,$64,$20,$53,$65,$63,$74,$6F,$72,$24,$53,$65,$6C,$65,$63 ; "Bad Sector$" "Selec"
 213  DCD9 53 65 63 74
 213  DCDD 6F 72 24 53
 213  DCE1 65 6C 65 63
 214  DCE5 74 24 46 69          DEFB    $74,$24,$46,$69,$6C,$65,$20,$52,$2F,$4F,$24,$E5,$CD ; "t$" "File R/O$"
 214  DCE9 6C 65 20 52
 214  DCED 2F 4F 24 E5
 214  DCF1 CD
 215  DCF2 B3 DD                DEFW    CON_CRLF

  75+ 0000              ; ---- FCB field offsets (from the start of a 36-byte FCB) ------------------------
  76+ 0000              ; ---------------------------------------------------------------------------
  77+ 0000              ; CP/M 2.2 on-disk / in-memory STRUCTURES.
  78+ 0000              ;
  79+ 0000              ; These replace the flat FCB_* offset EQUs that used to live here. A structure
  80+ 0000              ; gives the field a NAME at the use site instead of a bare number, and it lets a
  81+ 0000              ; step between two fields be written as arithmetic on the names, which a magic
  82+ 0000              ; number cannot be checked against. That is the same rule the repo already
  83+ 0000              ; applies to code sizes (a size is label-after minus label-on-first-byte).
  84+ 0000              ;
  85+ 0000              ; It is not cosmetic. Every structure below had a field mislabelled in the
  86+ 0000              ; sources at some point, and each time the cause was the same: the operand was a
  87+ 0000              ; bare number, so nothing contradicted a wrong comment. FCB offset 12 was called
  88+ 0000              ; "the current-record byte" at twelve sites across two trees; the DPB byte the
  89+ 0000              ; deblock tests was called a "deblock flag"; the DPH word holding the DPB pointer
  90+ 0000              ; was reached by an unnamed +10.
  91+ 0000              ;
  92+ 0000              ; A DIRECTORY ENTRY and an FCB are the same 32 bytes, with the FCB adding four.
  93+ 0000              ; The STRUCT carries the spelled-out name and the FIELDS keep their CP/M manual names.
  94+ 0000              ; EX and RC and AL only ever looked opaque because they sat on a bare number; read as
  95+ 0000              ; FCB.DIRECTORY_ENTRY.EX the path supplies the context the abbreviation assumes:
  96+ 0000              ;
  97+ 0000              ;      0                              31 32   33 34 35
  98+ 0000              ;     +--------------------------------+-----+--------+
  99+ 0000              ;     |      DIRECTORY_ENTRY (32)      | CR  | R0 R1 R2|
 100+ 0000              ;     +--------------------------------+-----+--------+
 101+ 0000              ;     |<---------- FCB (36) ---------------------------->|
 102+ 0000              ;
 103+ 0000              ; So reach a shared field through the structure you actually hold:
 104+ 0000              ;   holding an FCB          ->  FCB.DIRECTORY_ENTRY.EX
 105+ 0000              ;   holding a directory     ->  DIRECTORY_ENTRY.EX           (e.g. in DIRBUF)
 106+ 0000              ; Both are 12. The difference is that the NAME states which one the code has,
 107+ 0000              ; and that distinction is real: ALLOC_FROM_FCB, despite its name, walks a
 108+ 0000              ; DIRECTORY ENTRY out of DIRBUF, not a user FCB.
 109+ 0000              ; ---------------------------------------------------------------------------
 110+ 0000                  STRUCT DIRECTORY_ENTRY
 111+ 0000 ~            ST      BYTE           ; 0   status. In a DIRECTORY entry this is the user number
 112+ 0000 ~                                   ;     (0..31), or $E5 for a free/deleted slot. In an FCB the
 113+ 0000 ~                                   ;     same byte is DRI's DR, the drive code (0 = default,
 114+ 0000 ~                                   ;     1..16 = A..P). One byte, two meanings, and which one
 115+ 0000 ~                                   ;     applies is exactly what the struct path now states.
 116+ 0000 ~            FN      BLOCK 8        ; 1   filename, space-padded
 117+ 0000 ~            FT      BLOCK 3        ; 9   filetype; high bits flag R/O, SYS, archive
 118+ 0000 ~            EX      BYTE           ; 12  extent number, LOW 5 BITS ONLY. The extent is a PAIR:
 119+ 0000 ~                                   ;     EX + 32*S2. This is NOT the current record; that is CR
 120+ 0000 ~                                   ;     at offset 32, and it is 7 bits (0..127).
 121+ 0000 ~            S1      BYTE           ; 13  reserved
 122+ 0000 ~            S2      BYTE           ; 14  extent number, high bits (see EX)
 123+ 0000 ~            RC      BYTE           ; 15  records in the current extent (0..128)
 124+ 0000 ~            AL      BLOCK 16       ; 16  allocation map: 16 block bytes, or 8 block WORDS when
 125+ 0000 ~                                   ;     DSM > 255 (see BLOCK_WIDTH_FLAG)
 126+ 0000                  ENDS               ; = 32
 127+ 0000
 128+ 0000                  STRUCT FCB
 129+ 0000 ~            DIRECTORY_ENTRY  DIRECTORY_ENTRY  ; 0  the directory-entry image, byte for byte
 130+ 0000 ~            CR      BYTE           ; 32  current record within the extent (0..127)
 131+ 0000 ~            R0      BYTE           ; 33  random record number, low byte
 132+ 0000 ~            R1      BYTE           ; 34  random record number, middle byte
 133+ 0000 ~            R2      BYTE           ; 35  random record number, high byte (overflow)
 134+ 0000                  ENDS               ; = 36
 135+ 0000
 136+ 0000                  ASSERT DIRECTORY_ENTRY == 32                  ; a directory entry is 32 bytes
 137+ 0000                  ASSERT FCB.CR == DIRECTORY_ENTRY              ; CR begins where the entry ends
 138+ 0000                  ASSERT FCB == DIRECTORY_ENTRY + 4
 139+ 0000                  ASSERT FCB.DIRECTORY_ENTRY.EX == DIRECTORY_ENTRY.EX
 140+ 0000
 141+ 0000              ; Disk Parameter Block, the 15 bytes the BIOS hands the BDOS per drive.
 142+ 0000              ; NAMED *_LAYOUT because the OS sources already use DPB, DPH_TABLE, SPT, DSM and OFF as
 143+ 0000              ; INSTANCE labels for the real data block in CPM_BIOS.asm. This is the TYPE, not the instance.
 144+ 0000                  STRUCT DPB_LAYOUT
 145+ 0000 ~            SPT     WORD           ; 0   128-byte RECORDS per track, not 256-byte sectors
 146+ 0000 ~            BSH     BYTE           ; 2   block shift: log2(records per block)
 147+ 0000 ~            BLM     BYTE           ; 3   block mask: (records per block) - 1
 148+ 0000 ~            EXM     BYTE           ; 4   extent mask
 149+ 0000 ~            DSM     WORD           ; 5   highest allocation block number
 150+ 0000 ~            DRM     WORD           ; 7   highest directory entry number
 151+ 0000 ~            AL0     BYTE           ; 9   directory-reserved block bitmap, high byte
 152+ 0000 ~            AL1     BYTE           ; 10  ditto, low byte
 153+ 0000 ~            CKS     WORD           ; 11  directory checksum vector size
 154+ 0000 ~            OFF     WORD           ; 13  reserved tracks before the file area
 155+ 0000                  ENDS               ; = 15
 156+ 0000
 157+ 0000                  ASSERT DPB_LAYOUT.DSM == 5     ; SELDSK reaches the DSM byte with a bare +5
 158+ 0000                  ASSERT DPB_LAYOUT == 15
 159+ 0000
 160+ 0000              ; Disk Parameter Header, one per drive, 16 bytes.
 161+ 0000                  STRUCT DPH_LAYOUT
 162+ 0000 ~            XLT     WORD           ; 0   sector-translate table, or 0 for none
 163+ 0000 ~            SCRATCH BLOCK 6        ; 2   three scratch words the BDOS owns
 164+ 0000 ~            DIRBUF  WORD           ; 8   -> the 128-byte directory buffer (one per system)
 165+ 0000 ~            DPB     WORD           ; 10  -> this drive's DPB
 166+ 0000 ~            CSV     WORD           ; 12  -> directory checksum vector
 167+ 0000 ~            ALV     WORD           ; 14  -> allocation vector
 168+ 0000                  ENDS               ; = 16
 169+ 0000
 170+ 0000                  ASSERT DPH_LAYOUT.DPB == 10    ; SELDSK reaches the DPB pointer with a bare +10
 171+ 0000                  ASSERT DPH_LAYOUT == 16
 172+ 0000
 173+ 0000
 174+ 0000                  ENDIF
 175+ 0000

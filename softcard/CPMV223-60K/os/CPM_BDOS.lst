2556  BB6F              ; ----------------------------------------------------------------------
2557  BB6F              ; DIR_MAKE_ENTRY -- find a free directory slot and create a new (empty) entry for the FCB (worker for BDOS fn 22).
2558  BB6F              ;   In: current FCB at $DF11.
2559  BB6F              ;   Out: a free directory slot located and initialized for this file; returns Z if no slot is free.
2560  BB6F              ;   Clobbers: A,B,C,D,E,H,L,flags.
2561  BB6F              ;   Algorithm: CHECK_DRIVE_READONLY, temporarily redirect the FCB pointer (BDOS_PARAM_PTR) to the scratch
2562  BB6F              ;       EMPTY_DIR_FCB and DIR_SEARCH_FIRST in mode 1 for an empty ($E5) slot, restore the FCB pointer; on
2563  BB6F              ;       success zero 17 bytes of the entry's record/allocation area (from offset $0F), clear the S1 byte
2564  BB6F              ;       (offset $0D), advance the record pointer (RECPTR_INC_STORE), write the new entry
2565  BB6F              ;       (FCB_WRITE_DIR_ENTRY), and set the FCB S2 'written' flag.
2566  BB6F              ;   [RE] make-directory-entry helper.
2567  BB6F              ; ----------------------------------------------------------------------
2568  BB6F              DIR_MAKE_ENTRY:
2569  BB6F CD C3 B7             CALL CHECK_DRIVE_READONLY
2570  BB72 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2571  BB75 E5                   PUSH HL
2572  BB76 21 B9 BF             LD HL,EMPTY_DIR_FCB
2573  BB79 22 11 DF             LD (BDOS_PARAM_PTR),HL
2574  BB7C 0E 01                LD C,$01
2575  BB7E CD 80 B9             CALL DIR_SEARCH_FIRST
2576  BB81 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2577  BB84 E1                   POP HL
2578  BB85 22 11 DF             LD (BDOS_PARAM_PTR),HL
2579  BB88 C8                   RET Z
2580  BB89 EB                   EX DE,HL
2581  BB8A 21 0F 00             LD HL,$000F
2582  BB8D 19                   ADD HL,DE
2583  BB8E 0E 11                LD C,$11
2584  BB90 AF                   XOR A
2585  BB91              DIR_ZERO_ALLOC:
2586  BB91 77                   LD (HL),A
2587  BB92 23                   INC HL
2588  BB93 0D                   DEC C
2589  BB94 20 FB                JR NZ,DIR_ZERO_ALLOC
2590  BB96 21 0D 00             LD HL,$000D
2591  BB99 19                   ADD HL,DE
2592  BB9A 77                   LD (HL),A
2593  BB9B CD 05 B8             CALL RECPTR_INC_STORE
2594  BB9E CD 53 BA             CALL FCB_WRITE_DIR_ENTRY
2595  BBA1 C3 F1 B7             JP MARK_FCB_S2_HIGHBIT
2596  BBA4              ; ----------------------------------------------------------------------
2597  BBA4              ; FCB_ADVANCE_RECORD -- advance the FCB to the next record/extent for sequential access.
2598  BBA4              ;   In: current FCB at $DF11; DPB EXM mask at $BFD2; the dir-changed flag $BFDF.
2599  BBA4              ;   Out: FCB current-record / extent fields stepped; new extent opened or created as needed; result $DF13.
2600  BBA4              ;   Clobbers: A,B,C,D,E,H,L,flags.
2601  BBA4              ;   Algorithm: clear the dir-changed flag (DIR_DIRTY_FLAG), flush the current extent (F_CLOSE_HND), bump the FCB
2602  BBA4              ;       extent byte (offset $0C) mod 32; on wrap step the S2 module (offset $0E); otherwise use the EXM
2603  BBA4              ;       mask (DPB_EXM) and the dir-changed flag to decide between re-opening the current extent
2604  BBA4              ;       (FILE_OPEN_SEARCH / DIR_MAKE_ENTRY) or merging the just-flushed one (FILE_SIZE_FROM_EXTENT).
2605  BBA4              ;   [RE] sequential-access record/extent advance.
2606  BBA4              ; ----------------------------------------------------------------------
2607  BBA4              FCB_ADVANCE_RECORD:
2608  BBA4 AF                   XOR A
2609  BBA5 32 DF BF             LD (DIR_DIRTY_FLAG),A
2610  BBA8 CD F6 BA             CALL F_CLOSE_HND
2611  BBAB CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2612  BBAE C8                   RET Z
2613  BBAF 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2614  BBB2 01 0C 00             LD BC,$000C
2615  BBB5 09                   ADD HL,BC
2616  BBB6 7E                   LD A,(HL)
2617  BBB7 3C                   INC A
2618  BBB8 E6 1F                AND $1F
2619  BBBA 77                   LD (HL),A
2620  BBBB 28 0D                JR Z,FCB_NEXT_EXTENT
2621  BBBD 47                   LD B,A
2622  BBBE 3A D2 BF             LD A,(DPB_EXM)
2623  BBC1 A0                   AND B
2624  BBC2 21 DF BF             LD HL,DIR_DIRTY_FLAG
2625  BBC5 A6                   AND (HL)
2626  BBC6 28 0C                JR Z,FCB_ADVANCE_RECORD_2
2627  BBC8 18 24                JR FCB_ADVANCE_RECORD_3
2628  BBCA              FCB_NEXT_EXTENT:
2629  BBCA 01 02 00             LD BC,$0002
2630  BBCD 09                   ADD HL,BC
2631  BBCE 34                   INC (HL)
2632  BBCF 7E                   LD A,(HL)
2633  BBD0 E6 0F                AND $0F
2634  BBD2 28 24                JR Z,FCB_ADVANCE_RECORD_5
2635  BBD4              FCB_ADVANCE_RECORD_2:
2636  BBD4 0E 0F                LD C,$0F
2637  BBD6 CD 80 B9             CALL DIR_SEARCH_FIRST
2638  BBD9 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2639  BBDC 20 10                JR NZ,FCB_ADVANCE_RECORD_3
2640  BBDE 3A E0 BF             LD A,(RW_DIRECTION_FLAG)
2641  BBE1 3C                   INC A
2642  BBE2 28 14                JR Z,FCB_ADVANCE_RECORD_5
2643  BBE4 CD 6F BB             CALL DIR_MAKE_ENTRY
2644  BBE7 CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
2645  BBEA 28 0C                JR Z,FCB_ADVANCE_RECORD_5
2646  BBEC 18 03                JR FCB_ADVANCE_RECORD_4
2647  BBEE              FCB_ADVANCE_RECORD_3:
2648  BBEE CD B0 BA             CALL FILE_SIZE_FROM_EXTENT
2649  BBF1              FCB_ADVANCE_RECORD_4:
2650  BBF1 CD 31 B7             CALL FCB_PRIME_FIELDS
2651  BBF4 AF                   XOR A
2652  BBF5 C3 D0 DE             JP BDOS_RET_RESULT
2653  BBF8              FCB_ADVANCE_RECORD_5:
2654  BBF8 CD D4 DE             CALL $DED4
2655  BBFB C3 F1 B7             JP MARK_FCB_S2_HIGHBIT
2656  BBFE              ; ----------------------------------------------------------------------
2657  BBFE              ; FILE_WRITE_SEQ -- sequential-write entry into the shared read/deblock core (reached from BDOS_F_READ_SEQ).
2658  BBFE              ;   In: current FCB at $DF11.
2659  BBFE              ;   Out: enters FILE_READ_RECORD with the write-type flag set for a sequential operation.
2660  BBFE              ;   Clobbers: A,B,C,D,E,H,L,flags.
2661  BBFE              ;   Algorithm: set the write-type flag WRITE_TYPE=$BFE2 := 1 (sequential) then fall into FILE_READ_RECORD.
2662  BBFE              ;   [RE] NOTE the dispatch is crossed in this 60K build: BDOS_F_READ_SEQ (fn 20) jumps here and this
2663  BBFE              ;        entry feeds the read/deblock core. Twin of the 44K FILE_READ_SEQ (mode-flag set + fall-through).
2664  BBFE              ; ----------------------------------------------------------------------
2665  BBFE              FILE_WRITE_SEQ:
2666  BBFE 3E 01                LD A,$01
2667  BC00 32 E2 BF             LD (WRITE_TYPE_FLAG),A
2668  BC03              ; ----------------------------------------------------------------------
2669  BC03              ; FILE_READ_RECORD -- read the FCB's current record into the DMA buffer (shared read core).
2670  BC03              ;   In: current FCB at $DF11; record/extent fields set. Shared by the sequential and random read paths.
2671  BC03              ;   Out: the record's sector read and de-blocked to the DMA address; result = 0/error via $DED0/$DED4.
2672  BC03              ;   Clobbers: A,B,C,D,E,H,L,flags.
2673  BC03              ;   Algorithm: set the direction flag $BFE0=$FF (read), FCB_PRIME_FIELDS, compare the working CR (FCB_CURREC)
2674  BC03              ;       against the extent's record count (FCB_RECCOUNT); at the $80 boundary advance to the next extent
2675  BC03              ;       (FCB_ADVANCE_RECORD), else REC_TO_BLOCK_14 / BLOCK_IS_ZERO_16 / BLOCK_BASE_RECORD_17 /
2676  BC03              ;       RECORD_TO_TRACK and read the sector (CALL $DF20).
2677  BC03              ;   [RE] CP/M 2.2 read core.
2678  BC03              ; ----------------------------------------------------------------------
2679  BC03              FILE_READ_RECORD:
2680  BC03 3E FF                LD A,$FF
2681  BC05 32 E0 BF             LD (RW_DIRECTION_FLAG),A
2682  BC08 CD 31 B7             CALL FCB_PRIME_FIELDS
2683  BC0B 3A F0 BF             LD A,(FCB_CURREC)
2684  BC0E 21 EE BF             LD HL,FCB_RECCOUNT
2685  BC11 BE                   CP (HL)
2686  BC12 38 11                JR C,FILE_READ_RECORD_1
2687  BC14 FE 80                CP $80
2688  BC16 20 21                JR NZ,FILE_READ_RECORD_2
2689  BC18 CD A4 BB             CALL FCB_ADVANCE_RECORD
2690  BC1B AF                   XOR A
2691  BC1C 32 F0 BF             LD (FCB_CURREC),A
2692  BC1F 3A 13 DF             LD A,(BDOS_RETVAL)
2693  BC22 B7                   OR A
2694  BC23 20 14                JR NZ,FILE_READ_RECORD_2
2695  BC25              FILE_READ_RECORD_1:
2696  BC25 CD EE B6             CALL REC_TO_BLOCK_14
2697  BC28 CD FB B6             CALL BLOCK_IS_ZERO_16
2698  BC2B 28 0C                JR Z,FILE_READ_RECORD_2
2699  BC2D CD 01 B7             CALL BLOCK_BASE_RECORD_17
2700  BC30 CD 51 B6             CALL RECORD_TO_TRACK
2701  BC33 CD 20 DF             CALL $DF20
2702  BC36 C3 48 B7             JP FCB_WRITEBACK_REC
2703  BC39              FILE_READ_RECORD_2:
2704  BC39 C3 D4 DE             JP $DED4
2705  BC3C              ; ----------------------------------------------------------------------
2706  BC3C              ; FILE_READ_SEQ -- sequential-write entry into the shared write core (reached from BDOS_F_WRITE_SEQ).
2707  BC3C              ;   In: current FCB at $DF11; DMA buffer holds the record.
2708  BC3C              ;   Out: enters BDOS_WRITE with the write-type flag set for a sequential operation.
2709  BC3C              ;   Clobbers: A,B,C,D,E,H,L,flags.
2710  BC3C              ;   Algorithm: set the write-type flag WRITE_TYPE=$BFE2 := 1 (sequential) then fall into BDOS_WRITE.
2711  BC3C              ;   [RE] NOTE the dispatch is crossed in this 60K build: BDOS_F_WRITE_SEQ (fn 21) jumps here and this
2712  BC3C              ;        entry feeds the write core. Twin of the 44K FILE_WRITE_SEQ (mode-flag set + fall-through).
2713  BC3C              ; ----------------------------------------------------------------------
2714  BC3C              FILE_READ_SEQ:
2715  BC3C 3E 01                LD A,$01
2716  BC3E 32 E2 BF             LD (WRITE_TYPE_FLAG),A
2717  BC41              ; ----------------------------------------------------------------------
2718  BC41              ; BDOS_WRITE -- BDOS WRITE primitive (fn 21 F_WRITE / fn 34 F_WRITERAND / fn 40 F_WRITEZF target). Write
2719  BC41              ; the current record of the open file, allocating and deblocking disk blocks as needed.
2720  BC41              ;   In: current FCB at $DF11; the working record/record-count bytes primed by FCB_PRIME_FIELDS; DMA holds
2721  BC41              ;       the caller's record; WRITE_TYPE=$BFE2 = write type (1=sequential, 2=zero-fill/random); result
2722  BC41              ;       cell $DF13 = seek create/extend mode flag.
2723  BC41              ;   Out: A = BDOS return code (0=OK, 2=disk full) via the result cell $DF13 / $DED0; FCB allocation map /
2724  BC41              ;        record count updated; host sector written.  Clobbers: A,BC,DE,HL,flags.
2725  BC41              ;   Algorithm: clear the direction flag (RW_DIRECTION_FLAG); reject the record if the working CR (FCB_CURREC) >= 128
2726  BC41              ;       (extent full). REC_TO_BLOCK_14 / BLOCK_IS_ZERO_16: if the block is already allocated branch to
2727  BC41              ;       the write phase; else fetch the previous slot's block as a hint (FCB_BLOCKMAP_INDEX_10) and
2728  BC41              ;       ALLOC_GET_BLOCK a fresh block, store it into the FCB allocation slot (8- or 16-bit per $BFEA),
2729  BC41              ;       zero-fill new blocks when WRITE_TYPE=2, then RECORD_TO_TRACK and write (CALL $DF28), updating the
2730  BC41              ;       extent record count and CR via FCB_WRITEBACK_REC. Mirrors the standard CP/M 2.2 BDOS write. [RE]
2731  BC41              ; ----------------------------------------------------------------------
2732  BC41              BDOS_WRITE:
2733  BC41 3E 00                LD A,$00
2734  BC43 32 E0 BF             LD (RW_DIRECTION_FLAG),A
2735  BC46 CD C3 B7             CALL CHECK_DRIVE_READONLY
2736  BC49 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2737  BC4C CD B6 B7             CALL CHECK_DIRENT_READONLY_INNER
2738  BC4F CD 31 B7             CALL FCB_PRIME_FIELDS
2739  BC52 3A F0 BF             LD A,(FCB_CURREC)
2740  BC55 FE 80                CP $80
2741  BC57 D2 D4 DE             JP NC,$DED4
2742  BC5A CD EE B6             CALL REC_TO_BLOCK_14
2743  BC5D CD FB B6             CALL BLOCK_IS_ZERO_16
2744  BC60 0E 00                LD C,$00
2745  BC62 20 43                JR NZ,BDOS_WRITE_PHASE
2746  BC64 CD B9 B6             CALL REC_BLOCK_SHIFT_6
2747  BC67 32 E4 BF             LD (ALLOC_SLOT_INDEX),A
2748  BC6A 01 00 00             LD BC,$0000
2749  BC6D B7                   OR A
2750  BC6E 28 07                JR Z,BDOS_WRITE_ALLOCBLK
2751  BC70 4F                   LD C,A
2752  BC71 0B                   DEC BC
2753  BC72 CD D6 B6             CALL FCB_BLOCKMAP_INDEX_10
2754  BC75 44                   LD B,H
2755  BC76 4D                   LD C,L
2756  BC77              BDOS_WRITE_ALLOCBLK:
2757  BC77 CD 1A BA             CALL ALLOC_GET_BLOCK
2758  BC7A 7D                   LD A,L
2759  BC7B B4                   OR H
2760  BC7C 20 05                JR NZ,BDOS_WRITE_STOREBLK
2761  BC7E 3E 02                LD A,$02
2762  BC80 C3 D0 DE             JP BDOS_RET_RESULT
2763  BC83              BDOS_WRITE_STOREBLK:
2764  BC83 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
2765  BC86 EB                   EX DE,HL
2766  BC87 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2767  BC8A 01 10 00             LD BC,$0010
2768  BC8D 09                   ADD HL,BC
2769  BC8E 3A EA BF             LD A,(BLOCK_WIDTH_FLAG)
2770  BC91 B7                   OR A
2771  BC92 3A E4 BF             LD A,(ALLOC_SLOT_INDEX)
2772  BC95 28 06                JR Z,BDOS_WRITE_STOREBLK16
2773  BC97 CD D3 B7             CALL DIRENT_PTR_ADD
2774  BC9A 73                   LD (HL),E
2775  BC9B 18 08                JR BDOS_WRITE_NEWBLK
2776  BC9D              BDOS_WRITE_STOREBLK16:
2777  BC9D 4F                   LD C,A
2778  BC9E 06 00                LD B,$00
2779  BCA0 09                   ADD HL,BC
2780  BCA1 09                   ADD HL,BC
2781  BCA2 73                   LD (HL),E
2782  BCA3 23                   INC HL
2783  BCA4 72                   LD (HL),D
2784  BCA5              BDOS_WRITE_NEWBLK:
2785  BCA5 0E 02                LD C,$02
2786  BCA7              BDOS_WRITE_PHASE:
2787  BCA7 3A 13 DF             LD A,(BDOS_RETVAL)
2788  BCAA B7                   OR A
2789  BCAB C0                   RET NZ
2790  BCAC C5                   PUSH BC
2791  BCAD CD 01 B7             CALL BLOCK_BASE_RECORD_17
2792  BCB0 3A E2 BF             LD A,(WRITE_TYPE_FLAG)
2793  BCB3 3D                   DEC A
2794  BCB4 3D                   DEC A
2795  BCB5 20 3A                JR NZ,BDOS_WRITE_DOWRITE
2796  BCB7 C1                   POP BC
2797  BCB8 C5                   PUSH BC
2798  BCB9 79                   LD A,C
2799  BCBA 3D                   DEC A
2800  BCBB 3D                   DEC A
2801  BCBC 20 33                JR NZ,BDOS_WRITE_DOWRITE
2802  BCBE E5                   PUSH HL
2803  BCBF 2A C6 BF             LD HL,(DIRBUF_PTR)
2804  BCC2 57                   LD D,A
2805  BCC3              BDOS_WRITE_ZEROFILL:
2806  BCC3 77                   LD (HL),A
2807  BCC4 23                   INC HL
2808  BCC5 14                   INC D
2809  BCC6 F2 C3 BC             JP P,BDOS_WRITE_ZEROFILL
2810  BCC9 CD 54 B8             CALL SET_DMA_TO_DISK_BUF
2811  BCCC 2A F4 BF             LD HL,(BLOCK_BASE_RECORD)
2812  BCCF 0E 02                LD C,$02
2813  BCD1              BDOS_WRITE_FILLLOOP:
2814  BCD1 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
2815  BCD4 C5                   PUSH BC
2816  BCD5 CD 51 B6             CALL RECORD_TO_TRACK
2817  BCD8 C1                   POP BC
2818  BCD9 CD 28 DF             CALL $DF28
2819  BCDC 2A F2 BF             LD HL,(CUR_BLOCK_NUMBER)
2820  BCDF 0E 00                LD C,$00
2821  BCE1 3A D1 BF             LD A,(DPB_BLM)
2822  BCE4 47                   LD B,A
2823  BCE5 A5                   AND L
2824  BCE6 B8                   CP B
2825  BCE7 23                   INC HL
2826  BCE8 20 E7                JR NZ,BDOS_WRITE_FILLLOOP
2827  BCEA E1                   POP HL
2828  BCEB 22 F2 BF             LD (CUR_BLOCK_NUMBER),HL
2829  BCEE CD 4F B8             CALL RESTORE_USER_DMA
2830  BCF1              BDOS_WRITE_DOWRITE:
2831  BCF1 CD 51 B6             CALL RECORD_TO_TRACK
2832  BCF4 C1                   POP BC
2833  BCF5 C5                   PUSH BC
2834  BCF6 CD 28 DF             CALL $DF28
2835  BCF9 C1                   POP BC
2836  BCFA 3A F0 BF             LD A,(FCB_CURREC)
2837  BCFD 21 EE BF             LD HL,FCB_RECCOUNT
2838  BD00 BE                   CP (HL)
2839  BD01 38 04                JR C,BDOS_WRITE_9
2840  BD03 77                   LD (HL),A
2841  BD04 34                   INC (HL)
2842  BD05 0E 02                LD C,$02
2843  BD07              BDOS_WRITE_9:
2844  BD07 F5                   PUSH AF
2845  BD08 CD D8 B7             CALL FCB_GET_S2
2846  BD0B E6 7F                AND $7F
2847  BD0D 77                   LD (HL),A
2848  BD0E F1                   POP AF
2849  BD0F FE 7F                CP $7F
2850  BD11 20 1A                JR NZ,BDOS_WRITE_11
2851  BD13 3A E2 BF             LD A,(WRITE_TYPE_FLAG)
2852  BD16 FE 01                CP $01
2853  BD18 20 13                JR NZ,BDOS_WRITE_11
2854  BD1A CD 48 B7             CALL FCB_WRITEBACK_REC
2855  BD1D CD A4 BB             CALL FCB_ADVANCE_RECORD
2856  BD20 21 13 DF             LD HL,BDOS_RETVAL
2857  BD23 7E                   LD A,(HL)
2858  BD24 B7                   OR A
2859  BD25 20 04                JR NZ,BDOS_WRITE_10
2860  BD27 3D                   DEC A
2861  BD28 32 F0 BF             LD (FCB_CURREC),A
2862  BD2B              BDOS_WRITE_10:
2863  BD2B 36 00                LD (HL),$00
2864  BD2D              BDOS_WRITE_11:
2865  BD2D C3 48 B7             JP FCB_WRITEBACK_REC
2866  BD30              ; ----------------------------------------------------------------------
2867  BD30              ; BDOS_SEEK_NOREAD -- SEEK entry that clears the write-type cell, then computes/positions the target extent.
2868  BD30              ;   In: current FCB at $DF11 valid.
2869  BD30              ;   Out: as for BDOS_SEEK_COMPUTE below.  Clobbers: A,BC,DE,HL,flags.
2870  BD30              ;   Algorithm: clear the write-type cell (WRITE_TYPE=$BFE2 := 0), then fall straight into BDOS_SEEK_COMPUTE.
2871  BD30              ;       (OBSERVED: used by the random read/write bodies after they set C; BDOS_SEEK_NOREAD itself does not
2872  BD30              ;       consume C -- it is merely preserved on the stack across the seek and used by the caller after.) [RE]
2873  BD30              ; ----------------------------------------------------------------------
2874  BD30              BDOS_SEEK_NOREAD:
2875  BD30 AF                   XOR A
2876  BD31 32 E2 BF             LD (WRITE_TYPE_FLAG),A
2877  BD34              ; ----------------------------------------------------------------------
2878  BD34              ; BDOS_SEEK_COMPUTE -- compute the target extent/record from the FCB random-record field (R0/R1/R2) and seek the directory to it.
2879  BD34              ;   In: current FCB at $DF11 whose random-record bytes (FCB+$21..$23 = R0/R1/R2) hold the desired record;
2880  BD34              ;       result cell $DF13 = create/extend mode flag.
2881  BD34              ;   Out: B = target S2 (module), C = target extent-within-entry; if the FCB is already positioned there,
2882  BD34              ;        returns OK (A=0) via $DED0; else repositions the directory; on R2 != 0 returns record-out-of-range.
2883  BD34              ;        (OBSERVED: BC is also just preserved on the stack for the calling read/write routine.)
2884  BD34              ;   Clobbers: A,BC,DE,HL,flags.
2885  BD34              ;   Algorithm: read R0 and combine with R1 into the 16-bit record number. record-within-extent = R0 & $7F;
2886  BD34              ;       extent = ((R1<<1)|R0.bit7) & $1F (C); S2/module = R1>>4 (B). If R2 (high random byte) is non-zero
2887  BD34              ;       the record is out of range -> abort with phase code 6. Otherwise compare target extent (C vs
2888  BD34              ;       FCB+$0C) and S2 (B vs FCB+$0E): if both match, fall through with no positioning; else reposition
2889  BD34              ;       to the target extent. Mirrors the standard CP/M 2.2 BDOS random seek. [RE]
2890  BD34              ; ----------------------------------------------------------------------
2891  BD34              BDOS_SEEK_COMPUTE:
2892  BD34 C5                   PUSH BC
2893  BD35 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
2894  BD38 EB                   EX DE,HL
2895  BD39 21 21 00             LD HL,$0021
2896  BD3C 19                   ADD HL,DE
2897  BD3D 7E                   LD A,(HL)
2898  BD3E E6 7F                AND $7F
2899  BD40 F5                   PUSH AF
2900  BD41 7E                   LD A,(HL)
2901  BD42 17                   RLA
2902  BD43 23                   INC HL
2903  BD44 7E                   LD A,(HL)
2904  BD45 17                   RLA
2905  BD46 E6 1F                AND $1F
2906  BD48 4F                   LD C,A
2907  BD49 7E                   LD A,(HL)
2908  BD4A 1F                   RRA
2909  BD4B 1F                   RRA
2910  BD4C 1F                   RRA
2911  BD4D 1F                   RRA
2912  BD4E E6 0F                AND $0F
2913  BD50 47                   LD B,A
2914  BD51 F1                   POP AF
2915  BD52 23                   INC HL
2916  BD53 6E                   LD L,(HL)
2917  BD54 2C                   INC L
2918  BD55 2D                   DEC L
2919  BD56 2E 06                LD L,$06
2920  BD58 20 57                JR NZ,RANDREC_POS_RET
2921  BD5A 21 20 00             LD HL,$0020
2922  BD5D 19                   ADD HL,DE
2923  BD5E 77                   LD (HL),A
2924  BD5F 21 0C 00             LD HL,$000C
2925  BD62 19                   ADD HL,DE
2926  BD63 79                   LD A,C
2927  BD64 96                   SUB (HL)
2928  BD65 20 0A                JR NZ,BDOS_SEEK_REPOSITION
2929  BD67 21 0E 00             LD HL,$000E
2930  BD6A 19                   ADD HL,DE
2931  BD6B 78                   LD A,B
2932  BD6C 96                   SUB (HL)
2933  BD6D E6 7F                AND $7F
2934  BD6F 28 34                JR Z,BDOS_SEEK_DONE
2935  BD71              BDOS_SEEK_REPOSITION:
2936  BD71 C5                   PUSH BC
2937  BD72 D5                   PUSH DE
2938  BD73 CD F6 BA             CALL F_CLOSE_HND
2939  BD76 D1                   POP DE
2940  BD77 C1                   POP BC
2941  BD78 2E 03                LD L,$03
2942  BD7A 3A 13 DF             LD A,(BDOS_RETVAL)
2943  BD7D 3C                   INC A
2944  BD7E 28 2A                JR Z,BDOS_SEEK_COMPUTE_3
2945  BD80 21 0C 00             LD HL,$000C
2946  BD83 19                   ADD HL,DE
2947  BD84 71                   LD (HL),C
2948  BD85 21 0E 00             LD HL,$000E
2949  BD88 19                   ADD HL,DE
2950  BD89 70                   LD (HL),B
2951  BD8A CD A7 BA             CALL FILE_OPEN_SEARCH
2952  BD8D 3A 13 DF             LD A,(BDOS_RETVAL)
2953  BD90 3C                   INC A
2954  BD91 20 12                JR NZ,BDOS_SEEK_DONE
2955  BD93 C1                   POP BC
2956  BD94 C5                   PUSH BC
2957  BD95 2E 04                LD L,$04
2958  BD97 0C                   INC C
2959  BD98 28 10                JR Z,BDOS_SEEK_COMPUTE_3
2960  BD9A CD 6F BB             CALL DIR_MAKE_ENTRY
2961  BD9D 2E 05                LD L,$05
2962  BD9F 3A 13 DF             LD A,(BDOS_RETVAL)
2963  BDA2 3C                   INC A
2964  BDA3 28 05                JR Z,BDOS_SEEK_COMPUTE_3
2965  BDA5              BDOS_SEEK_DONE:
2966  BDA5 C1                   POP BC
2967  BDA6 AF                   XOR A
2968  BDA7 C3 D0 DE             JP BDOS_RET_RESULT
2969  BDAA              BDOS_SEEK_COMPUTE_3:
2970  BDAA E5                   PUSH HL
2971  BDAB CD D8 B7             CALL FCB_GET_S2
2972  BDAE 36 C0                LD (HL),$C0
2973  BDB0 E1                   POP HL
2974  BDB1              RANDREC_POS_RET:
2975  BDB1 C1                   POP BC
2976  BDB2 7D                   LD A,L
2977  BDB3 32 13 DF             LD (BDOS_RETVAL),A
2978  BDB6 C3 F1 B7             JP MARK_FCB_S2_HIGHBIT
2979  BDB9              ; ----------------------------------------------------------------------
2980  BDB9              ; F_READRAND_BODY -- BDOS function 33 (Read Random) worker: position the FCB from its random record, then read that record.
2981  BDB9              ;   In: current FCB at $DF11 (random-record field r0/r1/r2 set by the caller); reached from BDOS_F_READRAND
2982  BDB9              ;       after FCB_AUTO_DRIVE_SELECT.
2983  BDB9              ;   Out: read result stored in the result cell (BDOS_RETVAL) by the called read routine; Z from positioning
2984  BDB9              ;        governs whether the read runs.  Clobbers: A,BC,DE,HL.
2985  BDB9              ;   Algorithm: C := $FF (read mode = do NOT extend the file); CALL BDOS_SEEK_NOREAD (BDOS_SEEK_COMPUTE) to
2986  BDB9              ;       convert the random record into extent + current-record fields; if positioning succeeded (Z), CALL
2987  BDB9              ;       FILE_READ_RECORD to read the addressed record; RET.
2988  BDB9              ;   [RE][DOC CP/M 2.2 BDOS fn 33] C=$FF is consumed inside BDOS_SEEK_COMPUTE: a read past EOF fails instead
2989  BDB9              ;       of allocating. The conditional CALL Z performs the sector read only when positioning succeeded.
2990  BDB9              ; ----------------------------------------------------------------------
2991  BDB9              F_READRAND_BODY:
2992  BDB9 0E FF                LD C,$FF
2993  BDBB CD 30 BD             CALL BDOS_SEEK_NOREAD
2994  BDBE CC 03 BC             CALL Z,FILE_READ_RECORD
2995  BDC1 C9                   RET
2996  BDC2              ; ----------------------------------------------------------------------
2997  BDC2              ; F_WRITERAND_BODY -- BDOS function 34 (Write Random) worker: position the FCB from its random record, then write that record.
2998  BDC2              ;   In: current FCB at $DF11 (random-record field set by the caller); reached from BDOS_F_WRITERAND after
2999  BDC2              ;       FCB_AUTO_DRIVE_SELECT; DMA holds the record.
3000  BDC2              ;   Out: write result stored in the result cell (BDOS_RETVAL) by the called write routine; Z from positioning
3001  BDC2              ;        governs whether the write runs.  Clobbers: A,BC,DE,HL.
3002  BDC2              ;   Algorithm: C := $00 (write mode = allocate/extend as needed); CALL BDOS_SEEK_NOREAD (BDOS_SEEK_COMPUTE)
3003  BDC2              ;       to set extent + current-record from the random record; if positioning succeeded (Z), CALL
3004  BDC2              ;       BDOS_WRITE to write the record; RET.
3005  BDC2              ;   [RE][DOC CP/M 2.2 BDOS fn 34] C=$00 is consumed inside BDOS_SEEK_COMPUTE: the extend path is taken
3006  BDC2              ;       rather than the error tail, allowing a new extent/block to be allocated.
3007  BDC2              ; ----------------------------------------------------------------------
3008  BDC2              F_WRITERAND_BODY:
3009  BDC2 0E 00                LD C,$00
3010  BDC4 CD 30 BD             CALL BDOS_SEEK_NOREAD
3011  BDC7 CC 41 BC             CALL Z,BDOS_WRITE
3012  BDCA C9                   RET
3013  BDCB              ; ----------------------------------------------------------------------
3014  BDCB              ; FCB_ALLOC_PREP -- compute the 24-bit absolute record number from an FCB's record byte plus its extent (EX) and S2 fields.
3015  BDCB              ;   In: HL = base pointer to the FCB (or directory entry); DE = byte offset within it of the low record
3016  BDCB              ;       byte to read (e.g. $20 = CR for Set Random Record, $0F for the per-extent record count in Compute File Size).
3017  BDCB              ;   Out: C = low byte, B = mid byte, A = high byte of the record number; A AND $01 leaves Z/NZ on the
3018  BDCB              ;        result's low bit for callers.  Clobbers: A,BC,HL,DE,flags.
3019  BDCB              ;   Algorithm: EX DE,HL so HL=offset, DE=FCB base; ADD HL,DE -> &FCB+offset; C := that byte, B := 0. Read
3020  BDCB              ;       the extent byte (offset $0C): RRCA then AND $80 folds its bit0 into bit7, add to C (carry into B)
3021  BDCB              ;       -- the *128 contribution; RRCA/AND $0F of the extent byte adds the extent high nibble into B. Read
3022  BDCB              ;       S2 (offset $0E): shift left 4, add into B; final AND $01 sets Z/NZ on the low bit.
3023  BDCB              ;   [RE] builds the linear absolute record index (record + ex*128 + S2*...) used by Set Random Record (fn 36)
3024  BDCB              ;       and Compute File Size (fn 35). Twin of the 44K FCB_ALLOC_PREP.
3025  BDCB              ; ----------------------------------------------------------------------
3026  BDCB              FCB_ALLOC_PREP:
3027  BDCB EB                   EX DE,HL
3028  BDCC 19                   ADD HL,DE
3029  BDCD 4E                   LD C,(HL)
3030  BDCE 06 00                LD B,$00
3031  BDD0 21 0C 00             LD HL,$000C
3032  BDD3 19                   ADD HL,DE
3033  BDD4 7E                   LD A,(HL)
3034  BDD5 0F                   RRCA
3035  BDD6 E6 80                AND $80
3036  BDD8 81                   ADD A,C
3037  BDD9 4F                   LD C,A
3038  BDDA 3E 00                LD A,$00
3039  BDDC 88                   ADC A,B
3040  BDDD 47                   LD B,A
3041  BDDE 7E                   LD A,(HL)
3042  BDDF 0F                   RRCA
3043  BDE0 E6 0F                AND $0F
3044  BDE2 80                   ADD A,B
3045  BDE3 47                   LD B,A
3046  BDE4 21 0E 00             LD HL,$000E
3047  BDE7 19                   ADD HL,DE
3048  BDE8 7E                   LD A,(HL)
3049  BDE9 87                   ADD A,A
3050  BDEA 87                   ADD A,A
3051  BDEB 87                   ADD A,A
3052  BDEC 87                   ADD A,A
3053  BDED F5                   PUSH AF
3054  BDEE 80                   ADD A,B
3055  BDEF 47                   LD B,A
3056  BDF0 F5                   PUSH AF
3057  BDF1 E1                   POP HL
3058  BDF2 7D                   LD A,L
3059  BDF3 E1                   POP HL
3060  BDF4 B5                   OR L
3061  BDF5 E6 01                AND $01
3062  BDF7 C9                   RET
3063  BDF8              ; ----------------------------------------------------------------------
3064  BDF8              ; F_COMPSIZE_BODY -- BDOS function 35 (Compute File Size) worker: scan the directory and write the max record number into r0/r1/r2.
3065  BDF8              ;   In: current FCB at $DF11; reached from BDOS_F_SIZE after FCB_AUTO_DRIVE_SELECT.
3066  BDF8              ;   Out: FCB random-record bytes r0/r1/r2 (offsets $21-$23) set to the file's record count (one past the
3067  BDF8              ;        highest record across all matching directory extents).  Clobbers: A,BC,DE,HL.
3068  BDF8              ;   Algorithm: C := $0C, DIR_SEARCH_FIRST over the first 12 FCB bytes (drive+name+type; extent NOT matched);
3069  BDF8              ;       point HL at FCB+$21 and zero the three random-record bytes. Loop over every matching entry: compute
3070  BDF8              ;       its record number via FCB_ALLOC_PREP at offset $0F and keep the running maximum in r0/r1/r2;
3071  BDF8              ;       when the search exhausts, the largest record number remains stored.
3072  BDF8              ;   [RE][DOC CP/M 2.2 BDOS fn 35] result is a record count (next free record), one past the highest used record.
3073  BDF8              ; ----------------------------------------------------------------------
3074  BDF8              F_COMPSIZE_BODY:
3075  BDF8 0E 0C                LD C,$0C
3076  BDFA CD 80 B9             CALL DIR_SEARCH_FIRST
3077  BDFD 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
3078  BE00 11 21 00             LD DE,$0021
3079  BE03 19                   ADD HL,DE
3080  BE04 E5                   PUSH HL
3081  BE05 72                   LD (HL),D
3082  BE06 23                   INC HL
3083  BE07 72                   LD (HL),D
3084  BE08 23                   INC HL
3085  BE09 72                   LD (HL),D
3086  BE0A              COMPSIZE_SCAN_LOOP:
3087  BE0A CD 6B B8             CALL CUR_RECORD_BYTES_EQUAL
3088  BE0D 28 20                JR Z,FCB_RECNUM_FROM_FIELDS_4
3089  BE0F CD CD B7             CALL FCB_BUF_PTR_ADD_OFFSET
3090  BE12 11 0F 00             LD DE,$000F
3091  BE15 CD CB BD             CALL FCB_ALLOC_PREP
3092  BE18 E1                   POP HL
3093  BE19 E5                   PUSH HL
3094  BE1A 5F                   LD E,A
3095  BE1B 79                   LD A,C
3096  BE1C 96                   SUB (HL)
3097  BE1D 23                   INC HL
3098  BE1E 78                   LD A,B
3099  BE1F 9E                   SBC A,(HL)
3100  BE20 23                   INC HL
3101  BE21 7B                   LD A,E
3102  BE22 9E                   SBC A,(HL)
3103  BE23 38 05                JR C,COMPSIZE_NEXT
3104  BE25 73                   LD (HL),E
3105  BE26 2B                   DEC HL
3106  BE27 70                   LD (HL),B
3107  BE28 2B                   DEC HL
3108  BE29 71                   LD (HL),C
3109  BE2A              COMPSIZE_NEXT:
3110  BE2A CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
3111  BE2D 18 DB                JR COMPSIZE_SCAN_LOOP
3112  BE2F              FCB_RECNUM_FROM_FIELDS_4:
3113  BE2F E1                   POP HL
3114  BE30 C9                   RET
3115  BE31              ; ----------------------------------------------------------------------
3116  BE31              ; BDOS_F_RANDREC -- BDOS function 36 (Set Random Record): compute the random-record field of the current FCB from its sequential position.
3117  BE31              ;   In: current FCB at $DF11 (whose sequential extent/CR fields are to be converted).
3118  BE31              ;   Out: bytes r0/r1/r2 (FCB offsets $21..$23) written with the 24-bit record number derived from the FCB's
3119  BE31              ;        extent and current-record fields.  Clobbers: A,BC,DE,HL.
3120  BE31              ;   Algorithm: RANDREC_FIELD_RESET stages the FCB into the scratch, then FCB_ALLOC_PREP with HL=FCB
3121  BE31              ;       base and DE=$0020 folds the CR (FCB+$20), extent number and extent-high bit into a record count in
3122  BE31              ;       C(low)/B(high)/A(overflow); then HL = FCB+$0021 and store C,B,A into FCB[$21],[$22],[$23].
3123  BE31              ;   [RE] dispatch fn 36 ($DC9B->$BE31); FCB_ALLOC_PREP is the standard extent->record-count fold.
3124  BE31              ; ----------------------------------------------------------------------
3125  BE31              BDOS_F_RANDREC:
3126  BE31 CD A3 BF             CALL RANDREC_FIELD_RESET
3127  BE34 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
3128  BE37 11 20 00             LD DE,$0020
3129  BE3A CD CB BD             CALL FCB_ALLOC_PREP
3130  BE3D 21 21 00             LD HL,$0021
3131  BE40 19                   ADD HL,DE
3132  BE41 71                   LD (HL),C
3133  BE42 23                   INC HL
3134  BE43 70                   LD (HL),B
3135  BE44 23                   INC HL
3136  BE45 77                   LD (HL),A
3137  BE46 C9                   RET
3138  BE47              ; ----------------------------------------------------------------------
3139  BE47              ; BDOS_F_SELDSK -- BDOS function 14 (Select Disk): make the drive in the select arg (DRV_SELECT_ARG) the current drive.
3140  BE47              ;   In: requested drive at $BFE3; current drive at $DF10.
3141  BE47              ;   Out: if the drive changed, $DF10 is updated and the drive is logged in / allocation vector rebuilt (via
3142  BE47              ;        DRV_LOGIN_SCAN); otherwise no-op.  Clobbers: A,HL (and whatever DRV_LOGIN_SCAN clobbers).
3143  BE47              ;   Algorithm: compare desired drive (DRV_SELECT_ARG) with current (BDOS_CUR_DRIVE); if equal return; else store the new
3144  BE47              ;       current drive and fall into DRV_LOGIN_SCAN, the select/log-in worker.
3145  BE47              ;   [RE] dispatch fn 14 ($DC6F->$BE47); matches canonical CP/M 2.2 Select Disk.
3146  BE47              ; ----------------------------------------------------------------------
3147  BE47              BDOS_F_SELDSK:
3148  BE47 3A E3 BF             LD A,(DRV_SELECT_ARG)
3149  BE4A 21 10 DF             LD HL,BDOS_CUR_DRIVE
3150  BE4D BE                   CP (HL)
3151  BE4E C8                   RET Z
3152  BE4F 77                   LD (HL),A
3153  BE50              ; ----------------------------------------------------------------------
3154  BE50              ; DRV_LOGIN_SCAN -- Select-disk / log-in worker: ensure the current drive is logged in, and rebuild its allocation vector if it was not.
3155  BE50              ;   In: current drive at $DF10; the working login/select vector DRV_SELECT_VECTOR at $BFBC.
3156  BE50              ;   Out: if the drive was newly logged in, its DPB is fetched (SELDSK_DPB_FETCH) and its allocation vector
3157  BE50              ;        rebuilt (ALLOC_VECTOR_BUILD); DRV_SELECT_VECTOR updated with the drive's login bit.  Clobbers: A,BC,DE,HL.
3158  BE50              ;   Algorithm: load the working login vector (DRV_SELECT_VECTOR); build a single-bit mask for the current drive
3159  BE50              ;       (SHR_HL_C); test (SELDSK_DPB_FETCH) whether the drive's DPB is already established; if not yet
3160  BE50              ;       logged in (Z) call $DF15 to log it in / scan its directory; if the login bit was already set (RRA
3161  BE50              ;       -> carry) just return; otherwise OR this drive's bit into DRV_SELECT_VECTOR, store it, and fall
3162  BE50              ;       into ALLOC_VECTOR_BUILD.
3163  BE50              ;   [RE] the standard CP/M 2.2 select-disk login path reached from BDOS_F_SELDSK (fn 14) and BDOS_F_DSKRESET
3164  BE50              ;       (fn 13). Twin of the 44K DRV_INSTALL_RWTS_17. [?] the RRA already-logged-in test is inferred.
3165  BE50              ; ----------------------------------------------------------------------
3166  BE50              DRV_LOGIN_SCAN:
3167  BE50 2A BC BF             LD HL,(DRV_SELECT_VECTOR)
3168  BE53 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
3169  BE56 4F                   LD C,A
3170  BE57 CD 5F B7             CALL SHR_HL_C
3171  BE5A E5                   PUSH HL
3172  BE5B EB                   EX DE,HL
3173  BE5C CD EC B5             CALL SELDSK_DPB_FETCH
3174  BE5F E1                   POP HL
3175  BE60 CC 15 DF             CALL Z,$DF15
3176  BE63 7D                   LD A,L
3177  BE64 1F                   RRA
3178  BE65 D8                   RET C
3179  BE66 2A BC BF             LD HL,(DRV_SELECT_VECTOR)
3180  BE69 4D                   LD C,L
3181  BE6A 44                   LD B,H
3182  BE6B CD 7A B7             CALL DRIVE_BIT_OR_INTO_VECTOR
3183  BE6E 22 BC BF             LD (DRV_SELECT_VECTOR),HL
3184  BE71 C3 0F B9             JP ALLOC_VECTOR_BUILD
3185  BE74              ; ----------------------------------------------------------------------
3186  BE74              ; FCB_AUTO_DRIVE_SELECT -- common file-operation preamble: reset the random scratch then honor the drive prefix in the caller's FCB.
3187  BE74              ;   In: current FCB at $DF11 (byte 0 = drive prefix, 0=default else drive+1); current drive $DF10; current user $DF0F.
3188  BE74              ;   Out: RANDREC_FIELD_RESET stages the FCB into the scratch; then FCB_LOGIN_SELECT: if the FCB names an
3189  BE74              ;        explicit drive, that drive is selected (BDOS_F_SELDSK) and the prior drive/FCB-byte saved; the
3190  BE74              ;        FCB's drive byte is rewritten to OR in the current user number.  Clobbers: A,BC,DE,HL.
3191  BE74              ;   Algorithm: CALL RANDREC_FIELD_RESET, then fall into FCB_LOGIN_SELECT.
3192  BE74              ;   [RE] the auto-disk-select / FCB drive-prefix handler that nearly every file BDOS call funnels through.
3193  BE74              ; ----------------------------------------------------------------------
3194  BE74              FCB_AUTO_DRIVE_SELECT:
3195  BE74 CD A3 BF             CALL RANDREC_FIELD_RESET
3196  BE77              ; ----------------------------------------------------------------------
3197  BE77              ; FCB_LOGIN_SELECT -- honor the drive prefix in the current FCB, temporarily selecting that drive.
3198  BE77              ;   In: current FCB at $DF11 (byte 0 = drive prefix); current drive $DF10; current user $DF0F.
3199  BE77              ;   Out: if the FCB names an explicit drive, that drive is selected (select-arg $BFE3 set, BDOS_F_SELDSK
3200  BE77              ;        called) and the prior drive is saved in the restore cells ($BFEB flag=$FF, $BFEC=saved drive,
3201  BE77              ;        $BFED=saved FCB drive byte); the FCB's drive byte is OR'd with the current user number.  Clobbers: A,BC,DE,HL.
3202  BE77              ;   Algorithm: set restore-pending flag $BFEB=$FF; read FCB byte0, mask $1F and DEC to get drive index into
3203  BE77              ;       $BFE3; if >=$1E (no explicit drive) skip the switch (FCB_MERGE_USER); else save current drive
3204  BE77              ;       ($DF10->$BFEC) and original FCB byte (->$BFED), strip the prefix bits ($E0 mask) from FCB byte0,
3205  BE77              ;       select the requested drive (BDOS_F_SELDSK); finally OR the current user number (BDOS_STACK_TOP) into FCB byte0.
3206  BE77              ;   [RE] the FCB drive-prefix handler; the matching restore is done on the BDOS bank-out epilogue. Twin of
3207  BE77              ;       the 44K FCB_AUTO_DRIVE_SELECT body.
3208  BE77              ; ----------------------------------------------------------------------
3209  BE77              FCB_LOGIN_SELECT:
3210  BE77 3E FF                LD A,$FF
3211  BE79 32 EB BF             LD (DRV_RESTORE_FLAG),A
3212  BE7C 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
3213  BE7F 7E                   LD A,(HL)
3214  BE80 E6 1F                AND $1F
3215  BE82 3D                   DEC A
3216  BE83 32 E3 BF             LD (DRV_SELECT_ARG),A
3217  BE86 FE 1E                CP $1E
3218  BE88 30 10                JR NC,FCB_MERGE_USER
3219  BE8A 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
3220  BE8D 32 EC BF             LD (DRV_SAVED_DRIVE),A
3221  BE90 7E                   LD A,(HL)
3222  BE91 32 ED BF             LD (DRV_SAVED_FCB_BYTE),A
3223  BE94 E6 E0                AND $E0
3224  BE96 77                   LD (HL),A
3225  BE97 CD 47 BE             CALL BDOS_F_SELDSK
3226  BE9A              ; ----------------------------------------------------------------------
3227  BE9A              ; FCB_MERGE_USER -- tail of FCB_LOGIN_SELECT: OR the current user number into the FCB's drive byte.
3228  BE9A              ;   In: current user number at $DF0F; current FCB at $DF11.
3229  BE9A              ;   Out: FCB byte0 |= current user number.  Clobbers: A,HL.
3230  BE9A              ;   Algorithm: load user number (BDOS_STACK_TOP), OR with FCB byte0, store back.
3231  BE9A              ;   [RE] shared exit of the auto-disk-select preamble.
3232  BE9A              ; ----------------------------------------------------------------------
3233  BE9A              FCB_MERGE_USER:
3234  BE9A 3A 0F DF             LD A,(BDOS_STACK_TOP)
3235  BE9D 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
3236  BEA0 B6                   OR (HL)
3237  BEA1 77                   LD (HL),A
3238  BEA2 C9                   RET
3239  BEA3              ; ----------------------------------------------------------------------
3240  BEA3              ; BDOS_F_VERSION -- BDOS function 12 (Return Version Number): report CP/M 2.2.
3241  BEA3              ;   In: none.  Out: low byte of the BDOS result (BDOS_RETVAL) set to $22 (= version 2.2) via $DED0.  Clobbers: A.
3242  BEA3              ;   Algorithm: load $22 and store it as the low byte of the BDOS return result.
3243  BEA3              ;   [RE] dispatch fn 12 ($DC6B->$BEA3); $22 = CP/M 2.2 per the canonical version code.
3244  BEA3              ; ----------------------------------------------------------------------
3245  BEA3              BDOS_F_VERSION:
3246  BEA3 3E 22                LD A,$22
3247  BEA5 C3 D0 DE             JP BDOS_RET_RESULT
3248  BEA8              ; ----------------------------------------------------------------------
3249  BEA8              ; BDOS_F_DSKRESET -- BDOS function 13 (Reset Disk System): return CP/M to its initial disk state.
3250  BEA8              ;   In: none.  Out: login vector (DRV_LOGIN_VECTOR $BFBA) and working login/select vector
3251  BEA8              ;       (DRV_SELECT_VECTOR $BFBC) cleared; current drive $DF10 forced to A: (0); DMA address (DMA_ADDR) reset
3252  BEA8              ;       to TBUFF ($0080); drive A logged in fresh.  Clobbers: A,HL (and DRV_LOGIN_SCAN / RESTORE_USER_DMA clobbers).
3253  BEA8              ;   Algorithm: zero $BFBA and $BFBC; set current drive $DF10=0; set DMA_ADDR $BFBE=$0080 (TBUFF); CALL
3254  BEA8              ;       RESTORE_USER_DMA (apply to the live BIOS DMA); JR DRV_LOGIN_SCAN to log in drive A.
3255  BEA8              ;   [RE] dispatch fn 13 ($DC6D->$BEA8); matches canonical CP/M 2.2 Reset Disk System.
3256  BEA8              ; ----------------------------------------------------------------------
3257  BEA8              BDOS_F_DSKRESET:
3258  BEA8 21 00 00             LD HL,$0000
3259  BEAB 22 BA BF             LD (DRV_LOGIN_VECTOR),HL
3260  BEAE 22 BC BF             LD (DRV_SELECT_VECTOR),HL
3261  BEB1 AF                   XOR A
3262  BEB2 32 10 DF             LD (BDOS_CUR_DRIVE),A
3263  BEB5 21 80 00             LD HL,$0080
3264  BEB8 22 BE BF             LD (DMA_ADDR),HL
3265  BEBB CD 4F B8             CALL RESTORE_USER_DMA
3266  BEBE 18 90                JR DRV_LOGIN_SCAN
3267  BEC0              ; ----------------------------------------------------------------------
3268  BEC0              ; BDOS_F_OPEN -- BDOS function 15 (Open File): open the file named by the FCB.
3269  BEC0              ;   In: current FCB at $DF11.
3270  BEC0              ;   Out: directory match result via FILE_OPEN_SEARCH; FCB filled in from the matching directory entry on
3271  BEC0              ;        success, $FF if not found.  Clobbers: A,BC,DE,HL.
3272  BEC0              ;   Algorithm: F_MAKE_OPEN_PREP (reset random scratch, clear S2, log in the FCB drive); JP FILE_OPEN_SEARCH.
3273  BEC0              ;   [RE] dispatch fn 15 ($DC71->$BEC0); canonical CP/M 2.2 Open File.
3274  BEC0              ; ----------------------------------------------------------------------
3275  BEC0              BDOS_F_OPEN:
3276  BEC0 CD E1 B7             CALL F_MAKE_OPEN_PREP
3277  BEC3 C3 A7 BA             JP FILE_OPEN_SEARCH
3278  BEC6              ; ----------------------------------------------------------------------
3279  BEC6              ; BDOS_F_CLOSE -- BDOS function 16 (Close File): write the FCB back to its directory entry.
3280  BEC6              ;   In: current FCB at $DF11 (must be open).
3281  BEC6              ;   Out: directory entry updated; result via the F_CLOSE_HND path ($FF / dir-code).  Clobbers: A,BC,DE,HL.
3282  BEC6              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the FCB drive prefix; JP into F_CLOSE_HND.
3283  BEC6              ;   [RE] dispatch fn 16 ($DC73->$BEC6); canonical CP/M 2.2 Close File.
3284  BEC6              ; ----------------------------------------------------------------------
3285  BEC6              BDOS_F_CLOSE:
3286  BEC6 CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3287  BEC9 C3 F6 BA             JP F_CLOSE_HND
3288  BECC              ; ----------------------------------------------------------------------
3289  BECC              ; BDOS_F_SFIRST -- BDOS function 17 (Search for First): find the first directory entry matching the FCB.
3290  BECC              ;   In: current FCB at $DF11 (staged from DE). FCB byte0 = $3F ('?') means 'match every entry'.
3291  BECC              ;   Out: directory match copied to the DMA buffer; result (0..3 = dir position, or $FF none) via SET_DMA_TO_DISK_BUF_2.
3292  BECC              ;   Clobbers: A,BC,DE,HL.
3293  BECC              ;   Algorithm: RANDREC_FIELD_RESET; C=0 (default match length); fetch FCB byte0; if byte0==$3F do an
3294  BECC              ;       unqualified all-entries scan; else test the extent byte FCB[$0C] -- if not '?' CLEAR_FCB_S2 -- then
3295  BECC              ;       FCB_LOGIN_SELECT and C=$0F (15-byte name+type+extent match); fall into DIR_SEARCH_AND_COPY.
3296  BECC              ;   [RE] dispatch fn 17 ($DC75->$BECC); canonical CP/M 2.2 Search First; $3F is the '?' all-match marker.
3297  BECC              ; ----------------------------------------------------------------------
3298  BECC              BDOS_F_SFIRST:
3299  BECC CD A3 BF             CALL RANDREC_FIELD_RESET
3300  BECF 0E 00                LD C,$00
3301  BED1 EB                   EX DE,HL
3302  BED2 7E                   LD A,(HL)
3303  BED3 FE 3F                CP $3F
3304  BED5 28 0E                JR Z,DIR_SEARCH_AND_COPY
3305  BED7 CD 1C B7             CALL FCB_PTR_EXTENT
3306  BEDA 7E                   LD A,(HL)
3307  BEDB FE 3F                CP $3F
3308  BEDD              SFIRST_CLR_S2:
3309  BEDD C4 EB B7             CALL NZ,CLEAR_FCB_S2
3310  BEE0 CD 77 BE             CALL FCB_LOGIN_SELECT
3311  BEE3 0E 0F                LD C,$0F
3312  BEE5              ; ----------------------------------------------------------------------
3313  BEE5              ; DIR_SEARCH_AND_COPY -- run the directory scan and copy the matched entry to the DMA buffer.
3314  BEE5              ;   In: C = number of bytes to compare; search FCB already established by BDOS_F_SFIRST.
3315  BEE5              ;   Out: matching directory record moved to the DMA buffer; A = directory position (0..3) or $FF if none.
3316  BEE5              ;   Clobbers: A,BC,DE,HL.
3317  BEE5              ;   Algorithm: DIR_SEARCH_FIRST performs the directory search with the C-byte mask; JP SET_DMA_TO_DISK_BUF_2 (the
3318  BEE5              ;       disk-buffer -> user-DMA copy) to deliver the located entry and return the result code.
3319  BEE5              ;   [RE] shared search tail for fn 17 (Search First) and fn 18 (Search Next).
3320  BEE5              ; ----------------------------------------------------------------------
3321  BEE5              DIR_SEARCH_AND_COPY:
3322  BEE5 CD 80 B9             CALL DIR_SEARCH_FIRST
3323  BEE8 C3 5D B8             JP SET_DMA_TO_DISK_BUF_2
3324  BEEB              ; ----------------------------------------------------------------------
3325  BEEB              ; BDOS_F_SNEXT -- BDOS function 18 (Search for Next): continue a directory search begun by Search First.
3326  BEEB              ;   In: the saved search FCB pointer at $DF85 (stored by RANDREC_FIELD_RESET during Search First).
3327  BEEB              ;   Out: next matching directory record copied to the DMA buffer; A = position (0..3) or $FF if no more.
3328  BEEB              ;   Clobbers: A,BC,DE,HL.
3329  BEEB              ;   Algorithm: restore the saved search FCB pointer ($DF85 -> DE); RANDREC_FIELD_RESET; FCB_LOGIN_SELECT;
3330  BEEB              ;       BDOS_DIR_SCAN_NEXT advances the scan from the saved position; JP SET_DMA_TO_DISK_BUF_2 to deliver the hit.
3331  BEEB              ;   [RE] dispatch fn 18 ($DC77->$BEEB); canonical CP/M 2.2 Search Next.
3332  BEEB              ; ----------------------------------------------------------------------
3333  BEEB              BDOS_F_SNEXT:
3334  BEEB ED 5B 85 DF          LD DE,(DEFERRED_COPY_DST)
3335  BEEF CD A3 BF             CALL RANDREC_FIELD_RESET
3336  BEF2 EB                   EX DE,HL
3337  BEF3 CD 77 BE             CALL FCB_LOGIN_SELECT
3338  BEF6 CD 95 B9             CALL BDOS_DIR_SCAN_NEXT
3339  BEF9 C3 5D B8             JP SET_DMA_TO_DISK_BUF_2
3340  BEFC              ; ----------------------------------------------------------------------
3341  BEFC              ; BDOS_F_DELETE -- BDOS function 19 (Delete File): erase all directory entries matching the FCB.
3342  BEFC              ;   In: current FCB at $DF11 (possibly ambiguous).
3343  BEFC              ;   Out: matching directory entries marked deleted ($E5) and their allocation freed; result via
3344  BEFC              ;        DIR_RETURN_MATCH_FLAG ($FF if none / dir code).  Clobbers: A,BC,DE,HL.
3345  BEFC              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; F_DELETE_HND scans and erases each matching
3346  BEFC              ;       entry (releasing its blocks); JP DIR_RETURN_MATCH_FLAG.
3347  BEFC              ;   [RE] dispatch fn 19 ($DC79->$BEFC); canonical CP/M 2.2 Delete File.
3348  BEFC              ; ----------------------------------------------------------------------
3349  BEFC              BDOS_F_DELETE:
3350  BEFC CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3351  BEFF CD F9 B9             CALL F_DELETE_HND
3352  BF02 C3 69 B9             JP DIR_RETURN_MATCH_FLAG
3353  BF05              ; ----------------------------------------------------------------------
3354  BF05              ; BDOS_F_READ_SEQ -- BDOS function 20 (Read Sequential): read the next 128-byte record of the open file.
3355  BF05              ;   In: current FCB at $DF11 positioned at the next sequential record.
3356  BF05              ;   Out: one record read into the DMA buffer; A = 0 on success or a nonzero read-error/EOF code; FCB
3357  BF05              ;        position advanced.  Clobbers: A,BC,DE,HL.
3358  BF05              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; JP FILE_WRITE_SEQ (the sequential entry into
3359  BF05              ;       the shared read core; the FILE_WRITE_SEQ/FILE_READ_SEQ labels are cross-wired in this 60K build).
3360  BF05              ;   [RE] dispatch fn 20 ($DC7B->$BF05); canonical CP/M 2.2 Read Sequential.
3361  BF05              ; ----------------------------------------------------------------------
3362  BF05              BDOS_F_READ_SEQ:
3363  BF05 CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3364  BF08 C3 FE BB             JP FILE_WRITE_SEQ
3365  BF0B              ; ----------------------------------------------------------------------
3366  BF0B              ; BDOS_F_WRITE_SEQ -- BDOS function 21 (Write Sequential): write the next 128-byte record to the open file.
3367  BF0B              ;   In: current FCB at $DF11; DMA buffer holds the record to write.
3368  BF0B              ;   Out: one record written; A = 0 on success or a nonzero error code (disk full / R/O); FCB position
3369  BF0B              ;        advanced, allocation extended as needed.  Clobbers: A,BC,DE,HL.
3370  BF0B              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; JP FILE_READ_SEQ (the sequential entry into
3371  BF0B              ;       the shared write core; the FILE_READ_SEQ/FILE_WRITE_SEQ labels are cross-wired in this 60K build).
3372  BF0B              ;   [RE] dispatch fn 21 ($DC7D->$BF0B); canonical CP/M 2.2 Write Sequential.
3373  BF0B              ; ----------------------------------------------------------------------
3374  BF0B              BDOS_F_WRITE_SEQ:
3375  BF0B CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3376  BF0E C3 3C BC             JP FILE_READ_SEQ
3377  BF11              ; ----------------------------------------------------------------------
3378  BF11              ; BDOS_F_MAKE -- BDOS function 22 (Make File): create a new directory entry for the FCB.
3379  BF11              ;   In: current FCB at $DF11 naming the file to create.
3380  BF11              ;   Out: a fresh, empty directory entry allocated and the FCB opened against it; A = dir position or $FF if
3381  BF11              ;        the directory is full.  Clobbers: A,BC,DE,HL.
3382  BF11              ;   Algorithm: F_MAKE_OPEN_PREP (reset random scratch, clear S2, log in the FCB drive); JP DIR_MAKE_ENTRY.
3383  BF11              ;   [RE] dispatch fn 22 ($DC7F->$BF11); canonical CP/M 2.2 Make File.
3384  BF11              ; ----------------------------------------------------------------------
3385  BF11              BDOS_F_MAKE:
3386  BF11 CD E1 B7             CALL F_MAKE_OPEN_PREP
3387  BF14 C3 6F BB             JP DIR_MAKE_ENTRY
3388  BF17              ; ----------------------------------------------------------------------
3389  BF17              ; BDOS_F_RENAME -- BDOS function 23 (Rename File): change a file's name in its directory entries.
3390  BF17              ;   In: current FCB at $DF11 whose first 12 bytes hold the old name and bytes $10.. the new name.
3391  BF17              ;   Out: every matching directory entry's name field rewritten to the new name; result via DIR_RETURN_MATCH_FLAG.
3392  BF17              ;   Clobbers: A,BC,DE,HL.
3393  BF17              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; F_RENAME_HND rewrites matched entries; JP
3394  BF17              ;       DIR_RETURN_MATCH_FLAG.
3395  BF17              ;   [RE] dispatch fn 23 ($DC81->$BF17); canonical CP/M 2.2 Rename File.
3396  BF17              ; ----------------------------------------------------------------------
3397  BF17              BDOS_F_RENAME:
3398  BF17 CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3399  BF1A CD 6E BA             CALL F_RENAME_HND
3400  BF1D C3 69 B9             JP DIR_RETURN_MATCH_FLAG
3401  BF20              ; ----------------------------------------------------------------------
3402  BF20              ; BDOS_F_LOGINVEC -- BDOS function 24 (Return Login Vector): report which drives are logged in.
3403  BF20              ;   In: DRV_SELECT_VECTOR (DRV_SELECT_VECTOR) = working login/select vector (bit d = drive d logged in).
3404  BF20              ;   Out: BDOS result HL = the login vector (returned via BDOS_RET_RESULT_HL, result cell $DF13).  Clobbers: HL.
3405  BF20              ;   Algorithm: load the working login vector (DRV_SELECT_VECTOR) and store it as the 16-bit BDOS result.
3406  BF20              ;   [RE] dispatch fn 24 ($DC83->$BF20); canonical CP/M 2.2 Return Login Vector.
3407  BF20              ; ----------------------------------------------------------------------
3408  BF20              BDOS_F_LOGINVEC:
3409  BF20 2A BC BF             LD HL,(DRV_SELECT_VECTOR)
3410  BF23 18 23                JR BDOS_RET_RESULT_HL
3411  BF25              ; ----------------------------------------------------------------------
3412  BF25              ; BDOS_F_CURDSK -- BDOS function 25 (Return Current Disk): report the current default drive.
3413  BF25              ;   In: current drive at $DF10.  Out: BDOS result A = current drive (0=A:) via $DED0.  Clobbers: A.
3414  BF25              ;   Algorithm: load the current-drive cell (BDOS_CUR_DRIVE) and return it as the BDOS result.
3415  BF25              ;   [RE] dispatch fn 25 ($DC85->$BF25); canonical CP/M 2.2 Return Current Disk.
3416  BF25              ; ----------------------------------------------------------------------
3417  BF25              BDOS_F_CURDSK:
3418  BF25 3A 10 DF             LD A,(BDOS_CUR_DRIVE)
3419  BF28 C3 D0 DE             JP BDOS_RET_RESULT
3420  BF2B              ; ----------------------------------------------------------------------
3421  BF2B              ; BDOS_F_SETDMA -- BDOS function 26 (Set DMA Address): set the disk read/write buffer address.
3422  BF2B              ;   In: DE = new DMA (disk transfer) address supplied by the caller.
3423  BF2B              ;   Out: DMA_ADDR (DMA_ADDR) set to DE and pushed through to the BIOS disk-buffering layer.  Clobbers: A,HL
3424  BF2B              ;        (and RESTORE_USER_DMA clobbers).
3425  BF2B              ;   Algorithm: move DE into HL, store at DMA_ADDR (DMA_ADDR), JP RESTORE_USER_DMA to apply it to the live BIOS SETDMA.
3426  BF2B              ;   [RE] dispatch fn 26 ($DC87->$BF2B); canonical CP/M 2.2 Set DMA Address.
3427  BF2B              ; ----------------------------------------------------------------------
3428  BF2B              BDOS_F_SETDMA:
3429  BF2B EB                   EX DE,HL
3430  BF2C 22 BE BF             LD (DMA_ADDR),HL
3431  BF2F C3 4F B8             JP RESTORE_USER_DMA
3432  BF32              ; ----------------------------------------------------------------------
3433  BF32              ; BDOS_F_ALLOCVEC -- BDOS function 27 (Return Allocation Vector address).
3434  BF32              ;   In: the allocation (block-in-use) bit-vector base pointer at (ALLOC_VEC_PTR).
3435  BF32              ;   Out: BDOS result HL = the allocation vector address (via BDOS_RET_RESULT_HL).  Clobbers: HL.
3436  BF32              ;   Algorithm: load the allocation-vector pointer (ALLOC_VEC_PTR) and store it as the 16-bit BDOS result.
3437  BF32              ;   [RE] dispatch fn 27 ($DC89->$BF32); canonical CP/M 2.2 Get Allocation Vector.
3438  BF32              ; ----------------------------------------------------------------------
3439  BF32              BDOS_F_ALLOCVEC:
3440  BF32 2A CC BF             LD HL,(ALLOC_VEC_PTR)
3441  BF35 18 11                JR BDOS_RET_RESULT_HL
3442  BF37              ; ----------------------------------------------------------------------
3443  BF37              ; BDOS_F_ROVEC -- BDOS function 29 (Return Read-Only Vector): report which drives are read-only.
3444  BF37              ;   In: DRV_LOGIN_VECTOR (DRV_LOGIN_VECTOR) -- here read as the read-only bit vector master copy.
3445  BF37              ;   Out: BDOS result HL = the read-only drive vector (bit d set = drive d is R/O) via BDOS_RET_RESULT_HL.  Clobbers: HL.
3446  BF37              ;   Algorithm: load the R/O vector (DRV_LOGIN_VECTOR) and store it as the 16-bit BDOS result.
3447  BF37              ;   [RE] dispatch fn 29 ($DC8D->$BF37); canonical CP/M 2.2 Get Read-Only Vector. [?] the cell is named
3448  BF37              ;       DRV_LOGIN_VECTOR but holds the R/O bits in this build.
3449  BF37              ; ----------------------------------------------------------------------
3450  BF37              BDOS_F_ROVEC:
3451  BF37 2A BA BF             LD HL,(DRV_LOGIN_VECTOR)
3452  BF3A 18 0C                JR BDOS_RET_RESULT_HL
3453  BF3C              ; ----------------------------------------------------------------------
3454  BF3C              ; BDOS_F_ATTRIB -- BDOS function 30 (Set File Attributes): write the FCB's attribute bits into its directory entries.
3455  BF3C              ;   In: current FCB at $DF11 carrying the desired attribute (high) bits in its name/type bytes.
3456  BF3C              ;   Out: matching directory entries updated with the new attributes; result via DIR_RETURN_MATCH_FLAG.  Clobbers: A,BC,DE,HL.
3457  BF3C              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; F_ATTRIB_HND copies the attribute bits into
3458  BF3C              ;       each matched entry; JP DIR_RETURN_MATCH_FLAG.
3459  BF3C              ;   [RE] dispatch fn 30 ($DC8F->$BF3C); canonical CP/M 2.2 Set File Attributes.
3460  BF3C              ; ----------------------------------------------------------------------
3461  BF3C              BDOS_F_ATTRIB:
3462  BF3C CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3463  BF3F CD 92 BA             CALL F_ATTRIB_HND
3464  BF42 C3 69 B9             JP DIR_RETURN_MATCH_FLAG
3465  BF45              ; ----------------------------------------------------------------------
3466  BF45              ; BDOS_F_GETDPB -- BDOS function 31 (Return Disk Parameter Block address).
3467  BF45              ;   In: the current drive's DPB pointer at (DPB_PTR) (set during disk select/log-in).
3468  BF45              ;   Out: BDOS result HL = the DPB address (falls into the shared result-store BDOS_RET_RESULT_HL).  Clobbers: HL.
3469  BF45              ;   Algorithm: load the DPB pointer (DPB_PTR) and store it as the 16-bit BDOS result.
3470  BF45              ;   [RE] dispatch fn 31 ($DC91->$BF45); canonical CP/M 2.2 Get DPB.
3471  BF45              ; ----------------------------------------------------------------------
3472  BF45              BDOS_F_GETDPB:
3473  BF45 2A C8 BF             LD HL,(DPB_PTR)
3474  BF48              ; ----------------------------------------------------------------------
3475  BF48              ; BDOS_RET_RESULT_HL -- common exit: store the 16-bit value in HL as the BDOS return result.
3476  BF48              ;   In: HL = value to return to the caller.
3477  BF48              ;   Out: BDOS result cell ($DF13, in the BDOS upper bank) = HL.  Clobbers: none (writes memory).
3478  BF48              ;   Algorithm: store HL at the BDOS result cell (BDOS_RETVAL) and return.
3479  BF48              ;   [RE] the HL-valued counterpart of the byte-result store; used by the get-vector / get-pointer
3480  BF48              ;       functions (login vector, alloc vector, R/O vector, DPB) and fallen into from BDOS_F_GETDPB.
3481  BF48              ; ----------------------------------------------------------------------
3482  BF48              BDOS_RET_RESULT_HL:
3483  BF48 22 13 DF             LD (BDOS_RETVAL),HL
3484  BF4B C9                   RET
3485  BF4C              ; ----------------------------------------------------------------------
3486  BF4C              ; BDOS_F_USERNUM -- BDOS function 32 (Get/Set User Code).
3487  BF4C              ;   In: the caller's argument in $BFE3 ($FF = 'get', else the user number to set); current user at $DF0F.
3488  BF4C              ;   Out: if get: BDOS result A = current user number (via $DED0); if set: current user $DF0F updated to (arg AND $1F).  Clobbers: A.
3489  BF4C              ;   Algorithm: if the argument (DRV_SELECT_ARG) is $FF, return the current user number (BDOS_STACK_TOP); otherwise fall into
3490  BF4C              ;       SET_USER_NUMBER to mask the argument to 0..31 and store it.
3491  BF4C              ;   [RE] dispatch fn 32 ($DC93->$BF4C); canonical CP/M 2.2 Get/Set User; $FF = query.
3492  BF4C              ; ----------------------------------------------------------------------
3493  BF4C              BDOS_F_USERNUM:
3494  BF4C 3A E3 BF             LD A,(DRV_SELECT_ARG)
3495  BF4F FE FF                CP $FF
3496  BF51 20 06                JR NZ,SET_USER_NUMBER
3497  BF53 3A 0F DF             LD A,(BDOS_STACK_TOP)
3498  BF56 C3 D0 DE             JP BDOS_RET_RESULT
3499  BF59              ; ----------------------------------------------------------------------
3500  BF59              ; SET_USER_NUMBER -- set path of BDOS function 32: change the current user number.
3501  BF59              ;   In: A = requested user number.  Out: current user number $DF0F = A AND $1F (0..31).  Clobbers: A.
3502  BF59              ;   Algorithm: mask the requested user number to 5 bits and store it at $DF0F.
3503  BF59              ;   [RE] continuation of BDOS_F_USERNUM (Get/Set User).
3504  BF59              ; ----------------------------------------------------------------------
3505  BF59              SET_USER_NUMBER:
3506  BF59 E6 1F                AND $1F
3507  BF5B 32 0F DF             LD (BDOS_STACK_TOP),A
3508  BF5E C9                   RET
3509  BF5F              ; ----------------------------------------------------------------------
3510  BF5F              ; BDOS_F_READRAND -- BDOS function 33 (Read Random): read the record addressed by the FCB's random-record field.
3511  BF5F              ;   In: current FCB at $DF11 whose r0/r1/r2 ($21..$23) hold the target record number.
3512  BF5F              ;   Out: that record read into the DMA buffer; A = 0 on success or a random-read error code (e.g. 1=reading
3513  BF5F              ;        unwritten data, 6=record number out of range); FCB positioned at that record.  Clobbers: A,BC,DE,HL.
3514  BF5F              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; JP F_READRAND_BODY (seek to the random record and read it).
3515  BF5F              ;   [RE] dispatch fn 33 ($DC95->$BF5F); canonical CP/M 2.2 Read Random.
3516  BF5F              ; ----------------------------------------------------------------------
3517  BF5F              BDOS_F_READRAND:
3518  BF5F CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3519  BF62 C3 B9 BD             JP F_READRAND_BODY
3520  BF65              ; ----------------------------------------------------------------------
3521  BF65              ; BDOS_F_WRITERAND -- BDOS function 34 (Write Random): write the record addressed by the FCB's random-record field.
3522  BF65              ;   In: current FCB at $DF11 whose r0/r1/r2 hold the target record number; DMA buffer holds the record.
3523  BF65              ;   Out: that record written; A = 0 on success or a random-write error code; file extended/allocated as needed.  Clobbers: A,BC,DE,HL.
3524  BF65              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; JP F_WRITERAND_BODY.
3525  BF65              ;   [RE] dispatch fn 34 ($DC97->$BF65); canonical CP/M 2.2 Write Random.
3526  BF65              ; ----------------------------------------------------------------------
3527  BF65              BDOS_F_WRITERAND:
3528  BF65 CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3529  BF68 C3 C2 BD             JP F_WRITERAND_BODY
3530  BF6B              ; ----------------------------------------------------------------------
3531  BF6B              ; BDOS_F_SIZE -- BDOS function 35 (Compute File Size): set the FCB's random-record field to the file's record count.
3532  BF6B              ;   In: current FCB at $DF11 naming the file.
3533  BF6B              ;   Out: FCB r0/r1/r2 ($21..$23) set to the number of 128-byte records in the file (its 'virtual size').  Clobbers: A,BC,DE,HL.
3534  BF6B              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; JP F_COMPSIZE_BODY (scans the directory
3535  BF6B              ;       extents for the highest record and writes it into the FCB random-record field).
3536  BF6B              ;   [RE] dispatch fn 35 ($DC99->$BF6B); canonical CP/M 2.2 Compute File Size.
3537  BF6B              ; ----------------------------------------------------------------------
3538  BF6B              BDOS_F_SIZE:
3539  BF6B CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3540  BF6E C3 F8 BD             JP F_COMPSIZE_BODY
3541  BF71              ; ----------------------------------------------------------------------
3542  BF71              ; BDOS_F_RESET_DRIVE -- BDOS function 37 (Reset Drive): mark the drives named by the caller's bit mask as no longer logged in.
3543  BF71              ;   In: the caller's reset bit-mask staged at $DF11 (one bit per drive to reset); DRV_SELECT_VECTOR (DRV_SELECT_VECTOR)
3544  BF71              ;       = working login vector; DRV_LOGIN_VECTOR (DRV_LOGIN_VECTOR) = master logged-in / R-O master vector.
3545  BF71              ;   Out: for each drive bit set in the mask, that drive's bit is cleared in both DRV_SELECT_VECTOR and
3546  BF71              ;        DRV_LOGIN_VECTOR, forcing a fresh log-in on next access.  Clobbers: A,DE,HL.
3547  BF71              ;   Algorithm: form the bitwise complement of the caller's reset mask (BDOS_PARAM_PTR); AND it into DRV_SELECT_VECTOR
3548  BF71              ;       (DRV_SELECT_VECTOR) to clear those login bits and store back; then AND the masked login word with
3549  BF71              ;       DRV_LOGIN_VECTOR (DRV_LOGIN_VECTOR) and store back.
3550  BF71              ;   [RE] dispatch fn 37 ($DC9D->$BF71); canonical CP/M 2.2 Reset Drive (selective reset).
3551  BF71              ; ----------------------------------------------------------------------
3552  BF71              BDOS_F_RESET_DRIVE:
3553  BF71 2A 11 DF             LD HL,(BDOS_PARAM_PTR)
3554  BF74 7D                   LD A,L
3555  BF75 2F                   CPL
3556  BF76 5F                   LD E,A
3557  BF77 7C                   LD A,H
3558  BF78 2F                   CPL
3559  BF79 2A BC BF             LD HL,(DRV_SELECT_VECTOR)
3560  BF7C A4                   AND H
3561  BF7D 57                   LD D,A
3562  BF7E 7D                   LD A,L
3563  BF7F A3                   AND E
3564  BF80 5F                   LD E,A
3565  BF81 2A BA BF             LD HL,(DRV_LOGIN_VECTOR)
3566  BF84 EB                   EX DE,HL
3567  BF85 22 BC BF             LD (DRV_SELECT_VECTOR),HL
3568  BF88 7D                   LD A,L
3569  BF89 A3                   AND E
3570  BF8A 6F                   LD L,A
3571  BF8B 7C                   LD A,H
3572  BF8C A2                   AND D
3573  BF8D 67                   LD H,A
3574  BF8E 22 BA BF             LD (DRV_LOGIN_VECTOR),HL
3575  BF91 C9                   RET
3576  BF92              ; ----------------------------------------------------------------------
3577  BF92              ; BDOS_F_WRITEZF -- BDOS function 40 (Write Random with Zero Fill): like Write Random, but newly allocated blocks are pre-filled with zeros.
3578  BF92              ;   In: current FCB at $DF11 whose r0/r1/r2 hold the target record number; DMA buffer holds the record.
3579  BF92              ;   Out: the record written at the random position; any block newly allocated to reach it is zero-filled
3580  BF92              ;        first; A = 0 or a random-write error code.  Clobbers: A,BC,DE,HL.
3581  BF92              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; set write-type WRITE_TYPE=$BFE2 := 2
3582  BF92              ;       (zero-fill); C=0; CALL BDOS_SEEK_COMPUTE and, on success (Z), CALL BDOS_WRITE.
3583  BF92              ;   [RE] dispatch fn 40 ($DCA3->$BF92); canonical CP/M 2.2 Write Random with Zero Fill; WRITE_TYPE=2
3584  BF92              ;       distinguishes it from normal Write Random.
3585  BF92              ; ----------------------------------------------------------------------
3586  BF92              BDOS_F_WRITEZF:
3587  BF92 CD 74 BE             CALL FCB_AUTO_DRIVE_SELECT
3588  BF95 3E 02                LD A,$02
3589  BF97 32 E2 BF             LD (WRITE_TYPE_FLAG),A
3590  BF9A 0E 00                LD C,$00
3591  BF9C CD 34 BD             CALL BDOS_SEEK_COMPUTE
3592  BF9F CC 41 BC             CALL Z,BDOS_WRITE
3593  BFA2 C9                   RET
3594  BFA3              ; ----------------------------------------------------------------------
3595  BFA3              ; RANDREC_FIELD_RESET -- stage the caller's FCB into the BDOS scratch FCB and record it as the current/search FCB.
3596  BFA3              ;   In: the caller's FCB pointer (in HL/DE at the call site); the scratch region at $DF87..
3597  BFA3              ;   Out: current-FCB pointer $DF11 and saved-search-FCB pointer $DF85 both set to the scratch FCB copy at
3598  BFA3              ;        $DF88; a 36-byte ($24) FCB image staged there via the lower-LC copy trampoline ($DF3C); DE = $DF88.
3599  BFA3              ;   Clobbers: A,BC,DE,HL.
3600  BFA3              ;   Algorithm: bump the sequence byte at $DF87; HL := $DF88; store to $DF11 and $DF85; BC := $0024; CALL
3601  BFA3              ;       $DF3C (the lower-LC LDIR-across-banks helper) to copy the FCB into the scratch; DE := $DF88.
3602  BFA3              ;   [RE] common front end of the random-record and search functions; keeps a private copy of the caller's
3603  BFA3              ;       FCB in the BDOS bank so the file machinery can run with the LC banked in. [?]
3604  BFA3              ; ----------------------------------------------------------------------
3605  BFA3              RANDREC_FIELD_RESET:
3606  BFA3 21 87 DF             LD HL,DEFERRED_COPY_FLAG
3607  BFA6 34                   INC (HL)
3608  BFA7 23                   INC HL
3609  BFA8 22 11 DF             LD (BDOS_PARAM_PTR),HL
3610  BFAB EB                   EX DE,HL
3611  BFAC 22 85 DF             LD (DEFERRED_COPY_DST),HL
3612  BFAF 01 24 00             LD BC,$0024
3613  BFB2 CD 3C DF             CALL $DF3C
3614  BFB5 11 88 DF             LD DE,DEFERRED_COPY_BUF
3615  BFB8 C9                   RET
3616  BFB9              ; ----------------------------------------------------------------------
3617  BFB9              ; EMPTY_DIR_FCB -- Sentinel byte $E5 used as an empty/deleted directory-entry marker and zero-FCB source. [RE]
3618  BFB9              ; ----------------------------------------------------------------------
3619  BFB9              EMPTY_DIR_FCB:
3620  BFB9 E5                   DEFB    $E5
3621  BFBA              ; ----------------------------------------------------------------------
3622  BFBA              ; DRV_LOGIN_VECTOR -- 16-bit master drive vector at $BFBA. Despite the name, this build uses it as the
3623  BFBA              ; READ-ONLY drive vector (set by BDOS_F_SETRO, tested by DRIVE_BIT_TEST, reported by BDOS_F_ROVEC). [RE]
3624  BFBA              ; ----------------------------------------------------------------------
3625  BFBA              DRV_LOGIN_VECTOR:
3626  BFBA 00 00                DEFB    "\0\0"
3627  BFBC              ; ----------------------------------------------------------------------
3628  BFBC              ; DRV_SELECT_VECTOR -- 16-bit working login/select vector at $BFBC (bit d set = drive d logged in). Read
3629  BFBC              ; by BDOS_F_LOGINVEC, maintained by DRV_LOGIN_SCAN and BDOS_F_RESET_DRIVE. [RE]
3630  BFBC              ; ----------------------------------------------------------------------
3631  BFBC              DRV_SELECT_VECTOR:
3632  BFBC 00 00                DEFB    "\0\0"
3633  BFBE              ; ----------------------------------------------------------------------
3634  BFBE              ; DMA_ADDR -- 16-bit user DMA (disk transfer) address at $BFBE, default TBUFF ($0080). Set by BDOS_F_SETDMA
3635  BFBE              ; / BDOS_F_DSKRESET and applied to the BIOS via RESTORE_USER_DMA. [RE]
3636  BFBE              ; ----------------------------------------------------------------------
3637  BFBE              DMA_ADDR:
3638  BFBE 80 00                DEFB    $80,$00
3639  BFC0                  ENT
3640  EA00              ; -------------------- end lower LC bank (back to $EA00 image top) --------------------
3641  EA00              BDOS_IMAGE_END:                          ; first byte past the BDOS image ($EA00)
3642  EA00
3643  EA00                  IFNDEF CPM60_LINK  ; [link] master defines CPM60_LINK and owns this; standalone keeps it
3644  EA00                  ; Image size from its bracketing labels, not a magic length, as in the 2.23-44K twin.
3645  EA00                  ; The ENT above has closed the lower-bank DISP, so BDOS_IMAGE_END is the physical top
3646  EA00                  ; of the image rather than a $Bxxx run address.
3647  EA00                  ASSERT BDOS_IMAGE_END == $EA00
3648  EA00                  SAVEBIN "{out_bin}", $DC00, BDOS_IMAGE_END - $DC00
3649  EA00                  ENDIF
3650  EA00
3651  EA00              ; ----------------------------------------------------------------------
3652  EA00              ; BDOS work cells -- the 44K BDOS's cells, relocated.
3653  EA00              ;   The 60K BDOS is the 44K BDOS moved into the language card, and its scratch
3654  EA00              ;   cells moved with it by two constant offsets, one per bank:
3655  EA00              ;       upper bank  +$3FCE   (44K $9F41 -> 60K $DF0F)
3656  EA00              ;       lower bank  +$160D   (44K $A9B3 -> 60K $BFC0)
3657  EA00              ;   Those two deltas account for every cell with no exceptions, which is how
3658  EA00              ;   this naming was derived: the 44K twin's layout, order and field widths were
3659  EA00              ;   carried across and then checked against the addresses the 60K code actually
3660  EA00              ;   references. The names are therefore the SAME names as the 44K tree uses, so
3661  EA00              ;   a reader can move between the two.
3662  EA00              ;
3663  EA00              ;   The image ends at $BFC0 (DMA_ADDR is its last emitted storage), so unlike
3664  EA00              ;   the 44K -- where these cells are emitted zero bytes inside the image -- here
3665  EA00              ;   they are plain RAM above it. They are declared as a layout: one ORG at the
3666  EA00              ;   base, then a label per cell with its width carried in the arithmetic that
3667  EA00              ;   advances to the next. Labels emit no bytes, so this names the region without
3668  EA00              ;   adding any. [RE]
3669  EA00              ; ----------------------------------------------------------------------
3670  EA00                      ORG $BFC0                     ; = 44K $A9B3 + $160D
3671  BFC0              DPB_WORK_PTR0:                           ; 2 bytes  (44K $A9B3)
3672  BFC0                      ORG DPB_WORK_PTR0 + 2
3673  BFC2              DEBLOCK_HSTREC_PTR0:                     ; 2 bytes  (44K $A9B5)
3674  BFC2                      ORG DEBLOCK_HSTREC_PTR0 + 2
3675  BFC4              DEBLOCK_HSTREC_PTR1:                     ; 2 bytes  (44K $A9B7)
3676  BFC4                      ORG DEBLOCK_HSTREC_PTR1 + 2
3677  BFC6              DIRBUF_PTR:                              ; 2 bytes  (44K $A9B9)
3678  BFC6                      ORG DIRBUF_PTR + 2
3679  BFC8              DPB_PTR:                                 ; 2 bytes  (44K $A9BB)
3680  BFC8                      ORG DPB_PTR + 2
3681  BFCA              REC_BYTE_OFFSET:                         ; 2 bytes  (44K $A9BD)
3682  BFCA                      ORG REC_BYTE_OFFSET + 2
3683  BFCC              ALLOC_VEC_PTR:                           ; 2 bytes  (44K $A9BF)
3684  BFCC                      ORG ALLOC_VEC_PTR + 2
3685  BFCE              DPB_SPT:                                 ; 2 bytes  (44K $A9C1)
3686  BFCE                      ORG DPB_SPT + 2
3687  BFD0              DPB_BSH:                                 ; 1 byte  (44K $A9C3)
3688  BFD0                      ORG DPB_BSH + 1
3689  BFD1              DPB_BLM:                                 ; 1 byte  (44K $A9C4)
3690  BFD1                      ORG DPB_BLM + 1
3691  BFD2              DPB_EXM:                                 ; 1 byte  (44K $A9C5)
3692  BFD2                      ORG DPB_EXM + 1
3693  BFD3              MAX_BLOCK_DSM:                           ; 2 bytes  (44K $A9C6)
3694  BFD3                      ORG MAX_BLOCK_DSM + 2
3695  BFD5              DPB_REC_PTR:                             ; 2 bytes  (44K $A9C8)
3696  BFD5                      ORG DPB_REC_PTR + 2
3697  BFD7              ALLOC_END_PTR:                           ; 2 bytes  (44K $A9CA)
3698  BFD7                      ORG ALLOC_END_PTR + 2
3699  BFD9              REC_SCAN_PTR:                            ; 2 bytes  (44K $A9CC)
3700  BFD9                      ORG REC_SCAN_PTR + 2
3701  BFDB              DPB_OFF:                                 ; 2 bytes  (44K $A9CE)
3702  BFDB                      ORG DPB_OFF + 2
3703  BFDD              DPB_XLT_PTR:                             ; 2 bytes  (44K $A9D0)
3704  BFDD                      ORG DPB_XLT_PTR + 2
3705  BFDF              DIR_DIRTY_FLAG:                          ; 1 byte  (44K $A9D2)
3706  BFDF                      ORG DIR_DIRTY_FLAG + 1
3707  BFE0              RW_DIRECTION_FLAG:                       ; 1 byte  (44K $A9D3)
3708  BFE0                      ORG RW_DIRECTION_FLAG + 1
3709  BFE1              DIR_MATCH_FLAG:                          ; 1 byte  (44K $A9D4)
3710  BFE1                      ORG DIR_MATCH_FLAG + 1
3711  BFE2              WRITE_TYPE_FLAG:                         ; 1 byte  (44K $A9D5)
3712  BFE2                      ORG WRITE_TYPE_FLAG + 1
3713  BFE3              DRV_SELECT_ARG:                          ; 1 byte  (44K $A9D6)
3714  BFE3                      ORG DRV_SELECT_ARG + 1
3715  BFE4              ALLOC_SLOT_INDEX:                        ; 1 byte  (44K $A9D7)
3716  BFE4                      ORG ALLOC_SLOT_INDEX + 1
3717  BFE5              DIR_CMP_LEN:                             ; 1 byte  (44K $A9D8)
3718  BFE5                      ORG DIR_CMP_LEN + 1
3719  BFE6              DIR_FCB_PTR:                             ; 4 bytes  (44K $A9D9)
3720  BFE6                      ORG DIR_FCB_PTR + 4
3721  BFEA              BLOCK_WIDTH_FLAG:                        ; 1 byte  (44K $A9DD)
3722  BFEA                      ORG BLOCK_WIDTH_FLAG + 1
3723  BFEB              DRV_RESTORE_FLAG:                        ; 1 byte  (44K $A9DE)
3724  BFEB                      ORG DRV_RESTORE_FLAG + 1
3725  BFEC              DRV_SAVED_DRIVE:                         ; 1 byte  (44K $A9DF)
3726  BFEC                      ORG DRV_SAVED_DRIVE + 1
3727  BFED              DRV_SAVED_FCB_BYTE:                      ; 1 byte  (44K $A9E0)
3728  BFED                      ORG DRV_SAVED_FCB_BYTE + 1
3729  BFEE              FCB_RECCOUNT:                            ; 1 byte  (44K $A9E1)
3730  BFEE                      ORG FCB_RECCOUNT + 1
3731  BFEF              FCB_EXTENT_MASKED:                       ; 1 byte  (44K $A9E2)
3732  BFEF                      ORG FCB_EXTENT_MASKED + 1
3733  BFF0              FCB_CURREC:                              ; 2 bytes  (44K $A9E3)
3734  BFF0                      ORG FCB_CURREC + 2
3735  BFF2              CUR_BLOCK_NUMBER:                        ; 2 bytes  (44K $A9E5)
3736  BFF2                      ORG CUR_BLOCK_NUMBER + 2
3737  BFF4              BLOCK_BASE_RECORD:                       ; 2 bytes  (44K $A9E7)
3738  BFF4                      ORG BLOCK_BASE_RECORD + 2
3739  BFF6              DEBLOCK_BYTE_OFF:                        ; 1 byte  (44K $A9E9)
3740  BFF6                      ORG DEBLOCK_BYTE_OFF + 1
3741  BFF7              CUR_RECORD:                              ; 1 byte  (44K $A9EA)
3742  BFF7                      ORG CUR_RECORD + 1
3743  BFF8              CUR_RECORD_HI:                           ; 1 byte  (44K $A9EB)
3744  BFF8                      ORG CUR_RECORD_HI + 1
3745  BFF9              REC_CACHE:                               ; 20 bytes  (44K $A9EC)
3746  BFF9                      ORG REC_CACHE + 20
3747  C00D              BDOS_WORKCELLS_END:                      ; , first byte past the work cells
3748  C00D
3749  C00D                  ; Pin the relocated layout to the addresses the shipped code references.
3750  C00D                  ASSERT DPB_SPT       == $BFCE
3751  C00D                  ASSERT MAX_BLOCK_DSM == $BFD3
3752  C00D                  ASSERT REC_CACHE     == $BFF9
3753  C00D                  ASSERT BDOS_WORKCELLS_END == $C00D
3754  C00D
# file closed: CPM_BDOS.asm

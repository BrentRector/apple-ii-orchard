  15  0000                  INCLUDE "cpm_system_220.inc"
# file opened: cpm_system_220.inc
   1+ 0000              ; ============================================================================
   2+ 0000              ; cpm_system_220.inc -- CP/M 2.20 (44K) cross-module system contract
   3+ 0000              ; ----------------------------------------------------------------------------
   4+ 0000              ; The de-skewed 2.20-44K system image is TWO independent compilations -- the CCP
   5+ 0000              ; ($9400-$9BFF) and the BDOS ($9C00-$A9FF) -- decoded at their true RUNTIME
   6+ 0000              ; addresses (see ../docs/CPM_Skew_Findings.md). On the correctly-addressed source
   7+ 0000              ; the two are almost decoupled: the CCP calls the BDOS only through the page-zero
   8+ 0000              ; $0005 ABI (cpm22.inc :: BDOS), and the ONLY direct cross-module symbols are the
   9+ 0000              ; two module bases below. They are defined ONCE here and INCLUDEd by both modules
  10+ 0000              ; (never duplicated -- feedback_no_duplicate_symbol_definitions). The earlier
  11+ 0000              ; "59 CCP->BDOS cross-refs" were sector-skew artifacts and do not exist on the
  12+ 0000              ; de-skewed source.
  13+ 0000              ; ============================================================================
  14+ 0000
  15+ 0000              ; Memory-config axis: the 56K (Language Card) system is the 44K image lifted +$3000
  16+ 0000              ; (CCP $9400->$C400, BDOS $9C00->$CC00, BIOS $AA00->$DA00 = Apple LC $D400/$DC00/$EA00).
  17+ 0000              ; Because every address below is derived from this single offset, defining CFG_56K
  18+ 0000              ; (the build's -D flag) re-homes the whole 2.20 OS by re-assembly alone -- no per-cell
  19+ 0000              ; edits. See ../docs/CPM_56K_60K_Fold_Plan.md.
  20+ 0000                  IFDEF CFG_56K
  21+ 0000 ~            OS_RELOC   EQU $3000      ; 56K: OS relocated into the Apple Language Card
  22+ 0000                  ELSE
  23+ 0000              OS_RELOC   EQU $0000      ; 44K: OS in main RAM (the base build)
  24+ 0000                  ENDIF
  25+ 0000
  26+ 0000              CCP_ENTRY  EQU $9400 + OS_RELOC  ; CBASE: CCP cold entry (JP cold-start); BDOS fn 0 / warm boot returns here
  27+ 0000              BDOS_FBASE EQU $9C00 + OS_RELOC  ; FBASE: BDOS image base (6-byte serial + JP +6 entry); top-of-TPA marker the CCP loads
  28+ 0000              BIOS_FBASE EQU $AA00 + OS_RELOC  ; WBOOT/BIOS base = the first byte PAST the BDOS image (CPM_BDOS asserts $ == this)
  29+ 0000
  30+ 0000              ; Region sizes are computed from the contiguous module boundaries above -- never a magic
  31+ 0000              ; number -- so they track the image layout (and the byte gate catches any overrun via the
  32+ 0000              ; CPM_BDOS end-of-image ASSERT). CCP -> BDOS -> BIOS are back-to-back.
  33+ 0000              CCP_SIZE   EQU BDOS_FBASE - CCP_ENTRY     ; $0800: CCP image size  = (first BDOS byte) - (first CCP byte)
  34+ 0000              BDOS_SIZE  EQU BIOS_FBASE - BDOS_FBASE    ; $0E00: BDOS image size = (byte after BDOS) - (first BDOS byte)
  35+ 0000
  36+ 0000              ; --- CCP cells referenced cross-module (single source of truth, by label arithmetic) ---
  37+ 0000              ; CCP_INLEN ($9407 = CCP_ENTRY+7): the CCP console-line returned-count byte (CCP_INBUF+1).
  38+ 0000              ; It doubles as the staged / auto-command flag -- nonzero on CCP entry means a command line
  39+ 0000              ; is already staged in CCP_CMDTEXT and is re-parsed instead of re-prompting (the SUBMIT/$SUB
  40+ 0000              ; chaining hook). The CCP warm-start clears it; the 2.20B BIOS warm-boot path ALSO clears it
  41+ 0000              ; (XOR A; LD (CCP_INLEN),A) so a BIOS-driven warm boot discards any stale staged command and
  42+ 0000              ; the CCP re-prompts cleanly. (The base 2.20 BIOS does not reference it; this is the lone
  43+ 0000              ; genuine BIOS->CCP cell, introduced by 2.20B.)
  44+ 0000              CCP_INLEN  EQU CCP_ENTRY + 7
  45+ 0000
# file closed: cpm_system_220.inc
  16  0000                  ORG BDOS_FBASE               ; $9C00 (44K) or $CC00 (CFG_56K)
  17  9C00                  ENDIF
  18  9C00              ; (BDOS_IMAGE_HEADER == module base; defined in cpm_system_220.inc)
  19  9C00              ; The 6-byte DRI/Microsoft serial number. It differs per released disk; the 2.20B-56K
  20  9C00              ; disk carries a different tail than the 1980 2.20-44K disk (V220B selects it). The CCP
  21  9C00              ; keeps a matching copy at CCP_SERIAL and self-checks it against this header.
  22  9C00                  IFDEF V220B
  23  9C00 ~                    DEFB    $BD,$16,$00,$00,$60,$D9   ; 2.20B serial
  24  9C00                  ELSE
  25  9C00 BD 16 00 00          DEFB    $BD,$16,$00,$00,$16,$DF   ; 2.20 serial
  25  9C04 16 DF
  26  9C06                  ENDIF
  27  9C06              ; ----------------------------------------------------------------------
  28  9C06              ; BDOS_ENTRY -- the BDOS=$0005-vector landing point (FBASE+6); jumps to the function dispatcher.
  29  9C06              ;   In: C = BDOS function number, DE = info address (or single-byte arg in E) -- the standard $0005
  30  9C06              ;       call ABI.
  31  9C06              ;   Out: jumps to BDOS_DISPATCH; never returns here (the handler RETs through the common BDOS exit).
  32  9C06              ;   Clobbers: none of its own (single JP).
  33  9C06              ;   Algorithm: OBSERVED -- one JP BDOS_DISPATCH. The page-zero $0005 jump-vector targets this
  34  9C06              ;              address ($9C06), so every BDOS call enters here. [RE]
  35  9C06              ; ----------------------------------------------------------------------
  36  9C06              BDOS_ENTRY:
  37  9C06                      ; enter the function dispatcher; reached from the page-zero BDOS=$0005 jump vector
  38  9C06 C3 11 9C             JP BDOS_DISPATCH
  39  9C09              ; ----------------------------------------------------------------------
  40  9C09              ; BDOS_ERR_VECTORS -- DATA: first entry of a 4-word table of BDOS disk-error reporter addresses.
  41  9C09              ;   In: a caller does LD HL,<one of these 4 word slots> then falls into the reporter helper at
  42  9C09              ;       $9F4A, which does LD E,(HL)/INC HL/LD D,(HL)/EX DE,HL/JP (HL) to enter the selected
  43  9C09              ;       reporter.
  44  9C09              ;   Out: this slot's word is the run address of the Bad-Sector (permanent disk) error reporter.
  45  9C09              ;   Clobbers: n/a (data).
  46  9C09              ;   Algorithm: OBSERVED -- two DATA bytes ($99 $9C) forming the address of the Bad-Sector reporter;
  47  9C09              ;              mis-decoded as SBC A,C / SBC A,H. This slot is loaded by the random-record path (the
  48  9C09              ;              caller at $9FBD: LD HL,BDOS_ERR_VECTORS). The four reporters print 'Bdos Err On d:'
  49  9C09              ;              then a '$'-terminated cause string ('Bad Sector' / 'Select' / 'R/O' / 'File R/O').
  50  9C09              ;              [RE]
  51  9C09              ; ----------------------------------------------------------------------
  52  9C09              BDOS_ERR_VECTORS:
  53  9C09                      ; DATA: low byte of the Bad-Sector (permanent disk-error) reporter address -- mis-decoded as
  54  9C09                      ;       SBC A,C
  55  9C09 99                   SBC A,C
  56  9C0A                      ; DATA: high byte ($9C) of the Bad-Sector reporter address
  57  9C0A 9C                   DEFB $9C+(OS_RELOC>>8)
  58  9C0B              ; ----------------------------------------------------------------------
  59  9C0B              ; BDOS_ERRVEC_SELECT -- DATA: word for the Select-error reporter in the BDOS error-vector table.
  60  9C0B              ;   In: n/a (data; this label's address is loaded into HL by the helper-front-end at $9F47 (LD
  61  9C0B              ;       HL,BDOS_ERRVEC_SELECT) before falling into the $9F4A reporter dispatch).
  62  9C0B              ;   Out: n/a (the word here is the run address of the 'Select' error reporter, which prints the
  63  9C0B              ;        message then warm-boots).
  64  9C0B              ;   Clobbers: n/a (data).
  65  9C0B              ;   Algorithm: OBSERVED -- two DATA bytes ($A5 $9C) forming the Select-error reporter address;
  66  9C0B              ;              mis-decoded as AND L / SBC A,H. [RE]
  67  9C0B              ; ----------------------------------------------------------------------
  68  9C0B              BDOS_ERRVEC_SELECT:
  69  9C0B                      ; DATA: low byte of the Select-error reporter address -- mis-decoded as AND L
  70  9C0B A5                   AND L
  71  9C0C                      ; DATA: high byte ($9C) of the Select-error reporter address
  72  9C0C 9C                   DEFB $9C+(OS_RELOC>>8)
  73  9C0D              ; ----------------------------------------------------------------------
  74  9C0D              ; BDOS_ERRVEC_RODISK -- DATA: word for the R/O-disk error reporter in the BDOS error-vector table.
  75  9C0D              ;   In: n/a (data; loaded into HL by the caller at $A158 (LD HL,BDOS_ERRVEC_RODISK), reached when a
  76  9C0D              ;       write is attempted to a read-only-flagged drive).
  77  9C0D              ;   Out: n/a (the word here is the run address of the reporter that prints 'R/O').
  78  9C0D              ;   Clobbers: n/a (data).
  79  9C0D              ;   Algorithm: OBSERVED -- two DATA bytes ($AB $9C) forming the R/O-disk reporter address;
  80  9C0D              ;              mis-decoded as XOR E / SBC A,H. The exact CP/M error sub-class ('R/O disk' vs 'disk
  81  9C0D              ;              changed to R/O') is UNKNOWN from these bytes; the reported cause string is 'R/O'.
  82  9C0D              ;              [RE]
  83  9C0D              ; ----------------------------------------------------------------------
  84  9C0D              BDOS_ERRVEC_RODISK:
  85  9C0D                      ; DATA: low byte of the R/O-disk reporter address -- mis-decoded as XOR E
  86  9C0D AB                   XOR E
  87  9C0E                      ; DATA: high byte ($9C) of the R/O-disk reporter address
  88  9C0E 9C                   DEFB $9C+(OS_RELOC>>8)
  89  9C0F              ; ----------------------------------------------------------------------
  90  9C0F              ; BDOS_ERRVEC_FILERO -- DATA: word for the File-R/O error reporter in the BDOS error-vector table.
  91  9C0F              ;   In: n/a (data; loaded into HL by the caller at $A14E (LD HL,BDOS_ERRVEC_FILERO), reached on a
  92  9C0F              ;       write to a read-only file).
  93  9C0F              ;   Out: n/a (the word here is the run address of the reporter that prints 'File R/O').
  94  9C0F              ;   Clobbers: n/a (data).
  95  9C0F              ;   Algorithm: OBSERVED -- two DATA bytes ($B1 $9C) forming the File-R/O reporter address;
  96  9C0F              ;              mis-decoded as OR C / SBC A,H. This is the last of the 4 error-vector words;
  97  9C0F              ;              BDOS_DISPATCH begins immediately after. [RE]
  98  9C0F              ; ----------------------------------------------------------------------
  99  9C0F              BDOS_ERRVEC_FILERO:
 100  9C0F                      ; DATA: low byte of the File-R/O reporter address -- mis-decoded as OR C
 101  9C0F B1                   OR C
 102  9C10                      ; DATA: high byte ($9C) of the File-R/O reporter address
 103  9C10 9C                   DEFB $9C+(OS_RELOC>>8)
 104  9C11              ; ----------------------------------------------------------------------
 105  9C11              ; BDOS_DISPATCH -- the CP/M 2.2 FDOS dispatcher: set up the BDOS frame and vector to the function
 106  9C11              ; handler.
 107  9C11              ;   In: C = BDOS function number (valid 0..40); DE = info address (single-byte arg also in E);
 108  9C11              ;       caller's SP live.
 109  9C11              ;   Out: control transfers (JP (HL)) to the selected handler with HL = the caller's info-address; on
 110  9C11              ;        out-of-range C (>= 41) it RETs straight to the just-pushed common exit, returning the
 111  9C11              ;        default 0 result.
 112  9C11              ;   Clobbers: A, BC, DE, HL, SP (switches to the private BDOS stack).
 113  9C11              ;   Algorithm: OBSERVED -- save caller DE (the info-address) into BDOS_PARAM_PTR; copy low byte E
 114  9C11              ;              into the requested-drive/byte-param cell DRV_SELECT_ARG; default the word result
 115  9C11              ;              (BDOS_RETVAL) to 0; capture caller SP into BDOS_SAVED_SP and switch SP to the private
 116  9C11              ;              BDOS stack top (BDOS_STACK_TOP); clear two per-call state cells (DRV_SAVED_FCB_BYTE, DRV_RESTORE_FLAG) to
 117  9C11              ;              0; push the common BDOS exit (FCB_AUTO_DRIVE_RESTORE = $A974) so every handler RETs
 118  9C11              ;              through it; range-check the function number A (=C) against $29 (41) -- CP $29 / RET
 119  9C11              ;              NC returns to the exit when A >= 41. Then move byte-arg E into C for the handler, set
 120  9C11              ;              the index DE = function number (LD E,A / LD D,0), index BDOS_DISPATCH_TBL by 2*A (two
 121  9C11              ;              ADD HL,DE), fetch the handler word into DE, reload the saved info-address into HL, EX
 122  9C11              ;              DE,HL, and JP (HL). Dispatch is static-indexed: function N selects table entry N.
 123  9C11              ;              [RE]
 124  9C11              ; ----------------------------------------------------------------------
 125  9C11              BDOS_DISPATCH:
 126  9C11 EB                   EX DE,HL
 127  9C12                      ; save the caller's DE info-address (reloaded into HL just before JP (HL) to the handler)
 128  9C12 22 43 9F             LD (BDOS_PARAM_PTR),HL
 129  9C15 EB                   EX DE,HL
 130  9C16 7B                   LD A,E
 131  9C17                      ; stash the low arg byte E as the requested drive / byte parameter
 132  9C17 32 D6 A9             LD (DRV_SELECT_ARG),A
 133  9C1A                      ; default the BDOS word result to 0 before dispatch
 134  9C1A 21 00 00             LD HL,$0000
 135  9C1D                      ; clear the BDOS word-result cell (read back by the common exit)
 136  9C1D 22 45 9F             LD (BDOS_RETVAL),HL
 137  9C20                      ; HL was 0, so HL := caller's SP
 138  9C20 39                   ADD HL,SP
 139  9C21                      ; save the caller's stack pointer for the common exit to restore
 140  9C21 22 0F 9F             LD (BDOS_SAVED_SP),HL
 141  9C24                      ; switch to the private BDOS internal stack
 142  9C24 31 41 9F             LD SP,BDOS_STACK_TOP
 143  9C27 AF                   XOR A
 144  9C28                      ; clear a per-call disk/reselect state cell (A=0 from XOR A)
 145  9C28 32 E0 A9             LD (DRV_SAVED_FCB_BYTE),A
 146  9C2B                      ; clear a second per-call state cell (A=0)
 147  9C2B 32 DE A9             LD (DRV_RESTORE_FLAG),A
 148  9C2E                      ; load the common BDOS exit/return-result address ($A974)
 149  9C2E 21 74 A9             LD HL,FCB_AUTO_DRIVE_RESTORE
 150  9C31                      ; push the common exit so every handler RETs back through it
 151  9C31 E5                   PUSH HL
 152  9C32                      ; A := function number for the range check and the table index
 153  9C32 79                   LD A,C
 154  9C33                      ; range-check: function number 41 ($29) or higher is out of range
 155  9C33 FE 29                CP $29
 156  9C35                      ; out-of-range -> return to the common exit with the default (0) result
 157  9C35 D0                   RET NC
 158  9C36                      ; move the byte argument (E) into C for the handler (C is now free since A holds the func
 159  9C36                      ; number)
 160  9C36 4B                   LD C,E
 161  9C37                      ; base of the 41-entry handler table
 162  9C37 21 47 9C             LD HL,BDOS_DISPATCH_TBL
 163  9C3A                      ; DE := function number (E=A, D=0) as the table index
 164  9C3A 5F                   LD E,A
 165  9C3B                      ; high byte of the index = 0
 166  9C3B 16 00                LD D,$00
 167  9C3D                      ; index by 2*A: two ADD HL,DE advance HL by 2*function-number
 168  9C3D 19                   ADD HL,DE
 169  9C3E 19                   ADD HL,DE
 170  9C3F                      ; fetch handler address low byte
 171  9C3F 5E                   LD E,(HL)
 172  9C40 23                   INC HL
 173  9C41                      ; fetch handler address high byte
 174  9C41 56                   LD D,(HL)
 175  9C42                      ; reload the caller's info-address into HL for the handler
 176  9C42 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
 177  9C45 EB                   EX DE,HL
 178  9C46                      ; enter the selected BDOS function handler
 179  9C46 E9                   JP (HL)
 180  9C47              ; ----------------------------------------------------------------------
 181  9C47              ; BDOS_DISPATCH_TBL -- 41-entry BDOS function dispatch table (one handler address per function
 182  9C47              ; 0..40).
 183  9C47              ;   In: indexed by 2*A (the function number) in BDOS_DISPATCH.
 184  9C47              ;   Out: the selected word is fetched and entered via JP (HL).
 185  9C47              ;   Clobbers: n/a (data).
 186  9C47              ;   Algorithm: OBSERVED -- a table of 16-bit handler run addresses. In-image handlers ($9Cxx-$A8xx)
 187  9C47              ;              render as labels; handlers above this staged image render as raw $hex; functions
 188  9C47              ;              4..11 sit in the DEFB run at $9C4F that the disassembler did not split into DEFW.
 189  9C47              ;              Functions 0-36 ($00-$24) are the standard CP/M 2.2 set; slots 37-40 ($25-$28) are
 190  9C47              ;              SoftCard/2.2 extensions (37 = drive-login mask, 38/39 = RET no-op stubs, 40 = Write
 191  9C47              ;              Random Zero Fill). [RE]
 192  9C47              ; ----------------------------------------------------------------------
 193  9C47              BDOS_DISPATCH_TBL:
 194  9C47                      ; fn 0 ($00) System Reset (warm boot)
 195  9C47 03 AA                DEFW    $AA03+OS_RELOC
 196  9C49                      ; fn 1 ($01) Console Input -> A

5644  A9EC 00 00 00...          DEFS    20, $00                  ; fill
5645  AA00              BDOS_IMAGE_END:                          ; first byte past the BDOS image
5646  AA00
5647  AA00                  IFNDEF CPM_LINK
5648  AA00                  ; The de-skewed BDOS must exactly fill its $9C00..$AA00 slot, so BDOS_SIZE
5649  AA00                  ; (cpm_system_220.inc, = BIOS_FBASE - BDOS_FBASE) tracks the real image extent and
5650  AA00                  ; any overrun fails the build here rather than silently truncating the SAVEBIN.
5651  AA00                  ASSERT BDOS_IMAGE_END == BIOS_FBASE
5652  AA00                  SAVEBIN "{out_bin}", BDOS_FBASE, BDOS_SIZE
5653  AA00                  ENDIF

# file opened: CPM_BDOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.20 (44K) -- BDOS (Basic Disk Operating System)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; Runtime-addressed (de-skewed): ORG $9C00 (FBASE), runs $9C00-$A9FF. An independent
   5  0000              ; compilation: $9C00 image header (serial + JP $9C06 entry), the 41-entry function
   6  0000              ; dispatch table ($9C47), console/line-edit, FCB/directory/allocation, disk record
   7  0000              ; deblock + RWTS, the variable page ($A9xx). References the CCP base once (CCP_ENTRY,
   8  0000              ; warm boot). The 44K system tracks store this sector-interleaved; the disk producer
   9  0000              ; re-applies the skew (cpm_pipeline/deskew.py). See ../../docs/CPM_Skew_Findings.md.
  10  0000              ; ============================================================================
  11  0000
  12  0000                  IFNDEF CPM_LINK
  13  0000                  DEVICE NOSLOT64K
  14  0000                  INCLUDE "cpm22.inc"
# file opened: cpm22.inc
   1+ 0000              ; cpm22.inc -- canonical Digital Research CP/M 2.2 definitions shared by SoftCard
   2+ 0000              ; CP/M sources.  Defined ONCE here and INCLUDEd by each source rather than re-deriving
   3+ 0000              ; magic numbers per file.  EQUs are zero-width, so including this is byte-identical.
   4+ 0000              ; This is the OS/ABI counterpart to apple_softcard.inc (which holds the Apple/SoftCard
   5+ 0000              ; HARDWARE externals); keep the two concerns separate.
   6+ 0000              ;
   7+ 0000              ; Source: CP/M 2.2 Interface Guide / "CP/M Reference Manual" [DOC CPMREF] (in the
   8+ 0000              ; archive at softcard/reference/softcard-cpm-archive/manuals/transcribed/).
   9+ 0000              ;
  10+ 0000              ; NOTE on the base page: $0000 (warm-boot JP) and $0005 (BDOS JP) are implementation
  11+ 0000              ; LABELS inside the BIOS/CCP/BDOS modules but CALL TARGETS in transient programs.  The
  12+ 0000              ; cell EQUs below are for the transient-program (caller) view; an OS module that DEFINES
  13+ 0000              ; these vectors as its own labels should not also pull in this base-page section.
  14+ 0000
  15+ 0000              ; ---- base page (transient-program view) ----------------------------------------
  16+ 0000                  IFNDEF CPM22_INC
  17+ 0000                  DEFINE CPM22_INC
  18+ 0000
  19+ 0000              WBOOTV      EQU $0000      ; warm-boot vector: JP WBOOT (a CALL/JP $0000 restarts CP/M)
  20+ 0000              IOBYTE_ADDR EQU $0003      ; [DOC S&HD 2-18] logical<->physical device map: four 2-bit
  21+ 0000                                         ;   fields, CONSOLE (0-1), READER (2-3), PUNCH (4-5), LIST
  22+ 0000                                         ;   (6-7); set via STAT or BDOS fns 7/8. Each field selects
  23+ 0000                                         ;   which I/O Vector Table entry (#1 or #2) is used.
  24+ 0000              CDISK_ADDR  EQU $0004      ; current drive (low nibble) / user (high nibble)
  25+ 0000              BDOS        EQU $0005      ; BDOS entry vector: CALL BDOS with C=function, DE=arg
  26+ 0000              RST2_VEC    EQU $0010      ; Z-80 RST 2 ($10) restart vector (8 bytes); CP/M leaves it for the app/debugger
  27+ 0000              RST4_VEC    EQU $0020      ; Z-80 RST 4 ($20) restart vector (8 bytes); CP/M leaves it for the app/debugger
  28+ 0000              TFCB        EQU $005C      ; default FCB parsed from the command tail
  29+ 0000              TFCB2       EQU $006C      ; second parsed FCB (overlaps TFCB+16)
  30+ 0000              TBUFF       EQU $0080      ; default DMA buffer (128 B); also the command-tail buffer
  31+ 0000              CMDLINE     EQU $0081      ; command-tail characters (TBUFF+1): $0080 = length, $0081+ = the upper-cased tail
  32+ 0000              TPA         EQU $0100      ; transient program area / load address
  33+ 0000
  34+ 0000              ; ---- BDOS function numbers (register C) ----------------------------------------
  35+ 0000              P_TERMCPM   EQU 0          ; system reset (return to CCP)
  36+ 0000              C_READ      EQU 1          ; console input (echoed) -> A
  37+ 0000              C_WRITE     EQU 2          ; console output (E = char)
  38+ 0000              A_READ      EQU 3          ; reader (AUX) input -> A
  39+ 0000              A_WRITE     EQU 4          ; punch (AUX) output (E = char)
  40+ 0000              L_WRITE     EQU 5          ; list (printer) output (E = char)
  41+ 0000              C_RAWIO     EQU 6          ; direct console I/O (E=$FF read / else write)
  42+ 0000              A_STATIN    EQU 7          ; get IOBYTE -> A
  43+ 0000              A_STATOUT   EQU 8          ; set IOBYTE (E = value)
  44+ 0000              C_WRITESTR  EQU 9          ; print '$'-terminated string (DE -> string)
  45+ 0000              C_READSTR   EQU 10         ; buffered console line input (DE -> buffer)
  46+ 0000              C_STAT      EQU 11         ; console status -> A (0 = none ready)
  47+ 0000              S_BDOSVER   EQU 12         ; return BDOS version -> HL
  48+ 0000              DRV_ALLRESET EQU 13        ; reset disk system
  49+ 0000              DRV_SET     EQU 14         ; select drive (E = 0=A..15=P)
  50+ 0000              F_OPEN      EQU 15         ; open file (DE -> FCB)
  51+ 0000              F_CLOSE     EQU 16         ; close file (DE -> FCB)
  52+ 0000              F_SFIRST    EQU 17         ; search for first (DE -> FCB)
  53+ 0000              F_SNEXT     EQU 18         ; search for next
  54+ 0000              F_DELETE    EQU 19         ; delete file (DE -> FCB)
  55+ 0000              F_READ      EQU 20         ; read sequential (DE -> FCB)
  56+ 0000              F_WRITE     EQU 21         ; write sequential (DE -> FCB)
  57+ 0000              F_MAKE      EQU 22         ; create file (DE -> FCB)
  58+ 0000              F_RENAME    EQU 23         ; rename file (DE -> FCB)
  59+ 0000              DRV_LOGINVEC EQU 24        ; return login vector -> HL
  60+ 0000              DRV_GET     EQU 25         ; return current drive -> A
  61+ 0000              F_DMAOFF    EQU 26         ; set DMA address (DE)
  62+ 0000              DRV_ALLOCVEC EQU 27        ; return allocation vector -> HL
  63+ 0000              DRV_SETRO   EQU 28         ; write-protect current drive
  64+ 0000              DRV_ROVEC   EQU 29         ; return read-only vector -> HL
  65+ 0000              F_ATTRIB    EQU 30         ; set file attributes (DE -> FCB)
  66+ 0000              DRV_DPB     EQU 31         ; return DPB address -> HL
  67+ 0000              F_USERNUM   EQU 32         ; get/set user number (E=$FF get / else set)
  68+ 0000              F_READRAND  EQU 33         ; read random (DE -> FCB)
  69+ 0000              F_WRITERAND EQU 34         ; write random (DE -> FCB)
  70+ 0000              F_SIZE      EQU 35         ; compute file size (DE -> FCB)
  71+ 0000              F_RANDREC   EQU 36         ; set random record (DE -> FCB)
  72+ 0000              DRV_RESET   EQU 37         ; reset drives (DE = drive vector)
  73+ 0000              F_WRITEZF   EQU 40         ; write random with zero fill (DE -> FCB)
  74+ 0000
  75+ 0000              ; ---- FCB field offsets (from the start of a 36-byte FCB) ------------------------
  76+ 0000              ; ---------------------------------------------------------------------------
  77+ 0000              ; CP/M 2.2 on-disk / in-memory STRUCTURES.
  78+ 0000              ;
  79+ 0000              ; These replace the flat FCB_* offset EQUs that used to live here. A structure
  80+ 0000              ; gives the field a NAME at the use site instead of a bare number, and it lets a
  81+ 0000              ; step between two fields be written as arithmetic on the names, which a magic
  82+ 0000              ; number cannot be checked against. That is the same rule the repo already
  83+ 0000              ; applies to code sizes (a size is label-after minus label-on-first-byte).
  84+ 0000              ;
  85+ 0000              ; It is not cosmetic. Every structure below had a field mislabelled in the
  86+ 0000              ; sources at some point, and each time the cause was the same: the operand was a
  87+ 0000              ; bare number, so nothing contradicted a wrong comment. FCB offset 12 was called
  88+ 0000              ; "the current-record byte" at twelve sites across two trees; the DPB byte the
  89+ 0000              ; deblock tests was called a "deblock flag"; the DPH word holding the DPB pointer
  90+ 0000              ; was reached by an unnamed +10.
  91+ 0000              ;
  92+ 0000              ; A DIRECTORY ENTRY and an FCB are the same 32 bytes, with the FCB adding four.
  93+ 0000              ; The STRUCT carries the spelled-out name and the FIELDS keep their CP/M manual names.
  94+ 0000              ; EX and RC and AL only ever looked opaque because they sat on a bare number; read as
  95+ 0000              ; FCB.DIRECTORY_ENTRY.EX the path supplies the context the abbreviation assumes:
  96+ 0000              ;
  97+ 0000              ;      0                              31 32   33 34 35
  98+ 0000              ;     +--------------------------------+-----+--------+
  99+ 0000              ;     |      DIRECTORY_ENTRY (32)      | CR  | R0 R1 R2|
 100+ 0000              ;     +--------------------------------+-----+--------+
 101+ 0000              ;     |<---------- FCB (36) ---------------------------->|
 102+ 0000              ;
 103+ 0000              ; So reach a shared field through the structure you actually hold:
 104+ 0000              ;   holding an FCB          ->  FCB.DIRECTORY_ENTRY.EX
 105+ 0000              ;   holding a directory     ->  DIRECTORY_ENTRY.EX           (e.g. in DIRBUF)
 106+ 0000              ; Both are 12. The difference is that the NAME states which one the code has,
 107+ 0000              ; and that distinction is real: ALLOC_FROM_FCB, despite its name, walks a
 108+ 0000              ; DIRECTORY ENTRY out of DIRBUF, not a user FCB.
 109+ 0000              ; ---------------------------------------------------------------------------
 110+ 0000                  STRUCT DIRECTORY_ENTRY
 111+ 0000 ~            ST      BYTE           ; 0   status. In a DIRECTORY entry this is the user number
 112+ 0000 ~                                   ;     (0..31), or $E5 for a free/deleted slot. In an FCB the
 113+ 0000 ~                                   ;     same byte is DRI's DR, the drive code (0 = default,
 114+ 0000 ~                                   ;     1..16 = A..P). One byte, two meanings, and which one
 115+ 0000 ~                                   ;     applies is exactly what the struct path now states.
 116+ 0000 ~            FN      BLOCK 8        ; 1   filename, space-padded
 117+ 0000 ~            FT      BLOCK 3        ; 9   filetype; high bits flag R/O, SYS, archive
 118+ 0000 ~            EX      BYTE           ; 12  extent number, LOW 5 BITS ONLY. The extent is a PAIR:
 119+ 0000 ~                                   ;     EX + 32*S2. This is NOT the current record; that is CR
 120+ 0000 ~                                   ;     at offset 32, and it is 7 bits (0..127).
 121+ 0000 ~            S1      BYTE           ; 13  reserved
 122+ 0000 ~            S2      BYTE           ; 14  extent number, high bits (see EX)
 123+ 0000 ~            RC      BYTE           ; 15  records in the current extent (0..128)
 124+ 0000 ~            AL      BLOCK 16       ; 16  allocation map: 16 block bytes, or 8 block WORDS when
 125+ 0000 ~                                   ;     DSM > 255 (see BLOCK_WIDTH_FLAG)
 126+ 0000                  ENDS               ; = 32
 127+ 0000
 128+ 0000                  STRUCT FCB
 129+ 0000 ~            DIRECTORY_ENTRY  DIRECTORY_ENTRY  ; 0  the directory-entry image, byte for byte
 130+ 0000 ~            CR      BYTE           ; 32  current record within the extent (0..127)
 131+ 0000 ~            R0      BYTE           ; 33  random record number, low byte
 132+ 0000 ~            R1      BYTE           ; 34  random record number, middle byte
 133+ 0000 ~            R2      BYTE           ; 35  random record number, high byte (overflow)
 134+ 0000                  ENDS               ; = 36
 135+ 0000
 136+ 0000                  ASSERT DIRECTORY_ENTRY == 32                  ; a directory entry is 32 bytes
 137+ 0000                  ASSERT FCB.CR == DIRECTORY_ENTRY              ; CR begins where the entry ends
 138+ 0000                  ASSERT FCB == DIRECTORY_ENTRY + 4
 139+ 0000                  ASSERT FCB.DIRECTORY_ENTRY.EX == DIRECTORY_ENTRY.EX
 140+ 0000
 141+ 0000              ; Disk Parameter Block, the 15 bytes the BIOS hands the BDOS per drive.
 142+ 0000              ; NAMED *_LAYOUT because the OS sources already use DPB, DPH_TABLE, SPT, DSM and OFF as
 143+ 0000              ; INSTANCE labels for the real data block in CPM_BIOS.asm. This is the TYPE, not the instance.
 144+ 0000                  STRUCT DPB_LAYOUT
 145+ 0000 ~            SPT     WORD           ; 0   128-byte RECORDS per track, not 256-byte sectors
 146+ 0000 ~            BSH     BYTE           ; 2   block shift: log2(records per block)
 147+ 0000 ~            BLM     BYTE           ; 3   block mask: (records per block) - 1
 148+ 0000 ~            EXM     BYTE           ; 4   extent mask
 149+ 0000 ~            DSM     WORD           ; 5   highest allocation block number
 150+ 0000 ~            DRM     WORD           ; 7   highest directory entry number
 151+ 0000 ~            AL0     BYTE           ; 9   directory-reserved block bitmap, high byte
 152+ 0000 ~            AL1     BYTE           ; 10  ditto, low byte
 153+ 0000 ~            CKS     WORD           ; 11  directory checksum vector size
 154+ 0000 ~            OFF     WORD           ; 13  reserved tracks before the file area
 155+ 0000                  ENDS               ; = 15
 156+ 0000
 157+ 0000                  ASSERT DPB_LAYOUT.DSM == 5     ; SELDSK reaches the DSM byte with a bare +5
 158+ 0000                  ASSERT DPB_LAYOUT == 15
 159+ 0000
 160+ 0000              ; Disk Parameter Header, one per drive, 16 bytes.
 161+ 0000                  STRUCT DPH_LAYOUT
 162+ 0000 ~            XLT     WORD           ; 0   sector-translate table, or 0 for none
 163+ 0000 ~            SCRATCH BLOCK 6        ; 2   three scratch words the BDOS owns
 164+ 0000 ~            DIRBUF  WORD           ; 8   -> the 128-byte directory buffer (one per system)
 165+ 0000 ~            DPB     WORD           ; 10  -> this drive's DPB
 166+ 0000 ~            CSV     WORD           ; 12  -> directory checksum vector
 167+ 0000 ~            ALV     WORD           ; 14  -> allocation vector
 168+ 0000                  ENDS               ; = 16
 169+ 0000
 170+ 0000                  ASSERT DPH_LAYOUT.DPB == 10    ; SELDSK reaches the DPB pointer with a bare +10
 171+ 0000                  ASSERT DPH_LAYOUT == 16
 172+ 0000
 173+ 0000
 174+ 0000                  ENDIF
 175+ 0000
# file closed: cpm22.inc
  15  0000                  INCLUDE "cpm_system_220.inc"
# file opened: cpm_system_220.inc
   1+ 0000              ; ============================================================================
   2+ 0000              ; cpm_system_220.inc -- CP/M 2.20 (44K) cross-module system contract
   3+ 0000              ; ----------------------------------------------------------------------------
   4+ 0000              ; The de-skewed 2.20-44K system image is TWO independent compilations -- the CCP
   5+ 0000              ; ($9400-$9BFF) and the BDOS ($9C00-$A9FF) -- decoded at their true RUNTIME
   6+ 0000              ; addresses (see ../docs/CPM_Skew_Findings.md). On the correctly-addressed source
   7+ 0000              ; the two are almost decoupled: the CCP calls the BDOS only through the page-zero
   8+ 0000              ; $0005 ABI (cpm22.inc :: BDOS), and the ONLY direct cross-module symbols are the
   9+ 0000              ; two module bases below. They are defined ONCE here and INCLUDEd by both modules
  10+ 0000              ; (never duplicated -- feedback_no_duplicate_symbol_definitions). The earlier
  11+ 0000              ; "59 CCP->BDOS cross-refs" were sector-skew artifacts and do not exist on the
  12+ 0000              ; de-skewed source.
  13+ 0000              ; ============================================================================
  14+ 0000
  15+ 0000              ; Memory-config axis: the 56K (Language Card) system is the 44K image lifted +$3000
  16+ 0000              ; (CCP $9400->$C400, BDOS $9C00->$CC00, BIOS $AA00->$DA00 = Apple LC $D400/$DC00/$EA00).
  17+ 0000              ; Because every address below is derived from this single offset, defining CFG_56K
  18+ 0000              ; (the build's -D flag) re-homes the whole 2.20 OS by re-assembly alone -- no per-cell
  19+ 0000              ; edits. See ../docs/CPM_56K_60K_Fold_Plan.md.
  20+ 0000                  IFDEF CFG_56K
  21+ 0000 ~            OS_RELOC   EQU $3000      ; 56K: OS relocated into the Apple Language Card
  22+ 0000                  ELSE
  23+ 0000              OS_RELOC   EQU $0000      ; 44K: OS in main RAM (the base build)
  24+ 0000                  ENDIF
  25+ 0000
  26+ 0000              CCP_ENTRY  EQU $9400 + OS_RELOC  ; CBASE: CCP cold entry (JP cold-start); BDOS fn 0 / warm boot returns here
  27+ 0000              BDOS_FBASE EQU $9C00 + OS_RELOC  ; FBASE: BDOS image base (6-byte serial + JP +6 entry); top-of-TPA marker the CCP loads
  28+ 0000              BIOS_FBASE EQU $AA00 + OS_RELOC  ; WBOOT/BIOS base = the first byte PAST the BDOS image (CPM_BDOS asserts $ == this)
  29+ 0000
  30+ 0000              ; Region sizes are computed from the contiguous module boundaries above -- never a magic
  31+ 0000              ; number -- so they track the image layout (and the byte gate catches any overrun via the
  32+ 0000              ; CPM_BDOS end-of-image ASSERT). CCP -> BDOS -> BIOS are back-to-back.
  33+ 0000              CCP_SIZE   EQU BDOS_FBASE - CCP_ENTRY     ; $0800: CCP image size  = (first BDOS byte) - (first CCP byte)
  34+ 0000              BDOS_SIZE  EQU BIOS_FBASE - BDOS_FBASE    ; $0E00: BDOS image size = (byte after BDOS) - (first BDOS byte)
  35+ 0000
  36+ 0000              ; --- CCP cells referenced cross-module (single source of truth, by label arithmetic) ---
  37+ 0000              ; CCP_INLEN ($9407 = CCP_ENTRY+7): the CCP console-line returned-count byte (CCP_INBUF+1).
  38+ 0000              ; It doubles as the staged / auto-command flag -- nonzero on CCP entry means a command line
  39+ 0000              ; is already staged in CCP_CMDTEXT and is re-parsed instead of re-prompting (the SUBMIT/$SUB
  40+ 0000              ; chaining hook). The CCP warm-start clears it; the 2.20B BIOS warm-boot path ALSO clears it
  41+ 0000              ; (XOR A; LD (CCP_INLEN),A) so a BIOS-driven warm boot discards any stale staged command and
  42+ 0000              ; the CCP re-prompts cleanly. (The base 2.20 BIOS does not reference it; this is the lone
  43+ 0000              ; genuine BIOS->CCP cell, introduced by 2.20B.)
  44+ 0000              CCP_INLEN  EQU CCP_ENTRY + 7
  45+ 0000
# file closed: cpm_system_220.inc
  16  0000                  ORG BDOS_FBASE               ; $9C00 (44K) or $CC00 (CFG_56K)
  17  9C00                  ENDIF
  18  9C00              ; (BDOS_IMAGE_HEADER == module base; defined in cpm_system_220.inc)
  19  9C00              ; The 6-byte DRI/Microsoft serial number. It differs per released disk; the 2.20B-56K
  20  9C00              ; disk carries a different tail than the 1980 2.20-44K disk (V220B selects it). The CCP
  21  9C00              ; keeps a matching copy at CCP_SERIAL and self-checks it against this header.
  22  9C00                  IFDEF V220B
  23  9C00 ~                    DEFB    $BD,$16,$00,$00,$60,$D9   ; 2.20B serial
  24  9C00                  ELSE
  25  9C00 BD 16 00 00          DEFB    $BD,$16,$00,$00,$16,$DF   ; 2.20 serial
  25  9C04 16 DF
  26  9C06                  ENDIF
  27  9C06              ; ----------------------------------------------------------------------
  28  9C06              ; BDOS_ENTRY -- the BDOS=$0005-vector landing point (FBASE+6); jumps to the function dispatcher.
  29  9C06              ;   In: C = BDOS function number, DE = info address (or single-byte arg in E) -- the standard $0005
  30  9C06              ;       call ABI.
  31  9C06              ;   Out: jumps to BDOS_DISPATCH; never returns here (the handler RETs through the common BDOS exit).
  32  9C06              ;   Clobbers: none of its own (single JP).
  33  9C06              ;   Algorithm: OBSERVED -- one JP BDOS_DISPATCH. The page-zero $0005 jump-vector targets this
  34  9C06              ;              address ($9C06), so every BDOS call enters here. [RE]
  35  9C06              ; ----------------------------------------------------------------------
  36  9C06              BDOS_ENTRY:
  37  9C06                      ; enter the function dispatcher; reached from the page-zero BDOS=$0005 jump vector
  38  9C06 C3 11 9C             JP BDOS_DISPATCH
  39  9C09              ; ----------------------------------------------------------------------
  40  9C09              ; BDOS_ERR_VECTORS -- DATA: first entry of a 4-word table of BDOS disk-error reporter addresses.
  41  9C09              ;   In: a caller does LD HL,<one of these 4 word slots> then falls into the reporter helper at
  42  9C09              ;       $9F4A, which does LD E,(HL)/INC HL/LD D,(HL)/EX DE,HL/JP (HL) to enter the selected
  43  9C09              ;       reporter.
  44  9C09              ;   Out: this slot's word is the run address of the Bad-Sector (permanent disk) error reporter.
  45  9C09              ;   Clobbers: n/a (data).
  46  9C09              ;   Algorithm: OBSERVED -- two DATA bytes ($99 $9C) forming the address of the Bad-Sector reporter;
  47  9C09              ;              mis-decoded as SBC A,C / SBC A,H. This slot is loaded by the random-record path (the
  48  9C09              ;              caller at $9FBD: LD HL,BDOS_ERR_VECTORS). The four reporters print 'Bdos Err On d:'
  49  9C09              ;              then a '$'-terminated cause string ('Bad Sector' / 'Select' / 'R/O' / 'File R/O').
  50  9C09              ;              [RE]
  51  9C09              ; ----------------------------------------------------------------------
  52  9C09              BDOS_ERR_VECTORS:
  53  9C09                      ; DATA: low byte of the Bad-Sector (permanent disk-error) reporter address -- mis-decoded as
  54  9C09                      ;       SBC A,C
  55  9C09 99                   SBC A,C
  56  9C0A                      ; DATA: high byte ($9C) of the Bad-Sector reporter address
  57  9C0A 9C                   DEFB $9C+(OS_RELOC>>8)
  58  9C0B              ; ----------------------------------------------------------------------
  59  9C0B              ; BDOS_ERRVEC_SELECT -- DATA: word for the Select-error reporter in the BDOS error-vector table.
  60  9C0B              ;   In: n/a (data; this label's address is loaded into HL by the helper-front-end at $9F47 (LD
  61  9C0B              ;       HL,BDOS_ERRVEC_SELECT) before falling into the $9F4A reporter dispatch).
  62  9C0B              ;   Out: n/a (the word here is the run address of the 'Select' error reporter, which prints the
  63  9C0B              ;        message then warm-boots).
  64  9C0B              ;   Clobbers: n/a (data).
  65  9C0B              ;   Algorithm: OBSERVED -- two DATA bytes ($A5 $9C) forming the Select-error reporter address;
  66  9C0B              ;              mis-decoded as AND L / SBC A,H. [RE]
  67  9C0B              ; ----------------------------------------------------------------------
  68  9C0B              BDOS_ERRVEC_SELECT:
  69  9C0B                      ; DATA: low byte of the Select-error reporter address -- mis-decoded as AND L
  70  9C0B A5                   AND L
  71  9C0C                      ; DATA: high byte ($9C) of the Select-error reporter address
  72  9C0C 9C                   DEFB $9C+(OS_RELOC>>8)
  73  9C0D              ; ----------------------------------------------------------------------
  74  9C0D              ; BDOS_ERRVEC_RODISK -- DATA: word for the R/O-disk error reporter in the BDOS error-vector table.
  75  9C0D              ;   In: n/a (data; loaded into HL by the caller at $A158 (LD HL,BDOS_ERRVEC_RODISK), reached when a
  76  9C0D              ;       write is attempted to a read-only-flagged drive).
  77  9C0D              ;   Out: n/a (the word here is the run address of the reporter that prints 'R/O').
  78  9C0D              ;   Clobbers: n/a (data).
  79  9C0D              ;   Algorithm: OBSERVED -- two DATA bytes ($AB $9C) forming the R/O-disk reporter address;
  80  9C0D              ;              mis-decoded as XOR E / SBC A,H. The exact CP/M error sub-class ('R/O disk' vs 'disk
  81  9C0D              ;              changed to R/O') is UNKNOWN from these bytes; the reported cause string is 'R/O'.
  82  9C0D              ;              [RE]
  83  9C0D              ; ----------------------------------------------------------------------
  84  9C0D              BDOS_ERRVEC_RODISK:
  85  9C0D                      ; DATA: low byte of the R/O-disk reporter address -- mis-decoded as XOR E
  86  9C0D AB                   XOR E
  87  9C0E                      ; DATA: high byte ($9C) of the R/O-disk reporter address
  88  9C0E 9C                   DEFB $9C+(OS_RELOC>>8)
  89  9C0F              ; ----------------------------------------------------------------------
  90  9C0F              ; BDOS_ERRVEC_FILERO -- DATA: word for the File-R/O error reporter in the BDOS error-vector table.
  91  9C0F              ;   In: n/a (data; loaded into HL by the caller at $A14E (LD HL,BDOS_ERRVEC_FILERO), reached on a
  92  9C0F              ;       write to a read-only file).
  93  9C0F              ;   Out: n/a (the word here is the run address of the reporter that prints 'File R/O').
  94  9C0F              ;   Clobbers: n/a (data).
  95  9C0F              ;   Algorithm: OBSERVED -- two DATA bytes ($B1 $9C) forming the File-R/O reporter address;
  96  9C0F              ;              mis-decoded as OR C / SBC A,H. This is the last of the 4 error-vector words;
  97  9C0F              ;              BDOS_DISPATCH begins immediately after. [RE]
  98  9C0F              ; ----------------------------------------------------------------------
  99  9C0F              BDOS_ERRVEC_FILERO:
 100  9C0F                      ; DATA: low byte of the File-R/O reporter address -- mis-decoded as OR C
 101  9C0F B1                   OR C
 102  9C10                      ; DATA: high byte ($9C) of the File-R/O reporter address
 103  9C10 9C                   DEFB $9C+(OS_RELOC>>8)
 104  9C11              ; ----------------------------------------------------------------------
 105  9C11              ; BDOS_DISPATCH -- the CP/M 2.2 FDOS dispatcher: set up the BDOS frame and vector to the function
 106  9C11              ; handler.
 107  9C11              ;   In: C = BDOS function number (valid 0..40); DE = info address (single-byte arg also in E);
 108  9C11              ;       caller's SP live.
 109  9C11              ;   Out: control transfers (JP (HL)) to the selected handler with HL = the caller's info-address; on
 110  9C11              ;        out-of-range C (>= 41) it RETs straight to the just-pushed common exit, returning the
 111  9C11              ;        default 0 result.
 112  9C11              ;   Clobbers: A, BC, DE, HL, SP (switches to the private BDOS stack).
 113  9C11              ;   Algorithm: OBSERVED -- save caller DE (the info-address) into BDOS_PARAM_PTR; copy low byte E
 114  9C11              ;              into the requested-drive/byte-param cell DRV_SELECT_ARG; default the word result
 115  9C11              ;              (BDOS_RETVAL) to 0; capture caller SP into BDOS_SAVED_SP and switch SP to the private
 116  9C11              ;              BDOS stack top (BDOS_USER_NUM); clear two per-call state cells (DRV_SAVED_FCB_BYTE, DRV_RESTORE_FLAG) to
 117  9C11              ;              0; push the common BDOS exit (FCB_AUTO_DRIVE_RESTORE = $A974) so every handler RETs
 118  9C11              ;              through it; range-check the function number A (=C) against $29 (41) -- CP $29 / RET
 119  9C11              ;              NC returns to the exit when A >= 41. Then move byte-arg E into C for the handler, set
 120  9C11              ;              the index DE = function number (LD E,A / LD D,0), index BDOS_DISPATCH_TBL by 2*A (two
 121  9C11              ;              ADD HL,DE), fetch the handler word into DE, reload the saved info-address into HL, EX
 122  9C11              ;              DE,HL, and JP (HL). Dispatch is static-indexed: function N selects table entry N.
 123  9C11              ;              [RE]
 124  9C11              ; ----------------------------------------------------------------------
 125  9C11              BDOS_DISPATCH:
 126  9C11 EB                   EX DE,HL
 127  9C12                      ; save the caller's DE info-address (reloaded into HL just before JP (HL) to the handler)
 128  9C12 22 43 9F             LD (BDOS_PARAM_PTR),HL
 129  9C15 EB                   EX DE,HL
 130  9C16 7B                   LD A,E
 131  9C17                      ; stash the low arg byte E as the requested drive / byte parameter
 132  9C17 32 D6 A9             LD (DRV_SELECT_ARG),A
 133  9C1A                      ; default the BDOS word result to 0 before dispatch
 134  9C1A 21 00 00             LD HL,$0000
 135  9C1D                      ; clear the BDOS word-result cell (read back by the common exit)
 136  9C1D 22 45 9F             LD (BDOS_RETVAL),HL
 137  9C20                      ; HL was 0, so HL := caller's SP
 138  9C20 39                   ADD HL,SP
 139  9C21                      ; save the caller's stack pointer for the common exit to restore
 140  9C21 22 0F 9F             LD (BDOS_SAVED_SP),HL
 141  9C24                      ; switch to the private BDOS internal stack
 142  9C24 31 41 9F             LD SP,BDOS_USER_NUM
 143  9C27 AF                   XOR A
 144  9C28                      ; clear a per-call disk/reselect state cell (A=0 from XOR A)
 145  9C28 32 E0 A9             LD (DRV_SAVED_FCB_BYTE),A
 146  9C2B                      ; clear a second per-call state cell (A=0)
 147  9C2B 32 DE A9             LD (DRV_RESTORE_FLAG),A
 148  9C2E                      ; load the common BDOS exit/return-result address ($A974)
 149  9C2E 21 74 A9             LD HL,FCB_AUTO_DRIVE_RESTORE
 150  9C31                      ; push the common exit so every handler RETs back through it
 151  9C31 E5                   PUSH HL
 152  9C32                      ; A := function number for the range check and the table index
 153  9C32 79                   LD A,C
 154  9C33                      ; range-check: function number 41 ($29) or higher is out of range
 155  9C33 FE 29                CP $29
 156  9C35                      ; out-of-range -> return to the common exit with the default (0) result
 157  9C35 D0                   RET NC
 158  9C36                      ; move the byte argument (E) into C for the handler (C is now free since A holds the func
 159  9C36                      ; number)
 160  9C36 4B                   LD C,E
 161  9C37                      ; base of the 41-entry handler table
 162  9C37 21 47 9C             LD HL,BDOS_DISPATCH_TBL
 163  9C3A                      ; DE := function number (E=A, D=0) as the table index
 164  9C3A 5F                   LD E,A
 165  9C3B                      ; high byte of the index = 0
 166  9C3B 16 00                LD D,$00
 167  9C3D                      ; index by 2*A: two ADD HL,DE advance HL by 2*function-number
 168  9C3D 19                   ADD HL,DE
 169  9C3E 19                   ADD HL,DE
 170  9C3F                      ; fetch handler address low byte
 171  9C3F 5E                   LD E,(HL)
 172  9C40 23                   INC HL
 173  9C41                      ; fetch handler address high byte
 174  9C41 56                   LD D,(HL)
 175  9C42                      ; reload the caller's info-address into HL for the handler
 176  9C42 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
 177  9C45 EB                   EX DE,HL
 178  9C46                      ; enter the selected BDOS function handler
 179  9C46 E9                   JP (HL)
 180  9C47              ; ----------------------------------------------------------------------
 181  9C47              ; BDOS_DISPATCH_TBL -- 41-entry BDOS function dispatch table (one handler address per function
 182  9C47              ; 0..40).
 183  9C47              ;   In: indexed by 2*A (the function number) in BDOS_DISPATCH.
 184  9C47              ;   Out: the selected word is fetched and entered via JP (HL).
 185  9C47              ;   Clobbers: n/a (data).
 186  9C47              ;   Algorithm: OBSERVED -- a table of 16-bit handler run addresses. In-image handlers ($9Cxx-$A8xx)
 187  9C47              ;              render as labels; handlers above this staged image render as raw $hex; functions
 188  9C47              ;              4..11 sit in the DEFB run at $9C4F that the disassembler did not split into DEFW.
 189  9C47              ;              Functions 0-36 ($00-$24) are the standard CP/M 2.2 set; slots 37-40 ($25-$28) are
 190  9C47              ;              SoftCard/2.2 extensions (37 = drive-login mask, 38/39 = RET no-op stubs, 40 = Write
 191  9C47              ;              Random Zero Fill). [RE]
 192  9C47              ; ----------------------------------------------------------------------
 193  9C47              BDOS_DISPATCH_TBL:
 194  9C47                      ; fn 0 ($00) System Reset (warm boot)
 195  9C47 03 AA                DEFW    $AA03+OS_RELOC
 196  9C49                      ; fn 1 ($01) Console Input -> A
 197  9C49 C8 9E                DEFW    F_CONIN_H
 198  9C4B                      ; fn 2 ($02) Console Output (E=char)
 199  9C4B 90 9D                DEFW    F_CONOUT_H
 200  9C4D                      ; fn 3 ($03) Reader Input -> A
 201  9C4D CE 9E                DEFW    F_READERIN_H
 202  9C4F                      ; fns 4-11 as little-endian words: 4=$AA12 Punch Out, 5=$AA0F List Out, 6=$9ED4 Direct
 203  9C4F                      ; Console I/O, 7=$9EED Get IOBYTE, 8=$9EF3 Set IOBYTE, 9=$9EF8 Print String, 10=$9DE1 Read
 204  9C4F                      ; Console Buffer, 11=$9EFE Get Console Status
 205  9C4F 12 AA 0F AA          DEFW    $AA12+OS_RELOC,$AA0F+OS_RELOC,$9ED4+OS_RELOC,$9EED+OS_RELOC,$9EF3+OS_RELOC,$9EF8+OS_RELOC,$9DE1+OS_RELOC,$9EFE+OS_RELOC
 205  9C53 D4 9E ED 9E
 205  9C57 F3 9E F8 9E
 205  9C5B E1 9D FE 9E
 206  9C5F                      ; fn 12 ($0C) Return Version Number -> HL
 207  9C5F 7E A8                DEFW    S_BDOSVER_H
 208  9C61                      ; fn 13 ($0D) Reset Disk System
 209  9C61 83 A8                DEFW    DRV_ALLRESET_H
 210  9C63                      ; fn 14 ($0E) Select Disk
 211  9C63 45 A8                DEFW    DRV_SET_H
 212  9C65                      ; fn 15 ($0F) Open File
 213  9C65 9C A8                DEFW    F_OPEN_H
 214  9C67                      ; fn 16 ($10) Close File
 215  9C67 A5 A8                DEFW    F_CLOSE_H
 216  9C69                      ; fn 17 ($11) Search for First
 217  9C69 AB A8                DEFW    F_SFIRST_H
 218  9C6B                      ; fn 18 ($12) Search for Next
 219  9C6B C8 A8                DEFW    F_SNEXT_H
 220  9C6D                      ; fn 19 ($13) Delete File
 221  9C6D D7 A8                DEFW    F_DELETE_H
 222  9C6F                      ; fn 20 ($14) Read Sequential
 223  9C6F E0 A8                DEFW    F_READ_H
 224  9C71                      ; fn 21 ($15) Write Sequential
 225  9C71 E6 A8                DEFW    F_WRITE_H
 226  9C73                      ; fn 22 ($16) Make File
 227  9C73 EC A8                DEFW    F_MAKE_H
 228  9C75                      ; fn 23 ($17) Rename File
 229  9C75 F5 A8                DEFW    F_RENAME_H
 230  9C77                      ; fn 24 ($18) Return Login Vector -> HL
 231  9C77 FE A8                DEFW    DRV_LOGINVEC_H
 232  9C79                      ; fn 25 ($19) Return Current Disk -> A
 233  9C79 04 A9                DEFW    DRV_GET_H
 234  9C7B                      ; fn 26 ($1A) Set DMA Address (DE)
 235  9C7B 0A A9                DEFW    F_DMAOFF_H
 236  9C7D                      ; fn 27 ($1B) Get Allocation Vector -> HL
 237  9C7D 11 A9                DEFW    DRV_ALLOCVEC_H
 238  9C7F                      ; fn 28 ($1C) Write Protect Disk
 239  9C7F 2C A1                DEFW    DRV_SETRO_H
 240  9C81                      ; fn 29 ($1D) Get R/O Vector -> HL
 241  9C81 17 A9                DEFW    DRV_ROVEC_H
 242  9C83                      ; fn 30 ($1E) Set File Attributes
 243  9C83 1D A9                DEFW    F_ATTRIB_H
 244  9C85                      ; fn 31 ($1F) Get Disk Parameter Block addr -> HL
 245  9C85 26 A9                DEFW    DRV_DPB_H
 246  9C87                      ; fn 32 ($20) Get/Set User Number
 247  9C87 2D A9                DEFW    F_USERNUM_H
 248  9C89                      ; fn 33 ($21) Read Random
 249  9C89 41 A9                DEFW    F_READRAND_H
 250  9C8B                      ; fn 34 ($22) Write Random
 251  9C8B 47 A9                DEFW    F_WRITERAND_H
 252  9C8D                      ; fn 35 ($23) Compute File Size
 253  9C8D 4D A9                DEFW    F_SIZE_H
 254  9C8F                      ; fn 36 ($24) Set Random Record
 255  9C8F 0E A8                DEFW    F_RANDREC_H
 256  9C91                      ; fn 37 ($25) SoftCard extension: drive-login-vector mask (handler at $A953)
 257  9C91 53 A9                DEFW    DRV_RESET_H
 258  9C93                      ; fn 38 ($26) SoftCard extension: RET no-op stub
 259  9C93 04 9F                DEFW    BDOS_RET_NOP
 260  9C95                      ; fn 39 ($27) SoftCard extension: RET no-op stub (same handler)
 261  9C95 04 9F                DEFW    BDOS_RET_NOP
 262  9C97                      ; fn 40 ($28) Write Random with Zero Fill
 263  9C97 9B A9                DEFW    F_WRITEZF_H
 264  9C99                      ; --- the 4 disk-error reporter stubs (were misaligned DEFW; decoded as code so the
 265  9C99                      ;     in-image message/handler operands relocate). Each is the target of a BDOS_ERR_VECTORS
 266  9C99                      ;     word; each loads HL -> its '$'-terminated reason string then enters BDOS_ERR_TRAP. [RE]
 267  9C99              BDOS_ERRVEC_BADSEC_RPT:                  ; BDOS_ERR_VECTORS[0]
 268  9C99 21 CA 9C             LD HL,$9CCA+OS_RELOC             ; -> reason string
 269  9C9C CD E5 9C             CALL BDOS_ERR_PRINT
 270  9C9F FE 03                CP $03
 271  9CA1 CA 00 00             JP Z,$0000
 272  9CA4 C9                   RET
 273  9CA5              BDOS_ERRVEC_SELECT_RPT:                  ; BDOS_ERRVEC_SELECT
 274  9CA5 21 D5 9C             LD HL,$9CD5+OS_RELOC
 275  9CA8 C3 B4 9C             JP BDOS_ERR_TRAP
 276  9CAB              BDOS_ERRVEC_RODISK_RPT:                  ; BDOS_ERRVEC_RODISK
 277  9CAB 21 E1 9C             LD HL,$9CE1+OS_RELOC
 278  9CAE C3 B4 9C             JP BDOS_ERR_TRAP
 279  9CB1              BDOS_ERRVEC_FILERO_RPT:                  ; BDOS_ERRVEC_FILERO; falls into BDOS_ERR_TRAP
 280  9CB1 21 DC 9C             LD HL,$9CDC+OS_RELOC
 281  9CB4              ; ----------------------------------------------------------------------
 282  9CB4              ; BDOS_ERR_TRAP -- Print a BDOS disk error message and warm-boot.
 283  9CB4              ;   In: HL = pointer to the '$'-terminated reason string (set by the calling error
 284  9CB4              ;       stub, e.g. 'Bad Sector$'/'Select$'/'File R/O$'); BDOS_CUR_DRIVE = current drive index
 285  9CB4              ;       (0=A), used only to form the banner's drive letter.
 286  9CB4              ;   Out: does not return -- transfers to warm boot (JP 0).
 287  9CB4              ;   Clobbers: AF, BC, HL (irrelevant -- system restarts).
 288  9CB4              ;   Algorithm: call BDOS_ERR_PRINT to emit 'Bdos Err On d: <reason>', then JP 0000
 289  9CB4              ;              (CP/M warm-boot vector) to reload the CCP.
 290  9CB4              ;   [RE] Standard CP/M 2.2 BDOS fatal-disk-error trap. Reached via JP from the disk-error
 291  9CB4              ;        stubs just below the dispatch table, each of which loads HL with its reason string.
 292  9CB4              ; ----------------------------------------------------------------------
 293  9CB4              BDOS_ERR_TRAP:
 294  9CB4                      ; Emit 'Bdos Err On d: <reason>$' to the console
 295  9CB4 CD E5 9C             CALL BDOS_ERR_PRINT
 296  9CB7                      ; Warm boot (vector at 0000) -- reload CCP, never returns
 297  9CB7 C3 00 00             JP $0000
 298  9CBA              ; ----------------------------------------------------------------------
 299  9CBA              ; BDOS_ERR_MSG_HEAD -- '$'-terminated head of the BDOS error banner: 'Bdos Err On '.
 300  9CBA              ;   [RE] Printed by BDOS_ERR_PRINT; the drive letter is patched into the byte that follows.
 301  9CBA              ; ----------------------------------------------------------------------
 302  9CBA              BDOS_ERR_MSG_HEAD:
 303  9CBA 42 64 6F 73          DEFB    "Bdos Err On "           ; string
 303  9CBE 20 45 72 72
 303  9CC2 20 4F 6E 20
 304  9CC6              ; ----------------------------------------------------------------------
 305  9CC6              ; BDOS_ERR_MSG_DRIVE -- drive-letter slot plus the four '$'-delimited error reasons.
 306  9CC6              ;   Layout: 1 patched drive-letter byte, then ' : $', 'Bad Sector$', 'Select$', 'File R/O$'.
 307  9CC6              ;   [RE] BDOS_ERR_PRINT overwrites the first byte with 'A'+drive, then prints from here;
 308  9CC6              ;        the selected reason string ('Bad Sector$' at +4, 'Select$' at +15, 'File R/O$'
 309  9CC6              ;        at +22) is pointed to by HL on entry to the trap (moved into BC inside
 310  9CC6              ;        BDOS_ERR_PRINT via PUSH HL / POP BC).
 311  9CC6              ; ----------------------------------------------------------------------
 312  9CC6              BDOS_ERR_MSG_DRIVE:
 313  9CC6 20 3A 20 24          DEFB    " : $Bad Sector$Select$File R/O$" ; string
 313  9CCA 42 61 64 20
 313  9CCE 53 65 63 74
 313  9CD2 6F 72 24 53
 313  9CD6 65 6C 65 63
 313  9CDA 74 24 46 69
 313  9CDE 6C 65 20 52
 313  9CE2 2F 4F 24
 314  9CE5              ; ----------------------------------------------------------------------
 315  9CE5              ; BDOS_ERR_PRINT -- print the 'Bdos Err On d: <reason>' banner to the console.
 316  9CE5              ;   In: HL = pointer to the trailing reason string ('$'-terminated); BDOS_CUR_DRIVE = drive index.
 317  9CE5              ;   Out: banner echoed via the console-output path; the entry HL is consumed (PUSH/POP).
 318  9CE5              ;   Clobbers: AF, BC, HL.
 319  9CE5              ;   Algorithm: save the reason pointer (PUSH HL); print CR/LF (CON_CRLF); form drive
 320  9CE5              ;              letter 'A'+BDOS_CUR_DRIVE and patch it into BDOS_ERR_MSG_DRIVE; print the fixed head
 321  9CE5              ;              'Bdos Err On ' via BC; then POP the saved reason pointer into BC and print it,
 322  9CE5              ;              each through the '$'-terminated string printer (CON_PRINT_STR).
 323  9CE5              ;   [RE] Standard CP/M 2.2 BDOS error reporter.
 324  9CE5              ; ----------------------------------------------------------------------
 325  9CE5              BDOS_ERR_PRINT:
 326  9CE5 E5                   PUSH HL
 327  9CE6                      ; Emit CR/LF before the banner
 328  9CE6 CD C9 9D             CALL CON_CRLF
 329  9CE9                      ; Current drive index (0=A)
 330  9CE9 3A 42 9F             LD A,(BDOS_CUR_DRIVE)
 331  9CEC                      ; Convert to drive letter 'A'+n
 332  9CEC C6 41                ADD A,$41
 333  9CEE                      ; Patch the drive-letter slot in the message
 334  9CEE 32 C6 9C             LD (BDOS_ERR_MSG_DRIVE),A
 335  9CF1                      ; Point at the fixed head 'Bdos Err On '
 336  9CF1 01 BA 9C             LD BC,BDOS_ERR_MSG_HEAD
 337  9CF4                      ; Print head + ' d: ' up to the '$'
 338  9CF4 CD D3 9D             CALL CON_PRINT_STR
 339  9CF7                      ; Recover the reason-string pointer (PUSHed from HL on entry)
 340  9CF7 C1                   POP BC
 341  9CF8                      ; Print the selected reason string
 342  9CF8 CD D3 9D             CALL CON_PRINT_STR
 343  9CFB              ; ----------------------------------------------------------------------
 344  9CFB              ; CON_GETC_OR_RAW -- return the 1-char type-ahead if present, else read raw console input.
 345  9CFB              ;   In: CON_PENDING_CHAR = pending look-ahead char (0 if none).
 346  9CFB              ;   Out: A = next console character; CON_PENDING_CHAR cleared if it supplied the byte.
 347  9CFB              ;   Clobbers: AF, HL.
 348  9CFB              ;   Algorithm: if CON_PENDING_CHAR nonzero, consume and return it; otherwise call the BIOS
 349  9CFB              ;              console-input vector (BDOS variable-page entry $AA09) for a fresh key.
 350  9CFB              ;   [RE] Single-byte console un-get buffer used by the line editor and CONIN.
 351  9CFB              ; ----------------------------------------------------------------------
 352  9CFB              CON_GETC_OR_RAW:
 353  9CFB                      ; Point at the 1-char type-ahead buffer
 354  9CFB 21 0E 9F             LD HL,CON_PENDING_CHAR
 355  9CFE 7E                   LD A,(HL)
 356  9CFF                      ; Clear it -- the held char (if any) is consumed
 357  9CFF 36 00                LD (HL),$00
 358  9D01 B7                   OR A
 359  9D02                      ; A held char was present: return it
 360  9D02 C0                   RET NZ
 361  9D03                      ; Else fall through to the BIOS CONIN vector
 362  9D03 C3 09 AA             JP $AA09+OS_RELOC
 363  9D06              ; ----------------------------------------------------------------------
 364  9D06              ; F_CONIN_RAW -- read one console char, echoing it unless it is a control char.
 365  9D06              ;   In: none.
 366  9D06              ;   Out: A = character read (7-bit not masked here).
 367  9D06              ;   Clobbers: AF, BC, HL.
 368  9D06              ;   Algorithm: fetch a char (CON_GETC_OR_RAW); if it is a printable/handled control
 369  9D06              ;              (IS_CTRL_CHAR sets carry for the unechoed set) skip echo; otherwise echo
 370  9D06              ;              it via F_CONOUT_H, preserving the char across the call.
 371  9D06              ;   [RE] Backs BDOS function 1 (Console Input with echo).
 372  9D06              ; ----------------------------------------------------------------------
 373  9D06              F_CONIN_RAW:
 374  9D06                      ; Get next console char (type-ahead or raw)
 375  9D06 CD FB 9C             CALL CON_GETC_OR_RAW
 376  9D09                      ; Carry set => do not echo (control char)
 377  9D09 CD 14 9D             CALL IS_CTRL_CHAR
 378  9D0C                      ; Control char: return without echo
 379  9D0C D8                   RET C
 380  9D0D F5                   PUSH AF
 381  9D0E 4F                   LD C,A
 382  9D0F                      ; Echo the character
 383  9D0F CD 90 9D             CALL F_CONOUT_H
 384  9D12 F1                   POP AF
 385  9D13 C9                   RET
 386  9D14              ; ----------------------------------------------------------------------
 387  9D14              ; IS_CTRL_CHAR -- classify a char as a special/control code for echo suppression.
 388  9D14              ;   In: A = character.
 389  9D14              ;   Out: Z set if A is CR/LF/TAB/BS (those return early with Z); CARRY reflects A<' '
 390  9D14              ;        from the final CP $20 (carry set => below space, i.e. an unhandled control char).
 391  9D14              ;   Clobbers: AF.
 392  9D14              ;   Algorithm: compare A against CR(0D), LF(0A), TAB(09), BS(08) returning Z on a hit;
 393  9D14              ;              else fall through to CP ' ' so carry tells printable-vs-control.
 394  9D14              ;   [RE] Helper used by the console echo/expansion paths.
 395  9D14              ; ----------------------------------------------------------------------
 396  9D14              IS_CTRL_CHAR:
 397  9D14                      ; Carriage return?
 398  9D14 FE 0D                CP $0D
 399  9D16 C8                   RET Z
 400  9D17                      ; Line feed?
 401  9D17 FE 0A                CP $0A
 402  9D19 C8                   RET Z
 403  9D1A                      ; Tab?
 404  9D1A FE 09                CP $09
 405  9D1C C8                   RET Z
 406  9D1D                      ; Backspace?
 407  9D1D FE 08                CP $08
 408  9D1F C8                   RET Z
 409  9D20                      ; Set carry if below space (control char)
 410  9D20 FE 20                CP $20
 411  9D22 C9                   RET
 412  9D23              ; ----------------------------------------------------------------------
 413  9D23              ; CON_POLL_STATUS -- console-status poll that also traps Ctrl-S/Ctrl-C while idle.
 414  9D23              ;   In: CON_PENDING_CHAR = type-ahead char (nonzero => a key is already pending).
 415  9D23              ;   Out: A = 1 if a character is ready, 0 if not.
 416  9D23              ;   Clobbers: AF.
 417  9D23              ;   Algorithm: if a char is already buffered, report ready; else ask the BIOS console
 418  9D23              ;              status vector ($AA06). If a key is down, peek it ($AA09): Ctrl-S (13h)
 419  9D23              ;              stalls (then Ctrl-C warm-boots via JP 0); any other key is stashed in
 420  9D23              ;              CON_PENDING_CHAR as type-ahead and reported ready.
 421  9D23              ;   [RE] Backs the BDOS console-status / flow-control behaviour.
 422  9D23              ; ----------------------------------------------------------------------
 423  9D23              CON_POLL_STATUS:
 424  9D23                      ; Already have a buffered char?
 425  9D23 3A 0E 9F             LD A,(CON_PENDING_CHAR)
 426  9D26 B7                   OR A
 427  9D27                      ; Yes -> report 'ready' (A=1)
 428  9D27 C2 45 9D             JP NZ,CON_STATUS_READY
 429  9D2A                      ; BIOS console status vector
 430  9D2A CD 06 AA             CALL $AA06+OS_RELOC
 431  9D2D                      ; Bit0 = key available?
 432  9D2D E6 01                AND $01
 433  9D2F                      ; No key -> return A=0 (not ready)
 434  9D2F C8                   RET Z
 435  9D30                      ; Read the pending key
 436  9D30 CD 09 AA             CALL $AA09+OS_RELOC
 437  9D33                      ; Ctrl-S (stop/flow-control)?
 438  9D33 FE 13                CP $13
 439  9D35                      ; No -> buffer it as type-ahead
 440  9D35 C2 42 9D             JP NZ,CON_POLL_STASH
 441  9D38                      ; After Ctrl-S, wait for the resume/abort key
 442  9D38 CD 09 AA             CALL $AA09+OS_RELOC
 443  9D3B                      ; Ctrl-C while paused?
 444  9D3B FE 03                CP $03
 445  9D3D                      ; Ctrl-C -> warm boot
 446  9D3D CA 00 00             JP Z,$0000
 447  9D40                      ; Otherwise resume: report 'no key' (A=0)
 448  9D40 AF                   XOR A
 449  9D41 C9                   RET
 450  9D42              ; ----------------------------------------------------------------------
 451  9D42              ; CON_POLL_STASH -- stash the just-read key as type-ahead and report 'ready'.
 452  9D42              ;   In: A = key character to hold.
 453  9D42              ;   Out: A = 1 (ready).
 454  9D42              ;   Clobbers: none beyond A.
 455  9D42              ;   Algorithm: store A into the 1-char type-ahead cell, then fall into the A:=1 tail.
 456  9D42              ; ----------------------------------------------------------------------
 457  9D42              CON_POLL_STASH:
 458  9D42                      ; Hold the key in the type-ahead buffer
 459  9D42 32 0E 9F             LD (CON_PENDING_CHAR),A
 460  9D45              ; ----------------------------------------------------------------------
 461  9D45              ; CON_STATUS_READY -- return A=1, the 'character is ready' status result.
 462  9D45              ;   In: none. Out: A=1. Clobbers: A.
 463  9D45              ;   [RE] Shared tail of CON_POLL_STATUS.
 464  9D45              ; ----------------------------------------------------------------------
 465  9D45              CON_STATUS_READY:
 466  9D45                      ; Status = ready
 467  9D45 3E 01                LD A,$01
 468  9D47 C9                   RET
 469  9D48              ; ----------------------------------------------------------------------
 470  9D48              ; CON_PUT_COL -- output one char to the console, tracking column and honouring Ctrl-S.
 471  9D48              ;   In: C = character to print.
 472  9D48              ;   Out: char sent to console (and to the list device if echo flag set); column counter
 473  9D48              ;        CON_COL updated for printables; BS/LF adjust it.
 474  9D48              ;   Clobbers: AF, HL (BC preserved across the BIOS calls).
 475  9D48              ;   Algorithm: unless a redisplay-suppress flag (CON_SAVED_COL) is set, poll for Ctrl-S/Ctrl-C
 476  9D48              ;              then send C to the BIOS conout vector ($AA0C) and, if the printer-echo
 477  9D48              ;              flag CON_LIST_ECHO is set, to the list vector ($AA0F). Then update the column:
 478  9D48              ;              DEL(7F) leaves it; printable >=' ' increments; BS decrements; LF zeroes it.
 479  9D48              ;   [RE] Core character-output + column bookkeeping for the console writer.
 480  9D48              ; ----------------------------------------------------------------------
 481  9D48              CON_PUT_COL:
 482  9D48                      ; Redisplay-in-progress? skip status poll/echo if so
 483  9D48 3A 0A 9F             LD A,(CON_SAVED_COL)
 484  9D4B B7                   OR A
 485  9D4C                      ; Suppressed: go straight to column tracking
 486  9D4C C2 62 9D             JP NZ,CON_TRACK_COL
 487  9D4F C5                   PUSH BC
 488  9D50                      ; Poll for Ctrl-S/Ctrl-C before output
 489  9D50 CD 23 9D             CALL CON_POLL_STATUS
 490  9D53 C1                   POP BC
 491  9D54 C5                   PUSH BC
 492  9D55                      ; BIOS console-output vector
 493  9D55 CD 0C AA             CALL $AA0C+OS_RELOC
 494  9D58 C1                   POP BC
 495  9D59 C5                   PUSH BC
 496  9D5A                      ; Printer (list) echo enabled?
 497  9D5A 3A 0D 9F             LD A,(CON_LIST_ECHO)
 498  9D5D B7                   OR A
 499  9D5E                      ; Also send to the list device
 500  9D5E C4 0F AA             CALL NZ,$AA0F+OS_RELOC
 501  9D61 C1                   POP BC
 502  9D62              ; ----------------------------------------------------------------------
 503  9D62              ; CON_TRACK_COL -- update the output column counter for the char just sent.
 504  9D62              ;   In: C = the char emitted; CON_COL = current column.
 505  9D62              ;   Out: CON_COL adjusted (DEL no-op, printable +1, BS -1 if nonzero, LF -> 0).
 506  9D62              ;   Clobbers: AF, HL.
 507  9D62              ;   Algorithm: DEL(7F) -> return; >=' ' -> increment column; control chars -> if column
 508  9D62              ;              is already 0 return; BS(08) -> decrement; LF(0A) -> zero the column.
 509  9D62              ;   [RE] Column bookkeeping shared by CON_PUT_COL.
 510  9D62              ; ----------------------------------------------------------------------
 511  9D62              CON_TRACK_COL:
 512  9D62 79                   LD A,C
 513  9D63                      ; HL -> current output column
 514  9D63 21 0C 9F             LD HL,CON_COL
 515  9D66                      ; DELETE: no column change
 516  9D66 FE 7F                CP $7F
 517  9D68 C8                   RET Z
 518  9D69                      ; Tentatively advance the column
 519  9D69 34                   INC (HL)
 520  9D6A                      ; Printable (>= space)? keep the increment
 521  9D6A FE 20                CP $20
 522  9D6C D0                   RET NC
 523  9D6D                      ; Control char: undo the increment
 524  9D6D 35                   DEC (HL)
 525  9D6E 7E                   LD A,(HL)
 526  9D6F B7                   OR A
 527  9D70 C8                   RET Z
 528  9D71 79                   LD A,C
 529  9D72                      ; Backspace?
 530  9D72 FE 08                CP $08
 531  9D74 C2 79 9D             JP NZ,CON_TRACK_COL_LF
 532  9D77 35                   DEC (HL)
 533  9D78 C9                   RET
 534  9D79              ; ----------------------------------------------------------------------
 535  9D79              ; CON_TRACK_COL_LF -- handle the line-feed case of column tracking.
 536  9D79              ;   In: A = the control char; HL -> column cell.
 537  9D79              ;   Out: column zeroed if A was LF; unchanged otherwise.
 538  9D79              ;   Clobbers: AF.
 539  9D79              ;   [RE] LF tail of CON_TRACK_COL.
 540  9D79              ; ----------------------------------------------------------------------
 541  9D79              CON_TRACK_COL_LF:
 542  9D79                      ; Line feed?
 543  9D79 FE 0A                CP $0A
 544  9D7B C0                   RET NZ
 545  9D7C                      ; LF resets the column to 0
 546  9D7C 36 00                LD (HL),$00
 547  9D7E C9                   RET
 548  9D7F              ; ----------------------------------------------------------------------
 549  9D7F              ; CON_PUT_VISIBLE -- output a char, expanding non-tab control codes as '^X'.
 550  9D7F              ;   In: C = character.
 551  9D7F              ;   Out: char(s) sent via CON_PUT_COL; TAB handled by F_CONOUT_H expansion.
 552  9D7F              ;   Clobbers: AF.
 553  9D7F              ;   Algorithm: if the char is a handled control (IS_CTRL_CHAR, carry clear) print it
 554  9D7F              ;              normally through F_CONOUT_H; otherwise emit '^' then the char OR'd with
 555  9D7F              ;              40h (control-to-letter), so e.g. Ctrl-A shows as '^A'.
 556  9D7F              ;   [RE] Visible-control echo used by the line editor's buffer redisplay.
 557  9D7F              ; ----------------------------------------------------------------------
 558  9D7F              CON_PUT_VISIBLE:
 559  9D7F 79                   LD A,C
 560  9D80                      ; Classify; carry clear => print as-is
 561  9D80 CD 14 9D             CALL IS_CTRL_CHAR
 562  9D83                      ; Ordinary char/tab: normal output
 563  9D83 D2 90 9D             JP NC,F_CONOUT_H
 564  9D86 F5                   PUSH AF
 565  9D87                      ; '^' caret prefix for a control char
 566  9D87 0E 5E                LD C,$5E
 567  9D89                      ; Print the caret
 568  9D89 CD 48 9D             CALL CON_PUT_COL
 569  9D8C F1                   POP AF
 570  9D8D                      ; Map control code to its display letter
 571  9D8D F6 40                OR $40
 572  9D8F 4F                   LD C,A
 573  9D90              ; ----------------------------------------------------------------------
 574  9D90              ; F_CONOUT_H -- BDOS console-output handler (function 2) with tab expansion.
 575  9D90              ;   In: C = character to print.
 576  9D90              ;   Out: character emitted; TAB expands to spaces to the next 8-column stop.
 577  9D90              ;   Clobbers: AF.
 578  9D90              ;   Algorithm: if C != TAB(09) just print it via CON_PUT_COL; if TAB, emit spaces
 579  9D90              ;              through CON_PUT_COL until the column counter (CON_COL) is a multiple of 8.
 580  9D90              ;   [RE] BDOS function 2 (Console Output) backing routine.
 581  9D90              ; ----------------------------------------------------------------------
 582  9D90              F_CONOUT_H:
 583  9D90 79                   LD A,C
 584  9D91                      ; Tab character?
 585  9D91 FE 09                CP $09
 586  9D93                      ; Non-tab: print directly
 587  9D93 C2 48 9D             JP NZ,CON_PUT_COL
 588  9D96              ; ----------------------------------------------------------------------
 589  9D96              ; CONOUT_TAB_FILL -- emit spaces until the column reaches the next 8-stop (tab expand).
 590  9D96              ;   In: CON_COL = current column.
 591  9D96              ;   Out: spaces printed until (column & 7)==0.
 592  9D96              ;   Clobbers: AF, C.
 593  9D96              ;   Algorithm: output a space via CON_PUT_COL, re-read the column, loop while low 3 bits
 594  9D96              ;              are nonzero.
 595  9D96              ;   [RE] Tab-expansion loop of F_CONOUT_H.
 596  9D96              ; ----------------------------------------------------------------------
 597  9D96              CONOUT_TAB_FILL:
 598  9D96                      ; Space to fill the tab
 599  9D96 0E 20                LD C,$20
 600  9D98 CD 48 9D             CALL CON_PUT_COL
 601  9D9B 3A 0C 9F             LD A,(CON_COL)
 602  9D9E                      ; At an 8-column tab stop yet?
 603  9D9E E6 07                AND $07
 604  9DA0                      ; Not yet -> emit another space
 605  9DA0 C2 96 9D             JP NZ,CONOUT_TAB_FILL
 606  9DA3 C9                   RET
 607  9DA4              ; ----------------------------------------------------------------------
 608  9DA4              ; CON_BACKSPACE -- erase the last echoed character (BS, space, BS).
 609  9DA4              ;   In: none. Out: cursor moved left one cell, char blanked on screen.
 610  9DA4              ;   Clobbers: AF, C.
 611  9DA4              ;   Algorithm: emit BS (via CON_BS_OUT), then space, then BS again through the BIOS
 612  9DA4              ;              conout vector so the previous glyph is overwritten with a blank.
 613  9DA4              ;   [RE] Destructive backspace used by the line editor on rubout.
 614  9DA4              ; ----------------------------------------------------------------------
 615  9DA4              CON_BACKSPACE:
 616  9DA4                      ; Send a backspace
 617  9DA4 CD AC 9D             CALL CON_BS_OUT
 618  9DA7                      ; Overwrite the char with a space
 619  9DA7 0E 20                LD C,$20
 620  9DA9                      ; BIOS conout: print the blanking space
 621  9DA9 CD 0C AA             CALL $AA0C+OS_RELOC
 622  9DAC              ; ----------------------------------------------------------------------
 623  9DAC              ; CON_BS_OUT -- send a single backspace (08) to the console.
 624  9DAC              ;   In: none. Out: BS emitted via the BIOS conout vector.
 625  9DAC              ;   Clobbers: C.
 626  9DAC              ;   [RE] Tail-call helper; also used as the leading BS of CON_BACKSPACE.
 627  9DAC              ; ----------------------------------------------------------------------
 628  9DAC              CON_BS_OUT:
 629  9DAC                      ; Backspace character
 630  9DAC 0E 08                LD C,$08
 631  9DAE                      ; BIOS conout (tail call)
 632  9DAE C3 0C AA             JP $AA0C+OS_RELOC
 633  9DB1              ; ----------------------------------------------------------------------
 634  9DB1              ; CON_RETYPE_LINE -- echo '#' + CR/LF and reprint the current edit buffer (Ctrl-R).
 635  9DB1              ;   In: CON_COL = total chars in the line; the edit buffer follows BDOS_PARAM_PTR's pointer.
 636  9DB1              ;   Out: a fresh copy of the typed line shown on a new line.
 637  9DB1              ;   Clobbers: AF, C, HL.
 638  9DB1              ;   Algorithm: print '#', CR/LF (CON_CRLF), then loop re-emitting characters with
 639  9DB1              ;              CON_PUT_COL until the echoed count CON_LINE_START_COL reaches CON_COL.
 640  9DB1              ;   [RE] Implements the line editor's Ctrl-R (retype) function.
 641  9DB1              ; ----------------------------------------------------------------------
 642  9DB1              CON_RETYPE_LINE:
 643  9DB1                      ; '#' marker shown for a retype
 644  9DB1 0E 23                LD C,$23
 645  9DB3                      ; Print the '#'
 646  9DB3 CD 48 9D             CALL CON_PUT_COL
 647  9DB6                      ; CR/LF onto a fresh line
 648  9DB6 CD C9 9D             CALL CON_CRLF
 649  9DB9              ; ----------------------------------------------------------------------
 650  9DB9              ; CON_RETYPE_LOOP -- re-indent the cursor to the column the input line started at.
 651  9DB9              ;   In:  CON_LINE_START_COL = TARGET column; CON_COL = the live column tracker.
 652  9DB9              ;   Out: spaces emitted until CON_COL >= CON_LINE_START_COL.
 653  9DB9              ;   Clobbers: AF, C, HL.
 654  9DB9              ;   Algorithm: while CON_COL < CON_LINE_START_COL, emit a space via CON_PUT_COL (which
 655  9DB9              ;              advances CON_COL) and loop.
 656  9DB9              ;   [RE] Re-echo loop of CON_RETYPE_LINE. RESOLVED: the two cells were transposed here and
 657  9DB9              ;        the routine hedged as a result. F_READCONBUF_H seeds CON_LINE_START_COL from CON_COL
 658  9DB9              ;        at the start of the line edit, so it holds the column the line BEGAN at. After
 659  9DB9              ;        CON_RETYPE_LINE emits '#' and a CR/LF, this walks the cursor back out to that column
 660  9DB9              ;        so the redisplayed line lines up under the prompt. The 60K twin had it right.
 661  9DB9              ; ----------------------------------------------------------------------
 662  9DB9              CON_RETYPE_LOOP:
 663  9DB9                      ; Current column / line length
 664  9DB9 3A 0C 9F             LD A,(CON_COL)
 665  9DBC                      ; HL -> echoed-count cell
 666  9DBC 21 0B 9F             LD HL,CON_LINE_START_COL
 667  9DBF                      ; Reached the end of the buffer?
 668  9DBF BE                   CP (HL)
 669  9DC0                      ; Done re-echoing
 670  9DC0 D0                   RET NC
 671  9DC1                      ; Emit a space placeholder
 672  9DC1 0E 20                LD C,$20
 673  9DC3 CD 48 9D             CALL CON_PUT_COL
 674  9DC6 C3 B9 9D             JP CON_RETYPE_LOOP
 675  9DC9              ; ----------------------------------------------------------------------
 676  9DC9              ; CON_CRLF -- output a carriage-return / line-feed pair to the console.
 677  9DC9              ;   In: none. Out: CR then LF emitted; column reset by the LF.
 678  9DC9              ;   Clobbers: AF, C.
 679  9DC9              ;   Algorithm: CON_PUT_COL with CR(0D), then tail-call CON_PUT_COL with LF(0A).
 680  9DC9              ;   [RE] Newline helper used throughout the console/error paths.
 681  9DC9              ; ----------------------------------------------------------------------
 682  9DC9              CON_CRLF:
 683  9DC9                      ; Carriage return
 684  9DC9 0E 0D                LD C,$0D
 685  9DCB                      ; Emit CR
 686  9DCB CD 48 9D             CALL CON_PUT_COL
 687  9DCE                      ; Line feed
 688  9DCE 0E 0A                LD C,$0A
 689  9DD0                      ; Emit LF (tail call)
 690  9DD0 C3 48 9D             JP CON_PUT_COL
 691  9DD3              ; ----------------------------------------------------------------------
 692  9DD3              ; CON_PRINT_STR -- print a '$'-terminated string to the console.
 693  9DD3              ;   In: BC = pointer to the string; terminated by '$' (24h).
 694  9DD3              ;   Out: each char emitted via F_CONOUT_H until '$' is reached.
 695  9DD3              ;   Clobbers: AF, BC, C.
 696  9DD3              ;   Algorithm: load (BC); if '$' return; else advance BC, output the char through
 697  9DD3              ;              F_CONOUT_H (preserving BC), and loop.
 698  9DD3              ;   [RE] The '$'-terminated string writer; backs BDOS function 9 and the error printer.
 699  9DD3              ; ----------------------------------------------------------------------
 700  9DD3              CON_PRINT_STR:
 701  9DD3                      ; Fetch next string byte
 702  9DD3 0A                   LD A,(BC)
 703  9DD4                      ; '$' string terminator?
 704  9DD4 FE 24                CP $24
 705  9DD6                      ; End of string
 706  9DD6 C8                   RET Z
 707  9DD7 03                   INC BC
 708  9DD8 C5                   PUSH BC
 709  9DD9 4F                   LD C,A
 710  9DDA                      ; Print the character
 711  9DDA CD 90 9D             CALL F_CONOUT_H
 712  9DDD C1                   POP BC
 713  9DDE                      ; Next character
 714  9DDE C3 D3 9D             JP CON_PRINT_STR
 715  9DE1              ; ----------------------------------------------------------------------
 716  9DE1              ; F_READCONBUF_H -- BDOS buffered console line input (function 10) with editing.
 717  9DE1              ;   In: BDOS_PARAM_PTR -> the read buffer (byte0 = max length, byte1 = returned count, data...).
 718  9DE1              ;   Out: the buffer filled with the edited line; byte1 set to the char count.
 719  9DE1              ;   Clobbers: AF, BC, DE, HL.
 720  9DE1              ;   Algorithm: seed the echoed-count from the current column; read chars one at a time
 721  9DE1              ;              (CON_GETC_OR_RAW, masked to 7 bits) and dispatch the editing controls:
 722  9DE1              ;              CR/LF terminate; BS/DEL delete; Ctrl-E new line; Ctrl-P printer toggle;
 723  9DE1              ;              Ctrl-X erase line; Ctrl-U abandon (#); Ctrl-R retype; other chars are
 724  9DE1              ;              stored (full buffer rings). Terminates by writing the count and CR.
 725  9DE1              ;   [RE] Classic CP/M 2.2 line editor (Read Console Buffer).
 726  9DE1              ; ----------------------------------------------------------------------
 727  9DE1              F_READCONBUF_H:
 728  9DE1                      ; Start echoed-count at the current column
 729  9DE1 3A 0C 9F             LD A,(CON_COL)
 730  9DE4 32 0B 9F             LD (CON_LINE_START_COL),A
 731  9DE7                      ; HL -> caller's input buffer descriptor
 732  9DE7 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
 733  9DEA                      ; C = buffer maximum length
 734  9DEA 4E                   LD C,(HL)
 735  9DEB                      ; Skip to the data area (past max/count bytes)
 736  9DEB 23                   INC HL
 737  9DEC E5                   PUSH HL
 738  9DED                      ; B = current character count (starts 0)
 739  9DED 06 00                LD B,$00
 740  9DEF              ; ----------------------------------------------------------------------
 741  9DEF              ; READBUF_NEXT -- top of the line-editor read loop: save state and fetch a char.
 742  9DEF              ;   In: B = count so far, HL -> buffer position.
 743  9DEF              ;   Out: falls into READBUF_GETC with BC/HL preserved on the stack.
 744  9DEF              ;   Clobbers: stack.
 745  9DEF              ;   [RE] Per-keystroke loop head of F_READCONBUF_H.
 746  9DEF              ; ----------------------------------------------------------------------
 747  9DEF              READBUF_NEXT:
 748  9DEF C5                   PUSH BC
 749  9DF0 E5                   PUSH HL
 750  9DF1              ; ----------------------------------------------------------------------
 751  9DF1              ; READBUF_GETC -- read and classify the next edit character.
 752  9DF1              ;   In: stacked BC/HL = saved count and buffer pointer.
 753  9DF1              ;   Out: A = 7-bit char; control codes dispatched to the appropriate editor handler.
 754  9DF1              ;   Clobbers: AF, BC, HL.
 755  9DF1              ;   Algorithm: CON_GETC_OR_RAW, mask to 7 bits, restore BC/HL, then chain CP/JP tests:
 756  9DF1              ;              CR/LF -> finish; BS -> delete; the remaining tests fall through to the
 757  9DF1              ;              DEL / control-key handlers.
 758  9DF1              ;   [RE] Keystroke dispatcher inside F_READCONBUF_H.
 759  9DF1              ; ----------------------------------------------------------------------
 760  9DF1              READBUF_GETC:
 761  9DF1                      ; Read next raw/type-ahead char
 762  9DF1 CD FB 9C             CALL CON_GETC_OR_RAW
 763  9DF4                      ; Strip the high bit (7-bit ASCII)
 764  9DF4 E6 7F                AND $7F
 765  9DF6 E1                   POP HL
 766  9DF7 C1                   POP BC
 767  9DF8                      ; CR -> end of line
 768  9DF8 FE 0D                CP $0D
 769  9DFA CA C1 9E             JP Z,READBUF_DONE
 770  9DFD                      ; LF -> end of line
 771  9DFD FE 0A                CP $0A
 772  9DFF CA C1 9E             JP Z,READBUF_DONE
 773  9E02                      ; Backspace -> delete char
 774  9E02 FE 08                CP $08
 775  9E04 C2 16 9E             JP NZ,READBUF_DEL
 776  9E07 78                   LD A,B
 777  9E08 B7                   OR A
 778  9E09                      ; Buffer empty: nothing to delete, re-loop
 779  9E09 CA EF 9D             JP Z,READBUF_NEXT
 780  9E0C 05                   DEC B
 781  9E0D 3A 0C 9F             LD A,(CON_COL)
 782  9E10 32 0A 9F             LD (CON_SAVED_COL),A
 783  9E13 C3 70 9E             JP READBUF_REDISPLAY
 784  9E16              ; ----------------------------------------------------------------------
 785  9E16              ; READBUF_DEL -- handle DEL (7F) as a destructive rubout of the previous char.
 786  9E16              ;   In: A = char (7F), B = count, HL -> buffer position.
 787  9E16              ;   Out: if buffer nonempty, last char fetched for re-echo handling and pointer/count
 788  9E16              ;        backed up; empty buffer just re-loops.
 789  9E16              ;   Clobbers: AF, B, HL.
 790  9E16              ;   [RE] DELETE key path of the line editor.
 791  9E16              ; ----------------------------------------------------------------------
 792  9E16              READBUF_DEL:
 793  9E16                      ; DELETE key?
 794  9E16 FE 7F                CP $7F
 795  9E18                      ; No -> try the next control
 796  9E18 C2 26 9E             JP NZ,READBUF_CTRL_E
 797  9E1B 78                   LD A,B
 798  9E1C B7                   OR A
 799  9E1D                      ; Empty buffer: ignore, re-loop
 800  9E1D CA EF 9D             JP Z,READBUF_NEXT
 801  9E20 7E                   LD A,(HL)
 802  9E21 05                   DEC B
 803  9E22                      ; Back up the buffer pointer
 804  9E22 2B                   DEC HL
 805  9E23 C3 A9 9E             JP READBUF_STORE_ECHO
 806  9E26              ; ----------------------------------------------------------------------
 807  9E26              ; READBUF_CTRL_E -- handle Ctrl-E (05): physical CR/LF without ending the line.
 808  9E26              ;   In: A = char, BC/HL = editor state.
 809  9E26              ;   Out: cursor moved to a new line, echoed-count reset; editing continues.
 810  9E26              ;   Clobbers: AF.
 811  9E26              ;   Algorithm: on Ctrl-E print CR/LF (CON_CRLF), zero the echoed-count CON_LINE_START_COL, and
 812  9E26              ;              resume reading; otherwise fall through to the next control test.
 813  9E26              ; ----------------------------------------------------------------------
 814  9E26              READBUF_CTRL_E:
 815  9E26                      ; Ctrl-E -> physical new line
 816  9E26 FE 05                CP $05
 817  9E28                      ; No -> try Ctrl-P
 818  9E28 C2 37 9E             JP NZ,READBUF_CTRL_P
 819  9E2B C5                   PUSH BC
 820  9E2C E5                   PUSH HL
 821  9E2D                      ; Emit CR/LF
 822  9E2D CD C9 9D             CALL CON_CRLF
 823  9E30 AF                   XOR A
 824  9E31                      ; Reset the echoed-count to 0
 825  9E31 32 0B 9F             LD (CON_LINE_START_COL),A
 826  9E34 C3 F1 9D             JP READBUF_GETC
 827  9E37              ; ----------------------------------------------------------------------
 828  9E37              ; READBUF_CTRL_P -- handle Ctrl-P (10): toggle the printer (list-device) echo flag.
 829  9E37              ;   In: A = char.
 830  9E37              ;   Out: CON_LIST_ECHO flipped between 0 and 1; editing continues.
 831  9E37              ;   Clobbers: AF, HL.
 832  9E37              ;   Algorithm: on Ctrl-P compute 1 - CON_LIST_ECHO to toggle the printer-echo flag, then loop;
 833  9E37              ;              otherwise fall through to the Ctrl-X test.
 834  9E37              ; ----------------------------------------------------------------------
 835  9E37              READBUF_CTRL_P:
 836  9E37                      ; Ctrl-P -> toggle printer echo
 837  9E37 FE 10                CP $10
 838  9E39                      ; No -> try Ctrl-X
 839  9E39 C2 48 9E             JP NZ,READBUF_CTRL_X
 840  9E3C E5                   PUSH HL
 841  9E3D                      ; HL -> printer-echo flag
 842  9E3D 21 0D 9F             LD HL,CON_LIST_ECHO
 843  9E40 3E 01                LD A,$01
 844  9E42                      ; 1 - flag => toggle 0<->1
 845  9E42 96                   SUB (HL)
 846  9E43 77                   LD (HL),A
 847  9E44 E1                   POP HL
 848  9E45 C3 EF 9D             JP READBUF_NEXT
 849  9E48              ; ----------------------------------------------------------------------
 850  9E48              ; READBUF_CTRL_X -- handle Ctrl-X (18): erase the whole input line.
 851  9E48              ;   In: A = char; CON_COL = column; CON_LINE_START_COL = start column.
 852  9E48              ;   Out: all echoed chars backspaced away and the buffer emptied; editing restarts.
 853  9E48              ;   Clobbers: AF, HL.
 854  9E48              ;   Algorithm: on Ctrl-X loop CON_BACKSPACE while the column exceeds the line-start,
 855  9E48              ;              then restart the read with an empty buffer; else fall to the Ctrl-U test.
 856  9E48              ; ----------------------------------------------------------------------
 857  9E48              READBUF_CTRL_X:
 858  9E48                      ; Ctrl-X -> erase entire line
 859  9E48 FE 18                CP $18
 860  9E4A                      ; No -> try Ctrl-U
 861  9E4A C2 5F 9E             JP NZ,READBUF_CTRL_U
 862  9E4D E1                   POP HL
 863  9E4E              ; ----------------------------------------------------------------------
 864  9E4E              ; READBUF_ERASE_LOOP -- backspace-erase characters back to the line start.
 865  9E4E              ;   In: CON_LINE_START_COL = start column, CON_COL = current column.
 866  9E4E              ;   Out: console column reduced to the start; chars visually erased.
 867  9E4E              ;   Clobbers: AF, HL.
 868  9E4E              ;   Algorithm: while current column > start column, decrement it and CON_BACKSPACE.
 869  9E4E              ;   [RE] Erase loop shared by Ctrl-X.
 870  9E4E              ; ----------------------------------------------------------------------
 871  9E4E              READBUF_ERASE_LOOP:
 872  9E4E                      ; Line-start column
 873  9E4E 3A 0B 9F             LD A,(CON_LINE_START_COL)
 874  9E51 21 0C 9F             LD HL,CON_COL
 875  9E54                      ; Reached the start?
 876  9E54 BE                   CP (HL)
 877  9E55                      ; Yes -> restart with an empty buffer
 878  9E55 D2 E1 9D             JP NC,F_READCONBUF_H
 879  9E58 35                   DEC (HL)
 880  9E59                      ; Backspace-erase one cell
 881  9E59 CD A4 9D             CALL CON_BACKSPACE
 882  9E5C C3 4E 9E             JP READBUF_ERASE_LOOP
 883  9E5F              ; ----------------------------------------------------------------------
 884  9E5F              ; READBUF_CTRL_U -- handle Ctrl-U (15): abandon the line, show '#', restart.
 885  9E5F              ;   In: A = char.
 886  9E5F              ;   Out: '#' printed, fresh line started, buffer reset.
 887  9E5F              ;   Clobbers: AF, HL.
 888  9E5F              ;   Algorithm: on Ctrl-U mark the abandoned line (CON_RETYPE_LINE prints '#'+CRLF) and
 889  9E5F              ;              restart the read; otherwise fall to the Ctrl-R test.
 890  9E5F              ; ----------------------------------------------------------------------
 891  9E5F              READBUF_CTRL_U:
 892  9E5F                      ; Ctrl-U -> abandon line (#)
 893  9E5F FE 15                CP $15
 894  9E61                      ; No -> try Ctrl-R
 895  9E61 C2 6B 9E             JP NZ,READBUF_CTRL_R
 896  9E64                      ; Mark '#' and CR/LF
 897  9E64 CD B1 9D             CALL CON_RETYPE_LINE
 898  9E67 E1                   POP HL
 899  9E68                      ; Restart input with an empty buffer
 900  9E68 C3 E1 9D             JP F_READCONBUF_H
 901  9E6B              ; ----------------------------------------------------------------------
 902  9E6B              ; READBUF_CTRL_R -- handle Ctrl-R (12): retype the current line, else store the char.
 903  9E6B              ;   In: A = char, B = count, HL -> buffer.
 904  9E6B              ;   Out: Ctrl-R reprints the buffer; any other char falls into the store path.
 905  9E6B              ;   Clobbers: AF.
 906  9E6B              ;   Algorithm: if char != Ctrl-R, jump to the FCB/store path (the dispatcher's default);
 907  9E6B              ;              on Ctrl-R fall into the retype-and-redisplay sequence.
 908  9E6B              ; ----------------------------------------------------------------------
 909  9E6B              READBUF_CTRL_R:
 910  9E6B                      ; Ctrl-R -> retype line
 911  9E6B FE 12                CP $12
 912  9E6D                      ; Other char -> store it in the buffer
 913  9E6D C2 A6 9E             JP NZ,READBUF_STORE
 914  9E70              ; ----------------------------------------------------------------------
 915  9E70              ; READBUF_REDISPLAY -- reprint the buffered line after a retype/delete.
 916  9E70              ;   In: B = char count; buffer on stack (HL).
 917  9E70              ;   Out: '#'/CRLF emitted then each buffered char re-echoed via CON_PUT_VISIBLE.
 918  9E70              ;   Clobbers: AF, BC, HL.
 919  9E70              ;   Algorithm: CON_RETYPE_LINE for the marker, then walk the buffer re-echoing each
 920  9E70              ;              stored char with CON_PUT_VISIBLE (so controls show as '^X').
 921  9E70              ;   [RE] Buffer redisplay used by Ctrl-R and after a backspace.
 922  9E70              ; ----------------------------------------------------------------------
 923  9E70              READBUF_REDISPLAY:
 924  9E70 C5                   PUSH BC
 925  9E71                      ; Print '#' + CR/LF before redisplay
 926  9E71 CD B1 9D             CALL CON_RETYPE_LINE
 927  9E74 C1                   POP BC
 928  9E75 E1                   POP HL
 929  9E76 E5                   PUSH HL
 930  9E77 C5                   PUSH BC
 931  9E78              ; ----------------------------------------------------------------------
 932  9E78              ; READBUF_REDISPLAY_LOOP -- re-echo each buffered character.
 933  9E78              ;   In: B = remaining count, HL -> buffer position.
 934  9E78              ;   Out: every buffered char emitted via CON_PUT_VISIBLE.
 935  9E78              ;   Clobbers: AF, BC, C, HL.
 936  9E78              ;   Algorithm: while B != 0, advance HL, load the char, CON_PUT_VISIBLE it, decrement B;
 937  9E78              ;              on exhaustion fall into the post-redisplay column fixup (READBUF_REPOS).
 938  9E78              ;   [RE] Redisplay loop of READBUF_REDISPLAY.
 939  9E78              ; ----------------------------------------------------------------------
 940  9E78              READBUF_REDISPLAY_LOOP:
 941  9E78 78                   LD A,B
 942  9E79 B7                   OR A
 943  9E7A                      ; All re-echoed -> fix up column
 944  9E7A CA 8A 9E             JP Z,READBUF_REPOS
 945  9E7D 23                   INC HL
 946  9E7E 4E                   LD C,(HL)
 947  9E7F 05                   DEC B
 948  9E80 C5                   PUSH BC
 949  9E81 E5                   PUSH HL
 950  9E82                      ; Re-echo char (controls as ^X)
 951  9E82 CD 7F 9D             CALL CON_PUT_VISIBLE
 952  9E85 E1                   POP HL
 953  9E86 C1                   POP BC
 954  9E87 C3 78 9E             JP READBUF_REDISPLAY_LOOP
 955  9E8A              ; ----------------------------------------------------------------------
 956  9E8A              ; READBUF_REPOS -- after redisplay, backspace the cursor to the edit position.
 957  9E8A              ;   In: CON_SAVED_COL = saved column to restore to, CON_COL = current column.
 958  9E8A              ;   Out: cursor moved back so further typing continues at the right spot.
 959  9E8A              ;   Clobbers: AF, HL.
 960  9E8A              ;   Algorithm: if no saved position (CON_SAVED_COL==0) resume reading; else compute how far past
 961  9E8A              ;              the target the cursor is (CON_SAVED_COL := saved - column) and fall into the
 962  9E8A              ;              backspace loop READBUF_REPOS_LOOP.
 963  9E8A              ;   [RE] Cursor-reposition step after a Ctrl-R / delete redisplay.
 964  9E8A              ;   [RE] KNOWN de-skew artifact, not an open question: the auto-name 'READBUF_REPOS' was a stale/mislabel from the skewed source -- this is
 965  9E8A              ;       console line-editor code, NOT directory traversal.
 966  9E8A              ; ----------------------------------------------------------------------
 967  9E8A              READBUF_REPOS:
 968  9E8A E5                   PUSH HL
 969  9E8B                      ; Saved cursor column (0 = none)
 970  9E8B 3A 0A 9F             LD A,(CON_SAVED_COL)
 971  9E8E B7                   OR A
 972  9E8F                      ; Nothing to restore -> read next char
 973  9E8F CA F1 9D             JP Z,READBUF_GETC
 974  9E92 21 0C 9F             LD HL,CON_COL
 975  9E95                      ; saved - current column = cells to back up
 976  9E95 96                   SUB (HL)
 977  9E96 32 0A 9F             LD (CON_SAVED_COL),A
 978  9E99              ; ----------------------------------------------------------------------
 979  9E99              ; READBUF_REPOS_LOOP -- backspace the cursor by the computed cell count.
 980  9E99              ;   In: CON_SAVED_COL = number of cells to back up.
 981  9E99              ;   Out: cursor repositioned; loop ends and the editor reads the next char.
 982  9E99              ;   Clobbers: AF, HL.
 983  9E99              ;   Algorithm: CON_BACKSPACE, decrement CON_SAVED_COL, repeat until zero, then resume input.
 984  9E99              ;   [RE] Reposition loop of READBUF_REPOS.
 985  9E99              ; ----------------------------------------------------------------------
 986  9E99              READBUF_REPOS_LOOP:
 987  9E99                      ; Backspace one cell
 988  9E99 CD A4 9D             CALL CON_BACKSPACE
 989  9E9C 21 0A 9F             LD HL,CON_SAVED_COL
 990  9E9F 35                   DEC (HL)
 991  9EA0                      ; More cells to back up
 992  9EA0 C2 99 9E             JP NZ,READBUF_REPOS_LOOP
 993  9EA3                      ; Done -> read next char
 994  9EA3 C3 F1 9D             JP READBUF_GETC
 995  9EA6              ; ----------------------------------------------------------------------
 996  9EA6              ; READBUF_STORE -- store an ordinary character into the input buffer.
 997  9EA6              ;   In: A = char to store, B = count, HL -> next buffer slot.
 998  9EA6              ;   Out: char written, count incremented; falls into the echo/limit check.
 999  9EA6              ;   Clobbers: AF, B, HL.
1000  9EA6              ;   Algorithm: write the char at ++HL, bump B, then fall into READBUF_STORE_ECHO which
1001  9EA6              ;              echoes it and checks the buffer-full limit.
1002  9EA6              ;   [RE] KNOWN de-skew artifact, not an open question: the auto-name 'READBUF_STORE' is a stale skew mislabel -- this is the line
1003  9EA6              ;       editor's character-store path, NOT an FCB/directory compare.
1004  9EA6              ; ----------------------------------------------------------------------
1005  9EA6              READBUF_STORE:
1006  9EA6 23                   INC HL
1007  9EA7                      ; Store the typed char in the buffer
1008  9EA7 77                   LD (HL),A
1009  9EA8                      ; Bump the character count
1010  9EA8 04                   INC B
1011  9EA9              ; ----------------------------------------------------------------------
1012  9EA9              ; READBUF_STORE_ECHO -- echo the stored char and enforce the buffer length limit.
1013  9EA9              ;   In: A = char, B = count, C = buffer max length.
1014  9EA9              ;   Out: char echoed; if count reached the max (or hit a hard limit) the line is
1015  9EA9              ;        terminated, otherwise reading continues.
1016  9EA9              ;   Clobbers: AF, BC, HL.
1017  9EA9              ;   Algorithm: echo via CON_PUT_VISIBLE; reload the buffer max; if the max byte is 1
1018  9EA9              ;              (degenerate) terminate immediately; if count == max terminate, else loop.
1019  9EA9              ;   [RE] Store-and-limit tail of the line editor.
1020  9EA9              ;   [?] The CP $03 then CP $01 sequence tests the buffer-descriptor max byte; exact
1021  9EA9              ;       degenerate-case semantics beyond 'terminate when full' are UNKNOWN.
1022  9EA9              ; ----------------------------------------------------------------------
1023  9EA9              READBUF_STORE_ECHO:
1024  9EA9 C5                   PUSH BC
1025  9EAA E5                   PUSH HL
1026  9EAB 4F                   LD C,A
1027  9EAC                      ; Echo the just-stored char
1028  9EAC CD 7F 9D             CALL CON_PUT_VISIBLE
1029  9EAF E1                   POP HL
1030  9EB0 C1                   POP BC
1031  9EB1 7E                   LD A,(HL)
1032  9EB2                      ; Inspect the buffer-max byte
1033  9EB2 FE 03                CP $03
1034  9EB4 78                   LD A,B
1035  9EB5 C2 BD 9E             JP NZ,READBUF_LIMIT
1036  9EB8                      ; Degenerate max of 1 -> terminate
1037  9EB8 FE 01                CP $01
1038  9EBA                      ; Terminate (warm-boot guard path)
1039  9EBA CA 00 00             JP Z,$0000
1040  9EBD              ; ----------------------------------------------------------------------
1041  9EBD              ; READBUF_LIMIT -- compare the count to the buffer max and continue or finish.
1042  9EBD              ;   In: A = count (B), C = buffer maximum length.
1043  9EBD              ;   Out: if count < max keep reading, else fall into the line-terminate path.
1044  9EBD              ;   Clobbers: AF.
1045  9EBD              ;   Algorithm: CP C; if count < max (carry) loop back to READBUF_NEXT, else finish.
1046  9EBD              ;   [RE] Buffer-full check of the line editor.
1047  9EBD              ; ----------------------------------------------------------------------
1048  9EBD              READBUF_LIMIT:
1049  9EBD                      ; count vs buffer max
1050  9EBD B9                   CP C
1051  9EBE                      ; Room left -> read another char
1052  9EBE DA EF 9D             JP C,READBUF_NEXT
1053  9EC1              ; ----------------------------------------------------------------------
1054  9EC1              ; READBUF_DONE -- finish the input line: store the count and emit a CR.
1055  9EC1              ;   In: stacked HL -> buffer count byte; B = final character count.
1056  9EC1              ;   Out: count written into the buffer; CR echoed; returns to the BDOS caller.
1057  9EC1              ;   Clobbers: AF, C, HL.
1058  9EC1              ;   Algorithm: pop the buffer pointer, store B as the returned char count, then output
1059  9EC1              ;              CR via CON_PUT_COL (tail call) to close the input line.
1060  9EC1              ;   [RE] Line-editor termination, reached on CR/LF/buffer-full.
1061  9EC1              ; ----------------------------------------------------------------------
1062  9EC1              READBUF_DONE:
1063  9EC1 E1                   POP HL
1064  9EC2                      ; Write the final character count into the buffer
1065  9EC2 70                   LD (HL),B
1066  9EC3                      ; Carriage return to close the line
1067  9EC3 0E 0D                LD C,$0D
1068  9EC5                      ; Emit CR and return to caller
1069  9EC5 C3 48 9D             JP CON_PUT_COL
1070  9EC8              ; ----------------------------------------------------------------------
1071  9EC8              ; F_CONIN_H -- BDOS function 1 handler: console input with echo, returned in A.
1072  9EC8              ;   In: none.
1073  9EC8              ;   Out: BDOS result (BDOS_RETVAL) = char read.
1074  9EC8              ;   Clobbers: AF, BC, HL.
1075  9EC8              ;   Algorithm: read+echo via F_CONIN_RAW, then store the char as the BDOS return value.
1076  9EC8              ;   [RE] Dispatch-table entry for function 1.
1077  9EC8              ; ----------------------------------------------------------------------
1078  9EC8              F_CONIN_H:
1079  9EC8                      ; Read one char (with echo)
1080  9EC8 CD 06 9D             CALL F_CONIN_RAW
1081  9ECB                      ; Store as the BDOS return value
1082  9ECB C3 01 9F             JP BDOS_RET_RESULT
1083  9ECE              ; ----------------------------------------------------------------------
1084  9ECE              ; F_READERIN_H -- BDOS function 3 handler: read from the reader (AUX/RDR) device.
1085  9ECE              ;   In: none.
1086  9ECE              ;   Out: BDOS result (BDOS_RETVAL) = byte from the BIOS reader vector.
1087  9ECE              ;   Clobbers: AF.
1088  9ECE              ;   Algorithm: call the BIOS reader-input vector ($AA15), store the byte as the result.
1089  9ECE              ;   [RE] Dispatch entry for function 3 (Reader Input).
1090  9ECE              ; ----------------------------------------------------------------------
1091  9ECE              F_READERIN_H:
1092  9ECE                      ; BIOS reader-input vector
1093  9ECE CD 15 AA             CALL $AA15+OS_RELOC
1094  9ED1                      ; Store as the BDOS return value
1095  9ED1 C3 01 9F             JP BDOS_RET_RESULT
1096  9ED4              ; ----------------------------------------------------------------------
1097  9ED4              ; F_DIRECTIO_H -- BDOS function 6 handler: direct console I/O.
1098  9ED4              ;   In: C = subfunction (FF = input/status, FE = status only, else = output char).
1099  9ED4              ;   Out: input/status results returned via BDOS_RET_RESULT; output sent to console.
1100  9ED4              ;   Clobbers: AF.
1101  9ED4              ;   Algorithm: C==FF -> direct input branch; C==FE -> raw BIOS console-status ($AA06);
1102  9ED4              ;              otherwise treat C as a character and send it to the BIOS conout ($AA0C),
1103  9ED4              ;              bypassing the editor and flow control.
1104  9ED4              ;   [RE] Dispatch entry for function 6 (Direct Console I/O).
1105  9ED4              ; ----------------------------------------------------------------------
1106  9ED4              F_DIRECTIO_H:
1107  9ED4 79                   LD A,C
1108  9ED5                      ; C==FE? (status-only subfunction)
1109  9ED5                      ; C==FF? (test for direct-input subfunction)
1110  9ED5 3C                   INC A
1111  9ED6                      ; FF -> direct console input
1112  9ED6 CA E0 9E             JP Z,DIRECTIO_INPUT
1113  9ED9 3C                   INC A
1114  9EDA                      ; FE -> raw BIOS console status
1115  9EDA CA 06 AA             JP Z,$AA06+OS_RELOC
1116  9EDD                      ; Else output C directly via BIOS conout
1117  9EDD C3 0C AA             JP $AA0C+OS_RELOC
1118  9EE0              ; ----------------------------------------------------------------------
1119  9EE0              ; DIRECTIO_INPUT -- direct console input subfunction of function 6.
1120  9EE0              ;   In: none.
1121  9EE0              ;   Out: BDOS result = char if one is ready, else 0; no echo, no flow control.
1122  9EE0              ;   Clobbers: AF.
1123  9EE0              ;   Algorithm: poll raw BIOS console status ($AA06); if no key, return 0 (A=0 result);
1124  9EE0              ;              if a key is ready, read it raw ($AA09) and store as the result.
1125  9EE0              ;   [RE] KNOWN de-skew artifact, not an open question: the auto-name carries a stale 'READBUF_STORE' skew prefix -- this is direct
1126  9EE0              ;       console input, NOT an FCB/directory routine.
1127  9EE0              ; ----------------------------------------------------------------------
1128  9EE0              DIRECTIO_INPUT:
1129  9EE0                      ; Raw BIOS console status
1130  9EE0 CD 06 AA             CALL $AA06+OS_RELOC
1131  9EE3 B7                   OR A
1132  9EE4                      ; No key -> return 0 result
1133  9EE4 CA 91 A9             JP Z,BDOS_RETURN_RESULT
1134  9EE7                      ; Read the key raw (no echo)
1135  9EE7 CD 09 AA             CALL $AA09+OS_RELOC
1136  9EEA                      ; Store as the BDOS return value
1137  9EEA C3 01 9F             JP BDOS_RET_RESULT
1138  9EED              ; ----------------------------------------------------------------------
1139  9EED              ; F_GETIOB_H -- BDOS function 7 handler: get the I/O byte (IOBYTE).
1140  9EED              ;   In: none.
1141  9EED              ;   Out: BDOS result = the IOBYTE at fixed address 0003.
1142  9EED              ;   Clobbers: AF.
1143  9EED              ;   Algorithm: load (0003) and return it as the result.
1144  9EED              ;   [RE] Dispatch entry for function 7 (Get IOBYTE).
1145  9EED              ; ----------------------------------------------------------------------
1146  9EED              F_GETIOB_H:
1147  9EED                      ; IOBYTE lives at page-zero 0003
1148  9EED 3A 03 00             LD A,($0003)
1149  9EF0                      ; Return it as the BDOS result
1150  9EF0 C3 01 9F             JP BDOS_RET_RESULT
1151  9EF3              ; ----------------------------------------------------------------------
1152  9EF3              ; F_SETIOB_H -- BDOS function 8 handler: set the I/O byte (IOBYTE).
1153  9EF3              ;   In: C = new IOBYTE value.
1154  9EF3              ;   Out: (0003) = C.
1155  9EF3              ;   Clobbers: HL.
1156  9EF3              ;   Algorithm: store C into the fixed IOBYTE cell at 0003 and return.
1157  9EF3              ;   [RE] Dispatch entry for function 8 (Set IOBYTE).
1158  9EF3              ; ----------------------------------------------------------------------
1159  9EF3              F_SETIOB_H:
1160  9EF3                      ; Page-zero IOBYTE address
1161  9EF3 21 03 00             LD HL,$0003
1162  9EF6                      ; Write the new IOBYTE
1163  9EF6 71                   LD (HL),C
1164  9EF7 C9                   RET
1165  9EF8              ; ----------------------------------------------------------------------
1166  9EF8              ; F_PRINTSTR_H -- BDOS function 9 handler: print a '$'-terminated string.
1167  9EF8              ;   In: DE = pointer to the string.
1168  9EF8              ;   Out: string echoed to the console up to the '$'.
1169  9EF8              ;   Clobbers: AF, BC.
1170  9EF8              ;   Algorithm: move DE into BC and tail-call CON_PRINT_STR.
1171  9EF8              ;   [RE] Dispatch entry for function 9 (Print String).
1172  9EF8              ; ----------------------------------------------------------------------
1173  9EF8              F_PRINTSTR_H:
1174  9EF8 EB                   EX DE,HL
1175  9EF9                      ; BC := string pointer (from DE via EX)
1176  9EF9 4D                   LD C,L
1177  9EFA 44                   LD B,H
1178  9EFB                      ; Print '$'-terminated string
1179  9EFB C3 D3 9D             JP CON_PRINT_STR
1180  9EFE              ; ----------------------------------------------------------------------
1181  9EFE              ; F_CONSTAT_H -- BDOS function 11 handler: get console status.
1182  9EFE              ;   In: none.
1183  9EFE              ;   Out: BDOS result = 1 if a console char is ready, else 0.
1184  9EFE              ;   Clobbers: AF.
1185  9EFE              ;   Algorithm: CON_POLL_STATUS to test readiness (handling Ctrl-S/Ctrl-C), then fall
1186  9EFE              ;              into BDOS_RET_RESULT to store the 0/1 status.
1187  9EFE              ;   [RE] Dispatch entry for function 11 (Get Console Status).
1188  9EFE              ; ----------------------------------------------------------------------
1189  9EFE              F_CONSTAT_H:
1190  9EFE                      ; Poll console readiness (0/1)
1191  9EFE CD 23 9D             CALL CON_POLL_STATUS
1192  9F01              ; ----------------------------------------------------------------------
1193  9F01              ; BDOS_RET_RESULT -- store A as the BDOS function return value and return.
1194  9F01              ;   In: A = result byte.
1195  9F01              ;   Out: BDOS_RETVAL (BDOS return cell) = A.
1196  9F01              ;   Clobbers: none beyond the result cell.
1197  9F01              ;   Algorithm: write A to the return-value cell; common tail of many handlers.
1198  9F01              ;   [RE] The BDOS result sink read back by BDOS_DISPATCH on exit.
1199  9F01              ; ----------------------------------------------------------------------
1200  9F01              BDOS_RET_RESULT:
1201  9F01                      ; Save A as the BDOS return value
1202  9F01 32 45 9F             LD (BDOS_RETVAL),A
1203  9F04              ; ----------------------------------------------------------------------
1204  9F04              ; BDOS_RET_NOP -- bare RET; the no-op result tail shared by status handlers.
1205  9F04              ;   In: none. Out: none. Clobbers: none.
1206  9F04              ;   [RE] Fall-through return after BDOS_RET_RESULT; also a dispatch-table target for
1207  9F04              ;        functions that simply return.
1208  9F04              ; ----------------------------------------------------------------------
1209  9F04              BDOS_RET_NOP:
1210  9F04 C9                   RET
1211  9F05              ; ----------------------------------------------------------------------
1212  9F05              ; BDOS_RET_ONE -- set the BDOS return value to 1 and exit.
1213  9F05              ;   In: none.
1214  9F05              ;   Out: BDOS result (BDOS_RETVAL) = 1.
1215  9F05              ;   Clobbers: AF.
1216  9F05              ;   Algorithm: load A=1 and join BDOS_RET_RESULT.
1217  9F05              ;   [RE] Used by handlers that report a fixed 'true'/error-code-1 result.
1218  9F05              ; ----------------------------------------------------------------------
1219  9F05              BDOS_RET_ONE:
1220  9F05                      ; Result code 1
1221  9F05 3E 01                LD A,$01
1222  9F07                      ; Store and return
1223  9F07 C3 01 9F             JP BDOS_RET_RESULT
1224  9F0A              ; ----------------------------------------------------------------------
1225  9F0A              ; CON_SAVED_COL -- saved cursor column for line-editor redisplay/reposition.
1226  9F0A              ;   Also doubles as a 'suppress status-poll/echo' flag inside CON_PUT_COL.
1227  9F0A              ;   [RE] BDOS console state byte; zero when not repositioning.
1228  9F0A              ; ----------------------------------------------------------------------
1229  9F0A              CON_SAVED_COL:
1230  9F0A 00                   DEFB    "\0"
1231  9F0B              ; ----------------------------------------------------------------------
1232  9F0B              ; CON_LINE_START_COL -- column at the start of the current input line (echoed-count base).
1233  9F0B              ;   [RE] Used by the line editor to know how far back Ctrl-X / DEL may erase.
1234  9F0B              ; ----------------------------------------------------------------------
1235  9F0B              CON_LINE_START_COL:
1236  9F0B 00                   DEFB    "\0"
1237  9F0C              ; ----------------------------------------------------------------------
1238  9F0C              ; CON_COL -- current console output column counter.
1239  9F0C              ;   [RE] Incremented per printable char, reset by LF; drives tab expansion and editing.
1240  9F0C              ; ----------------------------------------------------------------------
1241  9F0C              CON_COL:
1242  9F0C 00                   DEFB    "\0"
1243  9F0D              ; ----------------------------------------------------------------------
1244  9F0D              ; CON_LIST_ECHO -- printer (list device) echo flag; nonzero => mirror console output.
1245  9F0D              ;   [RE] Toggled by the line editor's Ctrl-P.
1246  9F0D              ; ----------------------------------------------------------------------
1247  9F0D              CON_LIST_ECHO:
1248  9F0D 00                   DEFB    "\0"
1249  9F0E              ; ----------------------------------------------------------------------
1250  9F0E              ; CON_PENDING_CHAR -- 1-byte console type-ahead / un-get buffer (0 = empty).
1251  9F0E              ;   [RE] Filled by CON_POLL_STATUS, consumed by CON_GETC_OR_RAW.
1252  9F0E              ; ----------------------------------------------------------------------
1253  9F0E              CON_PENDING_CHAR:
1254  9F0E 00                   DEFB    "\0"
1255  9F0F              ; ----------------------------------------------------------------------
1256  9F0F              ; BDOS_SAVED_SP -- caller's stack pointer saved on BDOS entry (51-byte cell + slack).
1257  9F0F              ;   [RE] BDOS_DISPATCH saves SP here and switches to the BDOS-local stack; restored on
1258  9F0F              ;        exit. The trailing DEFS reserves the BDOS local stack space below BDOS_USER_NUM.
1259  9F0F              ; ----------------------------------------------------------------------
1260  9F0F              BDOS_SAVED_SP:
1261  9F0F 00 00 00...          DEFS    50, $00                  ; fill
1262  9F41              ; ----------------------------------------------------------------------
1263  9F41              ; BDOS_USER_NUM -- the CURRENT USER NUMBER (0..31), and also the BDOS stack top address.
1264  9F41              ;   DUAL USE, and it is DRI saving a byte rather than an accident: BDOS_DISPATCH does
1265  9F41              ;   LD SP,BDOS_USER_NUM, but the Z-80 decrements SP BEFORE writing, so pushes land at
1266  9F41              ;   BDOS_USER_NUM-1 and below. The byte at this address is never touched by the stack and
1267  9F41              ;   holds the user number: F_USERNUM_H (fn 32) writes it, FCB_MERGE_USER ORs it into FCB
1268  9F41              ;   byte 0, and ALLOC_VECTOR_BUILD compares directory entries against it. An earlier
1269  9F41              ;   annotation named it for the stack role only, which is what made the '$' probe in
1270  9F41              ;   ALLOC_VECTOR_BUILD unreadable. [RE]
1271  9F41              ; ----------------------------------------------------------------------
1272  9F41              BDOS_USER_NUM:
1273  9F41 00                   DEFB    "\0"
1274  9F42              ; ----------------------------------------------------------------------
1275  9F42              ; BDOS_CUR_DRIVE -- current selected drive index (0=A) for error reporting and disk ops.
1276  9F42              ;   [RE] Used to form the error-banner drive letter and as the drive arg in random-record
1277  9F42              ;        / DPB setup.
1278  9F42              ; ----------------------------------------------------------------------
1279  9F42              BDOS_CUR_DRIVE:
1280  9F42 00                   DEFB    "\0"
1281  9F43              ; ----------------------------------------------------------------------
1282  9F43              ; BDOS_PARAM_PTR -- saved DE parameter pointer from the BDOS call (FCB / DMA / buffer).
1283  9F43              ;   [RE] BDOS_DISPATCH stashes the incoming DE here; consumers (file ops, line input)
1284  9F43              ;        reload it as the operand pointer. 16-bit cell.
1285  9F43              ; ----------------------------------------------------------------------
1286  9F43              BDOS_PARAM_PTR:
1287  9F43 00 00                DEFB    "\0\0"
1288  9F45              ; ----------------------------------------------------------------------
1289  9F45              ; BDOS_RETVAL -- BDOS function return value (16-bit: low byte = A result, high = B).
1290  9F45              ;   [RE] Cleared on entry; written by BDOS_RET_RESULT; read back by the dispatcher's exit.
1291  9F45              ; ----------------------------------------------------------------------
1292  9F45              BDOS_RETVAL:
1293  9F45 00 00                DEFB    "\0\0"
1294  9F47              ; ----------------------------------------------------------------------
1295  9F47              ; BDOS_ERR_SELECT -- enter the BDOS disk-error handler via the error-vector table.
1296  9F47              ;   In: none (uses the fixed error-vector list at BDOS_ERR_VECTORS).
1297  9F47              ;   Out: transfers to the indexed error routine (does not return normally).
1298  9F47              ;   Clobbers: HL, DE.
1299  9F47              ;   Algorithm: point HL at the error-vector table entry (BDOS_ERRVEC_SELECT) and fall into the
1300  9F47              ;              dispatch-by-pointer tail BDOS_VECTOR_JUMP.
1301  9F47              ;   [RE] One of the BDOS_ERR_VECTORS table dispatch entry points.
1302  9F47              ;   [?] Exact reason-code mapping is encoded by which vector slot the caller chose;
1303  9F47              ;       semantics beyond 'jump through the error-vector table' are inferred.
1304  9F47              ; ----------------------------------------------------------------------
1305  9F47              BDOS_ERR_SELECT:
1306  9F47                      ; Point at the error-vector table slot
1307  9F47 21 0B 9C             LD HL,BDOS_ERRVEC_SELECT
1308  9F4A              ; ----------------------------------------------------------------------
1309  9F4A              ; BDOS_VECTOR_JUMP -- jump through a 2-byte pointer pointed to by HL.
1310  9F4A              ;   In: HL -> a little-endian routine pointer.
1311  9F4A              ;   Out: control transferred to (HL); does not return here.
1312  9F4A              ;   Clobbers: DE, HL.
1313  9F4A              ;   Algorithm: load DE from (HL), EX DE,HL, JP (HL) -- an indirect call/jump.
1314  9F4A              ;   [RE] Shared indirect-dispatch tail used by the BDOS error/random-record paths.
1315  9F4A              ; ----------------------------------------------------------------------
1316  9F4A              BDOS_VECTOR_JUMP:
1317  9F4A                      ; Low byte of the target pointer
1318  9F4A 5E                   LD E,(HL)
1319  9F4B 23                   INC HL
1320  9F4C                      ; High byte of the target pointer
1321  9F4C 56                   LD D,(HL)
1322  9F4D EB                   EX DE,HL
1323  9F4E                      ; Jump to the resolved routine
1324  9F4E E9                   JP (HL)
1325  9F4F              ; ----------------------------------------------------------------------
1326  9F4F              ; BLOCK_COPY_INCC -- copy (C+1) bytes from (DE) to (HL); pre-increment entry.
1327  9F4F              ;   In: C = count-1, DE = source, HL = destination.
1328  9F4F              ;   Out: bytes copied; DE/HL advanced past the block.
1329  9F4F              ;   Clobbers: AF, C, DE, HL.
1330  9F4F              ;   Algorithm: INC C so the following DEC-C-test loop runs C+1 times, copying one byte
1331  9F4F              ;              per pass.
1332  9F4F              ;   [RE] Small memory-copy helper used by the BDOS DPB / random-record setup.
1333  9F4F              ; ----------------------------------------------------------------------
1334  9F4F              BLOCK_COPY_INCC:
1335  9F4F                      ; Bump count so the loop runs (C+1) times
1336  9F4F 0C                   INC C
1337  9F50              ; ----------------------------------------------------------------------
1338  9F50              ; BLOCK_COPY_LOOP -- byte-copy loop body for BLOCK_COPY_INCC.
1339  9F50              ;   In: C = remaining count, DE = source, HL = destination.
1340  9F50              ;   Out: copies bytes until C decrements to zero.
1341  9F50              ;   Clobbers: AF, C, DE, HL.
1342  9F50              ;   Algorithm: DEC C; if zero return; copy (DE)->(HL); INC DE; INC HL; loop.
1343  9F50              ;   [RE] Loop of the BDOS block-copy helper.
1344  9F50              ; ----------------------------------------------------------------------
1345  9F50              BLOCK_COPY_LOOP:
1346  9F50                      ; One fewer byte to copy
1347  9F50 0D                   DEC C
1348  9F51                      ; Count exhausted
1349  9F51 C8                   RET Z
1350  9F52                      ; Read source byte
1351  9F52 1A                   LD A,(DE)
1352  9F53                      ; Store to destination
1353  9F53 77                   LD (HL),A
1354  9F54 13                   INC DE
1355  9F55 23                   INC HL
1356  9F56                      ; Next byte
1357  9F56 C3 50 9F             JP BLOCK_COPY_LOOP
1358  9F59              ; ----------------------------------------------------------------------
1359  9F59              ; DRV_SELECT_DPB -- select the current drive and copy its Disk Parameter Block into BDOS work cells.
1360  9F59              ;   In: BDOS_CUR_DRIVE = drive index.
1361  9F59              ;   Out: BDOS DPB/work pointers (DPB_WORK_PTR0, DEBLOCK_HSTREC_PTR0/B7, DPB_XLT_PTR, dir/alloc fields,
1362  9F59              ;        MAX_BLOCK_DSM, BLOCK_WIDTH_FLAG) populated for the selected drive; A=FF success.
1363  9F59              ;   Clobbers: AF, BC, DE, HL.
1364  9F59              ;   Algorithm: ask the BIOS SELDSK vector ($AA1B) for the selected drive's DPH; if null
1365  9F59              ;              return; chase the DPH to the DPB, copy the translation/allocation pointers
1366  9F59              ;              and the parameter block into the BDOS working cells (via BLOCK_COPY_INCC),
1367  9F59              ;              then set BLOCK_WIDTH_FLAG from the max-block-number high byte (single- vs
1368  9F59              ;              multi-byte block addressing).
1369  9F59              ;   [RE] Standard CP/M 2.2 drive-select / DPB extraction sequence.
1370  9F59              ;   [?] Individual A9xx work-cell roles are inferred from the canonical DPB layout.
1371  9F59              ; ----------------------------------------------------------------------
1372  9F59              BDOS_RANDREC_3:
1373  9F59                      ; Current drive index
1374  9F59 3A 42 9F             LD A,(BDOS_CUR_DRIVE)
1375  9F5C 4F                   LD C,A
1376  9F5D                      ; BIOS SELDSK -> DPH pointer in HL
1377  9F5D CD 1B AA             CALL $AA1B+OS_RELOC
1378  9F60 7C                   LD A,H
1379  9F61                      ; DPH pointer null? (no such drive)
1380  9F61 B5                   OR L
1381  9F62                      ; Null -> bail out
1382  9F62 C8                   RET Z
1383  9F63 5E                   LD E,(HL)
1384  9F64 23                   INC HL
1385  9F65 56                   LD D,(HL)
1386  9F66 23                   INC HL
1387  9F67                      ; Save the DPB-derived work pointer
1388  9F67 22 B3 A9             LD (DPB_WORK_PTR0),HL
1389  9F6A 23                   INC HL
1390  9F6B 23                   INC HL
1391  9F6C 22 B5 A9             LD (DEBLOCK_HSTREC_PTR0),HL
1392  9F6F 23                   INC HL
1393  9F70 23                   INC HL
1394  9F71 22 B7 A9             LD (DEBLOCK_HSTREC_PTR1),HL
1395  9F74 23                   INC HL
1396  9F75 23                   INC HL
1397  9F76 EB                   EX DE,HL
1398  9F77 22 D0 A9             LD (DPB_XLT_PTR),HL
1399  9F7A 21 B9 A9             LD HL,DIRBUF_PTR
1400  9F7D 0E 08                LD C,$08
1401  9F7F CD 4F 9F             CALL BLOCK_COPY_INCC
1402  9F82 2A BB A9             LD HL,(DPB_PTR)
1403  9F85 EB                   EX DE,HL
1404  9F86 21 C1 A9             LD HL,DPB_SPT
1405  9F89 0E 0F                LD C,$0F
1406  9F8B CD 4F 9F             CALL BLOCK_COPY_INCC
1407  9F8E                      ; Max block number (DSM) for this drive
1408  9F8E 2A C6 A9             LD HL,(MAX_BLOCK_DSM)
1409  9F91 7C                   LD A,H
1410  9F92                      ; Flag: 1- vs 2-byte block addressing
1411  9F92 21 DD A9             LD HL,BLOCK_WIDTH_FLAG
1412  9F95 36 FF                LD (HL),$FF
1413  9F97 B7                   OR A
1414  9F98                      ; DSM high byte 0 => single-byte block map
1415  9F98 CA 9D 9F             JP Z,DRV_SELECT_OK
1416  9F9B 36 00                LD (HL),$00
1417  9F9D              ; ----------------------------------------------------------------------
1418  9F9D              ; DRV_SELECT_OK -- success tail of the drive-select / DPB-setup path: pick the allocation-map width,
1419  9F9D              ; then return the 'drive selected' status.
1420  9F9D              ;   In: MAX_BLOCK_DSM (the DPB's DSM = highest block number) already loaded; BLOCK_WIDTH_FLAG cell
1421  9F9D              ;       about to be set.
1422  9F9D              ;   Out: A = $FF with flags NZ (OR A leaves A non-zero) -- the non-NULL 'drive selected' indicator
1423  9F9D              ;        returned to the SELDSK caller. BLOCK_WIDTH_FLAG = $FF if DSM < 256 (1-byte allocation
1424  9F9D              ;        entries) or $00 if DSM >= 256 (2-byte entries).
1425  9F9D              ;   Clobbers: A, F (HL was used by the caller just above to address BLOCK_WIDTH_FLAG).
1426  9F9D              ;   Algorithm: this label is the join of two paths. When DSM's high byte is zero (small disk) the
1427  9F9D              ;              caller's 'JP Z' lands here directly, leaving BLOCK_WIDTH_FLAG at its preset $FF;
1428  9F9D              ;              otherwise the caller falls through after first storing $00 into BLOCK_WIDTH_FLAG.
1429  9F9D              ;              Both paths then load A=$FF and OR A so the routine returns a non-zero 'selected'
1430  9F9D              ;              status.
1431  9F9D              ; [RE] Verified from the byte sequence (3E FF / B7 / C9) and from the preceding test of
1432  9F9D              ; MAX_BLOCK_DSM's high byte that selects BLOCK_WIDTH_FLAG. The $FF return is the SELDSK-path success
1433  9F9D              ; value.
1434  9F9D              ; ----------------------------------------------------------------------
1435  9F9D              DRV_SELECT_OK:
1436  9F9D                      ; A = $FF: non-zero 'drive selected / parameters valid' status.
1437  9F9D 3E FF                LD A,$FF
1438  9F9F                      ; Set flags from A (NZ) so the caller sees a non-zero result.
1439  9F9F B7                   OR A
1440  9FA0 C9                   RET
1441  9FA1              ; ----------------------------------------------------------------------
1442  9FA1              ; DISK_HOME_CLEAR_SCAN -- seek the drive to track 0 and reset the two BDOS record-scan accumulator
1443  9FA1              ; cells.
1444  9FA1              ;   In: DEBLOCK_HSTREC_PTR0 and DEBLOCK_HSTREC_PTR1 each hold the ADDRESS of a 16-bit scratch word (set up by the drive-select
1445  9FA1              ;       path).
1446  9FA1              ;   Out: BIOS HOME has positioned the head at track 0; the 16-bit word pointed to by (DEBLOCK_HSTREC_PTR0) and
1447  9FA1              ;        the 16-bit word pointed to by (DEBLOCK_HSTREC_PTR1) are both zeroed; A = 0.
1448  9FA1              ;   Clobbers: A, HL, F.
1449  9FA1              ;   Algorithm: CALL the BIOS HOME vector ($AA18, jump-table entry 8) to seek to track 0, then store
1450  9FA1              ;              0 into the two bytes of the word at (DEBLOCK_HSTREC_PTR0) and the two bytes of the word at
1451  9FA1              ;              (DEBLOCK_HSTREC_PTR1). This re-bases the record->track/sector walk at the start of the disk for a
1452  9FA1              ;              fresh scan.
1453  9FA1              ; [RE] $AA18 is jump-table entry 8 = HOME (verified against the BIOS jump table at $AA00). A=0 (XOR
1454  9FA1              ; A) is written through the two stored pointers, two bytes each.
1455  9FA1              ; ----------------------------------------------------------------------
1456  9FA1              DISK_HOME_CLEAR_SCAN:
1457  9FA1                      ; BIOS HOME (jump-table entry 8): seek the head to track 0.
1458  9FA1 CD 18 AA             CALL $AA18+OS_RELOC
1459  9FA4                      ; A = 0, the fill value for the scan-accumulator cells.
1460  9FA4 AF                   XOR A
1461  9FA5                      ; HL = address of the first 16-bit scan accumulator; zero its two bytes.
1462  9FA5 2A B5 A9             LD HL,(DEBLOCK_HSTREC_PTR0)
1463  9FA8 77                   LD (HL),A
1464  9FA9 23                   INC HL
1465  9FAA 77                   LD (HL),A
1466  9FAB                      ; HL = address of the second 16-bit scan accumulator; zero its two bytes.
1467  9FAB 2A B7 A9             LD HL,(DEBLOCK_HSTREC_PTR1)
1468  9FAE 77                   LD (HL),A
1469  9FAF 23                   INC HL
1470  9FB0 77                   LD (HL),A
1471  9FB1 C9                   RET
1472  9FB2              ; ----------------------------------------------------------------------
1473  9FB2              ; DISK_READ_CHECKED -- issue a BIOS sector READ and convert a non-zero BIOS status into a BDOS disk
1474  9FB2              ; error.
1475  9FB2              ;   In: BIOS disk parameters (drive/track/sector/DMA) already set by the caller.
1476  9FB2              ;   Out: returns normally if the read succeeded (BIOS A = 0); otherwise does not return -- transfers
1477  9FB2              ;        into the BDOS disk-error dispatcher.
1478  9FB2              ;   Clobbers: A, F (and whatever the BIOS read consumes).
1479  9FB2              ;   Algorithm: CALL the BIOS READ vector ($AA27, jump-table entry 13), then JP to the shared status
1480  9FB2              ;              check (DISK_STATUS_CHECK), which raises a BDOS disk error when A is non-zero.
1481  9FB2              ; [RE] $AA27 is jump-table entry 13 = READ (verified against the BIOS jump table at $AA00); the
1482  9FB2              ; shared tail tests A and dispatches through BDOS_ERR_VECTORS.
1483  9FB2              ; ----------------------------------------------------------------------
1484  9FB2              DISK_READ_CHECKED:
1485  9FB2                      ; BIOS READ (jump-table entry 13): read the selected sector into the DMA buffer; A=0 on
1486  9FB2                      ; success.
1487  9FB2 CD 27 AA             CALL $AA27+OS_RELOC
1488  9FB5 C3 BB 9F             JP DISK_STATUS_CHECK
1489  9FB8              ; ----------------------------------------------------------------------
1490  9FB8              ; DISK_WRITE_CHECKED -- issue a BIOS sector WRITE and convert a non-zero BIOS status into a BDOS
1491  9FB8              ; disk error.
1492  9FB8              ;   In: BIOS disk parameters (drive/track/sector/DMA) already set by the caller.
1493  9FB8              ;   Out: returns normally if the write succeeded (BIOS A = 0); otherwise does not return --
1494  9FB8              ;        transfers into the BDOS disk-error dispatcher.
1495  9FB8              ;   Clobbers: A, F (and whatever the BIOS write consumes).
1496  9FB8              ;   Algorithm: CALL the BIOS WRITE vector ($AA2A, jump-table entry 14), then fall through into the
1497  9FB8              ;              shared status check (DISK_STATUS_CHECK), which raises a BDOS disk error when A is
1498  9FB8              ;              non-zero.
1499  9FB8              ; [RE] $AA2A is jump-table entry 14 = WRITE (verified against the BIOS jump table at $AA00); shares
1500  9FB8              ; the error tail with DISK_READ_CHECKED.
1501  9FB8              ; ----------------------------------------------------------------------
1502  9FB8              DISK_WRITE_CHECKED:
1503  9FB8                      ; BIOS WRITE (jump-table entry 14): write the DMA buffer to the selected sector; A=0 on
1504  9FB8                      ; success.
1505  9FB8 CD 2A AA             CALL $AA2A+OS_RELOC
1506  9FBB              ; ----------------------------------------------------------------------
1507  9FBB              ; DISK_STATUS_CHECK -- shared BIOS-status check used by the READ/WRITE wrappers; raise a BDOS disk
1508  9FBB              ; error on failure.
1509  9FBB              ;   In: A = BIOS read/write status (0 = success, non-zero = hardware/select error).
1510  9FBB              ;   Out: returns to the wrapper's caller if A = 0; otherwise points HL at the BDOS error-vector
1511  9FBB              ;        table and jumps into the indirect error dispatcher (does not return).
1512  9FBB              ;   Clobbers: HL, F (on the error path control transfers away).
1513  9FBB              ;   Algorithm: OR A; RET Z on success. On failure load HL with BDOS_ERR_VECTORS and JP to the
1514  9FBB              ;              indirect dispatcher (BDOS_VECTOR_JUMP), which reads a 16-bit handler address from the
1515  9FBB              ;              table and jumps to it (the first entry = disk-I/O error).
1516  9FBB              ; [RE] HL is set to the BDOS_ERR_VECTORS table (its first entry, the disk-I/O error handler) before
1517  9FBB              ; the indirect dispatch through BDOS_VECTOR_JUMP.
1518  9FBB              ; ----------------------------------------------------------------------
1519  9FBB              DISK_STATUS_CHECK:
1520  9FBB                      ; Test BIOS status: zero = success.
1521  9FBB B7                   OR A
1522  9FBC                      ; Success: return to the READ/WRITE wrapper's caller.
1523  9FBC C8                   RET Z
1524  9FBD                      ; Failure: point at the BDOS disk-error vector table (first entry).
1525  9FBD 21 09 9C             LD HL,BDOS_ERR_VECTORS
1526  9FC0                      ; Dispatch indirectly through the error-vector table (does not return).
1527  9FC0 C3 4A 9F             JP BDOS_VECTOR_JUMP
1528  9FC3              ; ----------------------------------------------------------------------
1529  9FC3              ; REC_DIV4_SETUP -- divide the current record number by 4 and stage it as the target for the
1530  9FC3              ; record->track/sector walk.
1531  9FC3              ;   In: CUR_RECORD holds the current logical record number (read here as a 16-bit value).
1532  9FC3              ;   Out: HL = CUR_RECORD >> 2; that value is stored into both CUR_BLOCK_NUMBER (the walk target) and the start
1533  9FC3              ;        of REC_CACHE.
1534  9FC3              ;   Clobbers: A, C, HL, F.
1535  9FC3              ;   Algorithm: load HL from CUR_RECORD, set C = 2, call the logical-shift-right-by-C helper
1536  9FC3              ;              (DRV_INSTALL_RWTS_10) to compute HL = HL >> 2, then save the result to CUR_BLOCK_NUMBER
1537  9FC3              ;              (consumed by RECORD_TO_TRACK as the search target) and cache it at REC_CACHE.
1538  9FC3              ; [RE] DRV_INSTALL_RWTS_10 verified as a 'shift HL logically right C times' helper (OR A clears
1539  9FC3              ; carry, then RRA on H and L, C iterations); C=2 -> divide by 4.
1540  9FC3              ; RESOLVED from the 60K twin: the /4 is ENTRIES PER RECORD. CP/M packs four 32-byte directory
1541  9FC3              ; entries into one 128-byte record, so CUR_RECORD is an entry INDEX and index>>2 is the record
1542  9FC3              ; number holding it -- which is what the subsequent track/sector resolver searches for.
1543  9FC3              ; (128/32 = 4; the 60K DIR_RECORD_DEBLOCK header states the same packing.)
1544  9FC3              ; ----------------------------------------------------------------------
1545  9FC3              REC_DIV4_SETUP:
1546  9FC3                      ; HL = current logical record number (16-bit load).
1547  9FC3 2A EA A9             LD HL,(CUR_RECORD)
1548  9FC6                      ; Shift count = 2 (logical shift right by 2 = divide by 4).
1549  9FC6 0E 02                LD C,$02
1550  9FC8                      ; HL >>= 2 via the shift-right-by-C helper.
1551  9FC8 CD EA A0             CALL DRV_INSTALL_RWTS_10
1552  9FCB                      ; Store as the search target for the record->track/sector walk.
1553  9FCB 22 E5 A9             LD (CUR_BLOCK_NUMBER),HL
1554  9FCE                      ; Also cache the value at the start of REC_CACHE.
1555  9FCE 22 EC A9             LD (REC_CACHE),HL
1556  9FD1              ; ----------------------------------------------------------------------
1557  9FD1              ; RECORD_TO_TRACK -- entry of the loop that maps a logical record number to its physical track by
1558  9FD1              ; stepping in sectors-per-track units.
1559  9FD1              ;   In: CUR_BLOCK_NUMBER = 16-bit search target (record/4, set by REC_DIV4_SETUP); (DEBLOCK_HSTREC_PTR1) -> a 16-bit
1560  9FD1              ;       running record-boundary accumulator; (DEBLOCK_HSTREC_PTR0) -> the current track number; DPB_SPT = SPT
1561  9FD1              ;       (128-byte records per track, low word of the copied DPB).
1562  9FD1              ;   Out: loads BC = target, DE = current boundary accumulator, HL = current track number, then
1563  9FD1              ;        enters the search loop (RECORD_TO_TRACK_BACK). On a match it branches to
1564  9FD1              ;        DISK_STORE_SEC_TRK_1, which sets the BIOS track/sector.
1565  9FD1              ;   Clobbers: A, BC, DE, HL, F.
1566  9FD1              ;   Algorithm: load the target into BC (via CUR_BLOCK_NUMBER), the boundary accumulator into DE (dereferenced
1567  9FD1              ;              through (DEBLOCK_HSTREC_PTR1)), and the current track number into HL (dereferenced through
1568  9FD1              ;              (DEBLOCK_HSTREC_PTR0)), then fall into the back/forward search that walks the accumulator by SPT
1569  9FD1              ;              until the target record falls inside one track.
1570  9FD1              ; [RE] DPB_SPT is the first word of the 15-byte DPB copied at $9F86 = SPT (128-byte records per track);
1571  9FD1              ; MAX_BLOCK_DSM/$A9C6 is DSM at DPB offset 5, DPB_OFF is OFF at offset 13. The exit
1572  9FD1              ; DISK_STORE_SEC_TRK_1 adds DPB_OFF (OFF) and calls the BIOS SETTRK vector ($AA1E), confirming the
1573  9FD1              ; walked quantity is a track, not an allocation block.
1574  9FD1              ; ----------------------------------------------------------------------
1575  9FD1              RECORD_TO_TRACK:
1576  9FD1                      ; HL -> the 16-bit search-target cell (record/4).
1577  9FD1 21 E5 A9             LD HL,CUR_BLOCK_NUMBER
1578  9FD4                      ; BC = search target (low byte then high).
1579  9FD4 4E                   LD C,(HL)
1580  9FD5 23                   INC HL
1581  9FD6 46                   LD B,(HL)
1582  9FD7                      ; Dereference the boundary-accumulator pointer; load DE = current boundary.
1583  9FD7 2A B7 A9             LD HL,(DEBLOCK_HSTREC_PTR1)
1584  9FDA 5E                   LD E,(HL)
1585  9FDB 23                   INC HL
1586  9FDC 56                   LD D,(HL)
1587  9FDD                      ; Dereference the track-number pointer; load HL = current track number.
1588  9FDD 2A B5 A9             LD HL,(DEBLOCK_HSTREC_PTR0)
1589  9FE0 7E                   LD A,(HL)
1590  9FE1 23                   INC HL
1591  9FE2 66                   LD H,(HL)
1592  9FE3 6F                   LD L,A
1593  9FE4              ; ----------------------------------------------------------------------
1594  9FE4              ; RECORD_TO_TRACK_BACK -- 'overshoot' branch: step the track number back while the boundary
1595  9FE4              ; accumulator exceeds the target.
1596  9FE4              ;   In: BC = target; DE = current boundary accumulator; HL = current track number; DPB_SPT = SPT
1597  9FE4              ;       (128-byte records per track).
1598  9FE4              ;   Out: loops, or when target >= accumulator falls into RECORD_TO_TRACK_FWD (forward branch).
1599  9FE4              ;   Clobbers: A, DE, HL, F.
1600  9FE4              ;   Algorithm: compute target - accumulator (BC - DE) via SUB E / SBC A,D; if no borrow (target >=
1601  9FE4              ;              accumulator) branch forward to RECORD_TO_TRACK_FWD. Otherwise subtract one track's
1602  9FE4              ;              worth of sectors (SPT in DPB_SPT) from DE and decrement the track number HL, then
1603  9FE4              ;              repeat.
1604  9FE4              ; [RE] The SUB E / SBC A,D pattern is a 16-bit compare of BC against DE through A; the borrow
1605  9FE4              ; (carry-out) selects the direction. The subtraction of DPB_SPT from DE backs the boundary down by
1606  9FE4              ; one track.
1607  9FE4              ; ----------------------------------------------------------------------
1608  9FE4              RECORD_TO_TRACK_BACK:
1609  9FE4 79                   LD A,C
1610  9FE5                      ; 16-bit compare: low byte of (target - accumulator).
1611  9FE5 93                   SUB E
1612  9FE6 78                   LD A,B
1613  9FE7                      ; ...high byte; borrow (carry set) means target < accumulator (overshot).
1614  9FE7 9A                   SBC A,D
1615  9FE8                      ; target >= accumulator: switch to the forward search.
1616  9FE8 D2 FA 9F             JP NC,RECORD_TO_TRACK_FWD
1617  9FEB E5                   PUSH HL
1618  9FEC                      ; HL = SPT (128-byte records per track); back the boundary accumulator down by one track.
1619  9FEC 2A C1 A9             LD HL,(DPB_SPT)
1620  9FEF 7B                   LD A,E
1621  9FF0 95                   SUB L
1622  9FF1 5F                   LD E,A
1623  9FF2 7A                   LD A,D
1624  9FF3 9C                   SBC A,H
1625  9FF4 57                   LD D,A
1626  9FF5 E1                   POP HL
1627  9FF6                      ; Step the track number down by one.
1628  9FF6 2B                   DEC HL
1629  9FF7                      ; Repeat the overshoot test for the previous track.
1630  9FF7 C3 E4 9F             JP RECORD_TO_TRACK_BACK
1631  9FFA              ; ----------------------------------------------------------------------
1632  9FFA              ; RECORD_TO_TRACK_FWD -- 'forward' branch: step the track number ahead one track until the target
1633  9FFA              ; record falls inside it.
1634  9FFA              ;   In: BC = target; DE = boundary accumulator; HL = current track number; DPB_SPT = SPT (sectors per
1635  9FFA              ;       track).
1636  9FFA              ;   Out: when the target lies within the current track, branches to DISK_STORE_SEC_TRK_1 to set the
1637  9FFA              ;        BIOS track and compute the sector within it; otherwise loops.
1638  9FFA              ;   Clobbers: A, BC, DE, HL, F.
1639  9FFA              ;   Algorithm: add one SPT (DPB_SPT) to the boundary DE; if that addition carries, the target is in
1640  9FFA              ;              this track -> exit. Else compare the target (BC) against the new boundary; if the
1641  9FFA              ;              boundary now exceeds the target, exit; otherwise commit the new boundary into DE,
1642  9FFA              ;              advance the track number HL, and repeat.
1643  9FFA              ; [RE] The two SUB L / SBC A,H comparisons test BC against the advanced boundary in HL; either
1644  9FFA              ; carry-out routes to DISK_STORE_SEC_TRK_1, which sets the BIOS track via SETTRK ($AA1E).
1645  9FFA              ; ----------------------------------------------------------------------
1646  9FFA              RECORD_TO_TRACK_FWD:
1647  9FFA E5                   PUSH HL
1648  9FFB                      ; HL = SPT (128-byte records per track).
1649  9FFB 2A C1 A9             LD HL,(DPB_SPT)
1650  9FFE                      ; Advance the boundary accumulator by one track's sectors.
1651  9FFE 19                   ADD HL,DE
1652  9FFF                      ; Carry: target is inside this track -> resolve to track/sector.
1653  9FFF DA 0F A0             JP C,DISK_STORE_SEC_TRK_1
1654  A002 79                   LD A,C
1655  A003                      ; Compare target (BC) low byte against the advanced boundary.
1656  A003 95                   SUB L
1657  A004 78                   LD A,B
1658  A005                      ; ...high byte; carry means the boundary now passes the target -> done.
1659  A005 9C                   SBC A,H
1660  A006                      ; Boundary now exceeds target: resolve this track to track/sector.
1661  A006 DA 0F A0             JP C,DISK_STORE_SEC_TRK_1
1662  A009                      ; Commit the advanced boundary into DE.
1663  A009 EB                   EX DE,HL
1664  A00A E1                   POP HL
1665  A00B                      ; Advance the track number forward.
1666  A00B 23                   INC HL
1667  A00C                      ; Repeat the forward search for the next track.
1668  A00C C3 FA 9F             JP RECORD_TO_TRACK_FWD
1669  A00F              ; ----------------------------------------------------------------------
1670  A00F              ; BDOS_DEBLOCK_XFER_LOOP -- transfer a record span through the BIOS-bridge helper, then advance.
1671  A00F              ;   In: BC = record count, DE = record offset within the buffer span, HL on the stack;
1672  A00F              ;       DPB_OFF = a base address/pointer set from the selected-disk header (role UNKNOWN);
1673  A00F              ;       DEBLOCK_HSTREC_PTR0/DEBLOCK_HSTREC_PTR1 = pointer cells (set from the selected-disk header).
1674  A00F              ;   Out: DEBLOCK_HSTREC_PTR0 and DEBLOCK_HSTREC_PTR1 each updated to the value DE returned by the helper; BC = BC - DE.
1675  A00F              ;   Clobbers: A,BC,DE,HL.
1676  A00F              ;   Algorithm: pop the saved pointer, add the DPB_OFF base to DE to form the helper request in BC,
1677  A00F              ;       CALL the BIOS-bridge helper $AA1E; store its returned DE into both [DEBLOCK_HSTREC_PTR0] and [DEBLOCK_HSTREC_PTR1];
1678  A00F              ;       recompute BC = BC - DE; load the advance vector (DPB_XLT_PTR) into DE, CALL the advance helper
1679  A00F              ;       $AA30, then JP back into the bridge at $AA21.
1680  A00F              ;   [RE] part of the BDOS deblocking transfer path; the $AAxx targets are BIOS-bridge helpers above
1681  A00F              ;       this cluster. [?] transfer DIRECTION (read vs write) and the exact buffer/pointer semantics
1682  A00F              ;       UNKNOWN -- not determinable from these bytes alone.
1683  A00F              ; ----------------------------------------------------------------------
1684  A00F              DISK_STORE_SEC_TRK_1:
1685  A00F E1                   POP HL
1686  A010 C5                   PUSH BC
1687  A011 D5                   PUSH DE
1688  A012 E5                   PUSH HL
1689  A013 EB                   EX DE,HL
1690  A014                      ; add the DPB_OFF base (from the selected-disk header) to the record offset
1691  A014 2A CE A9             LD HL,(DPB_OFF)
1692  A017 19                   ADD HL,DE
1693  A018 44                   LD B,H
1694  A019 4D                   LD C,L
1695  A01A                      ; BIOS-bridge transfer helper for the assembled span
1696  A01A CD 1E AA             CALL $AA1E+OS_RELOC
1697  A01D D1                   POP DE
1698  A01E 2A B5 A9             LD HL,(DEBLOCK_HSTREC_PTR0)
1699  A021 73                   LD (HL),E
1700  A022 23                   INC HL
1701  A023 72                   LD (HL),D
1702  A024 D1                   POP DE
1703  A025 2A B7 A9             LD HL,(DEBLOCK_HSTREC_PTR1)
1704  A028 73                   LD (HL),E
1705  A029 23                   INC HL
1706  A02A 72                   LD (HL),D
1707  A02B C1                   POP BC
1708  A02C 79                   LD A,C
1709  A02D                      ; begin BC = BC - DE: records remaining after this span
1710  A02D 93                   SUB E
1711  A02E 4F                   LD C,A
1712  A02F 78                   LD A,B
1713  A030 9A                   SBC A,D
1714  A031 47                   LD B,A
1715  A032 2A D0 A9             LD HL,(DPB_XLT_PTR)
1716  A035 EB                   EX DE,HL
1717  A036                      ; BIOS-bridge advance helper for the next span
1718  A036 CD 30 AA             CALL $AA30+OS_RELOC
1719  A039 4D                   LD C,L
1720  A03A 44                   LD B,H
1721  A03B                      ; re-enter the bridge to continue the transfer loop
1722  A03B C3 21 AA             JP $AA21+OS_RELOC
1723  A03E              ; ----------------------------------------------------------------------
1724  A03E              ; FCB_RECORD_TO_BLOCKMAP_INDEX -- derive the FCB disk-map index for the current record/extent.
1725  A03E              ;   In: DPB_BSH = BSH (block-shift, records-per-block log2); FCB_CURREC = CR (current record, low half);
1726  A03E              ;       FCB_EXTENT_MASKED = the masked extent value ((FCB extent) AND EXM).
1727  A03E              ;   Out: A = the index (0..15) into the FCB allocation map for the block holding the current record.
1728  A03E              ;   Clobbers: A,B,C,HL.
1729  A03E              ;   Algorithm: C = BSH; rotate FCB_CURREC right BSH times (loop FCB_BLOCKMAP_INDEX_SHR) to drop the
1730  A03E              ;              within-block
1731  A03E              ;       record bits, keep the result in B; then C = 8 - BSH and rotate FCB_EXTENT_MASKED left (8-BSH) times
1732  A03E              ;       (loop FCB_BLOCKMAP_INDEX_SHL) to bring the extent bits up; finally ADD A,B at
1733  A03E              ;       DISK_STORE_SEC_TRK_9.
1734  A03E              ;   [RE] maps (record,extent) -> which d0..d15 entry of the FCB disk-allocation map; its output A is
1735  A03E              ;       used directly as the BC index into GET_ALLOC_BLOCK_ENTRY by DISK_STORE_SEC_TRK_14. [?] exact
1736  A03E              ;       bit packing partially inferred.
1737  A03E              ; ----------------------------------------------------------------------
1738  A03E              DISK_STORE_SEC_TRK_6:
1739  A03E                      ; DPB_BSH = DPB block-shift factor (BSH), records-per-block log2
1740  A03E 21 C3 A9             LD HL,DPB_BSH
1741  A041 4E                   LD C,(HL)
1742  A042 3A E3 A9             LD A,(FCB_CURREC)
1743  A045              FCB_BLOCKMAP_INDEX_SHR:
1744  A045 B7                   OR A
1745  A046 1F                   RRA
1746  A047 0D                   DEC C
1747  A048 C2 45 A0             JP NZ,FCB_BLOCKMAP_INDEX_SHR
1748  A04B 47                   LD B,A
1749  A04C                      ; complement the shift: 8 - BSH
1750  A04C 3E 08                LD A,$08
1751  A04E                      ; C = 8 - BSH = left-rotate count for the extent half
1752  A04E 96                   SUB (HL)
1753  A04F 4F                   LD C,A
1754  A050 3A E2 A9             LD A,(FCB_EXTENT_MASKED)
1755  A053              FCB_BLOCKMAP_INDEX_SHL:
1756  A053 0D                   DEC C
1757  A054 CA 5C A0             JP Z,DISK_STORE_SEC_TRK_9
1758  A057 B7                   OR A
1759  A058 17                   RLA
1760  A059 C3 53 A0             JP FCB_BLOCKMAP_INDEX_SHL
1761  A05C              ; ----------------------------------------------------------------------
1762  A05C              ; FCB_BLOCKMAP_INDEX_MERGE -- tail of DISK_STORE_SEC_TRK_6: combine the two shifted halves.
1763  A05C              ;   In: A = the left-shifted extent half; B = the right-shifted record half.
1764  A05C              ;   Out: A = combined disk-map index (A + B).
1765  A05C              ;   Clobbers: A.
1766  A05C              ;   Algorithm: ADD A,B and return.
1767  A05C              ;   [RE] continuation/exit label of the index computation.
1768  A05C              ; ----------------------------------------------------------------------
1769  A05C              DISK_STORE_SEC_TRK_9:
1770  A05C                      ; combine the extent and record halves into the disk-map index
1771  A05C 80                   ADD A,B
1772  A05D C9                   RET
1773  A05E              ; ----------------------------------------------------------------------
1774  A05E              ; GET_ALLOC_BLOCK_ENTRY -- read a block number from the current FCB's disk-allocation map, indexed
1775  A05E              ; by BC.
1776  A05E              ;   In: BC = entry index; BDOS_PARAM_PTR = the current FCB pointer (the BDOS call's DE parameter);
1777  A05E              ;       BLOCK_WIDTH_FLAG selects 8-bit (nonzero) vs 16-bit (zero) map entries.
1778  A05E              ;   Out: HL = the indexed block number (zero-extended byte if 8-bit, else the full 16-bit word).
1779  A05E              ;   Clobbers: A,DE,HL.
1780  A05E              ;   Algorithm: HL = [BDOS_PARAM_PTR] + $0010 + BC (FCB+$10 = the d0..d15 disk-allocation map); if
1781  A05E              ;       BLOCK_WIDTH_FLAG==0 fall through to the word path (DISK_STORE_SEC_TRK_13), otherwise read
1782  A05E              ;       a single byte into L with H=0.
1783  A05E              ;   [RE] the DSM>255 vs <=255 entry-width branch (standard CP/M big/small-disk map handling).
1784  A05E              ;       FCB offset $10 is the on-disk allocation map.
1785  A05E              ; ----------------------------------------------------------------------
1786  A05E              DISK_STORE_SEC_TRK_10:
1787  A05E                      ; current FCB pointer (BDOS DE parameter)
1788  A05E 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
1789  A061                      ; the FCB's allocation map (d0..d15)
1790  A061 11 10 00             LD DE,FCB.DIRECTORY_ENTRY.AL
1791  A064 19                   ADD HL,DE
1792  A065 09                   ADD HL,BC
1793  A066                      ; 0 = 16-bit map entries (big disk, DSM>255); nonzero = 8-bit
1794  A066 3A DD A9             LD A,(BLOCK_WIDTH_FLAG)
1795  A069 B7                   OR A
1796  A06A CA 71 A0             JP Z,DISK_STORE_SEC_TRK_13
1797  A06D                      ; 8-bit entry path: zero-extend the byte into HL
1798  A06D 6E                   LD L,(HL)
1799  A06E 26 00                LD H,$00
1800  A070 C9                   RET
1801  A071              ; ----------------------------------------------------------------------
1802  A071              ; GET_ALLOC_BLOCK_ENTRY_WORD -- 16-bit-entry tail of GET_ALLOC_BLOCK_ENTRY.
1803  A071              ;   In: HL = FCB map base + index (one stride short of the word entry); BC = entry index.
1804  A071              ;   Out: HL = the 16-bit block number fetched from the map.
1805  A071              ;   Clobbers: DE,HL.
1806  A071              ;   Algorithm: ADD HL,BC a second time (word stride), load low/high bytes into DE, EX DE,HL.
1807  A071              ;   [RE] big-disk word-entry fetch.
1808  A071              ; ----------------------------------------------------------------------
1809  A071              DISK_STORE_SEC_TRK_13:
1810  A071                      ; second add: word-sized stride into the allocation map
1811  A071 09                   ADD HL,BC
1812  A072 5E                   LD E,(HL)
1813  A073 23                   INC HL
1814  A074 56                   LD D,(HL)
1815  A075 EB                   EX DE,HL
1816  A076 C9                   RET
1817  A077              ; ----------------------------------------------------------------------
1818  A077              ; FCB_GET_CURRENT_BLOCK -- look up the FCB allocation-map block number for the current
1819  A077              ; record/extent.
1820  A077              ;   In: the current FCB and the FCB_CURREC/FCB_EXTENT_MASKED position cells (set by DRV_INSTALL_RWTS_3).
1821  A077              ;   Out: HL and CUR_BLOCK_NUMBER = the resolved block number from the FCB allocation map.
1822  A077              ;   Clobbers: A,BC,DE,HL.
1823  A077              ;   Algorithm: CALL DISK_STORE_SEC_TRK_6 to get the map index in A, move it to BC (C=A, B=0),
1824  A077              ;       CALL GET_ALLOC_BLOCK_ENTRY to fetch the block number, then cache it in CUR_BLOCK_NUMBER.
1825  A077              ;   [RE] composes the index computation and the map lookup to get the current block number.
1826  A077              ; ----------------------------------------------------------------------
1827  A077              DISK_STORE_SEC_TRK_14:
1828  A077                      ; derive the allocation-map index for this record/extent
1829  A077 CD 3E A0             CALL DISK_STORE_SEC_TRK_6
1830  A07A 4F                   LD C,A
1831  A07B 06 00                LD B,$00
1832  A07D                      ; fetch the block number from the FCB allocation map
1833  A07D CD 5E A0             CALL DISK_STORE_SEC_TRK_10
1834  A080                      ; cache the resolved block number
1835  A080 22 E5 A9             LD (CUR_BLOCK_NUMBER),HL
1836  A083 C9                   RET
1837  A084              ; ----------------------------------------------------------------------
1838  A084              ; BLOCK_IS_ZERO -- test whether the cached block number (CUR_BLOCK_NUMBER) is zero (unallocated).
1839  A084              ;   In: CUR_BLOCK_NUMBER = cached block number.
1840  A084              ;   Out: HL = the block number; Z set if it is zero (no block allocated -- a hole).
1841  A084              ;   Clobbers: A,HL.
1842  A084              ;   Algorithm: load CUR_BLOCK_NUMBER; LD A,L / OR H to set Z when both halves are zero.
1843  A084              ;   [RE] standard 'block 0 means unallocated' test.
1844  A084              ; ----------------------------------------------------------------------
1845  A084              DISK_STORE_SEC_TRK_16:
1846  A084 2A E5 A9             LD HL,(CUR_BLOCK_NUMBER)
1847  A087 7D                   LD A,L
1848  A088                      ; Z set when the 16-bit block number is zero (unallocated)
1849  A088 B4                   OR H
1850  A089 C9                   RET
1851  A08A              ; ----------------------------------------------------------------------
1852  A08A              ; BLOCK_TO_FIRST_RECORD -- expand a block number into the absolute record number it maps to.
1853  A08A              ;   In: CUR_BLOCK_NUMBER = block number; DPB_BSH = BSH (records-per-block log2); DPB_BLM = BLM (block mask);
1854  A08A              ;       FCB_CURREC = CR (current record, low half).
1855  A08A              ;   Out: BLOCK_BASE_RECORD = block<<BSH (the block's base record); CUR_BLOCK_NUMBER = (block base) OR (CR AND BLM).
1856  A08A              ;   Clobbers: A,C,HL.
1857  A08A              ;   Algorithm: shift CUR_BLOCK_NUMBER left BSH times (loop BLOCK_TO_FIRST_RECORD_SHL) to get the block base
1858  A08A              ;              record, store
1859  A08A              ;       it in BLOCK_BASE_RECORD; then OR in the within-block record bits (FCB_CURREC AND DPB_BLM) and store the
1860  A08A              ;       full record number back into CUR_BLOCK_NUMBER.
1861  A08A              ;   [RE] canonical record = (block << BSH) | (record AND BLM).
1862  A08A              ; ----------------------------------------------------------------------
1863  A08A              DISK_STORE_SEC_TRK_17:
1864  A08A                      ; BSH = number of left shifts (records-per-block log2)
1865  A08A 3A C3 A9             LD A,(DPB_BSH)
1866  A08D 2A E5 A9             LD HL,(CUR_BLOCK_NUMBER)
1867  A090              BLOCK_TO_FIRST_RECORD_SHL:
1868  A090 29                   ADD HL,HL
1869  A091 3D                   DEC A
1870  A092 C2 90 A0             JP NZ,BLOCK_TO_FIRST_RECORD_SHL
1871  A095                      ; save the block's base record number
1872  A095 22 E7 A9             LD (BLOCK_BASE_RECORD),HL
1873  A098                      ; BLM = block mask for the within-block record bits
1874  A098 3A C4 A9             LD A,(DPB_BLM)
1875  A09B 4F                   LD C,A
1876  A09C 3A E3 A9             LD A,(FCB_CURREC)
1877  A09F                      ; isolate the within-block record bits (CR AND BLM)
1878  A09F A1                   AND C
1879  A0A0                      ; merge the block base and the within-block offset
1880  A0A0 B5                   OR L
1881  A0A1 6F                   LD L,A
1882  A0A2 22 E5 A9             LD (CUR_BLOCK_NUMBER),HL
1883  A0A5 C9                   RET
1884  A0A6              ; ----------------------------------------------------------------------
1885  A0A6              ; FCB_FIELD_PTR_0C -- point HL at offset $0C (the EX / extent field) of the current FCB.
1886  A0A6              ;   In: BDOS_PARAM_PTR = current FCB pointer.
1887  A0A6              ;   Out: HL = [BDOS_PARAM_PTR] + $000C (FCB+12 = EX, the current-extent byte).
1888  A0A6              ;   Clobbers: DE,HL.
1889  A0A6              ;   Algorithm: load the FCB base, add $000C.
1890  A0A6              ;   [RE] accessor for FCB byte 12 (EX). [DOC CP/M 2.2 FCB]
1891  A0A6              ; ----------------------------------------------------------------------
1892  A0A6              DRV_INSTALL_RWTS_1:
1893  A0A6 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
1894  A0A9                      ; FCB+$0C = the EX (current extent) field
1895  A0A9 11 0C 00             LD DE,FCB.DIRECTORY_ENTRY.EX
1896  A0AC 19                   ADD HL,DE
1897  A0AD C9                   RET
1898  A0AE              ; ----------------------------------------------------------------------
1899  A0AE              ; FCB_FIELD_PTRS_0F_20 -- compute pointers to FCB offsets $0F (RC) and $20 (CR).
1900  A0AE              ;   In: BDOS_PARAM_PTR = current FCB pointer.
1901  A0AE              ;   Out: DE = [BDOS_PARAM_PTR] + $0F (FCB+15 = RC, record count); HL = DE + $11 = [BDOS_PARAM_PTR] +
1902  A0AE              ;        $20
1903  A0AE              ;        (FCB+32 = CR, current record).
1904  A0AE              ;   Clobbers: DE,HL.
1905  A0AE              ;   Algorithm: HL = base + $0F, move to DE, HL = DE + $11.
1906  A0AE              ;   [RE] paired accessor for the RC and CR FCB fields, used by DRV_INSTALL_RWTS_3/_6. [DOC CP/M 2.2
1907  A0AE              ;   FCB]
1908  A0AE              ; ----------------------------------------------------------------------
1909  A0AE              DRV_INSTALL_RWTS_2:
1910  A0AE 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
1911  A0B1                      ; FCB+$0F = the RC (record count) field
1912  A0B1 11 0F 00             LD DE,FCB.DIRECTORY_ENTRY.RC
1913  A0B4 19                   ADD HL,DE
1914  A0B5 EB                   EX DE,HL
1915  A0B6                      ; the distance from RC to CR, as arithmetic on the field names
1916  A0B6 21 11 00             LD HL,FCB.CR - FCB.DIRECTORY_ENTRY.RC
1917  A0B9 19                   ADD HL,DE
1918  A0BA C9                   RET
1919  A0BB              ; ----------------------------------------------------------------------
1920  A0BB              ; LOAD_FCB_POSITION -- copy the current FCB's position fields into the BDOS scratch cells.
1921  A0BB              ;   In: the current FCB (via DRV_INSTALL_RWTS_2 / _1); DPB_EXM = EXM (extent mask).
1922  A0BB              ;   Out: FCB_CURREC = CR (FCB+$20); FCB_RECCOUNT = RC (FCB+$0F); FCB_EXTENT_MASKED = EX (FCB+$0C) AND EXM.
1923  A0BB              ;   Clobbers: A,DE,HL.
1924  A0BB              ;   Algorithm: via DRV_INSTALL_RWTS_2 read CR into FCB_CURREC and RC into FCB_RECCOUNT; via
1925  A0BB              ;       DRV_INSTALL_RWTS_1 read EX, mask it with EXM (DPB_EXM), store in FCB_EXTENT_MASKED.
1926  A0BB              ;   [RE] loads the file's current record / record-count / masked-extent into the deblock scratch
1927  A0BB              ;   cells. [DOC CP/M 2.2 FCB]
1928  A0BB              ; ----------------------------------------------------------------------
1929  A0BB              DRV_INSTALL_RWTS_3:
1930  A0BB CD AE A0             CALL DRV_INSTALL_RWTS_2
1931  A0BE 7E                   LD A,(HL)
1932  A0BF                      ; stash CR (current record, FCB+$20)
1933  A0BF 32 E3 A9             LD (FCB_CURREC),A
1934  A0C2 EB                   EX DE,HL
1935  A0C3 7E                   LD A,(HL)
1936  A0C4                      ; stash RC (record count, FCB+$0F)
1937  A0C4 32 E1 A9             LD (FCB_RECCOUNT),A
1938  A0C7 CD A6 A0             CALL DRV_INSTALL_RWTS_1
1939  A0CA                      ; EXM (extent mask) applied to the EX byte
1940  A0CA 3A C5 A9             LD A,(DPB_EXM)
1941  A0CD A6                   AND (HL)
1942  A0CE                      ; store EX AND EXM (the in-extent bits)
1943  A0CE 32 E2 A9             LD (FCB_EXTENT_MASKED),A
1944  A0D1 C9                   RET
1945  A0D2              ; ----------------------------------------------------------------------
1946  A0D2              ; STORE_FCB_POSITION -- write the (possibly adjusted) position values back into the current FCB.
1947  A0D2              ;   In: WRITE_TYPE_FLAG (mode/adjust selector), FCB_CURREC, FCB_RECCOUNT scratch cells; the current FCB.
1948  A0D2              ;   Out: FCB+$20 (CR) = FCB_CURREC + adjust; FCB+$0F (RC) = FCB_RECCOUNT.
1949  A0D2              ;   Clobbers: A,C,DE,HL.
1950  A0D2              ;   Algorithm: get the RC/CR pointers; if WRITE_TYPE_FLAG != 2 then C = WRITE_TYPE_FLAG else C = 0; write
1951  A0D2              ;       (FCB_CURREC + C) into CR and FCB_RECCOUNT into RC.
1952  A0D2              ;   [RE] inverse of LOAD_FCB_POSITION with a special case when WRITE_TYPE_FLAG == 2 (the adjustment is
1953  A0D2              ;       zeroed). [?] meaning of the WRITE_TYPE_FLAG selector values UNKNOWN.
1954  A0D2              ; ----------------------------------------------------------------------
1955  A0D2              DRV_INSTALL_RWTS_6:
1956  A0D2 CD AE A0             CALL DRV_INSTALL_RWTS_2
1957  A0D5                      ; mode/adjust selector; value 2 zeroes the adjustment
1958  A0D5 3A D5 A9             LD A,(WRITE_TYPE_FLAG)
1959  A0D8                      ; special-case selector value 2
1960  A0D8 FE 02                CP $02
1961  A0DA C2 DE A0             JP NZ,STORE_FCB_POSITION_2
1962  A0DD AF                   XOR A
1963  A0DE              STORE_FCB_POSITION_2:
1964  A0DE 4F                   LD C,A
1965  A0DF 3A E3 A9             LD A,(FCB_CURREC)
1966  A0E2                      ; apply the selector-dependent adjustment to CR
1967  A0E2 81                   ADD A,C
1968  A0E3 77                   LD (HL),A
1969  A0E4 EB                   EX DE,HL
1970  A0E5 3A E1 A9             LD A,(FCB_RECCOUNT)
1971  A0E8 77                   LD (HL),A
1972  A0E9 C9                   RET
1973  A0EA              ; ----------------------------------------------------------------------
1974  A0EA              ; SHR_HL_C -- logical-shift HL right by C bit positions.
1975  A0EA              ;   In: HL = value; C = shift count (0 leaves HL unchanged).
1976  A0EA              ;   Out: HL >>= C (logical).
1977  A0EA              ;   Clobbers: A,C,HL (C decremented to 0).
1978  A0EA              ;   Algorithm: INC C / loop { DEC C; ret if zero; OR A to clear carry, RRA H, then RRA L feeding
1979  A0EA              ;       H's carried-out bit 0 into L's top }.
1980  A0EA              ;   [RE] generic unsigned right-shift helper used to scale block/drive-bit values.
1981  A0EA              ; ----------------------------------------------------------------------
1982  A0EA              DRV_INSTALL_RWTS_10:
1983  A0EA 0C                   INC C
1984  A0EB              SHR_HL_C_LOOP:
1985  A0EB 0D                   DEC C
1986  A0EC C8                   RET Z
1987  A0ED 7C                   LD A,H
1988  A0EE                      ; clear carry before the rotate (logical, not arithmetic, shift)
1989  A0EE B7                   OR A
1990  A0EF                      ; shift H right; its bit 0 is carried into L below
1991  A0EF 1F                   RRA
1992  A0F0 67                   LD H,A
1993  A0F1 7D                   LD A,L
1994  A0F2 1F                   RRA
1995  A0F3 6F                   LD L,A
1996  A0F4 C3 EB A0             JP SHR_HL_C_LOOP
1997  A0F7              ; ----------------------------------------------------------------------
1998  A0F7              ; DIR_CHECKSUM -- compute the 128-byte additive checksum of the directory buffer.
1999  A0F7              ;   In: DIRBUF_PTR -> 128-byte directory sector buffer.
2000  A0F7              ;   Out: A = 8-bit sum of the 128 bytes.
2001  A0F7              ;   Clobbers: A,C,HL.
2002  A0F7              ;   Algorithm: C=$80 count, HL=DIRBUF_PTR, A=0; loop ADD A,(HL)/INC HL/DEC C until C==0.
2003  A0F7              ;   [RE] canonical CP/M directory-checksum routine (detects media swap). [DOC CP/M 2.2 ALG]
2004  A0F7              ; ----------------------------------------------------------------------
2005  A0F7              DIR_CHECKSUM:
2006  A0F7                      ; 128 bytes = one directory sector
2007  A0F7 0E 80                LD C,$80
2008  A0F9                      ; directory sector buffer base
2009  A0F9 2A B9 A9             LD HL,(DIRBUF_PTR)
2010  A0FC AF                   XOR A
2011  A0FD              DIR_CHECKSUM_LOOP:
2012  A0FD                      ; accumulate the 8-bit additive checksum
2013  A0FD 86                   ADD A,(HL)
2014  A0FE 23                   INC HL
2015  A0FF 0D                   DEC C
2016  A100 C2 FD A0             JP NZ,DIR_CHECKSUM_LOOP
2017  A103 C9                   RET
2018  A104              ; ----------------------------------------------------------------------
2019  A104              ; SHL_HL_C -- logical-shift HL left by C bit positions.
2020  A104              ;   In: HL = value; C = shift count (0 leaves HL unchanged).
2021  A104              ;   Out: HL <<= C.
2022  A104              ;   Clobbers: C,HL (C decremented to 0).
2023  A104              ;   Algorithm: INC C / loop { DEC C; ret if zero; ADD HL,HL }.
2024  A104              ;   [RE] generic unsigned left-shift helper (e.g. building a 1<<n drive-bit mask).
2025  A104              ; ----------------------------------------------------------------------
2026  A104              SHL_HL_C:
2027  A104 0C                   INC C
2028  A105              SHL_HL_C_LOOP:
2029  A105 0D                   DEC C
2030  A106 C8                   RET Z
2031  A107                      ; one left shift of HL
2032  A107 29                   ADD HL,HL
2033  A108 C3 05 A1             JP SHL_HL_C_LOOP
2034  A10B              ; ----------------------------------------------------------------------
2035  A10B              ; DRIVE_BIT_OR_INTO_VECTOR -- OR the current drive's single-bit mask into a 16-bit vector.
2036  A10B              ;   In: BC = the existing 16-bit vector (preserved across the call); BDOS_CUR_DRIVE = current drive
2037  A10B              ;       (0-based).
2038  A10B              ;       (HL on entry is IGNORED -- it is overwritten with $0001.)
2039  A10B              ;   Out: HL = BC OR (1 << current_drive).
2040  A10B              ;   Clobbers: A,HL (BC saved/restored).
2041  A10B              ;   Algorithm: PUSH BC; C = current drive; HL = 1; CALL SHL_HL_C to form 1<<drive; POP BC;
2042  A10B              ;       L = C OR L (low byte), H = B OR H (high byte).
2043  A10B              ;   [RE] sets the current drive's bit in whatever vector the caller passes in BC (used by both the
2044  A10B              ;       R/O vector and the login vector setters).
2045  A10B              ; ----------------------------------------------------------------------
2046  A10B              DRIVE_BIT_OR_INTO_VECTOR:
2047  A10B C5                   PUSH BC
2048  A10C                      ; current drive number = bit position
2049  A10C 3A 42 9F             LD A,(BDOS_CUR_DRIVE)
2050  A10F 4F                   LD C,A
2051  A110 21 01 00             LD HL,$0001
2052  A113                      ; HL = 1 << current_drive
2053  A113 CD 04 A1             CALL SHL_HL_C
2054  A116 C1                   POP BC
2055  A117 79                   LD A,C
2056  A118                      ; low byte: OR the existing vector (C) with the new drive bit
2057  A118 B5                   OR L
2058  A119 6F                   LD L,A
2059  A11A 78                   LD A,B
2060  A11B                      ; high byte: OR the existing vector (B) with the new drive bit
2061  A11B B4                   OR H
2062  A11C 67                   LD H,A
2063  A11D C9                   RET
2064  A11E              ; ----------------------------------------------------------------------
2065  A11E              ; TEST_DRIVE_RO_BIT -- test whether the current drive's bit is set in the read-only drive vector.
2066  A11E              ;   In: the 16-bit R/O vector at $A9AD (NOTE: the var-page cell is mislabeled DRV_LOGIN_VECTOR;
2067  A11E              ;       it is the read-only vector set by the Write-Protect-Disk handler DRV_SETRO_H);
2068  A11E              ;       BDOS_CUR_DRIVE = drive.
2069  A11E              ;   Out: A = 1 if the current drive's R/O bit is set, else 0; Z reflects the result.
2070  A11E              ;   Clobbers: A,C,HL.
2071  A11E              ;   Algorithm: load the vector, SHR_HL_C by the drive number to bring its bit to bit 0, AND $01.
2072  A11E              ;   [RE] CHECK_DRIVE_READONLY (CHECK_DRIVE_READONLY) uses this and raises the R/O error when the bit is set,
2073  A11E              ;       which proves this vector is the read-only vector, not the login vector. [?] cell-name fix
2074  A11E              ;       deferred.
2075  A11E              ; ----------------------------------------------------------------------
2076  A11E              DRIVE_BIT_TEST:
2077  A11E                      ; the read-only drive vector (cell mislabeled DRV_LOGIN_VECTOR)
2078  A11E 2A AD A9             LD HL,(DRV_LOGIN_VECTOR)
2079  A121 3A 42 9F             LD A,(BDOS_CUR_DRIVE)
2080  A124 4F                   LD C,A
2081  A125                      ; shift the wanted drive's bit down to bit 0
2082  A125 CD EA A0             CALL DRV_INSTALL_RWTS_10
2083  A128 7D                   LD A,L
2084  A129                      ; isolate the current drive's R/O bit
2085  A129 E6 01                AND $01
2086  A12B C9                   RET
2087  A12C              ; ----------------------------------------------------------------------
2088  A12C              ; SET_DRIVE_READONLY -- BDOS function 28 (Write Protect Disk): set the current drive's R/O bit.
2089  A12C              ;   In: the R/O drive vector at $A9AD (cell mislabeled DRV_LOGIN_VECTOR); BDOS_CUR_DRIVE = current
2090  A12C              ;       drive;
2091  A12C              ;       DPB_REC_PTR (a directory record-count limit); DPB_WORK_PTR0 -> a 16-bit working cell.
2092  A12C              ;   Out: the R/O vector has the current drive's bit set; the word at [DPB_WORK_PTR0] = DPB_REC_PTR +
2093  A12C              ;        1.
2094  A12C              ;   Clobbers: A,BC,DE,HL.
2095  A12C              ;   Algorithm: load the R/O vector into BC, set the current-drive bit via DRIVE_BIT_OR_INTO_VECTOR,
2096  A12C              ;       store it back; then store (DPB_REC_PTR + 1) into the 16-bit cell pointed to by
2097  A12C              ;       DPB_WORK_PTR0.
2098  A12C              ;   [RE] this label is the fn-28 entry in the dispatch table at $9C7F, confirming
2099  A12C              ;   Write-Protect-Disk;
2100  A12C              ;       the existing label DRV_SETRO_H ('set read-only') agrees. [?] purpose of caching
2101  A12C              ;       DPB_REC_PTR+1 UNKNOWN.
2102  A12C              ; ----------------------------------------------------------------------
2103  A12C              DRV_SETRO_H:
2104  A12C 21 AD A9             LD HL,DRV_LOGIN_VECTOR
2105  A12F 4E                   LD C,(HL)
2106  A130 23                   INC HL
2107  A131 46                   LD B,(HL)
2108  A132                      ; set the current drive's bit in the R/O vector
2109  A132 CD 0B A1             CALL DRIVE_BIT_OR_INTO_VECTOR
2110  A135                      ; store the updated R/O vector (cell mislabeled DRV_LOGIN_VECTOR)
2111  A135 22 AD A9             LD (DRV_LOGIN_VECTOR),HL
2112  A138                      ; directory record-count limit for this drive
2113  A138 2A C8 A9             LD HL,(DPB_REC_PTR)
2114  A13B 23                   INC HL
2115  A13C EB                   EX DE,HL
2116  A13D 2A B3 A9             LD HL,(DPB_WORK_PTR0)
2117  A140 73                   LD (HL),E
2118  A141 23                   INC HL
2119  A142                      ; save (DPB_REC_PTR + 1) into the cell at [DPB_WORK_PTR0]
2120  A142 72                   LD (HL),D
2121  A143 C9                   RET
2122  A144              ; ----------------------------------------------------------------------
2123  A144              ; CHECK_DIRENT_READONLY -- raise the file-R/O error if the matched directory entry is read-only.
2124  A144              ;   In: DIRBUF_PTR / DEBLOCK_BYTE_OFF locate the matched directory entry (via
2125  A144              ;       FCB_BUF_PTR_ADD_OFFSET).
2126  A144              ;   Out: returns normally if writable; otherwise jumps to the BDOS error vector (no return).
2127  A144              ;   Clobbers: A,DE,HL.
2128  A144              ;   Algorithm: point at the entry, advance to byte +9 (the first type byte t1', whose bit 7 is the
2129  A144              ;       R/O attribute), RLA to shift bit 7 into carry; RET NC if clear, else load the file-R/O
2130  A144              ;       error vector (BDOS_ERRVEC_FILERO at $9C0F) and dispatch via BDOS_VECTOR_JUMP.
2131  A144              ;   [RE] CP/M file R/O attribute = bit 7 of directory-entry byte 9 (t1'). [DOC CP/M 2.2 FCB]
2132  A144              ; ----------------------------------------------------------------------
2133  A144              FCB_RO_FLAG_TEST:
2134  A144 CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
2135  A147              CHECK_DIRENT_READONLY_INNER:
2136  A147                      ; dir-entry filetype byte t1' (bit 7 = R/O attribute)
2137  A147 11 09 00             LD DE,DIRECTORY_ENTRY.FT
2138  A14A 19                   ADD HL,DE
2139  A14B 7E                   LD A,(HL)
2140  A14C                      ; shift attribute bit 7 into carry
2141  A14C 17                   RLA
2142  A14D                      ; carry clear: entry is writable, continue
2143  A14D D0                   RET NC
2144  A14E                      ; file-read-only error vector ($9C0F)
2145  A14E 21 0F 9C             LD HL,BDOS_ERRVEC_FILERO
2146  A151 C3 4A 9F             JP BDOS_VECTOR_JUMP
2147  A154              ; ----------------------------------------------------------------------
2148  A154              ; CHECK_DRIVE_READONLY -- raise the disk-R/O error if the current drive is write-protected.
2149  A154              ;   In: the current drive context (DRIVE_BIT_TEST reads the R/O drive vector).
2150  A154              ;   Out: returns if writable; otherwise jumps to the BDOS error vector (no return).
2151  A154              ;   Clobbers: A,C,HL.
2152  A154              ;   Algorithm: CALL DRIVE_BIT_TEST (current drive's R/O bit); RET Z if clear (writable), else load
2153  A154              ;       the disk-R/O error vector (BDOS_ERRVEC_RODISK at $9C0D) and dispatch via BDOS_VECTOR_JUMP.
2154  A154              ;   [RE] guards writes against a write-protected disk.
2155  A154              ; ----------------------------------------------------------------------
2156  A154              CHECK_DRIVE_READONLY:
2157  A154                      ; test the current drive's read-only bit
2158  A154 CD 1E A1             CALL DRIVE_BIT_TEST
2159  A157                      ; writable: nothing to raise
2160  A157 C8                   RET Z
2161  A158                      ; disk-read-only error vector ($9C0D)
2162  A158 21 0D 9C             LD HL,BDOS_ERRVEC_RODISK
2163  A15B C3 4A 9F             JP BDOS_VECTOR_JUMP
2164  A15E              ; ----------------------------------------------------------------------
2165  A15E              ; DIRENT_PTR -- compute a pointer to the matched directory entry inside the directory buffer.
2166  A15E              ;   In: DIRBUF_PTR -> directory sector buffer; DEBLOCK_BYTE_OFF = byte offset of the entry.
2167  A15E              ;   Out: HL = DIRBUF_PTR + DEBLOCK_BYTE_OFF.
2168  A15E              ;   Clobbers: A,HL.
2169  A15E              ;   Algorithm: load the buffer base, load the 8-bit entry offset, add it to L with carry into H
2170  A15E              ;              (DIRENT_PTR_ADD).
2171  A15E              ;   [RE] locates the directory entry just matched by a BDOS directory search.
2172  A15E              ; ----------------------------------------------------------------------
2173  A15E              FCB_BUF_PTR_ADD_OFFSET:
2174  A15E                      ; directory sector buffer base
2175  A15E 2A B9 A9             LD HL,(DIRBUF_PTR)
2176  A161                      ; byte offset of the matched entry within the buffer
2177  A161 3A E9 A9             LD A,(DEBLOCK_BYTE_OFF)
2178  A164              DIRENT_PTR_ADD:
2179  A164 85                   ADD A,L
2180  A165 6F                   LD L,A
2181  A166 D0                   RET NC
2182  A167 24                   INC H
2183  A168 C9                   RET
2184  A169              ; ----------------------------------------------------------------------
2185  A169              ; GET_FCB_S2_PTR -- point HL at FCB byte 14 (the S2 / extent-high field) of the current FCB.
2186  A169              ;   In: BDOS_PARAM_PTR = current FCB pointer.
2187  A169              ;   Out: HL = [BDOS_PARAM_PTR] + $000E (FCB+14, the S2 byte); A = its current value.
2188  A169              ;   Clobbers: A,DE,HL.
2189  A169              ;   Algorithm: HL = base + $0E, read (HL) into A.
2190  A169              ;   [RE] FCB byte 14 = S2 (extent-high / module count) per CP/M 2.2 FCB layout. [DOC CP/M 2.2 FCB]
2191  A169              ; ----------------------------------------------------------------------
2192  A169              FCB_GET_S2:
2193  A169 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
2194  A16C                      ; the FCB's S2 field
2195  A16C 11 0E 00             LD DE,FCB.DIRECTORY_ENTRY.S2
2196  A16F 19                   ADD HL,DE
2197  A170 7E                   LD A,(HL)
2198  A171 C9                   RET
2199  A172              ; ----------------------------------------------------------------------
2200  A172              ; CLEAR_FCB_S2 -- zero the S2 (byte 14) field of the current FCB.
2201  A172              ;   In: the current FCB (via GET_FCB_S2_PTR).
2202  A172              ;   Out: FCB byte 14 = 0.
2203  A172              ;   Clobbers: A,DE,HL.
2204  A172              ;   Algorithm: get the S2 pointer, store 0.
2205  A172              ;   [RE] resets the extent-high/S2 field. [DOC CP/M 2.2 FCB]
2206  A172              ; ----------------------------------------------------------------------
2207  A172              CLEAR_FCB_S2:
2208  A172 CD 69 A1             CALL FCB_GET_S2
2209  A175                      ; clear the FCB S2 field
2210  A175 36 00                LD (HL),$00
2211  A177 C9                   RET
2212  A178              ; ----------------------------------------------------------------------
2213  A178              ; MARK_FCB_S2_HIGHBIT -- set bit 7 of the FCB S2 (byte 14) field.
2214  A178              ;   In: the current FCB (via GET_FCB_S2_PTR, which also returns A = the current S2 value).
2215  A178              ;   Out: FCB byte 14 |= $80.
2216  A178              ;   Clobbers: A,DE,HL.
2217  A178              ;   Algorithm: get the S2 pointer (A = current S2), OR $80, store back.
2218  A178              ;   [RE] in CP/M 2.2 the high bit of S2 flags the FCB as written/needing a directory update at
2219  A178              ;   close. [DOC CP/M 2.2 FCB]
2220  A178              ; ----------------------------------------------------------------------
2221  A178              MARK_FCB_S2_HIGHBIT:
2222  A178 CD 69 A1             CALL FCB_GET_S2
2223  A17B                      ; set S2 bit 7 (the write/close flag)
2224  A17B F6 80                OR $80
2225  A17D 77                   LD (HL),A
2226  A17E C9                   RET
2227  A17F              ; ----------------------------------------------------------------------
2228  A17F              ; CMP_CURREC_VS_WORKPTR -- compare the current record number against the working record cell.
2229  A17F              ;   In: CUR_RECORD = 16-bit current record; DPB_WORK_PTR0 -> a 16-bit working record value.
2230  A17F              ;   Out: HL = address of the working value's high byte; flags = (CUR_RECORD - working value);
2231  A17F              ;        CARRY SET when CUR_RECORD < the working value (i.e. no extension needed).
2232  A17F              ;   Clobbers: A,DE,HL.
2233  A17F              ;   Algorithm: DE = CUR_RECORD, HL = (DPB_WORK_PTR0); subtract low byte (SUB), then high byte (SBC),
2234  A17F              ;       leaving HL pointing at the high byte; no value is stored.
2235  A17F              ;   [RE] RECPTR_INC_STORE uses this: on NC (CUR_RECORD >= working) it bumps and stores CUR_RECORD+1,
2236  A17F              ;       extending the high-water record count.
2237  A17F              ; ----------------------------------------------------------------------
2238  A17F              CMP_CURREC_VS_WORKPTR:
2239  A17F                      ; current logical record number
2240  A17F 2A EA A9             LD HL,(CUR_RECORD)
2241  A182 EB                   EX DE,HL
2242  A183                      ; pointer to the working record-count value
2243  A183 2A B3 A9             LD HL,(DPB_WORK_PTR0)
2244  A186 7B                   LD A,E
2245  A187 96                   SUB (HL)
2246  A188 23                   INC HL
2247  A189 7A                   LD A,D
2248  A18A                      ; 16-bit compare; carry => current record is BELOW the stored value
2249  A18A 9E                   SBC A,(HL)
2250  A18B C9                   RET
2251  A18C              ; ----------------------------------------------------------------------
2252  A18C              ; RECPTR_INC_STORE -- If the current record is at or past the stored high-water count, bump the
2253  A18C              ; count to one past it.
2254  A18C              ;   In: CUR_RECORD = the record number just processed; DPB_WORK_PTR0 holds a pointer to a 16-bit
2255  A18C              ;       record-count cell.
2256  A18C              ;   Out: If CUR_RECORD >= (count cell), the cell is set to CUR_RECORD+1. Otherwise unchanged. DE =
2257  A18C              ;        CUR_RECORD (then +1 if updated); HL left pointing into the count cell.
2258  A18C              ;   Clobbers: A, DE, HL, flags.
2259  A18C              ;   Algorithm: Call CMP_CURREC_VS_WORKPTR, which computes CUR_RECORD - (count cell) and leaves DE =
2260  A18C              ;              CUR_RECORD, HL -> the cell's high byte. RET C (carry = borrow = CUR_RECORD < count,
2261  A18C              ;              so the stored count is already larger -> leave it). Otherwise DE := CUR_RECORD+1 and
2262  A18C              ;              write it back HIGH byte first (LD (HL),D), DEC HL, then LOW byte (LD (HL),E).
2263  A18C              ;   [RE] Classic CP/M 2.2 BDOS extent record-count bump; keeps the FCB's high-water record one past
2264  A18C              ;   the last accessed.
2265  A18C              ; ----------------------------------------------------------------------
2266  A18C              RECPTR_INC_STORE:
2267  A18C                      ; compute CUR_RECORD - (count cell); carry => CUR_RECORD below the stored count; leaves HL
2268  A18C                      ; -> cell high byte, DE = CUR_RECORD
2269  A18C CD 7F A1             CALL CMP_CURREC_VS_WORKPTR
2270  A18F                      ; CUR_RECORD < stored count -- count is already ahead, nothing to advance
2271  A18F D8                   RET C
2272  A190                      ; DE = CUR_RECORD + 1 (one past the record just used)
2273  A190 13                   INC DE
2274  A191                      ; HL points at the count cell high byte (left there by CMP_CURREC_VS_WORKPTR); write new
2275  A191                      ; high byte
2276  A191 72                   LD (HL),D
2277  A192                      ; step back to the count cell low byte
2278  A192 2B                   DEC HL
2279  A193                      ; write new count low byte
2280  A193 73                   LD (HL),E
2281  A194 C9                   RET
2282  A195              ; ----------------------------------------------------------------------
2283  A195              ; SUB16_DE_HL -- 16-bit subtract HL := DE - HL.
2284  A195              ;   In: DE = minuend, HL = subtrahend.
2285  A195              ;   Out: HL = DE - HL; carry set on borrow (DE < HL unsigned). A holds the high-byte result.
2286  A195              ;   Clobbers: A, HL, flags. DE preserved.
2287  A195              ;   Algorithm: Subtract low bytes (E - L) -> L, then high bytes with borrow (D - H) -> H.
2288  A195              ;   [RE] General BDOS 16-bit compare/difference helper used by the record scan and seek logic.
2289  A195              ; ----------------------------------------------------------------------
2290  A195              SUB16_DE_HL:
2291  A195 7B                   LD A,E
2292  A196                      ; low byte: E - L
2293  A196 95                   SUB L
2294  A197                      ; store low result
2295  A197 6F                   LD L,A
2296  A198 7A                   LD A,D
2297  A199                      ; high byte: D - H with borrow; carry out = unsigned borrow
2298  A199 9C                   SBC A,H
2299  A19A                      ; store high result; HL = DE - HL
2300  A19A 67                   LD H,A
2301  A19B C9                   RET
2302  A19C              ; ----------------------------------------------------------------------
2303  A19C              ; RECORD_SCAN_INIT -- Enter the directory-record scan in store mode (write A into the located byte
2304  A19C              ; rather than compare it).
2305  A19C              ;   In: see RECORD_SCAN_BODY.
2306  A19C              ;   Out: see RECORD_SCAN_BODY.
2307  A19C              ;   Clobbers: A, BC, DE, HL, flags.
2308  A19C              ;   Algorithm: Set C = $FF so the INC C inside RECORD_SCAN_BODY wraps to 0 (Z) and takes the store
2309  A19C              ;              branch (FCB_STORE_A_ORPHAN), then fall through into RECORD_SCAN_BODY.
2310  A19C              ;   [RE] Thin mode-selecting entry to the shared directory-record scan.
2311  A19C              ; ----------------------------------------------------------------------
2312  A19C              RECORD_SCAN_INIT:
2313  A19C                      ; C=$FF -> INC C in scan body wraps to 0 (Z) -> take the store branch
2314  A19C 0E FF                LD C,$FF
2315  A19E              ; ----------------------------------------------------------------------
2316  A19E              ; RECORD_SCAN_BODY -- Scan to the target byte in the cached directory record, then either store A
2317  A19E              ; there or compare A against it.
2318  A19E              ;   In: C = mode (INC C wraps to 0 => store mode, else compare mode); REC_CACHE = cached record
2319  A19E              ;       cursor; REC_SCAN_PTR = scan limit; REC_BYTE_OFFSET = byte offset within the record; A = byte
2320  A19E              ;       to store/compare; DIRBUF (via DIRBUF_PTR) holds the loaded directory record.
2321  A19E              ;   Out: store mode writes A and returns via FCB_STORE_A_ORPHAN. Compare mode: returns Z on a match;
2322  A19E              ;        if no match and CUR_RECORD is past the stored count it flags the drive read-only
2323  A19E              ;        (DRV_SETRO_H). If REC_CACHE - REC_SCAN_PTR did not borrow, returns NC (nothing to do).
2324  A19E              ;   Clobbers: A, BC, DE, HL, flags.
2325  A19E              ;   Algorithm: DE := REC_CACHE, HL := REC_SCAN_PTR; SUB16_DE_HL (HL = REC_CACHE - REC_SCAN_PTR); RET
2326  A19E              ;              NC if no borrow. Else checksum the directory buffer (DIR_CHECKSUM), add REC_BYTE_OFFSET
2327  A19E              ;              to REC_CACHE to address the target byte. INC C: if it wrapped to 0, store A there.
2328  A19E              ;              Otherwise CP (HL); RET Z on match. On mismatch CMP_CURREC_VS_WORKPTR; RET NC if
2329  A19E              ;              within the record count, else DRV_SETRO_H.
2330  A19E              ;   [RE] Heart of the directory record scan/checksum loop in the BDOS deblocking layer.
2331  A19E              ; ----------------------------------------------------------------------
2332  A19E              RECORD_SCAN_BODY:
2333  A19E                      ; DE := cached record cursor (after the following EX DE,HL)
2334  A19E 2A EC A9             LD HL,(REC_CACHE)
2335  A1A1 EB                   EX DE,HL
2336  A1A2                      ; HL := scan limit pointer
2337  A1A2 2A CC A9             LD HL,(REC_SCAN_PTR)
2338  A1A5                      ; HL = REC_CACHE - REC_SCAN_PTR; carry (borrow) => still in range
2339  A1A5 CD 95 A1             CALL SUB16_DE_HL
2340  A1A8                      ; no borrow (cursor at/past limit) -> return, caller sees not-found
2341  A1A8 D0                   RET NC
2342  A1A9 C5                   PUSH BC
2343  A1AA                      ; sum the 128-byte directory buffer (DIRBUF) -- the change-detect checksum
2344  A1AA CD F7 A0             CALL DIR_CHECKSUM
2345  A1AD                      ; DE := byte offset within the record (after the following EX DE,HL)
2346  A1AD 2A BD A9             LD HL,(REC_BYTE_OFFSET)
2347  A1B0 EB                   EX DE,HL
2348  A1B1 2A EC A9             LD HL,(REC_CACHE)
2349  A1B4                      ; HL -> the target byte inside the cached record
2350  A1B4 19                   ADD HL,DE
2351  A1B5 C1                   POP BC
2352  A1B6                      ; advance mode; if it wraps to 0 this is store mode
2353  A1B6 0C                   INC C
2354  A1B7                      ; store mode: write A into the directory byte and return
2355  A1B7 CA C4 A1             JP Z,FCB_STORE_A_ORPHAN
2356  A1BA                      ; compare mode: compare A with the directory byte
2357  A1BA BE                   CP (HL)
2358  A1BB                      ; match found -> return Z
2359  A1BB C8                   RET Z
2360  A1BC                      ; no match: is CUR_RECORD within the stored record count?
2361  A1BC CD 7F A1             CALL CMP_CURREC_VS_WORKPTR
2362  A1BF                      ; within the record count -> just return
2363  A1BF D0                   RET NC
2364  A1C0                      ; past end with a mismatch -> set the drive read-only (protect)
2365  A1C0 CD 2C A1             CALL DRV_SETRO_H
2366  A1C3 C9                   RET
2367  A1C4              ; ----------------------------------------------------------------------
2368  A1C4              ; FCB_STORE_A_ORPHAN -- Store the accumulator into the directory byte addressed by HL (scan
2369  A1C4              ; store-mode tail).
2370  A1C4              ;   In: HL -> target directory byte; A = value to store.
2371  A1C4              ;   Out: (HL) = A.
2372  A1C4              ;   Clobbers: nothing (memory only).
2373  A1C4              ;   Algorithm: LD (HL),A; RET.
2374  A1C4              ;   [RE] Store-mode terminator branched to from RECORD_SCAN_BODY when INC C wrapped to 0.
2375  A1C4              ; ----------------------------------------------------------------------
2376  A1C4              FCB_STORE_A_ORPHAN:
2377  A1C4                      ; write the byte into the directory record
2378  A1C4 77                   LD (HL),A
2379  A1C5 C9                   RET
2380  A1C6              ; ----------------------------------------------------------------------
2381  A1C6              ; DIR_RECORD_WRITE -- Checksum-verify then write the directory buffer to disk as a record, and
2382  A1C6              ; refresh the user buffer.
2383  A1C6              ;   In: directory buffer (DIRBUF) and the BDOS deblock state set up by the caller.
2384  A1C6              ;   Out: the record is written to disk (with the R/O-on-tamper check); user DMA restored; errors
2385  A1C6              ;        raised via DISK_WRITE_CHECKED.
2386  A1C6              ;   Clobbers: A, BC, DE, HL, flags.
2387  A1C6              ;   Algorithm: RECORD_SCAN_INIT runs the scan in store mode (re-checksums the directory buffer and
2388  A1C6              ;              sets the drive R/O on a tamper mismatch). SET_DMA_TO_DISK_BUF aims the BIOS DMA at
2389  A1C6              ;              DIRBUF; C=1 selects the directory write type; DISK_WRITE_CHECKED issues the BIOS
2390  A1C6              ;              WRITE and raises on error; JP RESTORE_USER_DMA restores the user DMA.
2391  A1C6              ;   [RE] Directory-record write path; C=1 is the CP/M deblock directory-write code (BIOS WRITE
2392  A1C6              ;   vector $AA2A).
2393  A1C6              ; ----------------------------------------------------------------------
2394  A1C6              DIR_RECORD_WRITE:
2395  A1C6                      ; re-checksum the directory buffer / set R/O on a tamper mismatch before writing
2396  A1C6 CD 9C A1             CALL RECORD_SCAN_INIT
2397  A1C9                      ; point BIOS DMA at the directory buffer (DIRBUF)
2398  A1C9 CD E0 A1             CALL SET_DMA_TO_DISK_BUF
2399  A1CC                      ; deblock write type 1 = directory write
2400  A1CC 0E 01                LD C,$01
2401  A1CE                      ; BIOS sector WRITE ($AA2A) + raise on error
2402  A1CE CD B8 9F             CALL DISK_WRITE_CHECKED
2403  A1D1                      ; restore the user DMA address and return
2404  A1D1 C3 DA A1             JP RESTORE_USER_DMA
2405  A1D4              ; ----------------------------------------------------------------------
2406  A1D4              ; DIR_RECORD_READ -- Read a directory record from disk into the directory buffer, then restore the
2407  A1D4              ; user DMA.
2408  A1D4              ;   In: BDOS deblock state set up by the caller.
2409  A1D4              ;   Out: DIRBUF filled from disk; user DMA restored; errors raised via DISK_READ_CHECKED.
2410  A1D4              ;   Clobbers: A, BC, DE, HL, flags.
2411  A1D4              ;   Algorithm: SET_DMA_TO_DISK_BUF (aim BIOS DMA at DIRBUF), DISK_READ_CHECKED (BIOS READ vector
2412  A1D4              ;              $AA27 + error check), then fall through into RESTORE_USER_DMA to restore the user DMA
2413  A1D4              ;              address.
2414  A1D4              ;   [RE] Directory-record read path; pairs with DIR_RECORD_WRITE.
2415  A1D4              ; ----------------------------------------------------------------------
2416  A1D4              DIR_RECORD_READ:
2417  A1D4                      ; point BIOS DMA at the directory buffer (DIRBUF)
2418  A1D4 CD E0 A1             CALL SET_DMA_TO_DISK_BUF
2419  A1D7                      ; BIOS sector READ ($AA27) + raise on error
2420  A1D7 CD B2 9F             CALL DISK_READ_CHECKED
2421  A1DA              ; ----------------------------------------------------------------------
2422  A1DA              ; RESTORE_USER_DMA -- Restore the BIOS DMA address to the user's DMA buffer.
2423  A1DA              ;   In: DMA_ADDR cell holds the user DMA address.
2424  A1DA              ;   Out: BIOS DMA set to (DMA_ADDR) via the BIOS SETDMA vector.
2425  A1DA              ;   Clobbers: BC, HL, flags.
2426  A1DA              ;   Algorithm: HL := address of the DMA_ADDR cell, then JP SET_DMA_FROM_CELL which loads BC from the
2427  A1DA              ;              cell and jumps to the BIOS SETDMA vector ($AA24).
2428  A1DA              ;   [RE] Used after directory I/O to put DMA back to the application buffer.
2429  A1DA              ; ----------------------------------------------------------------------
2430  A1DA              RESTORE_USER_DMA:
2431  A1DA                      ; HL -> the saved user DMA address cell
2432  A1DA 21 B1 A9             LD HL,DMA_ADDR
2433  A1DD                      ; load BC from the cell and call BIOS SETDMA
2434  A1DD C3 E3 A1             JP SET_DMA_FROM_CELL
2435  A1E0              ; ----------------------------------------------------------------------
2436  A1E0              ; SET_DMA_TO_DISK_BUF -- Point the BIOS DMA at the directory/disk buffer (DIRBUF).
2437  A1E0              ;   In: DIRBUF_PTR cell holds the directory buffer address.
2438  A1E0              ;   Out: BIOS DMA set to (DIRBUF_PTR) via the BIOS SETDMA vector.
2439  A1E0              ;   Clobbers: BC, HL, flags.
2440  A1E0              ;   Algorithm: HL := address of the DIRBUF_PTR cell, fall into SET_DMA_FROM_CELL: load BC from (HL)
2441  A1E0              ;              and jump to the BIOS SETDMA vector ($AA24).
2442  A1E0              ;   [RE] Companion to RESTORE_USER_DMA; aims I/O at the OS directory buffer.
2443  A1E0              ; ----------------------------------------------------------------------
2444  A1E0              SET_DMA_TO_DISK_BUF:
2445  A1E0                      ; HL -> the directory buffer pointer cell
2446  A1E0 21 B9 A9             LD HL,DIRBUF_PTR
2447  A1E3              ; ----------------------------------------------------------------------
2448  A1E3              ; SET_DMA_FROM_CELL -- Load a DMA address from a 16-bit cell and hand it to the BIOS SETDMA vector.
2449  A1E3              ;   In: HL -> a 2-byte little-endian DMA address cell.
2450  A1E3              ;   Out: BIOS DMA set to (HL); tail-jumps into the BIOS SETDMA jump vector at $AA24.
2451  A1E3              ;   Clobbers: BC, HL.
2452  A1E3              ;   Algorithm: C := (HL), INC HL, B := (HL) so BC = the 16-bit address; JP $AA24 (BIOS SETDMA entry
2453  A1E3              ;              in the BDOS->BIOS jump-vector page).
2454  A1E3              ;   [RE] Shared tail of SET_DMA_TO_DISK_BUF and RESTORE_USER_DMA. $AA24 is the BIOS SETDMA jump cell
2455  A1E3              ;   (13th jump-table entry).
2456  A1E3              ; ----------------------------------------------------------------------
2457  A1E3              SET_DMA_FROM_CELL:
2458  A1E3                      ; BC low byte := DMA address low from the cell
2459  A1E3 4E                   LD C,(HL)
2460  A1E4 23                   INC HL
2461  A1E5                      ; BC high byte := DMA address high (HL advanced by the preceding INC HL)
2462  A1E5 46                   LD B,(HL)
2463  A1E6                      ; tail-jump to the BIOS SETDMA jump vector
2464  A1E6 C3 24 AA             JP $AA24+OS_RELOC
2465  A1E9              ; ----------------------------------------------------------------------
2466  A1E9              ; DISK_BUF_MOVE -- Copy the 128-byte directory buffer into the user DMA buffer.
2467  A1E9              ;   In: DIRBUF_PTR -> source (directory buffer); DMA_ADDR -> destination (user DMA).
2468  A1E9              ;   Out: 128 bytes copied DIRBUF -> user DMA.
2469  A1E9              ;   Clobbers: A, BC, DE, HL, flags.
2470  A1E9              ;   Algorithm: DE := (DIRBUF_PTR) source, HL := (DMA_ADDR) destination, C := $80 (128), JP
2471  A1E9              ;              BLOCK_COPY_INCC (the byte-copy loop moving C bytes from DE to HL).
2472  A1E9              ;   [RE] Deblock read-back: surfaces a directory-sector record to the application buffer.
2473  A1E9              ; ----------------------------------------------------------------------
2474  A1E9              DISK_BUF_MOVE:
2475  A1E9                      ; DE := directory buffer source (after the following EX DE,HL)
2476  A1E9 2A B9 A9             LD HL,(DIRBUF_PTR)
2477  A1EC EB                   EX DE,HL
2478  A1ED                      ; HL := user DMA buffer (copy destination)
2479  A1ED 2A B1 A9             LD HL,(DMA_ADDR)
2480  A1F0                      ; 128 bytes = one CP/M record
2481  A1F0 0E 80                LD C,$80
2482  A1F2                      ; tail-call the C-byte memory copy loop (DE->HL)
2483  A1F2 C3 4F 9F             JP BLOCK_COPY_INCC
2484  A1F5              ; ----------------------------------------------------------------------
2485  A1F5              ; CUR_RECORD_BYTES_EQUAL -- Test whether the low and high bytes of the 16-bit CUR_RECORD cell are
2486  A1F5              ; equal.
2487  A1F5              ;   In: CUR_RECORD = a 16-bit cell ($A9EA low, $A9EB high).
2488  A1F5              ;   Out: If the two bytes differ, returns NZ with A = the low byte unchanged. If they are equal,
2489  A1F5              ;        returns A = low byte + 1 (and Z cleared by the INC).
2490  A1F5              ;   Clobbers: A, HL, flags.
2491  A1F5              ;   Algorithm: HL -> CUR_RECORD low byte; A := (HL); INC HL (-> high byte); CP (HL); RET NZ if they
2492  A1F5              ;              differ; else INC A and RET.
2493  A1F5              ;   [RE] Deblock helper that compares the two halves of CUR_RECORD; called widely across the BDOS
2494  A1F5              ;   read/write deblock paths. The exact role of the equal/INC result is UNKNOWN from these bytes
2495  A1F5              ;   alone (the callers consume A/the Z flag).
2496  A1F5              ; ----------------------------------------------------------------------
2497  A1F5              CUR_RECORD_BYTES_EQUAL:
2498  A1F5                      ; HL -> CUR_RECORD low byte ($A9EA)
2499  A1F5 21 EA A9             LD HL,CUR_RECORD
2500  A1F8                      ; A := CUR_RECORD low byte
2501  A1F8 7E                   LD A,(HL)
2502  A1F9 23                   INC HL
2503  A1FA                      ; compare low byte against the high byte (HL advanced by the preceding INC HL)
2504  A1FA BE                   CP (HL)
2505  A1FB                      ; bytes differ -> return NZ, A = low byte
2506  A1FB C0                   RET NZ
2507  A1FC                      ; bytes equal -> A = low byte + 1 (also clears Z)
2508  A1FC 3C                   INC A
2509  A1FD C9                   RET
2510  A1FE              ; ----------------------------------------------------------------------
2511  A1FE              ; INVALIDATE_CUR_RECORD -- Mark the cached record pointer invalid (CUR_RECORD := $FFFF).
2512  A1FE              ;   In: none.
2513  A1FE              ;   Out: CUR_RECORD cell = $FFFF.
2514  A1FE              ;   Clobbers: HL.
2515  A1FE              ;   Algorithm: HL := $FFFF; store to CUR_RECORD; RET.
2516  A1FE              ;   [RE] Forces the next deblock access to reload, since $FFFF can never equal a real record number.
2517  A1FE              ; ----------------------------------------------------------------------
2518  A1FE              INVALIDATE_CUR_RECORD:
2519  A1FE                      ; sentinel: no record cached
2520  A1FE 21 FF FF             LD HL,$FFFF
2521  A201                      ; invalidate the cached current-record value
2522  A201 22 EA A9             LD (CUR_RECORD),HL
2523  A204 C9                   RET
2524  A205              ; ----------------------------------------------------------------------
2525  A205              ; DIR_READ_NEXT -- Advance the directory record pointer and read the next directory record.
2526  A205              ;   In: CUR_RECORD = last directory record index processed; DPB_REC_PTR = total directory records on
2527  A205              ;       this drive.
2528  A205              ;   Out: CY/A set per DIR_RECORD_DEBLOCK if a record remains; CUR_RECORD invalidated ($FFFF) when
2529  A205              ;        the directory is exhausted.
2530  A205              ;   Clobbers: A, DE, HL, flags.
2531  A205              ;   Algorithm: increment CUR_RECORD; if it has not passed the directory record count (DPB_REC_PTR)
2532  A205              ;              fall through to DIR_RECORD_DEBLOCK to position on the next 32-byte entry, else mark
2533  A205              ;              end-of-directory via DIR_INVALIDATE_RECORD.
2534  A205              ; [RE] Canonical CP/M 2.2 BDOS read-next-directory-entry sequencer.
2535  A205              ; ----------------------------------------------------------------------
2536  A205              DIR_READ_NEXT:
2537  A205                      ; DE = number of directory records on the selected drive (from the DPB).
2538  A205 2A C8 A9             LD HL,(DPB_REC_PTR)
2539  A208 EB                   EX DE,HL
2540  A209 2A EA A9             LD HL,(CUR_RECORD)
2541  A20C                      ; Step to the next directory record index.
2542  A20C 23                   INC HL
2543  A20D 22 EA A9             LD (CUR_RECORD),HL
2544  A210                      ; Compare CUR_RECORD against the directory record count.
2545  A210 CD 95 A1             CALL SUB16_DE_HL
2546  A213                      ; Records remain: deblock and read the next directory record.
2547  A213 D2 19 A2             JP NC,DIR_RECORD_DEBLOCK
2548  A216                      ; Directory exhausted: invalidate CUR_RECORD and return end-of-directory.
2549  A216 C3 FE A1             JP INVALIDATE_CUR_RECORD
2550  A219              ; ----------------------------------------------------------------------
2551  A219              ; DIR_RECORD_DEBLOCK -- Position on the current 32-byte directory entry within its 128-byte record,
2552  A219              ; reading the record from disk on a record boundary.
2553  A219              ;   In: CUR_RECORD = current directory record index.
2554  A219              ;   Out: DEBLOCK_BYTE_OFF = byte offset (0/32/64/96) of this entry inside the directory buffer; on a
2555  A219              ;        fresh record the directory record has been read into the disk buffer.
2556  A219              ;   Clobbers: A, BC, DE, HL, flags.
2557  A219              ;   Algorithm: entries-per-record offset = (CUR_RECORD & 3) << 5; store it; if the offset is
2558  A219              ;              non-zero the entry is already in the buffer so return; on a record boundary (offset
2559  A219              ;              0) compute the absolute disk record and read it into the directory buffer.
2560  A219              ; [RE] CP/M packs four 32-byte directory entries per 128-byte record; this is the BDOS deblocking
2561  A219              ; step.
2562  A219              ; ----------------------------------------------------------------------
2563  A219              DIR_RECORD_DEBLOCK:
2564  A219 3A EA A9             LD A,(CUR_RECORD)
2565  A21C                      ; Index of this entry within its 4-entry directory record.
2566  A21C E6 03                AND $03
2567  A21E                      ; Shift count: multiply by 32 to get the byte offset of the entry.
2568  A21E 06 05                LD B,$05
2569  A220              DIR_DEBLOCK_SHIFT:
2570  A220 87                   ADD A,A
2571  A221 05                   DEC B
2572  A222 C2 20 A2             JP NZ,DIR_DEBLOCK_SHIFT
2573  A225                      ; Byte offset (0/32/64/96) of this entry within the 128-byte directory buffer.
2574  A225 32 E9 A9             LD (DEBLOCK_BYTE_OFF),A
2575  A228 B7                   OR A
2576  A229                      ; Entry not on a record boundary: the record is already buffered, done.
2577  A229 C0                   RET NZ
2578  A22A C5                   PUSH BC
2579  A22B                      ; Resolve the directory record's physical disk location (block/record math).
2580  A22B CD C3 9F             CALL REC_DIV4_SETUP
2581  A22E                      ; Read the directory record into the disk buffer.
2582  A22E CD D4 A1             CALL DIR_RECORD_READ
2583  A231 C1                   POP BC
2584  A232                      ; Re-evaluate the record-scan state after the read.
2585  A232 C3 9E A1             JP RECORD_SCAN_BODY
2586  A235              ; ----------------------------------------------------------------------
2587  A235              ; ALLOC_BIT_GET -- Fetch the allocation-vector bit for a given disk block, returning it in carry.
2588  A235              ;   In: BC = block (group) number.
2589  A235              ;   Out: carry/high bit of A = current allocation state of that block; A = the allocation byte
2590  A235              ;        rotated so the wanted bit is in the MSB; HL = address of that byte in the allocation
2591  A235              ;        vector; D = E = bit index (rotate count).
2592  A235              ;   Clobbers: A, BC, DE, HL, flags.
2593  A235              ;   Algorithm: D=E=(block & 7)+1 = bit index (1-based) used as a rotate count; byte index = block >>
2594  A235              ;              3; add to ALLOC_VEC_PTR; load the byte and rotate left by the bit index so the
2595  A235              ;              selected bit ends up in carry/MSB.
2596  A235              ; [RE] Canonical CP/M 2.2 getmod: read one allocation bit from the bit-vector.
2597  A235              ; ----------------------------------------------------------------------
2598  A235              ALLOC_BIT_GET:
2599  A235 79                   LD A,C
2600  A236                      ; Low 3 bits = bit position of the block within its allocation byte.
2601  A236 E6 07                AND $07
2602  A238                      ; 1-based rotate count to bring the wanted bit into the MSB.
2603  A238 3C                   INC A
2604  A239                      ; Save the bit index in both D and E (E consumed here; D consumed by ALLOC_BIT_WRITE on the
2605  A239                      ; way back).
2606  A239 5F                   LD E,A
2607  A23A 57                   LD D,A
2608  A23B 79                   LD A,C
2609  A23C 0F                   RRCA
2610  A23D 0F                   RRCA
2611  A23E 0F                   RRCA
2612  A23F                      ; Form the byte index (block >> 3), low half of the 16-bit offset.
2613  A23F E6 1F                AND $1F
2614  A241 4F                   LD C,A
2615  A242 78                   LD A,B
2616  A243 87                   ADD A,A
2617  A244 87                   ADD A,A
2618  A245 87                   ADD A,A
2619  A246 87                   ADD A,A
2620  A247 87                   ADD A,A
2621  A248                      ; Combine high/low pieces of the (block>>3) byte offset.
2622  A248 B1                   OR C
2623  A249 4F                   LD C,A
2624  A24A 78                   LD A,B
2625  A24B 0F                   RRCA
2626  A24C 0F                   RRCA
2627  A24D 0F                   RRCA
2628  A24E E6 1F                AND $1F
2629  A250 47                   LD B,A
2630  A251                      ; Base of the in-memory allocation bit-vector for this drive.
2631  A251 2A BF A9             LD HL,(ALLOC_VEC_PTR)
2632  A254                      ; HL -> the allocation byte holding this block's bit.
2633  A254 09                   ADD HL,BC
2634  A255                      ; Load that allocation byte.
2635  A255 7E                   LD A,(HL)
2636  A256              ALLOC_BIT_ROTATE:
2637  A256 07                   RLCA
2638  A257 1D                   DEC E
2639  A258 C2 56 A2             JP NZ,ALLOC_BIT_ROTATE
2640  A25B C9                   RET
2641  A25C              ; ----------------------------------------------------------------------
2642  A25C              ; ALLOC_BIT_WRITE -- write one block's allocation-vector bit to a caller-supplied value.
2643  A25C              ;   In: BC = block (group) number; E = the bit value to store (1 = in use, 0 = free).
2644  A25C              ;   Out: that block's bit in the allocation vector is set to E. Clobbers: A,BC,DE,HL,flags.
2645  A25C              ;   Algorithm: PUSH DE saves the caller's value FIRST, because ALLOC_BIT_GET overwrites both
2646  A25C              ;       D and E with the bit index. ALLOC_BIT_GET returns the byte left-rotated so the target
2647  A25C              ;       bit is the LSB, HL pointing at it, and D = the rotate count. AND $FE clears that bit,
2648  A25C              ;       POP BC recovers the saved pair so C is the caller's value, and OR C writes it in;
2649  A25C              ;       ALLOC_BIT_RESTORE rotates back D times and stores.
2650  A25C              ;   The bit is NOT forced to 1 -- this is the one primitive for both directions, and which
2651  A25C              ;   direction it performs is entirely the caller's C. An earlier annotation here read "OR in 1
2652  A25C              ;   to set the target bit", which made the delete path look like it contradicted its own
2653  A25C              ;   comment. It does not: F_DELETE passes C=0 and frees, ALLOC_VECTOR_BUILD passes C=1. [RE]
2654  A25C              ; ----------------------------------------------------------------------
2655  A25C              ALLOC_BIT_WRITE:
2656  A25C D5                   PUSH DE
2657  A25D                      ; Read the allocation byte rotated so the target bit is in the MSB (D = bit index).
2658  A25D CD 35 A2             CALL ALLOC_BIT_GET
2659  A260                      ; Clear the target bit; the OR C below writes the caller's value into it.
2660  A260 E6 FE                AND $FE
2661  A262                      ; Recover the caller's DE (pushed before ALLOC_BIT_GET clobbered it): C = the value.
2662  A262 C1                   POP BC
2663  A263                      ; Write the caller's value (1 = in use, 0 = free) into the target bit.
2664  A263 B1                   OR C
2665  A264              ALLOC_BIT_RESTORE:
2666  A264 0F                   RRCA
2667  A265 15                   DEC D
2668  A266 C2 64 A2             JP NZ,ALLOC_BIT_RESTORE
2669  A269                      ; Store the updated allocation byte back into the bit-vector.
2670  A269 77                   LD (HL),A
2671  A26A C9                   RET
2672  A26B              ; ----------------------------------------------------------------------
2673  A26B              ; ALLOC_FROM_FCB -- apply a directory entry's block map to the allocation vector.
2674  A26B              ;   In: C = the bit value to write for each block (1 = in use, 0 = free); it is stashed by
2675  A26B              ;       PUSH BC and recirculated through DE each iteration, reaching ALLOC_BIT_WRITE in E.
2676  A26B              ;       In: DEBLOCK_BYTE_OFF positions HL on the current 32-byte directory entry; BLOCK_WIDTH_FLAG
2677  A26B              ;       selects 8-bit (non-zero, DSM<256) vs 16-bit (zero) block numbers; entry contains a 16-byte
2678  A26B              ;       block-pointer map at offset $10.
2679  A26B              ;   Out: every non-zero, in-range block of this entry has its allocation bit set to the
2680  A26B              ;        CALLER'S value -- C=1 marks them in use (directory rebuild), C=0 frees them
2681  A26B              ;        (F_DELETE). The routine itself is direction-agnostic. Clobbers: A,BC,DE,HL,flags.
2682  A26B              ;   Algorithm: point HL at the block map (entry+$10); iterate 16 (8-bit) or 8 (16-bit) pointers;
2683  A26B              ;              read each block number; if non-zero and <= MAX_BLOCK_DSM, mark it allocated via
2684  A26B              ;              ALLOC_BIT_WRITE.
2685  A26B              ; [RE] Canonical CP/M 2.2 directory-entry allocation-map application used when rebuilding the
2686  A26B              ; allocation vector.
2687  A26B              ; ----------------------------------------------------------------------
2688  A26B              ALLOC_FROM_FCB:
2689  A26B                      ; HL -> start of the current 32-byte directory entry in the buffer.
2690  A26B CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
2691  A26E                      ; Skip to the 16-byte block map. NOTE the structure here is a DIRECTORY ENTRY read
2692  A26E                      ; into DIRBUF, not a user FCB -- the routine's name is a misnomer, which is why this
2693  A26E                      ; uses DIRENT and not FCB.DIRENT.
2694  A26E 11 10 00             LD DE,DIRECTORY_ENTRY.AL
2695  A271 19                   ADD HL,DE
2696  A272 C5                   PUSH BC
2697  A273                      ; Loop counter: 16 block pointers plus one (decremented before each iteration).
2698  A273 0E 11                LD C,$11
2699  A275              ALLOC_FROM_FCB_LOOP:
2700  A275 D1                   POP DE
2701  A276 0D                   DEC C
2702  A277 C8                   RET Z
2703  A278 D5                   PUSH DE
2704  A279                      ; Non-zero => 8-bit block numbers (DSM<256); zero => 16-bit block numbers.
2705  A279 3A DD A9             LD A,(BLOCK_WIDTH_FLAG)
2706  A27C B7                   OR A
2707  A27D CA 88 A2             JP Z,ALLOC_FROM_FCB_WIDE
2708  A280 C5                   PUSH BC
2709  A281 E5                   PUSH HL
2710  A282                      ; Read one block-pointer byte (low byte of the block number; 8-bit path).
2711  A282 4E                   LD C,(HL)
2712  A283 06 00                LD B,$00
2713  A285 C3 8E A2             JP ALLOC_FROM_FCB_CHECK
2714  A288              ALLOC_FROM_FCB_WIDE:
2715  A288 0D                   DEC C
2716  A289 C5                   PUSH BC
2717  A28A 4E                   LD C,(HL)
2718  A28B 23                   INC HL
2719  A28C 46                   LD B,(HL)
2720  A28D E5                   PUSH HL
2721  A28E              ALLOC_FROM_FCB_CHECK:
2722  A28E 79                   LD A,C
2723  A28F B0                   OR B
2724  A290 CA 9D A2             JP Z,ALLOC_FROM_FCB_NEXT
2725  A293                      ; DSM = highest valid block number for this drive.
2726  A293 2A C6 A9             LD HL,(MAX_BLOCK_DSM)
2727  A296 7D                   LD A,L
2728  A297                      ; Range-check the block number against DSM (16-bit subtract: LD A,L/SUB C then LD A,H/SBC
2729  A297                      ; A,B).
2730  A297 91                   SUB C
2731  A298 7C                   LD A,H
2732  A299 98                   SBC A,B
2733  A29A                      ; In range and non-zero: write this block's bit (E = the caller's value).
2734  A29A D4 5C A2             CALL NC,ALLOC_BIT_WRITE
2735  A29D              ALLOC_FROM_FCB_NEXT:
2736  A29D E1                   POP HL
2737  A29E 23                   INC HL
2738  A29F C1                   POP BC
2739  A2A0 C3 75 A2             JP ALLOC_FROM_FCB_LOOP
2740  A2A3              ; ----------------------------------------------------------------------
2741  A2A3              ; ALLOC_VECTOR_BUILD -- Rebuild the drive's allocation bit-vector by scanning the entire directory.
2742  A2A3              ;   In: selected drive's DPB fields (MAX_BLOCK_DSM, directory-reserved-blocks word at ALLOC_END_PTR,
2743  A2A3              ;       ALLOC_VEC_PTR) set up.
2744  A2A3              ;   Out: allocation vector fully populated: reserved directory blocks plus every block referenced by
2745  A2A3              ;        a non-deleted directory entry are marked used.
2746  A2A3              ;   Clobbers: A, BC, DE, HL, flags.
2747  A2A3              ;   Algorithm: zero the allocation vector across its whole length ((DSM+1)/8 bytes); seed the
2748  A2A3              ;              directory's reserved blocks; reset the scan workspace to read the directory from the
2749  A2A3              ;              start; for each directory entry skip deleted ($E5) entries, run the '$' SUBMIT probe
2750  A2A3              ;              against the BDOS default-FCB byte / '$' name byte, and call ALLOC_FROM_FCB to mark
2751  A2A3              ;              its blocks; advance to the next entry until the directory is exhausted.
2752  A2A3              ; [RE] Canonical CP/M 2.2 drive-init allocation-vector builder, invoked on drive selection / reset.
2753  A2A3              ; THE '$' SUBMIT PROBE (resolved 2026-07-31; was marked [?] / UNKNOWN).
2754  A2A3              ;   While scanning the directory, this sets the BDOS return value to $FF if the CURRENT USER
2755  A2A3              ;   has a file whose name begins with '$'. That is DRI's documented CP/M 2.2 behaviour for
2756  A2A3              ;   function 13 (Reset Disk System): it logs in drive A and "returns 0FFh if there is a file
2757  A2A3              ;   present whose name begins with a $, otherwise 0". The CCP uses it to notice $$$.SUB, the
2758  A2A3              ;   SUBMIT continuation file, so a batch resumes after a warm boot. It is STANDARD DRI CODE,
2759  A2A3              ;   not a SoftCard addition: the 2.20 and 2.23 BDOSes carry it identically.
2760  A2A3              ;
2761  A2A3              ;   The reason it resisted decoding was the label. BDOS_USER_NUM is the CURRENT USER NUMBER
2762  A2A3              ;   cell, not a stack cell: F_USERNUM_H (fn 32) writes it and FCB_MERGE_USER ORs it into
2763  A2A3              ;   FCB byte 0. DRI overlapped it with the BDOS stack top to save a byte -- BDOS_DISPATCH
2764  A2A3              ;   does LD SP,BDOS_USER_NUM, and because the Z-80 decrements SP BEFORE writing, pushes land
2765  A2A3              ;   at BDOS_USER_NUM-1 and below and never disturb the byte itself.
2766  A2A3              ;
2767  A2A3              ;   So the sequence reads: A = current user; equal to this entry's user byte? then is its
2768  A2A3              ;   first name character '$'? then A (which is 0 from the SUB) becomes $FF and is stored as
2769  A2A3              ;   the function's result. [RE]
2770  A2A3              ; ----------------------------------------------------------------------
2771  A2A3              ALLOC_VECTOR_BUILD:
2772  A2A3                      ; DSM = highest block number; +1 gives the block count to clear.
2773  A2A3 2A C6 A9             LD HL,(MAX_BLOCK_DSM)
2774  A2A6                      ; Shift count 3: (DSM+1)/8 = number of bytes in the allocation vector.
2775  A2A6 0E 03                LD C,$03
2776  A2A8                      ; HL >>= 3 to convert block count into allocation-byte count.
2777  A2A8 CD EA A0             CALL DRV_INSTALL_RWTS_10
2778  A2AB 23                   INC HL
2779  A2AC 44                   LD B,H
2780  A2AD 4D                   LD C,L
2781  A2AE                      ; Start of the allocation vector to be cleared.
2782  A2AE 2A BF A9             LD HL,(ALLOC_VEC_PTR)
2783  A2B1              ALLOC_VECTOR_CLEAR_LOOP:
2784  A2B1                      ; Zero one allocation byte.
2785  A2B1 36 00                LD (HL),$00
2786  A2B3 23                   INC HL
2787  A2B4 0B                   DEC BC
2788  A2B5 78                   LD A,B
2789  A2B6 B1                   OR C
2790  A2B7 C2 B1 A2             JP NZ,ALLOC_VECTOR_CLEAR_LOOP
2791  A2BA                      ; Reserved-blocks mask word: the directory's pre-allocated blocks.
2792  A2BA 2A CA A9             LD HL,(ALLOC_END_PTR)
2793  A2BD EB                   EX DE,HL
2794  A2BE 2A BF A9             LD HL,(ALLOC_VEC_PTR)
2795  A2C1                      ; Seed the allocation vector with the reserved (directory) blocks.
2796  A2C1 73                   LD (HL),E
2797  A2C2 23                   INC HL
2798  A2C3 72                   LD (HL),D
2799  A2C4                      ; Reset the directory scan state to the beginning.
2800  A2C4 CD A1 9F             CALL DISK_HOME_CLEAR_SCAN
2801  A2C7 2A B3 A9             LD HL,(DPB_WORK_PTR0)
2802  A2CA                      ; Initialise the scan record-count workspace.
2803  A2CA 36 03                LD (HL),$03
2804  A2CC 23                   INC HL
2805  A2CD 36 00                LD (HL),$00
2806  A2CF                      ; Invalidate CUR_RECORD so the first read positions at directory start.
2807  A2CF CD FE A1             CALL INVALIDATE_CUR_RECORD
2808  A2D2              ALLOC_VECTOR_SCAN_LOOP:
2809  A2D2                      ; Search-all sentinel: advance unconditionally through every directory record.
2810  A2D2 0E FF                LD C,$FF
2811  A2D4                      ; Advance to and deblock the next directory entry.
2812  A2D4 CD 05 A2             CALL DIR_READ_NEXT
2813  A2D7                      ; Test for end-of-directory; Z => done scanning.
2814  A2D7 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
2815  A2DA                      ; Whole directory scanned: allocation vector is complete.
2816  A2DA C8                   RET Z
2817  A2DB                      ; HL -> the current directory entry's first byte (user/status code).
2818  A2DB CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
2819  A2DE                      ; $E5 = deleted/empty directory entry marker.
2820  A2DE 3E E5                LD A,$E5
2821  A2E0                      ; Skip deleted entries; they own no blocks.
2822  A2E0 BE                   CP (HL)
2823  A2E1                      ; Deleted entry: move to the next directory entry.
2824  A2E1 CA D2 A2             JP Z,ALLOC_VECTOR_SCAN_LOOP
2825  A2E4                      ; A = the current user number; does this entry belong to that user?
2826  A2E4 3A 41 9F             LD A,(BDOS_USER_NUM)
2827  A2E7 BE                   CP (HL)
2828  A2E8                      ; Some other user's entry: nothing to probe, just mark its blocks.
2829  A2E8 C2 F6 A2             JP NZ,ALLOC_VECTOR_SCAN_MARK
2830  A2EB 23                   INC HL
2831  A2EC 7E                   LD A,(HL)
2832  A2ED                      ; Does the name begin with '$'? (SUB leaves A=0 when it does.)
2833  A2ED D6 24                SUB $24
2834  A2EF C2 F6 A2             JP NZ,ALLOC_VECTOR_SCAN_MARK
2835  A2F2                      ; A was 0, so this makes it $FF.
2836  A2F2 3D                   DEC A
2837  A2F3                      ; fn 13 (Reset Disk System) returns $FF: a '$' file exists for this user. The CCP
2838  A2F3                      ; reads it to notice $$$.SUB and resume a SUBMIT batch.
2839  A2F3 32 45 9F             LD (BDOS_RETVAL),A
2840  A2F6              ALLOC_VECTOR_SCAN_MARK:
2841  A2F6                      ; C = 1: mark this entry's blocks IN USE. (The 8/16-bit map width is NOT selected
2842  A2F6                      ; here -- it comes from the BLOCK_WIDTH_FLAG cell, read inside the loop.)
2843  A2F6 0E 01                LD C,$01
2844  A2F8                      ; Apply this directory entry's block map to the allocation vector.
2845  A2F8 CD 6B A2             CALL ALLOC_FROM_FCB
2846  A2FB                      ; Advance the directory record/scan pointer to the next entry.
2847  A2FB CD 8C A1             CALL RECPTR_INC_STORE
2848  A2FE                      ; Continue the directory scan.
2849  A2FE C3 D2 A2             JP ALLOC_VECTOR_SCAN_LOOP
2850  A301              ; ----------------------------------------------------------------------
2851  A301              ; DIR_RETURN_MATCH_FLAG -- return the saved directory-search match status as the BDOS result.
2852  A301              ;   In: DIR_MATCH_FLAG ($A9D4) holds the result of the last directory scan ($FF=no match, else the
2853  A301              ;       0..3 entry index).
2854  A301              ;   Out: A = DIR_MATCH_FLAG; stored to the BDOS result byte ($9F45) via BDOS_RET_RESULT.
2855  A301              ;   Clobbers: A
2856  A301              ;   Algorithm: load the cached search-match flag and tail-jump into the common result-store path.
2857  A301              ;              Used as the common return tail of F_DELETE_HND/F_RENAME_HND/F_ATTRIB_HND.
2858  A301              ;   [RE]
2859  A301              ; ----------------------------------------------------------------------
2860  A301              DIR_RETURN_MATCH_FLAG:
2861  A301                      ; fetch the directory-search match flag saved by the scan
2862  A301 3A D4 A9             LD A,(DIR_MATCH_FLAG)
2863  A304                      ; store A as the BDOS function result and return
2864  A304 C3 01 9F             JP BDOS_RET_RESULT
2865  A307              ; ----------------------------------------------------------------------
2866  A307              ; FCB_EXTENT_COMPARE -- compare two FCB extent bytes under the drive's extent mask.
2867  A307              ;   In: C = one extent byte; A = the other extent byte; EXTENT_MASK ($A9C5) = DPB EXM.
2868  A307              ;   Out: A,flags = ((A & ~mask) - (C & ~mask)) & $1F; Z set when the high extent fields match.
2869  A307              ;   Clobbers: A (BC/AF saved+restored across the call).
2870  A307              ;   Algorithm: complement EXM, AND it into both extent bytes (dropping the masked low bits),
2871  A307              ;              subtract, keep five bits, and test for equality. BC and AF are pushed/popped, so only
2872  A307              ;              A and flags effectively change.
2873  A307              ;   [RE]
2874  A307              ; ----------------------------------------------------------------------
2875  A307              FCB_EXTENT_COMPARE:
2876  A307 C5                   PUSH BC
2877  A308 F5                   PUSH AF
2878  A309                      ; load the drive extent mask (DPB EXM)
2879  A309 3A C5 A9             LD A,(DPB_EXM)
2880  A30C                      ; complement mask: keep the extent bits, drop the EXM-masked low bits
2881  A30C 2F                   CPL
2882  A30D 47                   LD B,A
2883  A30E 79                   LD A,C
2884  A30F                      ; mask one extent byte (C) with ~EXM
2885  A30F A0                   AND B
2886  A310 4F                   LD C,A
2887  A311 F1                   POP AF
2888  A312                      ; mask the other extent byte (A) the same way
2889  A312 A0                   AND B
2890  A313                      ; compare the two masked extents
2891  A313 91                   SUB C
2892  A314                      ; keep the 5-bit extent field; Z means the extents match
2893  A314 E6 1F                AND $1F
2894  A316 C1                   POP BC
2895  A317 C9                   RET
2896  A318              ; ----------------------------------------------------------------------
2897  A318              ; DIR_SEARCH_FIRST -- begin a directory scan for the current FCB, comparing C bytes per entry.
2898  A318              ;   In: C = number of FCB bytes to match (e.g. $0C=name+type, $0F=incl. extent); FCB pointer in
2899  A318              ;       CURFCB_PTR ($9F43).
2900  A318              ;   Out: falls straight through into BDOS_DIR_SCAN_NEXT, which returns the within-record entry index
2901  A318              ;        0..3 or $FF.
2902  A318              ;   Clobbers: A,B,C,D,E,H,L,flags
2903  A318              ;   Algorithm: set DIR_MATCH_FLAG=$FF, store the compare length ($A9D8) and the search-FCB pointer
2904  A318              ;              ($A9D9), reset the record counter to -1 (INVALIDATE_CUR_RECORD), rewind/clear the
2905  A318              ;              directory scan state (DISK_HOME_CLEAR_SCAN), then run the first search-next pass.
2906  A318              ;   [RE]
2907  A318              ; ----------------------------------------------------------------------
2908  A318              DIR_SEARCH_FIRST:
2909  A318 3E FF                LD A,$FF
2910  A31A                      ; DIR_MATCH_FLAG = $FF (no match yet)
2911  A31A 32 D4 A9             LD (DIR_MATCH_FLAG),A
2912  A31D 21 D8 A9             LD HL,DIR_CMP_LEN
2913  A320                      ; save number of FCB bytes to compare per entry
2914  A320 71                   LD (HL),C
2915  A321                      ; current FCB pointer
2916  A321 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
2917  A324                      ; save the search-FCB pointer for the scan loop
2918  A324 22 D9 A9             LD (DIR_FCB_PTR),HL
2919  A327                      ; reset the directory record counter to -1
2920  A327 CD FE A1             CALL INVALIDATE_CUR_RECORD
2921  A32A                      ; rewind directory scan state / clear the record pointers
2922  A32A CD A1 9F             CALL DISK_HOME_CLEAR_SCAN
2923  A32D              ; ----------------------------------------------------------------------
2924  A32D              ; BDOS_DIR_SCAN_NEXT -- advance through directory entries until one matches the search FCB.
2925  A32D              ;   In: search-FCB pointer in DIR_FCB_PTR ($A9D9); compare length in DIR_CMP_LEN ($A9D8).
2926  A32D              ;   Out: A=matching entry index (0..3) on success (via DIR_MATCH_DONE); not-found via DIR_NO_MATCH
2927  A32D              ;        ($FF result).
2928  A32D              ;   Clobbers: A,B,C,D,E,H,L,flags
2929  A32D              ;   Algorithm: step to the next directory record (DIR_READ_NEXT); if the record counter passed the
2930  A32D              ;              directory limit -> not found; otherwise treat erased ($E5) entries specially and
2931  A32D              ;              bound-check the record (CMP_CURREC_VS_WORKPTR), then fall into the per-entry compare;
2932  A32D              ;              on full match -> DIR_MATCH_DONE, else loop to the next entry/record.
2933  A32D              ;   [RE] standard CP/M 2.2 directory search-next with '?' wildcards
2934  A32D              ; ----------------------------------------------------------------------
2935  A32D              BDOS_DIR_SCAN_NEXT:
2936  A32D                      ; scan mode: plain search-next (no special return)
2937  A32D 0E 00                LD C,$00
2938  A32F                      ; advance to the next directory record
2939  A32F CD 05 A2             CALL DIR_READ_NEXT
2940  A332 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
2941  A335                      ; record counter passed the directory limit -> not found
2942  A335 CA 94 A3             JP Z,DIR_NO_MATCH
2943  A338                      ; DE := search-FCB pointer
2944  A338 2A D9 A9             LD HL,(DIR_FCB_PTR)
2945  A33B EB                   EX DE,HL
2946  A33C 1A                   LD A,(DE)
2947  A33D                      ; first byte $E5 = empty/erased directory slot
2948  A33D FE E5                CP $E5
2949  A33F CA 4A A3             JP Z,BDOS_DIR_SCAN_NEXT_CMP
2950  A342 D5                   PUSH DE
2951  A343                      ; have we run past the active directory extent?
2952  A343 CD 7F A1             CALL CMP_CURREC_VS_WORKPTR
2953  A346 D1                   POP DE
2954  A347                      ; past end-of-directory -> not found
2955  A347 D2 94 A3             JP NC,DIR_NO_MATCH
2956  A34A              ; ----------------------------------------------------------------------
2957  A34A              ; BDOS_DIR_SCAN_NEXT_CMP -- set up the per-entry compare loop for BDOS_DIR_SCAN_NEXT.
2958  A34A              ;   In: DE -> directory entry; FCB bytes located via FCB_BUF_PTR_ADD_OFFSET; DIR_CMP_LEN ($A9D8)
2959  A34A              ;       bytes to compare.
2960  A34A              ;   Out: B=0 (index), C=compare count; falls into DIR_CMP_BYTE_LOOP.
2961  A34A              ;   Clobbers: A,B,C,H,L,flags
2962  A34A              ;   Algorithm: point HL at the FCB bytes to compare (FCB_BUF_PTR_ADD_OFFSET), load the compare
2963  A34A              ;              length into C, zero the byte index B, then enter the byte-compare loop.
2964  A34A              ;   [RE]
2965  A34A              ; ----------------------------------------------------------------------
2966  A34A              BDOS_DIR_SCAN_NEXT_CMP:
2967  A34A                      ; HL -> FCB bytes to compare against the entry
2968  A34A CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
2969  A34D                      ; load number of bytes to compare per entry
2970  A34D 3A D8 A9             LD A,(DIR_CMP_LEN)
2971  A350 4F                   LD C,A
2972  A351 06 00                LD B,$00
2973  A353              ; ----------------------------------------------------------------------
2974  A353              ; DIR_CMP_BYTE_LOOP -- compare one FCB byte against the directory entry, honoring wildcards.
2975  A353              ;   In: C = bytes remaining; B = byte index within the entry; DE -> entry byte; HL -> FCB byte.
2976  A353              ;   Out: on count exhausted -> DIR_MATCH_FOUND; on mismatch -> restart BDOS_DIR_SCAN_NEXT; else step
2977  A353              ;        via DIR_CMP_ADVANCE.
2978  A353              ;   Clobbers: A,flags (DE,HL,B,C advanced by DIR_CMP_ADVANCE)
2979  A353              ;   Algorithm: count==0 ends the entry as a match; entry byte '?' ($3F) is a wildcard; index 13
2980  A353              ;              ($0D, S1) is skipped; index 12 ($0C) is the extent field (DIR_CMP_EXTENT); otherwise
2981  A353              ;              the two bytes must match in the low 7 bits.
2982  A353              ;   [RE]
2983  A353              ; ----------------------------------------------------------------------
2984  A353              DIR_CMP_BYTE_LOOP:
2985  A353 79                   LD A,C
2986  A354 B7                   OR A
2987  A355                      ; all bytes compared equal -> directory entry matches
2988  A355 CA 83 A3             JP Z,DIR_MATCH_FOUND
2989  A358 1A                   LD A,(DE)
2990  A359                      ; '?' wildcard in the entry byte matches any FCB byte
2991  A359 FE 3F                CP $3F
2992  A35B CA 7C A3             JP Z,DIR_CMP_ADVANCE
2993  A35E 78                   LD A,B
2994  A35F                      ; byte index 13 (S1) is ignored in the compare
2995  A35F FE 0D                CP $0D
2996  A361 CA 7C A3             JP Z,DIR_CMP_ADVANCE
2997  A364                      ; byte index 12 is the extent byte -> special compare
2998  A364 FE 0C                CP $0C
2999  A366 1A                   LD A,(DE)
3000  A367 CA 73 A3             JP Z,DIR_CMP_EXTENT
3001  A36A                      ; ordinary byte: entry byte minus the FCB byte
3002  A36A 96                   SUB (HL)
3003  A36B                      ; mask the attribute high bit; non-zero -> mismatch, rescan
3004  A36B E6 7F                AND $7F
3005  A36D C2 2D A3             JP NZ,BDOS_DIR_SCAN_NEXT
3006  A370 C3 7C A3             JP DIR_CMP_ADVANCE
3007  A373              ; ----------------------------------------------------------------------
3008  A373              ; DIR_CMP_EXTENT -- compare the extent byte during the directory match.
3009  A373              ;   In: HL -> FCB extent byte; A = entry extent byte; B/C preserved across the call.
3010  A373              ;   Out: equal -> DIR_CMP_ADVANCE; unequal -> restart BDOS_DIR_SCAN_NEXT.
3011  A373              ;   Clobbers: A,flags (BC saved+restored)
3012  A373              ;   Algorithm: load the FCB extent byte into C, call FCB_EXTENT_COMPARE on the entry extent (A) and
3013  A373              ;              the FCB extent under the EXM mask; Z continues the compare, NZ rejects this entry.
3014  A373              ;   [RE]
3015  A373              ; ----------------------------------------------------------------------
3016  A373              DIR_CMP_EXTENT:
3017  A373 C5                   PUSH BC
3018  A374 4E                   LD C,(HL)
3019  A375                      ; compare entry vs FCB extents under the EXM mask
3020  A375 CD 07 A3             CALL FCB_EXTENT_COMPARE
3021  A378 C1                   POP BC
3022  A379                      ; extent differs -> reject entry, continue search
3023  A379 C2 2D A3             JP NZ,BDOS_DIR_SCAN_NEXT
3024  A37C              ; ----------------------------------------------------------------------
3025  A37C              ; DIR_CMP_ADVANCE -- step to the next byte of the entry/FCB compare.
3026  A37C              ;   In: DE -> entry byte, HL -> FCB byte, B = index, C = count remaining.
3027  A37C              ;   Out: DE,HL incremented; B incremented; C decremented; loops back to DIR_CMP_BYTE_LOOP.
3028  A37C              ;   Clobbers: B,C,D,E,H,L
3029  A37C              ;   Algorithm: advance both pointers, bump the index, drop the remaining count, re-enter the byte
3030  A37C              ;              loop.
3031  A37C              ;   [RE]
3032  A37C              ; ----------------------------------------------------------------------
3033  A37C              DIR_CMP_ADVANCE:
3034  A37C 13                   INC DE
3035  A37D 23                   INC HL
3036  A37E 04                   INC B
3037  A37F 0D                   DEC C
3038  A380                      ; compare the next byte of the entry
3039  A380 C3 53 A3             JP DIR_CMP_BYTE_LOOP
3040  A383              ; ----------------------------------------------------------------------
3041  A383              ; DIR_MATCH_FOUND -- record a successful directory match and return its index.
3042  A383              ;   In: CUR_RECORD ($A9EA) = current directory record number.
3043  A383              ;   Out: BDOS result byte ($9F45) = record & 3 (entry index 0..3); DIR_MATCH_FLAG cleared to 0 if it
3044  A383              ;        was still negative.
3045  A383              ;   Clobbers: A,H,L,flags
3046  A383              ;   Algorithm: compute the within-record entry index (record mod 4) into the result byte; if
3047  A383              ;              DIR_MATCH_FLAG still has its sign bit set (=$FF, not yet matched), zero it to mark
3048  A383              ;              'matched'.
3049  A383              ;   [RE]
3050  A383              ; ----------------------------------------------------------------------
3051  A383              DIR_MATCH_FOUND:
3052  A383 3A EA A9             LD A,(CUR_RECORD)
3053  A386                      ; entry index within the 128-byte record (4 entries)
3054  A386 E6 03                AND $03
3055  A388                      ; store entry index as the search result
3056  A388 32 45 9F             LD (BDOS_RETVAL),A
3057  A38B                      ; point at DIR_MATCH_FLAG
3058  A38B 21 D4 A9             LD HL,DIR_MATCH_FLAG
3059  A38E 7E                   LD A,(HL)
3060  A38F                      ; test the flag's high bit (still $FF == not yet matched)
3061  A38F 17                   RLA
3062  A390                      ; flag already cleared -> keep it
3063  A390 D0                   RET NC
3064  A391 AF                   XOR A
3065  A392 77                   LD (HL),A
3066  A393 C9                   RET
3067  A394              ; ----------------------------------------------------------------------
3068  A394              ; DIR_NO_MATCH -- terminate a directory scan with 'not found'.
3069  A394              ;   In: none.
3070  A394              ;   Out: BDOS result byte ($9F45) = $FF; record counter reset to -1.
3071  A394              ;   Clobbers: A,H,L,flags
3072  A394              ;   Algorithm: reset the record counter (INVALIDATE_CUR_RECORD) and store $FF as the BDOS result.
3073  A394              ;   [RE]
3074  A394              ; ----------------------------------------------------------------------
3075  A394              DIR_NO_MATCH:
3076  A394                      ; reset the directory record counter to -1
3077  A394 CD FE A1             CALL INVALIDATE_CUR_RECORD
3078  A397                      ; $FF = directory entry not found
3079  A397 3E FF                LD A,$FF
3080  A399                      ; store $FF as the BDOS result
3081  A399 C3 01 9F             JP BDOS_RET_RESULT
3082  A39C              ; ----------------------------------------------------------------------
3083  A39C              ; F_DELETE_HND -- delete every directory entry matching the FCB (BDOS function 19).
3084  A39C              ;   In: CURFCB_PTR ($9F43) -> FCB (may contain '?' wildcards). Reached from F_DELETE_H (dispatch fn
3085  A39C              ;       19).
3086  A39C              ;   Out: matching directory entries marked erased ($E5) and written back; result via the search
3087  A39C              ;        tail.
3088  A39C              ;   Clobbers: A,B,C,D,E,H,L,flags
3089  A39C              ;   Algorithm: log in the drive (CHECK_DRIVE_READONLY), search-first on 12 FCB bytes (name+type), then fall
3090  A39C              ;              into F_DELETE_LOOP to erase each match.
3091  A39C              ;   [RE] CP/M 2.2 F_DELETE_HND
3092  A39C              ; ----------------------------------------------------------------------
3093  A39C              F_DELETE_HND:
3094  A39C                      ; verify/log in the selected drive
3095  A39C CD 54 A1             CALL CHECK_DRIVE_READONLY
3096  A39F                      ; compare 12 FCB bytes (name + type, ignore extent)
3097  A39F 0E 0C                LD C,$0C
3098  A3A1                      ; search-first for a matching directory entry
3099  A3A1 CD 18 A3             CALL DIR_SEARCH_FIRST
3100  A3A4              ; ----------------------------------------------------------------------
3101  A3A4              ; F_DELETE_LOOP -- erase-and-write each matching directory entry, then search the next.
3102  A3A4              ;   In: a pending search result from DIR_SEARCH_FIRST/NEXT.
3103  A3A4              ;   Out: returns when no further matches remain.
3104  A3A4              ;   Clobbers: A,B,C,D,E,H,L,flags
3105  A3A4              ;   Algorithm: stop when CUR_RECORD_BYTES_EQUAL reports no match; reject if read-only
3106  A3A4              ;              (FCB_RO_FLAG_TEST); point at the matched entry, set its first byte to $E5, clear the
3107  A3A4              ;              entry's allocation map (ALLOC_FROM_FCB), write the directory record (DIR_RECORD_WRITE),
3108  A3A4              ;              search-next, repeat.
3109  A3A4              ;   [RE]
3110  A3A4              ; ----------------------------------------------------------------------
3111  A3A4              F_DELETE_LOOP:
3112  A3A4                      ; did the previous search find an entry?
3113  A3A4 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3114  A3A7                      ; no more matches -> done
3115  A3A7 C8                   RET Z
3116  A3A8                      ; reject deletion if the file is read-only
3117  A3A8 CD 44 A1             CALL FCB_RO_FLAG_TEST
3118  A3AB CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
3119  A3AE                      ; mark the directory entry as erased
3120  A3AE 36 E5                LD (HL),$E5
3121  A3B0 0E 00                LD C,$00
3122  A3B2                      ; free this entry's allocation-map blocks
3123  A3B2 CD 6B A2             CALL ALLOC_FROM_FCB
3124  A3B5                      ; write the modified directory record back to disk
3125  A3B5 CD C6 A1             CALL DIR_RECORD_WRITE
3126  A3B8                      ; advance to the next matching entry
3127  A3B8 CD 2D A3             CALL BDOS_DIR_SCAN_NEXT
3128  A3BB C3 A4 A3             JP F_DELETE_LOOP
3129  A3BE              ; ----------------------------------------------------------------------
3130  A3BE              ; ALLOC_GET_BLOCK -- find/allocate a disk block near a starting block, marking it used.
3131  A3BE              ;   In: BC = starting block number (passed by the write core when extending a file).
3132  A3BE              ;   Out: HL = the block number actually claimed (0 if none free); its allocation-vector bit set.
3133  A3BE              ;   Clobbers: A,B,C,D,E,H,L,flags
3134  A3BE              ;   Algorithm: copy the start block to DE, scan downward then upward from it testing each block's
3135  A3BE              ;              allocation bit (ALLOC_BIT_GET = BLOCK_BIT_TEST), bounded by MAX_BLOCK_DSM; mark the
3136  A3BE              ;              chosen block used (ALLOC_BIT_RESTORE = ALLOC_VEC_SETBIT) and return it, or 0 when no
3137  A3BE              ;              block can be allocated.
3138  A3BE              ;   [RE] allocation-vector block search/allocate
3139  A3BE              ; ----------------------------------------------------------------------
3140  A3BE              ALLOC_GET_BLOCK:
3141  A3BE                      ; copy the starting block number into DE
3142  A3BE 50                   LD D,B
3143  A3BF 59                   LD E,C
3144  A3C0              ; ----------------------------------------------------------------------
3145  A3C0              ; ALLOC_SCAN_DOWN -- scan downward for a FREE block in the run.
3146  A3C0              ;   In: BC = block counter; DE = candidate block; allocation vector via ALLOC_BIT_GET
3147  A3C0              ;       (BLOCK_BIT_TEST).
3148  A3C0              ;   Out: on a free block -> ALLOC_MARK_DONE; otherwise falls into ALLOC_SCAN_UP.
3149  A3C0              ;   Clobbers: A,B,C,D,E,flags
3150  A3C0              ;   Algorithm: while BC != 0, decrement, test the block's allocation bit; if CLEAR (free), go
3151  A3C0              ;              claim it; else keep scanning down.
3152  A3C0              ;   In the CP/M allocation vector a SET bit means the block is in use, so the free block this
3153  A3C0              ;   scan is looking for is the one whose bit is clear -- hence the `JP NC` below. [RE]
3154  A3C0              ; ----------------------------------------------------------------------
3155  A3C0              ALLOC_SCAN_DOWN:
3156  A3C0 79                   LD A,C
3157  A3C1 B0                   OR B
3158  A3C2                      ; counter exhausted -> switch to upward scan
3159  A3C2 CA D1 A3             JP Z,ALLOC_SCAN_UP
3160  A3C5 0B                   DEC BC
3161  A3C6 D5                   PUSH DE
3162  A3C7 C5                   PUSH BC
3163  A3C8                      ; test this block's allocation-vector bit (returned in A bit 0)
3164  A3C8 CD 35 A2             CALL ALLOC_BIT_GET
3165  A3CB                      ; rotate that bit into carry: SET = block in use, CLEAR = block free
3166  A3CB 1F                   RRA
3167  A3CC                      ; carry clear -> the block is FREE, so go claim it
3168  A3CC D2 EC A3             JP NC,ALLOC_MARK_DONE
3169  A3CF C1                   POP BC
3170  A3D0 D1                   POP DE
3171  A3D1              ; ----------------------------------------------------------------------
3172  A3D1              ; ALLOC_SCAN_UP -- scan upward (toward MAX_BLOCK_DSM) for a FREE block.
3173  A3D1              ;   In: DE = candidate block; MAX_BLOCK_DSM ($A9C6) = highest block number on the drive.
3174  A3D1              ;   Out: at/past the disk limit -> ALLOC_SCAN_FINISH; on a free block -> ALLOC_MARK_DONE.
3175  A3D1              ;   Clobbers: A,B,C,D,E,H,L,flags
3176  A3D1              ;   Algorithm: compare DE against DSM; if past it, stop; else increment and test the next block's
3177  A3D1              ;              allocation bit (ALLOC_BIT_GET); a CLEAR bit means free, so claim it.
3178  A3D1              ;   [RE]
3179  A3D1              ; ----------------------------------------------------------------------
3180  A3D1              ALLOC_SCAN_UP:
3181  A3D1                      ; highest valid block number (DSM)
3182  A3D1 2A C6 A9             LD HL,(MAX_BLOCK_DSM)
3183  A3D4 7B                   LD A,E
3184  A3D5 95                   SUB L
3185  A3D6 7A                   LD A,D
3186  A3D7 9C                   SBC A,H
3187  A3D8                      ; candidate beyond disk size -> stop scanning
3188  A3D8 D2 F4 A3             JP NC,ALLOC_SCAN_FINISH
3189  A3DB 13                   INC DE
3190  A3DC C5                   PUSH BC
3191  A3DD D5                   PUSH DE
3192  A3DE 42                   LD B,D
3193  A3DF 4B                   LD C,E
3194  A3E0                      ; test the next block's allocation bit (returned in A bit 0)
3195  A3E0 CD 35 A2             CALL ALLOC_BIT_GET
3196  A3E3                      ; rotate into carry: SET = in use, CLEAR = free
3197  A3E3 1F                   RRA
3198  A3E4                      ; carry clear -> free block found, go claim it
3199  A3E4 D2 EC A3             JP NC,ALLOC_MARK_DONE
3200  A3E7 D1                   POP DE
3201  A3E8 C1                   POP BC
3202  A3E9 C3 C0 A3             JP ALLOC_SCAN_DOWN
3203  A3EC              ; ----------------------------------------------------------------------
3204  A3EC              ; ALLOC_MARK_DONE -- set the chosen block's allocation bit and return it.
3205  A3EC              ;   In: A = the block's current allocation byte (rotated by the scan); the block number tracked by
3206  A3EC              ;       ALLOC_BIT_RESTORE.  Reached only from a scan that found a FREE block, so the bit about to
3207  A3EC              ;       be written is currently CLEAR.
3208  A3EC              ;   Out: allocation vector updated; HL/DE restored from the stack; returns to ALLOC_GET_BLOCK's
3209  A3EC              ;        caller.
3210  A3EC              ;   Clobbers: A,H,L,D,E,flags
3211  A3EC              ;   Algorithm: rotate the (clear) allocation bit back into place, set it with INC A, write it
3212  A3EC              ;              through ALLOC_BIT_RESTORE (ALLOC_VEC_SETBIT), restore the saved registers, return.
3213  A3EC              ;   INC A is what marks the block used, and it works only because bit 0 is known clear on entry:
3214  A3EC              ;   incrementing a value whose low bit is already 0 sets that bit and carries nowhere. [RE]
3215  A3EC              ; ----------------------------------------------------------------------
3216  A3EC              ALLOC_MARK_DONE:
3217  A3EC                      ; rotate the bit back to its position in the allocation byte (carry was clear, so
3218  A3EC                      ; bit 0 comes back clear)
3219  A3EC 17                   RLA
3220  A3ED                      ; bit 0 was clear, so INC A sets it: mark this block USED
3221  A3ED 3C                   INC A
3222  A3EE                      ; write the updated bit back into the allocation vector
3223  A3EE CD 64 A2             CALL ALLOC_BIT_RESTORE
3224  A3F1 E1                   POP HL
3225  A3F2 D1                   POP DE
3226  A3F3 C9                   RET
3227  A3F4              ; ----------------------------------------------------------------------
3228  A3F4              ; ALLOC_SCAN_FINISH -- end the block scan when the disk limit is reached.
3229  A3F4              ;   In: BC = remaining block counter; DE = candidate block.
3230  A3F4              ;   Out: if blocks remain -> back to ALLOC_SCAN_DOWN; else HL=0 (no block) and return.
3231  A3F4              ;   Clobbers: A,H,L,flags
3232  A3F4              ;   Algorithm: if the counter is non-zero, resume the downward scan; otherwise return zero meaning
3233  A3F4              ;              no allocatable block was found.
3234  A3F4              ;   [RE]
3235  A3F4              ; ----------------------------------------------------------------------
3236  A3F4              ALLOC_SCAN_FINISH:
3237  A3F4 79                   LD A,C
3238  A3F5 B0                   OR B
3239  A3F6                      ; blocks left to scan -> continue downward
3240  A3F6 C2 C0 A3             JP NZ,ALLOC_SCAN_DOWN
3241  A3F9                      ; no block found -> return 0
3242  A3F9 21 00 00             LD HL,$0000
3243  A3FC C9                   RET
3244  A3FD              ; ----------------------------------------------------------------------
3245  A3FD              ; FCB_WRITE_DIR_ENTRY -- copy the whole 32-byte FCB image into the matched directory entry and write
3246  A3FD              ; it.
3247  A3FD              ;   In: CURFCB_PTR ($9F43) -> FCB; sets C=0 (FCB offset 0), E=$20 (32 bytes).
3248  A3FD              ;   Out: directory record holding this entry written back to disk.
3249  A3FD              ;   Clobbers: A,B,C,D,E,H,L,flags
3250  A3FD              ;   Algorithm: set up a full-32-byte copy at FCB offset 0 and fall into FCB_COPY_TO_DIR, which moves
3251  A3FD              ;              the bytes and writes the directory record.
3252  A3FD              ;   [RE]
3253  A3FD              ; ----------------------------------------------------------------------
3254  A3FD              FCB_WRITE_DIR_ENTRY:
3255  A3FD                      ; FCB source offset 0
3256  A3FD 0E 00                LD C,$00
3257  A3FF                      ; copy length 32 = full directory entry
3258  A3FF 1E 20                LD E,$20
3259  A401              ; ----------------------------------------------------------------------
3260  A401              ; FCB_COPY_TO_DIR -- copy E FCB bytes (from offset C) into the matched directory entry.
3261  A401              ;   In: C = FCB byte offset; E = byte count; CURFCB_PTR ($9F43) -> FCB; current matched dir entry.
3262  A401              ;   Out: directory buffer updated, then the record written via FCB_FLUSH_DIR.
3263  A401              ;   Clobbers: A,B,C,D,E,H,L,flags
3264  A401              ;   Algorithm: form a source pointer at FCB+C, point HL at the directory entry slot
3265  A401              ;              (FCB_BUF_PTR_ADD_OFFSET), block-copy E bytes (BLOCK_COPY_INCC memcpy), then fall into
3266  A401              ;              FCB_FLUSH_DIR to commit the record.
3267  A401              ;   [RE]
3268  A401              ; ----------------------------------------------------------------------
3269  A401              FCB_COPY_TO_DIR:
3270  A401 D5                   PUSH DE
3271  A402 06 00                LD B,$00
3272  A404                      ; FCB base pointer
3273  A404 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
3274  A407                      ; source := FCB + offset C
3275  A407 09                   ADD HL,BC
3276  A408 EB                   EX DE,HL
3277  A409                      ; HL -> destination slot in the directory buffer
3278  A409 CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
3279  A40C C1                   POP BC
3280  A40D                      ; copy E FCB bytes into the directory entry
3281  A40D CD 4F 9F             CALL BLOCK_COPY_INCC
3282  A410              ; ----------------------------------------------------------------------
3283  A410              ; FCB_FLUSH_DIR -- position to the directory record and write it back.
3284  A410              ;   In: current directory record state from the preceding match.
3285  A410              ;   Out: the directory record written to disk.
3286  A410              ;   Clobbers: A,B,C,D,E,H,L,flags
3287  A410              ;   Algorithm: run the directory record-position helper (REC_DIV4_SETUP) then tail-jump to
3288  A410              ;              DIR_RECORD_WRITE to commit the buffer to the directory sector.
3289  A410              ;   [RE]
3290  A410              ; ----------------------------------------------------------------------
3291  A410              FCB_FLUSH_DIR:
3292  A410                      ; position to the directory record's disk sector
3293  A410 CD C3 9F             CALL REC_DIV4_SETUP
3294  A413                      ; write the updated directory record to disk
3295  A413 C3 C6 A1             JP DIR_RECORD_WRITE
3296  A416              ; ----------------------------------------------------------------------
3297  A416              ; F_RENAME_HND -- rename a file: replace matching directory entries with the new name (BDOS fn 23).
3298  A416              ;   In: CURFCB_PTR ($9F43) -> FCB whose bytes 0..15 are the old name and bytes 16..31 the new name.
3299  A416              ;       Reached from F_RENAME_H (dispatch fn 23).
3300  A416              ;   Out: every matching directory entry rewritten with the new name; read-only entries rejected.
3301  A416              ;   Clobbers: A,B,C,D,E,H,L,flags
3302  A416              ;   Algorithm: log in the drive, search-first on 12 bytes of the old name, copy the FCB drive byte
3303  A416              ;              (offset 0) into the new-name half (offset 16) so both target the same drive, then run
3304  A416              ;              F_RENAME_LOOP over each match.
3305  A416              ;   [RE] CP/M 2.2 F_RENAME_HND
3306  A416              ; ----------------------------------------------------------------------
3307  A416              F_RENAME_HND:
3308  A416                      ; verify/log in the selected drive
3309  A416 CD 54 A1             CALL CHECK_DRIVE_READONLY
3310  A419                      ; search on 12 FCB bytes (old name + type)
3311  A419 0E 0C                LD C,$0C
3312  A41B CD 18 A3             CALL DIR_SEARCH_FIRST
3313  A41E 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
3314  A421 7E                   LD A,(HL)
3315  A422                      ; offset 16: the NEW-name half of a rename FCB. F_RENAME overloads bytes 16-31 as a
3316  A422                      ; second filename, so this is NOT DIRECTORY_ENTRY.AL despite the identical offset. Kept literal.
3317  A422 11 10 00             LD DE,$0010
3318  A425 19                   ADD HL,DE
3319  A426                      ; copy the FCB drive byte (offset 0) into the new-name half
3320  A426 77                   LD (HL),A
3321  A427              ; ----------------------------------------------------------------------
3322  A427              ; F_RENAME_LOOP -- rewrite each matched entry with the new name and write it back.
3323  A427              ;   In: a pending search result.
3324  A427              ;   Out: returns when no more matches.
3325  A427              ;   Clobbers: A,B,C,D,E,H,L,flags
3326  A427              ;   Algorithm: stop on no-match; reject read-only files; copy 12 bytes from FCB offset 16 (the new
3327  A427              ;              name+type) into the entry at offset 0 (via FCB_COPY_TO_DIR); write the directory
3328  A427              ;              record; search-next; repeat.
3329  A427              ;   [RE]
3330  A427              ; ----------------------------------------------------------------------
3331  A427              F_RENAME_LOOP:
3332  A427                      ; did the search find an entry?
3333  A427 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3334  A42A                      ; no more matches -> done
3335  A42A C8                   RET Z
3336  A42B                      ; reject rename of a read-only file
3337  A42B CD 44 A1             CALL FCB_RO_FLAG_TEST
3338  A42E                      ; source offset 16 = the new-name half of the FCB
3339  A42E 0E 10                LD C,$10
3340  A430                      ; copy 12 bytes (new name + type) over the entry
3341  A430 1E 0C                LD E,$0C
3342  A432                      ; overwrite the entry with the new name and flush
3343  A432 CD 01 A4             CALL FCB_COPY_TO_DIR
3344  A435                      ; advance to the next matching entry
3345  A435 CD 2D A3             CALL BDOS_DIR_SCAN_NEXT
3346  A438 C3 27 A4             JP F_RENAME_LOOP
3347  A43B              ; ----------------------------------------------------------------------
3348  A43B              ; F_ATTRIB_HND -- set file attributes from the FCB into matching directory entries (BDOS fn 30).
3349  A43B              ;   In: CURFCB_PTR ($9F43) -> FCB carrying the attribute high bits in the name/type bytes. Reached
3350  A43B              ;       from F_ATTRIB_H (dispatch fn 30).
3351  A43B              ;   Out: every matching directory entry's first 12 bytes rewritten with the FCB's attribute bits.
3352  A43B              ;   Clobbers: A,B,C,D,E,H,L,flags
3353  A43B              ;   Algorithm: search-first on 12 bytes, then run F_ATTRIB_LOOP to copy the 12 name/type bytes (with
3354  A43B              ;              their attribute high bits) from FCB offset 0 into each matched entry and write the
3355  A43B              ;              record.
3356  A43B              ;   [RE] CP/M 2.2 F_ATTRIB_HND
3357  A43B              ; ----------------------------------------------------------------------
3358  A43B              F_ATTRIB_HND:
3359  A43B                      ; search on 12 FCB bytes (name + type)
3360  A43B 0E 0C                LD C,$0C
3361  A43D                      ; search-first for a matching entry
3362  A43D CD 18 A3             CALL DIR_SEARCH_FIRST
3363  A440              ; ----------------------------------------------------------------------
3364  A440              ; F_ATTRIB_LOOP -- write the FCB's attribute bytes into each matched entry.
3365  A440              ;   In: a pending search result.
3366  A440              ;   Out: returns when no more matches.
3367  A440              ;   Clobbers: A,B,C,D,E,H,L,flags
3368  A440              ;   Algorithm: stop on no-match; copy 12 bytes from FCB offset 0 (name/type with attribute bits)
3369  A440              ;              into the entry (FCB_COPY_TO_DIR); flush the directory record; search-next; repeat.
3370  A440              ;   [RE]
3371  A440              ; ----------------------------------------------------------------------
3372  A440              F_ATTRIB_LOOP:
3373  A440 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3374  A443                      ; no more matches -> done
3375  A443 C8                   RET Z
3376  A444                      ; source offset 0 = the FCB name/type bytes
3377  A444 0E 00                LD C,$00
3378  A446                      ; copy 12 bytes including the attribute high bits
3379  A446 1E 0C                LD E,$0C
3380  A448                      ; write the attribute bytes into the entry and flush
3381  A448 CD 01 A4             CALL FCB_COPY_TO_DIR
3382  A44B                      ; advance to the next matching entry
3383  A44B CD 2D A3             CALL BDOS_DIR_SCAN_NEXT
3384  A44E C3 40 A4             JP F_ATTRIB_LOOP
3385  A451              ; ----------------------------------------------------------------------
3386  A451              ; FCB_OPEN_SEARCH -- search-first for the FCB's extent and merge the directory entry into the FCB.
3387  A451              ;   In: CURFCB_PTR ($9F43) -> FCB. Called as the core of F_OPEN (F_OPEN_H, dispatch fn 15) and from
3388  A451              ;       the random-record extent-positioning path.
3389  A451              ;   Out: on match, the matched entry is merged into the FCB (record-count fields filled,
3390  A451              ;        FILE_SIZE_FROM_EXTENT); on no match returns Z with no merge.
3391  A451              ;   Clobbers: A,B,C,D,E,H,L,flags
3392  A451              ;   Algorithm: search-first on 15 bytes (name+type+extent); if not found return Z; otherwise fall
3393  A451              ;              through into FILE_SIZE_FROM_EXTENT to copy the entry into the FCB and set the record
3394  A451              ;              count.
3395  A451              ;   [RE] CP/M 2.2 F_OPEN core / extent locate-and-merge
3396  A451              ; ----------------------------------------------------------------------
3397  A451              FCB_OPEN_SEARCH:
3398  A451                      ; search on 15 bytes (name + type + extent)
3399  A451 0E 0F                LD C,$0F
3400  A453                      ; search-first for the file's directory entry
3401  A453 CD 18 A3             CALL DIR_SEARCH_FIRST
3402  A456 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3403  A459                      ; extent not found -> caller sees the no-match result
3404  A459 C8                   RET Z
3405  A45A              ; ----------------------------------------------------------------------
3406  A45A              ; FILE_SIZE_FROM_EXTENT -- merge a matched directory entry into the FCB and update its record count.
3407  A45A              ;   In: HL -> matched directory entry; CURFCB_PTR ($9F43) -> the user FCB.
3408  A45A              ;   Out: the 32-byte entry copied into the FCB image; the FCB's record-count byte (offset 15)
3409  A45A              ;        updated per this extent.
3410  A45A              ;   Clobbers: A,B,C,D,E,H,L,flags
3411  A45A              ;   Algorithm: save the entry's first byte, copy the 32 directory bytes into the FCB image
3412  A45A              ;              (BLOCK_COPY_INCC), set the S2 'written' flag (MARK_FCB_S2_HIGHBIT), then from the
3413  A45A              ;              entry copy read offset 12 = EX (extent number) into C and offset 15 = RC (record
3414  A45A              ;              count) into B, and choose the new offset-15 value ($00 if this extent is below the
3415  A45A              ;              current one, RC if equal, $80 if above) and store it.  Used by both F_OPEN
3416  A45A              ;              (FCB_OPEN_SEARCH) and F_SIZE.
3417  A45A              ;   [RE]
3418  A45A              ; ----------------------------------------------------------------------
3419  A45A              FILE_SIZE_FROM_EXTENT:
3420  A45A                      ; HL -> matched entry; read its first (extent-low) byte
3421  A45A CD A6 A0             CALL DRV_INSTALL_RWTS_1
3422  A45D 7E                   LD A,(HL)
3423  A45E F5                   PUSH AF
3424  A45F E5                   PUSH HL
3425  A460 CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
3426  A463 EB                   EX DE,HL
3427  A464 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
3428  A467                      ; copy the full 32-byte entry into the FCB image
3429  A467 0E 20                LD C,$20
3430  A469 D5                   PUSH DE
3431  A46A CD 4F 9F             CALL BLOCK_COPY_INCC
3432  A46D CD 78 A1             CALL MARK_FCB_S2_HIGHBIT
3433  A470 D1                   POP DE
3434  A471                      ; EX (extent number) of this DIRECTORY ENTRY
3435  A471 21 0C 00             LD HL,DIRECTORY_ENTRY.EX
3436  A474 19                   ADD HL,DE
3437  A475 4E                   LD C,(HL)
3438  A476                      ; RC (record count) of this DIRECTORY ENTRY
3439  A476 21 0F 00             LD HL,DIRECTORY_ENTRY.RC
3440  A479 19                   ADD HL,DE
3441  A47A 46                   LD B,(HL)
3442  A47B E1                   POP HL
3443  A47C F1                   POP AF
3444  A47D 77                   LD (HL),A
3445  A47E 79                   LD A,C
3446  A47F                      ; compare this extent's number against the FCB's
3447  A47F BE                   CP (HL)
3448  A480 78                   LD A,B
3449  A481 CA 8B A4             JP Z,FILE_SIZE_STORE
3450  A484 3E 00                LD A,$00
3451  A486 DA 8B A4             JP C,FILE_SIZE_STORE
3452  A489                      ; extent above current -> $80 (full 128-record) marker
3453  A489 3E 80                LD A,$80
3454  A48B              ; ----------------------------------------------------------------------
3455  A48B              ; FILE_SIZE_STORE -- write the computed record value into the FCB record-count field.
3456  A48B              ;   In: A = computed value ($00/$80/extent RC); CURFCB_PTR ($9F43) -> FCB.
3457  A48B              ;   Out: FCB offset 15 (RC) = A.
3458  A48B              ;   Clobbers: D,E,H,L
3459  A48B              ;   Algorithm: index the FCB to offset 15 and store the record-count byte.
3460  A48B              ;   [RE]
3461  A48B              ; ----------------------------------------------------------------------
3462  A48B              FILE_SIZE_STORE:
3463  A48B 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
3464  A48E                      ; the FCB's RC (record count) byte
3465  A48E 11 0F 00             LD DE,FCB.DIRECTORY_ENTRY.RC
3466  A491 19                   ADD HL,DE
3467  A492                      ; store the computed record value
3468  A492 77                   LD (HL),A
3469  A493 C9                   RET
3470  A494              ; ----------------------------------------------------------------------
3471  A494              ; FCB_WORD_FILL_IF_ZERO -- copy a 16-bit word from (DE) to (HL) only when (HL) is currently zero.
3472  A494              ;   In: HL -> destination word; DE -> source word.
3473  A494              ;   Out: if the destination word was 0, it is overwritten with the source word; DE,HL preserved.
3474  A494              ;   Clobbers: A,flags
3475  A494              ;   Algorithm: OR the two destination bytes; if non-zero return unchanged; otherwise copy both
3476  A494              ;              source bytes across, restoring DE/HL to their entry values.
3477  A494              ;   [RE] allocation-word merge helper used during F_CLOSE_HND
3478  A494              ; ----------------------------------------------------------------------
3479  A494              FCB_WORD_FILL_IF_ZERO:
3480  A494 7E                   LD A,(HL)
3481  A495 23                   INC HL
3482  A496                      ; test whether the destination word is already non-zero
3483  A496 B6                   OR (HL)
3484  A497 2B                   DEC HL
3485  A498                      ; destination already set -> leave it alone
3486  A498 C0                   RET NZ
3487  A499 1A                   LD A,(DE)
3488  A49A                      ; copy low byte of the source word
3489  A49A 77                   LD (HL),A
3490  A49B 13                   INC DE
3491  A49C 23                   INC HL
3492  A49D 1A                   LD A,(DE)
3493  A49E                      ; copy high byte of the source word
3494  A49E 77                   LD (HL),A
3495  A49F 1B                   DEC DE
3496  A4A0 2B                   DEC HL
3497  A4A1 C9                   RET
3498  A4A2              ; ----------------------------------------------------------------------
3499  A4A2              ; F_CLOSE_HND -- close a file: merge the in-memory FCB into its directory entry (BDOS fn 16).
3500  A4A2              ;   In: CURFCB_PTR ($9F43) -> FCB. Reached from F_CLOSE_H (dispatch fn 16); also used internally to
3501  A4A2              ;       flush an extent.
3502  A4A2              ;   Out: directory entry updated with this FCB's allocation map / record count; result byte set.
3503  A4A2              ;   Clobbers: A,B,C,D,E,H,L,flags
3504  A4A2              ;   Algorithm: zero the result byte and record state, verify the drive is selected (DRIVE_BIT_TEST)
3505  A4A2              ;              and the FCB S2 high bit is clear; search-first on the extent (15 bytes); if found,
3506  A4A2              ;              merge the FCB's 16-byte allocation map into the entry (filling zero words via
3507  A4A2              ;              FCB_WORD_FILL_IF_ZERO, keeping the larger record count) then flush.
3508  A4A2              ;   [RE] CP/M 2.2 F_CLOSE_HND
3509  A4A2              ; ----------------------------------------------------------------------
3510  A4A2              F_CLOSE_HND:
3511  A4A2 AF                   XOR A
3512  A4A3 32 45 9F             LD (BDOS_RETVAL),A
3513  A4A6                      ; clear the directory record counter
3514  A4A6 32 EA A9             LD (CUR_RECORD),A
3515  A4A9 32 EB A9             LD (CUR_RECORD_HI),A
3516  A4AC                      ; is the drive logged in?
3517  A4AC CD 1E A1             CALL DRIVE_BIT_TEST
3518  A4AF                      ; no valid drive -> nothing to close
3519  A4AF C0                   RET NZ
3520  A4B0                      ; read the FCB S2 byte (offset 14)
3521  A4B0 CD 69 A1             CALL FCB_GET_S2
3522  A4B3                      ; high bit = FCB flagged not-to-be-written -> skip
3523  A4B3 E6 80                AND $80
3524  A4B5 C0                   RET NZ
3525  A4B6                      ; search on 15 bytes (name+type+extent)
3526  A4B6 0E 0F                LD C,$0F
3527  A4B8                      ; search-first for this extent's directory entry
3528  A4B8 CD 18 A3             CALL DIR_SEARCH_FIRST
3529  A4BB CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3530  A4BE C8                   RET Z
3531  A4BF                      ; The allocation map, +$10 into BOTH structures: BC is reused for a DIRECTORY
3532  A4BF                      ; ENTRY and then for the FCB, which works because an FCB embeds a directory
3533  A4BF                      ; entry at offset 0.
3534  A4BF 01 10 00             LD BC,DIRECTORY_ENTRY.AL
3535  A4C2 CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
3536  A4C5 09                   ADD HL,BC
3537  A4C6 EB                   EX DE,HL
3538  A4C7 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
3539  A4CA 09                   ADD HL,BC
3540  A4CB 0E 10                LD C,$10
3541  A4CD              ; ----------------------------------------------------------------------
3542  A4CD              ; FCB_MERGE_MAP_LOOP -- merge the FCB allocation map slot-by-slot into the directory entry.
3543  A4CD              ;   In: HL -> entry allocation slot; DE -> FCB allocation slot; C = slots remaining (16).
3544  A4CD              ;   Out: merged allocation map; jumps to FCB_MERGE_DIFF on an 8-bit conflict, else continues.
3545  A4CD              ;   Clobbers: A,B,C,D,E,H,L,flags
3546  A4CD              ;   Algorithm: per slot, if BLOCK_WIDTH_FLAG selects 16-bit block numbers go word-wise
3547  A4CD              ;              (FCB_MERGE_WORD); else handle an 8-bit block: when the entry slot is zero take the
3548  A4CD              ;              FCB's block, then fall into the byte reconciliation.
3549  A4CD              ;   [RE]
3550  A4CD              ; ----------------------------------------------------------------------
3551  A4CD              FCB_MERGE_MAP_LOOP:
3552  A4CD                      ; 0 = 16-bit block numbers, non-zero = 8-bit
3553  A4CD 3A DD A9             LD A,(BLOCK_WIDTH_FLAG)
3554  A4D0 B7                   OR A
3555  A4D1                      ; 16-bit blocks -> word-wise merge path
3556  A4D1 CA E8 A4             JP Z,FCB_MERGE_WORD
3557  A4D4 7E                   LD A,(HL)
3558  A4D5 B7                   OR A
3559  A4D6 1A                   LD A,(DE)
3560  A4D7 C2 DB A4             JP NZ,FCB_MERGE_BYTE_CHECK
3561  A4DA                      ; entry slot empty -> take the FCB's block number
3562  A4DA 77                   LD (HL),A
3563  A4DB              ; ----------------------------------------------------------------------
3564  A4DB              ; FCB_MERGE_BYTE_CHECK -- reconcile one 8-bit allocation slot between FCB and entry.
3565  A4DB              ;   In: A = FCB block byte; HL -> entry block byte; DE -> FCB block byte.
3566  A4DB              ;   Out: FCB block non-zero -> FCB_MERGE_DIFF (compare); else copy entry block into the FCB, then
3567  A4DB              ;        compare.
3568  A4DB              ;   Clobbers: A,flags
3569  A4DB              ;   Algorithm: if the FCB block byte is non-zero, jump to the compare; otherwise mirror the entry
3570  A4DB              ;              block byte into the FCB so both agree, then fall into the compare.
3571  A4DB              ;   [RE]
3572  A4DB              ; ----------------------------------------------------------------------
3573  A4DB              FCB_MERGE_BYTE_CHECK:
3574  A4DB B7                   OR A
3575  A4DC                      ; FCB block set -> compare with the entry
3576  A4DC C2 E1 A4             JP NZ,FCB_MERGE_DIFF
3577  A4DF 7E                   LD A,(HL)
3578  A4E0                      ; FCB block empty -> copy the entry's block into it
3579  A4E0 12                   LD (DE),A
3580  A4E1              ; ----------------------------------------------------------------------
3581  A4E1              ; FCB_MERGE_DIFF -- detect a block-map disagreement between FCB and directory entry.
3582  A4E1              ;   In: A = FCB block byte; HL -> entry block byte.
3583  A4E1              ;   Out: if they differ, FCB_DEC_RESULT flags the conflict; else continue (FCB_MERGE_NEXT).
3584  A4E1              ;   Clobbers: A,flags
3585  A4E1              ;   Algorithm: compare the FCB block byte with the entry's; unequal records an error via
3586  A4E1              ;              FCB_DEC_RESULT, otherwise advance to the next slot.
3587  A4E1              ;   [RE]
3588  A4E1              ; ----------------------------------------------------------------------
3589  A4E1              FCB_MERGE_DIFF:
3590  A4E1                      ; FCB block vs entry block
3591  A4E1 BE                   CP (HL)
3592  A4E2                      ; block maps disagree -> flag conflict
3593  A4E2 C2 1F A5             JP NZ,FCB_DEC_RESULT
3594  A4E5 C3 FD A4             JP FCB_MERGE_NEXT
3595  A4E8              ; ----------------------------------------------------------------------
3596  A4E8              ; FCB_MERGE_WORD -- merge/compare a 16-bit allocation word for double-byte-block drives.
3597  A4E8              ;   In: HL -> entry word; DE -> FCB word.
3598  A4E8              ;   Out: zero words filled across both directions; on a true word mismatch -> FCB_DEC_RESULT.
3599  A4E8              ;   Clobbers: A,D,E,H,L,flags
3600  A4E8              ;   Algorithm: fill the entry word from the FCB if it was zero, fill the FCB word from the entry if
3601  A4E8              ;              it was zero (FCB_WORD_FILL_IF_ZERO both ways, EX DE,HL between), then compare the two
3602  A4E8              ;              16-bit values byte-by-byte and flag a conflict on inequality.
3603  A4E8              ;   [RE]
3604  A4E8              ; ----------------------------------------------------------------------
3605  A4E8              FCB_MERGE_WORD:
3606  A4E8                      ; fill entry word from FCB if entry was zero
3607  A4E8 CD 94 A4             CALL FCB_WORD_FILL_IF_ZERO
3608  A4EB EB                   EX DE,HL
3609  A4EC                      ; fill FCB word from entry if FCB was zero
3610  A4EC CD 94 A4             CALL FCB_WORD_FILL_IF_ZERO
3611  A4EF EB                   EX DE,HL
3612  A4F0 1A                   LD A,(DE)
3613  A4F1                      ; compare low bytes of the two block words
3614  A4F1 BE                   CP (HL)
3615  A4F2 C2 1F A5             JP NZ,FCB_DEC_RESULT
3616  A4F5 13                   INC DE
3617  A4F6 23                   INC HL
3618  A4F7 1A                   LD A,(DE)
3619  A4F8                      ; compare high bytes of the two block words
3620  A4F8 BE                   CP (HL)
3621  A4F9 C2 1F A5             JP NZ,FCB_DEC_RESULT
3622  A4FC 0D                   DEC C
3623  A4FD              ; ----------------------------------------------------------------------
3624  A4FD              ; FCB_MERGE_NEXT -- step to the next allocation slot, then finalize the record count.
3625  A4FD              ;   In: DE,HL -> current FCB/entry block bytes; C = slot count remaining.
3626  A4FD              ;   Out: loops to FCB_MERGE_MAP_LOOP until C reaches 0, then reconciles the record-count field and
3627  A4FD              ;        continues to FCB_MERGE_FINISH.
3628  A4FD              ;   Clobbers: A,B,C,D,E,H,L,flags
3629  A4FD              ;   Algorithm: advance both pointers, decrement the count; while slots remain re-enter the merge
3630  A4FD              ;              loop; when done back up by 20 bytes to EX (offset 12, NOT the record count) and keep the
3631  A4FD              ;              larger of the FCB/entry counts (and the matching S2/extent bytes), then fall into
3632  A4FD              ;              FCB_MERGE_FINISH.
3633  A4FD              ;   [RE]
3634  A4FD              ; ----------------------------------------------------------------------
3635  A4FD              FCB_MERGE_NEXT:
3636  A4FD 13                   INC DE
3637  A4FE 23                   INC HL
3638  A4FF 0D                   DEC C
3639  A500                      ; more allocation slots -> keep merging
3640  A500 C2 CD A4             JP NZ,FCB_MERGE_MAP_LOOP
3641  A503                      ; Back up from the END of the entry to EX. TRACED, both statically and at runtime:
3642  A503                      ; the map loop leaves the pointers at base+32 on BOTH paths (the 8-bit path does one
3643  A503                      ; INC HL and one DEC C per slot, 16 slots; the 16-bit path does two of each per slot,
3644  A503                      ; 8 slots), so -20 reaches offset 12, which is EX -- NOT the record count at 15.
3645  A503                      ; Verified in the emulator: at this instruction HL-20 == BDOS_PARAM_PTR+12 exactly,
3646  A503                      ; and the byte there matched the FCB's EX and not its RC. An earlier comment here
3647  A503                      ; called it "the record-count field", the same EX/RC confusion corrected elsewhere
3648  A503                      ; in this file. The +3 step further down then moves EX -> RC, which is only coherent
3649  A503                      ; if this landing really is EX.
3650  A503                      ; (The 16-bit path is unreachable on SoftCard hardware: every DSM here is <= 139, so
3651  A503                      ; block numbers are always 8-bit. It is traced above for completeness, not observed.)
3652  A503 01 EC FF             LD BC,DIRECTORY_ENTRY.EX - DIRECTORY_ENTRY
3653  A506 09                   ADD HL,BC
3654  A507 EB                   EX DE,HL
3655  A508 09                   ADD HL,BC
3656  A509 1A                   LD A,(DE)
3657  A50A                      ; compare the FCB's EX (extent) with the entry's
3658  A50A BE                   CP (HL)
3659  A50B                      ; FCB extent smaller -> keep the entry's
3660  A50B DA 17 A5             JP C,FCB_MERGE_FINISH
3661  A50E                      ; FCB extent larger -> store it into the entry
3662  A50E 77                   LD (HL),A
3663  A50F                      ; step from EX to RC, as arithmetic on the field names
3664  A50F 01 03 00             LD BC,DIRECTORY_ENTRY.RC - DIRECTORY_ENTRY.EX
3665  A512 09                   ADD HL,BC
3666  A513 EB                   EX DE,HL
3667  A514 09                   ADD HL,BC
3668  A515 7E                   LD A,(HL)
3669  A516 12                   LD (DE),A
3670  A517              ; ----------------------------------------------------------------------
3671  A517              ; FCB_MERGE_FINISH -- mark the merged entry dirty and flush the directory record.
3672  A517              ;   In: merged directory entry in the buffer.
3673  A517              ;   Out: dir-changed flag ($A9D2) = $FF; directory record written via FCB_FLUSH_DIR.
3674  A517              ;   Clobbers: A,H,L,flags
3675  A517              ;   Algorithm: set the 'directory changed' flag and tail-jump to FCB_FLUSH_DIR to commit the record
3676  A517              ;              to disk.
3677  A517              ;   [RE]
3678  A517              ; ----------------------------------------------------------------------
3679  A517              FCB_MERGE_FINISH:
3680  A517 3E FF                LD A,$FF
3681  A519                      ; set the directory-changed flag ($FF)
3682  A519 32 D2 A9             LD (DIR_DIRTY_FLAG),A
3683  A51C                      ; flush the merged entry to the directory sector
3684  A51C C3 10 A4             JP FCB_FLUSH_DIR
3685  A51F              ; ----------------------------------------------------------------------
3686  A51F              ; FCB_DEC_RESULT -- record a directory-merge conflict by decrementing the result byte.
3687  A51F              ;   In: none (operates on the BDOS result byte $9F45).
3688  A51F              ;   Out: result byte decremented (toward the $FF error code).
3689  A51F              ;   Clobbers: H,L,flags
3690  A51F              ;   Algorithm: point at the result byte and decrement it in place to signal the close/merge
3691  A51F              ;              mismatch.
3692  A51F              ;   [RE]
3693  A51F              ; ----------------------------------------------------------------------
3694  A51F              FCB_DEC_RESULT:
3695  A51F                      ; point at the BDOS result byte
3696  A51F 21 45 9F             LD HL,BDOS_RETVAL
3697  A522                      ; decrement to flag the merge conflict
3698  A522 35                   DEC (HL)
3699  A523 C9                   RET
3700  A524              ; ----------------------------------------------------------------------
3701  A524              ; DIR_MAKE_ENTRY -- find a free directory slot and create a new (empty) entry for the FCB.
3702  A524              ;   In: CURFCB_PTR ($9F43) -> FCB. Also the core of F_MAKE (F_MAKE_H, dispatch fn 22).
3703  A524              ;   Out: a free directory slot located and initialized for this file; returns Z if no slot is free.
3704  A524              ;   Clobbers: A,B,C,D,E,H,L,flags
3705  A524              ;   Algorithm: log in the drive, temporarily redirect the FCB pointer to a scratch FCB ($A9AC) and
3706  A524              ;              search-first in mode 1 for an empty ($E5) slot, restore the FCB pointer; on success
3707  A524              ;              zero 17 bytes of the entry's record/allocation area (from offset 15), clear the S1
3708  A524              ;              byte (offset 13), advance the record pointer (RECPTR_INC_STORE), write the new entry
3709  A524              ;              (FCB_WRITE_DIR_ENTRY), and set the FCB S2 'written' flag (MARK_FCB_S2_HIGHBIT).
3710  A524              ;   [RE] make-directory-entry helper
3711  A524              ; ----------------------------------------------------------------------
3712  A524              DIR_MAKE_ENTRY:
3713  A524                      ; log in the drive
3714  A524 CD 54 A1             CALL CHECK_DRIVE_READONLY
3715  A527 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
3716  A52A E5                   PUSH HL
3717  A52B                      ; point at a scratch FCB used to find a free slot
3718  A52B 21 AC A9             LD HL,EMPTY_DIR_FCB
3719  A52E 22 43 9F             LD (BDOS_PARAM_PTR),HL
3720  A531                      ; search mode 1: locate a free ($E5) directory entry
3721  A531 0E 01                LD C,$01
3722  A533 CD 18 A3             CALL DIR_SEARCH_FIRST
3723  A536 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3724  A539 E1                   POP HL
3725  A53A 22 43 9F             LD (BDOS_PARAM_PTR),HL
3726  A53D C8                   RET Z
3727  A53E EB                   EX DE,HL
3728  A53F 21 0F 00             LD HL,DIRECTORY_ENTRY.RC
3729  A542 19                   ADD HL,DE
3730  A543                      ; clear from RC to the end of the entry
3731  A543 0E 11                LD C,DIRECTORY_ENTRY - DIRECTORY_ENTRY.RC
3732  A545 AF                   XOR A
3733  A546              ; ----------------------------------------------------------------------
3734  A546              ; DIR_ZERO_ALLOC -- clear the record/allocation bytes of a freshly created directory entry.
3735  A546              ;   In: HL -> first byte to clear; C = byte count (17); A = 0.
3736  A546              ;   Out: C bytes at HL set to zero.
3737  A546              ;   Clobbers: C,H,L,flags
3738  A546              ;   Algorithm: store-zero / increment HL / decrement C until the count reaches zero.
3739  A546              ;   [RE]
3740  A546              ; ----------------------------------------------------------------------
3741  A546              DIR_ZERO_ALLOC:
3742  A546 77                   LD (HL),A
3743  A547 23                   INC HL
3744  A548 0D                   DEC C
3745  A549                      ; loop until all record/allocation bytes are zeroed
3746  A549 C2 46 A5             JP NZ,DIR_ZERO_ALLOC
3747  A54C 21 0D 00             LD HL,DIRECTORY_ENTRY.S1
3748  A54F 19                   ADD HL,DE
3749  A550 77                   LD (HL),A
3750  A551 CD 8C A1             CALL RECPTR_INC_STORE
3751  A554 CD FD A3             CALL FCB_WRITE_DIR_ENTRY
3752  A557 C3 78 A1             JP MARK_FCB_S2_HIGHBIT
3753  A55A              ; ----------------------------------------------------------------------
3754  A55A              ; FCB_ADVANCE_RECORD -- advance the FCB to the next record/extent for sequential write.
3755  A55A              ;   In: CURFCB_PTR ($9F43) -> open FCB.
3756  A55A              ;   Out: FCB EXTENT fields stepped (EX at offset 12, and S2 at 14 on wrap); new extent opened
3757  A55A              ;        or created as needed.;
3758  A55A              ;   FCB EXTENT PAIR (offsets 12 and 14). CP/M numbers extents with a PAIR of FCB bytes:
3759  A55A              ;     EX (offset 12) holds the low 5 bits, S2 (offset 14) the high bits, so the extent
3760  A55A              ;     number is EX + 32*S2. That is why this routine masks AND $1F and carries into
3761  A55A              ;     offset 14. CR, the current-record byte, is at offset $20 and is 7 bits (0-127);
3762  A55A              ;     it is NOT this field. Three earlier comments here named offset 12 "the
3763  A55A              ;     current-record byte", and one said "wrap the current record mod 32 (128
3764  A55A              ;     records/extent)", which states both numbers and cannot be right either way.
3765  A55A              ;     The 60K twin's copy of this routine had it correct all along. [RE]
3766  A55A              ;   Clobbers: A,B,C,D,E,H,L,flags
3767  A55A              ;   Algorithm: clear the dir-changed flag, flush the current extent (F_CLOSE_HND via F_CLOSE_HND), bump the
3768  A55A              ;              FCB EXTENT byte EX (offset 12) and wrap it mod 32; on wrap go open the next
3769  A55A              ;              extent (FCB_NEXT_EXTENT); otherwise check the extent mask (EXM at $A9C5) and the
3770  A55A              ;              dir-changed flag to decide between re-opening the current extent or merging the
3771  A55A              ;              just-flushed one.
3772  A55A              ;   [RE] sequential-write record/extent advance
3773  A55A              ; ----------------------------------------------------------------------
3774  A55A              FCB_ADVANCE_RECORD:
3775  A55A AF                   XOR A
3776  A55B                      ; clear the directory-changed flag
3777  A55B 32 D2 A9             LD (DIR_DIRTY_FLAG),A
3778  A55E                      ; close/flush the current extent first
3779  A55E CD A2 A4             CALL F_CLOSE_HND
3780  A561 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3781  A564 C8                   RET Z
3782  A565 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
3783  A568                      ; EX, the extent number's low 5 bits (CR lives at FCB.CR, not here)
3784  A568 01 0C 00             LD BC,FCB.DIRECTORY_ENTRY.EX
3785  A56B 09                   ADD HL,BC
3786  A56C 7E                   LD A,(HL)
3787  A56D 3C                   INC A
3788  A56E                      ; EX is a 5-bit field: wrap at 32 extents, then S2 (offset 14) takes the carry
3789  A56E E6 1F                AND $1F
3790  A570 77                   LD (HL),A
3791  A571                      ; EX wrapped past 31 -> carry into S2 and open the next extent
3792  A571 CA 83 A5             JP Z,FCB_NEXT_EXTENT
3793  A574 47                   LD B,A
3794  A575                      ; load the extent mask (EXM)
3795  A575 3A C5 A9             LD A,(DPB_EXM)
3796  A578 A0                   AND B
3797  A579 21 D2 A9             LD HL,DIR_DIRTY_FLAG
3798  A57C A6                   AND (HL)
3799  A57D CA 8E A5             JP Z,FCB_OPEN_NEXT_EXTENT
3800  A580 C3 AC A5             JP FCB_MERGE_FOUND_EXTENT
3801  A583              ; ----------------------------------------------------------------------
3802  A583              ; FCB_NEXT_EXTENT -- carry into S2 when the EX field wraps past 31.
3803  A583              ;   In: HL -> the FCB's EX byte (offset 12); S1 and S2 follow at offsets 13 and 14.
3804  A583              ;   Out: S2 (offset 14) incremented; low-nibble rollover branches to finish.
3805  A583              ;   Clobbers: A,B,C,H,L,flags
3806  A583              ;   Algorithm: advance HL by 2 to S2 (offset 14), increment it; if its low nibble is
3807  A583              ;              now zero a module of extents has rolled over and control goes to DISK_FINISH_OK;
3808  A583              ;              otherwise fall into the open-next-extent path.
3809  A583              ;   [RE]
3810  A583              ; ----------------------------------------------------------------------
3811  A583              FCB_NEXT_EXTENT:
3812  A583                      ; step from EX to S2, as arithmetic on the field names
3813  A583 01 02 00             LD BC,FCB.DIRECTORY_ENTRY.S2 - FCB.DIRECTORY_ENTRY.EX
3814  A586 09                   ADD HL,BC
3815  A587                      ; advance to the next extent
3816  A587 34                   INC (HL)
3817  A588 7E                   LD A,(HL)
3818  A589                      ; low nibble = extent within the current entry group
3819  A589 E6 0F                AND $0F
3820  A58B                      ; extent group rolled over -> finish
3821  A58B CA B6 A5             JP Z,DISK_FINISH_OK
3822  A58E              ; ----------------------------------------------------------------------
3823  A58E              ; FCB_OPEN_NEXT_EXTENT -- search the directory for the FCB's next extent, creating it if absent.
3824  A58E              ;   In: CURFCB_PTR ($9F43) -> FCB positioned at the next extent; the read/write direction flag in
3825  A58E              ;       $A9D3.
3826  A58E              ;   Out: the extent opened (merged into the FCB) or a new entry created; result set.
3827  A58E              ;   Clobbers: A,B,C,D,E,H,L,flags
3828  A58E              ;   Algorithm: search-first on 15 bytes for the extent; if found go merge it
3829  A58E              ;              (FCB_MERGE_FOUND_EXTENT); else, when the direction flag is not $FF (i.e. a write),
3830  A58E              ;              make a new directory entry (DIR_MAKE_ENTRY); on a read (or no free slot) take the
3831  A58E              ;              disk-finish/error path.
3832  A58E              ;   [RE]
3833  A58E              ; ----------------------------------------------------------------------
3834  A58E              FCB_OPEN_NEXT_EXTENT:
3835  A58E                      ; search on 15 bytes (name+type+extent)
3836  A58E 0E 0F                LD C,$0F
3837  A590                      ; search-first for the next extent
3838  A590 CD 18 A3             CALL DIR_SEARCH_FIRST
3839  A593 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3840  A596                      ; extent exists -> merge it into the FCB
3841  A596 C2 AC A5             JP NZ,FCB_MERGE_FOUND_EXTENT
3842  A599 3A D3 A9             LD A,(RW_DIRECTION_FLAG)
3843  A59C 3C                   INC A
3844  A59D CA B6 A5             JP Z,DISK_FINISH_OK
3845  A5A0                      ; no extent -> make a new directory entry
3846  A5A0 CD 24 A5             CALL DIR_MAKE_ENTRY
3847  A5A3 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
3848  A5A6 CA B6 A5             JP Z,DISK_FINISH_OK
3849  A5A9 C3 AF A5             JP FCB_FINISH_NEW_EXTENT
3850  A5AC              ; ----------------------------------------------------------------------
3851  A5AC              ; FCB_MERGE_FOUND_EXTENT -- merge a located directory extent back into the FCB.
3852  A5AC              ;   In: a successful search result for the extent; CURFCB_PTR ($9F43) -> FCB.
3853  A5AC              ;   Out: FCB's record/size fields updated from the entry; then falls into FCB_FINISH_NEW_EXTENT
3854  A5AC              ;        (refresh fields, return 0).
3855  A5AC              ;   Clobbers: A,B,C,D,E,H,L,flags
3856  A5AC              ;   Algorithm: merge the matched extent into the FCB (FILE_SIZE_FROM_EXTENT), then fall through into
3857  A5AC              ;              FCB_FINISH_NEW_EXTENT which refreshes the working fields and returns success.
3858  A5AC              ;   [RE]
3859  A5AC              ; ----------------------------------------------------------------------
3860  A5AC              FCB_MERGE_FOUND_EXTENT:
3861  A5AC                      ; merge the matched extent and set the FCB record count, then fall into
3862  A5AC                      ; FCB_FINISH_NEW_EXTENT
3863  A5AC CD 5A A4             CALL FILE_SIZE_FROM_EXTENT
3864  A5AF              ; ----------------------------------------------------------------------
3865  A5AF              ; FCB_FINISH_NEW_EXTENT -- finish opening a newly created extent and return OK.
3866  A5AF              ;   In: a new directory entry just made for the FCB.
3867  A5AF              ;   Out: FCB working fields refreshed; BDOS result = 0.
3868  A5AF              ;   Clobbers: A,B,C,D,E,H,L,flags
3869  A5AF              ;   Algorithm: refresh the FCB drive/extent fields (DRV_INSTALL_RWTS_3) and return success (0).
3870  A5AF              ;   [RE]
3871  A5AF              ; ----------------------------------------------------------------------
3872  A5AF              FCB_FINISH_NEW_EXTENT:
3873  A5AF                      ; refresh the FCB drive/extent working fields
3874  A5AF CD BB A0             CALL DRV_INSTALL_RWTS_3
3875  A5B2 AF                   XOR A
3876  A5B3                      ; return success (0)
3877  A5B3 C3 01 9F             JP BDOS_RET_RESULT
3878  A5B6              ; ----------------------------------------------------------------------
3879  A5B6              ; DISK_FINISH_OK -- finalize the BDOS result and set the FCB written flag.
3880  A5B6              ;   In: directory/record operation just completed.
3881  A5B6              ;   Out: BDOS result finalized (BDOS_RET_ONE); FCB S2 'written' bit set.
3882  A5B6              ;   Clobbers: A,H,L,flags
3883  A5B6              ;   Algorithm: run the common result-finalizer (BDOS_RET_ONE) then tail-jump to MARK_FCB_S2_HIGHBIT
3884  A5B6              ;              to set the FCB S2 high bit (mark written) and return.
3885  A5B6              ;   [RE]
3886  A5B6              ; ----------------------------------------------------------------------
3887  A5B6              DISK_FINISH_OK:
3888  A5B6                      ; finalize the BDOS result for the operation
3889  A5B6 CD 05 9F             CALL BDOS_RET_ONE
3890  A5B9                      ; set the FCB S2 'written' flag and return
3891  A5B9 C3 78 A1             JP MARK_FCB_S2_HIGHBIT
3892  A5BC              ; ----------------------------------------------------------------------
3893  A5BC              ; FILE_READ_SEQ -- sequential read of one record into the DMA buffer (BDOS fn 20).
3894  A5BC              ;   In: CURFCB_PTR ($9F43) -> open FCB. Reached from F_READ_H (dispatch fn 20).
3895  A5BC              ;   Out: requested record read; BDOS result reflects success/EOF.
3896  A5BC              ;   Clobbers: A,B,C,D,E,H,L,flags
3897  A5BC              ;   Algorithm: set the sequential/random mode flag $A9D5=1 (1 = sequential; the random-read path
3898  A5BC              ;              BDOS_SEEK_NOREAD sets it 0) then fall into the shared read core (FILE_READ_RECORD).
3899  A5BC              ;   [RE] CP/M 2.2 sequential read entry
3900  A5BC              ; ----------------------------------------------------------------------
3901  A5BC              FILE_READ_SEQ:
3902  A5BC                      ; mode = 1 (sequential read)
3903  A5BC 3E 01                LD A,$01
3904  A5BE                      ; store the sequential/random mode flag (1=sequential)
3905  A5BE 32 D5 A9             LD (WRITE_TYPE_FLAG),A
3906  A5C1              ; ----------------------------------------------------------------------
3907  A5C1              ; FILE_READ_RECORD -- read the FCB's current record into the DMA buffer (shared read core).
3908  A5C1              ;   In: CURFCB_PTR ($9F43) -> open FCB; record/extent fields set. Shared by sequential
3909  A5C1              ;       (FILE_READ_SEQ) and random read.
3910  A5C1              ;   Out: the record's sector read and de-blocked to the DMA address; result = 0/error.
3911  A5C1              ;   Clobbers: A,B,C,D,E,H,L,flags
3912  A5C1              ;   Algorithm: set the direction flag $A9D3=$FF (read), refresh the FCB working fields, compare the
3913  A5C1              ;              current record ($A9E3) against the extent's record count ($A9E1); if at the $80
3914  A5C1              ;              boundary advance to the next extent (FCB_ADVANCE_RECORD), else translate the record
3915  A5C1              ;              to a physical sector and read it.
3916  A5C1              ;   [RE] CP/M 2.2 read core
3917  A5C1              ; ----------------------------------------------------------------------
3918  A5C1              FILE_READ_RECORD:
3919  A5C1                      ; direction = read
3920  A5C1 3E FF                LD A,$FF
3921  A5C3                      ; store the read/write direction flag ($FF=read)
3922  A5C3 32 D3 A9             LD (RW_DIRECTION_FLAG),A
3923  A5C6                      ; refresh the FCB drive/extent working fields
3924  A5C6 CD BB A0             CALL DRV_INSTALL_RWTS_3
3925  A5C9 3A E3 A9             LD A,(FCB_CURREC)
3926  A5CC 21 E1 A9             LD HL,FCB_RECCOUNT
3927  A5CF BE                   CP (HL)
3928  A5D0 DA E6 A5             JP C,FILE_READ_DO_SECTOR
3929  A5D3                      ; record at the $80 boundary = extent boundary / EOF
3930  A5D3 FE 80                CP $80
3931  A5D5 C2 FB A5             JP NZ,FILE_READ_ERROR
3932  A5D8 CD 5A A5             CALL FCB_ADVANCE_RECORD
3933  A5DB AF                   XOR A
3934  A5DC 32 E3 A9             LD (FCB_CURREC),A
3935  A5DF 3A 45 9F             LD A,(BDOS_RETVAL)
3936  A5E2 B7                   OR A
3937  A5E3 C2 FB A5             JP NZ,FILE_READ_ERROR
3938  A5E6              ; ----------------------------------------------------------------------
3939  A5E6              ; FILE_READ_DO_SECTOR -- translate the record to a sector and read it into the DMA buffer.
3940  A5E6              ;   In: FCB working fields set; record within the current extent.
3941  A5E6              ;   Out: the physical sector read and de-blocked into the DMA address.
3942  A5E6              ;   Clobbers: A,B,C,D,E,H,L,flags
3943  A5E6              ;   Algorithm: compute block/sector/track from the record (DISK_STORE_SEC_TRK_14/16/17); if no block
3944  A5E6              ;              is allocated take the read-error path; otherwise read the sector through the
3945  A5E6              ;              deblocking buffer and return via the BIOS read tail (DRV_INSTALL_RWTS_6).
3946  A5E6              ;   [RE]
3947  A5E6              ; ----------------------------------------------------------------------
3948  A5E6              FILE_READ_DO_SECTOR:
3949  A5E6                      ; compute the block number for this record
3950  A5E6 CD 77 A0             CALL DISK_STORE_SEC_TRK_14
3951  A5E9 CD 84 A0             CALL DISK_STORE_SEC_TRK_16
3952  A5EC                      ; no allocated block -> read error / unwritten
3953  A5EC CA FB A5             JP Z,FILE_READ_ERROR
3954  A5EF                      ; compute the physical sector/track
3955  A5EF CD 8A A0             CALL DISK_STORE_SEC_TRK_17
3956  A5F2 CD D1 9F             CALL RECORD_TO_TRACK
3957  A5F5 CD B2 9F             CALL DISK_READ_CHECKED
3958  A5F8                      ; perform the BIOS sector read and return
3959  A5F8 C3 D2 A0             JP DRV_INSTALL_RWTS_6
3960  A5FB              ; ----------------------------------------------------------------------
3961  A5FB              ; FILE_READ_ERROR -- return a read error / unwritten-record result.
3962  A5FB              ;   In: none.
3963  A5FB              ;   Out: BDOS result set to the error code via BDOS_RET_ONE.
3964  A5FB              ;   Clobbers: A,flags
3965  A5FB              ;   Algorithm: tail-jump to the common error-result setter.
3966  A5FB              ;   [RE]
3967  A5FB              ; ----------------------------------------------------------------------
3968  A5FB              FILE_READ_ERROR:
3969  A5FB                      ; return the BDOS read error code
3970  A5FB C3 05 9F             JP BDOS_RET_ONE
3971  A5FE              ; ----------------------------------------------------------------------
3972  A5FE              ; FILE_WRITE_SEQ -- sequential write of one record from the DMA buffer (BDOS fn 21).
3973  A5FE              ;   In: CURFCB_PTR ($9F43) -> FCB; DMA buffer holds the record. Reached from F_WRITE_H (dispatch fn
3974  A5FE              ;       21).
3975  A5FE              ;   Out: enters the write core; record written, blocks allocated as needed; result set.
3976  A5FE              ;   Clobbers: A,B,C,D,E,H,L,flags
3977  A5FE              ;   Algorithm: set the sequential/random mode flag $A9D5=1 (1 = sequential) then fall into the
3978  A5FE              ;              shared write core (at $A603, which clears the direction flag, logs in, allocates a
3979  A5FE              ;              block when the record is new, translates to a sector, and writes).
3980  A5FE              ;   [RE] CP/M 2.2 sequential write entry
3981  A5FE              ; ----------------------------------------------------------------------
3982  A5FE              FILE_WRITE_SEQ:
3983  A5FE                      ; mode = 1 (sequential write)
3984  A5FE 3E 01                LD A,$01
3985  A600                      ; store the sequential/random mode flag (1=sequential)
3986  A600 32 D5 A9             LD (WRITE_TYPE_FLAG),A
3987  A603              ; ----------------------------------------------------------------------
3988  A603              ; BDOS_WRITE -- BDOS WRITE primitive (CP/M 2.2 fn 21 F_WRITE / fn 34 F_WRITERAND / fn 40 F_WRITEZF
3989  A603              ; target). Write the current record of the open file, allocating and deblocking disk blocks as
3990  A603              ; needed.
3991  A603              ;   In: CURFCB (BDOS_PARAM_PTR) -> active FCB; the BDOS work cells for current-record (FCB_CURREC) /
3992  A603              ;       record-count (FCB_RECCOUNT) have been primed from the FCB by DRV_INSTALL_RWTS_3; DMA holds the
3993  A603              ;       caller's record; WRITE_TYPE_FLAG = write type (1 = sequential, 2 = random); BDOS_RETVAL = seek
3994  A603              ;       create/extend mode flag.
3995  A603              ;   Out: A = BDOS return code (0 = OK, 2 = disk full); status returned through BDOS_RET_RESULT; FCB
3996  A603              ;        allocation map / record count updated; host sector written. (OBSERVED: only the disk-full=2
3997  A603              ;        path is taken here; other error codes come from sub-routines.)
3998  A603              ;   Clobbers: A, BC, DE, HL, flags.
3999  A603              ;   Algorithm: clear the directory-update flag (RW_DIRECTION_FLAG); fetch the current record index and reject
4000  A603              ;              it if >= 128 (extent full). Compute the FCB allocation-map SLOT for this record and
4001  A603              ;              read the block number already stored there: if it is non-zero the block is already
4002  A603              ;              allocated, so branch straight to the write phase. If it is zero, recompute the slot
4003  A603              ;              index, fetch the block stored in the PREVIOUS slot as an allocation hint, then call
4004  A603              ;              the disk-map allocator (ALLOC_GET_BLOCK) to grab a fresh block. Store the (new or
4005  A603              ;              existing) block number into the FCB allocation slot, then perform the physical write
4006  A603              ;              and update the extent record count. Mirrors the standard CP/M 2.2 BDOS write routine.
4007  A603              ;              [RE]
4008  A603              ; ----------------------------------------------------------------------
4009  A603              BDOS_WRITE:
4010  A603                      ; Clear the directory-update-needed flag (RW_DIRECTION_FLAG) before starting this write.
4011  A603 3E 00                LD A,$00
4012  A605 32 D3 A9             LD (RW_DIRECTION_FLAG),A
4013  A608                      ; Drive read-only / select check (raises a BDOS error overlay if the drive is not writable).
4014  A608 CD 54 A1             CALL CHECK_DRIVE_READONLY
4015  A60B                      ; HL = pointer to the active FCB (CURFCB).
4016  A60B 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
4017  A60E CD 47 A1             CALL CHECK_DIRENT_READONLY_INNER
4018  A611 CD BB A0             CALL DRV_INSTALL_RWTS_3
4019  A614                      ; Load the current record number within the extent (primed from the FCB).
4020  A614 3A E3 A9             LD A,(FCB_CURREC)
4021  A617                      ; Record index 128 means the extent is full -> cannot write, report error.
4022  A617 FE 80                CP $80
4023  A619                      ; Extent full / index out of range: bail to the BDOS error path.
4024  A619 D2 05 9F             JP NC,BDOS_RET_ONE
4025  A61C CD 77 A0             CALL DISK_STORE_SEC_TRK_14
4026  A61F CD 84 A0             CALL DISK_STORE_SEC_TRK_16
4027  A622                      ; C = 0: existing-block write mode (no zero-fill); used only if the block is already
4028  A622                      ; allocated.
4029  A622 0E 00                LD C,$00
4030  A624                      ; Block already allocated (slot held a non-zero block) -> skip allocation, go to the write
4031  A624                      ; phase.
4032  A624 C2 6E A6             JP NZ,BDOS_WRITE_PHASE
4033  A627                      ; Recompute the FCB allocation-map slot index for the current record (A = slot index, NOT a
4034  A627                      ; disk block).
4035  A627 CD 3E A0             CALL DISK_STORE_SEC_TRK_6
4036  A62A                      ; Save the allocation-slot index for use when storing the new block number.
4037  A62A 32 D7 A9             LD (ALLOC_SLOT_INDEX),A
4038  A62D 01 00 00             LD BC,$0000
4039  A630 B7                   OR A
4040  A631                      ; Slot index 0 (first slot) -> skip the previous-slot fetch; go allocate a fresh block.
4041  A631 CA 3B A6             JP Z,BDOS_WRITE_ALLOCBLK
4042  A634 4F                   LD C,A
4043  A635 0B                   DEC BC
4044  A636                      ; Fetch the block stored in the PREVIOUS slot (BC = slot-1) as the allocation starting hint
4045  A636                      ; -> HL.
4046  A636 CD 5E A0             CALL DISK_STORE_SEC_TRK_10
4047  A639 44                   LD B,H
4048  A63A 4D                   LD C,L
4049  A63B              ; ----------------------------------------------------------------------
4050  A63B              ; BDOS_WRITE_ALLOCBLK -- allocate a fresh data block from the disk allocation vector, or return
4051  A63B              ; 'disk full'.
4052  A63B              ;   In: BC = allocation hint (block from the previous slot, or 0); CURFCB context valid.
4053  A63B              ;   Out: on success HL = newly allocated block number and control falls into BDOS_WRITE_STOREBLK; on
4054  A63B              ;        no free block, returns A=2 (disk full) via BDOS_RET_RESULT.
4055  A63B              ;   Clobbers: A, BC, DE, HL, flags.
4056  A63B              ;   Algorithm: call the disk-map allocator ALLOC_GET_BLOCK, which scans the drive allocation bitmap
4057  A63B              ;              (up to MAX_BLOCK_DSM), marks a free block in use and returns HL = its block number
4058  A63B              ;              (HL = 0 when the disk is full). If HL is zero, set A=2 and return the disk-full
4059  A63B              ;              status; otherwise fall through to record the new block in the FCB. [RE]
4060  A63B              ; ----------------------------------------------------------------------
4061  A63B              BDOS_WRITE_ALLOCBLK:
4062  A63B                      ; Allocate a fresh block from the drive allocation bitmap; HL = new block number (0 = disk
4063  A63B                      ; full).
4064  A63B CD BE A3             CALL ALLOC_GET_BLOCK
4065  A63E 7D                   LD A,L
4066  A63F                      ; Test HL for zero (no free block was found).
4067  A63F B4                   OR H
4068  A640                      ; Non-zero block: proceed to record it in the FCB.
4069  A640 C2 48 A6             JP NZ,BDOS_WRITE_STOREBLK
4070  A643                      ; A = 2: disk-full return code.
4071  A643 3E 02                LD A,$02
4072  A645                      ; Return disk-full status to the caller.
4073  A645 C3 01 9F             JP BDOS_RET_RESULT
4074  A648              ; ----------------------------------------------------------------------
4075  A648              ; BDOS_WRITE_STOREBLK -- store the (new or existing) block number into the FCB allocation slot for
4076  A648              ; the current record.
4077  A648              ;   In: HL = block number; CURFCB (BDOS_PARAM_PTR) = active FCB; ALLOC_SLOT_INDEX = allocation-slot index
4078  A648              ;       within the extent; BLOCK_WIDTH_FLAG selects 1-byte vs 2-byte block entries.
4079  A648              ;   Out: FCB allocation map updated with the block number at the computed slot.
4080  A648              ;   Clobbers: A, BC, DE, HL, flags.
4081  A648              ;   Algorithm: save the block number to CUR_BLOCK_NUMBER (for the write phase) into DE; point HL at the FCB
4082  A648              ;              allocation map (FCB+16); read the slot index. If BLOCK_WIDTH_FLAG selects 8-bit
4083  A648              ;              blocks, add the slot index to HL (via DIRENT_PTR_ADD) and store one byte; otherwise
4084  A648              ;              jump to the 16-bit store path. [RE]
4085  A648              ; ----------------------------------------------------------------------
4086  A648              BDOS_WRITE_STOREBLK:
4087  A648                      ; Save the block number for the write phase (host record/sector base).
4088  A648 22 E5 A9             LD (CUR_BLOCK_NUMBER),HL
4089  A64B EB                   EX DE,HL
4090  A64C 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
4091  A64F                      ; the FCB's allocation map
4092  A64F 01 10 00             LD BC,FCB.DIRECTORY_ENTRY.AL
4093  A652 09                   ADD HL,BC
4094  A653                      ; Test whether the drive uses 8-bit (small disk) or 16-bit block numbers.
4095  A653 3A DD A9             LD A,(BLOCK_WIDTH_FLAG)
4096  A656 B7                   OR A
4097  A657                      ; A = allocation-slot index within the FCB extent.
4098  A657 3A D7 A9             LD A,(ALLOC_SLOT_INDEX)
4099  A65A                      ; 16-bit-block-number drive: store the block number as a 2-byte entry.
4100  A65A CA 64 A6             JP Z,BDOS_WRITE_STOREBLK16
4101  A65D                      ; Add the slot index to HL = address of the single-byte slot inside the FCB map.
4102  A65D CD 64 A1             CALL DIRENT_PTR_ADD
4103  A660                      ; Store the low byte (8-bit block number) into the FCB slot.
4104  A660 73                   LD (HL),E
4105  A661 C3 6C A6             JP BDOS_WRITE_NEWBLK
4106  A664              ; ----------------------------------------------------------------------
4107  A664              ; BDOS_WRITE_STOREBLK16 -- store a 16-bit block number into the FCB allocation map (large-disk
4108  A664              ; format).
4109  A664              ;   In: HL = FCB allocation-map base (FCB+16); A = slot index; DE = block number.
4110  A664              ;   Out: the 2-byte block number written at FCB+16 + slot*2 (low byte then high byte).
4111  A664              ;   Clobbers: A, BC, HL, flags.
4112  A664              ;   Algorithm: extend the slot index to BC, add it to HL twice (slot*2 byte offset), then store DE
4113  A664              ;              low/high. Falls through to the write phase. [RE]
4114  A664              ; ----------------------------------------------------------------------
4115  A664              BDOS_WRITE_STOREBLK16:
4116  A664                      ; BC = slot index.
4117  A664 4F                   LD C,A
4118  A665 06 00                LD B,$00
4119  A667                      ; Add slot index twice (this is the first add) => byte offset = slot*2 for 16-bit entries.
4120  A667 09                   ADD HL,BC
4121  A668 09                   ADD HL,BC
4122  A669                      ; Store block-number low byte.
4123  A669 73                   LD (HL),E
4124  A66A 23                   INC HL
4125  A66B                      ; Store block-number high byte.
4126  A66B 72                   LD (HL),D
4127  A66C              ; ----------------------------------------------------------------------
4128  A66C              ; BDOS_WRITE_NEWBLK -- mark this write as 'new block, must zero-fill' before the write phase.
4129  A66C              ;   In: control reaches here after a freshly allocated block was recorded in the FCB.
4130  A66C              ;   Out: C = 2, signalling the write phase to zero-fill the unwritten records of the new block.
4131  A66C              ;   Clobbers: C.
4132  A66C              ;   Algorithm: set C=2 (new-block write mode) and fall into the write phase. [RE]
4133  A66C              ; ----------------------------------------------------------------------
4134  A66C              BDOS_WRITE_NEWBLK:
4135  A66C                      ; C = 2: new-block write mode (the block was just allocated, zero-fill it).
4136  A66C 0E 02                LD C,$02
4137  A66E              ; ----------------------------------------------------------------------
4138  A66E              ; BDOS_WRITE_PHASE -- perform the physical write of the current record, honoring the
4139  A66E              ; deblocking/new-block mode.
4140  A66E              ;   In: C = write mode (0 = existing block, 2 = new block); CURFCB context valid; DMA holds the
4141  A66E              ;       caller's record; BDOS_RETVAL = seek create/extend mode flag (00 / FF); WRITE_TYPE_FLAG = BDOS write
4142  A66E              ;       type (1 = sequential, 2 = random).
4143  A66E              ;   Out: host sector updated on disk; control merges into the post-write record-count update;
4144  A66E              ;        returns early if the create/extend flag is set.
4145  A66E              ;   Clobbers: A, BC, DE, HL, flags.
4146  A66E              ;   Algorithm: load BDOS_RETVAL; if it is non-zero (a create/extend was flagged) return so the
4147  A66E              ;              caller can handle it. Otherwise save the mode, compute the host record/sector
4148  A66E              ;              (DISK_STORE_SEC_TRK_17), and branch on write type: random data writes (type 2) go
4149  A66E              ;              directly; sequential writes of a fresh block (mode 2) first zero-fill the
4150  A66E              ;              directory/work buffer and write its records up to the host-sector boundary.
4151  A66E              ;              (OBSERVED: BDOS_RETVAL is the same cell the seek code sets to its phase value;
4152  A66E              ;              calling it a 'host-buffer' flag is not supported -- it is the seek/create mode cell.)
4153  A66E              ;              [RE]
4154  A66E              ; ----------------------------------------------------------------------
4155  A66E              BDOS_WRITE_PHASE:
4156  A66E                      ; Load the seek create/extend mode flag (BDOS_RETVAL; 00 = normal, FF = create/extend
4157  A66E                      ; pending).
4158  A66E 3A 45 9F             LD A,(BDOS_RETVAL)
4159  A671 B7                   OR A
4160  A672                      ; Create/extend flagged (BDOS_RETVAL != 0) -> return to the caller without writing here.
4161  A672 C0                   RET NZ
4162  A673                      ; Preserve the write-mode byte (C) across the sector computation.
4163  A673 C5                   PUSH BC
4164  A674                      ; Compute the host physical record index/sector for the current logical record.
4165  A674 CD 8A A0             CALL DISK_STORE_SEC_TRK_17
4166  A677                      ; Load the BDOS write type (1 = sequential, 2 = random).
4167  A677 3A D5 A9             LD A,(WRITE_TYPE_FLAG)
4168  A67A 3D                   DEC A
4169  A67B 3D                   DEC A
4170  A67C                      ; Write type != 2 (sequential) -> may need the new-block zero-fill path.
4171  A67C C2 BB A6             JP NZ,BDOS_WRITE_DOWRITE
4172  A67F C1                   POP BC
4173  A680 C5                   PUSH BC
4174  A681                      ; A = write mode (was the block freshly allocated?).
4175  A681 79                   LD A,C
4176  A682 3D                   DEC A
4177  A683 3D                   DEC A
4178  A684                      ; Existing block (mode != 2): write directly, no zero-fill.
4179  A684 C2 BB A6             JP NZ,BDOS_WRITE_DOWRITE
4180  A687 E5                   PUSH HL
4181  A688                      ; HL = directory/work buffer to be zero-filled before the new-block write.
4182  A688 2A B9 A9             LD HL,(DIRBUF_PTR)
4183  A68B                      ; D = 0: byte counter for the 128-byte fill loop.
4184  A68B 57                   LD D,A
4185  A68C              ; ----------------------------------------------------------------------
4186  A68C              ; BDOS_WRITE_ZEROFILL -- zero-fill one 128-byte record buffer for a freshly allocated block.
4187  A68C              ;   In: HL = buffer start; A = 0 (fill value); D = 0 (loop counter).
4188  A68C              ;   Out: 128 bytes from HL cleared to 0; HL advanced past the buffer.
4189  A68C              ;   Clobbers: A(=0), D, HL, flags.
4190  A68C              ;   Algorithm: store 0, advance HL, INC D and loop while the sign flag stays clear (D < 128), i.e.
4191  A68C              ;              128 iterations (0..127). Clears the work buffer before writing fresh records into a
4192  A68C              ;              new block. [RE]
4193  A68C              ; ----------------------------------------------------------------------
4194  A68C              BDOS_WRITE_ZEROFILL:
4195  A68C                      ; Store 0 into the buffer byte.
4196  A68C 77                   LD (HL),A
4197  A68D 23                   INC HL
4198  A68E                      ; Advance the 0..127 fill counter.
4199  A68E 14                   INC D
4200  A68F                      ; Loop while D < 128 (sign clear): fill all 128 record bytes.
4201  A68F F2 8C A6             JP P,BDOS_WRITE_ZEROFILL
4202  A692                      ; Point the DMA at the deblocking/host buffer for the fill writes.
4203  A692 CD E0 A1             CALL SET_DMA_TO_DISK_BUF
4204  A695                      ; HL = base host record index for this block's fill.
4205  A695 2A E7 A9             LD HL,(BLOCK_BASE_RECORD)
4206  A698 0E 02                LD C,$02
4207  A69A              ; ----------------------------------------------------------------------
4208  A69A              ; BDOS_WRITE_FILLLOOP -- write the zero-filled records of a new block up to the host-sector
4209  A69A              ; boundary.
4210  A69A              ;   In: HL = current host record index; C = 2 (mode); deblock DMA already pointed at the fill
4211  A69A              ;       buffer.
4212  A69A              ;   Out: the records spanning the host sector written; loops until the record index crosses the
4213  A69A              ;        host-sector mask boundary.
4214  A69A              ;   Clobbers: A, BC, HL, flags.
4215  A69A              ;   Algorithm: save the record index (CUR_BLOCK_NUMBER), translate/seek the host sector (RECORD_TO_TRACK),
4216  A69A              ;              write it (DISK_WRITE_CHECKED), reload the index and mask it with the
4217  A69A              ;              records-per-host-sector mask (DPB_BLM); INC the index and loop until the masked value
4218  A69A              ;              differs (host-sector boundary reached). Then restore the saved record index and
4219  A69A              ;              finalize via RESTORE_USER_DMA. [RE]
4220  A69A              ; ----------------------------------------------------------------------
4221  A69A              BDOS_WRITE_FILLLOOP:
4222  A69A                      ; Save the working host-record index.
4223  A69A 22 E5 A9             LD (CUR_BLOCK_NUMBER),HL
4224  A69D C5                   PUSH BC
4225  A69E                      ; Translate/seek the host track+sector for this record.
4226  A69E CD D1 9F             CALL RECORD_TO_TRACK
4227  A6A1 C1                   POP BC
4228  A6A2                      ; Write the (zeroed) record to the host sector via the BIOS R/W call.
4229  A6A2 CD B8 9F             CALL DISK_WRITE_CHECKED
4230  A6A5 2A E5 A9             LD HL,(CUR_BLOCK_NUMBER)
4231  A6A8 0E 00                LD C,$00
4232  A6AA                      ; Load the records-per-host-sector mask.
4233  A6AA 3A C4 A9             LD A,(DPB_BLM)
4234  A6AD 47                   LD B,A
4235  A6AE                      ; Mask the record index to its position within the host sector.
4236  A6AE A5                   AND L
4237  A6AF                      ; Compare against the host-sector base value (still inside this host sector?).
4238  A6AF B8                   CP B
4239  A6B0 23                   INC HL
4240  A6B1                      ; Loop while still within the same host sector (fill all its records).
4241  A6B1 C2 9A A6             JP NZ,BDOS_WRITE_FILLLOOP
4242  A6B4 E1                   POP HL
4243  A6B5 22 E5 A9             LD (CUR_BLOCK_NUMBER),HL
4244  A6B8                      ; Restore the caller DMA and finalize the new-block fill.
4245  A6B8 CD DA A1             CALL RESTORE_USER_DMA
4246  A6BB              ; ----------------------------------------------------------------------
4247  A6BB              ; BDOS_WRITE_DOWRITE -- write the caller's current record to its host sector and bump the extent
4248  A6BB              ; record count.
4249  A6BB              ;   In: stack holds the mode byte; CURFCB context valid; DMA = caller record.
4250  A6BB              ;   Out: record written; FCB current-record-count cell (FCB_RECCOUNT) advanced when this record extends
4251  A6BB              ;        the extent; C=2 if the count grew; falls into the S2/extent-overflow update.
4252  A6BB              ;   Clobbers: A, BC, DE, HL, flags.
4253  A6BB              ;   Algorithm: translate/seek (RECORD_TO_TRACK) and write (DISK_WRITE_CHECKED) the record; compare
4254  A6BB              ;              the just-written record index (FCB_CURREC) against the extent's stored record count
4255  A6BB              ;              (FCB_RECCOUNT); if it is a new high-water record, store and increment the count and set C=2
4256  A6BB              ;              (extent grew). [RE]
4257  A6BB              ; ----------------------------------------------------------------------
4258  A6BB              BDOS_WRITE_DOWRITE:
4259  A6BB                      ; Translate/seek the host track+sector for the current record.
4260  A6BB CD D1 9F             CALL RECORD_TO_TRACK
4261  A6BE C1                   POP BC
4262  A6BF C5                   PUSH BC
4263  A6C0                      ; Write the caller's record to the host sector via the BIOS R/W call.
4264  A6C0 CD B8 9F             CALL DISK_WRITE_CHECKED
4265  A6C3 C1                   POP BC
4266  A6C4                      ; A = the record index just written within the extent.
4267  A6C4 3A E3 A9             LD A,(FCB_CURREC)
4268  A6C7                      ; HL -> the extent's current record-count cell (FCB_RECCOUNT).
4269  A6C7 21 E1 A9             LD HL,FCB_RECCOUNT
4270  A6CA                      ; Is the written record beyond the current record count?
4271  A6CA BE                   CP (HL)
4272  A6CB                      ; Record is within the existing count -> no count update needed.
4273  A6CB DA D2 A6             JP C,BDOS_WRITE_S2UPDATE
4274  A6CE                      ; Extent grew: store the new record index as the count...
4275  A6CE 77                   LD (HL),A
4276  A6CF                      ; ...and bump it (count = index + 1).
4277  A6CF 34                   INC (HL)
4278  A6D0                      ; C = 2: signal the extent record count was extended.
4279  A6D0 0E 02                LD C,$02
4280  A6D2              ; ----------------------------------------------------------------------
4281  A6D2              ; BDOS_WRITE_S2UPDATE -- refresh the FCB S2 byte and, at end-of-extent, advance the FCB to the next
4282  A6D2              ; extent.
4283  A6D2              ;   In: A = current record/extent state; CURFCB context valid; WRITE_TYPE_FLAG = write type.
4284  A6D2              ;   Out: FCB S2 byte stored with its high bit cleared; on extent rollover (record index 0x7F with
4285  A6D2              ;        sequential write) the record count is written back and the FCB moves to the next extent;
4286  A6D2              ;        otherwise takes the common return.
4287  A6D2              ;   Clobbers: A, BC, HL, flags.
4288  A6D2              ;   Algorithm: (two leading NOPs are padding). Fetch the FCB S2 byte (FCB_GET_S2), clear its high
4289  A6D2              ;              bit and store it back. If the just-written record was the last in the extent (0x7F)
4290  A6D2              ;              AND this is a sequential write (WRITE_TYPE_FLAG == 1), copy the working record count back into
4291  A6D2              ;              the FCB (DRV_INSTALL_RWTS_6) and advance to the next extent (FCB_ADVANCE_RECORD); if
4292  A6D2              ;              no host buffer write is pending, reset the current-record cell; else take the common
4293  A6D2              ;              return. (OBSERVED: the LD HL,$9400 at entry is immediately overwritten by FCB_GET_S2
4294  A6D2              ;              -- it loads no value that is used.) [RE]
4295  A6D2              ; ----------------------------------------------------------------------
4296  A6D2              BDOS_WRITE_S2UPDATE:
4297  A6D2 00                   NOP
4298  A6D3 00                   NOP
4299  A6D4                      ; Vestigial DEAD load -- HL is immediately overwritten by FCB_GET_S2 below; the value is
4300  A6D4                      ; never used. It is NOT a real pointer: 2.20 leaves $9400 here (which merely coincides with
4301  A6D4                      ; the CCP base -- do NOT label it CCP_ENTRY, that mis-relocates), and 2.20B leaves a
4302  A6D4                      ; self-pointer into BDOS code ($A6DF). Reproduce each disk's exact bytes.
4303  A6D4                  IFDEF V220B
4304  A6D4 ~                    LD HL,$A6DF+OS_RELOC     ; 2.20B dead value ($A6DF; -> $D6DF under CFG_56K)
4305  A6D4                  ELSE
4306  A6D4 21 00 94             LD HL,$9400              ; 2.20 dead value (coincidentally == CCP base; not a CCP ref)
4307  A6D7                  ENDIF
4308  A6D7 F5                   PUSH AF
4309  A6D8                      ; HL -> the FCB S2 (extent-module) byte; A = its value.
4310  A6D8 CD 69 A1             CALL FCB_GET_S2
4311  A6DB                      ; Clear the high (modified/in-use) bit of the S2 byte.
4312  A6DB E6 7F                AND $7F
4313  A6DD                      ; Store the updated S2 byte back into the FCB.
4314  A6DD 77                   LD (HL),A
4315  A6DE F1                   POP AF
4316  A6DF                      ; Was the just-written record the last (index 0x7F) of the extent?
4317  A6DF FE 7F                CP $7F
4318  A6E1                      ; Not at end of extent -> done, take the common return.
4319  A6E1 C2 00 A7             JP NZ,BDOS_WRITE_RET
4320  A6E4                      ; Load the BDOS write type.
4321  A6E4 3A D5 A9             LD A,(WRITE_TYPE_FLAG)
4322  A6E7                      ; Only sequential writes (type 1) roll the extent forward here.
4323  A6E7 FE 01                CP $01
4324  A6E9                      ; Random write at extent end -> done, common return.
4325  A6E9 C2 00 A7             JP NZ,BDOS_WRITE_RET
4326  A6EC                      ; Copy the working record count (FCB_CURREC/FCB_RECCOUNT) back into the FCB before rolling over.
4327  A6EC CD D2 A0             CALL DRV_INSTALL_RWTS_6
4328  A6EF                      ; Advance the FCB to the next extent (increment EX, handle module overflow).
4329  A6EF CD 5A A5             CALL FCB_ADVANCE_RECORD
4330  A6F2 21 45 9F             LD HL,BDOS_RETVAL
4331  A6F5 7E                   LD A,(HL)
4332  A6F6 B7                   OR A
4333  A6F7 C2 FE A6             JP NZ,BDOS_WRITE_RESETREC
4334  A6FA 3D                   DEC A
4335  A6FB 32 E3 A9             LD (FCB_CURREC),A
4336  A6FE              ; ----------------------------------------------------------------------
4337  A6FE              ; BDOS_WRITE_RESETREC -- clear the seek/create-mode flag cell after an extent rollover.
4338  A6FE              ;   In: HL -> the BDOS_RETVAL flag cell.
4339  A6FE              ;   Out: that flag cell cleared to 0.
4340  A6FE              ;   Clobbers: (memory only).
4341  A6FE              ;   Algorithm: store 0 through HL to reset the BDOS_RETVAL flag, then fall into the common return.
4342  A6FE              ;              [RE]
4343  A6FE              ; ----------------------------------------------------------------------
4344  A6FE              BDOS_WRITE_RESETREC:
4345  A6FE                      ; Clear the BDOS_RETVAL seek/create-mode flag for the new extent.
4346  A6FE 36 00                LD (HL),$00
4347  A700              ; ----------------------------------------------------------------------
4348  A700              ; BDOS_WRITE_RET -- common exit of the WRITE primitive.
4349  A700              ;   In: write completed (or no further action needed).
4350  A700              ;   Out: tail-jumps to DRV_INSTALL_RWTS_6, which copies the working record/count back into the FCB
4351  A700              ;        and returns to the BDOS dispatcher.
4352  A700              ;   Clobbers: per the tail routine.
4353  A700              ;   Algorithm: tail-jump to the record-count writeback routine. [RE]
4354  A700              ; ----------------------------------------------------------------------
4355  A700              BDOS_WRITE_RET:
4356  A700                      ; Copy the working record/count back into the FCB and return via the shared tail.
4357  A700 C3 D2 A0             JP DRV_INSTALL_RWTS_6
4358  A703              ; ----------------------------------------------------------------------
4359  A703              ; BDOS_SEEK_NOREAD -- SEEK entry that clears the write-type cell, then computes/positions the target
4360  A703              ; extent.
4361  A703              ;   In: CURFCB (BDOS_PARAM_PTR) valid.
4362  A703              ;   Out: as for BDOS_SEEK_COMPUTE below.
4363  A703              ;   Clobbers: A, BC, DE, HL, flags.
4364  A703              ;   Algorithm: clear the write-type cell (WRITE_TYPE_FLAG = 0), then fall straight into BDOS_SEEK_COMPUTE.
4365  A703              ;              (OBSERVED: this entry is used by the random read/write callers
4366  A703              ;              FCB_EXTENT_TO_TRKSEC_8/9 after they set C; BDOS_SEEK_NOREAD itself does not consume C
4367  A703              ;              -- it is merely preserved on the stack across the seek and used by the caller
4368  A703              ;              afterward.) [RE]
4369  A703              ; ----------------------------------------------------------------------
4370  A703              BDOS_SEEK_NOREAD:
4371  A703 AF                   XOR A
4372  A704                      ; Write type = 0 (cleared before the seek).
4373  A704 32 D5 A9             LD (WRITE_TYPE_FLAG),A
4374  A707              ; ----------------------------------------------------------------------
4375  A707              ; BDOS_SEEK_COMPUTE -- compute the target extent/record from the FCB random-record field (R0/R1/R2)
4376  A707              ; and seek the directory to it.
4377  A707              ;   In: CURFCB (BDOS_PARAM_PTR) -> FCB whose random-record bytes (FCB+33..35 = R0/R1/R2) hold the
4378  A707              ;       desired record; BDOS_RETVAL = create/extend mode flag.
4379  A707              ;   Out: B = target S2 (module), C = target extent-within-entry; if the FCB is already positioned
4380  A707              ;        there, returns OK (A=0) via BDOS_RET_RESULT; else repositions the directory; on R2 != 0
4381  A707              ;        returns record-out-of-range. (OBSERVED: BC is also just preserved on the stack for the
4382  A707              ;        calling read/write routine.)
4383  A707              ;   Clobbers: A, BC, DE, HL, flags.
4384  A707              ;   Algorithm: read R0 and combine with R1 into the 16-bit record number. record-within-extent = R0
4385  A707              ;              & 0x7F; extent = ((R1 << 1) | R0.bit7) & 0x1F (C); S2/module = R1 >> 4 (B). If R2
4386  A707              ;              (high random byte) is non-zero the record is out of range -> abort with phase code 6.
4387  A707              ;              Otherwise compare target extent (C vs FCB+12) and S2 (B vs FCB+14): if both already
4388  A707              ;              match, fall through with no positioning; else reposition the directory to the target
4389  A707              ;              extent. Mirrors the standard CP/M 2.2 BDOS random seek. [RE]
4390  A707              ; ----------------------------------------------------------------------
4391  A707              BDOS_SEEK_COMPUTE:
4392  A707 C5                   PUSH BC
4393  A708                      ; HL = pointer to the active FCB (CURFCB).
4394  A708 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
4395  A70B EB                   EX DE,HL
4396  A70C                      ; the FCB's random-record field R0
4397  A70C 21 21 00             LD HL,FCB.R0
4398  A70F 19                   ADD HL,DE
4399  A710 7E                   LD A,(HL)
4400  A711                      ; Record-within-extent = R0 bits 0..6 (0..127).
4401  A711 E6 7F                AND $7F
4402  A713 F5                   PUSH AF
4403  A714 7E                   LD A,(HL)
4404  A715                      ; Rotate R0 bit7 into carry (combined with R1 below for the extent number).
4405  A715 17                   RLA
4406  A716 23                   INC HL
4407  A717 7E                   LD A,(HL)
4408  A718                      ; Rotate R1 left, picking up R0.bit7 from carry: forms (R1 << 1) | R0.bit7.
4409  A718 17                   RLA
4410  A719                      ; Low 5 bits = extent number within the directory entry.
4411  A719 E6 1F                AND $1F
4412  A71B                      ; C = target extent (low part).
4413  A71B 4F                   LD C,A
4414  A71C 7E                   LD A,(HL)
4415  A71D 1F                   RRA
4416  A71E 1F                   RRA
4417  A71F 1F                   RRA
4418  A720 1F                   RRA
4419  A721                      ; Keep R1's high nibble = S2 / extent-module count.
4420  A721 E6 0F                AND $0F
4421  A723                      ; B = target S2 (extent module) value (R1 >> 4).
4422  A723 47                   LD B,A
4423  A724 F1                   POP AF
4424  A725 23                   INC HL
4425  A726 6E                   LD L,(HL)
4426  A727 2C                   INC L
4427  A728 2D                   DEC L
4428  A729                      ; Preset L = seek phase code 6 (the random-record overflow result).
4429  A729 2E 06                LD L,$06
4430  A72B                      ; R2 (high random-record byte) non-zero -> record number out of range, abort the seek.
4431  A72B C2 8B A7             JP NZ,RANDREC_POS_RET
4432  A72E 21 20 00             LD HL,FCB.CR
4433  A731 19                   ADD HL,DE
4434  A732 77                   LD (HL),A
4435  A733                      ; the FCB's EX (extent) byte
4436  A733 21 0C 00             LD HL,FCB.DIRECTORY_ENTRY.EX
4437  A736 19                   ADD HL,DE
4438  A737 79                   LD A,C
4439  A738                      ; Compare target extent (C) against the FCB's current extent.
4440  A738 96                   SUB (HL)
4441  A739                      ; Extent differs -> must reposition the directory to the new extent.
4442  A739 C2 47 A7             JP NZ,BDOS_SEEK_REPOSITION
4443  A73C                      ; the FCB's S2 (module) byte
4444  A73C 21 0E 00             LD HL,FCB.DIRECTORY_ENTRY.S2
4445  A73F 19                   ADD HL,DE
4446  A740 78                   LD A,B
4447  A741                      ; Compare target S2 (B) against the FCB's current S2.
4448  A741 96                   SUB (HL)
4449  A742 E6 7F                AND $7F
4450  A744                      ; Extent and S2 both already current -> nothing to seek, return OK.
4451  A744 CA 7F A7             JP Z,BDOS_SEEK_DONE
4452  A747              ; ----------------------------------------------------------------------
4453  A747              ; BDOS_SEEK_REPOSITION -- close the current extent and open/seek the directory to the requested
4454  A747              ; extent.
4455  A747              ;   In: B = target S2, C = target extent; DE -> FCB; BDOS_RETVAL = create/extend mode flag (0xFF =
4456  A747              ;       create on miss).
4457  A747              ;   Out: FCB extent (EX, +12) and S2 (+14) set to the target; directory positioned at the matching
4458  A747              ;        extent; a phase code is left in L (stored into BDOS_RETVAL at the seek tail); on success
4459  A747              ;        falls into BDOS_SEEK_DONE.
4460  A747              ;   Clobbers: A, BC, DE, HL, flags.
4461  A747              ;   Algorithm: close/flush the currently open extent (F_CLOSE_HND clears the host-buffer/seek cache).
4462  A747              ;              Set phase=3; if BDOS_RETVAL == 0xFF (create mode; INC A gives 0 / Z) take the
4463  A747              ;              extent-allocate path. Otherwise store the new EX (+12) and S2 (+14) into the FCB and
4464  A747              ;              open the matching directory entry (FCB_OPEN_SEARCH). Re-test BDOS_RETVAL (phase 4):
4465  A747              ;              on create, probe the next extent; read the directory record (DIR_MAKE_ENTRY); re-test
4466  A747              ;              (phase 5); then drop into BDOS_SEEK_DONE. [RE]
4467  A747              ; ----------------------------------------------------------------------
4468  A747              BDOS_SEEK_REPOSITION:
4469  A747 C5                   PUSH BC
4470  A748 D5                   PUSH DE
4471  A749                      ; Close the currently open extent (clears the host-buffer/seek cache cells) before
4472  A749                      ; repositioning.
4473  A749 CD A2 A4             CALL F_CLOSE_HND
4474  A74C D1                   POP DE
4475  A74D C1                   POP BC
4476  A74E                      ; Seek phase code 3 (extent-allocate path).
4477  A74E 2E 03                LD L,$03
4478  A750                      ; Load the create/extend mode flag.
4479  A750 3A 45 9F             LD A,(BDOS_RETVAL)
4480  A753                      ; Test for the 0xFF 'create/allocate on miss' value (INC -> 0 / sets Z).
4481  A753 3C                   INC A
4482  A754                      ; Create/allocate mode -> take the extent-allocate path.
4483  A754 CA 84 A7             JP Z,FCB_EXTENT_TO_TRKSEC_7
4484  A757                      ; the FCB's EX (extent) byte
4485  A757 21 0C 00             LD HL,FCB.DIRECTORY_ENTRY.EX
4486  A75A 19                   ADD HL,DE
4487  A75B                      ; Store the new target extent into the FCB.
4488  A75B 71                   LD (HL),C
4489  A75C                      ; Offset 14 = FCB S2 byte.
4490  A75C 21 0E 00             LD HL,FCB.DIRECTORY_ENTRY.S2
4491  A75F 19                   ADD HL,DE
4492  A760                      ; Store the new target S2 (module) into the FCB.
4493  A760 70                   LD (HL),B
4494  A761                      ; Search/open the directory entry for the new extent.
4495  A761 CD 51 A4             CALL FCB_OPEN_SEARCH
4496  A764 3A 45 9F             LD A,(BDOS_RETVAL)
4497  A767 3C                   INC A
4498  A768 C2 7F A7             JP NZ,BDOS_SEEK_DONE
4499  A76B C1                   POP BC
4500  A76C C5                   PUSH BC
4501  A76D                      ; Seek phase code 4.
4502  A76D 2E 04                LD L,$04
4503  A76F                      ; Bump the extent for the next-extent create probe.
4504  A76F 0C                   INC C
4505  A770                      ; Create path: allocate/init the new extent.
4506  A770 CA 84 A7             JP Z,FCB_EXTENT_TO_TRKSEC_7
4507  A773                      ; Read the directory record for the new extent into the scratch buffer.
4508  A773 CD 24 A5             CALL DIR_MAKE_ENTRY
4509  A776                      ; Seek phase code 5.
4510  A776 2E 05                LD L,$05
4511  A778 3A 45 9F             LD A,(BDOS_RETVAL)
4512  A77B 3C                   INC A
4513  A77C                      ; Create path: finalize the new extent.
4514  A77C CA 84 A7             JP Z,FCB_EXTENT_TO_TRKSEC_7
4515  A77F              ; ----------------------------------------------------------------------
4516  A77F              ; BDOS_SEEK_DONE -- successful SEEK exit: restore registers and return OK.
4517  A77F              ;   In: target extent/record now current in the FCB.
4518  A77F              ;   Out: A = 0 (seek OK) returned via BDOS_RET_RESULT; the BC saved at SEEK entry restored.
4519  A77F              ;   Clobbers: A, BC.
4520  A77F              ;   Algorithm: pop the saved BC, set A=0 and return the success status through the BDOS result tail.
4521  A77F              ;              [RE]
4522  A77F              ; ----------------------------------------------------------------------
4523  A77F              BDOS_SEEK_DONE:
4524  A77F                      ; Restore the caller's BC saved at SEEK entry.
4525  A77F C1                   POP BC
4526  A780                      ; A = 0: seek successful.
4527  A780 AF                   XOR A
4528  A781                      ; Return the seek result (0 = OK) to the caller.
4529  A781 C3 01 9F             JP BDOS_RET_RESULT
4530  A784              ; ----------------------------------------------------------------------
4531  A784              ; RANDREC_POS_FAIL -- error tail of the random-record positioning code (BDOS_SEEK_COMPUTE): mark the
4532  A784              ; extent invalid and report.
4533  A784              ;   In: L = error/return code to publish (set by the caller, e.g. 6 = 'random record out of range',
4534  A784              ;       3, 4, 5); one BC frame still pushed by BDOS_SEEK_COMPUTE; BDOS_PARAM_PTR = current FCB
4535  A784              ;       pointer.
4536  A784              ;   Out: FCB S2 byte (offset $0E) forced to $C0; BDOS_RETVAL result cell loaded with L; tail-jumps
4537  A784              ;        via RANDREC_POS_RET to MARK_FCB_S2_HIGHBIT, which then ORs $80 into S2 and returns.
4538  A784              ;   Clobbers: A, HL, BC (popped).
4539  A784              ;   Algorithm: PUSH HL; fetch &FCB.S2 via FCB_GET_S2 and store $C0 into it; POP HL; fall through
4540  A784              ;              into RANDREC_POS_RET, which POPs the BC frame, copies L into the result cell, and JPs
4541  A784              ;              MARK_FCB_S2_HIGHBIT.
4542  A784              ;   [RE] Reached from several points in BDOS_SEEK_COMPUTE when the random record cannot be
4543  A784              ;   positioned (out of range, or a read-mode request that would have to extend the file). Setting S2
4544  A784              ;   to $C0 marks the extent so the file is treated as unwritten/at-EOF; the published L code is the
4545  A784              ;   BDOS error returned to the caller.
4546  A784              ; ----------------------------------------------------------------------
4547  A784              FCB_EXTENT_TO_TRKSEC_7:
4548  A784 E5                   PUSH HL
4549  A785                      ; HL := &FCB.S2 (offset $0E of the current FCB)
4550  A785 CD 69 A1             CALL FCB_GET_S2
4551  A788                      ; S2 := $C0: high bit set (extent marked invalid/unwritten) + zero the module count [RE]
4552  A788 36 C0                LD (HL),$C0
4553  A78A E1                   POP HL
4554  A78B              ; ----------------------------------------------------------------------
4555  A78B              ; RANDREC_POS_RET -- common exit for BDOS_SEEK_COMPUTE: discard the saved BC frame, publish the L
4556  A78B              ; result code, finalize via MARK_FCB_S2_HIGHBIT.
4557  A78B              ;   In: L = result/return code; one BC frame still pushed on the stack from BDOS_SEEK_COMPUTE's
4558  A78B              ;       entry PUSH BC.
4559  A78B              ;   Out: BDOS_RETVAL result cell = L; control transfers to MARK_FCB_S2_HIGHBIT (sets FCB S2 high
4560  A78B              ;        bit, returns to the BDOS dispatcher).
4561  A78B              ;   Clobbers: A, BC (popped).
4562  A78B              ;   Algorithm: POP BC to discard the saved register pair; A := L; store A into the BDOS_RETVAL
4563  A78B              ;              result cell; JP MARK_FCB_S2_HIGHBIT.
4564  A78B              ;   [RE] Entered by fall-through from RANDREC_POS_FAIL and directly (JP NZ from $A72B) when the
4565  A78B              ;   addressed extent differs from the open one. MARK_FCB_S2_HIGHBIT ORs $80 into the FCB S2 byte
4566  A78B              ;   before returning.
4567  A78B              ; ----------------------------------------------------------------------
4568  A78B              RANDREC_POS_RET:
4569  A78B                      ; discard the BC frame pushed on entry to BDOS_SEEK_COMPUTE
4570  A78B C1                   POP BC
4571  A78C 7D                   LD A,L
4572  A78D                      ; publish the return/error code in the BDOS result cell
4573  A78D 32 45 9F             LD (BDOS_RETVAL),A
4574  A790                      ; set FCB S2 high bit, then return to caller
4575  A790 C3 78 A1             JP MARK_FCB_S2_HIGHBIT
4576  A793              ; ----------------------------------------------------------------------
4577  A793              ; F_READRAND_BODY -- BDOS function 33 (Read Random) worker: position the FCB from its random record,
4578  A793              ; then read that record.
4579  A793              ;   In: BDOS_PARAM_PTR = current FCB pointer (random-record field r0/r1/r2 set by the caller);
4580  A793              ;       reached from F_READRAND_H after FCB_AUTO_DRIVE_SELECT.
4581  A793              ;   Out: read result stored in the BDOS result cell (BDOS_RETVAL) by the called read routine; Z from
4582  A793              ;        positioning governs whether the read runs.
4583  A793              ;   Clobbers: A, BC, DE, HL.
4584  A793              ;   Algorithm: C := $FF (read mode = do NOT extend the file); CALL BDOS_SEEK_NOREAD
4585  A793              ;              (BDOS_SEEK_COMPUTE) to convert the random record into extent + current-record fields;
4586  A793              ;              if positioning succeeded (Z), CALL FILE_READ_RECORD to read the addressed record;
4587  A793              ;              RET.
4588  A793              ;   [RE][DOC CP/M 2.2 BDOS fn 33] C=$FF is consumed inside BDOS_SEEK_COMPUTE: when positioning would
4589  A793              ;   require extending the file, INC C on $FF sets Z and diverts to the error tail, so a read past
4590  A793              ;   EOF fails instead of allocating. The conditional CALL Z performs the sector read only when
4591  A793              ;   positioning succeeded (Z).
4592  A793              ; ----------------------------------------------------------------------
4593  A793              FCB_EXTENT_TO_TRKSEC_8:
4594  A793                      ; C := $FF: read mode -- positioning must NOT extend/allocate (INC C->Z triggers the fail
4595  A793                      ; path)
4596  A793 0E FF                LD C,$FF
4597  A795                      ; BDOS_SEEK_COMPUTE: convert random record (r0/r1/r2) into extent + cr; Z on success
4598  A795 CD 03 A7             CALL BDOS_SEEK_NOREAD
4599  A798                      ; if positioned OK, read the addressed record
4600  A798 CC C1 A5             CALL Z,FILE_READ_RECORD
4601  A79B C9                   RET
4602  A79C              ; ----------------------------------------------------------------------
4603  A79C              ; F_WRITERAND_BODY -- BDOS function 34 (Write Random) worker: position the FCB from its random
4604  A79C              ; record, then write that record.
4605  A79C              ;   In: BDOS_PARAM_PTR = current FCB pointer (random-record field set by the caller); reached from
4606  A79C              ;       F_WRITERAND_H after FCB_AUTO_DRIVE_SELECT.
4607  A79C              ;   Out: write result stored in the BDOS result cell (BDOS_RETVAL) by the called write routine; Z
4608  A79C              ;        from positioning governs whether the write runs.
4609  A79C              ;   Clobbers: A, BC, DE, HL.
4610  A79C              ;   Algorithm: C := $00 (write mode = allocate/extend as needed); CALL BDOS_SEEK_NOREAD
4611  A79C              ;              (BDOS_SEEK_COMPUTE) to set extent + current-record from the random record; if
4612  A79C              ;              positioning succeeded (Z), CALL BDOS_WRITE to write the record; RET.
4613  A79C              ;   [RE][DOC CP/M 2.2 BDOS fn 34] C=$00 is consumed inside BDOS_SEEK_COMPUTE: INC C on $00 yields
4614  A79C              ;   $01 (NZ), so the extend path is taken rather than the error tail, allowing a new extent/block to
4615  A79C              ;   be allocated. The conditional CALL Z writes the record only when positioning succeeded (Z).
4616  A79C              ; ----------------------------------------------------------------------
4617  A79C              FCB_EXTENT_TO_TRKSEC_9:
4618  A79C                      ; C := $00: write mode -- positioning may allocate/extend the file (INC C->$01 NZ, no fail)
4619  A79C 0E 00                LD C,$00
4620  A79E                      ; BDOS_SEEK_COMPUTE: convert random record into extent + cr; Z on success
4621  A79E CD 03 A7             CALL BDOS_SEEK_NOREAD
4622  A7A1                      ; if positioned OK, write the addressed record
4623  A7A1 CC 03 A6             CALL Z,BDOS_WRITE
4624  A7A4 C9                   RET
4625  A7A5              ; ----------------------------------------------------------------------
4626  A7A5              ; FCB_RECNUM_FROM_FIELDS -- compute the 24-bit absolute record number from an FCB's record byte plus
4627  A7A5              ; its extent (ex) and S2 fields.
4628  A7A5              ;   In: HL = base pointer to the FCB (or directory entry); DE = byte offset within it of the low
4629  A7A5              ;       record byte to read (e.g. $20 = cr for Set Random Record, $0F for the per-extent record
4630  A7A5              ;       count in Compute File Size).
4631  A7A5              ;   Out: C = low byte, B = mid byte, A = high byte of the record number; A AND $01 leaves Z/NZ on
4632  A7A5              ;        the result's low bit for callers; HL, DE clobbered.
4633  A7A5              ;   Clobbers: A, BC, HL, DE, flags.
4634  A7A5              ;   Algorithm: EX DE,HL so HL=offset, DE=FCB base; ADD HL,DE -> &FCB+offset; C := that byte, B := 0.
4635  A7A5              ;              Read the extent byte (offset $0C): RRCA then AND $80 puts its bit0 into bit7, add to
4636  A7A5              ;              C (carry into B) -- the *128 contribution; RRCA/AND $0F of the same extent byte adds
4637  A7A5              ;              the extent's high nibble into B. Read S2 (offset $0E): shift left 4 (ADD A,A x4), add
4638  A7A5              ;              into B to form the high bits; final AND $01 sets Z/NZ on the low bit of the
4639  A7A5              ;              accumulated value.
4640  A7A5              ;   [RE] Builds the linear absolute record index (record + ex*128 + S2*...) that CP/M 2.2 uses to
4641  A7A5              ;   map directory extents onto a flat record space; shared by Set Random Record (fn 36) and Compute
4642  A7A5              ;   File Size (fn 35).
4643  A7A5              ; ----------------------------------------------------------------------
4644  A7A5              FCB_ALLOC_PREP:
4645  A7A5                      ; HL := caller offset; DE := FCB base pointer
4646  A7A5 EB                   EX DE,HL
4647  A7A6                      ; HL := &FCB + offset (the low record byte)
4648  A7A6 19                   ADD HL,DE
4649  A7A7                      ; C := low record bits from that byte
4650  A7A7 4E                   LD C,(HL)
4651  A7A8 06 00                LD B,$00
4652  A7AA                      ; offset $0C = FCB extent (ex) byte
4653  A7AA 21 0C 00             LD HL,FCB.DIRECTORY_ENTRY.EX
4654  A7AD 19                   ADD HL,DE
4655  A7AE 7E                   LD A,(HL)
4656  A7AF 0F                   RRCA
4657  A7B0                      ; extent bit0 -> record bit7 (the ex*128 contribution)
4658  A7B0 E6 80                AND $80
4659  A7B2 81                   ADD A,C
4660  A7B3 4F                   LD C,A
4661  A7B4 3E 00                LD A,$00
4662  A7B6 88                   ADC A,B
4663  A7B7 47                   LD B,A
4664  A7B8 7E                   LD A,(HL)
4665  A7B9 0F                   RRCA
4666  A7BA E6 0F                AND $0F
4667  A7BC 80                   ADD A,B
4668  A7BD 47                   LD B,A
4669  A7BE                      ; offset $0E = FCB S2 byte (extent-high / module)
4670  A7BE 21 0E 00             LD HL,FCB.DIRECTORY_ENTRY.S2
4671  A7C1 19                   ADD HL,DE
4672  A7C2 7E                   LD A,(HL)
4673  A7C3                      ; first of four ADD A,A: shift S2 left to form the high record bits
4674  A7C3 87                   ADD A,A
4675  A7C4 87                   ADD A,A
4676  A7C5 87                   ADD A,A
4677  A7C6 87                   ADD A,A
4678  A7C7 F5                   PUSH AF
4679  A7C8 80                   ADD A,B
4680  A7C9 47                   LD B,A
4681  A7CA F5                   PUSH AF
4682  A7CB E1                   POP HL
4683  A7CC 7D                   LD A,L
4684  A7CD E1                   POP HL
4685  A7CE B5                   OR L
4686  A7CF                      ; set Z/NZ on the low bit of the result for callers
4687  A7CF E6 01                AND $01
4688  A7D1 C9                   RET
4689  A7D2              ; ----------------------------------------------------------------------
4690  A7D2              ; F_COMPSIZE_BODY -- BDOS function 35 (Compute File Size) worker: scan the directory and write the
4691  A7D2              ; max record number into r0/r1/r2.
4692  A7D2              ;   In: BDOS_PARAM_PTR = current FCB pointer; reached from F_SIZE_H after FCB_AUTO_DRIVE_SELECT.
4693  A7D2              ;   Out: FCB random-record bytes r0/r1/r2 (offsets $21-$23) set to the file's record count (one past
4694  A7D2              ;        the highest record across all matching directory extents).
4695  A7D2              ;   Clobbers: A, BC, DE, HL.
4696  A7D2              ;   Algorithm: C := $0C and CALL DIR_SEARCH_FIRST to begin a directory search masked over the first
4697  A7D2              ;              12 FCB bytes (drive+name+type; the extent byte is NOT matched). Point HL at FCB+$21
4698  A7D2              ;              and zero the three random-record bytes (D is 0 from LD DE,$0021). Then loop over
4699  A7D2              ;              every matching directory entry (falls into COMPSIZE_SCAN_LOOP): for each, compute its
4700  A7D2              ;              record number via FCB_RECNUM_FROM_FIELDS at offset $0F and keep the running maximum
4701  A7D2              ;              in r0/r1/r2; when the search exhausts, the largest record number remains stored.
4702  A7D2              ;   [RE][DOC CP/M 2.2 BDOS fn 35] Result is a record count (next free record), one past the highest
4703  A7D2              ;   used record; the loop mirrors the canonical 'scan directory, max(extent record number)'
4704  A7D2              ;   algorithm.
4705  A7D2              ; ----------------------------------------------------------------------
4706  A7D2              FCB_ALLOC_BLOCK_NUM_2:
4707  A7D2                      ; mask = first $0C (12) FCB bytes: drive+name+type (extent NOT compared) when scanning
4708  A7D2 0E 0C                LD C,$0C
4709  A7D4                      ; begin a masked directory search over those 12 bytes
4710  A7D4 CD 18 A3             CALL DIR_SEARCH_FIRST
4711  A7D7 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
4712  A7DA                      ; the FCB's random-record field r0 (D=0 used to zero the bytes)
4713  A7DA 11 21 00             LD DE,FCB.R0
4714  A7DD 19                   ADD HL,DE
4715  A7DE E5                   PUSH HL
4716  A7DF                      ; r0 := 0 (zero the 3-byte running maximum)
4717  A7DF 72                   LD (HL),D
4718  A7E0 23                   INC HL
4719  A7E1                      ; r1 := 0
4720  A7E1 72                   LD (HL),D
4721  A7E2 23                   INC HL
4722  A7E3                      ; r2 := 0
4723  A7E3 72                   LD (HL),D
4724  A7E4              ; ----------------------------------------------------------------------
4725  A7E4              ; COMPSIZE_SCAN_LOOP -- per-directory-entry step of Compute File Size: fold each extent's record
4726  A7E4              ; number into the running max.
4727  A7E4              ;   In: stack top = pointer to the FCB random-record max (r0/r1/r2); a masked directory search is in
4728  A7E4              ;       progress.
4729  A7E4              ;   Out: on directory exhaustion, exits via COMPSIZE_DONE (pop, return); otherwise updates the
4730  A7E4              ;        3-byte max in place and continues.
4731  A7E4              ;   Clobbers: A, BC, DE, HL.
4732  A7E4              ;   Algorithm: CALL CUR_RECORD_BYTES_EQUAL to test whether the search is exhausted; if so (Z) JP
4733  A7E4              ;              COMPSIZE_DONE. Else CALL FCB_BUF_PTR_ADD_OFFSET to point at this entry in the
4734  A7E4              ;              directory buffer, then FCB_ALLOC_PREP at offset $0F to get the candidate record
4735  A7E4              ;              number in C(lo)/B(mid)/A(hi). Reload &r0 (POP/PUSH HL), 24-bit subtract candidate -
4736  A7E4              ;              stored (SUB / SBC / SBC over r0,r1,r2); if candidate < stored (carry), JP
4737  A7E4              ;              COMPSIZE_NEXT keeping the stored max; otherwise overwrite r2,r1,r0 with the
4738  A7E4              ;              candidate; fall into COMPSIZE_NEXT.
4739  A7E4              ;   [RE] Implements a running max over directory extents; the 24-bit subtract decides whether this
4740  A7E4              ;   extent extends the file further than any seen so far.
4741  A7E4              ; ----------------------------------------------------------------------
4742  A7E4              COMPSIZE_SCAN_LOOP:
4743  A7E4                      ; test whether the directory search is exhausted; Z = no more entries
4744  A7E4 CD F5 A1             CALL CUR_RECORD_BYTES_EQUAL
4745  A7E7                      ; search exhausted -> finish (pop saved ptr and return)
4746  A7E7 CA 0C A8             JP Z,COMPSIZE_DONE
4747  A7EA                      ; HL := directory buffer + this entry's byte offset
4748  A7EA CD 5E A1             CALL FCB_BUF_PTR_ADD_OFFSET
4749  A7ED                      ; offset $0F = the entry's record-count byte for FCB_RECNUM_FROM_FIELDS
4750  A7ED 11 0F 00             LD DE,$000F
4751  A7F0                      ; candidate record number -> C(lo)/B(mid)/A(hi)
4752  A7F0 CD A5 A7             CALL FCB_ALLOC_PREP
4753  A7F3 E1                   POP HL
4754  A7F4 E5                   PUSH HL
4755  A7F5 5F                   LD E,A
4756  A7F6                      ; begin 24-bit compare: candidate - stored max over r0/r1/r2
4757  A7F6 79                   LD A,C
4758  A7F7 96                   SUB (HL)
4759  A7F8 23                   INC HL
4760  A7F9 78                   LD A,B
4761  A7FA 9E                   SBC A,(HL)
4762  A7FB 23                   INC HL
4763  A7FC 7B                   LD A,E
4764  A7FD 9E                   SBC A,(HL)
4765  A7FE                      ; candidate < stored max -> keep stored max, skip the store
4766  A7FE DA 06 A8             JP C,COMPSIZE_NEXT
4767  A801                      ; candidate >= max: store new high byte (r2)
4768  A801 73                   LD (HL),E
4769  A802 2B                   DEC HL
4770  A803                      ; store new mid byte (r1)
4771  A803 70                   LD (HL),B
4772  A804 2B                   DEC HL
4773  A805                      ; store new low byte (r0)
4774  A805 71                   LD (HL),C
4775  A806              ; ----------------------------------------------------------------------
4776  A806              ; COMPSIZE_NEXT -- Compute File Size loop continuation: advance the directory search and re-enter
4777  A806              ; the scan loop.
4778  A806              ;   In: directory search state live; stack top = pointer to the running r0/r1/r2 maximum.
4779  A806              ;   Out: re-enters COMPSIZE_SCAN_LOOP (COMPSIZE_SCAN_LOOP) after advancing to the next directory
4780  A806              ;        entry.
4781  A806              ;   Clobbers: A, BC, DE, HL.
4782  A806              ;   Algorithm: CALL BDOS_DIR_SCAN_NEXT to advance the masked directory search by one entry; JP
4783  A806              ;              COMPSIZE_SCAN_LOOP.
4784  A806              ;   [RE] Joined both from the 'candidate < max' early path and after a store; BDOS_DIR_SCAN_NEXT
4785  A806              ;   performs the next directory read/match.
4786  A806              ; ----------------------------------------------------------------------
4787  A806              COMPSIZE_NEXT:
4788  A806                      ; advance the masked directory search to the next matching entry
4789  A806 CD 2D A3             CALL BDOS_DIR_SCAN_NEXT
4790  A809                      ; loop back to fold the next extent into the max
4791  A809 C3 E4 A7             JP COMPSIZE_SCAN_LOOP
4792  A80C              ; ----------------------------------------------------------------------
4793  A80C              ; COMPSIZE_DONE -- Compute File Size exit: discard the saved max pointer and return.
4794  A80C              ;   In: stack top = pointer to the FCB r0/r1/r2 max (already written in place).
4795  A80C              ;   Out: returns to the F_SIZE_H caller; FCB random-record field holds the computed file size.
4796  A80C              ;   Clobbers: HL.
4797  A80C              ;   Algorithm: POP HL to balance the PUSH HL done in FCB_ALLOC_BLOCK_NUM_2 before the scan; RET.
4798  A80C              ;   [RE] Sole loop exit, reached when the directory search is exhausted.
4799  A80C              ; ----------------------------------------------------------------------
4800  A80C              COMPSIZE_DONE:
4801  A80C                      ; balance the saved r0/r1/r2 pointer pushed before the scan loop
4802  A80C E1                   POP HL
4803  A80D C9                   RET
4804  A80E              ; ----------------------------------------------------------------------
4805  A80E              ; F_RANDREC_H -- BDOS function 36 (Set Random Record): compute the random-record field of the
4806  A80E              ; current FCB from its sequential position.
4807  A80E              ;   In: current FCB pointer in BDOS cell BDOS_PARAM_PTR (the FCB whose sequential extent/cr fields
4808  A80E              ;       are to be converted).
4809  A80E              ;   Out: bytes r0/r1/r2 (FCB offsets $21..$23) written with the 24-bit record number derived from
4810  A80E              ;        the FCB's extent and current-record fields.
4811  A80E              ;   Clobbers: A, BC, DE, HL.
4812  A80E              ;   Algorithm: call FCB_ALLOC_PREP with HL=FCB base and DE=$0020, which folds the cr (current-record
4813  A80E              ;              at FCB+$20), the extent number and the extent-high bit into a record count returned
4814  A80E              ;              in C (low) / B (high) / A (overflow), and leaves DE = the FCB base pointer; then form
4815  A80E              ;              HL = FCB+$0021 (DE + $0021) and store C,B,A into FCB[$21],[$22],[$23].
4816  A80E              ;   [RE] verified against canonical CP/M 2.2 Set Random Record (dispatch fn 36 at $9C8F);
4817  A80E              ;   FCB_ALLOC_PREP is the standard extent->record-count fold.
4818  A80E              ; ----------------------------------------------------------------------
4819  A80E              F_RANDREC_H:
4820  A80E                      ; HL = pointer to the current FCB (the file whose sequential position we are converting)
4821  A80E 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
4822  A811                      ; DE = $20: FCB_ALLOC_PREP reads the cr/extent region at FCB+$20 and returns DE = the FCB
4823  A811                      ; base
4824  A811 11 20 00             LD DE,$0020
4825  A814                      ; fold cr + extent# + extent-high bit into a 24-bit record number -> C low, B high, A
4826  A814                      ; overflow; returns DE = FCB base
4827  A814 CD A5 A7             CALL FCB_ALLOC_PREP
4828  A817                      ; HL = $0021; the next ADD HL,DE makes HL = FCB + $21, the start of the 3-byte random-record
4829  A817                      ; field r0,r1,r2
4830  A817 21 21 00             LD HL,FCB.R0
4831  A81A 19                   ADD HL,DE
4832  A81B                      ; store r0 (record number, low byte)
4833  A81B 71                   LD (HL),C
4834  A81C 23                   INC HL
4835  A81D                      ; store r1 (record number, high byte)
4836  A81D 70                   LD (HL),B
4837  A81E 23                   INC HL
4838  A81F                      ; store r2 (record number overflow / random-record overflow byte)
4839  A81F 77                   LD (HL),A
4840  A820 C9                   RET
4841  A821              ; ----------------------------------------------------------------------
4842  A821              ; DRV_INSTALL_RWTS_17 -- Select-disk / log-in worker: ensure the drive in BDOS_CUR_DRIVE is logged
4843  A821              ; in, and rebuild its allocation vector if it was not.
4844  A821              ;   In: BDOS_CUR_DRIVE = requested (current) drive number 0..15; DRV_SELECT_VECTOR = working login/select
4845  A821              ;       vector.
4846  A821              ;   Out: if the drive was newly logged in, its directory is scanned (BDOS_ERR_SELECT) and its
4847  A821              ;        allocation vector rebuilt (ALLOC_VECTOR_BUILD); DRV_SELECT_VECTOR updated with the drive's login bit.
4848  A821              ;   Clobbers: A, BC, DE, HL.
4849  A821              ;   Algorithm: load the working login vector DRV_SELECT_VECTOR; build a single-bit mask for the requested drive
4850  A821              ;              (DRV_INSTALL_RWTS_10 shifts); test (BDOS_RANDREC_3) whether the drive's DPB is
4851  A821              ;              already established; if not yet logged in (Z) call BDOS_ERR_SELECT to log it in /
4852  A821              ;              scan its directory; if the login bit was already set (RRA -> carry) just return;
4853  A821              ;              otherwise OR this drive's bit into DRV_SELECT_VECTOR (DRIVE_BIT_OR_INTO_VECTOR), store it, and fall into
4854  A821              ;              ALLOC_VECTOR_BUILD to (re)build the allocation vector.
4855  A821              ;   [RE] the standard CP/M 2.2 select-disk login path reached from DRV_SET (fn 14) and DRV_ALLRESET
4856  A821              ;   (fn 13). [?] the A=L / RRA already-logged-in test is inferred from the surrounding flow, not
4857  A821              ;   proven from these bytes alone.
4858  A821              ; ----------------------------------------------------------------------
4859  A821              DRV_INSTALL_RWTS_17:
4860  A821                      ; HL = working login/select vector
4861  A821 2A AF A9             LD HL,(DRV_SELECT_VECTOR)
4862  A824                      ; A = requested drive number
4863  A824 3A 42 9F             LD A,(BDOS_CUR_DRIVE)
4864  A827 4F                   LD C,A
4865  A828                      ; shift to form the single-bit drive mask for this drive
4866  A828 CD EA A0             CALL DRV_INSTALL_RWTS_10
4867  A82B E5                   PUSH HL
4868  A82C EB                   EX DE,HL
4869  A82D                      ; establish/test the drive's DPB; sets Z if the drive needs logging in
4870  A82D CD 59 9F             CALL BDOS_RANDREC_3
4871  A830 E1                   POP HL
4872  A831                      ; drive not yet logged in: run the disk log-in / directory scan
4873  A831 CC 47 9F             CALL Z,BDOS_ERR_SELECT
4874  A834 7D                   LD A,L
4875  A835                      ; rotate bit 0 of the drive mask into carry: carry set => this drive already had its login
4876  A835                      ; bit set
4877  A835 1F                   RRA
4878  A836                      ; already logged in: nothing more to do
4879  A836 D8                   RET C
4880  A837 2A AF A9             LD HL,(DRV_SELECT_VECTOR)
4881  A83A 4D                   LD C,L
4882  A83B 44                   LD B,H
4883  A83C                      ; OR this drive's bit into the working login vector
4884  A83C CD 0B A1             CALL DRIVE_BIT_OR_INTO_VECTOR
4885  A83F                      ; store the updated working login vector
4886  A83F 22 AF A9             LD (DRV_SELECT_VECTOR),HL
4887  A842                      ; tail into rebuild-allocation-vector for the freshly logged-in drive
4888  A842 C3 A3 A2             JP ALLOC_VECTOR_BUILD
4889  A845              ; ----------------------------------------------------------------------
4890  A845              ; DRV_SET_H -- BDOS function 14 (Select Disk): make the drive in DRV_SELECT_ARG the current drive.
4891  A845              ;   In: DRV_SELECT_ARG = desired drive number; BDOS_CUR_DRIVE = current drive number.
4892  A845              ;   Out: if the drive changed, BDOS_CUR_DRIVE is updated and the drive is logged in / allocation
4893  A845              ;        vector rebuilt (via DRV_INSTALL_RWTS_17); otherwise no-op.
4894  A845              ;   Clobbers: A, HL (and whatever DRV_INSTALL_RWTS_17 clobbers).
4895  A845              ;   Algorithm: compare desired drive (DRV_SELECT_ARG) with current (BDOS_CUR_DRIVE); if equal return; else
4896  A845              ;              store the new current drive and jump to the select/log-in worker.
4897  A845              ;   [RE] dispatch fn 14 at $9C63; matches canonical CP/M 2.2 Select Disk.
4898  A845              ; ----------------------------------------------------------------------
4899  A845              DRV_SET_H:
4900  A845                      ; A = requested drive number
4901  A845 3A D6 A9             LD A,(DRV_SELECT_ARG)
4902  A848                      ; HL -> current-drive cell
4903  A848 21 42 9F             LD HL,BDOS_CUR_DRIVE
4904  A84B                      ; already the current drive?
4905  A84B BE                   CP (HL)
4906  A84C                      ; yes: nothing to do
4907  A84C C8                   RET Z
4908  A84D                      ; set the new current drive
4909  A84D 77                   LD (HL),A
4910  A84E                      ; log it in / rebuild its allocation vector
4911  A84E C3 21 A8             JP DRV_INSTALL_RWTS_17
4912  A851              ; ----------------------------------------------------------------------
4913  A851              ; FCB_AUTO_DRIVE_SELECT -- common file-operation preamble: honor the drive prefix in the caller's
4914  A851              ; FCB, temporarily selecting that drive.
4915  A851              ;   In: BDOS_PARAM_PTR = pointer to the caller's FCB (byte 0 = drive prefix, 0=default else
4916  A851              ;       drive+1); BDOS_CUR_DRIVE = current drive; BDOS_USER_NUM = current user number.
4917  A851              ;   Out: if the FCB names an explicit drive, that drive is selected (DRV_SELECT_ARG set, DRV_SET_H called)
4918  A851              ;        and the prior drive is saved in the restore cells (DRV_RESTORE_FLAG flag=$FF, DRV_SAVED_DRIVE=saved drive,
4919  A851              ;        DRV_SAVED_FCB_BYTE=saved FCB drive byte); the FCB's drive byte is rewritten to OR in the current user
4920  A851              ;        number.
4921  A851              ;   Clobbers: A, HL.
4922  A851              ;   Algorithm: set restore-pending flag DRV_RESTORE_FLAG=$FF; read FCB byte0, mask $1F and DEC to get drive
4923  A851              ;              index into DRV_SELECT_ARG; if >=$1E (no explicit drive / out of range) skip the switch; else
4924  A851              ;              save current drive (BDOS_CUR_DRIVE->DRV_SAVED_DRIVE) and original FCB byte (->DRV_SAVED_FCB_BYTE), strip
4925  A851              ;              the drive prefix bits ($E0 mask) from FCB byte0, and select the requested drive via
4926  A851              ;              DRV_SET_H; finally OR the current user number (BDOS_USER_NUM) into FCB byte0.
4927  A851              ;   [RE] this is the auto-disk-select / FCB drive-prefix handler that nearly every file BDOS call
4928  A851              ;   funnels through; the matching restore is FCB_AUTO_DRIVE_RESTORE. The old auto-label
4929  A851              ;   'FCB_AUTO_DRIVE_SELECT' is a misnomer (it does not seek tracks).
4930  A851              ; ----------------------------------------------------------------------
4931  A851              FCB_AUTO_DRIVE_SELECT:
4932  A851                      ; mark 'a temporary drive switch is pending' so the epilogue restores it
4933  A851 3E FF                LD A,$FF
4934  A853                      ; store the restore-pending flag
4935  A853 32 DE A9             LD (DRV_RESTORE_FLAG),A
4936  A856                      ; HL -> caller's FCB; (HL) = drive-prefix byte
4937  A856 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
4938  A859 7E                   LD A,(HL)
4939  A85A                      ; isolate the drive-prefix field of FCB byte 0
4940  A85A E6 1F                AND $1F
4941  A85C                      ; convert prefix (1..16) to drive index (0..15); $00 (default) wraps to $FF
4942  A85C 3D                   DEC A
4943  A85D                      ; record the drive this FCB asks for
4944  A85D 32 D6 A9             LD (DRV_SELECT_ARG),A
4945  A860                      ; no explicit drive (default => $FF) or out of range?
4946  A860 FE 1E                CP $1E
4947  A862                      ; yes: skip the drive switch, just merge the user number
4948  A862 D2 75 A8             JP NC,FCB_MERGE_USER
4949  A865 3A 42 9F             LD A,(BDOS_CUR_DRIVE)
4950  A868                      ; save the current drive so the epilogue can restore it
4951  A868 32 DF A9             LD (DRV_SAVED_DRIVE),A
4952  A86B 7E                   LD A,(HL)
4953  A86C                      ; save the original FCB drive-prefix byte for restore
4954  A86C 32 E0 A9             LD (DRV_SAVED_FCB_BYTE),A
4955  A86F                      ; clear the drive-prefix bits, leaving the high flag bits of FCB byte0
4956  A86F E6 E0                AND $E0
4957  A871 77                   LD (HL),A
4958  A872                      ; temporarily select the drive named by the FCB
4959  A872 CD 45 A8             CALL DRV_SET_H
4960  A875              ; ----------------------------------------------------------------------
4961  A875              ; FCB_MERGE_USER -- tail of FCB_AUTO_DRIVE_SELECT: OR the current user number into the FCB's drive
4962  A875              ; byte.
4963  A875              ;   In: BDOS_USER_NUM = current user number; BDOS_PARAM_PTR = pointer to the FCB.
4964  A875              ;   Out: FCB byte0 |= current user number.
4965  A875              ;   Clobbers: A, HL.
4966  A875              ;   Algorithm: load user number, OR with FCB byte0, store back.
4967  A875              ;   [RE] shared exit of the auto-disk-select preamble.
4968  A875              ; ----------------------------------------------------------------------
4969  A875              FCB_MERGE_USER:
4970  A875                      ; A = current user number
4971  A875 3A 41 9F             LD A,(BDOS_USER_NUM)
4972  A878 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
4973  A87B                      ; merge the user number into the FCB's drive/flags byte
4974  A87B B6                   OR (HL)
4975  A87C                      ; write it back
4976  A87C 77                   LD (HL),A
4977  A87D C9                   RET
4978  A87E              ; ----------------------------------------------------------------------
4979  A87E              ; S_BDOSVER_H -- BDOS function 12 (Return Version Number): report CP/M 2.2.
4980  A87E              ;   In: none.
4981  A87E              ;   Out: low byte of the BDOS result set to $22 (= version 2.2) via BDOS_RET_RESULT, which writes
4982  A87E              ;        only BDOS_RETVAL (the result low byte / register A).
4983  A87E              ;   Clobbers: A.
4984  A87E              ;   Algorithm: load $22 and store it as the low byte of the BDOS return result. (The result high
4985  A87E              ;              byte is not written here; in canonical CP/M 2.2 the version word is $00$22, but this
4986  A87E              ;              routine sets only the low byte.)
4987  A87E              ;   [RE] dispatch fn 12 at $9C5F; $22 = CP/M 2.2 per the canonical version code.
4988  A87E              ; ----------------------------------------------------------------------
4989  A87E              S_BDOSVER_H:
4990  A87E                      ; version code $22 = CP/M 2.2
4991  A87E 3E 22                LD A,$22
4992  A880                      ; return it as the BDOS result low byte
4993  A880 C3 01 9F             JP BDOS_RET_RESULT
4994  A883              ; ----------------------------------------------------------------------
4995  A883              ; DRV_ALLRESET_H -- BDOS function 13 (Reset Disk System): return CP/M to its initial disk state.
4996  A883              ;   In: none.
4997  A883              ;   Out: login vector and working login/select vector cleared; current drive forced to A: (0); DMA
4998  A883              ;        address reset to TBUFF ($0080); drive A logged in fresh.
4999  A883              ;   Clobbers: A, HL (and DRV_INSTALL_RWTS_17 / RESTORE_USER_DMA clobbers).
5000  A883              ;   Algorithm: zero DRV_LOGIN_VECTOR and DRV_SELECT_VECTOR; set current drive BDOS_CUR_DRIVE=0; set
5001  A883              ;              DMA_ADDR=$0080 (TBUFF); call RESTORE_USER_DMA (set the live BIOS DMA / reset disk
5002  A883              ;              buffering); jump to DRV_INSTALL_RWTS_17 to log in drive A.
5003  A883              ;   [RE] dispatch fn 13 at $9C61; matches canonical CP/M 2.2 Reset Disk System.
5004  A883              ; ----------------------------------------------------------------------
5005  A883              DRV_ALLRESET_H:
5006  A883 21 00 00             LD HL,$0000
5007  A886                      ; clear the master logged-in drive bitmap
5008  A886 22 AD A9             LD (DRV_LOGIN_VECTOR),HL
5009  A889                      ; clear the working login/select vector
5010  A889 22 AF A9             LD (DRV_SELECT_VECTOR),HL
5011  A88C AF                   XOR A
5012  A88D                      ; force current drive back to A: (0)
5013  A88D 32 42 9F             LD (BDOS_CUR_DRIVE),A
5014  A890                      ; TBUFF ($0080) = default DMA address
5015  A890 21 80 00             LD HL,$0080
5016  A893                      ; reset the DMA address to TBUFF
5017  A893 22 B1 A9             LD (DMA_ADDR),HL
5018  A896                      ; push the reset DMA address through to disk buffering / BIOS
5019  A896 CD DA A1             CALL RESTORE_USER_DMA
5020  A899                      ; log in drive A from a clean state
5021  A899 C3 21 A8             JP DRV_INSTALL_RWTS_17
5022  A89C              ; ----------------------------------------------------------------------
5023  A89C              ; F_OPEN_H -- BDOS function 15 (Open File): open the file named by the FCB.
5024  A89C              ;   In: BDOS_PARAM_PTR = pointer to the caller's FCB.
5025  A89C              ;   Out: directory match result returned via FCB_OPEN_SEARCH (the search/open result path); FCB
5026  A89C              ;        filled in from the matching directory entry on success, $FF if not found.
5027  A89C              ;   Clobbers: A, BC, DE, HL.
5028  A89C              ;   Algorithm: CLEAR_FCB_S2 prepares/clears the open scratch state; FCB_AUTO_DRIVE_SELECT honors the
5029  A89C              ;              FCB drive prefix; jump into the open/search-and-fill path (FCB_OPEN_SEARCH).
5030  A89C              ;   [RE] dispatch fn 15 at $9C65; canonical CP/M 2.2 Open File.
5031  A89C              ; ----------------------------------------------------------------------
5032  A89C              F_OPEN_H:
5033  A89C                      ; prepare directory/open scratch state for this FCB
5034  A89C CD 72 A1             CALL CLEAR_FCB_S2
5035  A89F                      ; auto-select the FCB's drive prefix
5036  A89F CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5037  A8A2                      ; search the directory and fill the FCB (open path)
5038  A8A2 C3 51 A4             JP FCB_OPEN_SEARCH
5039  A8A5              ; ----------------------------------------------------------------------
5040  A8A5              ; F_CLOSE_H -- BDOS function 16 (Close File): write the FCB back to its directory entry.
5041  A8A5              ;   In: BDOS_PARAM_PTR = pointer to the caller's FCB (must be open).
5042  A8A5              ;   Out: directory entry updated; result returned via F_CLOSE_HND path ($FF / dir-code).
5043  A8A5              ;   Clobbers: A, BC, DE, HL.
5044  A8A5              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the FCB drive prefix; jump into the close
5045  A8A5              ;              (rewrite-directory) path.
5046  A8A5              ;   [RE] dispatch fn 16 at $9C67; canonical CP/M 2.2 Close File.
5047  A8A5              ; ----------------------------------------------------------------------
5048  A8A5              F_CLOSE_H:
5049  A8A5                      ; auto-select the FCB's drive prefix
5050  A8A5 CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5051  A8A8                      ; rewrite the directory entry and return the close result
5052  A8A8 C3 A2 A4             JP F_CLOSE_HND
5053  A8AB              ; ----------------------------------------------------------------------
5054  A8AB              ; F_SFIRST_H -- BDOS function 17 (Search for First): find the first directory entry matching the
5055  A8AB              ; FCB.
5056  A8AB              ;   In: DE = pointer to the search FCB (the BDOS dispatcher has also saved DE in BDOS_PARAM_PTR).
5057  A8AB              ;       FCB byte0 = $3F ('?') means 'match every entry' (ambiguous all-entries scan).
5058  A8AB              ;   Out: directory match copied to the DMA buffer; result (0..3 = dir position, or $FF none) via
5059  A8AB              ;        DISK_BUF_MOVE.
5060  A8AB              ;   Clobbers: A, BC, DE, HL.
5061  A8AB              ;   Algorithm: C=0 (default match length); fetch FCB byte0 (HL<-DE); if byte0==$3F do an unqualified
5062  A8AB              ;              all-entries scan (C left 0); else compute HL=FCB+$0C via DRV_INSTALL_RWTS_1 and test
5063  A8AB              ;              the extent byte FCB[$0C] -- if it is not '?' prepare scratch (CLEAR_FCB_S2) -- then
5064  A8AB              ;              auto-select drive and set C=$0F (15-byte name+type+extent match); fall into
5065  A8AB              ;              DIR_SEARCH_AND_COPY to run the directory search and copy the hit to the DMA buffer.
5066  A8AB              ;   [RE] dispatch fn 17 at $9C69; canonical CP/M 2.2 Search First; $3F is the '?' all-match marker.
5067  A8AB              ;   DRV_INSTALL_RWTS_1 only computes the FCB+$0C pointer (it does not save the search FCB).
5068  A8AB              ; ----------------------------------------------------------------------
5069  A8AB              F_SFIRST_H:
5070  A8AB                      ; search match length 0 (default name+type compare)
5071  A8AB 0E 00                LD C,$00
5072  A8AD EB                   EX DE,HL
5073  A8AE                      ; fetch FCB byte0 (drive/wildcard marker)
5074  A8AE 7E                   LD A,(HL)
5075  A8AF                      ; $3F ('?') in byte0 => match every directory entry
5076  A8AF FE 3F                CP $3F
5077  A8B1                      ; all-entries scan: go straight to the directory search
5078  A8B1 CA C2 A8             JP Z,DIR_SEARCH_AND_COPY
5079  A8B4                      ; HL = FCB + $0C (pointer to the extent byte); does NOT save the search FCB
5080  A8B4 CD A6 A0             CALL DRV_INSTALL_RWTS_1
5081  A8B7 7E                   LD A,(HL)
5082  A8B8                      ; is the extent byte FCB[$0C] the '?' wildcard (match all extents)?
5083  A8B8 FE 3F                CP $3F
5084  A8BA                      ; extent not wildcard: prepare directory scratch state
5085  A8BA C4 72 A1             CALL NZ,CLEAR_FCB_S2
5086  A8BD                      ; auto-select the FCB's drive prefix
5087  A8BD CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5088  A8C0                      ; match 15 bytes (name+type+extent) for a qualified search
5089  A8C0 0E 0F                LD C,$0F
5090  A8C2              ; ----------------------------------------------------------------------
5091  A8C2              ; DIR_SEARCH_AND_COPY -- run the directory scan and copy the matched entry to the DMA buffer.
5092  A8C2              ;   In: C = number of bytes to compare in the directory match; search FCB already established by
5093  A8C2              ;       F_SFIRST_H.
5094  A8C2              ;   Out: matching directory record moved to the DMA buffer; A = directory position (0..3) or $FF if
5095  A8C2              ;        none.
5096  A8C2              ;   Clobbers: A, BC, DE, HL.
5097  A8C2              ;   Algorithm: DIR_SEARCH_FIRST performs the directory search with the C-byte mask; tail into
5098  A8C2              ;              DISK_BUF_MOVE to copy the located directory entry into the user's DMA buffer and
5099  A8C2              ;              return the result code.
5100  A8C2              ;   [RE] shared search tail for fn 17 (Search First) and fn 18 (Search Next).
5101  A8C2              ; ----------------------------------------------------------------------
5102  A8C2              DIR_SEARCH_AND_COPY:
5103  A8C2                      ; scan the directory comparing C bytes against the search FCB
5104  A8C2 CD 18 A3             CALL DIR_SEARCH_FIRST
5105  A8C5                      ; copy the matched directory entry to the DMA buffer, return its position
5106  A8C5 C3 E9 A1             JP DISK_BUF_MOVE
5107  A8C8              ; ----------------------------------------------------------------------
5108  A8C8              ; F_SNEXT_H -- BDOS function 18 (Search for Next): continue a directory search begun by Search
5109  A8C8              ; First.
5110  A8C8              ;   In: search state saved in DIR_FCB_PTR (the search FCB pointer stored by the directory-search core
5111  A8C8              ;       DIR_SEARCH_FIRST at $A324).
5112  A8C8              ;   Out: next matching directory record copied to the DMA buffer; A = position (0..3) or $FF if no
5113  A8C8              ;        more.
5114  A8C8              ;   Clobbers: A, BC, DE, HL.
5115  A8C8              ;   Algorithm: restore the saved search FCB pointer (DIR_FCB_PTR -> BDOS_PARAM_PTR); auto-select its
5116  A8C8              ;              drive; BDOS_DIR_SCAN_NEXT advances the directory scan from the saved position; tail
5117  A8C8              ;              into DISK_BUF_MOVE to deliver the hit.
5118  A8C8              ;   [RE] dispatch fn 18 at $9C6B; canonical CP/M 2.2 Search Next; DIR_FCB_PTR holds the in-progress
5119  A8C8              ;   search FCB.
5120  A8C8              ; ----------------------------------------------------------------------
5121  A8C8              F_SNEXT_H:
5122  A8C8                      ; restore the saved Search-First FCB pointer
5123  A8C8 2A D9 A9             LD HL,(DIR_FCB_PTR)
5124  A8CB                      ; make it the active FCB for this scan step
5125  A8CB 22 43 9F             LD (BDOS_PARAM_PTR),HL
5126  A8CE                      ; auto-select the FCB's drive prefix
5127  A8CE CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5128  A8D1                      ; advance the directory search from the last matched entry
5129  A8D1 CD 2D A3             CALL BDOS_DIR_SCAN_NEXT
5130  A8D4                      ; copy the next matched entry to the DMA buffer, return its position
5131  A8D4 C3 E9 A1             JP DISK_BUF_MOVE
5132  A8D7              ; ----------------------------------------------------------------------
5133  A8D7              ; F_DELETE_H -- BDOS function 19 (Delete File): erase all directory entries matching the FCB.
5134  A8D7              ;   In: BDOS_PARAM_PTR = pointer to the (possibly ambiguous) FCB.
5135  A8D7              ;   Out: matching directory entries marked deleted ($E5) and their allocation freed; result via
5136  A8D7              ;        DIR_RETURN_MATCH_FLAG ($FF if none / dir code).
5137  A8D7              ;   Clobbers: A, BC, DE, HL.
5138  A8D7              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; F_DELETE_HND scans and erases each
5139  A8D7              ;              matching directory entry (releasing its blocks); tail into the
5140  A8D7              ;              directory-update/result path DIR_RETURN_MATCH_FLAG.
5141  A8D7              ;   [RE] dispatch fn 19 at $9C6D; canonical CP/M 2.2 Delete File.
5142  A8D7              ; ----------------------------------------------------------------------
5143  A8D7              F_DELETE_H:
5144  A8D7                      ; auto-select the FCB's drive prefix
5145  A8D7 CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5146  A8DA                      ; erase every matching directory entry and free its blocks
5147  A8DA CD 9C A3             CALL F_DELETE_HND
5148  A8DD                      ; flush the directory and return the result code
5149  A8DD C3 01 A3             JP DIR_RETURN_MATCH_FLAG
5150  A8E0              ; ----------------------------------------------------------------------
5151  A8E0              ; F_READ_H -- BDOS function 20 (Read Sequential): read the next 128-byte record of the open file.
5152  A8E0              ;   In: BDOS_PARAM_PTR = pointer to an open FCB positioned at the next sequential record.
5153  A8E0              ;   Out: one record read into the DMA buffer; A = 0 on success or a nonzero read-error/EOF code; the
5154  A8E0              ;        FCB's sequential position advanced.
5155  A8E0              ;   Clobbers: A, BC, DE, HL.
5156  A8E0              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; jump into the sequential read core
5157  A8E0              ;              (FILE_READ_SEQ).
5158  A8E0              ;   [RE] dispatch fn 20 at $9C6F; canonical CP/M 2.2 Read Sequential.
5159  A8E0              ; ----------------------------------------------------------------------
5160  A8E0              F_READ_H:
5161  A8E0                      ; auto-select the FCB's drive prefix
5162  A8E0 CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5163  A8E3                      ; read the next sequential record into the DMA buffer
5164  A8E3 C3 BC A5             JP FILE_READ_SEQ
5165  A8E6              ; ----------------------------------------------------------------------
5166  A8E6              ; F_WRITE_H -- BDOS function 21 (Write Sequential): write the next 128-byte record to the open file.
5167  A8E6              ;   In: BDOS_PARAM_PTR = pointer to an open FCB; DMA buffer holds the record to write.
5168  A8E6              ;   Out: one record written; A = 0 on success or a nonzero error code (disk full / R/O); FCB
5169  A8E6              ;        position advanced, allocation extended as needed.
5170  A8E6              ;   Clobbers: A, BC, DE, HL.
5171  A8E6              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; jump into the write core
5172  A8E6              ;              (FILE_WRITE_SEQ sets the write-mode flag for a normal sequential write).
5173  A8E6              ;   [RE] dispatch fn 21 at $9C71; canonical CP/M 2.2 Write Sequential; the write core distinguishes
5174  A8E6              ;   normal vs zero-fill write modes.
5175  A8E6              ; ----------------------------------------------------------------------
5176  A8E6              F_WRITE_H:
5177  A8E6                      ; auto-select the FCB's drive prefix
5178  A8E6 CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5179  A8E9                      ; set the (normal) write mode and write the next sequential record
5180  A8E9 C3 FE A5             JP FILE_WRITE_SEQ
5181  A8EC              ; ----------------------------------------------------------------------
5182  A8EC              ; F_MAKE_H -- BDOS function 22 (Make File): create a new directory entry for the FCB.
5183  A8EC              ;   In: BDOS_PARAM_PTR = pointer to the FCB naming the file to create.
5184  A8EC              ;   Out: a fresh, empty directory entry allocated and the FCB opened against it; A = dir position or
5185  A8EC              ;        $FF if the directory is full.
5186  A8EC              ;   Clobbers: A, BC, DE, HL.
5187  A8EC              ;   Algorithm: CLEAR_FCB_S2 prepares the create scratch state; FCB_AUTO_DRIVE_SELECT honors the
5188  A8EC              ;              drive prefix; jump into the make-directory-entry core (DIR_MAKE_ENTRY).
5189  A8EC              ;   [RE] dispatch fn 22 at $9C73; canonical CP/M 2.2 Make File.
5190  A8EC              ; ----------------------------------------------------------------------
5191  A8EC              F_MAKE_H:
5192  A8EC                      ; prepare directory create scratch state
5193  A8EC CD 72 A1             CALL CLEAR_FCB_S2
5194  A8EF                      ; auto-select the FCB's drive prefix
5195  A8EF CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5196  A8F2                      ; allocate and initialize a new directory entry for the file
5197  A8F2 C3 24 A5             JP DIR_MAKE_ENTRY
5198  A8F5              ; ----------------------------------------------------------------------
5199  A8F5              ; F_RENAME_H -- BDOS function 23 (Rename File): change a file's name in its directory entries.
5200  A8F5              ;   In: BDOS_PARAM_PTR = pointer to an FCB whose first 12 bytes hold the old name and bytes $10..
5201  A8F5              ;       hold the new name.
5202  A8F5              ;   Out: every matching directory entry's name field rewritten to the new name; result via
5203  A8F5              ;        DIR_RETURN_MATCH_FLAG.
5204  A8F5              ;   Clobbers: A, BC, DE, HL.
5205  A8F5              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; F_RENAME_HND walks the directory rewriting
5206  A8F5              ;              matched entries to the new name; tail into the directory-update/result path
5207  A8F5              ;              DIR_RETURN_MATCH_FLAG.
5208  A8F5              ;   [RE] dispatch fn 23 at $9C75; canonical CP/M 2.2 Rename File.
5209  A8F5              ; ----------------------------------------------------------------------
5210  A8F5              F_RENAME_H:
5211  A8F5                      ; auto-select the FCB's drive prefix
5212  A8F5 CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5213  A8F8                      ; rewrite every matching directory entry to the new name
5214  A8F8 CD 16 A4             CALL F_RENAME_HND
5215  A8FB                      ; flush the directory and return the result code
5216  A8FB C3 01 A3             JP DIR_RETURN_MATCH_FLAG
5217  A8FE              ; ----------------------------------------------------------------------
5218  A8FE              ; DRV_LOGINVEC_H -- BDOS function 24 (Return Login Vector): report which drives are logged in.
5219  A8FE              ;   In: DRV_SELECT_VECTOR = working login/select vector (bit d = drive d logged in).
5220  A8FE              ;   Out: BDOS result HL = the login vector (returned via the common result-store
5221  A8FE              ;        BDOS_RET_RESULT_HL).
5222  A8FE              ;   Clobbers: HL.
5223  A8FE              ;   Algorithm: load the working login vector and store it as the 16-bit BDOS result.
5224  A8FE              ;   [RE] dispatch fn 24 at $9C77; canonical CP/M 2.2 Return Login Vector.
5225  A8FE              ; ----------------------------------------------------------------------
5226  A8FE              DRV_LOGINVEC_H:
5227  A8FE                      ; HL = login vector (one bit per logged-in drive)
5228  A8FE 2A AF A9             LD HL,(DRV_SELECT_VECTOR)
5229  A901                      ; store HL as the 16-bit BDOS result
5230  A901 C3 29 A9             JP BDOS_RET_RESULT_HL
5231  A904              ; ----------------------------------------------------------------------
5232  A904              ; DRV_GET_H -- BDOS function 25 (Return Current Disk): report the current default drive.
5233  A904              ;   In: BDOS_CUR_DRIVE = current drive number.
5234  A904              ;   Out: BDOS result A = current drive (0=A:).
5235  A904              ;   Clobbers: A.
5236  A904              ;   Algorithm: load the current-drive cell and return it as the BDOS result.
5237  A904              ;   [RE] dispatch fn 25 at $9C79; canonical CP/M 2.2 Return Current Disk.
5238  A904              ; ----------------------------------------------------------------------
5239  A904              DRV_GET_H:
5240  A904                      ; A = current drive number
5241  A904 3A 42 9F             LD A,(BDOS_CUR_DRIVE)
5242  A907                      ; return it as the BDOS result
5243  A907 C3 01 9F             JP BDOS_RET_RESULT
5244  A90A              ; ----------------------------------------------------------------------
5245  A90A              ; F_DMAOFF_H -- BDOS function 26 (Set DMA Address): set the disk read/write buffer address.
5246  A90A              ;   In: DE = new DMA (disk transfer) address supplied by the caller.
5247  A90A              ;   Out: DMA_ADDR set to DE and pushed through to the BIOS disk-buffering layer.
5248  A90A              ;   Clobbers: A, HL (and RESTORE_USER_DMA clobbers).
5249  A90A              ;   Algorithm: move DE into HL, store at DMA_ADDR, jump to RESTORE_USER_DMA to apply it to the live
5250  A90A              ;              disk buffering / BIOS SETDMA.
5251  A90A              ;   [RE] dispatch fn 26 at $9C7B; canonical CP/M 2.2 Set DMA Address.
5252  A90A              ; ----------------------------------------------------------------------
5253  A90A              F_DMAOFF_H:
5254  A90A                      ; HL = caller's requested DMA address
5255  A90A EB                   EX DE,HL
5256  A90B                      ; record the new DMA address
5257  A90B 22 B1 A9             LD (DMA_ADDR),HL
5258  A90E                      ; apply the DMA address to disk buffering / BIOS
5259  A90E C3 DA A1             JP RESTORE_USER_DMA
5260  A911              ; ----------------------------------------------------------------------
5261  A911              ; DRV_ALLOCVEC_H -- BDOS function 27 (Return Allocation Vector address).
5262  A911              ;   In: ALLOC_VEC_PTR = base address of the current drive's allocation (block-in-use) bit vector.
5263  A911              ;   Out: BDOS result HL = the allocation vector address.
5264  A911              ;   Clobbers: HL.
5265  A911              ;   Algorithm: load the allocation-vector pointer and store it as the 16-bit BDOS result.
5266  A911              ;   [RE] dispatch fn 27 at $9C7D; canonical CP/M 2.2 Get Allocation Vector.
5267  A911              ; ----------------------------------------------------------------------
5268  A911              DRV_ALLOCVEC_H:
5269  A911                      ; HL = address of the current drive's allocation bit vector
5270  A911 2A BF A9             LD HL,(ALLOC_VEC_PTR)
5271  A914                      ; store HL as the 16-bit BDOS result
5272  A914 C3 29 A9             JP BDOS_RET_RESULT_HL
5273  A917              ; ----------------------------------------------------------------------
5274  A917              ; DRV_ROVEC_H -- BDOS function 29 (Return Read-Only Vector): report which drives are read-only.
5275  A917              ;   In: DRV_LOGIN_VECTOR -- here read as the read-only bit vector master copy.
5276  A917              ;   Out: BDOS result HL = the read-only drive vector (bit d set = drive d is R/O).
5277  A917              ;   Clobbers: HL.
5278  A917              ;   Algorithm: load the R/O vector and store it as the 16-bit BDOS result.
5279  A917              ;   [RE] dispatch fn 29 at $9C81; canonical CP/M 2.2 Get Read-Only Vector. [?] Source operand is the
5280  A917              ;   DRV_LOGIN_VECTOR cell; per CP/M 2.2 the R/O vector is a distinct mask -- the symbol name may be
5281  A917              ;   a misnomer for the R/O vector cell, or this build keeps the R/O bits in the same word.
5282  A917              ; ----------------------------------------------------------------------
5283  A917              DRV_ROVEC_H:
5284  A917                      ; HL = read-only drive vector (one bit per R/O drive)
5285  A917 2A AD A9             LD HL,(DRV_LOGIN_VECTOR)
5286  A91A                      ; store HL as the 16-bit BDOS result
5287  A91A C3 29 A9             JP BDOS_RET_RESULT_HL
5288  A91D              ; ----------------------------------------------------------------------
5289  A91D              ; F_ATTRIB_H -- BDOS function 30 (Set File Attributes): write the FCB's attribute bits into its
5290  A91D              ; directory entries.
5291  A91D              ;   In: BDOS_PARAM_PTR = pointer to the FCB carrying the desired attribute (high) bits in its
5292  A91D              ;       name/type bytes.
5293  A91D              ;   Out: matching directory entries updated with the new attributes; result via
5294  A91D              ;        DIR_RETURN_MATCH_FLAG.
5295  A91D              ;   Clobbers: A, BC, DE, HL.
5296  A91D              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; F_ATTRIB_HND walks the directory copying
5297  A91D              ;              the FCB's attribute bits into each matched entry; tail into the
5298  A91D              ;              directory-update/result path.
5299  A91D              ;   [RE] dispatch fn 30 at $9C83; canonical CP/M 2.2 Set File Attributes.
5300  A91D              ; ----------------------------------------------------------------------
5301  A91D              F_ATTRIB_H:
5302  A91D                      ; auto-select the FCB's drive prefix
5303  A91D CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5304  A920                      ; copy the FCB's attribute bits into every matching directory entry
5305  A920 CD 3B A4             CALL F_ATTRIB_HND
5306  A923                      ; flush the directory and return the result code
5307  A923 C3 01 A3             JP DIR_RETURN_MATCH_FLAG
5308  A926              ; ----------------------------------------------------------------------
5309  A926              ; DRV_DPB_H -- BDOS function 31 (Return Disk Parameter Block address).
5310  A926              ;   In: DPB_PTR = address of the current drive's DPB (set during disk select/log-in).
5311  A926              ;   Out: BDOS result HL = the DPB address.
5312  A926              ;   Clobbers: HL.
5313  A926              ;   Algorithm: load the DPB pointer and store it as the 16-bit BDOS result.
5314  A926              ;   [RE] dispatch fn 31 at $9C85; canonical CP/M 2.2 Get DPB; falls into the shared result-store
5315  A926              ;   BDOS_RET_RESULT_HL.
5316  A926              ; ----------------------------------------------------------------------
5317  A926              DRV_DPB_H:
5318  A926                      ; HL = address of the current drive's Disk Parameter Block
5319  A926 2A BB A9             LD HL,(DPB_PTR)
5320  A929              ; ----------------------------------------------------------------------
5321  A929              ; BDOS_RET_RESULT_HL -- common exit: store the 16-bit value in HL as the BDOS return result.
5322  A929              ;   In: HL = value to return to the caller.
5323  A929              ;   Out: BDOS result cell BDOS_RETVAL = HL.
5324  A929              ;   Clobbers: none (writes memory).
5325  A929              ;   Algorithm: store HL at the BDOS result cell and return.
5326  A929              ;   [RE] the HL-valued counterpart of BDOS_RET_RESULT (which returns A); used by the get-vector /
5327  A929              ;   get-pointer functions (login vector, alloc vector, R/O vector, DPB) and fallen into from
5328  A929              ;   DRV_DPB_H.
5329  A929              ; ----------------------------------------------------------------------
5330  A929              BDOS_RET_RESULT_HL:
5331  A929                      ; store HL as the 16-bit BDOS result
5332  A929 22 45 9F             LD (BDOS_RETVAL),HL
5333  A92C C9                   RET
5334  A92D              ; ----------------------------------------------------------------------
5335  A92D              ; F_USERNUM_H -- BDOS function 32 (Get/Set User Code).
5336  A92D              ;   In: DRV_SELECT_ARG = caller's argument byte ($FF = 'get', else the user number to set); BDOS_USER_NUM =
5337  A92D              ;       current user number.
5338  A92D              ;   Out: if get: BDOS result A = current user number; if set: current user number BDOS_USER_NUM
5339  A92D              ;        updated to (arg AND $1F).
5340  A92D              ;   Clobbers: A.
5341  A92D              ;   Algorithm: if the argument is $FF, return the current user number; otherwise mask the argument
5342  A92D              ;              to 0..31 and store it as the current user number.
5343  A92D              ;   [RE] dispatch fn 32 at $9C87; canonical CP/M 2.2 Get/Set User; $FF = query.
5344  A92D              ; ----------------------------------------------------------------------
5345  A92D              F_USERNUM_H:
5346  A92D                      ; A = caller's argument ($FF = query current user)
5347  A92D 3A D6 A9             LD A,(DRV_SELECT_ARG)
5348  A930                      ; is this a 'get current user' request?
5349  A930 FE FF                CP $FF
5350  A932                      ; no: it is a 'set user number' request
5351  A932 C2 3B A9             JP NZ,SET_USER_NUMBER
5352  A935                      ; get path: load the current user number
5353  A935 3A 41 9F             LD A,(BDOS_USER_NUM)
5354  A938                      ; return it as the BDOS result
5355  A938 C3 01 9F             JP BDOS_RET_RESULT
5356  A93B              ; ----------------------------------------------------------------------
5357  A93B              ; SET_USER_NUMBER -- set path of BDOS function 32: change the current user number.
5358  A93B              ;   In: A = requested user number.
5359  A93B              ;   Out: current user number BDOS_USER_NUM = A AND $1F (0..31).
5360  A93B              ;   Clobbers: A.
5361  A93B              ;   Algorithm: mask the requested user number to 5 bits and store it.
5362  A93B              ;   [RE] continuation of F_USERNUM_H (Get/Set User).
5363  A93B              ; ----------------------------------------------------------------------
5364  A93B              SET_USER_NUMBER:
5365  A93B                      ; clamp the user number to the range 0..31
5366  A93B E6 1F                AND $1F
5367  A93D                      ; store the new current user number
5368  A93D 32 41 9F             LD (BDOS_USER_NUM),A
5369  A940 C9                   RET
5370  A941              ; ----------------------------------------------------------------------
5371  A941              ; F_READRAND_H -- BDOS function 33 (Read Random): read the record addressed by the FCB's
5372  A941              ; random-record field.
5373  A941              ;   In: BDOS_PARAM_PTR = pointer to an open FCB whose r0/r1/r2 ($21..$23) hold the target record
5374  A941              ;       number.
5375  A941              ;   Out: that record read into the DMA buffer; A = 0 on success or a random-read error code (e.g.
5376  A941              ;        1=reading unwritten data, 6=record number out of range); FCB positioned at that record.
5377  A941              ;   Clobbers: A, BC, DE, HL.
5378  A941              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; jump into the random-read core
5379  A941              ;              (FCB_EXTENT_TO_TRKSEC_8) which seeks to the random record and reads it.
5380  A941              ;   [RE] dispatch fn 33 at $9C89; canonical CP/M 2.2 Read Random.
5381  A941              ; ----------------------------------------------------------------------
5382  A941              F_READRAND_H:
5383  A941                      ; auto-select the FCB's drive prefix
5384  A941 CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5385  A944                      ; position to the FCB's random record and read it
5386  A944 C3 93 A7             JP FCB_EXTENT_TO_TRKSEC_8
5387  A947              ; ----------------------------------------------------------------------
5388  A947              ; F_WRITERAND_H -- BDOS function 34 (Write Random): write the record addressed by the FCB's
5389  A947              ; random-record field.
5390  A947              ;   In: BDOS_PARAM_PTR = pointer to an open FCB whose r0/r1/r2 hold the target record number; DMA
5391  A947              ;       buffer holds the record.
5392  A947              ;   Out: that record written; A = 0 on success or a random-write error code; file extended/allocated
5393  A947              ;        as needed.
5394  A947              ;   Clobbers: A, BC, DE, HL.
5395  A947              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; jump into the random-write core
5396  A947              ;              (FCB_EXTENT_TO_TRKSEC_9).
5397  A947              ;   [RE] dispatch fn 34 at $9C8B; canonical CP/M 2.2 Write Random.
5398  A947              ; ----------------------------------------------------------------------
5399  A947              F_WRITERAND_H:
5400  A947                      ; auto-select the FCB's drive prefix
5401  A947 CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5402  A94A                      ; position to the FCB's random record and write it
5403  A94A C3 9C A7             JP FCB_EXTENT_TO_TRKSEC_9
5404  A94D              ; ----------------------------------------------------------------------
5405  A94D              ; F_SIZE_H -- BDOS function 35 (Compute File Size): set the FCB's random-record field to the file's
5406  A94D              ; record count.
5407  A94D              ;   In: BDOS_PARAM_PTR = pointer to the FCB naming the file.
5408  A94D              ;   Out: FCB r0/r1/r2 ($21..$23) set to the number of 128-byte records in the file (its 'virtual
5409  A94D              ;        size').
5410  A94D              ;   Clobbers: A, BC, DE, HL.
5411  A94D              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; jump into the size-compute core
5412  A94D              ;              (FCB_ALLOC_BLOCK_NUM_2) which scans the directory extents to find the highest record
5413  A94D              ;              and writes it into the FCB random-record field.
5414  A94D              ;   [RE] dispatch fn 35 at $9C8D; canonical CP/M 2.2 Compute File Size.
5415  A94D              ; ----------------------------------------------------------------------
5416  A94D              F_SIZE_H:
5417  A94D                      ; auto-select the FCB's drive prefix
5418  A94D CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5419  A950                      ; scan the file's extents and write its record count into the FCB
5420  A950 C3 D2 A7             JP FCB_ALLOC_BLOCK_NUM_2
5421  A953              ; ----------------------------------------------------------------------
5422  A953              ; DRV_RESET_H -- BDOS function 37 (Reset Drive): mark the drives named by the caller's bit mask as
5423  A953              ; no longer logged in.
5424  A953              ;   In: BDOS_PARAM_PTR = caller's reset bit-mask (one bit per drive to reset); DRV_SELECT_VECTOR = working
5425  A953              ;       login vector; DRV_LOGIN_VECTOR = master logged-in / R-O master vector.
5426  A953              ;   Out: for each drive bit set in the mask, that drive's bit is cleared in both DRV_SELECT_VECTOR and
5427  A953              ;        DRV_LOGIN_VECTOR, forcing a fresh log-in on next access.
5428  A953              ;   Clobbers: A, DE, HL.
5429  A953              ;   Algorithm: form the bitwise complement of the caller's reset mask (CPL of each byte of
5430  A953              ;              BDOS_PARAM_PTR); AND it into DRV_SELECT_VECTOR to clear those login bits and store back; then
5431  A953              ;              AND the now-masked login word with DRV_LOGIN_VECTOR (which also has the reset bits
5432  A953              ;              cleared) and store back, so the master vector loses the reset drives' bits too.
5433  A953              ;   [RE] dispatch fn 37 at $9C91; canonical CP/M 2.2 Reset Drive (selective reset). The auto-label
5434  A953              ;   'DIR_NAME_MASK' is unrelated to its real function.
5435  A953              ; ----------------------------------------------------------------------
5436  A953              DRV_RESET_H:
5437  A953                      ; HL = caller's reset bit-mask (one bit per drive to reset)
5438  A953 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
5439  A956 7D                   LD A,L
5440  A957                      ; complement the mask low byte (a 1 marks a drive to KEEP; 0 marks a drive being reset)
5441  A957 2F                   CPL
5442  A958 5F                   LD E,A
5443  A959 7C                   LD A,H
5444  A95A 2F                   CPL
5445  A95B                      ; HL = working login vector
5446  A95B 2A AF A9             LD HL,(DRV_SELECT_VECTOR)
5447  A95E                      ; clear the reset drives' bits in the login vector (high byte path)
5448  A95E A4                   AND H
5449  A95F 57                   LD D,A
5450  A960 7D                   LD A,L
5451  A961 A3                   AND E
5452  A962 5F                   LD E,A
5453  A963                      ; HL = master logged-in / R-O vector
5454  A963 2A AD A9             LD HL,(DRV_LOGIN_VECTOR)
5455  A966 EB                   EX DE,HL
5456  A967                      ; store the updated login vector
5457  A967 22 AF A9             LD (DRV_SELECT_VECTOR),HL
5458  A96A 7D                   LD A,L
5459  A96B A3                   AND E
5460  A96C 6F                   LD L,A
5461  A96D 7C                   LD A,H
5462  A96E A2                   AND D
5463  A96F 67                   LD H,A
5464  A970                      ; store the master vector with the reset drives cleared
5465  A970 22 AD A9             LD (DRV_LOGIN_VECTOR),HL
5466  A973 C9                   RET
5467  A974              ; ----------------------------------------------------------------------
5468  A974              ; FCB_AUTO_DRIVE_RESTORE -- file-operation epilogue: undo a temporary drive switch made by
5469  A974              ; FCB_AUTO_DRIVE_SELECT, then return the BDOS result.
5470  A974              ;   In: DRV_RESTORE_FLAG = restore-pending flag (0 = no switch was made); BDOS_PARAM_PTR = FCB pointer; DRV_SAVED_FCB_BYTE
5471  A974              ;       = saved FCB drive byte; DRV_SAVED_DRIVE = saved drive number; BDOS_SAVED_SP = saved BDOS stack
5472  A974              ;       pointer; BDOS_RETVAL = BDOS result.
5473  A974              ;   Out: if a switch was pending, the FCB's drive byte and the current drive are restored to their
5474  A974              ;        pre-call values (DRV_SET_H reselects the original drive); then control falls into
5475  A974              ;        BDOS_RETURN_RESULT to restore the BDOS stack and deliver A = result low byte (B = high
5476  A974              ;        byte).
5477  A974              ;   Clobbers: A, B, HL, SP.
5478  A974              ;   Algorithm: if no temporary switch was made (DRV_RESTORE_FLAG==0) skip to the result return; else clear the
5479  A974              ;              FCB drive byte ($00), and if the saved original byte (DRV_SAVED_FCB_BYTE) is nonzero restore it;
5480  A974              ;              restore the saved current drive (DRV_SAVED_DRIVE -> DRV_SELECT_ARG) and reselect it via DRV_SET_H;
5481  A974              ;              fall into BDOS_RETURN_RESULT.
5482  A974              ;   [RE] this is the universal file-op epilogue that pairs with FCB_AUTO_DRIVE_SELECT; the
5483  A974              ;   'DIR_NAME_MASK' auto-label is unrelated.
5484  A974              ; ----------------------------------------------------------------------
5485  A974              FCB_AUTO_DRIVE_RESTORE:
5486  A974                      ; was a temporary drive switch made by the preamble?
5487  A974 3A DE A9             LD A,(DRV_RESTORE_FLAG)
5488  A977 B7                   OR A
5489  A978                      ; no switch: skip restore, go straight to the result return
5490  A978 CA 91 A9             JP Z,BDOS_RETURN_RESULT
5491  A97B                      ; HL -> FCB whose drive byte was modified
5492  A97B 2A 43 9F             LD HL,(BDOS_PARAM_PTR)
5493  A97E                      ; clear the FCB drive byte before restoring it
5494  A97E 36 00                LD (HL),$00
5495  A980                      ; A = saved original FCB drive-prefix byte
5496  A980 3A E0 A9             LD A,(DRV_SAVED_FCB_BYTE)
5497  A983 B7                   OR A
5498  A984                      ; saved byte was 0 (no real prefix): nothing to put back, go to result return
5499  A984 CA 91 A9             JP Z,BDOS_RETURN_RESULT
5500  A987                      ; restore the original FCB drive-prefix byte
5501  A987 77                   LD (HL),A
5502  A988                      ; A = saved current drive number
5503  A988 3A DF A9             LD A,(DRV_SAVED_DRIVE)
5504  A98B                      ; set it as the drive to reselect
5505  A98B 32 D6 A9             LD (DRV_SELECT_ARG),A
5506  A98E                      ; reselect the drive that was current before the call
5507  A98E CD 45 A8             CALL DRV_SET_H
5508  A991              ; ----------------------------------------------------------------------
5509  A991              ; BDOS_RETURN_RESULT -- final BDOS exit: restore the entry stack and deliver the result to the
5510  A991              ; caller.
5511  A991              ;   In: BDOS_SAVED_SP = saved BDOS entry stack pointer; BDOS_RETVAL = 16-bit BDOS result.
5512  A991              ;   Out: SP restored to the BDOS entry stack; A = result low byte, B = result high byte (HL also =
5513  A991              ;        result).
5514  A991              ;   Clobbers: A, B, HL, SP.
5515  A991              ;   Algorithm: load the saved stack pointer into SP; load the 16-bit result into HL; copy L->A and
5516  A991              ;              H->B so both the 8-bit (A) and 16-bit (HL/BA) return conventions are satisfied;
5517  A991              ;              return to the BDOS dispatcher.
5518  A991              ;   [RE] the common tail every BDOS function returns through; pairs the saved-SP restore with the
5519  A991              ;   result hand-off.
5520  A991              ; ----------------------------------------------------------------------
5521  A991              BDOS_RETURN_RESULT:
5522  A991                      ; HL = saved BDOS entry stack pointer
5523  A991 2A 0F 9F             LD HL,(BDOS_SAVED_SP)
5524  A994                      ; restore the BDOS entry stack (drop any locals)
5525  A994 F9                   LD SP,HL
5526  A995                      ; HL = the 16-bit BDOS result value
5527  A995 2A 45 9F             LD HL,(BDOS_RETVAL)
5528  A998                      ; A = result low byte (8-bit return convention)
5529  A998 7D                   LD A,L
5530  A999                      ; B = result high byte (16-bit return convention)
5531  A999 44                   LD B,H
5532  A99A C9                   RET
5533  A99B              ; ----------------------------------------------------------------------
5534  A99B              ; F_WRITEZF_H -- BDOS function 40 (Write Random with Zero Fill): like Write Random, but newly
5535  A99B              ; allocated blocks are pre-filled with zeros.
5536  A99B              ;   In: BDOS_PARAM_PTR = pointer to an open FCB whose r0/r1/r2 hold the target record number; DMA
5537  A99B              ;       buffer holds the record.
5538  A99B              ;   Out: the record written at the random position; any block newly allocated to reach it is
5539  A99B              ;        zero-filled first; A = 0 or a random-write error code.
5540  A99B              ;   Clobbers: A, BC, DE, HL.
5541  A99B              ;   Algorithm: FCB_AUTO_DRIVE_SELECT honors the drive prefix; set write-mode WRITE_TYPE_FLAG=2 (zero-fill);
5542  A99B              ;              C=0; call the random-record extract/seek core (BDOS_SEEK_COMPUTE) and, on success
5543  A99B              ;              (Z), perform the write (BDOS_WRITE).
5544  A99B              ;   [RE] dispatch fn 40 at $9C97; canonical CP/M 2.2 Write Random with Zero Fill; WRITE_TYPE_FLAG=2
5545  A99B              ;   distinguishes it from normal Write Random.
5546  A99B              ; ----------------------------------------------------------------------
5547  A99B              F_WRITEZF_H:
5548  A99B                      ; auto-select the FCB's drive prefix
5549  A99B CD 51 A8             CALL FCB_AUTO_DRIVE_SELECT
5550  A99E                      ; write-mode 2 = write random with zero fill of new blocks
5551  A99E 3E 02                LD A,$02
5552  A9A0                      ; select zero-fill write mode
5553  A9A0 32 D5 A9             LD (WRITE_TYPE_FLAG),A
5554  A9A3                      ; C=0 parameter to the random-record extract core
5555  A9A3 0E 00                LD C,$00
5556  A9A5                      ; decode the FCB random record and seek/allocate to it
5557  A9A5 CD 07 A7             CALL BDOS_SEEK_COMPUTE
5558  A9A8                      ; on success, write the record (with zero-filled new blocks)
5559  A9A8 CC 03 A6             CALL Z,BDOS_WRITE
5560  A9AB C9                   RET
5561  A9AC              EMPTY_DIR_FCB:
5562  A9AC E5                   DEFB    $E5
5563  A9AD              DRV_LOGIN_VECTOR:
5564  A9AD 00 00                DEFB    "\0\0"
5565  A9AF              DRV_SELECT_VECTOR:
5566  A9AF 00 00                DEFB    "\0\0"
5567  A9B1              DMA_ADDR:
5568  A9B1 80 00                DEFB    $80,$00
5569  A9B3              DPB_WORK_PTR0:
5570  A9B3 00 00                DEFB    "\0\0"
5571  A9B5              DEBLOCK_HSTREC_PTR0:
5572  A9B5 00 00                DEFB    "\0\0"
5573  A9B7              DEBLOCK_HSTREC_PTR1:
5574  A9B7 00 00                DEFB    "\0\0"
5575  A9B9              DIRBUF_PTR:
5576  A9B9 00 00                DEFB    "\0\0"
5577  A9BB              DPB_PTR:
5578  A9BB 00 00                DEFB    "\0\0"
5579  A9BD              REC_BYTE_OFFSET:
5580  A9BD 00 00                DEFB    "\0\0"
5581  A9BF              ALLOC_VEC_PTR:
5582  A9BF 00 00                DEFB    "\0\0"
5583  A9C1              DPB_SPT:
5584  A9C1 00 00                DEFB    "\0\0"
5585  A9C3              DPB_BSH:
5586  A9C3 00                   DEFB    "\0"
5587  A9C4              DPB_BLM:
5588  A9C4 00                   DEFB    "\0"
5589  A9C5              DPB_EXM:
5590  A9C5 00                   DEFB    "\0"
5591  A9C6              MAX_BLOCK_DSM:
5592  A9C6 00 00                DEFB    "\0\0"
5593  A9C8              DPB_REC_PTR:
5594  A9C8 00 00                DEFB    "\0\0"
5595  A9CA              ALLOC_END_PTR:
5596  A9CA 00 00                DEFB    "\0\0"
5597  A9CC              REC_SCAN_PTR:
5598  A9CC 00 00                DEFB    "\0\0"
5599  A9CE              DPB_OFF:
5600  A9CE 00 00                DEFB    "\0\0"
5601  A9D0              DPB_XLT_PTR:
5602  A9D0 00 00                DEFB    "\0\0"
5603  A9D2              DIR_DIRTY_FLAG:
5604  A9D2 00                   DEFB    "\0"
5605  A9D3              RW_DIRECTION_FLAG:
5606  A9D3 00                   DEFB    "\0"
5607  A9D4              DIR_MATCH_FLAG:
5608  A9D4 00                   DEFB    "\0"
5609  A9D5              WRITE_TYPE_FLAG:
5610  A9D5 00                   DEFB    "\0"
5611  A9D6              DRV_SELECT_ARG:
5612  A9D6 00                   DEFB    "\0"
5613  A9D7              ALLOC_SLOT_INDEX:
5614  A9D7 00                   DEFB    "\0"
5615  A9D8              DIR_CMP_LEN:
5616  A9D8 00                   DEFB    "\0"
5617  A9D9              DIR_FCB_PTR:
5618  A9D9 00 00 00 00          DEFB    "\0\0\0\0"
5619  A9DD              BLOCK_WIDTH_FLAG:
5620  A9DD 00                   DEFB    "\0"
5621  A9DE              DRV_RESTORE_FLAG:
5622  A9DE 00                   DEFB    "\0"
5623  A9DF              DRV_SAVED_DRIVE:
5624  A9DF 00                   DEFB    "\0"
5625  A9E0              DRV_SAVED_FCB_BYTE:
5626  A9E0 00                   DEFB    "\0"
5627  A9E1              FCB_RECCOUNT:
5628  A9E1 00                   DEFB    "\0"
5629  A9E2              FCB_EXTENT_MASKED:
5630  A9E2 00                   DEFB    "\0"
5631  A9E3              FCB_CURREC:
5632  A9E3 00 00                DEFB    "\0\0"
5633  A9E5              CUR_BLOCK_NUMBER:
5634  A9E5 00 00                DEFB    "\0\0"
5635  A9E7              BLOCK_BASE_RECORD:
5636  A9E7 00 00                DEFB    "\0\0"
5637  A9E9              DEBLOCK_BYTE_OFF:
5638  A9E9 00                   DEFB    "\0"

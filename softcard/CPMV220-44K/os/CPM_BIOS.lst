# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.20 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 44K BIOS runs at z80 $AA00-$AFFF (6 pages). The prior CPM_BIOS.asm decoded
   5  0000              ; it in on-disk (sector-interleaved) order and was both mis-addressed (28.9%
   6  0000              ; source-vs-runtime match) AND missing the 6th page; this source is decoded
   7  0000              ; against the DE-SKEWED runtime image -- every label a true runtime address. The
   8  0000              ; disk producer re-applies the sector skew (cpm_pipeline/deskew.py ::
   9  0000              ; BIOS_PAGE_TO_SECTOR). $AA00 = the 15-entry BIOS jump vector (BOOT, WBOOT,
  10  0000              ; CONST, CONIN, CONOUT, LIST, PUNCH, READER, HOME, SELDSK, SETTRK, SETSEC,
  11  0000              ; SETDMA, READ, WRITE). See ../../docs/CPM_Skew_Findings.md.
  12  0000              ;
  13  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
  14  0000              ; being enriched to the C-level bar.
  15  0000              ; ============================================================================
  16  0000
  17  0000                  INCLUDE "cpm_system_220.inc"   ; CCP/BDOS cross-module bases (CFG_56K re-homes them +$3000)
# file opened: cpm_system_220.inc
   1+ 0000              ; ============================================================================
   2+ 0000              ; cpm_system_220.inc -- CP/M 2.20 (44K) cross-module system contract
   3+ 0000              ; ----------------------------------------------------------------------------
   4+ 0000              ; The de-skewed 2.20-44K system image is TWO independent compilations -- the CCP
   5+ 0000              ; ($9400-$9BFF) and the BDOS ($9C00-$A9FF) -- decoded at their true RUNTIME
   6+ 0000              ; addresses (see ../docs/CPM_Skew_Findings.md). On the correctly-addressed source
   7+ 0000              ; the two are almost decoupled: the CCP calls the BDOS only through the page-zero
   8+ 0000              ; $0005 ABI (cpm22.inc :: BDOS), and the ONLY direct cross-module symbols are the
   9+ 0000              ; two module bases below. They are defined ONCE here and INCLUDEd by both modules
  10+ 0000              ; (never duplicated -- feedback_no_duplicate_symbol_definitions). The earlier
  11+ 0000              ; "59 CCP->BDOS cross-refs" were sector-skew artifacts and do not exist on the
  12+ 0000              ; de-skewed source.
  13+ 0000              ; ============================================================================
  14+ 0000
  15+ 0000              ; Memory-config axis: the 56K (Language Card) system is the 44K image lifted +$3000
  16+ 0000              ; (CCP $9400->$C400, BDOS $9C00->$CC00, BIOS $AA00->$DA00 = Apple LC $D400/$DC00/$EA00).
  17+ 0000              ; Because every address below is derived from this single offset, defining CFG_56K
  18+ 0000              ; (the build's -D flag) re-homes the whole 2.20 OS by re-assembly alone -- no per-cell
  19+ 0000              ; edits. See ../docs/CPM_56K_60K_Fold_Plan.md.
  20+ 0000                  IFDEF CFG_56K
  21+ 0000 ~            OS_RELOC   EQU $3000      ; 56K: OS relocated into the Apple Language Card
  22+ 0000                  ELSE
  23+ 0000              OS_RELOC   EQU $0000      ; 44K: OS in main RAM (the base build)
  24+ 0000                  ENDIF
  25+ 0000
  26+ 0000              CCP_ENTRY  EQU $9400 + OS_RELOC  ; CBASE: CCP cold entry (JP cold-start); BDOS fn 0 / warm boot returns here
  27+ 0000              BDOS_FBASE EQU $9C00 + OS_RELOC  ; FBASE: BDOS image base (6-byte serial + JP +6 entry); top-of-TPA marker the CCP loads
  28+ 0000              BIOS_FBASE EQU $AA00 + OS_RELOC  ; WBOOT/BIOS base = the first byte PAST the BDOS image (CPM_BDOS asserts $ == this)
  29+ 0000
  30+ 0000              ; Region sizes are computed from the contiguous module boundaries above -- never a magic
  31+ 0000              ; number -- so they track the image layout (and the byte gate catches any overrun via the
  32+ 0000              ; CPM_BDOS end-of-image ASSERT). CCP -> BDOS -> BIOS are back-to-back.
  33+ 0000              CCP_SIZE   EQU BDOS_FBASE - CCP_ENTRY     ; $0800: CCP image size  = (first BDOS byte) - (first CCP byte)
  34+ 0000              BDOS_SIZE  EQU BIOS_FBASE - BDOS_FBASE    ; $0E00: BDOS image size = (byte after BDOS) - (first BDOS byte)
  35+ 0000
  36+ 0000              ; --- CCP cells referenced cross-module (single source of truth, by label arithmetic) ---
  37+ 0000              ; CCP_INLEN ($9407 = CCP_ENTRY+7): the CCP console-line returned-count byte (CCP_INBUF+1).
  38+ 0000              ; It doubles as the staged / auto-command flag -- nonzero on CCP entry means a command line
  39+ 0000              ; is already staged in CCP_CMDTEXT and is re-parsed instead of re-prompting (the SUBMIT/$SUB
  40+ 0000              ; chaining hook). The CCP warm-start clears it; the 2.20B BIOS warm-boot path ALSO clears it
  41+ 0000              ; (XOR A; LD (CCP_INLEN),A) so a BIOS-driven warm boot discards any stale staged command and
  42+ 0000              ; the CCP re-prompts cleanly. (The base 2.20 BIOS does not reference it; this is the lone
  43+ 0000              ; genuine BIOS->CCP cell, introduced by 2.20B.)
  44+ 0000              CCP_INLEN  EQU CCP_ENTRY + 7
  45+ 0000
# file closed: cpm_system_220.inc
  18  0000
  19  0000                  IFNDEF CPM_LINK
  20  0000                  DEVICE NOSLOT64K
  21  0000                  ORG BIOS_FBASE                 ; $AA00 (44K) or $DA00 (CFG_56K); the byte past the BDOS image
  22  AA00                  ENDIF
  23  AA00
  24  AA00              ; -- Self-modify / dual-use cells (operand bytes referenced as LABEL+offset, per the
  25  AA00              ;    SoftCard convention: the patched instruction keeps a semantic label; the patch site
  26  AA00              ;    is +1/+2). The cold-boot installer (BOOT..DEV_INSTALL_*) and the deblock share much
  27  AA00              ;    of the $AEA8-$AEBA band: --
  28  AA00              ;      CCP_MODE_FLAG+1       patched immediate of the CCP-launch flag
  29  AA00              ;      KBD_STATUS_40COL+2    CONST read-address, repointed per console card
  30  AA00              ;      RPC_TRIGGER_STORE+1   RPC trigger store-address (set from the SoftCard config)
  31  AA00              ;      PUT_CHAR_VECTOR+1     self-modified screen-emit jump target
  32  AA00              ;      DEV_OUT_1_JP+1 / DEV_OUT_2_JP+1 / DEV_OUT_3_JP(+1/+2)  device-handler vectors
  33  AA00              ;      CONIN_DISPATCH+1      keyboard-wait vector
  34  AA00              ;      DISK_SEKDSK(+1/+2), DISK_HSTWRT(+1), DISK_WRTYPE(+1/+2), DISK_UNADSK(+1/+2),
  35  AA00              ;      DISK_DMAADR, BOOT, BOOT+1   the DRI deblock scratch (sekdsk/hstdsk/hstact/hstwrt/
  36  AA00              ;                                  readop/wrtype/rsflag/unacnt/unatrk/unasec/dmaadr/
  37  AA00              ;                                  sektrk/seksec), overlaid on the install templates.
  38  AA00
  39  AA00              ; ----------------------------------------------------------------------
  40  AA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector.
  41  AA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  42  AA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  43  AA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  44  AA00              ;   In:  entered by JP/CALL to base+3*n. Out: per the dispatched entry.
  45  AA00              ;   Note: the CONOUT and SETTRK targets ($AB43, $AD56) are the second-instruction
  46  AA00              ;         entry points of CONOUT_DISPATCH and HOME's tail, decoded as raw addresses
  47  AA00              ;         here; see flags.
  48  AA00              ; ----------------------------------------------------------------------
  49  AA00              BIOS_VECTOR:
  50  AA00                      ; entry 0 = cold boot (first run after the loader)
  51  AA00 C3 A8 AE             JP BOOT
  52  AA03              BIOS_VECTOR_WBOOT:
  53  AA03                      ; jump table
  54  AA03                      ; entry 1 = warm boot: reload CCP, rebuild page zero
  55  AA03 C3 CC AA             JP      WBOOT
  56  AA06 C3 08 AB             JP      CONST
  57  AA09                  IFDEF V220B
  58  AA09 ~                    JP      CONSOLE_IN_40COL        ; 2.20B: CONIN enters the 40-col handler, which calls the IOBYTE dispatcher then remaps fn/arrow keys
  59  AA09                  ELSE
  60  AA09 C3 50 AB             JP      CONIN
  61  AA0C                  ENDIF
  62  AA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  63  AA0C C3 43 AB             JP      CONOUT_DISPATCH+1
  64  AA0F C3 66 AB             JP      LIST
  65  AA12 C3 75 AB             JP      PUNCH
  66  AA15 C3 87 AB             JP      READER
  67  AA18 C3 4B AD             JP      HOME
  68  AA1B C3 6D AD             JP      SELDSK
  69  AA1E                      ; entry 10 = SETTRK; the LD A,C tail shared with HOME
  70  AA1E C3 56 AD             JP      SETTRK
  71  AA21 C3 89 AD             JP      SETSEC
  72  AA24 C3 8E AD             JP      SETDMA
  73  AA27 C3 93 AD             JP      READ
  74  AA2A C3 A3 AD             JP      WRITE
  75  AA2D              ; ----------------------------------------------------------------------
  76  AA2D              ; The last two jump-table slots are not JPs: both handlers are short enough to sit
  77  AA2D              ; INLINE in the table, which is legal because nothing after entry 16 needs a fixed
  78  AA2D              ; offset. They used to be dumped here as an opaque DEFB run. [RE]
  79  AA2D              ; ----------------------------------------------------------------------
  80  AA2D              ; LISTST -- entry 15: return the list device's ready status.
  81  AA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
  82  AA2D              ;   Algorithm: XOR A / RET. A is $00 whatever the printer is doing. Under the
  83  AA2D              ;     CP/M 2.2 convention $00 means NOT ready and $FF means ready, so this
  84  AA2D              ;     reports "not ready" unconditionally.
  85  AA2D              ;     That is the whole of what these two bytes support. WHO consults LISTST, and
  86  AA2D              ;     what they do with the answer, is NOT determinable from this image, and the
  87  AA2D              ;     SoftCard manual set in softcard/reference/ does not document LISTST at all
  88  AA2D              ;     -- so no claim is made here about callers or about anything blocking. Same two bytes in the 2.23-44K and 2.23-60K twins. [RE]
  89  AA2D              ; ----------------------------------------------------------------------
  90  AA2D              LISTST:
  91  AA2D AF                   XOR A
  92  AA2E C9                   RET
  93  AA2F 00                   DEFB    $00                      ; pad: realigns SECTRAN onto the 3-byte slot grid
  94  AA30              ; ----------------------------------------------------------------------
  95  AA30              ; SECTRAN -- entry 16: logical-to-physical sector translate (identity).
  96  AA30              ;   In:  BC = logical sector, DE = translate-table address (ignored).
  97  AA30              ;   Out: HL = BC (physical == logical).  Clobbers: H, L.
  98  AA30              ;   Algorithm: LD H,B / LD L,C / RET. The DPH XLT field is 0 for every drive, so the
  99  AA30              ;     BDOS asks for no translation and this returns its argument unchanged; the skew
 100  AA30              ;     is applied by the disk producer, off-image. Same three bytes in both twins. [RE]
 101  AA30              ; ----------------------------------------------------------------------
 102  AA30              SECTRAN:
 103  AA30 60                   LD H,B
 104  AA31 69                   LD L,C
 105  AA32 C9                   RET
 106  AA33              ; ----------------------------------------------------------------------
 107  AA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
 108  AA33              ;   drive 0..5). SELDSK returns DPH_TABLE + 16*drive (or 0 for an out-of-range drive).
 109  AA33              ;   Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV, ALV. XLT = 0 (no SECTRAN
 110  AA33              ;   sector translate; the deblock applies the skew internally via SECTOR_XLATE). All six
 111  AA33              ;   drives share one DIRBUF and one DPB. DIRBUF ($AEBA, 128 bytes) and the per-drive CSV
 112  AA33              ;   (checksum, 12 bytes) and ALV (allocation, ~17 bytes) vectors live in the BIOS's own
 113  AA33              ;   $AE/$AF RAM, reused as scratch after the cold-boot code there has run; they are kept
 114  AA33              ;   as literal addresses (not relocatable labels) for that reason. [RE]
 115  AA33              ; ----------------------------------------------------------------------
 116  AA33              ; The DIRBUF/CSV/ALV vectors OVERLAY the cold-boot/sign-on code in pages $AE-$AF: that
 117  AA33              ; code runs once, then the disk system reuses the bytes as scratch buffers (which is why a
 118  AA33              ; post-boot RAM dump shows those pages clobbered). They are in-image addresses, so define
 119  AA33              ; them by arithmetic from BIOS_FBASE -- they relocate with CFG_56K (a raw literal would not,
 120  AA33              ; silently breaking the 56K build's DPH pointers).
 121  AA33              ; DIRBUF, ALV_VECTORS and CSV_VECTORS are the BDOS scratch buffers this table hands out.
 122  AA33              ; They are declared at the foot of this file (see "BDOS scratch overlay"), because they
 123  AA33              ; are a SECOND tenant of bytes the cold-boot code above owns: the layout is set out there
 124  AA33              ; with its own ORG, so each field is a real label rather than a magic address.
 125  AA33              DPH_TABLE:
 126  AA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
 126  AA37 00 00 00 00
 126  AA3B BA AE 93 AA
 126  AA3F 9A AF 3A AF
 127  AA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+16   ; drive 1
 127  AA47 00 00 00 00
 127  AA4B BA AE 93 AA
 127  AA4F A6 AF 4A AF
 128  AA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+32   ; drive 2
 128  AA57 00 00 00 00
 128  AA5B BA AE 93 AA
 128  AA5F B2 AF 5A AF
 129  AA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+48   ; drive 3
 129  AA67 00 00 00 00
 129  AA6B BA AE 93 AA
 129  AA6F BE AF 6A AF
 130  AA73 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+48,ALV_VECTORS+64   ; drive 4
 130  AA77 00 00 00 00
 130  AA7B BA AE 93 AA
 130  AA7F CA AF 7A AF
 131  AA83 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+60,ALV_VECTORS+80   ; drive 5
 131  AA87 00 00 00 00
 131  AA8B BA AE 93 AA
 131  AA8F D6 AF 8A AF
 132  AA93              ; ----------------------------------------------------------------------
 133  AA93              ; DPB -- the shared Disk Parameter Block (5.25" floppy geometry; every DPH points here).
 134  AA93              ;   One label per field, so the field names are symbols rather than prose. The ten names
 135  AA93              ;   are Digital Research's CP/M 2.2 DPB field names. Not [DOC]-citable from THIS archive
 136  AA93              ;   -- the SoftCard set bundles DRI's CP/M 2.2 *Reference Manual*, which documents only
 137  AA93              ;   the BDOS call that RETURNS a DPB pointer (fn 31, Get Addr (disk parms)), not the
 138  AA93              ;   block's layout. The layout IS normatively specified by a DRI manual not in the box:
 139  AA93              ;   the CP/M 2.2 *Alteration Guide* (1979), sec. Disk Parameter Tables. SoftCard CP/M is
 140  AA93              ;   licensed DRI CP/M 2.2, so that manual governs this block. [DOC CPMAG "Disk Parameter
 141  AA93              ;   Tables"]  NOTE: the Guide defines every field but NEVER spells the acronyms out; the
 142  AA93              ;   expansions in the comments below are the conventional readings, not DRI's. [?]
 143  AA93              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 144  AA93              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track; DSM=127 -> 128 blocks =
 145  AA93              ;   128 KB of file area = 32 tracks, which with OFF=3 reserved tracks accounts for a
 146  AA93              ;   35-track disk exactly. [RE]
 147  AA93              ; ----------------------------------------------------------------------
 148  AA93              DPB:
 149  AA93 20 00        SPT:    DEFW    $0020                    ; Sectors Per Track: counts 128-byte RECORDS, not 256-byte sectors -> 32
 150  AA95 03           BSH:    DEFB    $03                      ; Block SHift: log2(records per block) -> 8 records
 151  AA96 07           BLM:    DEFB    $07                      ; BLock Mask: (records per block) - 1 -> 1 KB blocks
 152  AA97 00           EXM:    DEFB    $00                      ; EXtent Mask
 153  AA98 7F 00        DSM:    DEFW    $007F                    ; Disk Size Max: highest allocation block number: 127 -> 128 blocks
 154  AA9A 2F 00        DRM:    DEFW    $002F                    ; DiRectory Max: highest directory entry number: 47 -> 48 entries
 155  AA9C C0           AL0:    DEFB    $C0                      ; ALlocation bitmap, directory-reserved blocks, high byte -> 2
 156  AA9D 00           AL1:    DEFB    $00                      ; ditto, low byte
 157  AA9E 0C 00        CKS:    DEFW    $000C                    ; ChecKSum: directory checksum bytes
 158  AAA0 03 00        OFF:    DEFW    $0003                    ; OFFset: reserved tracks before the file area
 159  AAA2              ; ----------------------------------------------------------------------
 160  AAA2              ; PROBE_DEVICES -- scan the 7-entry SoftCard device/config area and mark presence.
 161  AAA2              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 162  AAA2              ;   Out: config bytes updated in place; calls per-device init when a device is found.
 163  AAA2              ;   Clobbers: A,DE,HL.
 164  AAA2              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E]; if it equals 3 the slot
 165  AAA2              ;              holds a recognized device, so call SLOT_IO_ADDR (build the slot I/O base)
 166  AAA2              ;              and store $03 then $15 into the config cell to flag it configured. A
 167  AAA2              ;              secondary DEC A test (value was 4) runs SET_SCREEN_BASE (console probe) and
 168  AAA2              ;              claims the $C800 shared expansion-ROM window via RPC_TRIGGER. [RE]
 169  AAA2              ; ----------------------------------------------------------------------
 170  AAA2              PROBE_DEVICES:
 171  AAA2                      ; DE = 7 entries to scan (index walks down to 1)
 172  AAA2 11 07 00             LD DE,$0007
 173  AAA5              PROBE_DEVICES_LOOP:
 174  AAA5                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 175  AAA5 21 B8 F3             LD HL,$F3B8
 176  AAA8 19                   ADD HL,DE
 177  AAA9 7E                   LD A,(HL)
 178  AAAA                      ; config value 3 = a recognized/present device in this slot
 179  AAAA D6 03                SUB $03
 180  AAAC 20 07                JR NZ,PROBE_DEVICES_CHK4
 181  AAAE CD 60 AD             CALL SLOT_IO_ADDR
 182  AAB1                      ; rewrite the cell: $03 then $15 = mark this device configured
 183  AAB1 36 03                LD (HL),$03
 184  AAB3 36 15                LD (HL),$15
 185  AAB5              PROBE_DEVICES_CHK4:
 186  AAB5                      ; after the SUB, A==1 here means the original value was 4 (e.g. Videx-class console)
 187  AAB5 3D                   DEC A
 188  AAB6 20 09                JR NZ,PROBE_DEVICES_NEXT
 189  AAB8 CD EE AC             CALL SET_SCREEN_BASE
 190  AABB                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 191  AABB 21 00 C8             LD HL,$C800
 192  AABE CD 3B AB             CALL RPC_TRIGGER
 193  AAC1              PROBE_DEVICES_NEXT:
 194  AAC1                      ; next config entry; loop until all 7 scanned
 195  AAC1 1D                   DEC E
 196  AAC2 20 E1                JR NZ,PROBE_DEVICES_LOOP
 197  AAC4 C9                   RET
 198  AAC5              ; ----------------------------------------------------------------------
 199  AAC5              ; SLOT_IO_ADDR -- form a SoftCard I/O / soft-switch address from a slot/offset index.
 200  AAC5              ;   In:  E = low offset within the I/O page.
 201  AAC5              ;   Out: HL = $E0(E | $E0), i.e. an address in z80 $E000-$EFFF = Apple I/O
 202  AAC5              ;        $C000-$CFFF; A clobbered.
 203  AAC5              ;   Algorithm: H = $E0 base; A = E OR H so the high nibble forces the $C0xx I/O
 204  AAC5              ;        page, then H = A. Used to reach keyboard / soft switches / slot I/O. [RE]
 205  AAC5              ; ----------------------------------------------------------------------
 206  AAC5              DEVICE_IO_BASE:
 207  AAC5                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 208  AAC5 21 00 E0             LD HL,$E000
 209  AAC8 7B                   LD A,E
 210  AAC9                      ; force the high byte into the $C0xx I/O range
 211  AAC9 B4                   OR H
 212  AACA 67                   LD H,A
 213  AACB C9                   RET
 214  AACC              ; ----------------------------------------------------------------------
 215  AACC              ; WBOOT -- CP/M warm boot: re-initialize the console, rebuild page zero, re-enter CCP.
 216  AACC              ;   In:  none. Out: jumps to the CCP at $9400; does not return.
 217  AACC              ;   Clobbers: all.
 218  AACC              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 219  AACC              ;        (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 220  AACC              ;        the device probe; then PAGEZERO_REBUILD writes the standard CP/M page-zero
 221  AACC              ;        jumps and DMA and enters the CCP. [RE]
 222  AACC              ; ----------------------------------------------------------------------
 223  AACC              WBOOT:
 224  AACC                      ; stack at the default DMA buffer top (page-zero $0080)
 225  AACC 31 80 00             LD SP,$0080
 226  AACF                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 227  AACF 3A 51 E0             LD A,($E051)
 228  AAD2 21 00 0E             LD HL,$0E00
 229  AAD5                      ; re-init the console I/O vectors for warm restart
 230  AAD5                  IFDEF V220B
 231  AAD5 ~                    CALL WARMBOOT_INLEN_STUB         ; 2.20B: fire the RPC, then clear CCP_INLEN so warm boot drops any staged command
 232  AAD5                  ELSE
 233  AAD5 CD 3B AB             CALL RPC_TRIGGER
 234  AAD8                  ENDIF
 235  AAD8                      ; re-scan devices so warm boot rebuilds the I/O table
 236  AAD8 CD A2 AA             CALL PROBE_DEVICES
 237  AADB              ; ----------------------------------------------------------------------
 238  AADB              ; PAGEZERO_REBUILD -- write the standard CP/M page-zero vectors and enter the CCP.
 239  AADB              ;   In:  none. Out: tail-calls into CCP_MODE_FLAG / JP $9400 (the CCP); no return.
 240  AADB              ;   Clobbers: A,HL,BC.
 241  AADB              ;   Algorithm: clear two self-modified BIOS state cells; write JP ($C3) at $0000
 242  AADB              ;        pointing at the BIOS vector+3 (warm-boot entry, BIOS_VECTOR_WBOOT) and JP at
 243  AADB              ;        $0005 pointing at the BDOS entry $9C06; set the default DMA to $0080 via
 244  AADB              ;        SETDMA; then fall into the CCP-launch tail. [RE]
 245  AADB              ; ----------------------------------------------------------------------
 246  AADB              PAGEZERO_REBUILD:
 247  AADB AF                   XOR A
 248  AADC                      ; clear a self-modified BIOS console-state cell
 249  AADC 32 B4 AE             LD (DISK_WRTYPE+2),A
 250  AADF 32 AF AE             LD (DISK_SEKDSK+2),A
 251  AAE2                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 252  AAE2 3E C3                LD A,$C3
 253  AAE4                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 254  AAE4 32 00 00             LD ($0000),A
 255  AAE7                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 256  AAE7 21 03 AA             LD HL,BIOS_VECTOR_WBOOT
 257  AAEA 22 01 00             LD ($0001),HL
 258  AAED                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 259  AAED 32 05 00             LD ($0005),A
 260  AAF0                      ; BDOS entry point (BDOS_FBASE+6) for the $0005 hook
 261  AAF0 21 06 9C             LD HL,BDOS_FBASE+6
 262  AAF3 22 06 00             LD ($0006),HL
 263  AAF6                      ; default DMA address = $0080 (page-zero buffer)
 264  AAF6 01 80 00             LD BC,$0080
 265  AAF9                      ; install the default DMA pointer
 266  AAF9 CD 8E AD             CALL SETDMA
 267  AAFC              ; ----------------------------------------------------------------------
 268  AAFC              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag and jump to the CCP.
 269  AAFC              ;   In:  none. Out: JP $9400 (CCP cold/warm entry); no return.
 270  AAFC              ;   Clobbers: A,C.
 271  AAFC              ;   Algorithm: store a CCP-mode flag ($01) into $98B2, then pass the current default
 272  AAFC              ;        drive (page-zero $0004) in C and jump to the CCP at $9400.
 273  AAFC              ;   Self-modify: CCP_MODE_FLAG's immediate ($01) is patched elsewhere to alter the
 274  AAFC              ;        launch path; references therefore read CCP_MODE_FLAG+1. [RE]
 275  AAFC              ; ----------------------------------------------------------------------
 276  AAFC              CCP_MODE_FLAG:
 277  AAFC                      ; CCP-mode flag value (this immediate is self-modified elsewhere)
 278  AAFC 3E 01                LD A,$01
 279  AAFE                      ; store the CCP entry/mode flag into CCP workspace at CCP_ENTRY+$04B2 ($98B2)
 280  AAFE 32 B2 98             LD (CCP_ENTRY+$04B2),A
 281  AB01                      ; page-zero $0004 = current default drive byte
 282  AB01 3A 04 00             LD A,($0004)
 283  AB04 4F                   LD C,A
 284  AB05                      ; enter the CCP at CCP_ENTRY ($9400), C = default drive
 285  AB05 C3 00 94             JP CCP_ENTRY
 286  AB08              ; ----------------------------------------------------------------------
 287  AB08              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 288  AB08              ;   In:  none. Out: A = $FF (ready) / $00 (not). Clobbers: A,HL.
 289  AB08              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 290  AB08              ;        cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler,
 291  AB08              ;        which returns the status in A. [RE]
 292  AB08              ; ----------------------------------------------------------------------
 293  AB08              CONST:
 294  AB08                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 295  AB08 2A 80 F3             LD HL,($F380)
 296  AB0B                      ; dispatch to the selected console-status handler (returns A)
 297  AB0B E9                   JP (HL)
 298  AB0C              ; ----------------------------------------------------------------------
 299  AB0C              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 300  AB0C              ;   In:  none. Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 301  AB0C              ;   Clobbers: A.
 302  AB0C              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard data/strobe; RLA shifts bit 7
 303  AB0C              ;        (key-ready) into carry; SBC A,A expands carry to $FF/$00. This is the
 304  AB0C              ;        built-in 40-col path used when no Videx/80-col card supplies CONST. [RE]
 305  AB0C              ; ----------------------------------------------------------------------
 306  AB0C              KBD_STATUS_40COL:
 307  AB0C                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 308  AB0C 3A 00 E0             LD A,($E000)
 309  AB0F                      ; rotate key-ready bit 7 into carry
 310  AB0F 17                   RLA
 311  AB10                      ; carry -> A = $FF (ready) or $00 (none)
 312  AB10 9F                   SBC A,A
 313  AB11 C9                   RET
 314  AB12              ; ----------------------------------------------------------------------
 315  AB12              ; CONSOLE_IN_40COL -- CONIN for the built-in Apple keyboard (default console-input
 316  AB12              ; handler, installed into the I/O vector table). Waits for a key, then maps it through
 317  AB12              ; a small remap table (function/arrow keys) at Apple $03AB.
 318  AB12              ;   Out: A = (translated) key. Clobbers A,B,C,DE,HL.
 319  AB12              ; ----------------------------------------------------------------------
 320  AB12              CONSOLE_IN_40COL:
 321  AB12                  IFDEF V220B
 322  AB12 ~                    CALL CONIN                       ; 2.20B: get the char via the IOBYTE-routed dispatcher first
 323  AB12                  ELSE
 324  AB12 CD 29 AB             CALL CONIN_KEYWAIT               ; wait for a raw key in A
 325  AB15                  ENDIF
 326  AB15 21 AB F3             LD HL,$F3AB                      ; HL = key-remap table base (Apple $03AB; first entry pair at $03AC)
 327  AB18 06 06                LD B,$06                         ; up to 6 table entries
 328  AB1A 4F                   LD C,A                           ; C = raw key
 329  AB1B              CONIN_XLATE_LOOP:
 330  AB1B 23                   INC HL
 331  AB1C 7E                   LD A,(HL)                        ; entry's match byte
 332  AB1D 23                   INC HL
 333  AB1E B7                   OR A
 334  AB1F FA 27 AB             JP M,CONIN_XLATE_DONE            ; high-bit sentinel ends the table
 335  AB22 B9                   CP C                             ; raw key == this entry?
 336  AB23 7E                   LD A,(HL)                        ; paired replacement byte
 337  AB24 C8                   RET Z                            ; match -> return the translated key
 338  AB25 10 F4                DJNZ CONIN_XLATE_LOOP
 339  AB27              CONIN_XLATE_DONE:
 340  AB27 79                   LD A,C                           ; no match -> return the raw key
 341  AB28 C9                   RET
 342  AB29              CONIN_KEYWAIT:
 343  AB29 11 03 00             LD DE,$0003
 344  AB2C              CONIN_DISPATCH:
 345  AB2C C3 2F AB             JP KBD_WAIT_KEY                  ; target (CONIN_DISPATCH+1) patched at boot
 346  AB2F              KBD_WAIT_KEY:
 347  AB2F 3A 00 E0             LD A,($E000)                     ; poll Apple $C000 keyboard register
 348  AB32 17                   RLA                              ; key-ready (bit 7) -> carry
 349  AB33 30 FA                JR NC,KBD_WAIT_KEY               ; spin until a key is down
 350  AB35 32 10 E0             LD ($E010),A                     ; clear the keyboard strobe (Apple $C010)
 351  AB38 3F                   CCF
 352  AB39 1F                   RRA                              ; A = 7-bit key
 353  AB3A C9                   RET
 354  AB3B              ; ----------------------------------------------------------------------
 355  AB3B              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC: stash HL to the command mailbox at
 356  AB3B              ; Apple $03D0, then poke the trigger cell (its address is patched per config at boot).
 357  AB3B              ;   In: HL = command/params; A = trigger value. Out: per the 6502 service routine.
 358  AB3B              ; ----------------------------------------------------------------------
 359  AB3B              RPC_TRIGGER:
 360  AB3B 22 D0 F3             LD ($F3D0),HL
 361  AB3E              RPC_TRIGGER_STORE:
 362  AB3E 32 00 00             LD ($0000),A
 363  AB41 C9                   RET
 364  AB42              ; ----------------------------------------------------------------------
 365  AB42              ; CONOUT body -- emit a console character, routed by the CP/M IOBYTE.
 366  AB42              ;   In:  A = character (caller's CONOUT arg, moved to C here).
 367  AB42              ;   Out: none. Clobbers: A,C,HL.
 368  AB42              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03). If the
 369  AB42              ;              field selects device value 2 (CRT/console), dispatch through the SoftCard
 370  AB42              ;              I/O vector cell at $F392 (Apple $0392) with JP (HL). Otherwise fall into
 371  AB42              ;              the column-tracking / tab-expansion path (CONOUT_FILTER) which formats the
 372  AB42              ;              character before it reaches the physical screen handler. This is the body
 373  AB42              ;              reached from the BIOS jump-vector CONOUT entry. [RE]
 374  AB42              ; ----------------------------------------------------------------------
 375  AB42              CONOUT_DISPATCH:
 376  AB42                      ; save the character to emit in C for the filter path
 377  AB42 4F                   LD C,A
 378  AB43                      ; read the CP/M IOBYTE (page-zero $0003)
 379  AB43 3A 03 00             LD A,($0003)
 380  AB46                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 381  AB46 E6 03                AND $03
 382  AB48                      ; device value 2 = direct console; anything else takes the filter path
 383  AB48 FE 02                CP $02
 384  AB4A 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 385  AB4C              LIST_VIA_VEC_F392:
 386  AB4C                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 387  AB4C 2A 92 F3             LD HL,($F392)
 388  AB4F E9                   JP (HL)
 389  AB50              ; ----------------------------------------------------------------------
 390  AB50              ; CONIN -- read a console character, routed by the IOBYTE CONSOLE field.
 391  AB50              ;   In:  none. Out: A = character. Clobbers: A,HL.
 392  AB50              ;   Algorithm: read IOBYTE, mask CONSOLE field (AND $03), and select one of three
 393  AB50              ;              input-handler vector cells by the field value: value 2 uses $F38A, value 3
 394  AB50              ;              ($02<x) uses the already-loaded $F384, the low values use $F382; then
 395  AB50              ;              JP (HL) into the chosen handler. ($F38x = Apple $038x I/O vector.) [RE]
 396  AB50              ; ----------------------------------------------------------------------
 397  AB50              CONIN:
 398  AB50 3A 03 00             LD A,($0003)
 399  AB53 E6 03                AND $03
 400  AB55 FE 02                CP $02
 401  AB57                      ; preload input-handler vector for the high CONSOLE field value ($F384 = Apple $0384)
 402  AB57 2A 84 F3             LD HL,($F384)
 403  AB5A 28 06                JR Z,CONIN_VIA_VEC_F38A
 404  AB5C 30 07                JR NC,DISPATCH_VIA_HL
 405  AB5E              CONIN_VIA_VEC_F382:
 406  AB5E                      ; input-handler vector for the low CONSOLE field values ($F382 = Apple $0382)
 407  AB5E 2A 82 F3             LD HL,($F382)
 408  AB61 E9                   JP (HL)
 409  AB62              CONIN_VIA_VEC_F38A:
 410  AB62                      ; input-handler vector for CONSOLE field value 2 ($F38A = Apple $038A)
 411  AB62 2A 8A F3             LD HL,($F38A)
 412  AB65              DISPATCH_VIA_HL:
 413  AB65 E9                   JP (HL)
 414  AB66              ; ----------------------------------------------------------------------
 415  AB66              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 416  AB66              ;   In:  C = character. Out: none. Clobbers: A,HL.
 417  AB66              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0). Field value below
 418  AB66              ;              $80 routes to the column/tab filter (CONOUT_FILTER); value == $80 reuses
 419  AB66              ;              the console vector path (LIST_VIA_VEC_F392); higher values dispatch through
 420  AB66              ;              the list-handler vector cell $F394 (Apple $0394). [RE]
 421  AB66              ; ----------------------------------------------------------------------
 422  AB66              LIST:
 423  AB66 3A 03 00             LD A,($0003)
 424  AB69                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 425  AB69 E6 C0                AND $C0
 426  AB6B FE 80                CP $80
 427  AB6D 38 27                JR C,CONOUT_FILTER
 428  AB6F 28 DB                JR Z,LIST_VIA_VEC_F392
 429  AB71                      ; load list-handler vector ($F394 = Apple $0394)
 430  AB71 2A 94 F3             LD HL,($F394)
 431  AB74 E9                   JP (HL)
 432  AB75              ; ----------------------------------------------------------------------
 433  AB75              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 434  AB75              ;   In:  C = character. Out: none. Clobbers: A,HL.
 435  AB75              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30). Field value below $10 takes
 436  AB75              ;              the column/tab filter; value $10 dispatches through vector $F390; higher
 437  AB75              ;              values dispatch through vector $F38E. ($F38E/$F390 = Apple $038E/$0390.) [RE]
 438  AB75              ; ----------------------------------------------------------------------
 439  AB75              PUNCH:
 440  AB75 3A 03 00             LD A,($0003)
 441  AB78                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 442  AB78 E6 30                AND $30
 443  AB7A FE 10                CP $10
 444  AB7C 38 18                JR C,CONOUT_FILTER
 445  AB7E                      ; punch-handler vector for the higher PUNCH field values ($F38E = Apple $038E)
 446  AB7E 2A 8E F3             LD HL,($F38E)
 447  AB81 20 E2                JR NZ,DISPATCH_VIA_HL
 448  AB83                      ; punch-handler vector for PUNCH field value $10 ($F390 = Apple $0390)
 449  AB83 2A 90 F3             LD HL,($F390)
 450  AB86 E9                   JP (HL)
 451  AB87              ; ----------------------------------------------------------------------
 452  AB87              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 453  AB87              ;   In:  none. Out: A = character. Clobbers: A,HL.
 454  AB87              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C). Field value below $04
 455  AB87              ;              reuses the CONIN low-value vector path; value $04 reuses the CONIN $F38A
 456  AB87              ;              path; higher values dispatch through reader vector $F38C (Apple $038C). [RE]
 457  AB87              ; ----------------------------------------------------------------------
 458  AB87              READER:
 459  AB87 3A 03 00             LD A,($0003)
 460  AB8A                      ; isolate the 2-bit READER device field of the IOBYTE
 461  AB8A E6 0C                AND $0C
 462  AB8C FE 04                CP $04
 463  AB8E 38 CE                JR C,CONIN_VIA_VEC_F382
 464  AB90 28 D0                JR Z,CONIN_VIA_VEC_F38A
 465  AB92                      ; load reader-handler vector ($F38C = Apple $038C)
 466  AB92 2A 8C F3             LD HL,($F38C)
 467  AB95 E9                   JP (HL)
 468  AB96              ; ----------------------------------------------------------------------
 469  AB96              ; CONOUT_FILTER -- column-tracking and tab/control formatting for console output.
 470  AB96              ;   In:  C = character; entered from CONOUT/LIST/PUNCH when the IOBYTE field selects the
 471  AB96              ;        filtered (non-raw) path. A carry/expand flag is set by the entry stub.
 472  AB96              ;   Out: none; emits 0..N physical characters via the screen handler (SCREEN_EMIT).
 473  AB96              ;   Clobbers: A,B,C,D,E,HL.
 474  AB96              ;   Algorithm: SCF then SBC A,A turns the carry into a 0/$FF flag stored in COL_FLAG.
 475  AB96              ;        Clear bit 7 of the character. If a pending-column-skip counter (COL_PENDING) is
 476  AB96              ;        nonzero, decrement it and reposition using config byte $F396 (Apple $0396) plus
 477  AB96              ;        the BOOT-overlaid base word, otherwise fall through to TAB_EXPAND. This is the
 478  AB96              ;        console output formatter; the two CONOUT_FILTER/_10 labels are the carry-set and
 479  AB96              ;        carry-clear entry points to the same body. [RE]
 480  AB96              ; ----------------------------------------------------------------------
 481  AB96              CONOUT_FILTER:
 482  AB96                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 483  AB96 37                   SCF
 484  AB97              CONOUT_FILTER_NOEXPAND:
 485  AB97                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 486  AB97 9F                   SBC A,A
 487  AB98 21 A2 AE             LD HL,COL_FLAG
 488  AB9B                      ; store the entry flag into COL_FLAG
 489  AB9B 77                   LD (HL),A
 490  AB9C                      ; strip the high bit of the character (7-bit ASCII)
 491  AB9C CB B9                RES 7,C
 492  AB9E 23                   INC HL
 493  AB9F                      ; load COL_PENDING (pending column-skip / fill count)
 494  AB9F 7E                   LD A,(HL)
 495  ABA0 B7                   OR A
 496  ABA1                      ; no pending column work -> go run tab/control expansion
 497  ABA1 28 3D                JR Z,TAB_EXPAND
 498  ABA3                      ; consume one pending column step
 499  ABA3 35                   DEC (HL)
 500  ABA4                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 501  ABA4 3A 96 F3             LD A,($F396)
 502  ABA7 21 AB AE             LD HL,DISK_SELDSK_SAVE
 503  ABAA 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 504  ABAC B7                   OR A
 505  ABAD F2 B3 AB             JP P,COL_APPLY_OFFSET_RAW
 506  ABB0 2B                   DEC HL
 507  ABB1              ; ----------------------------------------------------------------------
 508  ABB1              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 509  ABB1              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 510  ABB1              ;   Out: (HL) = C - offset. Clobbers: A,E.
 511  ABB1              ;   Algorithm: mask off the sign bit (AND $7F) to get the magnitude, subtract it from the
 512  ABB1              ;        current column in C, and store the new column. Reached when the config byte's
 513  ABB1              ;        sign indicates a simple subtractive column adjust. [RE]
 514  ABB1              ; ----------------------------------------------------------------------
 515  ABB1              COL_APPLY_OFFSET:
 516  ABB1                      ; drop the sign bit to get the offset magnitude
 517  ABB1 E6 7F                AND $7F
 518  ABB3              COL_APPLY_OFFSET_RAW:
 519  ABB3 5F                   LD E,A
 520  ABB4 79                   LD A,C
 521  ABB5                      ; new column = current column (C) minus the offset
 522  ABB5 93                   SUB E
 523  ABB6                      ; store the updated column position
 524  ABB6 77                   LD (HL),A
 525  ABB7 C9                   RET
 526  ABB8              COL_OFFSET_FROM_WIDTH:
 527  ABB8 B7                   OR A
 528  ABB9 FA BD AB             JP M,COL_OFFSET_FROM_WIDTH_1
 529  ABBC 2B                   DEC HL
 530  ABBD              COL_OFFSET_FROM_WIDTH_1:
 531  ABBD CD B1 AB             CALL COL_APPLY_OFFSET
 532  ABC0 2A AA AE             LD HL,(BOOT+2)
 533  ABC3 3A A1 F3             LD A,($F3A1)
 534  ABC6 B7                   OR A
 535  ABC7 F2 CF AB             JP P,COL_COMBINE_BASE
 536  ABCA E6 7F                AND $7F
 537  ABCC 5D                   LD E,L
 538  ABCD 6C                   LD L,H
 539  ABCE 63                   LD H,E
 540  ABCF              COL_COMBINE_BASE:
 541  ABCF 5F                   LD E,A
 542  ABD0 84                   ADD A,H
 543  ABD1 4F                   LD C,A
 544  ABD2 7B                   LD A,E
 545  ABD3 85                   ADD A,L
 546  ABD4 F5                   PUSH AF
 547  ABD5 06 07                LD B,$07
 548  ABD7 CD 2D AC             CALL SCREEN_EMIT
 549  ABDA F1                   POP AF
 550  ABDB 06 0A                LD B,$0A
 551  ABDD              ; ----------------------------------------------------------------------
 552  ABDD              ; CONOUT_EMIT_B -- emit character C, then route to TAB_EXPAND/SCREEN_EMIT with B as mode.
 553  ABDD              ;   In:  A = character to emit; B = mode/count code.
 554  ABDD              ;   Out: none. Clobbers: A,C.
 555  ABDD              ;   Algorithm: move A into C and fall through to SCREEN_EMIT (SCREEN_EMIT) carrying the B
 556  ABDD              ;        mode code. Tail-shared helper used by the column/tab logic to push a character
 557  ABDD              ;        to the physical screen handler. [RE]
 558  ABDD              ; ----------------------------------------------------------------------
 559  ABDD              CONOUT_EMIT_B:
 560  ABDD                      ; move the character into C for the screen emit path
 561  ABDD 4F                   LD C,A
 562  ABDE 18 4D                JR SCREEN_EMIT
 563  ABE0              ; ----------------------------------------------------------------------
 564  ABE0              ; TAB_EXPAND -- expand tabs / handle special columns against the tab-stop config table.
 565  ABE0              ;   In:  C = character (already 7-bit); B = passed from caller.
 566  ABE0              ;   Out: none; may emit fill characters and update the column state. Clobbers: A,B,C,D,E,HL.
 567  ABE0              ;   Algorithm: COL_STATE (COL_STATE) holds a sticky control state. If zero, compare the
 568  ABE0              ;        character against config byte $F397 (Apple $0397, a special trigger char); a match
 569  ABE0              ;        arms the sticky state ($80). Printable characters above $1F scan the 9-entry tab
 570  ABE0              ;        config table at $F3A0 (Apple $03A0, walked downward) for a matching stop; on a hit
 571  ABE0              ;        it indexes +$0B into a parallel table for the action byte, optionally recursing
 572  ABE0              ;        with config $F3A2 to emit a secondary character. A B==7 result sets COL_MODE
 573  ABE0              ;        (COL_PENDING) = 2. Falls through to SCREEN_EMIT for the actual output. [RE]
 574  ABE0              ; ----------------------------------------------------------------------
 575  ABE0              TAB_EXPAND:
 576  ABE0 47                   LD B,A
 577  ABE1                      ; HL -> COL_STATE sticky control-state cell
 578  ABE1 21 A4 AE             LD HL,COL_STATE
 579  ABE4 7E                   LD A,(HL)
 580  ABE5 5F                   LD E,A
 581  ABE6 B7                   OR A
 582  ABE7 20 11                JR NZ,TAB_TABLE_SCAN
 583  ABE9                      ; read the special trigger character from config ($F397 = Apple $0397)
 584  ABE9 3A 97 F3             LD A,($F397)
 585  ABEC B7                   OR A
 586  ABED 28 06                JR Z,TAB_EXPAND_CHECK_CTRL
 587  ABEF                      ; does the current character match the trigger?
 588  ABEF B9                   CP C
 589  ABF0 20 03                JR NZ,TAB_EXPAND_CHECK_CTRL
 590  ABF2                      ; arm the sticky control state for the next character
 591  ABF2 36 80                LD (HL),$80
 592  ABF4 C9                   RET
 593  ABF5              TAB_EXPAND_CHECK_CTRL:
 594  ABF5                      ; control-char threshold: chars <= $1F are not table-scanned
 595  ABF5 3E 1F                LD A,$1F
 596  ABF7 B9                   CP C
 597  ABF8 38 33                JR C,SCREEN_EMIT
 598  ABFA              TAB_TABLE_SCAN:
 599  ABFA                      ; HL -> top of the 9-entry tab-stop config table ($F3A0 = Apple $03A0)
 600  ABFA 21 A0 F3             LD HL,$F3A0
 601  ABFD                      ; 9 tab-stop table entries to scan
 602  ABFD 06 09                LD B,$09
 603  ABFF              TAB_TABLE_SCAN_LOOP:
 604  ABFF 7E                   LD A,(HL)
 605  AC00 B7                   OR A
 606  AC01 28 04                JR Z,TAB_TABLE_SCAN_NEXT
 607  AC03                      ; fold in COL_STATE before comparing the table entry to the char
 608  AC03 AB                   XOR E
 609  AC04 B9                   CP C
 610  AC05 28 05                JR Z,TAB_TABLE_HIT
 611  AC07              TAB_TABLE_SCAN_NEXT:
 612  AC07 2B                   DEC HL
 613  AC08 10 F5                DJNZ TAB_TABLE_SCAN_LOOP
 614  AC0A 18 21                JR SCREEN_EMIT
 615  AC0C              TAB_TABLE_HIT:
 616  AC0C                      ; step +$0B from the matched stop to its parallel action byte
 617  AC0C 11 0B 00             LD DE,$000B
 618  AC0F 19                   ADD HL,DE
 619  AC10 7E                   LD A,(HL)
 620  AC11 B7                   OR A
 621  AC12 4F                   LD C,A
 622  AC13 F2 23 AC             JP P,TAB_EXPAND_DONE
 623  AC16 E6 7F                AND $7F
 624  AC18 4F                   LD C,A
 625  AC19 C5                   PUSH BC
 626  AC1A                      ; secondary action character from config ($F3A2 = Apple $03A2)
 627  AC1A 3A A2 F3             LD A,($F3A2)
 628  AC1D 06 07                LD B,$07
 629  AC1F CD DD AB             CALL CONOUT_EMIT_B
 630  AC22 C1                   POP BC
 631  AC23              TAB_EXPAND_DONE:
 632  AC23 78                   LD A,B
 633  AC24                      ; action code 7 -> set COL_MODE = 2
 634  AC24 FE 07                CP $07
 635  AC26 20 05                JR NZ,SCREEN_EMIT
 636  AC28 3E 02                LD A,$02
 637  AC2A                      ; record COL_MODE = 2 for the next emit
 638  AC2A 32 A3 AE             LD (COL_PENDING),A
 639  AC2D              ; ----------------------------------------------------------------------
 640  AC2D              ; CONOUT_VIA_SCREEN -- emit one character to the Apple text screen, then advance
 641  AC2D              ; the cursor and redraw it.
 642  AC2D              ;   In:  the pending character is taken from the screen-driver state cells, not from
 643  AC2D              ;        a register here (SCREEN_CHAR holds the char-under-cursor; the caller has
 644  AC2D              ;        already staged the glyph). B = control-code selector for CTRL_CHAR_DISPATCH.
 645  AC2D              ;   Out: none. Clobbers: A,DE,HL.
 646  AC2D              ;   Algorithm: clear the wrap/scroll flag (COL_STATE), then vector through one of
 647  AC2D              ;              two screen-driver entry points selected by COL_FLAG (modeled in
 648  AC2D              ;              $F386/$F388 = Apple $0386/$0388 of the SoftCard I/O vector table).
 649  AC2D              ;              [RE] COL_FLAG selects 40-col vs 80-col / normal vs alternate path.
 650  AC2D              ; ----------------------------------------------------------------------
 651  AC2D              SCREEN_EMIT:
 652  AC2D AF                   XOR A
 653  AC2E                      ; clear the pending wrap/scroll flag before emitting
 654  AC2E                      ; clear COL_STATE before handing off to the screen handler
 655  AC2E 32 A4 AE             LD (COL_STATE),A
 656  AC31                      ; screen-mode selector: chooses which driver entry to vector to [RE]
 657  AC31                      ; test COL_FLAG to choose which screen-output vector to use
 658  AC31 3A A2 AE             LD A,(COL_FLAG)
 659  AC34 B7                   OR A
 660  AC35                      ; default screen-driver entry (SoftCard vector table, Apple $0388)
 661  AC35                      ; default screen-output vector ($F388 = Apple $0388)
 662  AC35 2A 88 F3             LD HL,($F388)
 663  AC38 28 03                JR Z,SCREEN_EMIT_VECTOR
 664  AC3A                      ; alternate screen-driver entry (Apple $0386) when selector nonzero
 665  AC3A                      ; alternate screen-output vector ($F386 = Apple $0386)
 666  AC3A 2A 86 F3             LD HL,($F386)
 667  AC3D              ; ----------------------------------------------------------------------
 668  AC3D              ; Merge point: HL = the selected screen-driver entry; fall through to the JP (HL).
 669  AC3D              ; ----------------------------------------------------------------------
 670  AC3D              SCREEN_EMIT_VECTOR:
 671  AC3D                      ; tail-jump into the selected screen-driver entry point
 672  AC3D E9                   JP (HL)
 673  AC3E              ; ----------------------------------------------------------------------
 674  AC3E              ; PUT_CHAR_DE3 -- screen-driver entry that preloads DE=3 (advance amount / column
 675  AC3E              ; step) and falls into the glyph-store path. [RE]
 676  AC3E              ;   In:  driver state cells as set up by CONOUT_VIA_SCREEN.
 677  AC3E              ;   Out: none. Clobbers: A,DE,HL.
 678  AC3E              ; ----------------------------------------------------------------------
 679  AC3E              PUT_CHAR_DE3:
 680  AC3E                      ; preset DE = column/advance step for this driver variant [RE]
 681  AC3E 11 03 00             LD DE,$0003
 682  AC41              ; ----------------------------------------------------------------------
 683  AC41              ; PUT_CHAR_VECTOR -- indirect entry into the glyph-store body. This JP's target
 684  AC41              ; operand is SELF-MODIFIED elsewhere (patch site = PUT_CHAR_VECTOR+1); it normally
 685  AC41              ; points at PUT_CHAR_STORE. Treat the +1/+2 bytes as the live dispatch target. [RE]
 686  AC41              ; ----------------------------------------------------------------------
 687  AC41              PUT_CHAR_VECTOR:
 688  AC41                      ; dispatch into the glyph-store body; target operand (PUT_CHAR_VECTOR+1) is patched at
 689  AC41                      ; runtime [RE]
 690  AC41 C3 44 AC             JP PUT_CHAR_STORE
 691  AC44              ; ----------------------------------------------------------------------
 692  AC44              ; PUT_CHAR_STORE -- store the current glyph at the cursor cell, recompute the cursor
 693  AC44              ; screen address from CH/BASL, read back the char now under the cursor, and write it
 694  AC44              ; as the inverse/cursor glyph.
 695  AC44              ;   In:  SCREEN_CURSOR_PTR = current cursor screen pointer; SCREEN_CHAR = glyph to store.
 696  AC44              ;   Out: SCREEN_CURSOR_PTR/SCREEN_CHAR updated to the new cursor cell + char under it.
 697  AC44              ;        Clobbers: A,DE,HL.
 698  AC44              ;   Algorithm: write staged glyph to old cursor cell; run the control-char handler
 699  AC44              ;              (CTRL_CHAR_DISPATCH) which may move CH; recompute the cell address as
 700  AC44              ;              BASL + CH ($F028/$F024 = Apple $0028/$0024); save char under cursor;
 701  AC44              ;              convert it to the inverse-video cursor glyph and store it. [RE]
 702  AC44              ; ----------------------------------------------------------------------
 703  AC44              PUT_CHAR_STORE:
 704  AC44                      ; HL = saved cursor screen pointer (cell holding the cursor)
 705  AC44 2A A5 AE             LD HL,(SCREEN_CURSOR_PTR)
 706  AC47                      ; A = staged glyph (the real char that belongs in that cell)
 707  AC47 3A A7 AE             LD A,(SCREEN_CHAR)
 708  AC4A                      ; draw the inverse-video cursor glyph in the new cell
 709  AC4A                      ; restore the real char into the old cursor cell
 710  AC4A 77                   LD (HL),A
 711  AC4B                      ; run control-char handling / cursor advance (may update CH=$F024)
 712  AC4B CD 6B AC             CALL CTRL_CHAR_DISPATCH
 713  AC4E                      ; HL = current text line base BASL/BASH (Apple ZP $0028/$0029)
 714  AC4E 2A 28 F0             LD HL,($F028)
 715  AC51                      ; A = cursor column CH (Apple ZP $0024)
 716  AC51 3A 24 F0             LD A,($F024)
 717  AC54 5F                   LD E,A
 718  AC55                      ; high byte $F0 maps column offset into the Apple low-RAM screen region
 719  AC55 16 F0                LD D,$F0
 720  AC57                      ; HL = BASL + CH = address of the new cursor cell
 721  AC57 19                   ADD HL,DE
 722  AC58                      ; save the new cursor cell pointer
 723  AC58 22 A5 AE             LD (SCREEN_CURSOR_PTR),HL
 724  AC5B 7E                   LD A,(HL)
 725  AC5C                      ; save the char currently under the cursor (to restore later)
 726  AC5C 32 A7 AE             LD (SCREEN_CHAR),A
 727  AC5F                      ; is the char in the lowercase/high range? choose inverse-video mapping
 728  AC5F FE E0                CP $E0
 729  AC61 38 02                JR C,PUT_CHAR_CURSOR_GLYPH
 730  AC63                      ; fold lowercase to its display form for the cursor glyph
 731  AC63 EE 20                XOR $20
 732  AC65              ; ----------------------------------------------------------------------
 733  AC65              ; Merge point in the cursor-glyph conversion (chars below $E0 skip the XOR $20 fold).
 734  AC65              ; ----------------------------------------------------------------------
 735  AC65              PUT_CHAR_CURSOR_GLYPH:
 736  AC65                      ; mask to 6-bit glyph code
 737  AC65 E6 3F                AND $3F
 738  AC67                      ; set inverse/flash field for the on-screen cursor glyph
 739  AC67 F6 40                OR $40
 740  AC69 77                   LD (HL),A
 741  AC6A C9                   RET
 742  AC6B              ; ----------------------------------------------------------------------
 743  AC6B              ; CTRL_CHAR_DISPATCH -- handle a control character / cursor-motion code by indexing a
 744  AC6B              ; per-code offset table and jumping to the matching handler body.
 745  AC6B              ;   In:  B = control-code index (0 = none/plain char). A is loaded from B.
 746  AC6B              ;   Out: per-handler (typically updates CH=$F024 and/or the line base). Clobbers A,HL.
 747  AC6B              ;   Algorithm: if B==0 fall through to the plain-character handler at CTRL_PLAIN_CHAR. Else
 748  AC6B              ;              push the RET address RPC_TRIGGER (each handler RETs back through it), load
 749  AC6B              ;              HL = CTRL_HANDLER_OFFSET_TBL, add the code to L, read the handler's low byte
 750  AC6B              ;              from the table (high byte stays $AC), and JP (HL) into the handler body. The
 751  AC6B              ;              handlers set HL to an Apple monitor routine address and RET (the caller fires
 752  AC6B              ;              the 6502 RPC), or update the cursor cells (CH/CV at Apple ZP $0024/$0025)
 753  AC6B              ;              directly. See CTRL_HANDLER_OFFSET_TBL for the code -> handler mapping.
 754  AC6B              ; ----------------------------------------------------------------------
 755  AC6B              CTRL_CHAR_DISPATCH:
 756  AC6B                      ; A = control-code index passed in B
 757  AC6B 78                   LD A,B
 758  AC6C                      ; index 0 means plain character: fall through to CTRL_PLAIN_CHAR
 759  AC6C B7                   OR A
 760  AC6D                      ; no control code: take the plain-char store path
 761  AC6D 28 0B                JR Z,CTRL_PLAIN_CHAR
 762  AC6F                      ; push the common return address so each handler RETs back here [RE]
 763  AC6F 21 3B AB             LD HL,RPC_TRIGGER
 764  AC72 E5                   PUSH HL
 765  AC73                      ; HL = base of the per-code handler offset table
 766  AC73 21 D4 AC             LD HL,CTRL_HANDLER_OFFSET_TBL
 767  AC76                      ; index the table: L = table_base_low + control-code; (HL) then holds the handler low byte
 768  AC76                      ; [RE]
 769  AC76 85                   ADD A,L
 770  AC77                      ; dispatch tail: L = table base low + control code; fetch the handler low byte
 771  AC77                      ; (high byte stays $AC) and jump to it.
 772  AC77 6F                   LD L,A
 773  AC78 6E                   LD L,(HL)                        ; 6E  L = CTRL_HANDLER_OFFSET_TBL[code]
 774  AC79 E9                   JP (HL)                          ; E9  enter the handler in page $AC
 775  AC7A              ; CTRL_PLAIN_CHAR -- store a printable character (or handle CR) on the text screen.
 776  AC7A              CTRL_PLAIN_CHAR:
 777  AC7A 79                   LD A,C
 778  AC7B FE 0D                CP $0D                           ; carriage return?
 779  AC7D 20 05                JR NZ,CTRL_PLAIN_PUT
 780  AC7F AF                   XOR A
 781  AC80 32 24 F0             LD ($F024),A                     ; CR: reset cursor column CH (Apple ZP $0024)
 782  AC83 C9                   RET
 783  AC84              CTRL_PLAIN_PUT:
 784  AC84 F6 80                OR $80                           ; set high bit (Apple screen glyph)
 785  AC86 FE E0                CP $E0                           ; in the lowercase range?
 786  AC88 38 04                JR C,CTRL_PLAIN_STORE
 787  AC8A 21 DD F3             LD HL,$F3DD                      ; case-fold config byte (Apple $03DD)
 788  AC8D AE                   XOR (HL)
 789  AC8E              CTRL_PLAIN_STORE:
 790  AC8E 32 45 F0             LD ($F045),A                     ; stash the glyph (Apple ZP $0045)
 791  AC91 21 F0 FD             LD HL,$FDF0                      ; HL = Apple monitor COUT1 ($FDF0) for the 6502 RPC
 792  AC94 18 79                JR PLOT_RPC_TAIL                 ; emit via the shared RPC tail
 793  AC96              ; --- control-code handlers (entered via the offset table; each RETs through RPC_TRIGGER) ---
 794  AC96              CTRL_VIDEO_NORMAL:                       ; code 4: select normal video
 795  AC96 3E FF                LD A,$FF
 796  AC98 01                   DEFB    $01                      ; cover (LD BC,nn): skips the LD A,$3F below
 797  AC99              CTRL_VIDEO_INVERSE:                      ; code 5: select inverse video
 798  AC99 3E 3F                LD A,$3F
 799  AC9B 32 32 F0             LD ($F032),A                     ; INVFLG (Apple ZP $0032): $FF = normal, $3F = inverse
 800  AC9E              CTRL_POP_RET:                            ; code 7: discard the pushed return and exit
 801  AC9E E1                   POP HL
 802  AC9F C9                   RET
 803  ACA0              CTRL_CURSOR_RIGHT:                       ; code 9: cursor right
 804  ACA0 21 F4 FB             LD HL,$FBF4                      ; HL = Apple monitor ADVANCE ($FBF4) for the RPC
 805  ACA3 C9                   RET
 806  ACA4              CTRL_HOME_CURSOR:                        ; code 6: home the cursor (CH/CV = 0)
 807  ACA4 AF                   XOR A
 808  ACA5 6F                   LD L,A
 809  ACA6 67                   LD H,A
 810  ACA7 22 24 F0             LD ($F024),HL                    ; Apple ZP $0024/$0025 (CH/CV) = (0,0)
 811  ACAA              CTRL_BASCAL2:
 812  ACAA 32 45 F0             LD ($F045),A
 813  ACAD 21 C1 FB             LD HL,$FBC1                      ; HL = Apple monitor BASCAL2 ($FBC1, line-base calc) for the RPC
 814  ACB0 C9                   RET
 815  ACB1              CTRL_CLREOP:                             ; code 2: clear to end of page -> $FC42 CLREOP
 816  ACB1 2E 42                LD L,$42
 817  ACB3 01                   DEFB    $01                      ; cover: skips the LD L,$9C below
 818  ACB4              CTRL_CLREOL:                             ; code 3: clear to end of line -> $FC9C CLREOL
 819  ACB4 2E 9C                LD L,$9C
 820  ACB6 01                   DEFB    $01                      ; cover: skips the LD L,$1A below
 821  ACB7              CTRL_CURSOR_UP:                          ; code 8: cursor up -> $FC1A UP
 822  ACB7 2E 1A                LD L,$1A
 823  ACB9 01                   DEFB    $01                      ; cover: skips the LD L,$58 below
 824  ACBA              CTRL_CLR_HOME:                           ; code 1: clear screen + home -> $FC58 HOME
 825  ACBA 2E 58                LD L,$58
 826  ACBC 26 FC                LD H,$FC                         ; HL = Apple monitor routine in page $FC (per the L above)
 827  ACBE C9                   RET
 828  ACBF              CTRL_CLAMP_CURSOR:                       ; code 10: clamp the saved cursor to 40x24 and store it
 829  ACBF 2A AA AE             LD HL,(BOOT+2)                   ; load saved cursor col/row (BOOT+2 cell)
 830  ACC2 7D                   LD A,L
 831  ACC3 FE 28                CP $28                           ; column >= 40?
 832  ACC5 38 02                JR C,CTRL_CLAMP_ROW
 833  ACC7 2E 00                LD L,$00                         ; clamp column to 0
 834  ACC9              CTRL_CLAMP_ROW:
 835  ACC9 7C                   LD A,H
 836  ACCA FE 18                CP $18                           ; row >= 24?
 837  ACCC 38 02                JR C,CTRL_CLAMP_STORE
 838  ACCE 26 00                LD H,$00                         ; clamp row to 0
 839  ACD0              CTRL_CLAMP_STORE:
 840  ACD0 22 24 F0             LD ($F024),HL                    ; store cursor (Apple ZP $0024/$0025)
 841  ACD3 18                   DEFB    $18                      ; JR opcode; its offset is the table[0] byte below
 842  ACD4                                                       ;        ($D5 = -43 -> CTRL_BASCAL2)
 843  ACD4              CTRL_HANDLER_OFFSET_TBL:
 844  ACD4                      ; low byte of each control-code handler (high byte $AC); indexed by control code
 845  ACD4                      ; 1..10. Entry [0]=$D5 doubles as the JR offset above (code 0 never dispatches here;
 846  ACD4                      ; it falls through to CTRL_PLAIN_CHAR earlier).
 847  ACD4                      ; -> [0]=JR-offset, COL_58, COL_42, COL_9C, MODE_FF, MODE_3F, HOME, POP_RET, COL_1A,
 848  ACD4                      ;    RPC_FBF4, CLAMP
 849  ACD4 D5 BA B1 B4          DEFB    $D5,$BA,$B1,$B4,$96,$99,$A4,$9E,$B7,$A0,$BF
 849  ACD8 96 99 A4 9E
 849  ACDC B7 A0 BF
 850  ACDF              ; DEV_STROBE_RD -- device handler: poll a status bit at the slot I/O base, then strobe.
 851  ACDF              DEV_STROBE_RD:
 852  ACDF CD 60 AD             CALL SLOT_IO_ADDR                ; HL = slot I/O base for the device
 853  ACE2              DEV_STROBE_WAIT:
 854  ACE2 7E                   LD A,(HL)
 855  ACE3 E6 02                AND $02                          ; wait for the ready bit
 856  ACE5 28 FB                JR Z,DEV_STROBE_WAIT
 857  ACE7 2C                   INC L
 858  ACE8 71                   LD (HL),C                        ; hand the byte to the device
 859  ACE9 C9                   RET
 860  ACEA              ; ----------------------------------------------------------------------
 861  ACEA              ; SET_CURSOR_COL_AND_BASE -- set the cursor column from C, then compute the screen
 862  ACEA              ; line base address for the current row.
 863  ACEA              ;   In:  C = cursor column. Row state read inside SLOT_IO_ADDR_W.
 864  ACEA              ;   Out: CH=$F045 set; falls through to SET_SCREEN_BASE. Clobbers A,HL (per AD5B).
 865  ACEA              ;   Algorithm: store C to the column cell (Apple $0045), then fall into the base
 866  ACEA              ;              computation. [RE]
 867  ACEA              ; ----------------------------------------------------------------------
 868  ACEA              SET_CURSOR_COL_AND_BASE:
 869  ACEA                      ; A = requested cursor column from C
 870  ACEA 79                   LD A,C
 871  ACEB                      ; store cursor column (Apple ZP $0045) [RE]
 872  ACEB 32 45 F0             LD ($F045),A
 873  ACEE              ; ----------------------------------------------------------------------
 874  ACEE              ; SET_SCREEN_BASE -- compute the text-line base address for the current cursor row
 875  ACEE              ; and stash its parts in the Apple ZP screen-base cells.
 876  ACEE              ;   In:  row state (consumed by SLOT_IO_ADDR_W).
 877  ACEE              ;   Out: A = char under cursor (from (HL)); $F6F8/$F045/$F046/$F047 updated.
 878  ACEE              ;        Clobbers A,HL.
 879  ACEE              ;   Algorithm: call SLOT_IO_ADDR_W to derive the row base, store it to the scratch cell
 880  ACEE              ;              $F6F8 (Apple $06F8) and to $F047 (Apple $0047); read a column from the
 881  ACEE              ;              SoftCard I/O region $EFFF (Apple $CFFF), normalize via DEVICE_IO_BASE,
 882  ACEE              ;              subtract a space ($20) bias, store to $F046, and return char-under-
 883  ACEE              ;              cursor in A. [RE] exact roles of $F045/$F046/$F047 = BASL/BASH/col.
 884  ACEE              ; ----------------------------------------------------------------------
 885  ACEE              SET_SCREEN_BASE:
 886  ACEE                      ; derive the text-line base address for the current row
 887  ACEE CD 5B AD             CALL SLOT_IO_ADDR_W
 888  ACF1                      ; save base into scratch cell (Apple $06F8)
 889  ACF1 32 F8 F6             LD ($F6F8),A
 890  ACF4                      ; store base into a screen-base cell (Apple ZP $0047)
 891  ACF4 32 47 F0             LD ($F047),A
 892  ACF7                      ; read a column/value from SoftCard I/O ($EFFF = Apple $CFFF) [RE]
 893  ACF7 3A FF EF             LD A,($EFFF)
 894  ACFA CD C5 AA             CALL DEVICE_IO_BASE
 895  ACFD                      ; remove the space ($20) bias to get a screen offset [RE]
 896  ACFD D6 20                SUB $20
 897  ACFF                      ; store the computed offset into a screen-base cell (Apple ZP $0046)
 898  ACFF 32 46 F0             LD ($F046),A
 899  AD02                      ; return the character currently at the computed cell
 900  AD02 7E                   LD A,(HL)
 901  AD03 C9                   RET
 902  AD04              ; ----------------------------------------------------------------------
 903  AD04              ; PLOT_CHAR_AT_COL -- position to a column then write C into the row buffer at that
 904  AD04              ; offset, and tail-jump to the common screen-driver return.
 905  AD04              ;   In:  C = character; DE = column offset; cursor row state.
 906  AD04              ;   Out: char stored into the row buffer at $F678+DE (Apple $0678+DE). [RE]
 907  AD04              ;   Algorithm: recompute the base via SET_CURSOR_COL_AND_BASE, form $F678+DE,
 908  AD04              ;              store C, then JP RPC_TRIGGER (shared driver epilogue). [RE]
 909  AD04              ; ----------------------------------------------------------------------
 910  AD04              PLOT_CHAR_AT_COL:
 911  AD04                      ; set cursor column and recompute the row base
 912  AD04 CD EA AC             CALL SET_CURSOR_COL_AND_BASE
 913  AD07                      ; HL = row buffer base (Apple $0678) [RE]
 914  AD07 21 78 F6             LD HL,$F678
 915  AD0A                      ; HL = buffer base + column offset DE
 916  AD0A 19                   ADD HL,DE
 917  AD0B                      ; store the character at the target column
 918  AD0B 71                   LD (HL),C
 919  AD0C 21 AA C9             LD HL,$C9AA
 920  AD0F                      ; tail into the shared screen-driver return path
 921  AD0F              PLOT_RPC_TAIL:
 922  AD0F C3 3B AB             JP RPC_TRIGGER                   ; (emit via the SoftCard RPC trigger)
 923  AD12              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 924  AD12              DEV_READ_BIT:                            ; (DEV_HANDLER_PTRS_B[0])
 925  AD12 CD 60 AD             CALL SLOT_IO_ADDR
 926  AD15              DEV_READ_WAIT:
 927  AD15 7E                   LD A,(HL)
 928  AD16 1F                   RRA                              ; ready bit -> carry
 929  AD17 30 FC                JR NC,DEV_READ_WAIT
 930  AD19 2C                   INC L
 931  AD1A 7E                   LD A,(HL)                        ; read the data byte
 932  AD1B C9                   RET
 933  AD1C              ; DEV_OUT_RPC -- device handler: position via the screen base, RPC a fixed command, read back.
 934  AD1C              DEV_OUT_RPC:                             ; (DEV_HANDLER_PTRS_B[1])
 935  AD1C CD EE AC             CALL SET_SCREEN_BASE
 936  AD1F 21 4D C8             LD HL,$C84D
 937  AD22 CD 3B AB             CALL RPC_TRIGGER                 ; trigger the SoftCard RPC
 938  AD25 21 78 F6             LD HL,$F678                      ; row buffer base (Apple $0678)
 939  AD28 19                   ADD HL,DE
 940  AD29 7E                   LD A,(HL)
 941  AD2A C9                   RET
 942  AD2B              DEV_OUT_1:                               ; (default I/O vector handler)
 943  AD2B 11 01 00             LD DE,$0001
 944  AD2E              DEV_OUT_1_JP:
 945  AD2E C3 3E AD             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 946  AD31              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 947  AD31              DEV_WR_BIT:                              ; (DEV_HANDLER_PTRS[2])
 948  AD31 CD C5 AA             CALL DEVICE_IO_BASE
 949  AD34 2E C1                LD L,$C1
 950  AD36              DEV_WR_WAIT:
 951  AD36 7E                   LD A,(HL)
 952  AD37 17                   RLA                              ; ready bit -> carry
 953  AD38 38 FC                JR C,DEV_WR_WAIT
 954  AD3A CD 5B AD             CALL SLOT_IO_ADDR_W
 955  AD3D 71                   LD (HL),C
 956  AD3E              DEV_RET:
 957  AD3E C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 958  AD3F              DEV_OUT_2:                               ; (default I/O vector handler)
 959  AD3F 11 02 00             LD DE,$0002
 960  AD42              DEV_OUT_2_JP:
 961  AD42 C3 3E AD             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 962  AD45              DEV_OUT_3:                               ; (default I/O vector handler)
 963  AD45 11 02 00             LD DE,$0002
 964  AD48              DEV_OUT_3_JP:
 965  AD48 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 966  AD4B              ; ----------------------------------------------------------------------
 967  AD4B              ; HOME -- BIOS jump-vector entry: seek the selected drive to track 0.
 968  AD4B              ;   In:  none (operates on the selected disk).
 969  AD4B              ;   Out: none. Clobbers: A,C.
 970  AD4B              ;   Algorithm: if the host buffer still holds dirty (hstwrt) data, leave hstact
 971  AD4B              ;              set so the pending write is not lost; otherwise mark the host
 972  AD4B              ;              buffer inactive (hstact=0). Then fall into SETTRK with track 0,
 973  AD4B              ;              recording sektrk=0. The actual head step happens later inside the
 974  AD4B              ;              deblock read/write path, not here. [RE]
 975  AD4B              ; ----------------------------------------------------------------------
 976  AD4B              HOME:
 977  AD4B                      ; read hstwrt (host-write-pending flag)
 978  AD4B 3A B0 AE             LD A,(DISK_HSTWRT)
 979  AD4E B7                   OR A
 980  AD4F 20 03                JR NZ,SETTRK_STORE
 981  AD51                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 982  AD51 32 AF AE             LD (DISK_SEKDSK+2),A
 983  AD54              ; ----------------------------------------------------------------------
 984  AD54              ; SETTRK -- BIOS jump-vector entry (vector $AA1E -> here): set the requested track.
 985  AD54              ;   In:  C = track number (BC = track; only C used).
 986  AD54              ;   Out: none. Clobbers: A.
 987  AD54              ;   Algorithm: store C into sektrk (the BDOS-requested track). HOME falls in here
 988  AD54              ;              with C=0. The track is consumed later by the deblock host-match
 989  AD54              ;              test and the RWTS setup, not acted on immediately.
 990  AD54              ; ----------------------------------------------------------------------
 991  AD54              SETTRK_STORE:
 992  AD54                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 993  AD54 0E 00                LD C,$00
 994  AD56                      ; track number from BDOS
 995  AD56              SETTRK:                                  ; BIOS jump-vector entry 10 (HOME falls in above)
 996  AD56 79                   LD A,C
 997  AD57                      ; store into sektrk (overlaid on the BOOT entry's LD SP operand)
 998  AD57 32 A8 AE             LD (BOOT),A
 999  AD5A C9                   RET
1000  AD5B              ; ----------------------------------------------------------------------
1001  AD5B              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
1002  AD5B              ;   In:  E = slot/drive index (0..15).
1003  AD5B              ;   Out: HL = $E080 + (E << 4) = Apple $C080+slot*16 soft-switch register.
1004  AD5B              ;        A preserved low nibble math. Clobbers: A,L.
1005  AD5B              ;   Algorithm: load the $C08x base for the write/control bank, then fall into the
1006  AD5B              ;              common index scaler (SLOT_IO_SCALE) that shifts E left by 4 and adds it
1007  AD5B              ;              to L. z80 $E080 = Apple $C080 (slot I/O space). [RE]
1008  AD5B              ; ----------------------------------------------------------------------
1009  AD5B              SLOT_IO_ADDR_W:
1010  AD5B                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
1011  AD5B 21 80 E0             LD HL,$E080
1012  AD5E 18 03                JR SLOT_IO_SCALE_E
1013  AD60              ; ----------------------------------------------------------------------
1014  AD60              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch address ($C08E bank).
1015  AD60              ;   In:  E = slot/drive index (0..15).
1016  AD60              ;   Out: HL = $E08E + (E << 4) = Apple $C08E+slot*16. Clobbers: A,L.
1017  AD60              ;   Algorithm: load the $C08E base, then SLOT_IO_SCALE shifts E left by 4 (ADD A,A x4)
1018  AD60              ;              and adds it to L to index the per-slot $C0n0..$C0nF register block.
1019  AD60              ;              z80 $E08E = Apple $C08E (slot I/O). [RE]
1020  AD60              ; ----------------------------------------------------------------------
1021  AD60              SLOT_IO_ADDR:
1022  AD60                      ; z80 $E08E = Apple $C08E slot-I/O base
1023  AD60 21 8E E0             LD HL,$E08E
1024  AD63              SLOT_IO_SCALE_E:
1025  AD63                      ; slot/drive index
1026  AD63 7B                   LD A,E
1027  AD64              SLOT_IO_SCALE:
1028  AD64 87                   ADD A,A
1029  AD65 87                   ADD A,A
1030  AD66 87                   ADD A,A
1031  AD67 87                   ADD A,A
1032  AD68 F5                   PUSH AF
1033  AD69 85                   ADD A,L
1034  AD6A 6F                   LD L,A
1035  AD6B F1                   POP AF
1036  AD6C C9                   RET
1037  AD6D              ; ----------------------------------------------------------------------
1038  AD6D              ; SELDSK -- BIOS jump-vector entry: select the disk drive for subsequent I/O.
1039  AD6D              ;   In:  C = disk number (0-based).
1040  AD6D              ;   Out: HL = DPH (disk parameter header) address for drive C, or HL=0 if C is out
1041  AD6D              ;             of range. Clobbers: A,DE,HL.
1042  AD6D              ;   Algorithm: read the configured drive count from the SoftCard config block
1043  AD6D              ;              (z80 $F3B8 = Apple $03B8). If C >= count, return 0. Otherwise record
1044  AD6D              ;              the selected disk into the sekdsk build site (DISK_SELDSK_SAVE+1 = $04 marker
1045  AD6D              ;              then C) and return the constant DPH at DPH_TABLE scaled by the index.
1046  AD6D              ;              z80 $F3B8 = Apple ZP/config $03B8. [RE]
1047  AD6D              ; ----------------------------------------------------------------------
1048  AD6D              SELDSK:
1049  AD6D                      ; DE -> sekdsk build site (the SMC cells overlaid on the BOOT-area instructions)
1050  AD6D 11 AC AE             LD DE,DISK_SELDSK_SAVE+1
1051  AD70 21 04 00             LD HL,$0004
1052  AD73                      ; configured drive count from Apple config $03B8
1053  AD73 3A B8 F3             LD A,($F3B8)
1054  AD76 3D                   DEC A
1055  AD77                      ; requested drive vs (count-1); C-flag set if out of range
1056  AD77 B9                   CP C
1057  AD78                      ; out of range -> return HL=0
1058  AD78 38 0A                JR C,SELDSK_BAD_DRIVE
1059  AD7A 7E                   LD A,(HL)
1060  AD7B                      ; store the marker, then the selected disk number into sekdsk
1061  AD7B 12                   LD (DE),A
1062  AD7C 13                   INC DE
1063  AD7D 79                   LD A,C
1064  AD7E 12                   LD (DE),A
1065  AD7F                      ; base DPH; SLOT_IO_SCALE indexes it by the drive number
1066  AD7F 21 33 AA             LD HL,DPH_TABLE
1067  AD82 18 E0                JR SLOT_IO_SCALE
1068  AD84              SELDSK_BAD_DRIVE:
1069  AD84 1A                   LD A,(DE)
1070  AD85 77                   LD (HL),A
1071  AD86 2E 00                LD L,$00
1072  AD88 C9                   RET
1073  AD89              ; ----------------------------------------------------------------------
1074  AD89              ; SETSEC -- BIOS jump-vector entry: set the requested sector.
1075  AD89              ;   In:  C = sector number.
1076  AD89              ;   Out: none. Clobbers: A.
1077  AD89              ;   Algorithm: store C into seksec (the BDOS-requested sector, overlaid on BOOT+1).
1078  AD89              ;              Consumed later by the deblock host-match test.
1079  AD89              ; ----------------------------------------------------------------------
1080  AD89              SETSEC:
1081  AD89 79                   LD A,C
1082  AD8A                      ; store into seksec
1083  AD8A 32 A9 AE             LD (BOOT+1),A
1084  AD8D C9                   RET
1085  AD8E              ; ----------------------------------------------------------------------
1086  AD8E              ; SETDMA -- BIOS jump-vector entry: set the DMA (record transfer) address.
1087  AD8E              ;   In:  BC = DMA buffer address (where the 128-byte CP/M record is read to/written from).
1088  AD8E              ;   Out: none. Clobbers: none.
1089  AD8E              ;   Algorithm: store BC into dmaadr; the deblock copy (LDIR) uses it as the host<->record
1090  AD8E              ;              transfer endpoint.
1091  AD8E              ; ----------------------------------------------------------------------
1092  AD8E              SETDMA:
1093  AD8E                      ; store the DMA address into dmaadr
1094  AD8E ED 43 B8 AE          LD (DISK_DMAADR),BC
1095  AD92 C9                   RET
1096  AD93              ; ----------------------------------------------------------------------
1097  AD93              ; READ -- BIOS jump-vector entry: read one 128-byte CP/M record via deblocking.
1098  AD93              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set by SELDSK/SETTRK/SETSEC/SETDMA.
1099  AD93              ;   Out: A = 0 on success, 1 on error (set by the shared deblock tail). Clobbers: A,HL,...
1100  AD93              ;   Algorithm: clear unacnt (no unallocated-write run is in progress on a read), then
1101  AD93              ;              mark this as a read: readop=2 and seed the wrtype/flag bytes to 2, and
1102  AD93              ;              jump into the shared deblock core which pre-reads the host sector if the
1103  AD93              ;              requested record is not already buffered, then copies host -> DMA. [RE]
1104  AD93              ; ----------------------------------------------------------------------
1105  AD93              READ:
1106  AD93 AF                   XOR A
1107  AD94                      ; unacnt = 0: a read never continues an unallocated-write run
1108  AD94 32 B4 AE             LD (DISK_WRTYPE+2),A
1109  AD97 3E 02                LD A,$02
1110  AD99                      ; HL -> readop; seed readop and the following flag bytes = 2 (read operation)
1111  AD99 21 B1 AE             LD HL,DISK_HSTWRT+1
1112  AD9C 77                   LD (HL),A
1113  AD9D 23                   INC HL
1114  AD9E 77                   LD (HL),A
1115  AD9F 23                   INC HL
1116  ADA0 77                   LD (HL),A
1117  ADA1                      ; enter the shared deblock core (skip the write-only pre-roll)
1118  ADA1 18 4F                JR DEBLOCK_CORE
1119  ADA3              ; ----------------------------------------------------------------------
1120  ADA3              ; WRITE -- BIOS jump-vector entry: write one 128-byte CP/M record via deblocking.
1121  ADA3              ;   In:  C = write type (0=allocated, 1=directory, 2=to a freshly-allocated/unalloc block);
1122  ADA3              ;        sekdsk/sektrk/seksec/dmaadr previously set.
1123  ADA3              ;   Out: A = 0 on success, 1 on error. Clobbers: A,HL,...
1124  ADA3              ;   Algorithm: record readop/wrtype from C. For an unallocated-block write (C=2) seed an
1125  ADA3              ;              8-record run (unacnt=8) anchored at the current sekdsk/sektrk/seksec so the
1126  ADA3              ;              next 7 sequential records skip the redundant pre-read. Then the shared
1127  ADA3              ;              deblock core: if the requested record extends the active unalloc run just
1128  ADA3              ;              buffer it (rsflag=0); otherwise force a host pre-read (rsflag=1), copy
1129  ADA3              ;              DMA -> host, mark hstwrt. [RE]
1130  ADA3              ; ----------------------------------------------------------------------
1131  ADA3              WRITE:
1132  ADA3 61                   LD H,C
1133  ADA4 2E 00                LD L,$00
1134  ADA6                      ; readop = wrtype (from C), clear the adjacent flag byte
1135  ADA6 22 B1 AE             LD (DISK_HSTWRT+1),HL
1136  ADA9 79                   LD A,C
1137  ADAA                      ; wrtype 2 = write to an unallocated block (start a sequential run)
1138  ADAA FE 02                CP $02
1139  ADAC                      ; ordinary write: skip the unalloc-run seeding
1140  ADAC 20 0F                JR NZ,DEBLOCK_CHECK_UNALLOC
1141  ADAE                      ; unacnt = 8 records in the new unallocated run (host blocking factor)
1142  ADAE 2E 08                LD L,$08
1143  ADB0                      ; compare sekdsk against the run's disk
1144  ADB0 3A AD AE             LD A,(DISK_SEKDSK)
1145  ADB3 67                   LD H,A
1146  ADB4                      ; seed unacnt (and the next byte) for the run
1147  ADB4 22 B4 AE             LD (DISK_WRTYPE+2),HL
1148  ADB7                      ; anchor the run's next-track/sector (unatrk/unasec) at the requested sektrk/seksec
1149  ADB7 2A A8 AE             LD HL,(BOOT)
1150  ADBA                      ; advance unatrk/unasec to the next record in the run
1151  ADBA 22 B6 AE             LD (DISK_UNADSK+1),HL
1152  ADBD              ; ----------------------------------------------------------------------
1153  ADBD              ; DEBLOCK_CHECK_UNALLOC -- decide whether the requested record continues the active
1154  ADBD              ;   unallocated-write run; if so just buffer it, else force a pre-read.
1155  ADBD              ;   In:  unacnt/unatrk/unasec, sekdsk/sektrk/seksec set by READ/WRITE.
1156  ADBD              ;   Out: rsflag set (0 = reuse buffer, 1 = must pre-read host sector). Clobbers: A,HL.
1157  ADBD              ;   Algorithm: if unacnt==0 the run is over -> rsflag=1. Otherwise verify the request
1158  ADBD              ;              matches sekdsk and the run's next unatrk/unasec; on a match advance the
1159  ADBD              ;              run and set rsflag=0, on any mismatch set rsflag=1. [RE]
1160  ADBD              ; ----------------------------------------------------------------------
1161  ADBD              DEBLOCK_CHECK_UNALLOC:
1162  ADBD                      ; point HL at unacnt (unallocated record count)
1163  ADBD 21 B4 AE             LD HL,DISK_WRTYPE+2
1164  ADC0                      ; unacnt: zero means no active unalloc run
1165  ADC0 7E                   LD A,(HL)
1166  ADC1 B7                   OR A
1167  ADC2 28 28                JR Z,DEBLOCK_FORCE_PREREAD
1168  ADC4                      ; consume one record of the unallocated run
1169  ADC4 35                   DEC (HL)
1170  ADC5 3A AD AE             LD A,(DISK_SEKDSK)
1171  ADC8 23                   INC HL
1172  ADC9 BE                   CP (HL)
1173  ADCA 20 20                JR NZ,DEBLOCK_FORCE_PREREAD
1174  ADCC 3A A8 AE             LD A,(BOOT)
1175  ADCF                      ; load unatrk/unasec (the run's current track/sector)
1176  ADCF 2A B6 AE             LD HL,(DISK_UNADSK+1)
1177  ADD2 BD                   CP L
1178  ADD3 20 17                JR NZ,DEBLOCK_FORCE_PREREAD
1179  ADD5                      ; requested seksec vs the run's sector
1180  ADD5 3A A9 AE             LD A,(BOOT+1)
1181  ADD8 BC                   CP H
1182  ADD9 20 11                JR NZ,DEBLOCK_FORCE_PREREAD
1183  ADDB                      ; advance the unalloc sector; wrap to next track when it passes the sectors-per-track limit
1184  ADDB                      ; ($20)
1185  ADDB 24                   INC H
1186  ADDC 7C                   LD A,H
1187  ADDD D6 20                SUB $20
1188  ADDF 38 02                JR C,DEBLOCK_RUN_CONTINUES
1189  ADE1 67                   LD H,A
1190  ADE2 2C                   INC L
1191  ADE3              DEBLOCK_RUN_CONTINUES:
1192  ADE3 22 B6 AE             LD (DISK_UNADSK+1),HL
1193  ADE6 AF                   XOR A
1194  ADE7                      ; rsflag = 0: record continues the run, no host pre-read needed
1195  ADE7 32 B3 AE             LD (DISK_WRTYPE+1),A
1196  ADEA 18 06                JR DEBLOCK_CORE
1197  ADEC              DEBLOCK_FORCE_PREREAD:
1198  ADEC                      ; rsflag = 1: record breaks the run, force a host-sector pre-read
1199  ADEC 21 01 00             LD HL,$0001
1200  ADEF 22 B3 AE             LD (DISK_WRTYPE+1),HL
1201  ADF2              ; ----------------------------------------------------------------------
1202  ADF2              ; DEBLOCK_CORE -- shared host-buffer management for READ and WRITE (the deblock heart).
1203  ADF2              ;   In:  sekdsk/sektrk/seksec, readop, wrtype, rsflag, hstact, hstwrt, dmaadr.
1204  ADF2              ;   Out: A = status (0 ok). Performs the host sector flush/read and the 128-byte
1205  ADF2              ;        record copy host<->DMA. Clobbers: A,BC,DE,HL.
1206  ADF2              ;   Algorithm: translate seksec through SECTOR_XLATE to the physical sector. If the
1207  ADF2              ;              host buffer is active (hstact) but holds a different disk/track/sector,
1208  ADF2              ;              flush it when dirty (hstwrt). Set up the RWTS request (track/sector/
1209  ADF2              ;              unit into the Apple $03Ex IOB). If rsflag demands it, physically read
1210  ADF2              ;              the host sector. Finally LDIR-copy the selected 128-byte half of the
1211  ADF2              ;              host sector to/from dmaadr (direction chosen by readop), and on a write
1212  ADF2              ;              mark hstwrt and flush if required. [RE]
1213  ADF2              ; ----------------------------------------------------------------------
1214  ADF2              DEBLOCK_CORE:
1215  ADF2                      ; read seksec back (returns the requested sector for translation)
1216  ADF2 CD F0 AF             CALL READ_SEKSEC
1217  ADF5 5F                   LD E,A
1218  ADF6 1F                   RRA
1219  ADF7                      ; translate logical sector -> physical via the skew table
1220  ADF7 21 92 AE             LD HL,SECTOR_XLATE
1221  ADFA 85                   ADD A,L
1222  ADFB 6F                   LD L,A
1223  ADFC 4E                   LD C,(HL)
1224  ADFD                      ; HL -> hstact; remember prior state, then mark the host buffer active
1225  ADFD 21 AF AE             LD HL,DISK_SEKDSK+2
1226  AE00 7E                   LD A,(HL)
1227  AE01                      ; hstact = 1 (host buffer now in use)
1228  AE01 36 01                LD (HL),$01
1229  AE03 B7                   OR A
1230  AE04                      ; host buffer was inactive: no flush/match test needed, go set up RWTS
1231  AE04 28 1B                JR Z,DEBLOCK_SETUP_RWTS
1232  AE06                      ; compare sekdsk vs hstdsk (host buffer's disk)
1233  AE06 2A AD AE             LD HL,(DISK_SEKDSK)
1234  AE09 7D                   LD A,L
1235  AE0A BC                   CP H
1236  AE0B 20 0D                JR NZ,DEBLOCK_NEED_RELOAD
1237  AE0D                      ; Apple $03E0 = current RWTS track/sector in the host buffer
1238  AE0D 2A E0 F3             LD HL,($F3E0)
1239  AE10                      ; requested sektrk vs host buffer track
1240  AE10 3A A8 AE             LD A,(BOOT)
1241  AE13 BD                   CP L
1242  AE14 20 04                JR NZ,DEBLOCK_NEED_RELOAD
1243  AE16 79                   LD A,C
1244  AE17 BC                   CP H
1245  AE18                      ; requested record already in the host buffer -> skip flush and re-read, go straight to the
1246  AE18                      ; copy
1247  AE18 28 33                JR Z,DEBLOCK_COPY_RECORD
1248  AE1A              DEBLOCK_NEED_RELOAD:
1249  AE1A                      ; hstwrt: if the outgoing host buffer is dirty, flush it first
1250  AE1A 3A B0 AE             LD A,(DISK_HSTWRT)
1251  AE1D B7                   OR A
1252  AE1E                      ; flush the dirty host buffer before reloading
1253  AE1E C4 73 AE             CALL NZ,DISK_WRITE_HOST
1254  AE21              DEBLOCK_SETUP_RWTS:
1255  AE21 3A AD AE             LD A,(DISK_SEKDSK)
1256  AE24 32 AE AE             LD (DISK_SEKDSK+1),A
1257  AE27 47                   LD B,A
1258  AE28 E6 01                AND $01
1259  AE2A 3C                   INC A
1260  AE2B                      ; Apple $03E4 = RWTS unit/volume cell
1261  AE2B 32 E4 F3             LD ($F3E4),A
1262  AE2E 78                   LD A,B
1263  AE2F E6 0E                AND $0E
1264  AE31 87                   ADD A,A
1265  AE32 87                   ADD A,A
1266  AE33 87                   ADD A,A
1267  AE34 2F                   CPL
1268  AE35 C6 61                ADD A,$61
1269  AE37                      ; Apple $03E6 = RWTS track cell
1270  AE37 32 E6 F3             LD ($F3E6),A
1271  AE3A 3A A8 AE             LD A,(BOOT)
1272  AE3D 6F                   LD L,A
1273  AE3E 61                   LD H,C
1274  AE3F                      ; Apple $03E0 = record the host buffer's new track/sector
1275  AE3F 22 E0 F3             LD ($F3E0),HL
1276  AE42                      ; rsflag: nonzero -> physically pre-read the host sector
1277  AE42 3A B3 AE             LD A,(DISK_WRTYPE+1)
1278  AE45 B7                   OR A
1279  AE46                      ; perform the host sector read (RWTS read entry)
1280  AE46 C4 7A AE             CALL NZ,DISK_READ_HOST
1281  AE49 AF                   XOR A
1282  AE4A                      ; hstwrt = 0 after a fresh read
1283  AE4A 32 B0 AE             LD (DISK_HSTWRT),A
1284  AE4D              DEBLOCK_COPY_RECORD:
1285  AE4D 7B                   LD A,E
1286  AE4E                      ; z80 $F800 = Apple $0800 host sector buffer base
1287  AE4E 21 00 F8             LD HL,$F800
1288  AE51 1F                   RRA
1289  AE52                      ; select the upper/lower 128-byte half of the host sector from the record's parity
1290  AE52 CB 1D                RR L
1291  AE54                      ; dmaadr = the CP/M record buffer
1292  AE54 ED 5B B8 AE          LD DE,(DISK_DMAADR)
1293  AE58                      ; 128-byte CP/M record length
1294  AE58 01 80 00             LD BC,$0080
1295  AE5B                      ; readop: nonzero = read (host->DMA), zero = write (DMA->host)
1296  AE5B 3A B1 AE             LD A,(DISK_HSTWRT+1)
1297  AE5E B7                   OR A
1298  AE5F 20 05                JR NZ,DEBLOCK_COPY
1299  AE61 3C                   INC A
1300  AE62 32 B0 AE             LD (DISK_HSTWRT),A
1301  AE65                      ; write direction: swap so LDIR copies DMA -> host buffer
1302  AE65 EB                   EX DE,HL
1303  AE66              DEBLOCK_COPY:
1304  AE66                      ; copy the 128-byte record host<->DMA
1305  AE66 ED B0                LDIR
1306  AE68                      ; wrtype: bit 0 decides whether a write must flush immediately (directory write)
1307  AE68 3A B2 AE             LD A,(DISK_WRTYPE)
1308  AE6B 1F                   RRA
1309  AE6C 3E 00                LD A,$00
1310  AE6E D0                   RET NC
1311  AE6F                      ; immediate flush of the dirty host buffer
1312  AE6F CD 73 AE             CALL DISK_WRITE_HOST
1313  AE72 C9                   RET
1314  AE73              ; ----------------------------------------------------------------------
1315  AE73              ; DISK_WRITE_HOST -- write the staged host sector to disk via the SoftCard RWTS RPC.
1316  AE73              ;   Clears hstwrt, sets the RWTS command cell ($F3EB = Apple $03EB) to write ($02),
1317  AE73              ;   fires the RPC (RPC_TRIGGER) with the track/sector params, then checks RWTS status
1318  AE73              ;   ($F3EA = Apple $03EA): 0 = OK; $10 = write-protected -> dispatch the BDOS read-only
1319  AE73              ;   disk error through the vector at ($9C0D). The read entry DISK_READ_HOST just below
1320  AE73              ;   shares this body via the $21 cover. Called by the deblock to flush a dirty host
1321  AE73              ;   buffer / write a directory record. [RE]
1322  AE73              ; ----------------------------------------------------------------------
1323  AE73              DISK_WRITE_HOST:
1324  AE73 AF                   XOR A
1325  AE74                      ; clear the host-buffer-dirty flag (hstwrt) as part of the flush
1326  AE74 32 B0 AE             LD (DISK_HSTWRT),A
1327  AE77 3E 02                LD A,$02
1328  AE79 21                   DEFB    $21                      ; cover (LD HL,nn opcode): on fall-through absorbs the
1329  AE7A              ; ----------------------------------------------------------------------
1330  AE7A              ; DISK_READ_HOST -- read a host sector from disk via the RWTS RPC. A direct CALL enters
1331  AE7A              ;   here so the LD A,$01 sets the RWTS command to read ($01); the $21 cover above absorbs
1332  AE7A              ;   this instruction on fall-through, leaving DISK_WRITE_HOST's A=$02 (write). Shares the
1333  AE7A              ;   RWTS command/status path with DISK_WRITE_HOST. [RE]
1334  AE7A              ; ----------------------------------------------------------------------
1335  AE7A              DISK_READ_HOST:
1336  AE7A 3E 01                LD A,$01                         ; CALL'd directly -> A=$01 (cover-skipped on fall-through)
1337  AE7C                      ; store the console-selector index into the SoftCard config block (Apple $03EB)
1338  AE7C 32 EB F3             LD ($F3EB),A
1339  AE7F 21 03 0E             LD HL,$0E03
1340  AE82                      ; probe/init the selected console device handler
1341  AE82 CD 3B AB             CALL RPC_TRIGGER
1342  AE85                      ; read the detected device-class byte from the config block (Apple $03EA)
1343  AE85 3A EA F3             LD A,($F3EA)
1344  AE88 B7                   OR A
1345  AE89                      ; no special device class -> done
1346  AE89 C8                   RET Z
1347  AE8A D1                   POP DE
1348  AE8B                      ; device class $10 -> dispatch through the installed handler vector
1349  AE8B FE 10                CP $10
1350  AE8D C0                   RET NZ
1351  AE8E                      ; fetch the handler entry from the CCP/loader vector cell (BDOS_FBASE+$0D) and tail-jump to it [RE]
1352  AE8E 2A 0D 9C             LD HL,(BDOS_FBASE+$0D)
1353  AE91 E9                   JP (HL)
1354  AE92              ; ----------------------------------------------------------------------
1355  AE92              ; SECTOR_XLATE -- 16-entry logical->physical sector skew table (a 0..15 permutation).
1356  AE92              ;   Indexed by the deblock code (LD A,L add-offset lookup) to translate a CP/M logical
1357  AE92              ;   sector to the physical RWTS sector. DATA, not code.
1358  AE92              ; ----------------------------------------------------------------------
1359  AE92              SECTOR_XLATE:
1360  AE92                      ; 16-entry logical->physical sector skew table (a 0..15 permutation),
1361  AE92                      ; indexed during disk deblock (DEV_HANDLER_LOOKUP-style *1 byte lookups).
1362  AE92 00 09 03 0C          DEFB    $00,$09,$03,$0C,$06,$0F,$01,$0A
1362  AE96 06 0F 01 0A
1363  AE9A 04 0D 07 08          DEFB    $04,$0D,$07,$08,$02,$0B,$05,$0E
1363  AE9E 02 0B 05 0E
1364  AEA2              ; ----------------------------------------------------------------------
1365  AEA2              ; COL_FLAG -- console-output entry/expand flag (0 or $FF), set by CONOUT_FILTER and
1366  AEA2              ;   tested by SCREEN_EMIT to pick the physical output vector. Immediately followed by
1367  AEA2              ;   COL_PENDING at A3-adjacent cells. Scratch byte, init $00. [RE]
1368  AEA2              ; ----------------------------------------------------------------------
1369  AEA2              COL_FLAG:
1370  AEA2 00                   DEFB    $00                      ; disk scratch byte
1371  AEA3              ; ----------------------------------------------------------------------
1372  AEA3              ; COL_PENDING -- pending column-skip / fill counter for console output, also reused as a
1373  AEA3              ;   mode byte (set to 2 by TAB_EXPAND_DONE). Decremented as columns are consumed.
1374  AEA3              ;   Accessed as COL_FLAG+1 in CONOUT_FILTER. Scratch byte, init $00. [RE]
1375  AEA3              ; ----------------------------------------------------------------------
1376  AEA3              COL_PENDING:
1377  AEA3 00                   DEFB    $00                      ; disk scratch byte
1378  AEA4              ; ----------------------------------------------------------------------
1379  AEA4              ; COL_STATE -- sticky control/escape state for tab expansion; armed to $80 on a trigger-
1380  AEA4              ;   char match and cleared by SCREEN_EMIT. Scratch byte, init $00. [RE]
1381  AEA4              ; ----------------------------------------------------------------------
1382  AEA4              COL_STATE:
1383  AEA4 00                   DEFB    $00                      ; disk scratch byte
1384  AEA5              ; ----------------------------------------------------------------------
1385  AEA5              ; SCREEN_CURSOR_PTR -- 2-byte pointer cell used by the screen routines (initialized to
1386  AEA5              ;   point at SCREEN_CHAR / SCREEN_CHAR). Loaded and re-stored by PUT_CHAR_STORE while reading
1387  AEA5              ;   the Apple cursor base ($F028) and column ($F024) to compute the on-screen cell. [RE]
1388  AEA5              ; ----------------------------------------------------------------------
1389  AEA5              SCREEN_CURSOR_PTR:
1390  AEA5 A7 AE                DEFW    SCREEN_CHAR              ; pointer cell (init -> SCREEN_CHAR)
1391  AEA7              ; ----------------------------------------------------------------------
1392  AEA7              ; SCREEN_CHAR -- saved on-screen character byte (the cell SCREEN_CURSOR_PTR points at by
1393  AEA7              ;   default); written back to the screen with format bits applied. Scratch byte, init $00.
1394  AEA7              ;   [RE]
1395  AEA7              ; ----------------------------------------------------------------------
1396  AEA7              SCREEN_CHAR:
1397  AEA7 00                   DEFB    $00                      ; disk scratch byte
1398  AEA8              ; ----------------------------------------------------------------------
1399  AEA8              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector $AA00 lands here via $AA00->$AEA8).
1400  AEA8              ;   In:  none. Out: does not return through here (falls into the install engine).
1401  AEA8              ;   Clobbers: all.
1402  AEA8              ;   DUAL USE of the first 2 operand bytes: this 'LD SP,$0100' executes once at cold boot;
1403  AEA8              ;   afterwards BOOT and BOOT+1 (the $00,$01 immediate-operand bytes) are reused as the
1404  AEA8              ;   disk-deblock sektrk and seksec cells: HOME/SETTRK write BOOT (sektrk), SETSEC writes
1405  AEA8              ;   BOOT+1 (seksec), and the WRITE/READ deblock and READ_SEKSEC read them. The third byte
1406  AEA8              ;   BOOT+2 is a SEPARATE console cursor word (read by the column/tab path and
1407  AEA8              ;   CTRL_CLAMP_CURSOR), NOT a disk cell. Valid SP-init bytes only during the single
1408  AEA8              ;   cold-boot pass; thereafter scratch, never re-executed. [RE]
1409  AEA8              ;   Algorithm: set the Z-80 stack, then fall through into the self-modifying install
1410  AEA8              ;   engine (PATCH_* cells) that writes the per-config operands into the running BIOS.
1411  AEA8              ; ----------------------------------------------------------------------
1412  AEA8              BOOT:
1413  AEA8                      ; init Z-80 stack; BOOT/BOOT+1 are reused post-boot as the sektrk/seksec deblock
1414  AEA8                      ; cells (BOOT=track, BOOT+1=sector); BOOT+2 is a separate console cursor word
1415  AEA8 31 00 01             LD SP,$0100
1416  AEAB              ; ----------------------------------------------------------------------
1417  AEAB              ; DISK_SELDSK_SAVE -- (boot install template 'LD A,$C9'); +1 byte reused as SELDSK scratch.
1418  AEAB              ;   At cold boot this is the install engine's 'LD A,$C9' template. After boot SELDSK
1419  AEAB              ;   stores the previously-selected drive (page-zero $0004) into DISK_SELDSK_SAVE+1,
1420  AEAB              ;   then the disk number into DISK_SEKDSK (the next cell). [RE]
1421  AEAB              ; ----------------------------------------------------------------------
1422  AEAB              DISK_SELDSK_SAVE:
1423  AEAB 3E C9                LD A,$C9
1424  AEAD              ; ----------------------------------------------------------------------
1425  AEAD              ; DISK_SEKDSK -- CP/M-requested disk number (DRI deblock 'sekdsk'); +1/+2 = hstdsk/hstact.
1426  AEAD              ;   Boot tenant: install template 'LD (nn),A' (operand runtime-patched). Operational
1427  AEAD              ;   tenant: SELDSK stores the selected disk number here; DISK_SEKDSK+1 = host disk
1428  AEAD              ;   (hstdsk [RE]); DISK_SEKDSK+2 = host-buffer-active flag (hstact), cleared by WBOOT/
1429  AEAD              ;   HOME and the deblock, set when a host sector is staged. [RE]
1430  AEAD              ; ----------------------------------------------------------------------
1431  AEAD              DISK_SEKDSK:
1432  AEAD 32 00 AA             LD (BIOS_VECTOR),A
1433  AEB0              ; ----------------------------------------------------------------------
1434  AEB0              ; DISK_HSTWRT -- host-buffer-dirty flag (DRI deblock 'hstwrt' [RE]); +1 = readop [RE].
1435  AEB0              ;   Boot tenant: install template 'LD A,$95' (the default IOBYTE immediate). Operational
1436  AEB0              ;   tenant: a deblock flag the WRITE path sets and the host-flush test reads;
1437  AEB0              ;   DISK_HSTWRT+1 is the read/seek scratch the READ/WRITE deblock loads. [RE]
1438  AEB0              ; ----------------------------------------------------------------------
1439  AEB0              DISK_HSTWRT:
1440  AEB0 3E 95                LD A,$95
1441  AEB2              ; ----------------------------------------------------------------------
1442  AEB2              ; DISK_WRTYPE -- deblock write type (DRI 'wrtype' [RE]); +1 = rsflag, +2 = unacnt.
1443  AEB2              ;   Boot tenant: install template 'LD ($0003),A' (stores the default IOBYTE). Operational
1444  AEB2              ;   tenant: DISK_WRTYPE+1 = read-sector-needed flag (rsflag); DISK_WRTYPE+2 = unallocated
1445  AEB2              ;   record count (unacnt), seeded to 8 on a directory-extending write and decremented
1446  AEB2              ;   by the WRITE deblock loop. [RE]
1447  AEB2              ; ----------------------------------------------------------------------
1448  AEB2              DISK_WRTYPE:
1449  AEB2 32 03 00             LD ($0003),A
1450  AEB5              ; ----------------------------------------------------------------------
1451  AEB5              ; DISK_UNADSK -- unallocated-run disk (DRI 'unadsk' [RE]); +1/+2 = unatrk/unasec.
1452  AEB5              ;   Boot tenant: install template 'LD HL,(nn)'. Operational tenant: the unallocated
1453  AEB5              ;   write run's position. DISK_UNADSK+1 (unatrk) and +2 (unasec) are seeded from the
1454  AEB5              ;   CP/M-requested track/sector (BOOT/BOOT+1) and advanced as the run is written. [RE]
1455  AEB5              ; ----------------------------------------------------------------------
1456  AEB5              DISK_UNADSK:
1457  AEB5 2A DE F3             LD HL,($F3DE)
1458  AEB8              ; ----------------------------------------------------------------------
1459  AEB8              ; DISK_DMAADR -- current DMA buffer address (DRI deblock 'dmaadr').
1460  AEB8              ;   Boot tenant: install template 'LD (nn),HL' (patches a console/IO operand at boot).
1461  AEB8              ;   Operational tenant: SETDMA stores BC here; the deblock record copy uses it as the
1462  AEB8              ;   CP/M 128-byte record source/destination.
1463  AEB8              ; ----------------------------------------------------------------------
1464  AEB8              DISK_DMAADR:
1465  AEB8 22 3F AB             LD (RPC_TRIGGER_STORE+1),HL
1466  AEBB AF                   XOR A
1467  AEBC 32 04 00             LD ($0004),A
1468  AEBF 3A BB F3             LD A,($F3BB)
1469  AEC2 FE 05                CP $05
1470  AEC4 30 1F                JR NC,DEV_INSTALL_2
1471  AEC6 D6 03                SUB $03
1472  AEC8 38 1B                JR C,DEV_INSTALL_2
1473  AECA 20 06                JR NZ,DEV_INSTALL_1
1474  AECC                      ; this console card class: repoint the CONST handler's read to $1FB0 (rewrites the
1475  AECC                      ; LD A,($E000) operand + the following byte) so status comes from the card, not $C000
1476  AECC 21 B0 1F             LD HL,$1FB0
1477  AECF 22 0E AB             LD (KBD_STATUS_40COL+2),HL
1478  AED2              DEV_INSTALL_1:
1479  AED2 F5                   PUSH AF
1480  AED3 CD 59 AF             CALL DEV_HANDLER_LOOKUP
1481  AED6 F1                   POP AF
1482  AED7 22 42 AC             LD (PUT_CHAR_VECTOR+1),HL
1483  AEDA CD 54 AF             CALL DEV_HANDLER_LOOKUP_B
1484  AEDD 22 2D AB             LD (CONIN_DISPATCH+1),HL         ; patch the CONIN keyboard-wait vector
1485  AEE0 3E 03                LD A,$03
1486  AEE2 32 FD AA             LD (CCP_MODE_FLAG+1),A
1487  AEE5              DEV_INSTALL_2:
1488  AEE5 3A B9 F3             LD A,($F3B9)
1489  AEE8 D6 03                SUB $03
1490  AEEA 38 08                JR C,DEV_INSTALL_3
1491  AEEC CD 59 AF             CALL DEV_HANDLER_LOOKUP
1492  AEEF 22 2F AD             LD (DEV_OUT_1_JP+1),HL           ; patch the DEV_OUT_1 vector
1493  AEF2 1E 80                LD E,$80
1494  AEF4              DEV_INSTALL_3:
1495  AEF4 3A BA F3             LD A,($F3BA)
1496  AEF7 D6 03                SUB $03
1497  AEF9 38 14                JR C,DEV_INSTALL_4
1498  AEFB F5                   PUSH AF
1499  AEFC CD 59 AF             CALL DEV_HANDLER_LOOKUP
1500  AEFF 22 43 AD             LD (DEV_OUT_2_JP+1),HL           ; patch the DEV_OUT_2 vector
1501  AF02 F1                   POP AF
1502  AF03 FE 02                CP $02
1503  AF05 30 08                JR NC,DEV_INSTALL_4
1504  AF07 CD 54 AF             CALL DEV_HANDLER_LOOKUP_B
1505  AF0A 22 49 AD             LD (DEV_OUT_3_JP+1),HL           ; patch the DEV_OUT_3 jump target
1506  AF0D 18 0B                JR DEV_INSTALL_5
1507  AF0F              DEV_INSTALL_4:
1508  AF0F 21 3E 1A             LD HL,$1A3E
1509  AF12 22 48 AD             LD (DEV_OUT_3_JP),HL             ; build DEV_OUT_3's instruction (opcode+lo)
1510  AF15 3E C9                LD A,$C9
1511  AF17 32 4A AD             LD (DEV_OUT_3_JP+2),A            ; build DEV_OUT_3's instruction (hi byte)
1512  AF1A              DEV_INSTALL_5:
1513  AF1A 3A 81 F3             LD A,($F381)
1514  AF1D B7                   OR A
1515  AF1E 20 0B                JR NZ,DEV_INSTALL_6
1516  AF20 21 AE AF             LD HL,IO_VECTOR_DEFAULTS
1517  AF23 11 80 F3             LD DE,$F380
1518  AF26 01 16 00             LD BC,$0016
1519  AF29 ED B0                LDIR
1520  AF2B              DEV_INSTALL_6:
1521  AF2B CD A2 AA             CALL PROBE_DEVICES
1522  AF2E 3A 98 F3             LD A,($F398)
1523  AF31 CD 64 AF             CALL SIGNON_EMIT
1524  AF34 3A 9B F3             LD A,($F39B)
1525  AF37                  IFDEF V220B
1526  AF37 ~                    LD A,(SIGNON_EMIT)               ; 2.20B: skip emitting the 2nd config byte (A is reloaded then discarded by the banner loop)
1527  AF37                  ELSE
1528  AF37 CD 64 AF             CALL SIGNON_EMIT
1529  AF3A                  ENDIF
1530  AF3A 21 73 AF             LD HL,SIGNON_BANNER
1531  AF3D              DEV_INSTALL_7:
1532  AF3D 7E                   LD A,(HL)
1533  AF3E B7                   OR A
1534  AF3F CA DB AA             JP Z,PAGEZERO_REBUILD
1535  AF42 E5                   PUSH HL
1536  AF43 CD 42 AB             CALL CONOUT_DISPATCH
1537  AF46 E1                   POP HL
1538  AF47 23                   INC HL
1539  AF48 18 F3                JR DEV_INSTALL_7
1540  AF4A              ; ----------------------------------------------------------------------
1541  AF4A              ; DEV_HANDLER_PTRS -- DEFW table of disk read/write handler addresses (primary group),
1542  AF4A              ;   indexed by DEV_HANDLER_LOOKUP. Continues as DEV_HANDLER_PTRS_B (+6). DATA.
1543  AF4A              ;   Each entry should relocate from a literal address to the named target:
1544  AF4A              ;     [0] $ACDF -> DISK_RD_HANDLER_A  (CALL SLOT_IO_ADDR sector-bit read handler in the
1545  AF4A              ;         CTRL_HANDLER_OFFSET_TBL data/code region)
1546  AF4A              ;     [1] $AD04 -> PLOT_CHAR_AT_COL        (named handler just below)
1547  AF4A              ;     [2] $AD31 -> DISK_WR_HANDLER_B (handler tail in the $AD22 data/code region)
1548  AF4A              ;   and DEV_HANDLER_PTRS_B holds:
1549  AF4A              ;     [0] $AD12 -> DISK_RD_HANDLER_B (RRA bit-test read handler at the $AD12 block)
1550  AF4A              ;     [1] $AD1C -> DISK_WR_HANDLER_A (CALL SET_SCREEN_BASE write handler in the $AD22 block)
1551  AF4A              ;   See flags: these targets currently sit inside DEFB blocks (CTRL_HANDLER_OFFSET_TBL / $AD12 /
1552  AF4A              ;   $AD22)
1553  AF4A              ;   that are really handler CODE, so the relocations need those blocks named first.
1554  AF4A              ; ----------------------------------------------------------------------
1555  AF4A              DEV_HANDLER_PTRS:
1556  AF4A                      ; table of device-handler addresses (DEFW). DEV_HANDLER_LOOKUP indexes from
1557  AF4A                      ; here; DEV_HANDLER_LOOKUP_B indexes from DEV_HANDLER_PTRS_B (+6). Selected per config
1558  AF4A                      ; by DISK_WRITE_HOST to install the right console/disk handler into the vector slots.
1559  AF4A DF AC                DEFW    DEV_STROBE_RD            ; [0]
1560  AF4C 04 AD                DEFW    PLOT_CHAR_AT_COL         ; [1]
1561  AF4E 31 AD                DEFW    DEV_WR_BIT               ; [2]
1562  AF50              DEV_HANDLER_PTRS_B:
1563  AF50 12 AD                DEFW    DEV_READ_BIT             ; DEV_HANDLER_LOOKUP_B base
1564  AF52 1C AD                DEFW    DEV_OUT_RPC
1565  AF54              ; ----------------------------------------------------------------------
1566  AF54              ; DEV_HANDLER_LOOKUP_B -- fetch a disk-handler address from DEV_HANDLER_PTRS_B[A].
1567  AF54              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1568  AF54              ;   Algorithm: point HL at DEV_HANDLER_PTRS_B then fall into the shared index loader
1569  AF54              ;   (HL += A*2; HL = word at that slot). Used by DISK_WRITE_HOST to install the per-config
1570  AF54              ;   read/write handler addresses. [RE]
1571  AF54              ; ----------------------------------------------------------------------
1572  AF54              DEV_HANDLER_LOOKUP_B:
1573  AF54                      ; select the secondary handler-pointer table
1574  AF54 21 50 AF             LD HL,DEV_HANDLER_PTRS_B
1575  AF57 18 03                JR DISK_RTN_LOOKUP_IDX
1576  AF59              ; ----------------------------------------------------------------------
1577  AF59              ; DEV_HANDLER_LOOKUP -- fetch a disk-handler address from DEV_HANDLER_PTRS[A].
1578  AF59              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1579  AF59              ;   Algorithm: HL = base; HL += A*2 (ADD A,A; ADD A,L; LD L,A); HL = the 16-bit word
1580  AF59              ;   at that slot (low then high). Shared tail of DEV_HANDLER_LOOKUP_B. [RE]
1581  AF59              ; ----------------------------------------------------------------------
1582  AF59              DEV_HANDLER_LOOKUP:
1583  AF59                      ; select the primary handler-pointer table
1584  AF59 21 4A AF             LD HL,DEV_HANDLER_PTRS
1585  AF5C              DISK_RTN_LOOKUP_IDX:
1586  AF5C                      ; index*2 for 16-bit (word) table entries
1587  AF5C 87                   ADD A,A
1588  AF5D 85                   ADD A,L
1589  AF5E 6F                   LD L,A
1590  AF5F                      ; load handler address low byte
1591  AF5F 7E                   LD A,(HL)
1592  AF60 2C                   INC L
1593  AF61                      ; load handler address high byte -> HL = handler entry
1594  AF61 66                   LD H,(HL)
1595  AF62 6F                   LD L,A
1596  AF63 C9                   RET
1597  AF64              ; ----------------------------------------------------------------------
1598  AF64              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1599  AF64              ;   In:  A = byte/flag. Out: none (prints via CONOUT_DISPATCH=CONOUT-class writer).
1600  AF64              ;   Algorithm: if A is positive (bit7 clear) just print it; if negative, first print
1601  AF64              ;   the prefix char from the config block (Apple $0397) then print A. Called twice from
1602  AF64              ;   the boot path to emit two config-derived sign-on chars before the banner. [RE]
1603  AF64              ; ----------------------------------------------------------------------
1604  AF64              SIGNON_EMIT:
1605  AF64 B7                   OR A
1606  AF65                      ; bit7 clear -> emit the char directly
1607  AF65 F2 70 AF             JP P,SIGNON_EMIT_CHAR
1608  AF68 F5                   PUSH AF
1609  AF69                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1610  AF69 3A 97 F3             LD A,($F397)
1611  AF6C                      ; emit the prefix char
1612  AF6C CD 42 AB             CALL CONOUT_DISPATCH
1613  AF6F F1                   POP AF
1614  AF70              SIGNON_EMIT_CHAR:
1615  AF70                      ; tail-call to emit the original char
1616  AF70 C3 42 AB             JP CONOUT_DISPATCH
1617  AF73              ; ----------------------------------------------------------------------
1618  AF73              ; SIGNON_BANNER -- the cold-boot sign-on string, printed char-by-char by the boot path
1619  AF73              ;   (loop at DEV_INSTALL_7) until the $00 terminator. Reads:
1620  AF73              ;   'Apple ][ CP/M' / '44K Ver. 2.20' / '(C) 1980 Microsoft', CR/LF separated. DATA.
1621  AF73              ; ----------------------------------------------------------------------
1622  AF73              SIGNON_BANNER:
1623  AF73 0D 0A 0D 0A          DEFB    "\r\n\r\n\r\n"
1623  AF77 0D 0A
1624  AF79 41 70 70 6C          DEFB    "Apple ][ CP/M"          ; string
1624  AF7D 65 20 5D 5B
1624  AF81 20 43 50 2F
1624  AF85 4D
1625  AF86 0D                   DEFB    $0D                      ; terminator
1626  AF87 0A                   DEFB    "\n"
1627  AF88                      ; memory token (CFG_56K) + version token (V220B); the +1 'B' is offset by
1628  AF88                      ; dropping a CR in the tail below so the banner stays 59 bytes either way.
1629  AF88                  IFDEF CFG_56K
1630  AF88 ~                    DEFB    "56K"
1631  AF88                  ELSE
1632  AF88 34 34 4B             DEFB    "44K"
1633  AF8B                  ENDIF
1634  AF8B 20 56 65 72          DEFB    " Ver. 2.20"
1634  AF8F 2E 20 32 2E
1634  AF93 32 30
1635  AF95                  IFDEF V220B
1636  AF95 ~                    DEFB    "B"                      ; 2.20B sub-revision
1637  AF95                  ENDIF
1638  AF95 0D                   DEFB    $0D                      ; terminator
1639  AF96 0A                   DEFB    "\n"
1640  AF97 28 43 29 20          DEFB    "(C) 1980 Microsoft"     ; string
1640  AF9B 31 39 38 30
1640  AF9F 20 4D 69 63
1640  AFA3 72 6F 73 6F
1640  AFA7 66 74
1641  AFA9 0D                   DEFB    $0D                      ; terminator
1642  AFAA                  IFDEF V220B
1643  AFAA ~                    DEFB    "\n\n\0"                  ; 2.20B: one fewer CR (offsets the 'B')
1644  AFAA                  ELSE
1645  AFAA 0A 0D 0A 00          DEFB    "\n\r\n\0"
1646  AFAE                  ENDIF
1647  AFAE              ; ----------------------------------------------------------------------
1648  AFAE              ; IO_VECTOR_DEFAULTS -- 22-byte (BC=$0016) DATA table of default I/O handler pointers,
1649  AFAE              ;   copied by the boot path (LDIR) into the SoftCard config/vector page at $F380=Apple
1650  AFAE              ;   $0380 when that page is uninitialized ($F381==0). The first 22 bytes are eleven
1651  AFAE              ;   little-endian addresses ($AB0C,$AB12,$AB12,$AC3E,$AC3E,$AD45,$AD45,$AD3F,$AD3F,
1652  AFAE              ;   $AD2B,$AD2B) mirroring console/list/punch/reader/disk handler entry points; only
1653  AFAE              ;   those 22 bytes are copied. This is a DATA pointer table, not relocated code. The
1654  AFAE              ;   bytes past offset 22 ($AFC4 onward) coincidentally re-mirror nearby handler code
1655  AFAE              ;   but are NOT executed from here. [RE] -- see flags.
1656  AFAE              ; ----------------------------------------------------------------------
1657  AFAE              IO_VECTOR_DEFAULTS:
1658  AFAE                  IFDEF V220B
1659  AFAE ~                    ; 2.20B: the CCP_INLEN warm-boot stub overlays the first four (CONST/CONIN/CONOUT)
1660  AFAE ~                    ; vector-default slots. Safe because the LDIR that copies these into the config page
1661  AFAE ~                    ; runs only on an uninitialized page ($F381==0), which the Language-Card loader pre-sets.
1662  AFAE ~                    CALL RPC_TRIGGER
1663  AFAE ~                    XOR A
1664  AFAE ~                    LD (CCP_INLEN),A
1665  AFAE ~                    RET
1666  AFAE                  ELSE
1667  AFAE 0C AB                DEFW    KBD_STATUS_40COL         ; CONST (40-col keyboard status)
1668  AFB0 12 AB                DEFW    CONSOLE_IN_40COL         ; CONIN
1669  AFB2 12 AB                DEFW    CONSOLE_IN_40COL
1670  AFB4 3E AC                DEFW    PUT_CHAR_DE3             ; CONOUT
1671  AFB6                  ENDIF
1672  AFB6 3E AC                DEFW    PUT_CHAR_DE3
1673  AFB8 45 AD                DEFW    DEV_OUT_3                ; LIST/PUNCH/READER stubs
1674  AFBA 45 AD                DEFW    DEV_OUT_3
1675  AFBC 3F AD                DEFW    DEV_OUT_2
1676  AFBE 3F AD                DEFW    DEV_OUT_2
1677  AFC0 2B AD                DEFW    DEV_OUT_1
1678  AFC2 2B AD                DEFW    DEV_OUT_1
1679  AFC4                      ; A dead in-image mirror of the DEV_HANDLER_PTRS table + DEV_HANDLER_LOOKUP /
1680  AFC4                      ; SIGNON_EMIT code (byte-identical to $xF44-$xF67); not referenced or executed. Its
1681  AFC4                      ; embedded in-image address high-bytes relocate with the OS (+$3000 under CFG_56K).
1682  AFC4 42 AB E1 23          DEFB    $42,$AB+(OS_RELOC>>8),$E1,$23,$18,$F3,$DF,$AC+(OS_RELOC>>8),$04,$AD+(OS_RELOC>>8),$31,$AD+(OS_RELOC>>8),$12,$AD+(OS_RELOC>>8),$1C,$AD+(OS_RELOC>>8)
1682  AFC8 18 F3 DF AC
1682  AFCC 04 AD 31 AD
1682  AFD0 12 AD 1C AD
1683  AFD4 21 50 AF 18          DEFB    $21,$50,$AF+(OS_RELOC>>8),$18,$03,$21,$4A,$AF+(OS_RELOC>>8),$87,$85,$6F,$7E,$2C,$66,$6F,$C9
1683  AFD8 03 21 4A AF
1683  AFDC 87 85 6F 7E
1683  AFE0 2C 66 6F C9
1684  AFE4 B7 F2 70 AF          DEFB    $B7,$F2,$70,$AF+(OS_RELOC>>8)
1685  AFE8                  IFDEF V220B
1686  AFE8 ~            WARMBOOT_INLEN_STUB:                     ; 2.20B: warm-boot RPC + clear the CCP staged-command flag
1687  AFE8 ~                    CALL RPC_TRIGGER
1688  AFE8 ~                    XOR A
1689  AFE8 ~                    LD (CCP_INLEN),A
1690  AFE8 ~                    RET
1691  AFE8                  ELSE
1692  AFE8 F5 3A 97 F3          DEFB    $F5,$3A,$97,$F3,$CD,$42,$AB,$F1   ; mirror tail (dead)
1692  AFEC CD 42 AB F1
1693  AFF0                  ENDIF
1694  AFF0              ; ----------------------------------------------------------------------
1695  AFF0              ; READ_SEKSEC -- load the current deblock sector and set flags.
1696  AFF0              ;   In:  none. Out: A = current sector (from BOOT+1=seksec); Z set if sector==0.
1697  AFF0              ;   Clobbers: A. Called by the READ/WRITE deblock path to test/translate the sector.
1698  AFF0              ;   Note BOOT+1 is the post-boot reuse of the BOOT 'LD SP,$0100' operand byte. [RE]
1699  AFF0              ; ----------------------------------------------------------------------
1700  AFF0              READ_SEKSEC:
1701  AFF0                      ; read the current deblock sector (BOOT+1 reused as seksec)
1702  AFF0 3A A9 AE             LD A,(BOOT+1)
1703  AFF3                      ; set Z/sign flags on the sector value for the caller
1704  AFF3 B7                   OR A
1705  AFF4 C9                   RET
1706  AFF5                  IFDEF V220B
1707  AFF5 ~                    ; 2.20B overlays the leading "\r\n\r\nAppl" of this dead fragment with a 3rd stub copy
1708  AFF5 ~                    CALL RPC_TRIGGER
1709  AFF5 ~                    XOR A
1710  AFF5 ~                    LD (CCP_INLEN),A
1711  AFF5 ~                    RET
1712  AFF5 ~                    DEFB    "e ]"
1713  AFF5                  ELSE
1714  AFF5 0D 0A 0D 0A          DEFB    "\r\n\r\nApple ]"
1714  AFF9 41 70 70 6C
1714  AFFD 65 20 5D
1715  B000                  ENDIF
1716  B000              BIOS_IMAGE_END:                          ; first byte past the BIOS image
1717  B000
1718  B000                  IFNDEF CPM_LINK
1719  B000                  ; image size from its bracketing labels (no magic length); $AA00 = the ORG base
1720  B000                  SAVEBIN "{out_bin}", BIOS_FBASE, BIOS_IMAGE_END - BIOS_FBASE
1721  B000                  ENDIF
1722  B000
1723  B000              ; ----------------------------------------------------------------------
1724  B000              ; BDOS scratch overlay -- the SECOND tenant of $AEBA-$AFE1 (CFG_56K: +$3000).
1725  B000              ;   Those bytes are the one-shot cold-boot / sign-on code above. It runs once at cold
1726  B000              ;   start; only afterwards does the disk system reuse them as the buffers DPH_TABLE
1727  B000              ;   hands out. The two tenants are never live at the same time, which is why a
1728  B000              ;   post-boot RAM dump shows those pages clobbered.
1729  B000              ;
1730  B000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1731  B000              ;   at the overlay base, then one label per field with its extent carried in the
1732  B000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1733  B000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1734  B000              ;   the image, and the ORG leaves the emitted output untouched. Being BIOS_FBASE
1735  B000              ;   relative, it also relocates with CFG_56K.
1736  B000              ;
1737  B000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1738  B000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1739  B000              ;   cold boot has finished. The sizes are the DPB's own values, so they cannot drift
1740  B000              ;   from the DPB this BIOS publishes. [RE]
1741  B000              ; ----------------------------------------------------------------------
1742  B000              DRIVES       EQU 6                    ; six DPH entries in DPH_TABLE
1743  B000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1744  B000              ALV_SIZE     EQU 127 / 8 + 1          ; = 16; 127 is DSM, the highest allocation block number
1745  B000              CSV_SIZE     EQU 12                   ; = CKS
1746  B000
1747  B000                      ORG BIOS_FBASE + $04BA        ; the one given: where the author placed the overlay
1748  AEBA              DIRBUF:                               ; shared directory buffer, one per system ($AEBA)
1749  AEBA                      ORG DIRBUF + DIRBUF_SIZE
1750  AF3A              ALV_VECTORS:                          ; per-drive allocation vectors ($AF3A..)
1751  AF3A                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1752  AF9A              CSV_VECTORS:                          ; per-drive checksum vectors ($AF9A..)
1753  AF9A                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1754  AFE2              BIOS_SCRATCH_END:                     ; first byte past the overlay ($AFE2)
1755  AFE2
1756  AFE2                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1757  AFE2                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1758  AFE2                  ASSERT ALV_VECTORS == BIOS_FBASE + $053A
1759  AFE2                  ASSERT CSV_VECTORS == BIOS_FBASE + $059A
1760  AFE2                  ASSERT BIOS_SCRATCH_END <= BIOS_IMAGE_END
1761  AFE2
# file closed: CPM_BIOS.asm

# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.20 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 44K BIOS runs at z80 $AA00-$AFFF (6 pages). The prior CPM_BIOS.asm decoded
   5  0000              ; it in on-disk (sector-interleaved) order and was both mis-addressed (28.9%
   6  0000              ; source-vs-runtime match) AND missing the 6th page; this source is decoded
   7  0000              ; against the DE-SKEWED runtime image -- every label a true runtime address. The
   8  0000              ; disk producer re-applies the sector skew (cpm_pipeline/deskew.py ::
   9  0000              ; BIOS_PAGE_TO_SECTOR). $AA00 = the 15-entry BIOS jump vector (BOOT, WBOOT,
  10  0000              ; CONST, CONIN, CONOUT, LIST, PUNCH, READER, HOME, SELDSK, SETTRK, SETSEC,
  11  0000              ; SETDMA, READ, WRITE). See ../../docs/CPM_Skew_Findings.md.
  12  0000              ;
  13  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
  14  0000              ; being enriched to the C-level bar.
  15  0000              ; ============================================================================
  16  0000
  17  0000                  INCLUDE "cpm_system_220.inc"   ; CCP/BDOS cross-module bases (CFG_56K re-homes them +$3000)
# file opened: cpm_system_220.inc
   1+ 0000              ; ============================================================================
   2+ 0000              ; cpm_system_220.inc -- CP/M 2.20 (44K) cross-module system contract
   3+ 0000              ; ----------------------------------------------------------------------------
   4+ 0000              ; The de-skewed 2.20-44K system image is TWO independent compilations -- the CCP
   5+ 0000              ; ($9400-$9BFF) and the BDOS ($9C00-$A9FF) -- decoded at their true RUNTIME
   6+ 0000              ; addresses (see ../docs/CPM_Skew_Findings.md). On the correctly-addressed source
   7+ 0000              ; the two are almost decoupled: the CCP calls the BDOS only through the page-zero
   8+ 0000              ; $0005 ABI (cpm22.inc :: BDOS), and the ONLY direct cross-module symbols are the
   9+ 0000              ; two module bases below. They are defined ONCE here and INCLUDEd by both modules
  10+ 0000              ; (never duplicated -- feedback_no_duplicate_symbol_definitions). The earlier
  11+ 0000              ; "59 CCP->BDOS cross-refs" were sector-skew artifacts and do not exist on the
  12+ 0000              ; de-skewed source.
  13+ 0000              ; ============================================================================
  14+ 0000
  15+ 0000              ; Memory-config axis: the 56K (Language Card) system is the 44K image lifted +$3000
  16+ 0000              ; (CCP $9400->$C400, BDOS $9C00->$CC00, BIOS $AA00->$DA00 = Apple LC $D400/$DC00/$EA00).
  17+ 0000              ; Because every address below is derived from this single offset, defining CFG_56K
  18+ 0000              ; (the build's -D flag) re-homes the whole 2.20 OS by re-assembly alone -- no per-cell
  19+ 0000              ; edits. See ../docs/CPM_56K_60K_Fold_Plan.md.
  20+ 0000                  IFDEF CFG_56K
  21+ 0000 ~            OS_RELOC   EQU $3000      ; 56K: OS relocated into the Apple Language Card
  22+ 0000                  ELSE
  23+ 0000              OS_RELOC   EQU $0000      ; 44K: OS in main RAM (the base build)
  24+ 0000                  ENDIF
  25+ 0000
  26+ 0000              CCP_ENTRY  EQU $9400 + OS_RELOC  ; CBASE: CCP cold entry (JP cold-start); BDOS fn 0 / warm boot returns here
  27+ 0000              BDOS_FBASE EQU $9C00 + OS_RELOC  ; FBASE: BDOS image base (6-byte serial + JP +6 entry); top-of-TPA marker the CCP loads
  28+ 0000              BIOS_FBASE EQU $AA00 + OS_RELOC  ; WBOOT/BIOS base = the first byte PAST the BDOS image (CPM_BDOS asserts $ == this)
  29+ 0000
  30+ 0000              ; Region sizes are computed from the contiguous module boundaries above -- never a magic
  31+ 0000              ; number -- so they track the image layout (and the byte gate catches any overrun via the
  32+ 0000              ; CPM_BDOS end-of-image ASSERT). CCP -> BDOS -> BIOS are back-to-back.
  33+ 0000              CCP_SIZE   EQU BDOS_FBASE - CCP_ENTRY     ; $0800: CCP image size  = (first BDOS byte) - (first CCP byte)
  34+ 0000              BDOS_SIZE  EQU BIOS_FBASE - BDOS_FBASE    ; $0E00: BDOS image size = (byte after BDOS) - (first BDOS byte)
  35+ 0000
  36+ 0000              ; --- CCP cells referenced cross-module (single source of truth, by label arithmetic) ---
  37+ 0000              ; CCP_INLEN ($9407 = CCP_ENTRY+7): the CCP console-line returned-count byte (CCP_INBUF+1).
  38+ 0000              ; It doubles as the staged / auto-command flag -- nonzero on CCP entry means a command line
  39+ 0000              ; is already staged in CCP_CMDTEXT and is re-parsed instead of re-prompting (the SUBMIT/$SUB
  40+ 0000              ; chaining hook). The CCP warm-start clears it; the 2.20B BIOS warm-boot path ALSO clears it
  41+ 0000              ; (XOR A; LD (CCP_INLEN),A) so a BIOS-driven warm boot discards any stale staged command and
  42+ 0000              ; the CCP re-prompts cleanly. (The base 2.20 BIOS does not reference it; this is the lone
  43+ 0000              ; genuine BIOS->CCP cell, introduced by 2.20B.)
  44+ 0000              CCP_INLEN  EQU CCP_ENTRY + 7
  45+ 0000
# file closed: cpm_system_220.inc
  18  0000
  19  0000                  IFNDEF CPM_LINK
  20  0000                  DEVICE NOSLOT64K
  21  0000                  ORG BIOS_FBASE                 ; $AA00 (44K) or $DA00 (CFG_56K); the byte past the BDOS image
  22  AA00                  ENDIF
  23  AA00
  24  AA00              ; -- Self-modify / dual-use cells (operand bytes referenced as LABEL+offset, per the
  25  AA00              ;    SoftCard convention: the patched instruction keeps a semantic label; the patch site
  26  AA00              ;    is +1/+2). The cold-boot installer (BOOT..DEV_INSTALL_*) and the deblock share much
  27  AA00              ;    of the $AEA8-$AEBA band: --
  28  AA00              ;      CCP_MODE_FLAG+1       patched immediate of the CCP-launch flag
  29  AA00              ;      KBD_STATUS_40COL+2    CONST read-address, repointed per console card
  30  AA00              ;      RPC_TRIGGER_STORE+1   RPC trigger store-address (set from the SoftCard config)
  31  AA00              ;      PUT_CHAR_VECTOR+1     self-modified screen-emit jump target
  32  AA00              ;      DEV_OUT_1_JP+1 / DEV_OUT_2_JP+1 / DEV_OUT_3_JP(+1/+2)  device-handler vectors
  33  AA00              ;      CONIN_DISPATCH+1      keyboard-wait vector
  34  AA00              ;      DISK_SEKDSK(+1/+2), DISK_HSTWRT(+1), DISK_WRTYPE(+1/+2), DISK_UNADSK(+1/+2),
  35  AA00              ;      DISK_DMAADR, BOOT, BOOT+1   the DRI deblock scratch (sekdsk/hstdsk/hstact/hstwrt/
  36  AA00              ;                                  readop/wrtype/rsflag/unacnt/unatrk/unasec/dmaadr/
  37  AA00              ;                                  sektrk/seksec), overlaid on the install templates.
  38  AA00
  39  AA00              ; ----------------------------------------------------------------------
  40  AA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector.
  41  AA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  42  AA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  43  AA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  44  AA00              ;   In:  entered by JP/CALL to base+3*n. Out: per the dispatched entry.
  45  AA00              ;   Note: the CONOUT and SETTRK targets ($AB43, $AD56) are the second-instruction
  46  AA00              ;         entry points of CONOUT_DISPATCH and HOME's tail, decoded as raw addresses
  47  AA00              ;         here; see flags.
  48  AA00              ; ----------------------------------------------------------------------
  49  AA00              BIOS_VECTOR:
  50  AA00                      ; entry 0 = cold boot (first run after the loader)
  51  AA00 C3 A8 AE             JP BOOT
  52  AA03              BIOS_VECTOR_WBOOT:
  53  AA03                      ; jump table
  54  AA03                      ; entry 1 = warm boot: reload CCP, rebuild page zero
  55  AA03 C3 CC AA             JP      WBOOT
  56  AA06 C3 08 AB             JP      CONST
  57  AA09                  IFDEF V220B
  58  AA09 ~                    JP      CONSOLE_IN_40COL        ; 2.20B: CONIN enters the 40-col handler, which calls the IOBYTE dispatcher then remaps fn/arrow keys
  59  AA09                  ELSE
  60  AA09 C3 50 AB             JP      CONIN
  61  AA0C                  ENDIF
  62  AA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  63  AA0C C3 43 AB             JP      CONOUT_DISPATCH+1
  64  AA0F C3 66 AB             JP      LIST
  65  AA12 C3 75 AB             JP      PUNCH
  66  AA15 C3 87 AB             JP      READER
  67  AA18 C3 4B AD             JP      HOME
  68  AA1B C3 6D AD             JP      SELDSK
  69  AA1E                      ; entry 10 = SETTRK; the LD A,C tail shared with HOME
  70  AA1E C3 56 AD             JP      SETTRK
  71  AA21 C3 89 AD             JP      SETSEC
  72  AA24 C3 8E AD             JP      SETDMA
  73  AA27 C3 93 AD             JP      READ
  74  AA2A C3 A3 AD             JP      WRITE
  75  AA2D AF C9 00 60          DEFB    $AF,$C9,$00,$60,$69,$C9
  75  AA31 69 C9
  76  AA33              ; ----------------------------------------------------------------------
  77  AA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
  78  AA33              ;   drive 0..5). SELDSK returns DPH_TABLE + 16*drive (or 0 for an out-of-range drive).
  79  AA33              ;   Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV, ALV. XLT = 0 (no SECTRAN
  80  AA33              ;   sector translate; the deblock applies the skew internally via SECTOR_XLATE). All six
  81  AA33              ;   drives share one DIRBUF and one DPB. DIRBUF ($AEBA, 128 bytes) and the per-drive CSV
  82  AA33              ;   (checksum, 12 bytes) and ALV (allocation, ~17 bytes) vectors live in the BIOS's own
  83  AA33              ;   $AE/$AF RAM, reused as scratch after the cold-boot code there has run; they are kept
  84  AA33              ;   as literal addresses (not relocatable labels) for that reason. [RE]
  85  AA33              ; ----------------------------------------------------------------------
  86  AA33              ; The DIRBUF/CSV/ALV vectors OVERLAY the cold-boot/sign-on code in pages $AE-$AF: that
  87  AA33              ; code runs once, then the disk system reuses the bytes as scratch buffers (which is why a
  88  AA33              ; post-boot RAM dump shows those pages clobbered). They are in-image addresses, so define
  89  AA33              ; them by arithmetic from BIOS_FBASE -- they relocate with CFG_56K (a raw literal would not,
  90  AA33              ; silently breaking the 56K build's DPH pointers).
  91  AA33              DIRBUF       EQU BIOS_FBASE + $04BA   ; shared 128-byte directory buffer ($AEBA)
  92  AA33              CSV_VECTORS  EQU BIOS_FBASE + $059A   ; per-drive checksum vectors, 12 bytes apart ($AF9A..)
  93  AA33              ALV_VECTORS  EQU BIOS_FBASE + $053A   ; per-drive allocation vectors, 16 bytes apart ($AF3A..)
  94  AA33              DPH_TABLE:
  95  AA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
  95  AA37 00 00 00 00
  95  AA3B BA AE 93 AA
  95  AA3F 9A AF 3A AF
  96  AA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+16   ; drive 1
  96  AA47 00 00 00 00
  96  AA4B BA AE 93 AA
  96  AA4F A6 AF 4A AF
  97  AA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+32   ; drive 2
  97  AA57 00 00 00 00
  97  AA5B BA AE 93 AA
  97  AA5F B2 AF 5A AF
  98  AA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+48   ; drive 3
  98  AA67 00 00 00 00
  98  AA6B BA AE 93 AA
  98  AA6F BE AF 6A AF
  99  AA73 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+48,ALV_VECTORS+64   ; drive 4
  99  AA77 00 00 00 00
  99  AA7B BA AE 93 AA
  99  AA7F CA AF 7A AF
 100  AA83 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+60,ALV_VECTORS+80   ; drive 5
 100  AA87 00 00 00 00
 100  AA8B BA AE 93 AA
 100  AA8F D6 AF 8A AF
 101  AA93              ; ----------------------------------------------------------------------
 102  AA93              ; DPB -- the shared Disk Parameter Block (5.25" floppy geometry; every DPH points here).
 103  AA93              ;   One label per field, so the field names are symbols rather than prose. The ten names
 104  AA93              ;   are Digital Research's CP/M 2.2 DPB field names. NOT [DOC]-citable from this archive:
 105  AA93              ;   the SoftCard manual set documents only the BDOS call that RETURNS a DPB pointer
 106  AA93              ;   (fn 31, Get Addr (disk parms)), not the block's layout.
 107  AA93              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 108  AA93              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track; DSM=127 -> 128 blocks =
 109  AA93              ;   128 KB of file area = 32 tracks, which with OFF=3 reserved tracks accounts for a
 110  AA93              ;   35-track disk exactly. [RE]
 111  AA93              ; ----------------------------------------------------------------------
 112  AA93              DPB:
 113  AA93 20 00        SPT:    DEFW    $0020                    ; records per track: 32 x 128-byte records
 114  AA95 03           BSH:    DEFB    $03                      ; block shift: log2(records per block) -> 8 records
 115  AA96 07           BLM:    DEFB    $07                      ; block mask: (records per block) - 1 -> 1 KB blocks
 116  AA97 00           EXM:    DEFB    $00                      ; extent mask
 117  AA98 7F 00        DSM:    DEFW    $007F                    ; highest allocation block number: 127 -> 128 blocks
 118  AA9A 2F 00        DRM:    DEFW    $002F                    ; highest directory entry number: 47 -> 48 entries
 119  AA9C C0           AL0:    DEFB    $C0                      ; directory-reserved blocks, bitmap, high byte -> 2
 120  AA9D 00           AL1:    DEFB    $00                      ; ditto, low byte
 121  AA9E 0C 00        CKS:    DEFW    $000C                    ; directory checksum bytes
 122  AAA0 03 00        OFF:    DEFW    $0003                    ; reserved tracks before the file area
 123  AAA2              ; ----------------------------------------------------------------------
 124  AAA2              ; PROBE_DEVICES -- scan the 7-entry SoftCard device/config area and mark presence.
 125  AAA2              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 126  AAA2              ;   Out: config bytes updated in place; calls per-device init when a device is found.
 127  AAA2              ;   Clobbers: A,DE,HL.
 128  AAA2              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E]; if it equals 3 the slot
 129  AAA2              ;              holds a recognized device, so call SLOT_IO_ADDR (build the slot I/O base)
 130  AAA2              ;              and store $03 then $15 into the config cell to flag it configured. A
 131  AAA2              ;              secondary DEC A test (value was 4) runs SET_SCREEN_BASE (console probe) and
 132  AAA2              ;              claims the $C800 shared expansion-ROM window via RPC_TRIGGER. [RE]
 133  AAA2              ; ----------------------------------------------------------------------
 134  AAA2              PROBE_DEVICES:
 135  AAA2                      ; DE = 7 entries to scan (index walks down to 1)
 136  AAA2 11 07 00             LD DE,$0007
 137  AAA5              PROBE_DEVICES_LOOP:
 138  AAA5                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 139  AAA5 21 B8 F3             LD HL,$F3B8
 140  AAA8 19                   ADD HL,DE
 141  AAA9 7E                   LD A,(HL)
 142  AAAA                      ; config value 3 = a recognized/present device in this slot
 143  AAAA D6 03                SUB $03
 144  AAAC 20 07                JR NZ,PROBE_DEVICES_CHK4
 145  AAAE CD 60 AD             CALL SLOT_IO_ADDR
 146  AAB1                      ; rewrite the cell: $03 then $15 = mark this device configured
 147  AAB1 36 03                LD (HL),$03
 148  AAB3 36 15                LD (HL),$15
 149  AAB5              PROBE_DEVICES_CHK4:
 150  AAB5                      ; after the SUB, A==1 here means the original value was 4 (e.g. Videx-class console)
 151  AAB5 3D                   DEC A
 152  AAB6 20 09                JR NZ,PROBE_DEVICES_NEXT
 153  AAB8 CD EE AC             CALL SET_SCREEN_BASE
 154  AABB                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 155  AABB 21 00 C8             LD HL,$C800
 156  AABE CD 3B AB             CALL RPC_TRIGGER
 157  AAC1              PROBE_DEVICES_NEXT:
 158  AAC1                      ; next config entry; loop until all 7 scanned
 159  AAC1 1D                   DEC E
 160  AAC2 20 E1                JR NZ,PROBE_DEVICES_LOOP
 161  AAC4 C9                   RET
 162  AAC5              ; ----------------------------------------------------------------------
 163  AAC5              ; SLOT_IO_ADDR -- form a SoftCard I/O / soft-switch address from a slot/offset index.
 164  AAC5              ;   In:  E = low offset within the I/O page.
 165  AAC5              ;   Out: HL = $E0(E | $E0), i.e. an address in z80 $E000-$EFFF = Apple I/O
 166  AAC5              ;        $C000-$CFFF; A clobbered.
 167  AAC5              ;   Algorithm: H = $E0 base; A = E OR H so the high nibble forces the $C0xx I/O
 168  AAC5              ;        page, then H = A. Used to reach keyboard / soft switches / slot I/O. [RE]
 169  AAC5              ; ----------------------------------------------------------------------
 170  AAC5              DEVICE_IO_BASE:
 171  AAC5                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 172  AAC5 21 00 E0             LD HL,$E000
 173  AAC8 7B                   LD A,E
 174  AAC9                      ; force the high byte into the $C0xx I/O range
 175  AAC9 B4                   OR H
 176  AACA 67                   LD H,A
 177  AACB C9                   RET
 178  AACC              ; ----------------------------------------------------------------------
 179  AACC              ; WBOOT -- CP/M warm boot: re-initialize the console, rebuild page zero, re-enter CCP.
 180  AACC              ;   In:  none. Out: jumps to the CCP at $9400; does not return.
 181  AACC              ;   Clobbers: all.
 182  AACC              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 183  AACC              ;        (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 184  AACC              ;        the device probe; then PAGEZERO_REBUILD writes the standard CP/M page-zero
 185  AACC              ;        jumps and DMA and enters the CCP. [RE]
 186  AACC              ; ----------------------------------------------------------------------
 187  AACC              WBOOT:
 188  AACC                      ; stack at the default DMA buffer top (page-zero $0080)
 189  AACC 31 80 00             LD SP,$0080
 190  AACF                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 191  AACF 3A 51 E0             LD A,($E051)
 192  AAD2 21 00 0E             LD HL,$0E00
 193  AAD5                      ; re-init the console I/O vectors for warm restart
 194  AAD5                  IFDEF V220B
 195  AAD5 ~                    CALL WARMBOOT_INLEN_STUB         ; 2.20B: fire the RPC, then clear CCP_INLEN so warm boot drops any staged command
 196  AAD5                  ELSE
 197  AAD5 CD 3B AB             CALL RPC_TRIGGER
 198  AAD8                  ENDIF
 199  AAD8                      ; re-scan devices so warm boot rebuilds the I/O table
 200  AAD8 CD A2 AA             CALL PROBE_DEVICES
 201  AADB              ; ----------------------------------------------------------------------
 202  AADB              ; PAGEZERO_REBUILD -- write the standard CP/M page-zero vectors and enter the CCP.
 203  AADB              ;   In:  none. Out: tail-calls into CCP_MODE_FLAG / JP $9400 (the CCP); no return.
 204  AADB              ;   Clobbers: A,HL,BC.
 205  AADB              ;   Algorithm: clear two self-modified BIOS state cells; write JP ($C3) at $0000
 206  AADB              ;        pointing at the BIOS vector+3 (warm-boot entry, BIOS_VECTOR_WBOOT) and JP at
 207  AADB              ;        $0005 pointing at the BDOS entry $9C06; set the default DMA to $0080 via
 208  AADB              ;        SETDMA; then fall into the CCP-launch tail. [RE]
 209  AADB              ; ----------------------------------------------------------------------
 210  AADB              PAGEZERO_REBUILD:
 211  AADB AF                   XOR A
 212  AADC                      ; clear a self-modified BIOS console-state cell
 213  AADC 32 B4 AE             LD (DISK_WRTYPE+2),A
 214  AADF 32 AF AE             LD (DISK_SEKDSK+2),A
 215  AAE2                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 216  AAE2 3E C3                LD A,$C3
 217  AAE4                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 218  AAE4 32 00 00             LD ($0000),A
 219  AAE7                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 220  AAE7 21 03 AA             LD HL,BIOS_VECTOR_WBOOT
 221  AAEA 22 01 00             LD ($0001),HL
 222  AAED                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 223  AAED 32 05 00             LD ($0005),A
 224  AAF0                      ; BDOS entry point (BDOS_FBASE+6) for the $0005 hook
 225  AAF0 21 06 9C             LD HL,BDOS_FBASE+6
 226  AAF3 22 06 00             LD ($0006),HL
 227  AAF6                      ; default DMA address = $0080 (page-zero buffer)
 228  AAF6 01 80 00             LD BC,$0080
 229  AAF9                      ; install the default DMA pointer
 230  AAF9 CD 8E AD             CALL SETDMA
 231  AAFC              ; ----------------------------------------------------------------------
 232  AAFC              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag and jump to the CCP.
 233  AAFC              ;   In:  none. Out: JP $9400 (CCP cold/warm entry); no return.
 234  AAFC              ;   Clobbers: A,C.
 235  AAFC              ;   Algorithm: store a CCP-mode flag ($01) into $98B2, then pass the current default
 236  AAFC              ;        drive (page-zero $0004) in C and jump to the CCP at $9400.
 237  AAFC              ;   Self-modify: CCP_MODE_FLAG's immediate ($01) is patched elsewhere to alter the
 238  AAFC              ;        launch path; references therefore read CCP_MODE_FLAG+1. [RE]
 239  AAFC              ; ----------------------------------------------------------------------
 240  AAFC              CCP_MODE_FLAG:
 241  AAFC                      ; CCP-mode flag value (this immediate is self-modified elsewhere)
 242  AAFC 3E 01                LD A,$01
 243  AAFE                      ; store the CCP entry/mode flag into CCP workspace at CCP_ENTRY+$04B2 ($98B2)
 244  AAFE 32 B2 98             LD (CCP_ENTRY+$04B2),A
 245  AB01                      ; page-zero $0004 = current default drive byte
 246  AB01 3A 04 00             LD A,($0004)
 247  AB04 4F                   LD C,A
 248  AB05                      ; enter the CCP at CCP_ENTRY ($9400), C = default drive
 249  AB05 C3 00 94             JP CCP_ENTRY
 250  AB08              ; ----------------------------------------------------------------------
 251  AB08              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 252  AB08              ;   In:  none. Out: A = $FF (ready) / $00 (not). Clobbers: A,HL.
 253  AB08              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 254  AB08              ;        cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler,
 255  AB08              ;        which returns the status in A. [RE]
 256  AB08              ; ----------------------------------------------------------------------
 257  AB08              CONST:
 258  AB08                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 259  AB08 2A 80 F3             LD HL,($F380)
 260  AB0B                      ; dispatch to the selected console-status handler (returns A)
 261  AB0B E9                   JP (HL)
 262  AB0C              ; ----------------------------------------------------------------------
 263  AB0C              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 264  AB0C              ;   In:  none. Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 265  AB0C              ;   Clobbers: A.
 266  AB0C              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard data/strobe; RLA shifts bit 7
 267  AB0C              ;        (key-ready) into carry; SBC A,A expands carry to $FF/$00. This is the
 268  AB0C              ;        built-in 40-col path used when no Videx/80-col card supplies CONST. [RE]
 269  AB0C              ; ----------------------------------------------------------------------
 270  AB0C              KBD_STATUS_40COL:
 271  AB0C                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 272  AB0C 3A 00 E0             LD A,($E000)
 273  AB0F                      ; rotate key-ready bit 7 into carry
 274  AB0F 17                   RLA
 275  AB10                      ; carry -> A = $FF (ready) or $00 (none)
 276  AB10 9F                   SBC A,A
 277  AB11 C9                   RET
 278  AB12              ; ----------------------------------------------------------------------
 279  AB12              ; CONSOLE_IN_40COL -- CONIN for the built-in Apple keyboard (default console-input
 280  AB12              ; handler, installed into the I/O vector table). Waits for a key, then maps it through
 281  AB12              ; a small remap table (function/arrow keys) at Apple $03AB.
 282  AB12              ;   Out: A = (translated) key. Clobbers A,B,C,DE,HL.
 283  AB12              ; ----------------------------------------------------------------------
 284  AB12              CONSOLE_IN_40COL:
 285  AB12                  IFDEF V220B
 286  AB12 ~                    CALL CONIN                       ; 2.20B: get the char via the IOBYTE-routed dispatcher first
 287  AB12                  ELSE
 288  AB12 CD 29 AB             CALL CONIN_KEYWAIT               ; wait for a raw key in A
 289  AB15                  ENDIF
 290  AB15 21 AB F3             LD HL,$F3AB                      ; HL = key-remap table base (Apple $03AB; first entry pair at $03AC)
 291  AB18 06 06                LD B,$06                         ; up to 6 table entries
 292  AB1A 4F                   LD C,A                           ; C = raw key
 293  AB1B              CONIN_XLATE_LOOP:
 294  AB1B 23                   INC HL
 295  AB1C 7E                   LD A,(HL)                        ; entry's match byte
 296  AB1D 23                   INC HL
 297  AB1E B7                   OR A
 298  AB1F FA 27 AB             JP M,CONIN_XLATE_DONE            ; high-bit sentinel ends the table
 299  AB22 B9                   CP C                             ; raw key == this entry?
 300  AB23 7E                   LD A,(HL)                        ; paired replacement byte
 301  AB24 C8                   RET Z                            ; match -> return the translated key
 302  AB25 10 F4                DJNZ CONIN_XLATE_LOOP
 303  AB27              CONIN_XLATE_DONE:
 304  AB27 79                   LD A,C                           ; no match -> return the raw key
 305  AB28 C9                   RET
 306  AB29              CONIN_KEYWAIT:
 307  AB29 11 03 00             LD DE,$0003
 308  AB2C              CONIN_DISPATCH:
 309  AB2C C3 2F AB             JP KBD_WAIT_KEY                  ; target (CONIN_DISPATCH+1) patched at boot
 310  AB2F              KBD_WAIT_KEY:
 311  AB2F 3A 00 E0             LD A,($E000)                     ; poll Apple $C000 keyboard register
 312  AB32 17                   RLA                              ; key-ready (bit 7) -> carry
 313  AB33 30 FA                JR NC,KBD_WAIT_KEY               ; spin until a key is down
 314  AB35 32 10 E0             LD ($E010),A                     ; clear the keyboard strobe (Apple $C010)
 315  AB38 3F                   CCF
 316  AB39 1F                   RRA                              ; A = 7-bit key
 317  AB3A C9                   RET
 318  AB3B              ; ----------------------------------------------------------------------
 319  AB3B              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC: stash HL to the command mailbox at
 320  AB3B              ; Apple $03D0, then poke the trigger cell (its address is patched per config at boot).
 321  AB3B              ;   In: HL = command/params; A = trigger value. Out: per the 6502 service routine.
 322  AB3B              ; ----------------------------------------------------------------------
 323  AB3B              RPC_TRIGGER:
 324  AB3B 22 D0 F3             LD ($F3D0),HL
 325  AB3E              RPC_TRIGGER_STORE:
 326  AB3E 32 00 00             LD ($0000),A
 327  AB41 C9                   RET
 328  AB42              ; ----------------------------------------------------------------------
 329  AB42              ; CONOUT body -- emit a console character, routed by the CP/M IOBYTE.
 330  AB42              ;   In:  A = character (caller's CONOUT arg, moved to C here).
 331  AB42              ;   Out: none. Clobbers: A,C,HL.
 332  AB42              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03). If the
 333  AB42              ;              field selects device value 2 (CRT/console), dispatch through the SoftCard
 334  AB42              ;              I/O vector cell at $F392 (Apple $0392) with JP (HL). Otherwise fall into
 335  AB42              ;              the column-tracking / tab-expansion path (CONOUT_FILTER) which formats the
 336  AB42              ;              character before it reaches the physical screen handler. This is the body
 337  AB42              ;              reached from the BIOS jump-vector CONOUT entry. [RE]
 338  AB42              ; ----------------------------------------------------------------------
 339  AB42              CONOUT_DISPATCH:
 340  AB42                      ; save the character to emit in C for the filter path
 341  AB42 4F                   LD C,A
 342  AB43                      ; read the CP/M IOBYTE (page-zero $0003)
 343  AB43 3A 03 00             LD A,($0003)
 344  AB46                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 345  AB46 E6 03                AND $03
 346  AB48                      ; device value 2 = direct console; anything else takes the filter path
 347  AB48 FE 02                CP $02
 348  AB4A 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 349  AB4C              LIST_VIA_VEC_F392:
 350  AB4C                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 351  AB4C 2A 92 F3             LD HL,($F392)
 352  AB4F E9                   JP (HL)
 353  AB50              ; ----------------------------------------------------------------------
 354  AB50              ; CONIN -- read a console character, routed by the IOBYTE CONSOLE field.
 355  AB50              ;   In:  none. Out: A = character. Clobbers: A,HL.
 356  AB50              ;   Algorithm: read IOBYTE, mask CONSOLE field (AND $03), and select one of three
 357  AB50              ;              input-handler vector cells by the field value: value 2 uses $F38A, value 3
 358  AB50              ;              ($02<x) uses the already-loaded $F384, the low values use $F382; then
 359  AB50              ;              JP (HL) into the chosen handler. ($F38x = Apple $038x I/O vector.) [RE]
 360  AB50              ; ----------------------------------------------------------------------
 361  AB50              CONIN:
 362  AB50 3A 03 00             LD A,($0003)
 363  AB53 E6 03                AND $03
 364  AB55 FE 02                CP $02
 365  AB57                      ; preload input-handler vector for the high CONSOLE field value ($F384 = Apple $0384)
 366  AB57 2A 84 F3             LD HL,($F384)
 367  AB5A 28 06                JR Z,CONIN_VIA_VEC_F38A
 368  AB5C 30 07                JR NC,DISPATCH_VIA_HL
 369  AB5E              CONIN_VIA_VEC_F382:
 370  AB5E                      ; input-handler vector for the low CONSOLE field values ($F382 = Apple $0382)
 371  AB5E 2A 82 F3             LD HL,($F382)
 372  AB61 E9                   JP (HL)
 373  AB62              CONIN_VIA_VEC_F38A:
 374  AB62                      ; input-handler vector for CONSOLE field value 2 ($F38A = Apple $038A)
 375  AB62 2A 8A F3             LD HL,($F38A)
 376  AB65              DISPATCH_VIA_HL:
 377  AB65 E9                   JP (HL)
 378  AB66              ; ----------------------------------------------------------------------
 379  AB66              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 380  AB66              ;   In:  C = character. Out: none. Clobbers: A,HL.
 381  AB66              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0). Field value below
 382  AB66              ;              $80 routes to the column/tab filter (CONOUT_FILTER); value == $80 reuses
 383  AB66              ;              the console vector path (LIST_VIA_VEC_F392); higher values dispatch through
 384  AB66              ;              the list-handler vector cell $F394 (Apple $0394). [RE]
 385  AB66              ; ----------------------------------------------------------------------
 386  AB66              LIST:
 387  AB66 3A 03 00             LD A,($0003)
 388  AB69                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 389  AB69 E6 C0                AND $C0
 390  AB6B FE 80                CP $80
 391  AB6D 38 27                JR C,CONOUT_FILTER
 392  AB6F 28 DB                JR Z,LIST_VIA_VEC_F392
 393  AB71                      ; load list-handler vector ($F394 = Apple $0394)
 394  AB71 2A 94 F3             LD HL,($F394)
 395  AB74 E9                   JP (HL)
 396  AB75              ; ----------------------------------------------------------------------
 397  AB75              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 398  AB75              ;   In:  C = character. Out: none. Clobbers: A,HL.
 399  AB75              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30). Field value below $10 takes
 400  AB75              ;              the column/tab filter; value $10 dispatches through vector $F390; higher
 401  AB75              ;              values dispatch through vector $F38E. ($F38E/$F390 = Apple $038E/$0390.) [RE]
 402  AB75              ; ----------------------------------------------------------------------
 403  AB75              PUNCH:
 404  AB75 3A 03 00             LD A,($0003)
 405  AB78                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 406  AB78 E6 30                AND $30
 407  AB7A FE 10                CP $10
 408  AB7C 38 18                JR C,CONOUT_FILTER
 409  AB7E                      ; punch-handler vector for the higher PUNCH field values ($F38E = Apple $038E)
 410  AB7E 2A 8E F3             LD HL,($F38E)
 411  AB81 20 E2                JR NZ,DISPATCH_VIA_HL
 412  AB83                      ; punch-handler vector for PUNCH field value $10 ($F390 = Apple $0390)
 413  AB83 2A 90 F3             LD HL,($F390)
 414  AB86 E9                   JP (HL)
 415  AB87              ; ----------------------------------------------------------------------
 416  AB87              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 417  AB87              ;   In:  none. Out: A = character. Clobbers: A,HL.
 418  AB87              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C). Field value below $04
 419  AB87              ;              reuses the CONIN low-value vector path; value $04 reuses the CONIN $F38A
 420  AB87              ;              path; higher values dispatch through reader vector $F38C (Apple $038C). [RE]
 421  AB87              ; ----------------------------------------------------------------------
 422  AB87              READER:
 423  AB87 3A 03 00             LD A,($0003)
 424  AB8A                      ; isolate the 2-bit READER device field of the IOBYTE
 425  AB8A E6 0C                AND $0C
 426  AB8C FE 04                CP $04
 427  AB8E 38 CE                JR C,CONIN_VIA_VEC_F382
 428  AB90 28 D0                JR Z,CONIN_VIA_VEC_F38A
 429  AB92                      ; load reader-handler vector ($F38C = Apple $038C)
 430  AB92 2A 8C F3             LD HL,($F38C)
 431  AB95 E9                   JP (HL)
 432  AB96              ; ----------------------------------------------------------------------
 433  AB96              ; CONOUT_FILTER -- column-tracking and tab/control formatting for console output.
 434  AB96              ;   In:  C = character; entered from CONOUT/LIST/PUNCH when the IOBYTE field selects the
 435  AB96              ;        filtered (non-raw) path. A carry/expand flag is set by the entry stub.
 436  AB96              ;   Out: none; emits 0..N physical characters via the screen handler (SCREEN_EMIT).
 437  AB96              ;   Clobbers: A,B,C,D,E,HL.
 438  AB96              ;   Algorithm: SCF then SBC A,A turns the carry into a 0/$FF flag stored in COL_FLAG.
 439  AB96              ;        Clear bit 7 of the character. If a pending-column-skip counter (COL_PENDING) is
 440  AB96              ;        nonzero, decrement it and reposition using config byte $F396 (Apple $0396) plus
 441  AB96              ;        the BOOT-overlaid base word, otherwise fall through to TAB_EXPAND. This is the
 442  AB96              ;        console output formatter; the two CONOUT_FILTER/_10 labels are the carry-set and
 443  AB96              ;        carry-clear entry points to the same body. [RE]
 444  AB96              ; ----------------------------------------------------------------------
 445  AB96              CONOUT_FILTER:
 446  AB96                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 447  AB96 37                   SCF
 448  AB97              CONOUT_FILTER_NOEXPAND:
 449  AB97                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 450  AB97 9F                   SBC A,A
 451  AB98 21 A2 AE             LD HL,COL_FLAG
 452  AB9B                      ; store the entry flag into COL_FLAG
 453  AB9B 77                   LD (HL),A
 454  AB9C                      ; strip the high bit of the character (7-bit ASCII)
 455  AB9C CB B9                RES 7,C
 456  AB9E 23                   INC HL
 457  AB9F                      ; load COL_PENDING (pending column-skip / fill count)
 458  AB9F 7E                   LD A,(HL)
 459  ABA0 B7                   OR A
 460  ABA1                      ; no pending column work -> go run tab/control expansion
 461  ABA1 28 3D                JR Z,TAB_EXPAND
 462  ABA3                      ; consume one pending column step
 463  ABA3 35                   DEC (HL)
 464  ABA4                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 465  ABA4 3A 96 F3             LD A,($F396)
 466  ABA7 21 AB AE             LD HL,DISK_SELDSK_SAVE
 467  ABAA 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 468  ABAC B7                   OR A
 469  ABAD F2 B3 AB             JP P,COL_APPLY_OFFSET_RAW
 470  ABB0 2B                   DEC HL
 471  ABB1              ; ----------------------------------------------------------------------
 472  ABB1              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 473  ABB1              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 474  ABB1              ;   Out: (HL) = C - offset. Clobbers: A,E.
 475  ABB1              ;   Algorithm: mask off the sign bit (AND $7F) to get the magnitude, subtract it from the
 476  ABB1              ;        current column in C, and store the new column. Reached when the config byte's
 477  ABB1              ;        sign indicates a simple subtractive column adjust. [RE]
 478  ABB1              ; ----------------------------------------------------------------------
 479  ABB1              COL_APPLY_OFFSET:
 480  ABB1                      ; drop the sign bit to get the offset magnitude
 481  ABB1 E6 7F                AND $7F
 482  ABB3              COL_APPLY_OFFSET_RAW:
 483  ABB3 5F                   LD E,A
 484  ABB4 79                   LD A,C
 485  ABB5                      ; new column = current column (C) minus the offset
 486  ABB5 93                   SUB E
 487  ABB6                      ; store the updated column position
 488  ABB6 77                   LD (HL),A
 489  ABB7 C9                   RET
 490  ABB8              COL_OFFSET_FROM_WIDTH:
 491  ABB8 B7                   OR A
 492  ABB9 FA BD AB             JP M,COL_OFFSET_FROM_WIDTH_1
 493  ABBC 2B                   DEC HL
 494  ABBD              COL_OFFSET_FROM_WIDTH_1:
 495  ABBD CD B1 AB             CALL COL_APPLY_OFFSET
 496  ABC0 2A AA AE             LD HL,(BOOT+2)
 497  ABC3 3A A1 F3             LD A,($F3A1)
 498  ABC6 B7                   OR A
 499  ABC7 F2 CF AB             JP P,COL_COMBINE_BASE
 500  ABCA E6 7F                AND $7F
 501  ABCC 5D                   LD E,L
 502  ABCD 6C                   LD L,H
 503  ABCE 63                   LD H,E
 504  ABCF              COL_COMBINE_BASE:
 505  ABCF 5F                   LD E,A
 506  ABD0 84                   ADD A,H
 507  ABD1 4F                   LD C,A
 508  ABD2 7B                   LD A,E
 509  ABD3 85                   ADD A,L
 510  ABD4 F5                   PUSH AF
 511  ABD5 06 07                LD B,$07
 512  ABD7 CD 2D AC             CALL SCREEN_EMIT
 513  ABDA F1                   POP AF
 514  ABDB 06 0A                LD B,$0A
 515  ABDD              ; ----------------------------------------------------------------------
 516  ABDD              ; CONOUT_EMIT_B -- emit character C, then route to TAB_EXPAND/SCREEN_EMIT with B as mode.
 517  ABDD              ;   In:  A = character to emit; B = mode/count code.
 518  ABDD              ;   Out: none. Clobbers: A,C.
 519  ABDD              ;   Algorithm: move A into C and fall through to SCREEN_EMIT (SCREEN_EMIT) carrying the B
 520  ABDD              ;        mode code. Tail-shared helper used by the column/tab logic to push a character
 521  ABDD              ;        to the physical screen handler. [RE]
 522  ABDD              ; ----------------------------------------------------------------------
 523  ABDD              CONOUT_EMIT_B:
 524  ABDD                      ; move the character into C for the screen emit path
 525  ABDD 4F                   LD C,A
 526  ABDE 18 4D                JR SCREEN_EMIT
 527  ABE0              ; ----------------------------------------------------------------------
 528  ABE0              ; TAB_EXPAND -- expand tabs / handle special columns against the tab-stop config table.
 529  ABE0              ;   In:  C = character (already 7-bit); B = passed from caller.
 530  ABE0              ;   Out: none; may emit fill characters and update the column state. Clobbers: A,B,C,D,E,HL.
 531  ABE0              ;   Algorithm: COL_STATE (COL_STATE) holds a sticky control state. If zero, compare the
 532  ABE0              ;        character against config byte $F397 (Apple $0397, a special trigger char); a match
 533  ABE0              ;        arms the sticky state ($80). Printable characters above $1F scan the 9-entry tab
 534  ABE0              ;        config table at $F3A0 (Apple $03A0, walked downward) for a matching stop; on a hit
 535  ABE0              ;        it indexes +$0B into a parallel table for the action byte, optionally recursing
 536  ABE0              ;        with config $F3A2 to emit a secondary character. A B==7 result sets COL_MODE
 537  ABE0              ;        (COL_PENDING) = 2. Falls through to SCREEN_EMIT for the actual output. [RE]
 538  ABE0              ; ----------------------------------------------------------------------
 539  ABE0              TAB_EXPAND:
 540  ABE0 47                   LD B,A
 541  ABE1                      ; HL -> COL_STATE sticky control-state cell
 542  ABE1 21 A4 AE             LD HL,COL_STATE
 543  ABE4 7E                   LD A,(HL)
 544  ABE5 5F                   LD E,A
 545  ABE6 B7                   OR A
 546  ABE7 20 11                JR NZ,TAB_TABLE_SCAN
 547  ABE9                      ; read the special trigger character from config ($F397 = Apple $0397)
 548  ABE9 3A 97 F3             LD A,($F397)
 549  ABEC B7                   OR A
 550  ABED 28 06                JR Z,TAB_EXPAND_CHECK_CTRL
 551  ABEF                      ; does the current character match the trigger?
 552  ABEF B9                   CP C
 553  ABF0 20 03                JR NZ,TAB_EXPAND_CHECK_CTRL
 554  ABF2                      ; arm the sticky control state for the next character
 555  ABF2 36 80                LD (HL),$80
 556  ABF4 C9                   RET
 557  ABF5              TAB_EXPAND_CHECK_CTRL:
 558  ABF5                      ; control-char threshold: chars <= $1F are not table-scanned
 559  ABF5 3E 1F                LD A,$1F
 560  ABF7 B9                   CP C
 561  ABF8 38 33                JR C,SCREEN_EMIT
 562  ABFA              TAB_TABLE_SCAN:
 563  ABFA                      ; HL -> top of the 9-entry tab-stop config table ($F3A0 = Apple $03A0)
 564  ABFA 21 A0 F3             LD HL,$F3A0
 565  ABFD                      ; 9 tab-stop table entries to scan
 566  ABFD 06 09                LD B,$09
 567  ABFF              TAB_TABLE_SCAN_LOOP:
 568  ABFF 7E                   LD A,(HL)
 569  AC00 B7                   OR A
 570  AC01 28 04                JR Z,TAB_TABLE_SCAN_NEXT
 571  AC03                      ; fold in COL_STATE before comparing the table entry to the char
 572  AC03 AB                   XOR E
 573  AC04 B9                   CP C
 574  AC05 28 05                JR Z,TAB_TABLE_HIT
 575  AC07              TAB_TABLE_SCAN_NEXT:
 576  AC07 2B                   DEC HL
 577  AC08 10 F5                DJNZ TAB_TABLE_SCAN_LOOP
 578  AC0A 18 21                JR SCREEN_EMIT
 579  AC0C              TAB_TABLE_HIT:
 580  AC0C                      ; step +$0B from the matched stop to its parallel action byte
 581  AC0C 11 0B 00             LD DE,$000B
 582  AC0F 19                   ADD HL,DE
 583  AC10 7E                   LD A,(HL)
 584  AC11 B7                   OR A
 585  AC12 4F                   LD C,A
 586  AC13 F2 23 AC             JP P,TAB_EXPAND_DONE
 587  AC16 E6 7F                AND $7F
 588  AC18 4F                   LD C,A
 589  AC19 C5                   PUSH BC
 590  AC1A                      ; secondary action character from config ($F3A2 = Apple $03A2)
 591  AC1A 3A A2 F3             LD A,($F3A2)
 592  AC1D 06 07                LD B,$07
 593  AC1F CD DD AB             CALL CONOUT_EMIT_B
 594  AC22 C1                   POP BC
 595  AC23              TAB_EXPAND_DONE:
 596  AC23 78                   LD A,B
 597  AC24                      ; action code 7 -> set COL_MODE = 2
 598  AC24 FE 07                CP $07
 599  AC26 20 05                JR NZ,SCREEN_EMIT
 600  AC28 3E 02                LD A,$02
 601  AC2A                      ; record COL_MODE = 2 for the next emit
 602  AC2A 32 A3 AE             LD (COL_PENDING),A
 603  AC2D              ; ----------------------------------------------------------------------
 604  AC2D              ; CONOUT_VIA_SCREEN -- emit one character to the Apple text screen, then advance
 605  AC2D              ; the cursor and redraw it.
 606  AC2D              ;   In:  the pending character is taken from the screen-driver state cells, not from
 607  AC2D              ;        a register here (SCREEN_CHAR holds the char-under-cursor; the caller has
 608  AC2D              ;        already staged the glyph). B = control-code selector for CTRL_CHAR_DISPATCH.
 609  AC2D              ;   Out: none. Clobbers: A,DE,HL.
 610  AC2D              ;   Algorithm: clear the wrap/scroll flag (COL_STATE), then vector through one of
 611  AC2D              ;              two screen-driver entry points selected by COL_FLAG (modeled in
 612  AC2D              ;              $F386/$F388 = Apple $0386/$0388 of the SoftCard I/O vector table).
 613  AC2D              ;              [RE] COL_FLAG selects 40-col vs 80-col / normal vs alternate path.
 614  AC2D              ; ----------------------------------------------------------------------
 615  AC2D              SCREEN_EMIT:
 616  AC2D AF                   XOR A
 617  AC2E                      ; clear the pending wrap/scroll flag before emitting
 618  AC2E                      ; clear COL_STATE before handing off to the screen handler
 619  AC2E 32 A4 AE             LD (COL_STATE),A
 620  AC31                      ; screen-mode selector: chooses which driver entry to vector to [RE]
 621  AC31                      ; test COL_FLAG to choose which screen-output vector to use
 622  AC31 3A A2 AE             LD A,(COL_FLAG)
 623  AC34 B7                   OR A
 624  AC35                      ; default screen-driver entry (SoftCard vector table, Apple $0388)
 625  AC35                      ; default screen-output vector ($F388 = Apple $0388)
 626  AC35 2A 88 F3             LD HL,($F388)
 627  AC38 28 03                JR Z,SCREEN_EMIT_VECTOR
 628  AC3A                      ; alternate screen-driver entry (Apple $0386) when selector nonzero
 629  AC3A                      ; alternate screen-output vector ($F386 = Apple $0386)
 630  AC3A 2A 86 F3             LD HL,($F386)
 631  AC3D              ; ----------------------------------------------------------------------
 632  AC3D              ; Merge point: HL = the selected screen-driver entry; fall through to the JP (HL).
 633  AC3D              ; ----------------------------------------------------------------------
 634  AC3D              SCREEN_EMIT_VECTOR:
 635  AC3D                      ; tail-jump into the selected screen-driver entry point
 636  AC3D E9                   JP (HL)
 637  AC3E              ; ----------------------------------------------------------------------
 638  AC3E              ; PUT_CHAR_DE3 -- screen-driver entry that preloads DE=3 (advance amount / column
 639  AC3E              ; step) and falls into the glyph-store path. [RE]
 640  AC3E              ;   In:  driver state cells as set up by CONOUT_VIA_SCREEN.
 641  AC3E              ;   Out: none. Clobbers: A,DE,HL.
 642  AC3E              ; ----------------------------------------------------------------------
 643  AC3E              PUT_CHAR_DE3:
 644  AC3E                      ; preset DE = column/advance step for this driver variant [RE]
 645  AC3E 11 03 00             LD DE,$0003
 646  AC41              ; ----------------------------------------------------------------------
 647  AC41              ; PUT_CHAR_VECTOR -- indirect entry into the glyph-store body. This JP's target
 648  AC41              ; operand is SELF-MODIFIED elsewhere (patch site = PUT_CHAR_VECTOR+1); it normally
 649  AC41              ; points at PUT_CHAR_STORE. Treat the +1/+2 bytes as the live dispatch target. [RE]
 650  AC41              ; ----------------------------------------------------------------------
 651  AC41              PUT_CHAR_VECTOR:
 652  AC41                      ; dispatch into the glyph-store body; target operand (PUT_CHAR_VECTOR+1) is patched at
 653  AC41                      ; runtime [RE]
 654  AC41 C3 44 AC             JP PUT_CHAR_STORE
 655  AC44              ; ----------------------------------------------------------------------
 656  AC44              ; PUT_CHAR_STORE -- store the current glyph at the cursor cell, recompute the cursor
 657  AC44              ; screen address from CH/BASL, read back the char now under the cursor, and write it
 658  AC44              ; as the inverse/cursor glyph.
 659  AC44              ;   In:  SCREEN_CURSOR_PTR = current cursor screen pointer; SCREEN_CHAR = glyph to store.
 660  AC44              ;   Out: SCREEN_CURSOR_PTR/SCREEN_CHAR updated to the new cursor cell + char under it.
 661  AC44              ;        Clobbers: A,DE,HL.
 662  AC44              ;   Algorithm: write staged glyph to old cursor cell; run the control-char handler
 663  AC44              ;              (CTRL_CHAR_DISPATCH) which may move CH; recompute the cell address as
 664  AC44              ;              BASL + CH ($F028/$F024 = Apple $0028/$0024); save char under cursor;
 665  AC44              ;              convert it to the inverse-video cursor glyph and store it. [RE]
 666  AC44              ; ----------------------------------------------------------------------
 667  AC44              PUT_CHAR_STORE:
 668  AC44                      ; HL = saved cursor screen pointer (cell holding the cursor)
 669  AC44 2A A5 AE             LD HL,(SCREEN_CURSOR_PTR)
 670  AC47                      ; A = staged glyph (the real char that belongs in that cell)
 671  AC47 3A A7 AE             LD A,(SCREEN_CHAR)
 672  AC4A                      ; draw the inverse-video cursor glyph in the new cell
 673  AC4A                      ; restore the real char into the old cursor cell
 674  AC4A 77                   LD (HL),A
 675  AC4B                      ; run control-char handling / cursor advance (may update CH=$F024)
 676  AC4B CD 6B AC             CALL CTRL_CHAR_DISPATCH
 677  AC4E                      ; HL = current text line base BASL/BASH (Apple ZP $0028/$0029)
 678  AC4E 2A 28 F0             LD HL,($F028)
 679  AC51                      ; A = cursor column CH (Apple ZP $0024)
 680  AC51 3A 24 F0             LD A,($F024)
 681  AC54 5F                   LD E,A
 682  AC55                      ; high byte $F0 maps column offset into the Apple low-RAM screen region
 683  AC55 16 F0                LD D,$F0
 684  AC57                      ; HL = BASL + CH = address of the new cursor cell
 685  AC57 19                   ADD HL,DE
 686  AC58                      ; save the new cursor cell pointer
 687  AC58 22 A5 AE             LD (SCREEN_CURSOR_PTR),HL
 688  AC5B 7E                   LD A,(HL)
 689  AC5C                      ; save the char currently under the cursor (to restore later)
 690  AC5C 32 A7 AE             LD (SCREEN_CHAR),A
 691  AC5F                      ; is the char in the lowercase/high range? choose inverse-video mapping
 692  AC5F FE E0                CP $E0
 693  AC61 38 02                JR C,PUT_CHAR_CURSOR_GLYPH
 694  AC63                      ; fold lowercase to its display form for the cursor glyph
 695  AC63 EE 20                XOR $20
 696  AC65              ; ----------------------------------------------------------------------
 697  AC65              ; Merge point in the cursor-glyph conversion (chars below $E0 skip the XOR $20 fold).
 698  AC65              ; ----------------------------------------------------------------------
 699  AC65              PUT_CHAR_CURSOR_GLYPH:
 700  AC65                      ; mask to 6-bit glyph code
 701  AC65 E6 3F                AND $3F
 702  AC67                      ; set inverse/flash field for the on-screen cursor glyph
 703  AC67 F6 40                OR $40
 704  AC69 77                   LD (HL),A
 705  AC6A C9                   RET
 706  AC6B              ; ----------------------------------------------------------------------
 707  AC6B              ; CTRL_CHAR_DISPATCH -- handle a control character / cursor-motion code by indexing a
 708  AC6B              ; per-code offset table and jumping to the matching handler body.
 709  AC6B              ;   In:  B = control-code index (0 = none/plain char). A is loaded from B.
 710  AC6B              ;   Out: per-handler (typically updates CH=$F024 and/or the line base). Clobbers A,HL.
 711  AC6B              ;   Algorithm: if B==0 fall through to the plain-character handler at CTRL_PLAIN_CHAR. Else
 712  AC6B              ;              push the RET address RPC_TRIGGER (each handler RETs back through it), load
 713  AC6B              ;              HL = CTRL_HANDLER_OFFSET_TBL, add the code to L, read the handler's low byte
 714  AC6B              ;              from the table (high byte stays $AC), and JP (HL) into the handler body. The
 715  AC6B              ;              handlers set HL to an Apple monitor routine address and RET (the caller fires
 716  AC6B              ;              the 6502 RPC), or update the cursor cells (CH/CV at Apple ZP $0024/$0025)
 717  AC6B              ;              directly. See CTRL_HANDLER_OFFSET_TBL for the code -> handler mapping.
 718  AC6B              ; ----------------------------------------------------------------------
 719  AC6B              CTRL_CHAR_DISPATCH:
 720  AC6B                      ; A = control-code index passed in B
 721  AC6B 78                   LD A,B
 722  AC6C                      ; index 0 means plain character: fall through to CTRL_PLAIN_CHAR
 723  AC6C B7                   OR A
 724  AC6D                      ; no control code: take the plain-char store path
 725  AC6D 28 0B                JR Z,CTRL_PLAIN_CHAR
 726  AC6F                      ; push the common return address so each handler RETs back here [RE]
 727  AC6F 21 3B AB             LD HL,RPC_TRIGGER
 728  AC72 E5                   PUSH HL
 729  AC73                      ; HL = base of the per-code handler offset table
 730  AC73 21 D4 AC             LD HL,CTRL_HANDLER_OFFSET_TBL
 731  AC76                      ; index the table: L = table_base_low + control-code; (HL) then holds the handler low byte
 732  AC76                      ; [RE]
 733  AC76 85                   ADD A,L
 734  AC77                      ; dispatch tail: L = table base low + control code; fetch the handler low byte
 735  AC77                      ; (high byte stays $AC) and jump to it.
 736  AC77 6F                   LD L,A
 737  AC78 6E                   LD L,(HL)                        ; 6E  L = CTRL_HANDLER_OFFSET_TBL[code]
 738  AC79 E9                   JP (HL)                          ; E9  enter the handler in page $AC
 739  AC7A              ; CTRL_PLAIN_CHAR -- store a printable character (or handle CR) on the text screen.
 740  AC7A              CTRL_PLAIN_CHAR:
 741  AC7A 79                   LD A,C
 742  AC7B FE 0D                CP $0D                           ; carriage return?
 743  AC7D 20 05                JR NZ,CTRL_PLAIN_PUT
 744  AC7F AF                   XOR A
 745  AC80 32 24 F0             LD ($F024),A                     ; CR: reset cursor column CH (Apple ZP $0024)
 746  AC83 C9                   RET
 747  AC84              CTRL_PLAIN_PUT:
 748  AC84 F6 80                OR $80                           ; set high bit (Apple screen glyph)
 749  AC86 FE E0                CP $E0                           ; in the lowercase range?
 750  AC88 38 04                JR C,CTRL_PLAIN_STORE
 751  AC8A 21 DD F3             LD HL,$F3DD                      ; case-fold config byte (Apple $03DD)
 752  AC8D AE                   XOR (HL)
 753  AC8E              CTRL_PLAIN_STORE:
 754  AC8E 32 45 F0             LD ($F045),A                     ; stash the glyph (Apple ZP $0045)
 755  AC91 21 F0 FD             LD HL,$FDF0                      ; HL = Apple monitor COUT1 ($FDF0) for the 6502 RPC
 756  AC94 18 79                JR PLOT_RPC_TAIL                 ; emit via the shared RPC tail
 757  AC96              ; --- control-code handlers (entered via the offset table; each RETs through RPC_TRIGGER) ---
 758  AC96              CTRL_VIDEO_NORMAL:                       ; code 4: select normal video
 759  AC96 3E FF                LD A,$FF
 760  AC98 01                   DEFB    $01                      ; cover (LD BC,nn): skips the LD A,$3F below
 761  AC99              CTRL_VIDEO_INVERSE:                      ; code 5: select inverse video
 762  AC99 3E 3F                LD A,$3F
 763  AC9B 32 32 F0             LD ($F032),A                     ; INVFLG (Apple ZP $0032): $FF = normal, $3F = inverse
 764  AC9E              CTRL_POP_RET:                            ; code 7: discard the pushed return and exit
 765  AC9E E1                   POP HL
 766  AC9F C9                   RET
 767  ACA0              CTRL_CURSOR_RIGHT:                       ; code 9: cursor right
 768  ACA0 21 F4 FB             LD HL,$FBF4                      ; HL = Apple monitor ADVANCE ($FBF4) for the RPC
 769  ACA3 C9                   RET
 770  ACA4              CTRL_HOME_CURSOR:                        ; code 6: home the cursor (CH/CV = 0)
 771  ACA4 AF                   XOR A
 772  ACA5 6F                   LD L,A
 773  ACA6 67                   LD H,A
 774  ACA7 22 24 F0             LD ($F024),HL                    ; Apple ZP $0024/$0025 (CH/CV) = (0,0)
 775  ACAA              CTRL_BASCAL2:
 776  ACAA 32 45 F0             LD ($F045),A
 777  ACAD 21 C1 FB             LD HL,$FBC1                      ; HL = Apple monitor BASCAL2 ($FBC1, line-base calc) for the RPC
 778  ACB0 C9                   RET
 779  ACB1              CTRL_CLREOP:                             ; code 2: clear to end of page -> $FC42 CLREOP
 780  ACB1 2E 42                LD L,$42
 781  ACB3 01                   DEFB    $01                      ; cover: skips the LD L,$9C below
 782  ACB4              CTRL_CLREOL:                             ; code 3: clear to end of line -> $FC9C CLREOL
 783  ACB4 2E 9C                LD L,$9C
 784  ACB6 01                   DEFB    $01                      ; cover: skips the LD L,$1A below
 785  ACB7              CTRL_CURSOR_UP:                          ; code 8: cursor up -> $FC1A UP
 786  ACB7 2E 1A                LD L,$1A
 787  ACB9 01                   DEFB    $01                      ; cover: skips the LD L,$58 below
 788  ACBA              CTRL_CLR_HOME:                           ; code 1: clear screen + home -> $FC58 HOME
 789  ACBA 2E 58                LD L,$58
 790  ACBC 26 FC                LD H,$FC                         ; HL = Apple monitor routine in page $FC (per the L above)
 791  ACBE C9                   RET
 792  ACBF              CTRL_CLAMP_CURSOR:                       ; code 10: clamp the saved cursor to 40x24 and store it
 793  ACBF 2A AA AE             LD HL,(BOOT+2)                   ; load saved cursor col/row (BOOT+2 cell)
 794  ACC2 7D                   LD A,L
 795  ACC3 FE 28                CP $28                           ; column >= 40?
 796  ACC5 38 02                JR C,CTRL_CLAMP_ROW
 797  ACC7 2E 00                LD L,$00                         ; clamp column to 0
 798  ACC9              CTRL_CLAMP_ROW:
 799  ACC9 7C                   LD A,H
 800  ACCA FE 18                CP $18                           ; row >= 24?
 801  ACCC 38 02                JR C,CTRL_CLAMP_STORE
 802  ACCE 26 00                LD H,$00                         ; clamp row to 0
 803  ACD0              CTRL_CLAMP_STORE:
 804  ACD0 22 24 F0             LD ($F024),HL                    ; store cursor (Apple ZP $0024/$0025)
 805  ACD3 18                   DEFB    $18                      ; JR opcode; its offset is the table[0] byte below
 806  ACD4                                                       ;        ($D5 = -43 -> CTRL_BASCAL2)
 807  ACD4              CTRL_HANDLER_OFFSET_TBL:
 808  ACD4                      ; low byte of each control-code handler (high byte $AC); indexed by control code
 809  ACD4                      ; 1..10. Entry [0]=$D5 doubles as the JR offset above (code 0 never dispatches here;
 810  ACD4                      ; it falls through to CTRL_PLAIN_CHAR earlier).
 811  ACD4                      ; -> [0]=JR-offset, COL_58, COL_42, COL_9C, MODE_FF, MODE_3F, HOME, POP_RET, COL_1A,
 812  ACD4                      ;    RPC_FBF4, CLAMP
 813  ACD4 D5 BA B1 B4          DEFB    $D5,$BA,$B1,$B4,$96,$99,$A4,$9E,$B7,$A0,$BF
 813  ACD8 96 99 A4 9E
 813  ACDC B7 A0 BF
 814  ACDF              ; DEV_STROBE_RD -- device handler: poll a status bit at the slot I/O base, then strobe.
 815  ACDF              DEV_STROBE_RD:
 816  ACDF CD 60 AD             CALL SLOT_IO_ADDR                ; HL = slot I/O base for the device
 817  ACE2              DEV_STROBE_WAIT:
 818  ACE2 7E                   LD A,(HL)
 819  ACE3 E6 02                AND $02                          ; wait for the ready bit
 820  ACE5 28 FB                JR Z,DEV_STROBE_WAIT
 821  ACE7 2C                   INC L
 822  ACE8 71                   LD (HL),C                        ; hand the byte to the device
 823  ACE9 C9                   RET
 824  ACEA              ; ----------------------------------------------------------------------
 825  ACEA              ; SET_CURSOR_COL_AND_BASE -- set the cursor column from C, then compute the screen
 826  ACEA              ; line base address for the current row.
 827  ACEA              ;   In:  C = cursor column. Row state read inside SLOT_IO_ADDR_W.
 828  ACEA              ;   Out: CH=$F045 set; falls through to SET_SCREEN_BASE. Clobbers A,HL (per AD5B).
 829  ACEA              ;   Algorithm: store C to the column cell (Apple $0045), then fall into the base
 830  ACEA              ;              computation. [RE]
 831  ACEA              ; ----------------------------------------------------------------------
 832  ACEA              SET_CURSOR_COL_AND_BASE:
 833  ACEA                      ; A = requested cursor column from C
 834  ACEA 79                   LD A,C
 835  ACEB                      ; store cursor column (Apple ZP $0045) [RE]
 836  ACEB 32 45 F0             LD ($F045),A
 837  ACEE              ; ----------------------------------------------------------------------
 838  ACEE              ; SET_SCREEN_BASE -- compute the text-line base address for the current cursor row
 839  ACEE              ; and stash its parts in the Apple ZP screen-base cells.
 840  ACEE              ;   In:  row state (consumed by SLOT_IO_ADDR_W).
 841  ACEE              ;   Out: A = char under cursor (from (HL)); $F6F8/$F045/$F046/$F047 updated.
 842  ACEE              ;        Clobbers A,HL.
 843  ACEE              ;   Algorithm: call SLOT_IO_ADDR_W to derive the row base, store it to the scratch cell
 844  ACEE              ;              $F6F8 (Apple $06F8) and to $F047 (Apple $0047); read a column from the
 845  ACEE              ;              SoftCard I/O region $EFFF (Apple $CFFF), normalize via DEVICE_IO_BASE,
 846  ACEE              ;              subtract a space ($20) bias, store to $F046, and return char-under-
 847  ACEE              ;              cursor in A. [RE] exact roles of $F045/$F046/$F047 = BASL/BASH/col.
 848  ACEE              ; ----------------------------------------------------------------------
 849  ACEE              SET_SCREEN_BASE:
 850  ACEE                      ; derive the text-line base address for the current row
 851  ACEE CD 5B AD             CALL SLOT_IO_ADDR_W
 852  ACF1                      ; save base into scratch cell (Apple $06F8)
 853  ACF1 32 F8 F6             LD ($F6F8),A
 854  ACF4                      ; store base into a screen-base cell (Apple ZP $0047)
 855  ACF4 32 47 F0             LD ($F047),A
 856  ACF7                      ; read a column/value from SoftCard I/O ($EFFF = Apple $CFFF) [RE]
 857  ACF7 3A FF EF             LD A,($EFFF)
 858  ACFA CD C5 AA             CALL DEVICE_IO_BASE
 859  ACFD                      ; remove the space ($20) bias to get a screen offset [RE]
 860  ACFD D6 20                SUB $20
 861  ACFF                      ; store the computed offset into a screen-base cell (Apple ZP $0046)
 862  ACFF 32 46 F0             LD ($F046),A
 863  AD02                      ; return the character currently at the computed cell
 864  AD02 7E                   LD A,(HL)
 865  AD03 C9                   RET
 866  AD04              ; ----------------------------------------------------------------------
 867  AD04              ; PLOT_CHAR_AT_COL -- position to a column then write C into the row buffer at that
 868  AD04              ; offset, and tail-jump to the common screen-driver return.
 869  AD04              ;   In:  C = character; DE = column offset; cursor row state.
 870  AD04              ;   Out: char stored into the row buffer at $F678+DE (Apple $0678+DE). [RE]
 871  AD04              ;   Algorithm: recompute the base via SET_CURSOR_COL_AND_BASE, form $F678+DE,
 872  AD04              ;              store C, then JP RPC_TRIGGER (shared driver epilogue). [RE]
 873  AD04              ; ----------------------------------------------------------------------
 874  AD04              PLOT_CHAR_AT_COL:
 875  AD04                      ; set cursor column and recompute the row base
 876  AD04 CD EA AC             CALL SET_CURSOR_COL_AND_BASE
 877  AD07                      ; HL = row buffer base (Apple $0678) [RE]
 878  AD07 21 78 F6             LD HL,$F678
 879  AD0A                      ; HL = buffer base + column offset DE
 880  AD0A 19                   ADD HL,DE
 881  AD0B                      ; store the character at the target column
 882  AD0B 71                   LD (HL),C
 883  AD0C 21 AA C9             LD HL,$C9AA
 884  AD0F                      ; tail into the shared screen-driver return path
 885  AD0F              PLOT_RPC_TAIL:
 886  AD0F C3 3B AB             JP RPC_TRIGGER                   ; (emit via the SoftCard RPC trigger)
 887  AD12              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 888  AD12              DEV_READ_BIT:                            ; (DEV_HANDLER_PTRS_B[0])
 889  AD12 CD 60 AD             CALL SLOT_IO_ADDR
 890  AD15              DEV_READ_WAIT:
 891  AD15 7E                   LD A,(HL)
 892  AD16 1F                   RRA                              ; ready bit -> carry
 893  AD17 30 FC                JR NC,DEV_READ_WAIT
 894  AD19 2C                   INC L
 895  AD1A 7E                   LD A,(HL)                        ; read the data byte
 896  AD1B C9                   RET
 897  AD1C              ; DEV_OUT_RPC -- device handler: position via the screen base, RPC a fixed command, read back.
 898  AD1C              DEV_OUT_RPC:                             ; (DEV_HANDLER_PTRS_B[1])
 899  AD1C CD EE AC             CALL SET_SCREEN_BASE
 900  AD1F 21 4D C8             LD HL,$C84D
 901  AD22 CD 3B AB             CALL RPC_TRIGGER                 ; trigger the SoftCard RPC
 902  AD25 21 78 F6             LD HL,$F678                      ; row buffer base (Apple $0678)
 903  AD28 19                   ADD HL,DE
 904  AD29 7E                   LD A,(HL)
 905  AD2A C9                   RET
 906  AD2B              DEV_OUT_1:                               ; (default I/O vector handler)
 907  AD2B 11 01 00             LD DE,$0001
 908  AD2E              DEV_OUT_1_JP:
 909  AD2E C3 3E AD             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 910  AD31              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 911  AD31              DEV_WR_BIT:                              ; (DEV_HANDLER_PTRS[2])
 912  AD31 CD C5 AA             CALL DEVICE_IO_BASE
 913  AD34 2E C1                LD L,$C1
 914  AD36              DEV_WR_WAIT:
 915  AD36 7E                   LD A,(HL)
 916  AD37 17                   RLA                              ; ready bit -> carry
 917  AD38 38 FC                JR C,DEV_WR_WAIT
 918  AD3A CD 5B AD             CALL SLOT_IO_ADDR_W
 919  AD3D 71                   LD (HL),C
 920  AD3E              DEV_RET:
 921  AD3E C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 922  AD3F              DEV_OUT_2:                               ; (default I/O vector handler)
 923  AD3F 11 02 00             LD DE,$0002
 924  AD42              DEV_OUT_2_JP:
 925  AD42 C3 3E AD             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 926  AD45              DEV_OUT_3:                               ; (default I/O vector handler)
 927  AD45 11 02 00             LD DE,$0002
 928  AD48              DEV_OUT_3_JP:
 929  AD48 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 930  AD4B              ; ----------------------------------------------------------------------
 931  AD4B              ; HOME -- BIOS jump-vector entry: seek the selected drive to track 0.
 932  AD4B              ;   In:  none (operates on the selected disk).
 933  AD4B              ;   Out: none. Clobbers: A,C.
 934  AD4B              ;   Algorithm: if the host buffer still holds dirty (hstwrt) data, leave hstact
 935  AD4B              ;              set so the pending write is not lost; otherwise mark the host
 936  AD4B              ;              buffer inactive (hstact=0). Then fall into SETTRK with track 0,
 937  AD4B              ;              recording sektrk=0. The actual head step happens later inside the
 938  AD4B              ;              deblock read/write path, not here. [RE]
 939  AD4B              ; ----------------------------------------------------------------------
 940  AD4B              HOME:
 941  AD4B                      ; read hstwrt (host-write-pending flag)
 942  AD4B 3A B0 AE             LD A,(DISK_HSTWRT)
 943  AD4E B7                   OR A
 944  AD4F 20 03                JR NZ,SETTRK_STORE
 945  AD51                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 946  AD51 32 AF AE             LD (DISK_SEKDSK+2),A
 947  AD54              ; ----------------------------------------------------------------------
 948  AD54              ; SETTRK -- BIOS jump-vector entry (vector $AA1E -> here): set the requested track.
 949  AD54              ;   In:  C = track number (BC = track; only C used).
 950  AD54              ;   Out: none. Clobbers: A.
 951  AD54              ;   Algorithm: store C into sektrk (the BDOS-requested track). HOME falls in here
 952  AD54              ;              with C=0. The track is consumed later by the deblock host-match
 953  AD54              ;              test and the RWTS setup, not acted on immediately.
 954  AD54              ; ----------------------------------------------------------------------
 955  AD54              SETTRK_STORE:
 956  AD54                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 957  AD54 0E 00                LD C,$00
 958  AD56                      ; track number from BDOS
 959  AD56              SETTRK:                                  ; BIOS jump-vector entry 10 (HOME falls in above)
 960  AD56 79                   LD A,C
 961  AD57                      ; store into sektrk (overlaid on the BOOT entry's LD SP operand)
 962  AD57 32 A8 AE             LD (BOOT),A
 963  AD5A C9                   RET
 964  AD5B              ; ----------------------------------------------------------------------
 965  AD5B              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 966  AD5B              ;   In:  E = slot/drive index (0..15).
 967  AD5B              ;   Out: HL = $E080 + (E << 4) = Apple $C080+slot*16 soft-switch register.
 968  AD5B              ;        A preserved low nibble math. Clobbers: A,L.
 969  AD5B              ;   Algorithm: load the $C08x base for the write/control bank, then fall into the
 970  AD5B              ;              common index scaler (SLOT_IO_SCALE) that shifts E left by 4 and adds it
 971  AD5B              ;              to L. z80 $E080 = Apple $C080 (slot I/O space). [RE]
 972  AD5B              ; ----------------------------------------------------------------------
 973  AD5B              SLOT_IO_ADDR_W:
 974  AD5B                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 975  AD5B 21 80 E0             LD HL,$E080
 976  AD5E 18 03                JR SLOT_IO_SCALE_E
 977  AD60              ; ----------------------------------------------------------------------
 978  AD60              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch address ($C08E bank).
 979  AD60              ;   In:  E = slot/drive index (0..15).
 980  AD60              ;   Out: HL = $E08E + (E << 4) = Apple $C08E+slot*16. Clobbers: A,L.
 981  AD60              ;   Algorithm: load the $C08E base, then SLOT_IO_SCALE shifts E left by 4 (ADD A,A x4)
 982  AD60              ;              and adds it to L to index the per-slot $C0n0..$C0nF register block.
 983  AD60              ;              z80 $E08E = Apple $C08E (slot I/O). [RE]
 984  AD60              ; ----------------------------------------------------------------------
 985  AD60              SLOT_IO_ADDR:
 986  AD60                      ; z80 $E08E = Apple $C08E slot-I/O base
 987  AD60 21 8E E0             LD HL,$E08E
 988  AD63              SLOT_IO_SCALE_E:
 989  AD63                      ; slot/drive index
 990  AD63 7B                   LD A,E
 991  AD64              SLOT_IO_SCALE:
 992  AD64 87                   ADD A,A
 993  AD65 87                   ADD A,A
 994  AD66 87                   ADD A,A
 995  AD67 87                   ADD A,A
 996  AD68 F5                   PUSH AF
 997  AD69 85                   ADD A,L
 998  AD6A 6F                   LD L,A
 999  AD6B F1                   POP AF
1000  AD6C C9                   RET
1001  AD6D              ; ----------------------------------------------------------------------
1002  AD6D              ; SELDSK -- BIOS jump-vector entry: select the disk drive for subsequent I/O.
1003  AD6D              ;   In:  C = disk number (0-based).
1004  AD6D              ;   Out: HL = DPH (disk parameter header) address for drive C, or HL=0 if C is out
1005  AD6D              ;             of range. Clobbers: A,DE,HL.
1006  AD6D              ;   Algorithm: read the configured drive count from the SoftCard config block
1007  AD6D              ;              (z80 $F3B8 = Apple $03B8). If C >= count, return 0. Otherwise record
1008  AD6D              ;              the selected disk into the sekdsk build site (DISK_SELDSK_SAVE+1 = $04 marker
1009  AD6D              ;              then C) and return the constant DPH at DPH_TABLE scaled by the index.
1010  AD6D              ;              z80 $F3B8 = Apple ZP/config $03B8. [RE]
1011  AD6D              ; ----------------------------------------------------------------------
1012  AD6D              SELDSK:
1013  AD6D                      ; DE -> sekdsk build site (the SMC cells overlaid on the BOOT-area instructions)
1014  AD6D 11 AC AE             LD DE,DISK_SELDSK_SAVE+1
1015  AD70 21 04 00             LD HL,$0004
1016  AD73                      ; configured drive count from Apple config $03B8
1017  AD73 3A B8 F3             LD A,($F3B8)
1018  AD76 3D                   DEC A
1019  AD77                      ; requested drive vs (count-1); C-flag set if out of range
1020  AD77 B9                   CP C
1021  AD78                      ; out of range -> return HL=0
1022  AD78 38 0A                JR C,SELDSK_BAD_DRIVE
1023  AD7A 7E                   LD A,(HL)
1024  AD7B                      ; store the marker, then the selected disk number into sekdsk
1025  AD7B 12                   LD (DE),A
1026  AD7C 13                   INC DE
1027  AD7D 79                   LD A,C
1028  AD7E 12                   LD (DE),A
1029  AD7F                      ; base DPH; SLOT_IO_SCALE indexes it by the drive number
1030  AD7F 21 33 AA             LD HL,DPH_TABLE
1031  AD82 18 E0                JR SLOT_IO_SCALE
1032  AD84              SELDSK_BAD_DRIVE:
1033  AD84 1A                   LD A,(DE)
1034  AD85 77                   LD (HL),A
1035  AD86 2E 00                LD L,$00
1036  AD88 C9                   RET
1037  AD89              ; ----------------------------------------------------------------------
1038  AD89              ; SETSEC -- BIOS jump-vector entry: set the requested sector.
1039  AD89              ;   In:  C = sector number.
1040  AD89              ;   Out: none. Clobbers: A.
1041  AD89              ;   Algorithm: store C into seksec (the BDOS-requested sector, overlaid on BOOT+1).
1042  AD89              ;              Consumed later by the deblock host-match test.
1043  AD89              ; ----------------------------------------------------------------------
1044  AD89              SETSEC:
1045  AD89 79                   LD A,C
1046  AD8A                      ; store into seksec
1047  AD8A 32 A9 AE             LD (BOOT+1),A
1048  AD8D C9                   RET
1049  AD8E              ; ----------------------------------------------------------------------
1050  AD8E              ; SETDMA -- BIOS jump-vector entry: set the DMA (record transfer) address.
1051  AD8E              ;   In:  BC = DMA buffer address (where the 128-byte CP/M record is read to/written from).
1052  AD8E              ;   Out: none. Clobbers: none.
1053  AD8E              ;   Algorithm: store BC into dmaadr; the deblock copy (LDIR) uses it as the host<->record
1054  AD8E              ;              transfer endpoint.
1055  AD8E              ; ----------------------------------------------------------------------
1056  AD8E              SETDMA:
1057  AD8E                      ; store the DMA address into dmaadr
1058  AD8E ED 43 B8 AE          LD (DISK_DMAADR),BC
1059  AD92 C9                   RET
1060  AD93              ; ----------------------------------------------------------------------
1061  AD93              ; READ -- BIOS jump-vector entry: read one 128-byte CP/M record via deblocking.
1062  AD93              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set by SELDSK/SETTRK/SETSEC/SETDMA.
1063  AD93              ;   Out: A = 0 on success, 1 on error (set by the shared deblock tail). Clobbers: A,HL,...
1064  AD93              ;   Algorithm: clear unacnt (no unallocated-write run is in progress on a read), then
1065  AD93              ;              mark this as a read: readop=2 and seed the wrtype/flag bytes to 2, and
1066  AD93              ;              jump into the shared deblock core which pre-reads the host sector if the
1067  AD93              ;              requested record is not already buffered, then copies host -> DMA. [RE]
1068  AD93              ; ----------------------------------------------------------------------
1069  AD93              READ:
1070  AD93 AF                   XOR A
1071  AD94                      ; unacnt = 0: a read never continues an unallocated-write run
1072  AD94 32 B4 AE             LD (DISK_WRTYPE+2),A
1073  AD97 3E 02                LD A,$02
1074  AD99                      ; HL -> readop; seed readop and the following flag bytes = 2 (read operation)
1075  AD99 21 B1 AE             LD HL,DISK_HSTWRT+1
1076  AD9C 77                   LD (HL),A
1077  AD9D 23                   INC HL
1078  AD9E 77                   LD (HL),A
1079  AD9F 23                   INC HL
1080  ADA0 77                   LD (HL),A
1081  ADA1                      ; enter the shared deblock core (skip the write-only pre-roll)
1082  ADA1 18 4F                JR DEBLOCK_CORE
1083  ADA3              ; ----------------------------------------------------------------------
1084  ADA3              ; WRITE -- BIOS jump-vector entry: write one 128-byte CP/M record via deblocking.
1085  ADA3              ;   In:  C = write type (0=allocated, 1=directory, 2=to a freshly-allocated/unalloc block);
1086  ADA3              ;        sekdsk/sektrk/seksec/dmaadr previously set.
1087  ADA3              ;   Out: A = 0 on success, 1 on error. Clobbers: A,HL,...
1088  ADA3              ;   Algorithm: record readop/wrtype from C. For an unallocated-block write (C=2) seed an
1089  ADA3              ;              8-record run (unacnt=8) anchored at the current sekdsk/sektrk/seksec so the
1090  ADA3              ;              next 7 sequential records skip the redundant pre-read. Then the shared
1091  ADA3              ;              deblock core: if the requested record extends the active unalloc run just
1092  ADA3              ;              buffer it (rsflag=0); otherwise force a host pre-read (rsflag=1), copy
1093  ADA3              ;              DMA -> host, mark hstwrt. [RE]
1094  ADA3              ; ----------------------------------------------------------------------
1095  ADA3              WRITE:
1096  ADA3 61                   LD H,C
1097  ADA4 2E 00                LD L,$00
1098  ADA6                      ; readop = wrtype (from C), clear the adjacent flag byte
1099  ADA6 22 B1 AE             LD (DISK_HSTWRT+1),HL
1100  ADA9 79                   LD A,C
1101  ADAA                      ; wrtype 2 = write to an unallocated block (start a sequential run)
1102  ADAA FE 02                CP $02
1103  ADAC                      ; ordinary write: skip the unalloc-run seeding
1104  ADAC 20 0F                JR NZ,DEBLOCK_CHECK_UNALLOC
1105  ADAE                      ; unacnt = 8 records in the new unallocated run (host blocking factor)
1106  ADAE 2E 08                LD L,$08
1107  ADB0                      ; compare sekdsk against the run's disk
1108  ADB0 3A AD AE             LD A,(DISK_SEKDSK)
1109  ADB3 67                   LD H,A
1110  ADB4                      ; seed unacnt (and the next byte) for the run
1111  ADB4 22 B4 AE             LD (DISK_WRTYPE+2),HL
1112  ADB7                      ; anchor the run's next-track/sector (unatrk/unasec) at the requested sektrk/seksec
1113  ADB7 2A A8 AE             LD HL,(BOOT)
1114  ADBA                      ; advance unatrk/unasec to the next record in the run
1115  ADBA 22 B6 AE             LD (DISK_UNADSK+1),HL
1116  ADBD              ; ----------------------------------------------------------------------
1117  ADBD              ; DEBLOCK_CHECK_UNALLOC -- decide whether the requested record continues the active
1118  ADBD              ;   unallocated-write run; if so just buffer it, else force a pre-read.
1119  ADBD              ;   In:  unacnt/unatrk/unasec, sekdsk/sektrk/seksec set by READ/WRITE.
1120  ADBD              ;   Out: rsflag set (0 = reuse buffer, 1 = must pre-read host sector). Clobbers: A,HL.
1121  ADBD              ;   Algorithm: if unacnt==0 the run is over -> rsflag=1. Otherwise verify the request
1122  ADBD              ;              matches sekdsk and the run's next unatrk/unasec; on a match advance the
1123  ADBD              ;              run and set rsflag=0, on any mismatch set rsflag=1. [RE]
1124  ADBD              ; ----------------------------------------------------------------------
1125  ADBD              DEBLOCK_CHECK_UNALLOC:
1126  ADBD                      ; point HL at unacnt (unallocated record count)
1127  ADBD 21 B4 AE             LD HL,DISK_WRTYPE+2
1128  ADC0                      ; unacnt: zero means no active unalloc run
1129  ADC0 7E                   LD A,(HL)
1130  ADC1 B7                   OR A
1131  ADC2 28 28                JR Z,DEBLOCK_FORCE_PREREAD
1132  ADC4                      ; consume one record of the unallocated run
1133  ADC4 35                   DEC (HL)
1134  ADC5 3A AD AE             LD A,(DISK_SEKDSK)
1135  ADC8 23                   INC HL
1136  ADC9 BE                   CP (HL)
1137  ADCA 20 20                JR NZ,DEBLOCK_FORCE_PREREAD
1138  ADCC 3A A8 AE             LD A,(BOOT)
1139  ADCF                      ; load unatrk/unasec (the run's current track/sector)
1140  ADCF 2A B6 AE             LD HL,(DISK_UNADSK+1)
1141  ADD2 BD                   CP L
1142  ADD3 20 17                JR NZ,DEBLOCK_FORCE_PREREAD
1143  ADD5                      ; requested seksec vs the run's sector
1144  ADD5 3A A9 AE             LD A,(BOOT+1)
1145  ADD8 BC                   CP H
1146  ADD9 20 11                JR NZ,DEBLOCK_FORCE_PREREAD
1147  ADDB                      ; advance the unalloc sector; wrap to next track when it passes the sectors-per-track limit
1148  ADDB                      ; ($20)
1149  ADDB 24                   INC H
1150  ADDC 7C                   LD A,H
1151  ADDD D6 20                SUB $20
1152  ADDF 38 02                JR C,DEBLOCK_RUN_CONTINUES
1153  ADE1 67                   LD H,A
1154  ADE2 2C                   INC L
1155  ADE3              DEBLOCK_RUN_CONTINUES:
1156  ADE3 22 B6 AE             LD (DISK_UNADSK+1),HL
1157  ADE6 AF                   XOR A
1158  ADE7                      ; rsflag = 0: record continues the run, no host pre-read needed
1159  ADE7 32 B3 AE             LD (DISK_WRTYPE+1),A
1160  ADEA 18 06                JR DEBLOCK_CORE
1161  ADEC              DEBLOCK_FORCE_PREREAD:
1162  ADEC                      ; rsflag = 1: record breaks the run, force a host-sector pre-read
1163  ADEC 21 01 00             LD HL,$0001
1164  ADEF 22 B3 AE             LD (DISK_WRTYPE+1),HL
1165  ADF2              ; ----------------------------------------------------------------------
1166  ADF2              ; DEBLOCK_CORE -- shared host-buffer management for READ and WRITE (the deblock heart).
1167  ADF2              ;   In:  sekdsk/sektrk/seksec, readop, wrtype, rsflag, hstact, hstwrt, dmaadr.
1168  ADF2              ;   Out: A = status (0 ok). Performs the host sector flush/read and the 128-byte
1169  ADF2              ;        record copy host<->DMA. Clobbers: A,BC,DE,HL.
1170  ADF2              ;   Algorithm: translate seksec through SECTOR_XLATE to the physical sector. If the
1171  ADF2              ;              host buffer is active (hstact) but holds a different disk/track/sector,
1172  ADF2              ;              flush it when dirty (hstwrt). Set up the RWTS request (track/sector/
1173  ADF2              ;              unit into the Apple $03Ex IOB). If rsflag demands it, physically read
1174  ADF2              ;              the host sector. Finally LDIR-copy the selected 128-byte half of the
1175  ADF2              ;              host sector to/from dmaadr (direction chosen by readop), and on a write
1176  ADF2              ;              mark hstwrt and flush if required. [RE]
1177  ADF2              ; ----------------------------------------------------------------------
1178  ADF2              DEBLOCK_CORE:
1179  ADF2                      ; read seksec back (returns the requested sector for translation)
1180  ADF2 CD F0 AF             CALL READ_SEKSEC
1181  ADF5 5F                   LD E,A
1182  ADF6 1F                   RRA
1183  ADF7                      ; translate logical sector -> physical via the skew table
1184  ADF7 21 92 AE             LD HL,SECTOR_XLATE
1185  ADFA 85                   ADD A,L
1186  ADFB 6F                   LD L,A
1187  ADFC 4E                   LD C,(HL)
1188  ADFD                      ; HL -> hstact; remember prior state, then mark the host buffer active
1189  ADFD 21 AF AE             LD HL,DISK_SEKDSK+2
1190  AE00 7E                   LD A,(HL)
1191  AE01                      ; hstact = 1 (host buffer now in use)
1192  AE01 36 01                LD (HL),$01
1193  AE03 B7                   OR A
1194  AE04                      ; host buffer was inactive: no flush/match test needed, go set up RWTS
1195  AE04 28 1B                JR Z,DEBLOCK_SETUP_RWTS
1196  AE06                      ; compare sekdsk vs hstdsk (host buffer's disk)
1197  AE06 2A AD AE             LD HL,(DISK_SEKDSK)
1198  AE09 7D                   LD A,L
1199  AE0A BC                   CP H
1200  AE0B 20 0D                JR NZ,DEBLOCK_NEED_RELOAD
1201  AE0D                      ; Apple $03E0 = current RWTS track/sector in the host buffer
1202  AE0D 2A E0 F3             LD HL,($F3E0)
1203  AE10                      ; requested sektrk vs host buffer track
1204  AE10 3A A8 AE             LD A,(BOOT)
1205  AE13 BD                   CP L
1206  AE14 20 04                JR NZ,DEBLOCK_NEED_RELOAD
1207  AE16 79                   LD A,C
1208  AE17 BC                   CP H
1209  AE18                      ; requested record already in the host buffer -> skip flush and re-read, go straight to the
1210  AE18                      ; copy
1211  AE18 28 33                JR Z,DEBLOCK_COPY_RECORD
1212  AE1A              DEBLOCK_NEED_RELOAD:
1213  AE1A                      ; hstwrt: if the outgoing host buffer is dirty, flush it first
1214  AE1A 3A B0 AE             LD A,(DISK_HSTWRT)
1215  AE1D B7                   OR A
1216  AE1E                      ; flush the dirty host buffer before reloading
1217  AE1E C4 73 AE             CALL NZ,DISK_WRITE_HOST
1218  AE21              DEBLOCK_SETUP_RWTS:
1219  AE21 3A AD AE             LD A,(DISK_SEKDSK)
1220  AE24 32 AE AE             LD (DISK_SEKDSK+1),A
1221  AE27 47                   LD B,A
1222  AE28 E6 01                AND $01
1223  AE2A 3C                   INC A
1224  AE2B                      ; Apple $03E4 = RWTS unit/volume cell
1225  AE2B 32 E4 F3             LD ($F3E4),A
1226  AE2E 78                   LD A,B
1227  AE2F E6 0E                AND $0E
1228  AE31 87                   ADD A,A
1229  AE32 87                   ADD A,A
1230  AE33 87                   ADD A,A
1231  AE34 2F                   CPL
1232  AE35 C6 61                ADD A,$61
1233  AE37                      ; Apple $03E6 = RWTS track cell
1234  AE37 32 E6 F3             LD ($F3E6),A
1235  AE3A 3A A8 AE             LD A,(BOOT)
1236  AE3D 6F                   LD L,A
1237  AE3E 61                   LD H,C
1238  AE3F                      ; Apple $03E0 = record the host buffer's new track/sector
1239  AE3F 22 E0 F3             LD ($F3E0),HL
1240  AE42                      ; rsflag: nonzero -> physically pre-read the host sector
1241  AE42 3A B3 AE             LD A,(DISK_WRTYPE+1)
1242  AE45 B7                   OR A
1243  AE46                      ; perform the host sector read (RWTS read entry)
1244  AE46 C4 7A AE             CALL NZ,DISK_READ_HOST
1245  AE49 AF                   XOR A
1246  AE4A                      ; hstwrt = 0 after a fresh read
1247  AE4A 32 B0 AE             LD (DISK_HSTWRT),A
1248  AE4D              DEBLOCK_COPY_RECORD:
1249  AE4D 7B                   LD A,E
1250  AE4E                      ; z80 $F800 = Apple $0800 host sector buffer base
1251  AE4E 21 00 F8             LD HL,$F800
1252  AE51 1F                   RRA
1253  AE52                      ; select the upper/lower 128-byte half of the host sector from the record's parity
1254  AE52 CB 1D                RR L
1255  AE54                      ; dmaadr = the CP/M record buffer
1256  AE54 ED 5B B8 AE          LD DE,(DISK_DMAADR)
1257  AE58                      ; 128-byte CP/M record length
1258  AE58 01 80 00             LD BC,$0080
1259  AE5B                      ; readop: nonzero = read (host->DMA), zero = write (DMA->host)
1260  AE5B 3A B1 AE             LD A,(DISK_HSTWRT+1)
1261  AE5E B7                   OR A
1262  AE5F 20 05                JR NZ,DEBLOCK_COPY
1263  AE61 3C                   INC A
1264  AE62 32 B0 AE             LD (DISK_HSTWRT),A
1265  AE65                      ; write direction: swap so LDIR copies DMA -> host buffer
1266  AE65 EB                   EX DE,HL
1267  AE66              DEBLOCK_COPY:
1268  AE66                      ; copy the 128-byte record host<->DMA
1269  AE66 ED B0                LDIR
1270  AE68                      ; wrtype: bit 0 decides whether a write must flush immediately (directory write)
1271  AE68 3A B2 AE             LD A,(DISK_WRTYPE)
1272  AE6B 1F                   RRA
1273  AE6C 3E 00                LD A,$00
1274  AE6E D0                   RET NC
1275  AE6F                      ; immediate flush of the dirty host buffer
1276  AE6F CD 73 AE             CALL DISK_WRITE_HOST
1277  AE72 C9                   RET
1278  AE73              ; ----------------------------------------------------------------------
1279  AE73              ; DISK_WRITE_HOST -- write the staged host sector to disk via the SoftCard RWTS RPC.
1280  AE73              ;   Clears hstwrt, sets the RWTS command cell ($F3EB = Apple $03EB) to write ($02),
1281  AE73              ;   fires the RPC (RPC_TRIGGER) with the track/sector params, then checks RWTS status
1282  AE73              ;   ($F3EA = Apple $03EA): 0 = OK; $10 = write-protected -> dispatch the BDOS read-only
1283  AE73              ;   disk error through the vector at ($9C0D). The read entry DISK_READ_HOST just below
1284  AE73              ;   shares this body via the $21 cover. Called by the deblock to flush a dirty host
1285  AE73              ;   buffer / write a directory record. [RE]
1286  AE73              ; ----------------------------------------------------------------------
1287  AE73              DISK_WRITE_HOST:
1288  AE73 AF                   XOR A
1289  AE74                      ; clear the host-buffer-dirty flag (hstwrt) as part of the flush
1290  AE74 32 B0 AE             LD (DISK_HSTWRT),A
1291  AE77 3E 02                LD A,$02
1292  AE79 21                   DEFB    $21                      ; cover (LD HL,nn opcode): on fall-through absorbs the
1293  AE7A              ; ----------------------------------------------------------------------
1294  AE7A              ; DISK_READ_HOST -- read a host sector from disk via the RWTS RPC. A direct CALL enters
1295  AE7A              ;   here so the LD A,$01 sets the RWTS command to read ($01); the $21 cover above absorbs
1296  AE7A              ;   this instruction on fall-through, leaving DISK_WRITE_HOST's A=$02 (write). Shares the
1297  AE7A              ;   RWTS command/status path with DISK_WRITE_HOST. [RE]
1298  AE7A              ; ----------------------------------------------------------------------
1299  AE7A              DISK_READ_HOST:
1300  AE7A 3E 01                LD A,$01                         ; CALL'd directly -> A=$01 (cover-skipped on fall-through)
1301  AE7C                      ; store the console-selector index into the SoftCard config block (Apple $03EB)
1302  AE7C 32 EB F3             LD ($F3EB),A
1303  AE7F 21 03 0E             LD HL,$0E03
1304  AE82                      ; probe/init the selected console device handler
1305  AE82 CD 3B AB             CALL RPC_TRIGGER
1306  AE85                      ; read the detected device-class byte from the config block (Apple $03EA)
1307  AE85 3A EA F3             LD A,($F3EA)
1308  AE88 B7                   OR A
1309  AE89                      ; no special device class -> done
1310  AE89 C8                   RET Z
1311  AE8A D1                   POP DE
1312  AE8B                      ; device class $10 -> dispatch through the installed handler vector
1313  AE8B FE 10                CP $10
1314  AE8D C0                   RET NZ
1315  AE8E                      ; fetch the handler entry from the CCP/loader vector cell (BDOS_FBASE+$0D) and tail-jump to it [RE]
1316  AE8E 2A 0D 9C             LD HL,(BDOS_FBASE+$0D)
1317  AE91 E9                   JP (HL)
1318  AE92              ; ----------------------------------------------------------------------
1319  AE92              ; SECTOR_XLATE -- 16-entry logical->physical sector skew table (a 0..15 permutation).
1320  AE92              ;   Indexed by the deblock code (LD A,L add-offset lookup) to translate a CP/M logical
1321  AE92              ;   sector to the physical RWTS sector. DATA, not code.
1322  AE92              ; ----------------------------------------------------------------------
1323  AE92              SECTOR_XLATE:
1324  AE92                      ; 16-entry logical->physical sector skew table (a 0..15 permutation),
1325  AE92                      ; indexed during disk deblock (DEV_HANDLER_LOOKUP-style *1 byte lookups).
1326  AE92 00 09 03 0C          DEFB    $00,$09,$03,$0C,$06,$0F,$01,$0A
1326  AE96 06 0F 01 0A
1327  AE9A 04 0D 07 08          DEFB    $04,$0D,$07,$08,$02,$0B,$05,$0E
1327  AE9E 02 0B 05 0E
1328  AEA2              ; ----------------------------------------------------------------------
1329  AEA2              ; COL_FLAG -- console-output entry/expand flag (0 or $FF), set by CONOUT_FILTER and
1330  AEA2              ;   tested by SCREEN_EMIT to pick the physical output vector. Immediately followed by
1331  AEA2              ;   COL_PENDING at A3-adjacent cells. Scratch byte, init $00. [RE]
1332  AEA2              ; ----------------------------------------------------------------------
1333  AEA2              COL_FLAG:
1334  AEA2 00                   DEFB    $00                      ; disk scratch byte
1335  AEA3              ; ----------------------------------------------------------------------
1336  AEA3              ; COL_PENDING -- pending column-skip / fill counter for console output, also reused as a
1337  AEA3              ;   mode byte (set to 2 by TAB_EXPAND_DONE). Decremented as columns are consumed.
1338  AEA3              ;   Accessed as COL_FLAG+1 in CONOUT_FILTER. Scratch byte, init $00. [RE]
1339  AEA3              ; ----------------------------------------------------------------------
1340  AEA3              COL_PENDING:
1341  AEA3 00                   DEFB    $00                      ; disk scratch byte
1342  AEA4              ; ----------------------------------------------------------------------
1343  AEA4              ; COL_STATE -- sticky control/escape state for tab expansion; armed to $80 on a trigger-
1344  AEA4              ;   char match and cleared by SCREEN_EMIT. Scratch byte, init $00. [RE]
1345  AEA4              ; ----------------------------------------------------------------------
1346  AEA4              COL_STATE:
1347  AEA4 00                   DEFB    $00                      ; disk scratch byte
1348  AEA5              ; ----------------------------------------------------------------------
1349  AEA5              ; SCREEN_CURSOR_PTR -- 2-byte pointer cell used by the screen routines (initialized to
1350  AEA5              ;   point at SCREEN_CHAR / SCREEN_CHAR). Loaded and re-stored by PUT_CHAR_STORE while reading
1351  AEA5              ;   the Apple cursor base ($F028) and column ($F024) to compute the on-screen cell. [RE]
1352  AEA5              ; ----------------------------------------------------------------------
1353  AEA5              SCREEN_CURSOR_PTR:
1354  AEA5 A7 AE                DEFW    SCREEN_CHAR              ; pointer cell (init -> SCREEN_CHAR)
1355  AEA7              ; ----------------------------------------------------------------------
1356  AEA7              ; SCREEN_CHAR -- saved on-screen character byte (the cell SCREEN_CURSOR_PTR points at by
1357  AEA7              ;   default); written back to the screen with format bits applied. Scratch byte, init $00.
1358  AEA7              ;   [RE]
1359  AEA7              ; ----------------------------------------------------------------------
1360  AEA7              SCREEN_CHAR:
1361  AEA7 00                   DEFB    $00                      ; disk scratch byte
1362  AEA8              ; ----------------------------------------------------------------------
1363  AEA8              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector $AA00 lands here via $AA00->$AEA8).
1364  AEA8              ;   In:  none. Out: does not return through here (falls into the install engine).
1365  AEA8              ;   Clobbers: all.
1366  AEA8              ;   DUAL USE of the first 2 operand bytes: this 'LD SP,$0100' executes once at cold boot;
1367  AEA8              ;   afterwards BOOT and BOOT+1 (the $00,$01 immediate-operand bytes) are reused as the
1368  AEA8              ;   disk-deblock sektrk and seksec cells: HOME/SETTRK write BOOT (sektrk), SETSEC writes
1369  AEA8              ;   BOOT+1 (seksec), and the WRITE/READ deblock and READ_SEKSEC read them. The third byte
1370  AEA8              ;   BOOT+2 is a SEPARATE console cursor word (read by the column/tab path and
1371  AEA8              ;   CTRL_CLAMP_CURSOR), NOT a disk cell. Valid SP-init bytes only during the single
1372  AEA8              ;   cold-boot pass; thereafter scratch, never re-executed. [RE]
1373  AEA8              ;   Algorithm: set the Z-80 stack, then fall through into the self-modifying install
1374  AEA8              ;   engine (PATCH_* cells) that writes the per-config operands into the running BIOS.
1375  AEA8              ; ----------------------------------------------------------------------
1376  AEA8              BOOT:
1377  AEA8                      ; init Z-80 stack; BOOT/BOOT+1 are reused post-boot as the sektrk/seksec deblock
1378  AEA8                      ; cells (BOOT=track, BOOT+1=sector); BOOT+2 is a separate console cursor word
1379  AEA8 31 00 01             LD SP,$0100
1380  AEAB              ; ----------------------------------------------------------------------
1381  AEAB              ; DISK_SELDSK_SAVE -- (boot install template 'LD A,$C9'); +1 byte reused as SELDSK scratch.
1382  AEAB              ;   At cold boot this is the install engine's 'LD A,$C9' template. After boot SELDSK
1383  AEAB              ;   stores the previously-selected drive (page-zero $0004) into DISK_SELDSK_SAVE+1,
1384  AEAB              ;   then the disk number into DISK_SEKDSK (the next cell). [RE]
1385  AEAB              ; ----------------------------------------------------------------------
1386  AEAB              DISK_SELDSK_SAVE:
1387  AEAB 3E C9                LD A,$C9
1388  AEAD              ; ----------------------------------------------------------------------
1389  AEAD              ; DISK_SEKDSK -- CP/M-requested disk number (DRI deblock 'sekdsk'); +1/+2 = hstdsk/hstact.
1390  AEAD              ;   Boot tenant: install template 'LD (nn),A' (operand runtime-patched). Operational
1391  AEAD              ;   tenant: SELDSK stores the selected disk number here; DISK_SEKDSK+1 = host disk
1392  AEAD              ;   (hstdsk [RE]); DISK_SEKDSK+2 = host-buffer-active flag (hstact), cleared by WBOOT/
1393  AEAD              ;   HOME and the deblock, set when a host sector is staged. [RE]
1394  AEAD              ; ----------------------------------------------------------------------
1395  AEAD              DISK_SEKDSK:
1396  AEAD 32 00 AA             LD (BIOS_VECTOR),A
1397  AEB0              ; ----------------------------------------------------------------------
1398  AEB0              ; DISK_HSTWRT -- host-buffer-dirty flag (DRI deblock 'hstwrt' [RE]); +1 = readop [RE].
1399  AEB0              ;   Boot tenant: install template 'LD A,$95' (the default IOBYTE immediate). Operational
1400  AEB0              ;   tenant: a deblock flag the WRITE path sets and the host-flush test reads;
1401  AEB0              ;   DISK_HSTWRT+1 is the read/seek scratch the READ/WRITE deblock loads. [RE]
1402  AEB0              ; ----------------------------------------------------------------------
1403  AEB0              DISK_HSTWRT:
1404  AEB0 3E 95                LD A,$95
1405  AEB2              ; ----------------------------------------------------------------------
1406  AEB2              ; DISK_WRTYPE -- deblock write type (DRI 'wrtype' [RE]); +1 = rsflag, +2 = unacnt.
1407  AEB2              ;   Boot tenant: install template 'LD ($0003),A' (stores the default IOBYTE). Operational
1408  AEB2              ;   tenant: DISK_WRTYPE+1 = read-sector-needed flag (rsflag); DISK_WRTYPE+2 = unallocated
1409  AEB2              ;   record count (unacnt), seeded to 8 on a directory-extending write and decremented
1410  AEB2              ;   by the WRITE deblock loop. [RE]
1411  AEB2              ; ----------------------------------------------------------------------
1412  AEB2              DISK_WRTYPE:
1413  AEB2 32 03 00             LD ($0003),A
1414  AEB5              ; ----------------------------------------------------------------------
1415  AEB5              ; DISK_UNADSK -- unallocated-run disk (DRI 'unadsk' [RE]); +1/+2 = unatrk/unasec.
1416  AEB5              ;   Boot tenant: install template 'LD HL,(nn)'. Operational tenant: the unallocated
1417  AEB5              ;   write run's position. DISK_UNADSK+1 (unatrk) and +2 (unasec) are seeded from the
1418  AEB5              ;   CP/M-requested track/sector (BOOT/BOOT+1) and advanced as the run is written. [RE]
1419  AEB5              ; ----------------------------------------------------------------------
1420  AEB5              DISK_UNADSK:
1421  AEB5 2A DE F3             LD HL,($F3DE)
1422  AEB8              ; ----------------------------------------------------------------------
1423  AEB8              ; DISK_DMAADR -- current DMA buffer address (DRI deblock 'dmaadr').
1424  AEB8              ;   Boot tenant: install template 'LD (nn),HL' (patches a console/IO operand at boot).
1425  AEB8              ;   Operational tenant: SETDMA stores BC here; the deblock record copy uses it as the
1426  AEB8              ;   CP/M 128-byte record source/destination.
1427  AEB8              ; ----------------------------------------------------------------------
1428  AEB8              DISK_DMAADR:
1429  AEB8 22 3F AB             LD (RPC_TRIGGER_STORE+1),HL
1430  AEBB AF                   XOR A
1431  AEBC 32 04 00             LD ($0004),A
1432  AEBF 3A BB F3             LD A,($F3BB)
1433  AEC2 FE 05                CP $05
1434  AEC4 30 1F                JR NC,DEV_INSTALL_2
1435  AEC6 D6 03                SUB $03
1436  AEC8 38 1B                JR C,DEV_INSTALL_2
1437  AECA 20 06                JR NZ,DEV_INSTALL_1
1438  AECC                      ; this console card class: repoint the CONST handler's read to $1FB0 (rewrites the
1439  AECC                      ; LD A,($E000) operand + the following byte) so status comes from the card, not $C000
1440  AECC 21 B0 1F             LD HL,$1FB0
1441  AECF 22 0E AB             LD (KBD_STATUS_40COL+2),HL
1442  AED2              DEV_INSTALL_1:
1443  AED2 F5                   PUSH AF
1444  AED3 CD 59 AF             CALL DEV_HANDLER_LOOKUP
1445  AED6 F1                   POP AF
1446  AED7 22 42 AC             LD (PUT_CHAR_VECTOR+1),HL
1447  AEDA CD 54 AF             CALL DEV_HANDLER_LOOKUP_B
1448  AEDD 22 2D AB             LD (CONIN_DISPATCH+1),HL         ; patch the CONIN keyboard-wait vector
1449  AEE0 3E 03                LD A,$03
1450  AEE2 32 FD AA             LD (CCP_MODE_FLAG+1),A
1451  AEE5              DEV_INSTALL_2:
1452  AEE5 3A B9 F3             LD A,($F3B9)
1453  AEE8 D6 03                SUB $03
1454  AEEA 38 08                JR C,DEV_INSTALL_3
1455  AEEC CD 59 AF             CALL DEV_HANDLER_LOOKUP
1456  AEEF 22 2F AD             LD (DEV_OUT_1_JP+1),HL           ; patch the DEV_OUT_1 vector
1457  AEF2 1E 80                LD E,$80
1458  AEF4              DEV_INSTALL_3:
1459  AEF4 3A BA F3             LD A,($F3BA)
1460  AEF7 D6 03                SUB $03
1461  AEF9 38 14                JR C,DEV_INSTALL_4
1462  AEFB F5                   PUSH AF
1463  AEFC CD 59 AF             CALL DEV_HANDLER_LOOKUP
1464  AEFF 22 43 AD             LD (DEV_OUT_2_JP+1),HL           ; patch the DEV_OUT_2 vector
1465  AF02 F1                   POP AF
1466  AF03 FE 02                CP $02
1467  AF05 30 08                JR NC,DEV_INSTALL_4
1468  AF07 CD 54 AF             CALL DEV_HANDLER_LOOKUP_B
1469  AF0A 22 49 AD             LD (DEV_OUT_3_JP+1),HL           ; patch the DEV_OUT_3 jump target
1470  AF0D 18 0B                JR DEV_INSTALL_5
1471  AF0F              DEV_INSTALL_4:
1472  AF0F 21 3E 1A             LD HL,$1A3E
1473  AF12 22 48 AD             LD (DEV_OUT_3_JP),HL             ; build DEV_OUT_3's instruction (opcode+lo)
1474  AF15 3E C9                LD A,$C9
1475  AF17 32 4A AD             LD (DEV_OUT_3_JP+2),A            ; build DEV_OUT_3's instruction (hi byte)
1476  AF1A              DEV_INSTALL_5:
1477  AF1A 3A 81 F3             LD A,($F381)
1478  AF1D B7                   OR A
1479  AF1E 20 0B                JR NZ,DEV_INSTALL_6
1480  AF20 21 AE AF             LD HL,IO_VECTOR_DEFAULTS
1481  AF23 11 80 F3             LD DE,$F380
1482  AF26 01 16 00             LD BC,$0016
1483  AF29 ED B0                LDIR
1484  AF2B              DEV_INSTALL_6:
1485  AF2B CD A2 AA             CALL PROBE_DEVICES
1486  AF2E 3A 98 F3             LD A,($F398)
1487  AF31 CD 64 AF             CALL SIGNON_EMIT
1488  AF34 3A 9B F3             LD A,($F39B)
1489  AF37                  IFDEF V220B
1490  AF37 ~                    LD A,(SIGNON_EMIT)               ; 2.20B: skip emitting the 2nd config byte (A is reloaded then discarded by the banner loop)
1491  AF37                  ELSE
1492  AF37 CD 64 AF             CALL SIGNON_EMIT
1493  AF3A                  ENDIF
1494  AF3A 21 73 AF             LD HL,SIGNON_BANNER
1495  AF3D              DEV_INSTALL_7:
1496  AF3D 7E                   LD A,(HL)
1497  AF3E B7                   OR A
1498  AF3F CA DB AA             JP Z,PAGEZERO_REBUILD
1499  AF42 E5                   PUSH HL
1500  AF43 CD 42 AB             CALL CONOUT_DISPATCH
1501  AF46 E1                   POP HL
1502  AF47 23                   INC HL
1503  AF48 18 F3                JR DEV_INSTALL_7
1504  AF4A              ; ----------------------------------------------------------------------
1505  AF4A              ; DEV_HANDLER_PTRS -- DEFW table of disk read/write handler addresses (primary group),
1506  AF4A              ;   indexed by DEV_HANDLER_LOOKUP. Continues as DEV_HANDLER_PTRS_B (+6). DATA.
1507  AF4A              ;   Each entry should relocate from a literal address to the named target:
1508  AF4A              ;     [0] $ACDF -> DISK_RD_HANDLER_A  (CALL SLOT_IO_ADDR sector-bit read handler in the
1509  AF4A              ;         CTRL_HANDLER_OFFSET_TBL data/code region)
1510  AF4A              ;     [1] $AD04 -> PLOT_CHAR_AT_COL        (named handler just below)
1511  AF4A              ;     [2] $AD31 -> DISK_WR_HANDLER_B (handler tail in the $AD22 data/code region)
1512  AF4A              ;   and DEV_HANDLER_PTRS_B holds:
1513  AF4A              ;     [0] $AD12 -> DISK_RD_HANDLER_B (RRA bit-test read handler at the $AD12 block)
1514  AF4A              ;     [1] $AD1C -> DISK_WR_HANDLER_A (CALL SET_SCREEN_BASE write handler in the $AD22 block)
1515  AF4A              ;   See flags: these targets currently sit inside DEFB blocks (CTRL_HANDLER_OFFSET_TBL / $AD12 /
1516  AF4A              ;   $AD22)
1517  AF4A              ;   that are really handler CODE, so the relocations need those blocks named first.
1518  AF4A              ; ----------------------------------------------------------------------
1519  AF4A              DEV_HANDLER_PTRS:
1520  AF4A                      ; table of device-handler addresses (DEFW). DEV_HANDLER_LOOKUP indexes from
1521  AF4A                      ; here; DEV_HANDLER_LOOKUP_B indexes from DEV_HANDLER_PTRS_B (+6). Selected per config
1522  AF4A                      ; by DISK_WRITE_HOST to install the right console/disk handler into the vector slots.
1523  AF4A DF AC                DEFW    DEV_STROBE_RD            ; [0]
1524  AF4C 04 AD                DEFW    PLOT_CHAR_AT_COL         ; [1]
1525  AF4E 31 AD                DEFW    DEV_WR_BIT               ; [2]
1526  AF50              DEV_HANDLER_PTRS_B:
1527  AF50 12 AD                DEFW    DEV_READ_BIT             ; DEV_HANDLER_LOOKUP_B base
1528  AF52 1C AD                DEFW    DEV_OUT_RPC
1529  AF54              ; ----------------------------------------------------------------------
1530  AF54              ; DEV_HANDLER_LOOKUP_B -- fetch a disk-handler address from DEV_HANDLER_PTRS_B[A].
1531  AF54              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1532  AF54              ;   Algorithm: point HL at DEV_HANDLER_PTRS_B then fall into the shared index loader
1533  AF54              ;   (HL += A*2; HL = word at that slot). Used by DISK_WRITE_HOST to install the per-config
1534  AF54              ;   read/write handler addresses. [RE]
1535  AF54              ; ----------------------------------------------------------------------
1536  AF54              DEV_HANDLER_LOOKUP_B:
1537  AF54                      ; select the secondary handler-pointer table
1538  AF54 21 50 AF             LD HL,DEV_HANDLER_PTRS_B
1539  AF57 18 03                JR DISK_RTN_LOOKUP_IDX
1540  AF59              ; ----------------------------------------------------------------------
1541  AF59              ; DEV_HANDLER_LOOKUP -- fetch a disk-handler address from DEV_HANDLER_PTRS[A].
1542  AF59              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1543  AF59              ;   Algorithm: HL = base; HL += A*2 (ADD A,A; ADD A,L; LD L,A); HL = the 16-bit word
1544  AF59              ;   at that slot (low then high). Shared tail of DEV_HANDLER_LOOKUP_B. [RE]
1545  AF59              ; ----------------------------------------------------------------------
1546  AF59              DEV_HANDLER_LOOKUP:
1547  AF59                      ; select the primary handler-pointer table
1548  AF59 21 4A AF             LD HL,DEV_HANDLER_PTRS
1549  AF5C              DISK_RTN_LOOKUP_IDX:
1550  AF5C                      ; index*2 for 16-bit (word) table entries
1551  AF5C 87                   ADD A,A
1552  AF5D 85                   ADD A,L
1553  AF5E 6F                   LD L,A
1554  AF5F                      ; load handler address low byte
1555  AF5F 7E                   LD A,(HL)
1556  AF60 2C                   INC L
1557  AF61                      ; load handler address high byte -> HL = handler entry
1558  AF61 66                   LD H,(HL)
1559  AF62 6F                   LD L,A
1560  AF63 C9                   RET
1561  AF64              ; ----------------------------------------------------------------------
1562  AF64              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1563  AF64              ;   In:  A = byte/flag. Out: none (prints via CONOUT_DISPATCH=CONOUT-class writer).
1564  AF64              ;   Algorithm: if A is positive (bit7 clear) just print it; if negative, first print
1565  AF64              ;   the prefix char from the config block (Apple $0397) then print A. Called twice from
1566  AF64              ;   the boot path to emit two config-derived sign-on chars before the banner. [RE]
1567  AF64              ; ----------------------------------------------------------------------
1568  AF64              SIGNON_EMIT:
1569  AF64 B7                   OR A
1570  AF65                      ; bit7 clear -> emit the char directly
1571  AF65 F2 70 AF             JP P,SIGNON_EMIT_CHAR
1572  AF68 F5                   PUSH AF
1573  AF69                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1574  AF69 3A 97 F3             LD A,($F397)
1575  AF6C                      ; emit the prefix char
1576  AF6C CD 42 AB             CALL CONOUT_DISPATCH
1577  AF6F F1                   POP AF
1578  AF70              SIGNON_EMIT_CHAR:
1579  AF70                      ; tail-call to emit the original char
1580  AF70 C3 42 AB             JP CONOUT_DISPATCH
1581  AF73              ; ----------------------------------------------------------------------
1582  AF73              ; SIGNON_BANNER -- the cold-boot sign-on string, printed char-by-char by the boot path
1583  AF73              ;   (loop at DEV_INSTALL_7) until the $00 terminator. Reads:
1584  AF73              ;   'Apple ][ CP/M' / '44K Ver. 2.20' / '(C) 1980 Microsoft', CR/LF separated. DATA.
1585  AF73              ; ----------------------------------------------------------------------
1586  AF73              SIGNON_BANNER:
1587  AF73 0D 0A 0D 0A          DEFB    "\r\n\r\n\r\n"
1587  AF77 0D 0A
1588  AF79 41 70 70 6C          DEFB    "Apple ][ CP/M"          ; string
1588  AF7D 65 20 5D 5B
1588  AF81 20 43 50 2F
1588  AF85 4D
1589  AF86 0D                   DEFB    $0D                      ; terminator
1590  AF87 0A                   DEFB    "\n"
1591  AF88                      ; memory token (CFG_56K) + version token (V220B); the +1 'B' is offset by
1592  AF88                      ; dropping a CR in the tail below so the banner stays 59 bytes either way.
1593  AF88                  IFDEF CFG_56K
1594  AF88 ~                    DEFB    "56K"
1595  AF88                  ELSE
1596  AF88 34 34 4B             DEFB    "44K"
1597  AF8B                  ENDIF
1598  AF8B 20 56 65 72          DEFB    " Ver. 2.20"
1598  AF8F 2E 20 32 2E
1598  AF93 32 30
1599  AF95                  IFDEF V220B
1600  AF95 ~                    DEFB    "B"                      ; 2.20B sub-revision
1601  AF95                  ENDIF
1602  AF95 0D                   DEFB    $0D                      ; terminator
1603  AF96 0A                   DEFB    "\n"
1604  AF97 28 43 29 20          DEFB    "(C) 1980 Microsoft"     ; string
1604  AF9B 31 39 38 30
1604  AF9F 20 4D 69 63
1604  AFA3 72 6F 73 6F
1604  AFA7 66 74
1605  AFA9 0D                   DEFB    $0D                      ; terminator
1606  AFAA                  IFDEF V220B
1607  AFAA ~                    DEFB    "\n\n\0"                  ; 2.20B: one fewer CR (offsets the 'B')
1608  AFAA                  ELSE
1609  AFAA 0A 0D 0A 00          DEFB    "\n\r\n\0"
1610  AFAE                  ENDIF
1611  AFAE              ; ----------------------------------------------------------------------
1612  AFAE              ; IO_VECTOR_DEFAULTS -- 22-byte (BC=$0016) DATA table of default I/O handler pointers,
1613  AFAE              ;   copied by the boot path (LDIR) into the SoftCard config/vector page at $F380=Apple
1614  AFAE              ;   $0380 when that page is uninitialized ($F381==0). The first 22 bytes are eleven
1615  AFAE              ;   little-endian addresses ($AB0C,$AB12,$AB12,$AC3E,$AC3E,$AD45,$AD45,$AD3F,$AD3F,
1616  AFAE              ;   $AD2B,$AD2B) mirroring console/list/punch/reader/disk handler entry points; only
1617  AFAE              ;   those 22 bytes are copied. This is a DATA pointer table, not relocated code. The
1618  AFAE              ;   bytes past offset 22 ($AFC4 onward) coincidentally re-mirror nearby handler code
1619  AFAE              ;   but are NOT executed from here. [RE] -- see flags.
1620  AFAE              ; ----------------------------------------------------------------------
1621  AFAE              IO_VECTOR_DEFAULTS:
1622  AFAE                  IFDEF V220B
1623  AFAE ~                    ; 2.20B: the CCP_INLEN warm-boot stub overlays the first four (CONST/CONIN/CONOUT)
1624  AFAE ~                    ; vector-default slots. Safe because the LDIR that copies these into the config page
1625  AFAE ~                    ; runs only on an uninitialized page ($F381==0), which the Language-Card loader pre-sets.
1626  AFAE ~                    CALL RPC_TRIGGER
1627  AFAE ~                    XOR A
1628  AFAE ~                    LD (CCP_INLEN),A
1629  AFAE ~                    RET
1630  AFAE                  ELSE
1631  AFAE 0C AB                DEFW    KBD_STATUS_40COL         ; CONST (40-col keyboard status)
1632  AFB0 12 AB                DEFW    CONSOLE_IN_40COL         ; CONIN
1633  AFB2 12 AB                DEFW    CONSOLE_IN_40COL
1634  AFB4 3E AC                DEFW    PUT_CHAR_DE3             ; CONOUT
1635  AFB6                  ENDIF
1636  AFB6 3E AC                DEFW    PUT_CHAR_DE3
1637  AFB8 45 AD                DEFW    DEV_OUT_3                ; LIST/PUNCH/READER stubs
1638  AFBA 45 AD                DEFW    DEV_OUT_3
1639  AFBC 3F AD                DEFW    DEV_OUT_2
1640  AFBE 3F AD                DEFW    DEV_OUT_2
1641  AFC0 2B AD                DEFW    DEV_OUT_1
1642  AFC2 2B AD                DEFW    DEV_OUT_1
1643  AFC4                      ; A dead in-image mirror of the DEV_HANDLER_PTRS table + DEV_HANDLER_LOOKUP /
1644  AFC4                      ; SIGNON_EMIT code (byte-identical to $xF44-$xF67); not referenced or executed. Its
1645  AFC4                      ; embedded in-image address high-bytes relocate with the OS (+$3000 under CFG_56K).
1646  AFC4 42 AB E1 23          DEFB    $42,$AB+(OS_RELOC>>8),$E1,$23,$18,$F3,$DF,$AC+(OS_RELOC>>8),$04,$AD+(OS_RELOC>>8),$31,$AD+(OS_RELOC>>8),$12,$AD+(OS_RELOC>>8),$1C,$AD+(OS_RELOC>>8)
1646  AFC8 18 F3 DF AC
1646  AFCC 04 AD 31 AD
1646  AFD0 12 AD 1C AD
1647  AFD4 21 50 AF 18          DEFB    $21,$50,$AF+(OS_RELOC>>8),$18,$03,$21,$4A,$AF+(OS_RELOC>>8),$87,$85,$6F,$7E,$2C,$66,$6F,$C9
1647  AFD8 03 21 4A AF
1647  AFDC 87 85 6F 7E
1647  AFE0 2C 66 6F C9
1648  AFE4 B7 F2 70 AF          DEFB    $B7,$F2,$70,$AF+(OS_RELOC>>8)
1649  AFE8                  IFDEF V220B
1650  AFE8 ~            WARMBOOT_INLEN_STUB:                     ; 2.20B: warm-boot RPC + clear the CCP staged-command flag
1651  AFE8 ~                    CALL RPC_TRIGGER
1652  AFE8 ~                    XOR A
1653  AFE8 ~                    LD (CCP_INLEN),A
1654  AFE8 ~                    RET
1655  AFE8                  ELSE
1656  AFE8 F5 3A 97 F3          DEFB    $F5,$3A,$97,$F3,$CD,$42,$AB,$F1   ; mirror tail (dead)
1656  AFEC CD 42 AB F1
1657  AFF0                  ENDIF
1658  AFF0              ; ----------------------------------------------------------------------
1659  AFF0              ; READ_SEKSEC -- load the current deblock sector and set flags.
1660  AFF0              ;   In:  none. Out: A = current sector (from BOOT+1=seksec); Z set if sector==0.
1661  AFF0              ;   Clobbers: A. Called by the READ/WRITE deblock path to test/translate the sector.
1662  AFF0              ;   Note BOOT+1 is the post-boot reuse of the BOOT 'LD SP,$0100' operand byte. [RE]
1663  AFF0              ; ----------------------------------------------------------------------
1664  AFF0              READ_SEKSEC:
1665  AFF0                      ; read the current deblock sector (BOOT+1 reused as seksec)
1666  AFF0 3A A9 AE             LD A,(BOOT+1)
1667  AFF3                      ; set Z/sign flags on the sector value for the caller
1668  AFF3 B7                   OR A
1669  AFF4 C9                   RET
1670  AFF5                  IFDEF V220B
1671  AFF5 ~                    ; 2.20B overlays the leading "\r\n\r\nAppl" of this dead fragment with a 3rd stub copy
1672  AFF5 ~                    CALL RPC_TRIGGER
1673  AFF5 ~                    XOR A
1674  AFF5 ~                    LD (CCP_INLEN),A
1675  AFF5 ~                    RET
1676  AFF5 ~                    DEFB    "e ]"
1677  AFF5                  ELSE
1678  AFF5 0D 0A 0D 0A          DEFB    "\r\n\r\nApple ]"
1678  AFF9 41 70 70 6C
1678  AFFD 65 20 5D
1679  B000                  ENDIF
1680  B000              BIOS_IMAGE_END:                          ; first byte past the BIOS image
1681  B000
1682  B000                  IFNDEF CPM_LINK
1683  B000                  ; image size from its bracketing labels (no magic length); $AA00 = the ORG base
1684  B000                  SAVEBIN "{out_bin}", BIOS_FBASE, BIOS_IMAGE_END - BIOS_FBASE
1685  B000                  ENDIF
1686  B000
# file closed: CPM_BIOS.asm

# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.20 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 44K BIOS runs at z80 $AA00-$AFFF (6 pages). The prior CPM_BIOS.asm decoded
   5  0000              ; it in on-disk (sector-interleaved) order and was both mis-addressed (28.9%
   6  0000              ; source-vs-runtime match) AND missing the 6th page; this source is decoded
   7  0000              ; against the DE-SKEWED runtime image -- every label a true runtime address. The
   8  0000              ; disk producer re-applies the sector skew (cpm_pipeline/deskew.py ::
   9  0000              ; BIOS_PAGE_TO_SECTOR). $AA00 = the 15-entry BIOS jump vector (BOOT, WBOOT,
  10  0000              ; CONST, CONIN, CONOUT, LIST, PUNCH, READER, HOME, SELDSK, SETTRK, SETSEC,
  11  0000              ; SETDMA, READ, WRITE). See ../../docs/CPM_Skew_Findings.md.
  12  0000              ;
  13  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
  14  0000              ; being enriched to the C-level bar.
  15  0000              ; ============================================================================
  16  0000
  17  0000                  INCLUDE "cpm_system_220.inc"   ; CCP/BDOS cross-module bases (CFG_56K re-homes them +$3000)
# file opened: cpm_system_220.inc
   1+ 0000              ; ============================================================================
   2+ 0000              ; cpm_system_220.inc -- CP/M 2.20 (44K) cross-module system contract
   3+ 0000              ; ----------------------------------------------------------------------------
   4+ 0000              ; The de-skewed 2.20-44K system image is TWO independent compilations -- the CCP
   5+ 0000              ; ($9400-$9BFF) and the BDOS ($9C00-$A9FF) -- decoded at their true RUNTIME
   6+ 0000              ; addresses (see ../docs/CPM_Skew_Findings.md). On the correctly-addressed source
   7+ 0000              ; the two are almost decoupled: the CCP calls the BDOS only through the page-zero
   8+ 0000              ; $0005 ABI (cpm22.inc :: BDOS), and the ONLY direct cross-module symbols are the
   9+ 0000              ; two module bases below. They are defined ONCE here and INCLUDEd by both modules
  10+ 0000              ; (never duplicated -- feedback_no_duplicate_symbol_definitions). The earlier
  11+ 0000              ; "59 CCP->BDOS cross-refs" were sector-skew artifacts and do not exist on the
  12+ 0000              ; de-skewed source.
  13+ 0000              ; ============================================================================
  14+ 0000
  15+ 0000              ; Memory-config axis: the 56K (Language Card) system is the 44K image lifted +$3000
  16+ 0000              ; (CCP $9400->$C400, BDOS $9C00->$CC00, BIOS $AA00->$DA00 = Apple LC $D400/$DC00/$EA00).
  17+ 0000              ; Because every address below is derived from this single offset, defining CFG_56K
  18+ 0000              ; (the build's -D flag) re-homes the whole 2.20 OS by re-assembly alone -- no per-cell
  19+ 0000              ; edits. See ../docs/CPM_56K_60K_Fold_Plan.md.
  20+ 0000                  IFDEF CFG_56K
  21+ 0000 ~            OS_RELOC   EQU $3000      ; 56K: OS relocated into the Apple Language Card
  22+ 0000                  ELSE
  23+ 0000              OS_RELOC   EQU $0000      ; 44K: OS in main RAM (the base build)
  24+ 0000                  ENDIF
  25+ 0000
  26+ 0000              CCP_ENTRY  EQU $9400 + OS_RELOC  ; CBASE: CCP cold entry (JP cold-start); BDOS fn 0 / warm boot returns here
  27+ 0000              BDOS_FBASE EQU $9C00 + OS_RELOC  ; FBASE: BDOS image base (6-byte serial + JP +6 entry); top-of-TPA marker the CCP loads
  28+ 0000              BIOS_FBASE EQU $AA00 + OS_RELOC  ; WBOOT/BIOS base = the first byte PAST the BDOS image (CPM_BDOS asserts $ == this)
  29+ 0000
  30+ 0000              ; Region sizes are computed from the contiguous module boundaries above -- never a magic
  31+ 0000              ; number -- so they track the image layout (and the byte gate catches any overrun via the
  32+ 0000              ; CPM_BDOS end-of-image ASSERT). CCP -> BDOS -> BIOS are back-to-back.
  33+ 0000              CCP_SIZE   EQU BDOS_FBASE - CCP_ENTRY     ; $0800: CCP image size  = (first BDOS byte) - (first CCP byte)
  34+ 0000              BDOS_SIZE  EQU BIOS_FBASE - BDOS_FBASE    ; $0E00: BDOS image size = (byte after BDOS) - (first BDOS byte)
  35+ 0000
  36+ 0000              ; --- CCP cells referenced cross-module (single source of truth, by label arithmetic) ---
  37+ 0000              ; CCP_INLEN ($9407 = CCP_ENTRY+7): the CCP console-line returned-count byte (CCP_INBUF+1).
  38+ 0000              ; It doubles as the staged / auto-command flag -- nonzero on CCP entry means a command line
  39+ 0000              ; is already staged in CCP_CMDTEXT and is re-parsed instead of re-prompting (the SUBMIT/$SUB
  40+ 0000              ; chaining hook). The CCP warm-start clears it; the 2.20B BIOS warm-boot path ALSO clears it
  41+ 0000              ; (XOR A; LD (CCP_INLEN),A) so a BIOS-driven warm boot discards any stale staged command and
  42+ 0000              ; the CCP re-prompts cleanly. (The base 2.20 BIOS does not reference it; this is the lone
  43+ 0000              ; genuine BIOS->CCP cell, introduced by 2.20B.)
  44+ 0000              CCP_INLEN  EQU CCP_ENTRY + 7
  45+ 0000
# file closed: cpm_system_220.inc
  18  0000
  19  0000                  IFNDEF CPM_LINK
  20  0000                  DEVICE NOSLOT64K
  21  0000                  ORG BIOS_FBASE                 ; $AA00 (44K) or $DA00 (CFG_56K); the byte past the BDOS image
  22  AA00                  ENDIF
  23  AA00
  24  AA00              ; -- Self-modify / dual-use cells (operand bytes referenced as LABEL+offset, per the
  25  AA00              ;    SoftCard convention: the patched instruction keeps a semantic label; the patch site
  26  AA00              ;    is +1/+2). The cold-boot installer (BOOT..DEV_INSTALL_*) and the deblock share much
  27  AA00              ;    of the $AEA8-$AEBA band: --
  28  AA00              ;      CCP_MODE_FLAG+1       patched immediate of the CCP-launch flag
  29  AA00              ;      KBD_STATUS_40COL+2    CONST read-address, repointed per console card
  30  AA00              ;      RPC_TRIGGER_STORE+1   RPC trigger store-address (set from the SoftCard config)
  31  AA00              ;      PUT_CHAR_VECTOR+1     self-modified screen-emit jump target
  32  AA00              ;      DEV_OUT_1_JP+1 / DEV_OUT_2_JP+1 / DEV_OUT_3_JP(+1/+2)  device-handler vectors
  33  AA00              ;      CONIN_DISPATCH+1      keyboard-wait vector
  34  AA00              ;      DISK_SEKDSK(+1/+2), DISK_HSTWRT(+1), DISK_WRTYPE(+1/+2), DISK_UNADSK(+1/+2),
  35  AA00              ;      DISK_DMAADR, BOOT, BOOT+1   the DRI deblock scratch (sekdsk/hstdsk/hstact/hstwrt/
  36  AA00              ;                                  readop/wrtype/rsflag/unacnt/unatrk/unasec/dmaadr/
  37  AA00              ;                                  sektrk/seksec), overlaid on the install templates.
  38  AA00
  39  AA00              ; ----------------------------------------------------------------------
  40  AA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector.
  41  AA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  42  AA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  43  AA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  44  AA00              ;   In:  entered by JP/CALL to base+3*n. Out: per the dispatched entry.
  45  AA00              ;   Note: the CONOUT and SETTRK targets ($AB43, $AD56) are the second-instruction
  46  AA00              ;         entry points of CONOUT_DISPATCH and HOME's tail, decoded as raw addresses
  47  AA00              ;         here; see flags.
  48  AA00              ; ----------------------------------------------------------------------
  49  AA00              BIOS_VECTOR:
  50  AA00                      ; entry 0 = cold boot (first run after the loader)
  51  AA00 C3 A8 AE             JP BOOT
  52  AA03              BIOS_VECTOR_WBOOT:
  53  AA03                      ; jump table
  54  AA03                      ; entry 1 = warm boot: reload CCP, rebuild page zero
  55  AA03 C3 CC AA             JP      WBOOT
  56  AA06 C3 08 AB             JP      CONST
  57  AA09                  IFDEF V220B
  58  AA09 ~                    JP      CONSOLE_IN_40COL        ; 2.20B: CONIN enters the 40-col handler, which calls the IOBYTE dispatcher then remaps fn/arrow keys
  59  AA09                  ELSE
  60  AA09 C3 50 AB             JP      CONIN
  61  AA0C                  ENDIF
  62  AA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  63  AA0C C3 43 AB             JP      CONOUT_DISPATCH+1
  64  AA0F C3 66 AB             JP      LIST
  65  AA12 C3 75 AB             JP      PUNCH
  66  AA15 C3 87 AB             JP      READER
  67  AA18 C3 4B AD             JP      HOME
  68  AA1B C3 6D AD             JP      SELDSK
  69  AA1E                      ; entry 10 = SETTRK; the LD A,C tail shared with HOME
  70  AA1E C3 56 AD             JP      SETTRK
  71  AA21 C3 89 AD             JP      SETSEC
  72  AA24 C3 8E AD             JP      SETDMA
  73  AA27 C3 93 AD             JP      READ
  74  AA2A C3 A3 AD             JP      WRITE
  75  AA2D AF C9 00 60          DEFB    $AF,$C9,$00,$60,$69,$C9
  75  AA31 69 C9
  76  AA33              ; ----------------------------------------------------------------------
  77  AA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
  78  AA33              ;   drive 0..5). SELDSK returns DPH_TABLE + 16*drive (or 0 for an out-of-range drive).
  79  AA33              ;   Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV, ALV. XLT = 0 (no SECTRAN
  80  AA33              ;   sector translate; the deblock applies the skew internally via SECTOR_XLATE). All six
  81  AA33              ;   drives share one DIRBUF and one DPB. DIRBUF ($AEBA, 128 bytes) and the per-drive CSV
  82  AA33              ;   (checksum, 12 bytes) and ALV (allocation, ~17 bytes) vectors live in the BIOS's own
  83  AA33              ;   $AE/$AF RAM, reused as scratch after the cold-boot code there has run; they are kept
  84  AA33              ;   as literal addresses (not relocatable labels) for that reason. [RE]
  85  AA33              ; ----------------------------------------------------------------------
  86  AA33              ; The DIRBUF/CSV/ALV vectors OVERLAY the cold-boot/sign-on code in pages $AE-$AF: that
  87  AA33              ; code runs once, then the disk system reuses the bytes as scratch buffers (which is why a
  88  AA33              ; post-boot RAM dump shows those pages clobbered). They are in-image addresses, so define
  89  AA33              ; them by arithmetic from BIOS_FBASE -- they relocate with CFG_56K (a raw literal would not,
  90  AA33              ; silently breaking the 56K build's DPH pointers).
  91  AA33              ; DIRBUF, ALV_VECTORS and CSV_VECTORS are the BDOS scratch buffers this table hands out.
  92  AA33              ; They are declared at the foot of this file (see "BDOS scratch overlay"), because they
  93  AA33              ; are a SECOND tenant of bytes the cold-boot code above owns: the layout is set out there
  94  AA33              ; with its own ORG, so each field is a real label rather than a magic address.
  95  AA33              DPH_TABLE:
  96  AA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
  96  AA37 00 00 00 00
  96  AA3B BA AE 93 AA
  96  AA3F 9A AF 3A AF
  97  AA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+16   ; drive 1
  97  AA47 00 00 00 00
  97  AA4B BA AE 93 AA
  97  AA4F A6 AF 4A AF
  98  AA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+32   ; drive 2
  98  AA57 00 00 00 00
  98  AA5B BA AE 93 AA
  98  AA5F B2 AF 5A AF
  99  AA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+48   ; drive 3
  99  AA67 00 00 00 00
  99  AA6B BA AE 93 AA
  99  AA6F BE AF 6A AF
 100  AA73 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+48,ALV_VECTORS+64   ; drive 4
 100  AA77 00 00 00 00
 100  AA7B BA AE 93 AA
 100  AA7F CA AF 7A AF
 101  AA83 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+60,ALV_VECTORS+80   ; drive 5
 101  AA87 00 00 00 00
 101  AA8B BA AE 93 AA
 101  AA8F D6 AF 8A AF
 102  AA93              ; ----------------------------------------------------------------------
 103  AA93              ; DPB -- the shared Disk Parameter Block (5.25" floppy geometry; every DPH points here).
 104  AA93              ;   One label per field, so the field names are symbols rather than prose. The ten names
 105  AA93              ;   are Digital Research's CP/M 2.2 DPB field names. NOT [DOC]-citable from this archive:
 106  AA93              ;   the SoftCard manual set documents only the BDOS call that RETURNS a DPB pointer
 107  AA93              ;   (fn 31, Get Addr (disk parms)), not the block's layout.
 108  AA93              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 109  AA93              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track; DSM=127 -> 128 blocks =
 110  AA93              ;   128 KB of file area = 32 tracks, which with OFF=3 reserved tracks accounts for a
 111  AA93              ;   35-track disk exactly. [RE]
 112  AA93              ; ----------------------------------------------------------------------
 113  AA93              DPB:
 114  AA93 20 00        SPT:    DEFW    $0020                    ; records per track: 32 x 128-byte records
 115  AA95 03           BSH:    DEFB    $03                      ; block shift: log2(records per block) -> 8 records
 116  AA96 07           BLM:    DEFB    $07                      ; block mask: (records per block) - 1 -> 1 KB blocks
 117  AA97 00           EXM:    DEFB    $00                      ; extent mask
 118  AA98 7F 00        DSM:    DEFW    $007F                    ; highest allocation block number: 127 -> 128 blocks
 119  AA9A 2F 00        DRM:    DEFW    $002F                    ; highest directory entry number: 47 -> 48 entries
 120  AA9C C0           AL0:    DEFB    $C0                      ; directory-reserved blocks, bitmap, high byte -> 2
 121  AA9D 00           AL1:    DEFB    $00                      ; ditto, low byte
 122  AA9E 0C 00        CKS:    DEFW    $000C                    ; directory checksum bytes
 123  AAA0 03 00        OFF:    DEFW    $0003                    ; reserved tracks before the file area
 124  AAA2              ; ----------------------------------------------------------------------
 125  AAA2              ; PROBE_DEVICES -- scan the 7-entry SoftCard device/config area and mark presence.
 126  AAA2              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 127  AAA2              ;   Out: config bytes updated in place; calls per-device init when a device is found.
 128  AAA2              ;   Clobbers: A,DE,HL.
 129  AAA2              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E]; if it equals 3 the slot
 130  AAA2              ;              holds a recognized device, so call SLOT_IO_ADDR (build the slot I/O base)
 131  AAA2              ;              and store $03 then $15 into the config cell to flag it configured. A
 132  AAA2              ;              secondary DEC A test (value was 4) runs SET_SCREEN_BASE (console probe) and
 133  AAA2              ;              claims the $C800 shared expansion-ROM window via RPC_TRIGGER. [RE]
 134  AAA2              ; ----------------------------------------------------------------------
 135  AAA2              PROBE_DEVICES:
 136  AAA2                      ; DE = 7 entries to scan (index walks down to 1)
 137  AAA2 11 07 00             LD DE,$0007
 138  AAA5              PROBE_DEVICES_LOOP:
 139  AAA5                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 140  AAA5 21 B8 F3             LD HL,$F3B8
 141  AAA8 19                   ADD HL,DE
 142  AAA9 7E                   LD A,(HL)
 143  AAAA                      ; config value 3 = a recognized/present device in this slot
 144  AAAA D6 03                SUB $03
 145  AAAC 20 07                JR NZ,PROBE_DEVICES_CHK4
 146  AAAE CD 60 AD             CALL SLOT_IO_ADDR
 147  AAB1                      ; rewrite the cell: $03 then $15 = mark this device configured
 148  AAB1 36 03                LD (HL),$03
 149  AAB3 36 15                LD (HL),$15
 150  AAB5              PROBE_DEVICES_CHK4:
 151  AAB5                      ; after the SUB, A==1 here means the original value was 4 (e.g. Videx-class console)
 152  AAB5 3D                   DEC A
 153  AAB6 20 09                JR NZ,PROBE_DEVICES_NEXT
 154  AAB8 CD EE AC             CALL SET_SCREEN_BASE
 155  AABB                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 156  AABB 21 00 C8             LD HL,$C800
 157  AABE CD 3B AB             CALL RPC_TRIGGER
 158  AAC1              PROBE_DEVICES_NEXT:
 159  AAC1                      ; next config entry; loop until all 7 scanned
 160  AAC1 1D                   DEC E
 161  AAC2 20 E1                JR NZ,PROBE_DEVICES_LOOP
 162  AAC4 C9                   RET
 163  AAC5              ; ----------------------------------------------------------------------
 164  AAC5              ; SLOT_IO_ADDR -- form a SoftCard I/O / soft-switch address from a slot/offset index.
 165  AAC5              ;   In:  E = low offset within the I/O page.
 166  AAC5              ;   Out: HL = $E0(E | $E0), i.e. an address in z80 $E000-$EFFF = Apple I/O
 167  AAC5              ;        $C000-$CFFF; A clobbered.
 168  AAC5              ;   Algorithm: H = $E0 base; A = E OR H so the high nibble forces the $C0xx I/O
 169  AAC5              ;        page, then H = A. Used to reach keyboard / soft switches / slot I/O. [RE]
 170  AAC5              ; ----------------------------------------------------------------------
 171  AAC5              DEVICE_IO_BASE:
 172  AAC5                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 173  AAC5 21 00 E0             LD HL,$E000
 174  AAC8 7B                   LD A,E
 175  AAC9                      ; force the high byte into the $C0xx I/O range
 176  AAC9 B4                   OR H
 177  AACA 67                   LD H,A
 178  AACB C9                   RET
 179  AACC              ; ----------------------------------------------------------------------
 180  AACC              ; WBOOT -- CP/M warm boot: re-initialize the console, rebuild page zero, re-enter CCP.
 181  AACC              ;   In:  none. Out: jumps to the CCP at $9400; does not return.
 182  AACC              ;   Clobbers: all.
 183  AACC              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 184  AACC              ;        (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 185  AACC              ;        the device probe; then PAGEZERO_REBUILD writes the standard CP/M page-zero
 186  AACC              ;        jumps and DMA and enters the CCP. [RE]
 187  AACC              ; ----------------------------------------------------------------------
 188  AACC              WBOOT:
 189  AACC                      ; stack at the default DMA buffer top (page-zero $0080)
 190  AACC 31 80 00             LD SP,$0080
 191  AACF                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 192  AACF 3A 51 E0             LD A,($E051)
 193  AAD2 21 00 0E             LD HL,$0E00
 194  AAD5                      ; re-init the console I/O vectors for warm restart
 195  AAD5                  IFDEF V220B
 196  AAD5 ~                    CALL WARMBOOT_INLEN_STUB         ; 2.20B: fire the RPC, then clear CCP_INLEN so warm boot drops any staged command
 197  AAD5                  ELSE
 198  AAD5 CD 3B AB             CALL RPC_TRIGGER
 199  AAD8                  ENDIF
 200  AAD8                      ; re-scan devices so warm boot rebuilds the I/O table
 201  AAD8 CD A2 AA             CALL PROBE_DEVICES
 202  AADB              ; ----------------------------------------------------------------------
 203  AADB              ; PAGEZERO_REBUILD -- write the standard CP/M page-zero vectors and enter the CCP.
 204  AADB              ;   In:  none. Out: tail-calls into CCP_MODE_FLAG / JP $9400 (the CCP); no return.
 205  AADB              ;   Clobbers: A,HL,BC.
 206  AADB              ;   Algorithm: clear two self-modified BIOS state cells; write JP ($C3) at $0000
 207  AADB              ;        pointing at the BIOS vector+3 (warm-boot entry, BIOS_VECTOR_WBOOT) and JP at
 208  AADB              ;        $0005 pointing at the BDOS entry $9C06; set the default DMA to $0080 via
 209  AADB              ;        SETDMA; then fall into the CCP-launch tail. [RE]
 210  AADB              ; ----------------------------------------------------------------------
 211  AADB              PAGEZERO_REBUILD:
 212  AADB AF                   XOR A
 213  AADC                      ; clear a self-modified BIOS console-state cell
 214  AADC 32 B4 AE             LD (DISK_WRTYPE+2),A
 215  AADF 32 AF AE             LD (DISK_SEKDSK+2),A
 216  AAE2                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 217  AAE2 3E C3                LD A,$C3
 218  AAE4                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 219  AAE4 32 00 00             LD ($0000),A
 220  AAE7                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 221  AAE7 21 03 AA             LD HL,BIOS_VECTOR_WBOOT
 222  AAEA 22 01 00             LD ($0001),HL
 223  AAED                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 224  AAED 32 05 00             LD ($0005),A
 225  AAF0                      ; BDOS entry point (BDOS_FBASE+6) for the $0005 hook
 226  AAF0 21 06 9C             LD HL,BDOS_FBASE+6
 227  AAF3 22 06 00             LD ($0006),HL
 228  AAF6                      ; default DMA address = $0080 (page-zero buffer)
 229  AAF6 01 80 00             LD BC,$0080
 230  AAF9                      ; install the default DMA pointer
 231  AAF9 CD 8E AD             CALL SETDMA
 232  AAFC              ; ----------------------------------------------------------------------
 233  AAFC              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag and jump to the CCP.
 234  AAFC              ;   In:  none. Out: JP $9400 (CCP cold/warm entry); no return.
 235  AAFC              ;   Clobbers: A,C.
 236  AAFC              ;   Algorithm: store a CCP-mode flag ($01) into $98B2, then pass the current default
 237  AAFC              ;        drive (page-zero $0004) in C and jump to the CCP at $9400.
 238  AAFC              ;   Self-modify: CCP_MODE_FLAG's immediate ($01) is patched elsewhere to alter the
 239  AAFC              ;        launch path; references therefore read CCP_MODE_FLAG+1. [RE]
 240  AAFC              ; ----------------------------------------------------------------------
 241  AAFC              CCP_MODE_FLAG:
 242  AAFC                      ; CCP-mode flag value (this immediate is self-modified elsewhere)
 243  AAFC 3E 01                LD A,$01
 244  AAFE                      ; store the CCP entry/mode flag into CCP workspace at CCP_ENTRY+$04B2 ($98B2)
 245  AAFE 32 B2 98             LD (CCP_ENTRY+$04B2),A
 246  AB01                      ; page-zero $0004 = current default drive byte
 247  AB01 3A 04 00             LD A,($0004)
 248  AB04 4F                   LD C,A
 249  AB05                      ; enter the CCP at CCP_ENTRY ($9400), C = default drive
 250  AB05 C3 00 94             JP CCP_ENTRY
 251  AB08              ; ----------------------------------------------------------------------
 252  AB08              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 253  AB08              ;   In:  none. Out: A = $FF (ready) / $00 (not). Clobbers: A,HL.
 254  AB08              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 255  AB08              ;        cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler,
 256  AB08              ;        which returns the status in A. [RE]
 257  AB08              ; ----------------------------------------------------------------------
 258  AB08              CONST:
 259  AB08                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 260  AB08 2A 80 F3             LD HL,($F380)
 261  AB0B                      ; dispatch to the selected console-status handler (returns A)
 262  AB0B E9                   JP (HL)
 263  AB0C              ; ----------------------------------------------------------------------
 264  AB0C              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 265  AB0C              ;   In:  none. Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 266  AB0C              ;   Clobbers: A.
 267  AB0C              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard data/strobe; RLA shifts bit 7
 268  AB0C              ;        (key-ready) into carry; SBC A,A expands carry to $FF/$00. This is the
 269  AB0C              ;        built-in 40-col path used when no Videx/80-col card supplies CONST. [RE]
 270  AB0C              ; ----------------------------------------------------------------------
 271  AB0C              KBD_STATUS_40COL:
 272  AB0C                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 273  AB0C 3A 00 E0             LD A,($E000)
 274  AB0F                      ; rotate key-ready bit 7 into carry
 275  AB0F 17                   RLA
 276  AB10                      ; carry -> A = $FF (ready) or $00 (none)
 277  AB10 9F                   SBC A,A
 278  AB11 C9                   RET
 279  AB12              ; ----------------------------------------------------------------------
 280  AB12              ; CONSOLE_IN_40COL -- CONIN for the built-in Apple keyboard (default console-input
 281  AB12              ; handler, installed into the I/O vector table). Waits for a key, then maps it through
 282  AB12              ; a small remap table (function/arrow keys) at Apple $03AB.
 283  AB12              ;   Out: A = (translated) key. Clobbers A,B,C,DE,HL.
 284  AB12              ; ----------------------------------------------------------------------
 285  AB12              CONSOLE_IN_40COL:
 286  AB12                  IFDEF V220B
 287  AB12 ~                    CALL CONIN                       ; 2.20B: get the char via the IOBYTE-routed dispatcher first
 288  AB12                  ELSE
 289  AB12 CD 29 AB             CALL CONIN_KEYWAIT               ; wait for a raw key in A
 290  AB15                  ENDIF
 291  AB15 21 AB F3             LD HL,$F3AB                      ; HL = key-remap table base (Apple $03AB; first entry pair at $03AC)
 292  AB18 06 06                LD B,$06                         ; up to 6 table entries
 293  AB1A 4F                   LD C,A                           ; C = raw key
 294  AB1B              CONIN_XLATE_LOOP:
 295  AB1B 23                   INC HL
 296  AB1C 7E                   LD A,(HL)                        ; entry's match byte
 297  AB1D 23                   INC HL
 298  AB1E B7                   OR A
 299  AB1F FA 27 AB             JP M,CONIN_XLATE_DONE            ; high-bit sentinel ends the table
 300  AB22 B9                   CP C                             ; raw key == this entry?
 301  AB23 7E                   LD A,(HL)                        ; paired replacement byte
 302  AB24 C8                   RET Z                            ; match -> return the translated key
 303  AB25 10 F4                DJNZ CONIN_XLATE_LOOP
 304  AB27              CONIN_XLATE_DONE:
 305  AB27 79                   LD A,C                           ; no match -> return the raw key
 306  AB28 C9                   RET
 307  AB29              CONIN_KEYWAIT:
 308  AB29 11 03 00             LD DE,$0003
 309  AB2C              CONIN_DISPATCH:
 310  AB2C C3 2F AB             JP KBD_WAIT_KEY                  ; target (CONIN_DISPATCH+1) patched at boot
 311  AB2F              KBD_WAIT_KEY:
 312  AB2F 3A 00 E0             LD A,($E000)                     ; poll Apple $C000 keyboard register
 313  AB32 17                   RLA                              ; key-ready (bit 7) -> carry
 314  AB33 30 FA                JR NC,KBD_WAIT_KEY               ; spin until a key is down
 315  AB35 32 10 E0             LD ($E010),A                     ; clear the keyboard strobe (Apple $C010)
 316  AB38 3F                   CCF
 317  AB39 1F                   RRA                              ; A = 7-bit key
 318  AB3A C9                   RET
 319  AB3B              ; ----------------------------------------------------------------------
 320  AB3B              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC: stash HL to the command mailbox at
 321  AB3B              ; Apple $03D0, then poke the trigger cell (its address is patched per config at boot).
 322  AB3B              ;   In: HL = command/params; A = trigger value. Out: per the 6502 service routine.
 323  AB3B              ; ----------------------------------------------------------------------
 324  AB3B              RPC_TRIGGER:
 325  AB3B 22 D0 F3             LD ($F3D0),HL
 326  AB3E              RPC_TRIGGER_STORE:
 327  AB3E 32 00 00             LD ($0000),A
 328  AB41 C9                   RET
 329  AB42              ; ----------------------------------------------------------------------
 330  AB42              ; CONOUT body -- emit a console character, routed by the CP/M IOBYTE.
 331  AB42              ;   In:  A = character (caller's CONOUT arg, moved to C here).
 332  AB42              ;   Out: none. Clobbers: A,C,HL.
 333  AB42              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03). If the
 334  AB42              ;              field selects device value 2 (CRT/console), dispatch through the SoftCard
 335  AB42              ;              I/O vector cell at $F392 (Apple $0392) with JP (HL). Otherwise fall into
 336  AB42              ;              the column-tracking / tab-expansion path (CONOUT_FILTER) which formats the
 337  AB42              ;              character before it reaches the physical screen handler. This is the body
 338  AB42              ;              reached from the BIOS jump-vector CONOUT entry. [RE]
 339  AB42              ; ----------------------------------------------------------------------
 340  AB42              CONOUT_DISPATCH:
 341  AB42                      ; save the character to emit in C for the filter path
 342  AB42 4F                   LD C,A
 343  AB43                      ; read the CP/M IOBYTE (page-zero $0003)
 344  AB43 3A 03 00             LD A,($0003)
 345  AB46                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 346  AB46 E6 03                AND $03
 347  AB48                      ; device value 2 = direct console; anything else takes the filter path
 348  AB48 FE 02                CP $02
 349  AB4A 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 350  AB4C              LIST_VIA_VEC_F392:
 351  AB4C                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 352  AB4C 2A 92 F3             LD HL,($F392)
 353  AB4F E9                   JP (HL)
 354  AB50              ; ----------------------------------------------------------------------
 355  AB50              ; CONIN -- read a console character, routed by the IOBYTE CONSOLE field.
 356  AB50              ;   In:  none. Out: A = character. Clobbers: A,HL.
 357  AB50              ;   Algorithm: read IOBYTE, mask CONSOLE field (AND $03), and select one of three
 358  AB50              ;              input-handler vector cells by the field value: value 2 uses $F38A, value 3
 359  AB50              ;              ($02<x) uses the already-loaded $F384, the low values use $F382; then
 360  AB50              ;              JP (HL) into the chosen handler. ($F38x = Apple $038x I/O vector.) [RE]
 361  AB50              ; ----------------------------------------------------------------------
 362  AB50              CONIN:
 363  AB50 3A 03 00             LD A,($0003)
 364  AB53 E6 03                AND $03
 365  AB55 FE 02                CP $02
 366  AB57                      ; preload input-handler vector for the high CONSOLE field value ($F384 = Apple $0384)
 367  AB57 2A 84 F3             LD HL,($F384)
 368  AB5A 28 06                JR Z,CONIN_VIA_VEC_F38A
 369  AB5C 30 07                JR NC,DISPATCH_VIA_HL
 370  AB5E              CONIN_VIA_VEC_F382:
 371  AB5E                      ; input-handler vector for the low CONSOLE field values ($F382 = Apple $0382)
 372  AB5E 2A 82 F3             LD HL,($F382)
 373  AB61 E9                   JP (HL)
 374  AB62              CONIN_VIA_VEC_F38A:
 375  AB62                      ; input-handler vector for CONSOLE field value 2 ($F38A = Apple $038A)
 376  AB62 2A 8A F3             LD HL,($F38A)
 377  AB65              DISPATCH_VIA_HL:
 378  AB65 E9                   JP (HL)
 379  AB66              ; ----------------------------------------------------------------------
 380  AB66              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 381  AB66              ;   In:  C = character. Out: none. Clobbers: A,HL.
 382  AB66              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0). Field value below
 383  AB66              ;              $80 routes to the column/tab filter (CONOUT_FILTER); value == $80 reuses
 384  AB66              ;              the console vector path (LIST_VIA_VEC_F392); higher values dispatch through
 385  AB66              ;              the list-handler vector cell $F394 (Apple $0394). [RE]
 386  AB66              ; ----------------------------------------------------------------------
 387  AB66              LIST:
 388  AB66 3A 03 00             LD A,($0003)
 389  AB69                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 390  AB69 E6 C0                AND $C0
 391  AB6B FE 80                CP $80
 392  AB6D 38 27                JR C,CONOUT_FILTER
 393  AB6F 28 DB                JR Z,LIST_VIA_VEC_F392
 394  AB71                      ; load list-handler vector ($F394 = Apple $0394)
 395  AB71 2A 94 F3             LD HL,($F394)
 396  AB74 E9                   JP (HL)
 397  AB75              ; ----------------------------------------------------------------------
 398  AB75              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 399  AB75              ;   In:  C = character. Out: none. Clobbers: A,HL.
 400  AB75              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30). Field value below $10 takes
 401  AB75              ;              the column/tab filter; value $10 dispatches through vector $F390; higher
 402  AB75              ;              values dispatch through vector $F38E. ($F38E/$F390 = Apple $038E/$0390.) [RE]
 403  AB75              ; ----------------------------------------------------------------------
 404  AB75              PUNCH:
 405  AB75 3A 03 00             LD A,($0003)
 406  AB78                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 407  AB78 E6 30                AND $30
 408  AB7A FE 10                CP $10
 409  AB7C 38 18                JR C,CONOUT_FILTER
 410  AB7E                      ; punch-handler vector for the higher PUNCH field values ($F38E = Apple $038E)
 411  AB7E 2A 8E F3             LD HL,($F38E)
 412  AB81 20 E2                JR NZ,DISPATCH_VIA_HL
 413  AB83                      ; punch-handler vector for PUNCH field value $10 ($F390 = Apple $0390)
 414  AB83 2A 90 F3             LD HL,($F390)
 415  AB86 E9                   JP (HL)
 416  AB87              ; ----------------------------------------------------------------------
 417  AB87              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 418  AB87              ;   In:  none. Out: A = character. Clobbers: A,HL.
 419  AB87              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C). Field value below $04
 420  AB87              ;              reuses the CONIN low-value vector path; value $04 reuses the CONIN $F38A
 421  AB87              ;              path; higher values dispatch through reader vector $F38C (Apple $038C). [RE]
 422  AB87              ; ----------------------------------------------------------------------
 423  AB87              READER:
 424  AB87 3A 03 00             LD A,($0003)
 425  AB8A                      ; isolate the 2-bit READER device field of the IOBYTE
 426  AB8A E6 0C                AND $0C
 427  AB8C FE 04                CP $04
 428  AB8E 38 CE                JR C,CONIN_VIA_VEC_F382
 429  AB90 28 D0                JR Z,CONIN_VIA_VEC_F38A
 430  AB92                      ; load reader-handler vector ($F38C = Apple $038C)
 431  AB92 2A 8C F3             LD HL,($F38C)
 432  AB95 E9                   JP (HL)
 433  AB96              ; ----------------------------------------------------------------------
 434  AB96              ; CONOUT_FILTER -- column-tracking and tab/control formatting for console output.
 435  AB96              ;   In:  C = character; entered from CONOUT/LIST/PUNCH when the IOBYTE field selects the
 436  AB96              ;        filtered (non-raw) path. A carry/expand flag is set by the entry stub.
 437  AB96              ;   Out: none; emits 0..N physical characters via the screen handler (SCREEN_EMIT).
 438  AB96              ;   Clobbers: A,B,C,D,E,HL.
 439  AB96              ;   Algorithm: SCF then SBC A,A turns the carry into a 0/$FF flag stored in COL_FLAG.
 440  AB96              ;        Clear bit 7 of the character. If a pending-column-skip counter (COL_PENDING) is
 441  AB96              ;        nonzero, decrement it and reposition using config byte $F396 (Apple $0396) plus
 442  AB96              ;        the BOOT-overlaid base word, otherwise fall through to TAB_EXPAND. This is the
 443  AB96              ;        console output formatter; the two CONOUT_FILTER/_10 labels are the carry-set and
 444  AB96              ;        carry-clear entry points to the same body. [RE]
 445  AB96              ; ----------------------------------------------------------------------
 446  AB96              CONOUT_FILTER:
 447  AB96                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 448  AB96 37                   SCF
 449  AB97              CONOUT_FILTER_NOEXPAND:
 450  AB97                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 451  AB97 9F                   SBC A,A
 452  AB98 21 A2 AE             LD HL,COL_FLAG
 453  AB9B                      ; store the entry flag into COL_FLAG
 454  AB9B 77                   LD (HL),A
 455  AB9C                      ; strip the high bit of the character (7-bit ASCII)
 456  AB9C CB B9                RES 7,C
 457  AB9E 23                   INC HL
 458  AB9F                      ; load COL_PENDING (pending column-skip / fill count)
 459  AB9F 7E                   LD A,(HL)
 460  ABA0 B7                   OR A
 461  ABA1                      ; no pending column work -> go run tab/control expansion
 462  ABA1 28 3D                JR Z,TAB_EXPAND
 463  ABA3                      ; consume one pending column step
 464  ABA3 35                   DEC (HL)
 465  ABA4                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 466  ABA4 3A 96 F3             LD A,($F396)
 467  ABA7 21 AB AE             LD HL,DISK_SELDSK_SAVE
 468  ABAA 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 469  ABAC B7                   OR A
 470  ABAD F2 B3 AB             JP P,COL_APPLY_OFFSET_RAW
 471  ABB0 2B                   DEC HL
 472  ABB1              ; ----------------------------------------------------------------------
 473  ABB1              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 474  ABB1              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 475  ABB1              ;   Out: (HL) = C - offset. Clobbers: A,E.
 476  ABB1              ;   Algorithm: mask off the sign bit (AND $7F) to get the magnitude, subtract it from the
 477  ABB1              ;        current column in C, and store the new column. Reached when the config byte's
 478  ABB1              ;        sign indicates a simple subtractive column adjust. [RE]
 479  ABB1              ; ----------------------------------------------------------------------
 480  ABB1              COL_APPLY_OFFSET:
 481  ABB1                      ; drop the sign bit to get the offset magnitude
 482  ABB1 E6 7F                AND $7F
 483  ABB3              COL_APPLY_OFFSET_RAW:
 484  ABB3 5F                   LD E,A
 485  ABB4 79                   LD A,C
 486  ABB5                      ; new column = current column (C) minus the offset
 487  ABB5 93                   SUB E
 488  ABB6                      ; store the updated column position
 489  ABB6 77                   LD (HL),A
 490  ABB7 C9                   RET
 491  ABB8              COL_OFFSET_FROM_WIDTH:
 492  ABB8 B7                   OR A
 493  ABB9 FA BD AB             JP M,COL_OFFSET_FROM_WIDTH_1
 494  ABBC 2B                   DEC HL
 495  ABBD              COL_OFFSET_FROM_WIDTH_1:
 496  ABBD CD B1 AB             CALL COL_APPLY_OFFSET
 497  ABC0 2A AA AE             LD HL,(BOOT+2)
 498  ABC3 3A A1 F3             LD A,($F3A1)
 499  ABC6 B7                   OR A
 500  ABC7 F2 CF AB             JP P,COL_COMBINE_BASE
 501  ABCA E6 7F                AND $7F
 502  ABCC 5D                   LD E,L
 503  ABCD 6C                   LD L,H
 504  ABCE 63                   LD H,E
 505  ABCF              COL_COMBINE_BASE:
 506  ABCF 5F                   LD E,A
 507  ABD0 84                   ADD A,H
 508  ABD1 4F                   LD C,A
 509  ABD2 7B                   LD A,E
 510  ABD3 85                   ADD A,L
 511  ABD4 F5                   PUSH AF
 512  ABD5 06 07                LD B,$07
 513  ABD7 CD 2D AC             CALL SCREEN_EMIT
 514  ABDA F1                   POP AF
 515  ABDB 06 0A                LD B,$0A
 516  ABDD              ; ----------------------------------------------------------------------
 517  ABDD              ; CONOUT_EMIT_B -- emit character C, then route to TAB_EXPAND/SCREEN_EMIT with B as mode.
 518  ABDD              ;   In:  A = character to emit; B = mode/count code.
 519  ABDD              ;   Out: none. Clobbers: A,C.
 520  ABDD              ;   Algorithm: move A into C and fall through to SCREEN_EMIT (SCREEN_EMIT) carrying the B
 521  ABDD              ;        mode code. Tail-shared helper used by the column/tab logic to push a character
 522  ABDD              ;        to the physical screen handler. [RE]
 523  ABDD              ; ----------------------------------------------------------------------
 524  ABDD              CONOUT_EMIT_B:
 525  ABDD                      ; move the character into C for the screen emit path
 526  ABDD 4F                   LD C,A
 527  ABDE 18 4D                JR SCREEN_EMIT
 528  ABE0              ; ----------------------------------------------------------------------
 529  ABE0              ; TAB_EXPAND -- expand tabs / handle special columns against the tab-stop config table.
 530  ABE0              ;   In:  C = character (already 7-bit); B = passed from caller.
 531  ABE0              ;   Out: none; may emit fill characters and update the column state. Clobbers: A,B,C,D,E,HL.
 532  ABE0              ;   Algorithm: COL_STATE (COL_STATE) holds a sticky control state. If zero, compare the
 533  ABE0              ;        character against config byte $F397 (Apple $0397, a special trigger char); a match
 534  ABE0              ;        arms the sticky state ($80). Printable characters above $1F scan the 9-entry tab
 535  ABE0              ;        config table at $F3A0 (Apple $03A0, walked downward) for a matching stop; on a hit
 536  ABE0              ;        it indexes +$0B into a parallel table for the action byte, optionally recursing
 537  ABE0              ;        with config $F3A2 to emit a secondary character. A B==7 result sets COL_MODE
 538  ABE0              ;        (COL_PENDING) = 2. Falls through to SCREEN_EMIT for the actual output. [RE]
 539  ABE0              ; ----------------------------------------------------------------------
 540  ABE0              TAB_EXPAND:
 541  ABE0 47                   LD B,A
 542  ABE1                      ; HL -> COL_STATE sticky control-state cell
 543  ABE1 21 A4 AE             LD HL,COL_STATE
 544  ABE4 7E                   LD A,(HL)
 545  ABE5 5F                   LD E,A
 546  ABE6 B7                   OR A
 547  ABE7 20 11                JR NZ,TAB_TABLE_SCAN
 548  ABE9                      ; read the special trigger character from config ($F397 = Apple $0397)
 549  ABE9 3A 97 F3             LD A,($F397)
 550  ABEC B7                   OR A
 551  ABED 28 06                JR Z,TAB_EXPAND_CHECK_CTRL
 552  ABEF                      ; does the current character match the trigger?
 553  ABEF B9                   CP C
 554  ABF0 20 03                JR NZ,TAB_EXPAND_CHECK_CTRL
 555  ABF2                      ; arm the sticky control state for the next character
 556  ABF2 36 80                LD (HL),$80
 557  ABF4 C9                   RET
 558  ABF5              TAB_EXPAND_CHECK_CTRL:
 559  ABF5                      ; control-char threshold: chars <= $1F are not table-scanned
 560  ABF5 3E 1F                LD A,$1F
 561  ABF7 B9                   CP C
 562  ABF8 38 33                JR C,SCREEN_EMIT
 563  ABFA              TAB_TABLE_SCAN:
 564  ABFA                      ; HL -> top of the 9-entry tab-stop config table ($F3A0 = Apple $03A0)
 565  ABFA 21 A0 F3             LD HL,$F3A0
 566  ABFD                      ; 9 tab-stop table entries to scan
 567  ABFD 06 09                LD B,$09
 568  ABFF              TAB_TABLE_SCAN_LOOP:
 569  ABFF 7E                   LD A,(HL)
 570  AC00 B7                   OR A
 571  AC01 28 04                JR Z,TAB_TABLE_SCAN_NEXT
 572  AC03                      ; fold in COL_STATE before comparing the table entry to the char
 573  AC03 AB                   XOR E
 574  AC04 B9                   CP C
 575  AC05 28 05                JR Z,TAB_TABLE_HIT
 576  AC07              TAB_TABLE_SCAN_NEXT:
 577  AC07 2B                   DEC HL
 578  AC08 10 F5                DJNZ TAB_TABLE_SCAN_LOOP
 579  AC0A 18 21                JR SCREEN_EMIT
 580  AC0C              TAB_TABLE_HIT:
 581  AC0C                      ; step +$0B from the matched stop to its parallel action byte
 582  AC0C 11 0B 00             LD DE,$000B
 583  AC0F 19                   ADD HL,DE
 584  AC10 7E                   LD A,(HL)
 585  AC11 B7                   OR A
 586  AC12 4F                   LD C,A
 587  AC13 F2 23 AC             JP P,TAB_EXPAND_DONE
 588  AC16 E6 7F                AND $7F
 589  AC18 4F                   LD C,A
 590  AC19 C5                   PUSH BC
 591  AC1A                      ; secondary action character from config ($F3A2 = Apple $03A2)
 592  AC1A 3A A2 F3             LD A,($F3A2)
 593  AC1D 06 07                LD B,$07
 594  AC1F CD DD AB             CALL CONOUT_EMIT_B
 595  AC22 C1                   POP BC
 596  AC23              TAB_EXPAND_DONE:
 597  AC23 78                   LD A,B
 598  AC24                      ; action code 7 -> set COL_MODE = 2
 599  AC24 FE 07                CP $07
 600  AC26 20 05                JR NZ,SCREEN_EMIT
 601  AC28 3E 02                LD A,$02
 602  AC2A                      ; record COL_MODE = 2 for the next emit
 603  AC2A 32 A3 AE             LD (COL_PENDING),A
 604  AC2D              ; ----------------------------------------------------------------------
 605  AC2D              ; CONOUT_VIA_SCREEN -- emit one character to the Apple text screen, then advance
 606  AC2D              ; the cursor and redraw it.
 607  AC2D              ;   In:  the pending character is taken from the screen-driver state cells, not from
 608  AC2D              ;        a register here (SCREEN_CHAR holds the char-under-cursor; the caller has
 609  AC2D              ;        already staged the glyph). B = control-code selector for CTRL_CHAR_DISPATCH.
 610  AC2D              ;   Out: none. Clobbers: A,DE,HL.
 611  AC2D              ;   Algorithm: clear the wrap/scroll flag (COL_STATE), then vector through one of
 612  AC2D              ;              two screen-driver entry points selected by COL_FLAG (modeled in
 613  AC2D              ;              $F386/$F388 = Apple $0386/$0388 of the SoftCard I/O vector table).
 614  AC2D              ;              [RE] COL_FLAG selects 40-col vs 80-col / normal vs alternate path.
 615  AC2D              ; ----------------------------------------------------------------------
 616  AC2D              SCREEN_EMIT:
 617  AC2D AF                   XOR A
 618  AC2E                      ; clear the pending wrap/scroll flag before emitting
 619  AC2E                      ; clear COL_STATE before handing off to the screen handler
 620  AC2E 32 A4 AE             LD (COL_STATE),A
 621  AC31                      ; screen-mode selector: chooses which driver entry to vector to [RE]
 622  AC31                      ; test COL_FLAG to choose which screen-output vector to use
 623  AC31 3A A2 AE             LD A,(COL_FLAG)
 624  AC34 B7                   OR A
 625  AC35                      ; default screen-driver entry (SoftCard vector table, Apple $0388)
 626  AC35                      ; default screen-output vector ($F388 = Apple $0388)
 627  AC35 2A 88 F3             LD HL,($F388)
 628  AC38 28 03                JR Z,SCREEN_EMIT_VECTOR
 629  AC3A                      ; alternate screen-driver entry (Apple $0386) when selector nonzero
 630  AC3A                      ; alternate screen-output vector ($F386 = Apple $0386)
 631  AC3A 2A 86 F3             LD HL,($F386)
 632  AC3D              ; ----------------------------------------------------------------------
 633  AC3D              ; Merge point: HL = the selected screen-driver entry; fall through to the JP (HL).
 634  AC3D              ; ----------------------------------------------------------------------
 635  AC3D              SCREEN_EMIT_VECTOR:
 636  AC3D                      ; tail-jump into the selected screen-driver entry point
 637  AC3D E9                   JP (HL)
 638  AC3E              ; ----------------------------------------------------------------------
 639  AC3E              ; PUT_CHAR_DE3 -- screen-driver entry that preloads DE=3 (advance amount / column
 640  AC3E              ; step) and falls into the glyph-store path. [RE]
 641  AC3E              ;   In:  driver state cells as set up by CONOUT_VIA_SCREEN.
 642  AC3E              ;   Out: none. Clobbers: A,DE,HL.
 643  AC3E              ; ----------------------------------------------------------------------
 644  AC3E              PUT_CHAR_DE3:
 645  AC3E                      ; preset DE = column/advance step for this driver variant [RE]
 646  AC3E 11 03 00             LD DE,$0003
 647  AC41              ; ----------------------------------------------------------------------
 648  AC41              ; PUT_CHAR_VECTOR -- indirect entry into the glyph-store body. This JP's target
 649  AC41              ; operand is SELF-MODIFIED elsewhere (patch site = PUT_CHAR_VECTOR+1); it normally
 650  AC41              ; points at PUT_CHAR_STORE. Treat the +1/+2 bytes as the live dispatch target. [RE]
 651  AC41              ; ----------------------------------------------------------------------
 652  AC41              PUT_CHAR_VECTOR:
 653  AC41                      ; dispatch into the glyph-store body; target operand (PUT_CHAR_VECTOR+1) is patched at
 654  AC41                      ; runtime [RE]
 655  AC41 C3 44 AC             JP PUT_CHAR_STORE
 656  AC44              ; ----------------------------------------------------------------------
 657  AC44              ; PUT_CHAR_STORE -- store the current glyph at the cursor cell, recompute the cursor
 658  AC44              ; screen address from CH/BASL, read back the char now under the cursor, and write it
 659  AC44              ; as the inverse/cursor glyph.
 660  AC44              ;   In:  SCREEN_CURSOR_PTR = current cursor screen pointer; SCREEN_CHAR = glyph to store.
 661  AC44              ;   Out: SCREEN_CURSOR_PTR/SCREEN_CHAR updated to the new cursor cell + char under it.
 662  AC44              ;        Clobbers: A,DE,HL.
 663  AC44              ;   Algorithm: write staged glyph to old cursor cell; run the control-char handler
 664  AC44              ;              (CTRL_CHAR_DISPATCH) which may move CH; recompute the cell address as
 665  AC44              ;              BASL + CH ($F028/$F024 = Apple $0028/$0024); save char under cursor;
 666  AC44              ;              convert it to the inverse-video cursor glyph and store it. [RE]
 667  AC44              ; ----------------------------------------------------------------------
 668  AC44              PUT_CHAR_STORE:
 669  AC44                      ; HL = saved cursor screen pointer (cell holding the cursor)
 670  AC44 2A A5 AE             LD HL,(SCREEN_CURSOR_PTR)
 671  AC47                      ; A = staged glyph (the real char that belongs in that cell)
 672  AC47 3A A7 AE             LD A,(SCREEN_CHAR)
 673  AC4A                      ; draw the inverse-video cursor glyph in the new cell
 674  AC4A                      ; restore the real char into the old cursor cell
 675  AC4A 77                   LD (HL),A
 676  AC4B                      ; run control-char handling / cursor advance (may update CH=$F024)
 677  AC4B CD 6B AC             CALL CTRL_CHAR_DISPATCH
 678  AC4E                      ; HL = current text line base BASL/BASH (Apple ZP $0028/$0029)
 679  AC4E 2A 28 F0             LD HL,($F028)
 680  AC51                      ; A = cursor column CH (Apple ZP $0024)
 681  AC51 3A 24 F0             LD A,($F024)
 682  AC54 5F                   LD E,A
 683  AC55                      ; high byte $F0 maps column offset into the Apple low-RAM screen region
 684  AC55 16 F0                LD D,$F0
 685  AC57                      ; HL = BASL + CH = address of the new cursor cell
 686  AC57 19                   ADD HL,DE
 687  AC58                      ; save the new cursor cell pointer
 688  AC58 22 A5 AE             LD (SCREEN_CURSOR_PTR),HL
 689  AC5B 7E                   LD A,(HL)
 690  AC5C                      ; save the char currently under the cursor (to restore later)
 691  AC5C 32 A7 AE             LD (SCREEN_CHAR),A
 692  AC5F                      ; is the char in the lowercase/high range? choose inverse-video mapping
 693  AC5F FE E0                CP $E0
 694  AC61 38 02                JR C,PUT_CHAR_CURSOR_GLYPH
 695  AC63                      ; fold lowercase to its display form for the cursor glyph
 696  AC63 EE 20                XOR $20
 697  AC65              ; ----------------------------------------------------------------------
 698  AC65              ; Merge point in the cursor-glyph conversion (chars below $E0 skip the XOR $20 fold).
 699  AC65              ; ----------------------------------------------------------------------
 700  AC65              PUT_CHAR_CURSOR_GLYPH:
 701  AC65                      ; mask to 6-bit glyph code
 702  AC65 E6 3F                AND $3F
 703  AC67                      ; set inverse/flash field for the on-screen cursor glyph
 704  AC67 F6 40                OR $40
 705  AC69 77                   LD (HL),A
 706  AC6A C9                   RET
 707  AC6B              ; ----------------------------------------------------------------------
 708  AC6B              ; CTRL_CHAR_DISPATCH -- handle a control character / cursor-motion code by indexing a
 709  AC6B              ; per-code offset table and jumping to the matching handler body.
 710  AC6B              ;   In:  B = control-code index (0 = none/plain char). A is loaded from B.
 711  AC6B              ;   Out: per-handler (typically updates CH=$F024 and/or the line base). Clobbers A,HL.
 712  AC6B              ;   Algorithm: if B==0 fall through to the plain-character handler at CTRL_PLAIN_CHAR. Else
 713  AC6B              ;              push the RET address RPC_TRIGGER (each handler RETs back through it), load
 714  AC6B              ;              HL = CTRL_HANDLER_OFFSET_TBL, add the code to L, read the handler's low byte
 715  AC6B              ;              from the table (high byte stays $AC), and JP (HL) into the handler body. The
 716  AC6B              ;              handlers set HL to an Apple monitor routine address and RET (the caller fires
 717  AC6B              ;              the 6502 RPC), or update the cursor cells (CH/CV at Apple ZP $0024/$0025)
 718  AC6B              ;              directly. See CTRL_HANDLER_OFFSET_TBL for the code -> handler mapping.
 719  AC6B              ; ----------------------------------------------------------------------
 720  AC6B              CTRL_CHAR_DISPATCH:
 721  AC6B                      ; A = control-code index passed in B
 722  AC6B 78                   LD A,B
 723  AC6C                      ; index 0 means plain character: fall through to CTRL_PLAIN_CHAR
 724  AC6C B7                   OR A
 725  AC6D                      ; no control code: take the plain-char store path
 726  AC6D 28 0B                JR Z,CTRL_PLAIN_CHAR
 727  AC6F                      ; push the common return address so each handler RETs back here [RE]
 728  AC6F 21 3B AB             LD HL,RPC_TRIGGER
 729  AC72 E5                   PUSH HL
 730  AC73                      ; HL = base of the per-code handler offset table
 731  AC73 21 D4 AC             LD HL,CTRL_HANDLER_OFFSET_TBL
 732  AC76                      ; index the table: L = table_base_low + control-code; (HL) then holds the handler low byte
 733  AC76                      ; [RE]
 734  AC76 85                   ADD A,L
 735  AC77                      ; dispatch tail: L = table base low + control code; fetch the handler low byte
 736  AC77                      ; (high byte stays $AC) and jump to it.
 737  AC77 6F                   LD L,A
 738  AC78 6E                   LD L,(HL)                        ; 6E  L = CTRL_HANDLER_OFFSET_TBL[code]
 739  AC79 E9                   JP (HL)                          ; E9  enter the handler in page $AC
 740  AC7A              ; CTRL_PLAIN_CHAR -- store a printable character (or handle CR) on the text screen.
 741  AC7A              CTRL_PLAIN_CHAR:
 742  AC7A 79                   LD A,C
 743  AC7B FE 0D                CP $0D                           ; carriage return?
 744  AC7D 20 05                JR NZ,CTRL_PLAIN_PUT
 745  AC7F AF                   XOR A
 746  AC80 32 24 F0             LD ($F024),A                     ; CR: reset cursor column CH (Apple ZP $0024)
 747  AC83 C9                   RET
 748  AC84              CTRL_PLAIN_PUT:
 749  AC84 F6 80                OR $80                           ; set high bit (Apple screen glyph)
 750  AC86 FE E0                CP $E0                           ; in the lowercase range?
 751  AC88 38 04                JR C,CTRL_PLAIN_STORE
 752  AC8A 21 DD F3             LD HL,$F3DD                      ; case-fold config byte (Apple $03DD)
 753  AC8D AE                   XOR (HL)
 754  AC8E              CTRL_PLAIN_STORE:
 755  AC8E 32 45 F0             LD ($F045),A                     ; stash the glyph (Apple ZP $0045)
 756  AC91 21 F0 FD             LD HL,$FDF0                      ; HL = Apple monitor COUT1 ($FDF0) for the 6502 RPC
 757  AC94 18 79                JR PLOT_RPC_TAIL                 ; emit via the shared RPC tail
 758  AC96              ; --- control-code handlers (entered via the offset table; each RETs through RPC_TRIGGER) ---
 759  AC96              CTRL_VIDEO_NORMAL:                       ; code 4: select normal video
 760  AC96 3E FF                LD A,$FF
 761  AC98 01                   DEFB    $01                      ; cover (LD BC,nn): skips the LD A,$3F below
 762  AC99              CTRL_VIDEO_INVERSE:                      ; code 5: select inverse video
 763  AC99 3E 3F                LD A,$3F
 764  AC9B 32 32 F0             LD ($F032),A                     ; INVFLG (Apple ZP $0032): $FF = normal, $3F = inverse
 765  AC9E              CTRL_POP_RET:                            ; code 7: discard the pushed return and exit
 766  AC9E E1                   POP HL
 767  AC9F C9                   RET
 768  ACA0              CTRL_CURSOR_RIGHT:                       ; code 9: cursor right
 769  ACA0 21 F4 FB             LD HL,$FBF4                      ; HL = Apple monitor ADVANCE ($FBF4) for the RPC
 770  ACA3 C9                   RET
 771  ACA4              CTRL_HOME_CURSOR:                        ; code 6: home the cursor (CH/CV = 0)
 772  ACA4 AF                   XOR A
 773  ACA5 6F                   LD L,A
 774  ACA6 67                   LD H,A
 775  ACA7 22 24 F0             LD ($F024),HL                    ; Apple ZP $0024/$0025 (CH/CV) = (0,0)
 776  ACAA              CTRL_BASCAL2:
 777  ACAA 32 45 F0             LD ($F045),A
 778  ACAD 21 C1 FB             LD HL,$FBC1                      ; HL = Apple monitor BASCAL2 ($FBC1, line-base calc) for the RPC
 779  ACB0 C9                   RET
 780  ACB1              CTRL_CLREOP:                             ; code 2: clear to end of page -> $FC42 CLREOP
 781  ACB1 2E 42                LD L,$42
 782  ACB3 01                   DEFB    $01                      ; cover: skips the LD L,$9C below
 783  ACB4              CTRL_CLREOL:                             ; code 3: clear to end of line -> $FC9C CLREOL
 784  ACB4 2E 9C                LD L,$9C
 785  ACB6 01                   DEFB    $01                      ; cover: skips the LD L,$1A below
 786  ACB7              CTRL_CURSOR_UP:                          ; code 8: cursor up -> $FC1A UP
 787  ACB7 2E 1A                LD L,$1A
 788  ACB9 01                   DEFB    $01                      ; cover: skips the LD L,$58 below
 789  ACBA              CTRL_CLR_HOME:                           ; code 1: clear screen + home -> $FC58 HOME
 790  ACBA 2E 58                LD L,$58
 791  ACBC 26 FC                LD H,$FC                         ; HL = Apple monitor routine in page $FC (per the L above)
 792  ACBE C9                   RET
 793  ACBF              CTRL_CLAMP_CURSOR:                       ; code 10: clamp the saved cursor to 40x24 and store it
 794  ACBF 2A AA AE             LD HL,(BOOT+2)                   ; load saved cursor col/row (BOOT+2 cell)
 795  ACC2 7D                   LD A,L
 796  ACC3 FE 28                CP $28                           ; column >= 40?
 797  ACC5 38 02                JR C,CTRL_CLAMP_ROW
 798  ACC7 2E 00                LD L,$00                         ; clamp column to 0
 799  ACC9              CTRL_CLAMP_ROW:
 800  ACC9 7C                   LD A,H
 801  ACCA FE 18                CP $18                           ; row >= 24?
 802  ACCC 38 02                JR C,CTRL_CLAMP_STORE
 803  ACCE 26 00                LD H,$00                         ; clamp row to 0
 804  ACD0              CTRL_CLAMP_STORE:
 805  ACD0 22 24 F0             LD ($F024),HL                    ; store cursor (Apple ZP $0024/$0025)
 806  ACD3 18                   DEFB    $18                      ; JR opcode; its offset is the table[0] byte below
 807  ACD4                                                       ;        ($D5 = -43 -> CTRL_BASCAL2)
 808  ACD4              CTRL_HANDLER_OFFSET_TBL:
 809  ACD4                      ; low byte of each control-code handler (high byte $AC); indexed by control code
 810  ACD4                      ; 1..10. Entry [0]=$D5 doubles as the JR offset above (code 0 never dispatches here;
 811  ACD4                      ; it falls through to CTRL_PLAIN_CHAR earlier).
 812  ACD4                      ; -> [0]=JR-offset, COL_58, COL_42, COL_9C, MODE_FF, MODE_3F, HOME, POP_RET, COL_1A,
 813  ACD4                      ;    RPC_FBF4, CLAMP
 814  ACD4 D5 BA B1 B4          DEFB    $D5,$BA,$B1,$B4,$96,$99,$A4,$9E,$B7,$A0,$BF
 814  ACD8 96 99 A4 9E
 814  ACDC B7 A0 BF
 815  ACDF              ; DEV_STROBE_RD -- device handler: poll a status bit at the slot I/O base, then strobe.
 816  ACDF              DEV_STROBE_RD:
 817  ACDF CD 60 AD             CALL SLOT_IO_ADDR                ; HL = slot I/O base for the device
 818  ACE2              DEV_STROBE_WAIT:
 819  ACE2 7E                   LD A,(HL)
 820  ACE3 E6 02                AND $02                          ; wait for the ready bit
 821  ACE5 28 FB                JR Z,DEV_STROBE_WAIT
 822  ACE7 2C                   INC L
 823  ACE8 71                   LD (HL),C                        ; hand the byte to the device
 824  ACE9 C9                   RET
 825  ACEA              ; ----------------------------------------------------------------------
 826  ACEA              ; SET_CURSOR_COL_AND_BASE -- set the cursor column from C, then compute the screen
 827  ACEA              ; line base address for the current row.
 828  ACEA              ;   In:  C = cursor column. Row state read inside SLOT_IO_ADDR_W.
 829  ACEA              ;   Out: CH=$F045 set; falls through to SET_SCREEN_BASE. Clobbers A,HL (per AD5B).
 830  ACEA              ;   Algorithm: store C to the column cell (Apple $0045), then fall into the base
 831  ACEA              ;              computation. [RE]
 832  ACEA              ; ----------------------------------------------------------------------
 833  ACEA              SET_CURSOR_COL_AND_BASE:
 834  ACEA                      ; A = requested cursor column from C
 835  ACEA 79                   LD A,C
 836  ACEB                      ; store cursor column (Apple ZP $0045) [RE]
 837  ACEB 32 45 F0             LD ($F045),A
 838  ACEE              ; ----------------------------------------------------------------------
 839  ACEE              ; SET_SCREEN_BASE -- compute the text-line base address for the current cursor row
 840  ACEE              ; and stash its parts in the Apple ZP screen-base cells.
 841  ACEE              ;   In:  row state (consumed by SLOT_IO_ADDR_W).
 842  ACEE              ;   Out: A = char under cursor (from (HL)); $F6F8/$F045/$F046/$F047 updated.
 843  ACEE              ;        Clobbers A,HL.
 844  ACEE              ;   Algorithm: call SLOT_IO_ADDR_W to derive the row base, store it to the scratch cell
 845  ACEE              ;              $F6F8 (Apple $06F8) and to $F047 (Apple $0047); read a column from the
 846  ACEE              ;              SoftCard I/O region $EFFF (Apple $CFFF), normalize via DEVICE_IO_BASE,
 847  ACEE              ;              subtract a space ($20) bias, store to $F046, and return char-under-
 848  ACEE              ;              cursor in A. [RE] exact roles of $F045/$F046/$F047 = BASL/BASH/col.
 849  ACEE              ; ----------------------------------------------------------------------
 850  ACEE              SET_SCREEN_BASE:
 851  ACEE                      ; derive the text-line base address for the current row
 852  ACEE CD 5B AD             CALL SLOT_IO_ADDR_W
 853  ACF1                      ; save base into scratch cell (Apple $06F8)
 854  ACF1 32 F8 F6             LD ($F6F8),A
 855  ACF4                      ; store base into a screen-base cell (Apple ZP $0047)
 856  ACF4 32 47 F0             LD ($F047),A
 857  ACF7                      ; read a column/value from SoftCard I/O ($EFFF = Apple $CFFF) [RE]
 858  ACF7 3A FF EF             LD A,($EFFF)
 859  ACFA CD C5 AA             CALL DEVICE_IO_BASE
 860  ACFD                      ; remove the space ($20) bias to get a screen offset [RE]
 861  ACFD D6 20                SUB $20
 862  ACFF                      ; store the computed offset into a screen-base cell (Apple ZP $0046)
 863  ACFF 32 46 F0             LD ($F046),A
 864  AD02                      ; return the character currently at the computed cell
 865  AD02 7E                   LD A,(HL)
 866  AD03 C9                   RET
 867  AD04              ; ----------------------------------------------------------------------
 868  AD04              ; PLOT_CHAR_AT_COL -- position to a column then write C into the row buffer at that
 869  AD04              ; offset, and tail-jump to the common screen-driver return.
 870  AD04              ;   In:  C = character; DE = column offset; cursor row state.
 871  AD04              ;   Out: char stored into the row buffer at $F678+DE (Apple $0678+DE). [RE]
 872  AD04              ;   Algorithm: recompute the base via SET_CURSOR_COL_AND_BASE, form $F678+DE,
 873  AD04              ;              store C, then JP RPC_TRIGGER (shared driver epilogue). [RE]
 874  AD04              ; ----------------------------------------------------------------------
 875  AD04              PLOT_CHAR_AT_COL:
 876  AD04                      ; set cursor column and recompute the row base
 877  AD04 CD EA AC             CALL SET_CURSOR_COL_AND_BASE
 878  AD07                      ; HL = row buffer base (Apple $0678) [RE]
 879  AD07 21 78 F6             LD HL,$F678
 880  AD0A                      ; HL = buffer base + column offset DE
 881  AD0A 19                   ADD HL,DE
 882  AD0B                      ; store the character at the target column
 883  AD0B 71                   LD (HL),C
 884  AD0C 21 AA C9             LD HL,$C9AA
 885  AD0F                      ; tail into the shared screen-driver return path
 886  AD0F              PLOT_RPC_TAIL:
 887  AD0F C3 3B AB             JP RPC_TRIGGER                   ; (emit via the SoftCard RPC trigger)
 888  AD12              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 889  AD12              DEV_READ_BIT:                            ; (DEV_HANDLER_PTRS_B[0])
 890  AD12 CD 60 AD             CALL SLOT_IO_ADDR
 891  AD15              DEV_READ_WAIT:
 892  AD15 7E                   LD A,(HL)
 893  AD16 1F                   RRA                              ; ready bit -> carry
 894  AD17 30 FC                JR NC,DEV_READ_WAIT
 895  AD19 2C                   INC L
 896  AD1A 7E                   LD A,(HL)                        ; read the data byte
 897  AD1B C9                   RET
 898  AD1C              ; DEV_OUT_RPC -- device handler: position via the screen base, RPC a fixed command, read back.
 899  AD1C              DEV_OUT_RPC:                             ; (DEV_HANDLER_PTRS_B[1])
 900  AD1C CD EE AC             CALL SET_SCREEN_BASE
 901  AD1F 21 4D C8             LD HL,$C84D
 902  AD22 CD 3B AB             CALL RPC_TRIGGER                 ; trigger the SoftCard RPC
 903  AD25 21 78 F6             LD HL,$F678                      ; row buffer base (Apple $0678)
 904  AD28 19                   ADD HL,DE
 905  AD29 7E                   LD A,(HL)
 906  AD2A C9                   RET
 907  AD2B              DEV_OUT_1:                               ; (default I/O vector handler)
 908  AD2B 11 01 00             LD DE,$0001
 909  AD2E              DEV_OUT_1_JP:
 910  AD2E C3 3E AD             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 911  AD31              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 912  AD31              DEV_WR_BIT:                              ; (DEV_HANDLER_PTRS[2])
 913  AD31 CD C5 AA             CALL DEVICE_IO_BASE
 914  AD34 2E C1                LD L,$C1
 915  AD36              DEV_WR_WAIT:
 916  AD36 7E                   LD A,(HL)
 917  AD37 17                   RLA                              ; ready bit -> carry
 918  AD38 38 FC                JR C,DEV_WR_WAIT
 919  AD3A CD 5B AD             CALL SLOT_IO_ADDR_W
 920  AD3D 71                   LD (HL),C
 921  AD3E              DEV_RET:
 922  AD3E C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 923  AD3F              DEV_OUT_2:                               ; (default I/O vector handler)
 924  AD3F 11 02 00             LD DE,$0002
 925  AD42              DEV_OUT_2_JP:
 926  AD42 C3 3E AD             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 927  AD45              DEV_OUT_3:                               ; (default I/O vector handler)
 928  AD45 11 02 00             LD DE,$0002
 929  AD48              DEV_OUT_3_JP:
 930  AD48 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 931  AD4B              ; ----------------------------------------------------------------------
 932  AD4B              ; HOME -- BIOS jump-vector entry: seek the selected drive to track 0.
 933  AD4B              ;   In:  none (operates on the selected disk).
 934  AD4B              ;   Out: none. Clobbers: A,C.
 935  AD4B              ;   Algorithm: if the host buffer still holds dirty (hstwrt) data, leave hstact
 936  AD4B              ;              set so the pending write is not lost; otherwise mark the host
 937  AD4B              ;              buffer inactive (hstact=0). Then fall into SETTRK with track 0,
 938  AD4B              ;              recording sektrk=0. The actual head step happens later inside the
 939  AD4B              ;              deblock read/write path, not here. [RE]
 940  AD4B              ; ----------------------------------------------------------------------
 941  AD4B              HOME:
 942  AD4B                      ; read hstwrt (host-write-pending flag)
 943  AD4B 3A B0 AE             LD A,(DISK_HSTWRT)
 944  AD4E B7                   OR A
 945  AD4F 20 03                JR NZ,SETTRK_STORE
 946  AD51                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 947  AD51 32 AF AE             LD (DISK_SEKDSK+2),A
 948  AD54              ; ----------------------------------------------------------------------
 949  AD54              ; SETTRK -- BIOS jump-vector entry (vector $AA1E -> here): set the requested track.
 950  AD54              ;   In:  C = track number (BC = track; only C used).
 951  AD54              ;   Out: none. Clobbers: A.
 952  AD54              ;   Algorithm: store C into sektrk (the BDOS-requested track). HOME falls in here
 953  AD54              ;              with C=0. The track is consumed later by the deblock host-match
 954  AD54              ;              test and the RWTS setup, not acted on immediately.
 955  AD54              ; ----------------------------------------------------------------------
 956  AD54              SETTRK_STORE:
 957  AD54                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 958  AD54 0E 00                LD C,$00
 959  AD56                      ; track number from BDOS
 960  AD56              SETTRK:                                  ; BIOS jump-vector entry 10 (HOME falls in above)
 961  AD56 79                   LD A,C
 962  AD57                      ; store into sektrk (overlaid on the BOOT entry's LD SP operand)
 963  AD57 32 A8 AE             LD (BOOT),A
 964  AD5A C9                   RET
 965  AD5B              ; ----------------------------------------------------------------------
 966  AD5B              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 967  AD5B              ;   In:  E = slot/drive index (0..15).
 968  AD5B              ;   Out: HL = $E080 + (E << 4) = Apple $C080+slot*16 soft-switch register.
 969  AD5B              ;        A preserved low nibble math. Clobbers: A,L.
 970  AD5B              ;   Algorithm: load the $C08x base for the write/control bank, then fall into the
 971  AD5B              ;              common index scaler (SLOT_IO_SCALE) that shifts E left by 4 and adds it
 972  AD5B              ;              to L. z80 $E080 = Apple $C080 (slot I/O space). [RE]
 973  AD5B              ; ----------------------------------------------------------------------
 974  AD5B              SLOT_IO_ADDR_W:
 975  AD5B                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 976  AD5B 21 80 E0             LD HL,$E080
 977  AD5E 18 03                JR SLOT_IO_SCALE_E
 978  AD60              ; ----------------------------------------------------------------------
 979  AD60              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch address ($C08E bank).
 980  AD60              ;   In:  E = slot/drive index (0..15).
 981  AD60              ;   Out: HL = $E08E + (E << 4) = Apple $C08E+slot*16. Clobbers: A,L.
 982  AD60              ;   Algorithm: load the $C08E base, then SLOT_IO_SCALE shifts E left by 4 (ADD A,A x4)
 983  AD60              ;              and adds it to L to index the per-slot $C0n0..$C0nF register block.
 984  AD60              ;              z80 $E08E = Apple $C08E (slot I/O). [RE]
 985  AD60              ; ----------------------------------------------------------------------
 986  AD60              SLOT_IO_ADDR:
 987  AD60                      ; z80 $E08E = Apple $C08E slot-I/O base
 988  AD60 21 8E E0             LD HL,$E08E
 989  AD63              SLOT_IO_SCALE_E:
 990  AD63                      ; slot/drive index
 991  AD63 7B                   LD A,E
 992  AD64              SLOT_IO_SCALE:
 993  AD64 87                   ADD A,A
 994  AD65 87                   ADD A,A
 995  AD66 87                   ADD A,A
 996  AD67 87                   ADD A,A
 997  AD68 F5                   PUSH AF
 998  AD69 85                   ADD A,L
 999  AD6A 6F                   LD L,A
1000  AD6B F1                   POP AF
1001  AD6C C9                   RET
1002  AD6D              ; ----------------------------------------------------------------------
1003  AD6D              ; SELDSK -- BIOS jump-vector entry: select the disk drive for subsequent I/O.
1004  AD6D              ;   In:  C = disk number (0-based).
1005  AD6D              ;   Out: HL = DPH (disk parameter header) address for drive C, or HL=0 if C is out
1006  AD6D              ;             of range. Clobbers: A,DE,HL.
1007  AD6D              ;   Algorithm: read the configured drive count from the SoftCard config block
1008  AD6D              ;              (z80 $F3B8 = Apple $03B8). If C >= count, return 0. Otherwise record
1009  AD6D              ;              the selected disk into the sekdsk build site (DISK_SELDSK_SAVE+1 = $04 marker
1010  AD6D              ;              then C) and return the constant DPH at DPH_TABLE scaled by the index.
1011  AD6D              ;              z80 $F3B8 = Apple ZP/config $03B8. [RE]
1012  AD6D              ; ----------------------------------------------------------------------
1013  AD6D              SELDSK:
1014  AD6D                      ; DE -> sekdsk build site (the SMC cells overlaid on the BOOT-area instructions)
1015  AD6D 11 AC AE             LD DE,DISK_SELDSK_SAVE+1
1016  AD70 21 04 00             LD HL,$0004
1017  AD73                      ; configured drive count from Apple config $03B8
1018  AD73 3A B8 F3             LD A,($F3B8)
1019  AD76 3D                   DEC A
1020  AD77                      ; requested drive vs (count-1); C-flag set if out of range
1021  AD77 B9                   CP C
1022  AD78                      ; out of range -> return HL=0
1023  AD78 38 0A                JR C,SELDSK_BAD_DRIVE
1024  AD7A 7E                   LD A,(HL)
1025  AD7B                      ; store the marker, then the selected disk number into sekdsk
1026  AD7B 12                   LD (DE),A
1027  AD7C 13                   INC DE
1028  AD7D 79                   LD A,C
1029  AD7E 12                   LD (DE),A
1030  AD7F                      ; base DPH; SLOT_IO_SCALE indexes it by the drive number
1031  AD7F 21 33 AA             LD HL,DPH_TABLE
1032  AD82 18 E0                JR SLOT_IO_SCALE
1033  AD84              SELDSK_BAD_DRIVE:
1034  AD84 1A                   LD A,(DE)
1035  AD85 77                   LD (HL),A
1036  AD86 2E 00                LD L,$00
1037  AD88 C9                   RET
1038  AD89              ; ----------------------------------------------------------------------
1039  AD89              ; SETSEC -- BIOS jump-vector entry: set the requested sector.
1040  AD89              ;   In:  C = sector number.
1041  AD89              ;   Out: none. Clobbers: A.
1042  AD89              ;   Algorithm: store C into seksec (the BDOS-requested sector, overlaid on BOOT+1).
1043  AD89              ;              Consumed later by the deblock host-match test.
1044  AD89              ; ----------------------------------------------------------------------
1045  AD89              SETSEC:
1046  AD89 79                   LD A,C
1047  AD8A                      ; store into seksec
1048  AD8A 32 A9 AE             LD (BOOT+1),A
1049  AD8D C9                   RET
1050  AD8E              ; ----------------------------------------------------------------------
1051  AD8E              ; SETDMA -- BIOS jump-vector entry: set the DMA (record transfer) address.
1052  AD8E              ;   In:  BC = DMA buffer address (where the 128-byte CP/M record is read to/written from).
1053  AD8E              ;   Out: none. Clobbers: none.
1054  AD8E              ;   Algorithm: store BC into dmaadr; the deblock copy (LDIR) uses it as the host<->record
1055  AD8E              ;              transfer endpoint.
1056  AD8E              ; ----------------------------------------------------------------------
1057  AD8E              SETDMA:
1058  AD8E                      ; store the DMA address into dmaadr
1059  AD8E ED 43 B8 AE          LD (DISK_DMAADR),BC
1060  AD92 C9                   RET
1061  AD93              ; ----------------------------------------------------------------------
1062  AD93              ; READ -- BIOS jump-vector entry: read one 128-byte CP/M record via deblocking.
1063  AD93              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set by SELDSK/SETTRK/SETSEC/SETDMA.
1064  AD93              ;   Out: A = 0 on success, 1 on error (set by the shared deblock tail). Clobbers: A,HL,...
1065  AD93              ;   Algorithm: clear unacnt (no unallocated-write run is in progress on a read), then
1066  AD93              ;              mark this as a read: readop=2 and seed the wrtype/flag bytes to 2, and
1067  AD93              ;              jump into the shared deblock core which pre-reads the host sector if the
1068  AD93              ;              requested record is not already buffered, then copies host -> DMA. [RE]
1069  AD93              ; ----------------------------------------------------------------------
1070  AD93              READ:
1071  AD93 AF                   XOR A
1072  AD94                      ; unacnt = 0: a read never continues an unallocated-write run
1073  AD94 32 B4 AE             LD (DISK_WRTYPE+2),A
1074  AD97 3E 02                LD A,$02
1075  AD99                      ; HL -> readop; seed readop and the following flag bytes = 2 (read operation)
1076  AD99 21 B1 AE             LD HL,DISK_HSTWRT+1
1077  AD9C 77                   LD (HL),A
1078  AD9D 23                   INC HL
1079  AD9E 77                   LD (HL),A
1080  AD9F 23                   INC HL
1081  ADA0 77                   LD (HL),A
1082  ADA1                      ; enter the shared deblock core (skip the write-only pre-roll)
1083  ADA1 18 4F                JR DEBLOCK_CORE
1084  ADA3              ; ----------------------------------------------------------------------
1085  ADA3              ; WRITE -- BIOS jump-vector entry: write one 128-byte CP/M record via deblocking.
1086  ADA3              ;   In:  C = write type (0=allocated, 1=directory, 2=to a freshly-allocated/unalloc block);
1087  ADA3              ;        sekdsk/sektrk/seksec/dmaadr previously set.
1088  ADA3              ;   Out: A = 0 on success, 1 on error. Clobbers: A,HL,...
1089  ADA3              ;   Algorithm: record readop/wrtype from C. For an unallocated-block write (C=2) seed an
1090  ADA3              ;              8-record run (unacnt=8) anchored at the current sekdsk/sektrk/seksec so the
1091  ADA3              ;              next 7 sequential records skip the redundant pre-read. Then the shared
1092  ADA3              ;              deblock core: if the requested record extends the active unalloc run just
1093  ADA3              ;              buffer it (rsflag=0); otherwise force a host pre-read (rsflag=1), copy
1094  ADA3              ;              DMA -> host, mark hstwrt. [RE]
1095  ADA3              ; ----------------------------------------------------------------------
1096  ADA3              WRITE:
1097  ADA3 61                   LD H,C
1098  ADA4 2E 00                LD L,$00
1099  ADA6                      ; readop = wrtype (from C), clear the adjacent flag byte
1100  ADA6 22 B1 AE             LD (DISK_HSTWRT+1),HL
1101  ADA9 79                   LD A,C
1102  ADAA                      ; wrtype 2 = write to an unallocated block (start a sequential run)
1103  ADAA FE 02                CP $02
1104  ADAC                      ; ordinary write: skip the unalloc-run seeding
1105  ADAC 20 0F                JR NZ,DEBLOCK_CHECK_UNALLOC
1106  ADAE                      ; unacnt = 8 records in the new unallocated run (host blocking factor)
1107  ADAE 2E 08                LD L,$08
1108  ADB0                      ; compare sekdsk against the run's disk
1109  ADB0 3A AD AE             LD A,(DISK_SEKDSK)
1110  ADB3 67                   LD H,A
1111  ADB4                      ; seed unacnt (and the next byte) for the run
1112  ADB4 22 B4 AE             LD (DISK_WRTYPE+2),HL
1113  ADB7                      ; anchor the run's next-track/sector (unatrk/unasec) at the requested sektrk/seksec
1114  ADB7 2A A8 AE             LD HL,(BOOT)
1115  ADBA                      ; advance unatrk/unasec to the next record in the run
1116  ADBA 22 B6 AE             LD (DISK_UNADSK+1),HL
1117  ADBD              ; ----------------------------------------------------------------------
1118  ADBD              ; DEBLOCK_CHECK_UNALLOC -- decide whether the requested record continues the active
1119  ADBD              ;   unallocated-write run; if so just buffer it, else force a pre-read.
1120  ADBD              ;   In:  unacnt/unatrk/unasec, sekdsk/sektrk/seksec set by READ/WRITE.
1121  ADBD              ;   Out: rsflag set (0 = reuse buffer, 1 = must pre-read host sector). Clobbers: A,HL.
1122  ADBD              ;   Algorithm: if unacnt==0 the run is over -> rsflag=1. Otherwise verify the request
1123  ADBD              ;              matches sekdsk and the run's next unatrk/unasec; on a match advance the
1124  ADBD              ;              run and set rsflag=0, on any mismatch set rsflag=1. [RE]
1125  ADBD              ; ----------------------------------------------------------------------
1126  ADBD              DEBLOCK_CHECK_UNALLOC:
1127  ADBD                      ; point HL at unacnt (unallocated record count)
1128  ADBD 21 B4 AE             LD HL,DISK_WRTYPE+2
1129  ADC0                      ; unacnt: zero means no active unalloc run
1130  ADC0 7E                   LD A,(HL)
1131  ADC1 B7                   OR A
1132  ADC2 28 28                JR Z,DEBLOCK_FORCE_PREREAD
1133  ADC4                      ; consume one record of the unallocated run
1134  ADC4 35                   DEC (HL)
1135  ADC5 3A AD AE             LD A,(DISK_SEKDSK)
1136  ADC8 23                   INC HL
1137  ADC9 BE                   CP (HL)
1138  ADCA 20 20                JR NZ,DEBLOCK_FORCE_PREREAD
1139  ADCC 3A A8 AE             LD A,(BOOT)
1140  ADCF                      ; load unatrk/unasec (the run's current track/sector)
1141  ADCF 2A B6 AE             LD HL,(DISK_UNADSK+1)
1142  ADD2 BD                   CP L
1143  ADD3 20 17                JR NZ,DEBLOCK_FORCE_PREREAD
1144  ADD5                      ; requested seksec vs the run's sector
1145  ADD5 3A A9 AE             LD A,(BOOT+1)
1146  ADD8 BC                   CP H
1147  ADD9 20 11                JR NZ,DEBLOCK_FORCE_PREREAD
1148  ADDB                      ; advance the unalloc sector; wrap to next track when it passes the sectors-per-track limit
1149  ADDB                      ; ($20)
1150  ADDB 24                   INC H
1151  ADDC 7C                   LD A,H
1152  ADDD D6 20                SUB $20
1153  ADDF 38 02                JR C,DEBLOCK_RUN_CONTINUES
1154  ADE1 67                   LD H,A
1155  ADE2 2C                   INC L
1156  ADE3              DEBLOCK_RUN_CONTINUES:
1157  ADE3 22 B6 AE             LD (DISK_UNADSK+1),HL
1158  ADE6 AF                   XOR A
1159  ADE7                      ; rsflag = 0: record continues the run, no host pre-read needed
1160  ADE7 32 B3 AE             LD (DISK_WRTYPE+1),A
1161  ADEA 18 06                JR DEBLOCK_CORE
1162  ADEC              DEBLOCK_FORCE_PREREAD:
1163  ADEC                      ; rsflag = 1: record breaks the run, force a host-sector pre-read
1164  ADEC 21 01 00             LD HL,$0001
1165  ADEF 22 B3 AE             LD (DISK_WRTYPE+1),HL
1166  ADF2              ; ----------------------------------------------------------------------
1167  ADF2              ; DEBLOCK_CORE -- shared host-buffer management for READ and WRITE (the deblock heart).
1168  ADF2              ;   In:  sekdsk/sektrk/seksec, readop, wrtype, rsflag, hstact, hstwrt, dmaadr.
1169  ADF2              ;   Out: A = status (0 ok). Performs the host sector flush/read and the 128-byte
1170  ADF2              ;        record copy host<->DMA. Clobbers: A,BC,DE,HL.
1171  ADF2              ;   Algorithm: translate seksec through SECTOR_XLATE to the physical sector. If the
1172  ADF2              ;              host buffer is active (hstact) but holds a different disk/track/sector,
1173  ADF2              ;              flush it when dirty (hstwrt). Set up the RWTS request (track/sector/
1174  ADF2              ;              unit into the Apple $03Ex IOB). If rsflag demands it, physically read
1175  ADF2              ;              the host sector. Finally LDIR-copy the selected 128-byte half of the
1176  ADF2              ;              host sector to/from dmaadr (direction chosen by readop), and on a write
1177  ADF2              ;              mark hstwrt and flush if required. [RE]
1178  ADF2              ; ----------------------------------------------------------------------
1179  ADF2              DEBLOCK_CORE:
1180  ADF2                      ; read seksec back (returns the requested sector for translation)
1181  ADF2 CD F0 AF             CALL READ_SEKSEC
1182  ADF5 5F                   LD E,A
1183  ADF6 1F                   RRA
1184  ADF7                      ; translate logical sector -> physical via the skew table
1185  ADF7 21 92 AE             LD HL,SECTOR_XLATE
1186  ADFA 85                   ADD A,L
1187  ADFB 6F                   LD L,A
1188  ADFC 4E                   LD C,(HL)
1189  ADFD                      ; HL -> hstact; remember prior state, then mark the host buffer active
1190  ADFD 21 AF AE             LD HL,DISK_SEKDSK+2
1191  AE00 7E                   LD A,(HL)
1192  AE01                      ; hstact = 1 (host buffer now in use)
1193  AE01 36 01                LD (HL),$01
1194  AE03 B7                   OR A
1195  AE04                      ; host buffer was inactive: no flush/match test needed, go set up RWTS
1196  AE04 28 1B                JR Z,DEBLOCK_SETUP_RWTS
1197  AE06                      ; compare sekdsk vs hstdsk (host buffer's disk)
1198  AE06 2A AD AE             LD HL,(DISK_SEKDSK)
1199  AE09 7D                   LD A,L
1200  AE0A BC                   CP H
1201  AE0B 20 0D                JR NZ,DEBLOCK_NEED_RELOAD
1202  AE0D                      ; Apple $03E0 = current RWTS track/sector in the host buffer
1203  AE0D 2A E0 F3             LD HL,($F3E0)
1204  AE10                      ; requested sektrk vs host buffer track
1205  AE10 3A A8 AE             LD A,(BOOT)
1206  AE13 BD                   CP L
1207  AE14 20 04                JR NZ,DEBLOCK_NEED_RELOAD
1208  AE16 79                   LD A,C
1209  AE17 BC                   CP H
1210  AE18                      ; requested record already in the host buffer -> skip flush and re-read, go straight to the
1211  AE18                      ; copy
1212  AE18 28 33                JR Z,DEBLOCK_COPY_RECORD
1213  AE1A              DEBLOCK_NEED_RELOAD:
1214  AE1A                      ; hstwrt: if the outgoing host buffer is dirty, flush it first
1215  AE1A 3A B0 AE             LD A,(DISK_HSTWRT)
1216  AE1D B7                   OR A
1217  AE1E                      ; flush the dirty host buffer before reloading
1218  AE1E C4 73 AE             CALL NZ,DISK_WRITE_HOST
1219  AE21              DEBLOCK_SETUP_RWTS:
1220  AE21 3A AD AE             LD A,(DISK_SEKDSK)
1221  AE24 32 AE AE             LD (DISK_SEKDSK+1),A
1222  AE27 47                   LD B,A
1223  AE28 E6 01                AND $01
1224  AE2A 3C                   INC A
1225  AE2B                      ; Apple $03E4 = RWTS unit/volume cell
1226  AE2B 32 E4 F3             LD ($F3E4),A
1227  AE2E 78                   LD A,B
1228  AE2F E6 0E                AND $0E
1229  AE31 87                   ADD A,A
1230  AE32 87                   ADD A,A
1231  AE33 87                   ADD A,A
1232  AE34 2F                   CPL
1233  AE35 C6 61                ADD A,$61
1234  AE37                      ; Apple $03E6 = RWTS track cell
1235  AE37 32 E6 F3             LD ($F3E6),A
1236  AE3A 3A A8 AE             LD A,(BOOT)
1237  AE3D 6F                   LD L,A
1238  AE3E 61                   LD H,C
1239  AE3F                      ; Apple $03E0 = record the host buffer's new track/sector
1240  AE3F 22 E0 F3             LD ($F3E0),HL
1241  AE42                      ; rsflag: nonzero -> physically pre-read the host sector
1242  AE42 3A B3 AE             LD A,(DISK_WRTYPE+1)
1243  AE45 B7                   OR A
1244  AE46                      ; perform the host sector read (RWTS read entry)
1245  AE46 C4 7A AE             CALL NZ,DISK_READ_HOST
1246  AE49 AF                   XOR A
1247  AE4A                      ; hstwrt = 0 after a fresh read
1248  AE4A 32 B0 AE             LD (DISK_HSTWRT),A
1249  AE4D              DEBLOCK_COPY_RECORD:
1250  AE4D 7B                   LD A,E
1251  AE4E                      ; z80 $F800 = Apple $0800 host sector buffer base
1252  AE4E 21 00 F8             LD HL,$F800
1253  AE51 1F                   RRA
1254  AE52                      ; select the upper/lower 128-byte half of the host sector from the record's parity
1255  AE52 CB 1D                RR L
1256  AE54                      ; dmaadr = the CP/M record buffer
1257  AE54 ED 5B B8 AE          LD DE,(DISK_DMAADR)
1258  AE58                      ; 128-byte CP/M record length
1259  AE58 01 80 00             LD BC,$0080
1260  AE5B                      ; readop: nonzero = read (host->DMA), zero = write (DMA->host)
1261  AE5B 3A B1 AE             LD A,(DISK_HSTWRT+1)
1262  AE5E B7                   OR A
1263  AE5F 20 05                JR NZ,DEBLOCK_COPY
1264  AE61 3C                   INC A
1265  AE62 32 B0 AE             LD (DISK_HSTWRT),A
1266  AE65                      ; write direction: swap so LDIR copies DMA -> host buffer
1267  AE65 EB                   EX DE,HL
1268  AE66              DEBLOCK_COPY:
1269  AE66                      ; copy the 128-byte record host<->DMA
1270  AE66 ED B0                LDIR
1271  AE68                      ; wrtype: bit 0 decides whether a write must flush immediately (directory write)
1272  AE68 3A B2 AE             LD A,(DISK_WRTYPE)
1273  AE6B 1F                   RRA
1274  AE6C 3E 00                LD A,$00
1275  AE6E D0                   RET NC
1276  AE6F                      ; immediate flush of the dirty host buffer
1277  AE6F CD 73 AE             CALL DISK_WRITE_HOST
1278  AE72 C9                   RET
1279  AE73              ; ----------------------------------------------------------------------
1280  AE73              ; DISK_WRITE_HOST -- write the staged host sector to disk via the SoftCard RWTS RPC.
1281  AE73              ;   Clears hstwrt, sets the RWTS command cell ($F3EB = Apple $03EB) to write ($02),
1282  AE73              ;   fires the RPC (RPC_TRIGGER) with the track/sector params, then checks RWTS status
1283  AE73              ;   ($F3EA = Apple $03EA): 0 = OK; $10 = write-protected -> dispatch the BDOS read-only
1284  AE73              ;   disk error through the vector at ($9C0D). The read entry DISK_READ_HOST just below
1285  AE73              ;   shares this body via the $21 cover. Called by the deblock to flush a dirty host
1286  AE73              ;   buffer / write a directory record. [RE]
1287  AE73              ; ----------------------------------------------------------------------
1288  AE73              DISK_WRITE_HOST:
1289  AE73 AF                   XOR A
1290  AE74                      ; clear the host-buffer-dirty flag (hstwrt) as part of the flush
1291  AE74 32 B0 AE             LD (DISK_HSTWRT),A
1292  AE77 3E 02                LD A,$02
1293  AE79 21                   DEFB    $21                      ; cover (LD HL,nn opcode): on fall-through absorbs the
1294  AE7A              ; ----------------------------------------------------------------------
1295  AE7A              ; DISK_READ_HOST -- read a host sector from disk via the RWTS RPC. A direct CALL enters
1296  AE7A              ;   here so the LD A,$01 sets the RWTS command to read ($01); the $21 cover above absorbs
1297  AE7A              ;   this instruction on fall-through, leaving DISK_WRITE_HOST's A=$02 (write). Shares the
1298  AE7A              ;   RWTS command/status path with DISK_WRITE_HOST. [RE]
1299  AE7A              ; ----------------------------------------------------------------------
1300  AE7A              DISK_READ_HOST:
1301  AE7A 3E 01                LD A,$01                         ; CALL'd directly -> A=$01 (cover-skipped on fall-through)
1302  AE7C                      ; store the console-selector index into the SoftCard config block (Apple $03EB)
1303  AE7C 32 EB F3             LD ($F3EB),A
1304  AE7F 21 03 0E             LD HL,$0E03
1305  AE82                      ; probe/init the selected console device handler
1306  AE82 CD 3B AB             CALL RPC_TRIGGER
1307  AE85                      ; read the detected device-class byte from the config block (Apple $03EA)
1308  AE85 3A EA F3             LD A,($F3EA)
1309  AE88 B7                   OR A
1310  AE89                      ; no special device class -> done
1311  AE89 C8                   RET Z
1312  AE8A D1                   POP DE
1313  AE8B                      ; device class $10 -> dispatch through the installed handler vector
1314  AE8B FE 10                CP $10
1315  AE8D C0                   RET NZ
1316  AE8E                      ; fetch the handler entry from the CCP/loader vector cell (BDOS_FBASE+$0D) and tail-jump to it [RE]
1317  AE8E 2A 0D 9C             LD HL,(BDOS_FBASE+$0D)
1318  AE91 E9                   JP (HL)
1319  AE92              ; ----------------------------------------------------------------------
1320  AE92              ; SECTOR_XLATE -- 16-entry logical->physical sector skew table (a 0..15 permutation).
1321  AE92              ;   Indexed by the deblock code (LD A,L add-offset lookup) to translate a CP/M logical
1322  AE92              ;   sector to the physical RWTS sector. DATA, not code.
1323  AE92              ; ----------------------------------------------------------------------
1324  AE92              SECTOR_XLATE:
1325  AE92                      ; 16-entry logical->physical sector skew table (a 0..15 permutation),
1326  AE92                      ; indexed during disk deblock (DEV_HANDLER_LOOKUP-style *1 byte lookups).
1327  AE92 00 09 03 0C          DEFB    $00,$09,$03,$0C,$06,$0F,$01,$0A
1327  AE96 06 0F 01 0A
1328  AE9A 04 0D 07 08          DEFB    $04,$0D,$07,$08,$02,$0B,$05,$0E
1328  AE9E 02 0B 05 0E
1329  AEA2              ; ----------------------------------------------------------------------
1330  AEA2              ; COL_FLAG -- console-output entry/expand flag (0 or $FF), set by CONOUT_FILTER and
1331  AEA2              ;   tested by SCREEN_EMIT to pick the physical output vector. Immediately followed by
1332  AEA2              ;   COL_PENDING at A3-adjacent cells. Scratch byte, init $00. [RE]
1333  AEA2              ; ----------------------------------------------------------------------
1334  AEA2              COL_FLAG:
1335  AEA2 00                   DEFB    $00                      ; disk scratch byte
1336  AEA3              ; ----------------------------------------------------------------------
1337  AEA3              ; COL_PENDING -- pending column-skip / fill counter for console output, also reused as a
1338  AEA3              ;   mode byte (set to 2 by TAB_EXPAND_DONE). Decremented as columns are consumed.
1339  AEA3              ;   Accessed as COL_FLAG+1 in CONOUT_FILTER. Scratch byte, init $00. [RE]
1340  AEA3              ; ----------------------------------------------------------------------
1341  AEA3              COL_PENDING:
1342  AEA3 00                   DEFB    $00                      ; disk scratch byte
1343  AEA4              ; ----------------------------------------------------------------------
1344  AEA4              ; COL_STATE -- sticky control/escape state for tab expansion; armed to $80 on a trigger-
1345  AEA4              ;   char match and cleared by SCREEN_EMIT. Scratch byte, init $00. [RE]
1346  AEA4              ; ----------------------------------------------------------------------
1347  AEA4              COL_STATE:
1348  AEA4 00                   DEFB    $00                      ; disk scratch byte
1349  AEA5              ; ----------------------------------------------------------------------
1350  AEA5              ; SCREEN_CURSOR_PTR -- 2-byte pointer cell used by the screen routines (initialized to
1351  AEA5              ;   point at SCREEN_CHAR / SCREEN_CHAR). Loaded and re-stored by PUT_CHAR_STORE while reading
1352  AEA5              ;   the Apple cursor base ($F028) and column ($F024) to compute the on-screen cell. [RE]
1353  AEA5              ; ----------------------------------------------------------------------
1354  AEA5              SCREEN_CURSOR_PTR:
1355  AEA5 A7 AE                DEFW    SCREEN_CHAR              ; pointer cell (init -> SCREEN_CHAR)
1356  AEA7              ; ----------------------------------------------------------------------
1357  AEA7              ; SCREEN_CHAR -- saved on-screen character byte (the cell SCREEN_CURSOR_PTR points at by
1358  AEA7              ;   default); written back to the screen with format bits applied. Scratch byte, init $00.
1359  AEA7              ;   [RE]
1360  AEA7              ; ----------------------------------------------------------------------
1361  AEA7              SCREEN_CHAR:
1362  AEA7 00                   DEFB    $00                      ; disk scratch byte
1363  AEA8              ; ----------------------------------------------------------------------
1364  AEA8              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector $AA00 lands here via $AA00->$AEA8).
1365  AEA8              ;   In:  none. Out: does not return through here (falls into the install engine).
1366  AEA8              ;   Clobbers: all.
1367  AEA8              ;   DUAL USE of the first 2 operand bytes: this 'LD SP,$0100' executes once at cold boot;
1368  AEA8              ;   afterwards BOOT and BOOT+1 (the $00,$01 immediate-operand bytes) are reused as the
1369  AEA8              ;   disk-deblock sektrk and seksec cells: HOME/SETTRK write BOOT (sektrk), SETSEC writes
1370  AEA8              ;   BOOT+1 (seksec), and the WRITE/READ deblock and READ_SEKSEC read them. The third byte
1371  AEA8              ;   BOOT+2 is a SEPARATE console cursor word (read by the column/tab path and
1372  AEA8              ;   CTRL_CLAMP_CURSOR), NOT a disk cell. Valid SP-init bytes only during the single
1373  AEA8              ;   cold-boot pass; thereafter scratch, never re-executed. [RE]
1374  AEA8              ;   Algorithm: set the Z-80 stack, then fall through into the self-modifying install
1375  AEA8              ;   engine (PATCH_* cells) that writes the per-config operands into the running BIOS.
1376  AEA8              ; ----------------------------------------------------------------------
1377  AEA8              BOOT:
1378  AEA8                      ; init Z-80 stack; BOOT/BOOT+1 are reused post-boot as the sektrk/seksec deblock
1379  AEA8                      ; cells (BOOT=track, BOOT+1=sector); BOOT+2 is a separate console cursor word
1380  AEA8 31 00 01             LD SP,$0100
1381  AEAB              ; ----------------------------------------------------------------------
1382  AEAB              ; DISK_SELDSK_SAVE -- (boot install template 'LD A,$C9'); +1 byte reused as SELDSK scratch.
1383  AEAB              ;   At cold boot this is the install engine's 'LD A,$C9' template. After boot SELDSK
1384  AEAB              ;   stores the previously-selected drive (page-zero $0004) into DISK_SELDSK_SAVE+1,
1385  AEAB              ;   then the disk number into DISK_SEKDSK (the next cell). [RE]
1386  AEAB              ; ----------------------------------------------------------------------
1387  AEAB              DISK_SELDSK_SAVE:
1388  AEAB 3E C9                LD A,$C9
1389  AEAD              ; ----------------------------------------------------------------------
1390  AEAD              ; DISK_SEKDSK -- CP/M-requested disk number (DRI deblock 'sekdsk'); +1/+2 = hstdsk/hstact.
1391  AEAD              ;   Boot tenant: install template 'LD (nn),A' (operand runtime-patched). Operational
1392  AEAD              ;   tenant: SELDSK stores the selected disk number here; DISK_SEKDSK+1 = host disk
1393  AEAD              ;   (hstdsk [RE]); DISK_SEKDSK+2 = host-buffer-active flag (hstact), cleared by WBOOT/
1394  AEAD              ;   HOME and the deblock, set when a host sector is staged. [RE]
1395  AEAD              ; ----------------------------------------------------------------------
1396  AEAD              DISK_SEKDSK:
1397  AEAD 32 00 AA             LD (BIOS_VECTOR),A
1398  AEB0              ; ----------------------------------------------------------------------
1399  AEB0              ; DISK_HSTWRT -- host-buffer-dirty flag (DRI deblock 'hstwrt' [RE]); +1 = readop [RE].
1400  AEB0              ;   Boot tenant: install template 'LD A,$95' (the default IOBYTE immediate). Operational
1401  AEB0              ;   tenant: a deblock flag the WRITE path sets and the host-flush test reads;
1402  AEB0              ;   DISK_HSTWRT+1 is the read/seek scratch the READ/WRITE deblock loads. [RE]
1403  AEB0              ; ----------------------------------------------------------------------
1404  AEB0              DISK_HSTWRT:
1405  AEB0 3E 95                LD A,$95
1406  AEB2              ; ----------------------------------------------------------------------
1407  AEB2              ; DISK_WRTYPE -- deblock write type (DRI 'wrtype' [RE]); +1 = rsflag, +2 = unacnt.
1408  AEB2              ;   Boot tenant: install template 'LD ($0003),A' (stores the default IOBYTE). Operational
1409  AEB2              ;   tenant: DISK_WRTYPE+1 = read-sector-needed flag (rsflag); DISK_WRTYPE+2 = unallocated
1410  AEB2              ;   record count (unacnt), seeded to 8 on a directory-extending write and decremented
1411  AEB2              ;   by the WRITE deblock loop. [RE]
1412  AEB2              ; ----------------------------------------------------------------------
1413  AEB2              DISK_WRTYPE:
1414  AEB2 32 03 00             LD ($0003),A
1415  AEB5              ; ----------------------------------------------------------------------
1416  AEB5              ; DISK_UNADSK -- unallocated-run disk (DRI 'unadsk' [RE]); +1/+2 = unatrk/unasec.
1417  AEB5              ;   Boot tenant: install template 'LD HL,(nn)'. Operational tenant: the unallocated
1418  AEB5              ;   write run's position. DISK_UNADSK+1 (unatrk) and +2 (unasec) are seeded from the
1419  AEB5              ;   CP/M-requested track/sector (BOOT/BOOT+1) and advanced as the run is written. [RE]
1420  AEB5              ; ----------------------------------------------------------------------
1421  AEB5              DISK_UNADSK:
1422  AEB5 2A DE F3             LD HL,($F3DE)
1423  AEB8              ; ----------------------------------------------------------------------
1424  AEB8              ; DISK_DMAADR -- current DMA buffer address (DRI deblock 'dmaadr').
1425  AEB8              ;   Boot tenant: install template 'LD (nn),HL' (patches a console/IO operand at boot).
1426  AEB8              ;   Operational tenant: SETDMA stores BC here; the deblock record copy uses it as the
1427  AEB8              ;   CP/M 128-byte record source/destination.
1428  AEB8              ; ----------------------------------------------------------------------
1429  AEB8              DISK_DMAADR:
1430  AEB8 22 3F AB             LD (RPC_TRIGGER_STORE+1),HL
1431  AEBB AF                   XOR A
1432  AEBC 32 04 00             LD ($0004),A
1433  AEBF 3A BB F3             LD A,($F3BB)
1434  AEC2 FE 05                CP $05
1435  AEC4 30 1F                JR NC,DEV_INSTALL_2
1436  AEC6 D6 03                SUB $03
1437  AEC8 38 1B                JR C,DEV_INSTALL_2
1438  AECA 20 06                JR NZ,DEV_INSTALL_1
1439  AECC                      ; this console card class: repoint the CONST handler's read to $1FB0 (rewrites the
1440  AECC                      ; LD A,($E000) operand + the following byte) so status comes from the card, not $C000
1441  AECC 21 B0 1F             LD HL,$1FB0
1442  AECF 22 0E AB             LD (KBD_STATUS_40COL+2),HL
1443  AED2              DEV_INSTALL_1:
1444  AED2 F5                   PUSH AF
1445  AED3 CD 59 AF             CALL DEV_HANDLER_LOOKUP
1446  AED6 F1                   POP AF
1447  AED7 22 42 AC             LD (PUT_CHAR_VECTOR+1),HL
1448  AEDA CD 54 AF             CALL DEV_HANDLER_LOOKUP_B
1449  AEDD 22 2D AB             LD (CONIN_DISPATCH+1),HL         ; patch the CONIN keyboard-wait vector
1450  AEE0 3E 03                LD A,$03
1451  AEE2 32 FD AA             LD (CCP_MODE_FLAG+1),A
1452  AEE5              DEV_INSTALL_2:
1453  AEE5 3A B9 F3             LD A,($F3B9)
1454  AEE8 D6 03                SUB $03
1455  AEEA 38 08                JR C,DEV_INSTALL_3
1456  AEEC CD 59 AF             CALL DEV_HANDLER_LOOKUP
1457  AEEF 22 2F AD             LD (DEV_OUT_1_JP+1),HL           ; patch the DEV_OUT_1 vector
1458  AEF2 1E 80                LD E,$80
1459  AEF4              DEV_INSTALL_3:
1460  AEF4 3A BA F3             LD A,($F3BA)
1461  AEF7 D6 03                SUB $03
1462  AEF9 38 14                JR C,DEV_INSTALL_4
1463  AEFB F5                   PUSH AF
1464  AEFC CD 59 AF             CALL DEV_HANDLER_LOOKUP
1465  AEFF 22 43 AD             LD (DEV_OUT_2_JP+1),HL           ; patch the DEV_OUT_2 vector
1466  AF02 F1                   POP AF
1467  AF03 FE 02                CP $02
1468  AF05 30 08                JR NC,DEV_INSTALL_4
1469  AF07 CD 54 AF             CALL DEV_HANDLER_LOOKUP_B
1470  AF0A 22 49 AD             LD (DEV_OUT_3_JP+1),HL           ; patch the DEV_OUT_3 jump target
1471  AF0D 18 0B                JR DEV_INSTALL_5
1472  AF0F              DEV_INSTALL_4:
1473  AF0F 21 3E 1A             LD HL,$1A3E
1474  AF12 22 48 AD             LD (DEV_OUT_3_JP),HL             ; build DEV_OUT_3's instruction (opcode+lo)
1475  AF15 3E C9                LD A,$C9
1476  AF17 32 4A AD             LD (DEV_OUT_3_JP+2),A            ; build DEV_OUT_3's instruction (hi byte)
1477  AF1A              DEV_INSTALL_5:
1478  AF1A 3A 81 F3             LD A,($F381)
1479  AF1D B7                   OR A
1480  AF1E 20 0B                JR NZ,DEV_INSTALL_6
1481  AF20 21 AE AF             LD HL,IO_VECTOR_DEFAULTS
1482  AF23 11 80 F3             LD DE,$F380
1483  AF26 01 16 00             LD BC,$0016
1484  AF29 ED B0                LDIR
1485  AF2B              DEV_INSTALL_6:
1486  AF2B CD A2 AA             CALL PROBE_DEVICES
1487  AF2E 3A 98 F3             LD A,($F398)
1488  AF31 CD 64 AF             CALL SIGNON_EMIT
1489  AF34 3A 9B F3             LD A,($F39B)
1490  AF37                  IFDEF V220B
1491  AF37 ~                    LD A,(SIGNON_EMIT)               ; 2.20B: skip emitting the 2nd config byte (A is reloaded then discarded by the banner loop)
1492  AF37                  ELSE
1493  AF37 CD 64 AF             CALL SIGNON_EMIT
1494  AF3A                  ENDIF
1495  AF3A 21 73 AF             LD HL,SIGNON_BANNER
1496  AF3D              DEV_INSTALL_7:
1497  AF3D 7E                   LD A,(HL)
1498  AF3E B7                   OR A
1499  AF3F CA DB AA             JP Z,PAGEZERO_REBUILD
1500  AF42 E5                   PUSH HL
1501  AF43 CD 42 AB             CALL CONOUT_DISPATCH
1502  AF46 E1                   POP HL
1503  AF47 23                   INC HL
1504  AF48 18 F3                JR DEV_INSTALL_7
1505  AF4A              ; ----------------------------------------------------------------------
1506  AF4A              ; DEV_HANDLER_PTRS -- DEFW table of disk read/write handler addresses (primary group),
1507  AF4A              ;   indexed by DEV_HANDLER_LOOKUP. Continues as DEV_HANDLER_PTRS_B (+6). DATA.
1508  AF4A              ;   Each entry should relocate from a literal address to the named target:
1509  AF4A              ;     [0] $ACDF -> DISK_RD_HANDLER_A  (CALL SLOT_IO_ADDR sector-bit read handler in the
1510  AF4A              ;         CTRL_HANDLER_OFFSET_TBL data/code region)
1511  AF4A              ;     [1] $AD04 -> PLOT_CHAR_AT_COL        (named handler just below)
1512  AF4A              ;     [2] $AD31 -> DISK_WR_HANDLER_B (handler tail in the $AD22 data/code region)
1513  AF4A              ;   and DEV_HANDLER_PTRS_B holds:
1514  AF4A              ;     [0] $AD12 -> DISK_RD_HANDLER_B (RRA bit-test read handler at the $AD12 block)
1515  AF4A              ;     [1] $AD1C -> DISK_WR_HANDLER_A (CALL SET_SCREEN_BASE write handler in the $AD22 block)
1516  AF4A              ;   See flags: these targets currently sit inside DEFB blocks (CTRL_HANDLER_OFFSET_TBL / $AD12 /
1517  AF4A              ;   $AD22)
1518  AF4A              ;   that are really handler CODE, so the relocations need those blocks named first.
1519  AF4A              ; ----------------------------------------------------------------------
1520  AF4A              DEV_HANDLER_PTRS:
1521  AF4A                      ; table of device-handler addresses (DEFW). DEV_HANDLER_LOOKUP indexes from
1522  AF4A                      ; here; DEV_HANDLER_LOOKUP_B indexes from DEV_HANDLER_PTRS_B (+6). Selected per config
1523  AF4A                      ; by DISK_WRITE_HOST to install the right console/disk handler into the vector slots.
1524  AF4A DF AC                DEFW    DEV_STROBE_RD            ; [0]
1525  AF4C 04 AD                DEFW    PLOT_CHAR_AT_COL         ; [1]
1526  AF4E 31 AD                DEFW    DEV_WR_BIT               ; [2]
1527  AF50              DEV_HANDLER_PTRS_B:
1528  AF50 12 AD                DEFW    DEV_READ_BIT             ; DEV_HANDLER_LOOKUP_B base
1529  AF52 1C AD                DEFW    DEV_OUT_RPC
1530  AF54              ; ----------------------------------------------------------------------
1531  AF54              ; DEV_HANDLER_LOOKUP_B -- fetch a disk-handler address from DEV_HANDLER_PTRS_B[A].
1532  AF54              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1533  AF54              ;   Algorithm: point HL at DEV_HANDLER_PTRS_B then fall into the shared index loader
1534  AF54              ;   (HL += A*2; HL = word at that slot). Used by DISK_WRITE_HOST to install the per-config
1535  AF54              ;   read/write handler addresses. [RE]
1536  AF54              ; ----------------------------------------------------------------------
1537  AF54              DEV_HANDLER_LOOKUP_B:
1538  AF54                      ; select the secondary handler-pointer table
1539  AF54 21 50 AF             LD HL,DEV_HANDLER_PTRS_B
1540  AF57 18 03                JR DISK_RTN_LOOKUP_IDX
1541  AF59              ; ----------------------------------------------------------------------
1542  AF59              ; DEV_HANDLER_LOOKUP -- fetch a disk-handler address from DEV_HANDLER_PTRS[A].
1543  AF59              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1544  AF59              ;   Algorithm: HL = base; HL += A*2 (ADD A,A; ADD A,L; LD L,A); HL = the 16-bit word
1545  AF59              ;   at that slot (low then high). Shared tail of DEV_HANDLER_LOOKUP_B. [RE]
1546  AF59              ; ----------------------------------------------------------------------
1547  AF59              DEV_HANDLER_LOOKUP:
1548  AF59                      ; select the primary handler-pointer table
1549  AF59 21 4A AF             LD HL,DEV_HANDLER_PTRS
1550  AF5C              DISK_RTN_LOOKUP_IDX:
1551  AF5C                      ; index*2 for 16-bit (word) table entries
1552  AF5C 87                   ADD A,A
1553  AF5D 85                   ADD A,L
1554  AF5E 6F                   LD L,A
1555  AF5F                      ; load handler address low byte
1556  AF5F 7E                   LD A,(HL)
1557  AF60 2C                   INC L
1558  AF61                      ; load handler address high byte -> HL = handler entry
1559  AF61 66                   LD H,(HL)
1560  AF62 6F                   LD L,A
1561  AF63 C9                   RET
1562  AF64              ; ----------------------------------------------------------------------
1563  AF64              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1564  AF64              ;   In:  A = byte/flag. Out: none (prints via CONOUT_DISPATCH=CONOUT-class writer).
1565  AF64              ;   Algorithm: if A is positive (bit7 clear) just print it; if negative, first print
1566  AF64              ;   the prefix char from the config block (Apple $0397) then print A. Called twice from
1567  AF64              ;   the boot path to emit two config-derived sign-on chars before the banner. [RE]
1568  AF64              ; ----------------------------------------------------------------------
1569  AF64              SIGNON_EMIT:
1570  AF64 B7                   OR A
1571  AF65                      ; bit7 clear -> emit the char directly
1572  AF65 F2 70 AF             JP P,SIGNON_EMIT_CHAR
1573  AF68 F5                   PUSH AF
1574  AF69                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1575  AF69 3A 97 F3             LD A,($F397)
1576  AF6C                      ; emit the prefix char
1577  AF6C CD 42 AB             CALL CONOUT_DISPATCH
1578  AF6F F1                   POP AF
1579  AF70              SIGNON_EMIT_CHAR:
1580  AF70                      ; tail-call to emit the original char
1581  AF70 C3 42 AB             JP CONOUT_DISPATCH
1582  AF73              ; ----------------------------------------------------------------------
1583  AF73              ; SIGNON_BANNER -- the cold-boot sign-on string, printed char-by-char by the boot path
1584  AF73              ;   (loop at DEV_INSTALL_7) until the $00 terminator. Reads:
1585  AF73              ;   'Apple ][ CP/M' / '44K Ver. 2.20' / '(C) 1980 Microsoft', CR/LF separated. DATA.
1586  AF73              ; ----------------------------------------------------------------------
1587  AF73              SIGNON_BANNER:
1588  AF73 0D 0A 0D 0A          DEFB    "\r\n\r\n\r\n"
1588  AF77 0D 0A
1589  AF79 41 70 70 6C          DEFB    "Apple ][ CP/M"          ; string
1589  AF7D 65 20 5D 5B
1589  AF81 20 43 50 2F
1589  AF85 4D
1590  AF86 0D                   DEFB    $0D                      ; terminator
1591  AF87 0A                   DEFB    "\n"
1592  AF88                      ; memory token (CFG_56K) + version token (V220B); the +1 'B' is offset by
1593  AF88                      ; dropping a CR in the tail below so the banner stays 59 bytes either way.
1594  AF88                  IFDEF CFG_56K
1595  AF88 ~                    DEFB    "56K"
1596  AF88                  ELSE
1597  AF88 34 34 4B             DEFB    "44K"
1598  AF8B                  ENDIF
1599  AF8B 20 56 65 72          DEFB    " Ver. 2.20"
1599  AF8F 2E 20 32 2E
1599  AF93 32 30
1600  AF95                  IFDEF V220B
1601  AF95 ~                    DEFB    "B"                      ; 2.20B sub-revision
1602  AF95                  ENDIF
1603  AF95 0D                   DEFB    $0D                      ; terminator
1604  AF96 0A                   DEFB    "\n"
1605  AF97 28 43 29 20          DEFB    "(C) 1980 Microsoft"     ; string
1605  AF9B 31 39 38 30
1605  AF9F 20 4D 69 63
1605  AFA3 72 6F 73 6F
1605  AFA7 66 74
1606  AFA9 0D                   DEFB    $0D                      ; terminator
1607  AFAA                  IFDEF V220B
1608  AFAA ~                    DEFB    "\n\n\0"                  ; 2.20B: one fewer CR (offsets the 'B')
1609  AFAA                  ELSE
1610  AFAA 0A 0D 0A 00          DEFB    "\n\r\n\0"
1611  AFAE                  ENDIF
1612  AFAE              ; ----------------------------------------------------------------------
1613  AFAE              ; IO_VECTOR_DEFAULTS -- 22-byte (BC=$0016) DATA table of default I/O handler pointers,
1614  AFAE              ;   copied by the boot path (LDIR) into the SoftCard config/vector page at $F380=Apple
1615  AFAE              ;   $0380 when that page is uninitialized ($F381==0). The first 22 bytes are eleven
1616  AFAE              ;   little-endian addresses ($AB0C,$AB12,$AB12,$AC3E,$AC3E,$AD45,$AD45,$AD3F,$AD3F,
1617  AFAE              ;   $AD2B,$AD2B) mirroring console/list/punch/reader/disk handler entry points; only
1618  AFAE              ;   those 22 bytes are copied. This is a DATA pointer table, not relocated code. The
1619  AFAE              ;   bytes past offset 22 ($AFC4 onward) coincidentally re-mirror nearby handler code
1620  AFAE              ;   but are NOT executed from here. [RE] -- see flags.
1621  AFAE              ; ----------------------------------------------------------------------
1622  AFAE              IO_VECTOR_DEFAULTS:
1623  AFAE                  IFDEF V220B
1624  AFAE ~                    ; 2.20B: the CCP_INLEN warm-boot stub overlays the first four (CONST/CONIN/CONOUT)
1625  AFAE ~                    ; vector-default slots. Safe because the LDIR that copies these into the config page
1626  AFAE ~                    ; runs only on an uninitialized page ($F381==0), which the Language-Card loader pre-sets.
1627  AFAE ~                    CALL RPC_TRIGGER
1628  AFAE ~                    XOR A
1629  AFAE ~                    LD (CCP_INLEN),A
1630  AFAE ~                    RET
1631  AFAE                  ELSE
1632  AFAE 0C AB                DEFW    KBD_STATUS_40COL         ; CONST (40-col keyboard status)
1633  AFB0 12 AB                DEFW    CONSOLE_IN_40COL         ; CONIN
1634  AFB2 12 AB                DEFW    CONSOLE_IN_40COL
1635  AFB4 3E AC                DEFW    PUT_CHAR_DE3             ; CONOUT
1636  AFB6                  ENDIF
1637  AFB6 3E AC                DEFW    PUT_CHAR_DE3
1638  AFB8 45 AD                DEFW    DEV_OUT_3                ; LIST/PUNCH/READER stubs
1639  AFBA 45 AD                DEFW    DEV_OUT_3
1640  AFBC 3F AD                DEFW    DEV_OUT_2
1641  AFBE 3F AD                DEFW    DEV_OUT_2
1642  AFC0 2B AD                DEFW    DEV_OUT_1
1643  AFC2 2B AD                DEFW    DEV_OUT_1
1644  AFC4                      ; A dead in-image mirror of the DEV_HANDLER_PTRS table + DEV_HANDLER_LOOKUP /
1645  AFC4                      ; SIGNON_EMIT code (byte-identical to $xF44-$xF67); not referenced or executed. Its
1646  AFC4                      ; embedded in-image address high-bytes relocate with the OS (+$3000 under CFG_56K).
1647  AFC4 42 AB E1 23          DEFB    $42,$AB+(OS_RELOC>>8),$E1,$23,$18,$F3,$DF,$AC+(OS_RELOC>>8),$04,$AD+(OS_RELOC>>8),$31,$AD+(OS_RELOC>>8),$12,$AD+(OS_RELOC>>8),$1C,$AD+(OS_RELOC>>8)
1647  AFC8 18 F3 DF AC
1647  AFCC 04 AD 31 AD
1647  AFD0 12 AD 1C AD
1648  AFD4 21 50 AF 18          DEFB    $21,$50,$AF+(OS_RELOC>>8),$18,$03,$21,$4A,$AF+(OS_RELOC>>8),$87,$85,$6F,$7E,$2C,$66,$6F,$C9
1648  AFD8 03 21 4A AF
1648  AFDC 87 85 6F 7E
1648  AFE0 2C 66 6F C9
1649  AFE4 B7 F2 70 AF          DEFB    $B7,$F2,$70,$AF+(OS_RELOC>>8)
1650  AFE8                  IFDEF V220B
1651  AFE8 ~            WARMBOOT_INLEN_STUB:                     ; 2.20B: warm-boot RPC + clear the CCP staged-command flag
1652  AFE8 ~                    CALL RPC_TRIGGER
1653  AFE8 ~                    XOR A
1654  AFE8 ~                    LD (CCP_INLEN),A
1655  AFE8 ~                    RET
1656  AFE8                  ELSE
1657  AFE8 F5 3A 97 F3          DEFB    $F5,$3A,$97,$F3,$CD,$42,$AB,$F1   ; mirror tail (dead)
1657  AFEC CD 42 AB F1
1658  AFF0                  ENDIF
1659  AFF0              ; ----------------------------------------------------------------------
1660  AFF0              ; READ_SEKSEC -- load the current deblock sector and set flags.
1661  AFF0              ;   In:  none. Out: A = current sector (from BOOT+1=seksec); Z set if sector==0.
1662  AFF0              ;   Clobbers: A. Called by the READ/WRITE deblock path to test/translate the sector.
1663  AFF0              ;   Note BOOT+1 is the post-boot reuse of the BOOT 'LD SP,$0100' operand byte. [RE]
1664  AFF0              ; ----------------------------------------------------------------------
1665  AFF0              READ_SEKSEC:
1666  AFF0                      ; read the current deblock sector (BOOT+1 reused as seksec)
1667  AFF0 3A A9 AE             LD A,(BOOT+1)
1668  AFF3                      ; set Z/sign flags on the sector value for the caller
1669  AFF3 B7                   OR A
1670  AFF4 C9                   RET
1671  AFF5                  IFDEF V220B
1672  AFF5 ~                    ; 2.20B overlays the leading "\r\n\r\nAppl" of this dead fragment with a 3rd stub copy
1673  AFF5 ~                    CALL RPC_TRIGGER
1674  AFF5 ~                    XOR A
1675  AFF5 ~                    LD (CCP_INLEN),A
1676  AFF5 ~                    RET
1677  AFF5 ~                    DEFB    "e ]"
1678  AFF5                  ELSE
1679  AFF5 0D 0A 0D 0A          DEFB    "\r\n\r\nApple ]"
1679  AFF9 41 70 70 6C
1679  AFFD 65 20 5D
1680  B000                  ENDIF
1681  B000              BIOS_IMAGE_END:                          ; first byte past the BIOS image
1682  B000
1683  B000                  IFNDEF CPM_LINK
1684  B000                  ; image size from its bracketing labels (no magic length); $AA00 = the ORG base
1685  B000                  SAVEBIN "{out_bin}", BIOS_FBASE, BIOS_IMAGE_END - BIOS_FBASE
1686  B000                  ENDIF
1687  B000
1688  B000              ; ----------------------------------------------------------------------
1689  B000              ; BDOS scratch overlay -- the SECOND tenant of $AEBA-$AFE1 (CFG_56K: +$3000).
1690  B000              ;   Those bytes are the one-shot cold-boot / sign-on code above. It runs once at cold
1691  B000              ;   start; only afterwards does the disk system reuse them as the buffers DPH_TABLE
1692  B000              ;   hands out. The two tenants are never live at the same time, which is why a
1693  B000              ;   post-boot RAM dump shows those pages clobbered.
1694  B000              ;
1695  B000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1696  B000              ;   at the overlay base, then one label per field with its extent carried in the
1697  B000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1698  B000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1699  B000              ;   the image, and the ORG leaves the emitted output untouched. Being BIOS_FBASE
1700  B000              ;   relative, it also relocates with CFG_56K.
1701  B000              ;
1702  B000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1703  B000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1704  B000              ;   cold boot has finished. The sizes are the DPB's own values, so they cannot drift
1705  B000              ;   from the DPB this BIOS publishes. [RE]
1706  B000              ; ----------------------------------------------------------------------
1707  B000              DRIVES       EQU 6                    ; six DPH entries in DPH_TABLE
1708  B000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1709  B000              ALV_SIZE     EQU 127 / 8 + 1          ; = 16; 127 is DSM, the highest allocation block number
1710  B000              CSV_SIZE     EQU 12                   ; = CKS
1711  B000
1712  B000                      ORG BIOS_FBASE + $04BA        ; the one given: where the author placed the overlay
1713  AEBA              DIRBUF:                               ; shared directory buffer, one per system ($AEBA)
1714  AEBA                      ORG DIRBUF + DIRBUF_SIZE
1715  AF3A              ALV_VECTORS:                          ; per-drive allocation vectors ($AF3A..)
1716  AF3A                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1717  AF9A              CSV_VECTORS:                          ; per-drive checksum vectors ($AF9A..)
1718  AF9A                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1719  AFE2              BIOS_SCRATCH_END:                     ; first byte past the overlay ($AFE2)
1720  AFE2
1721  AFE2                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1722  AFE2                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1723  AFE2                  ASSERT ALV_VECTORS == BIOS_FBASE + $053A
1724  AFE2                  ASSERT CSV_VECTORS == BIOS_FBASE + $059A
1725  AFE2                  ASSERT BIOS_SCRATCH_END <= BIOS_IMAGE_END
1726  AFE2
# file closed: CPM_BIOS.asm

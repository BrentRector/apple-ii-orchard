 979  9F47              ; BDOS_ERR_SELECT -- enter the BDOS disk-error handler via the error-vector table.
 980  9F47              ;   In: none (uses the fixed error-vector list at BDOS_ERR_VECTORS).
 981  9F47              ;   Out: transfers to the indexed error routine (does not return normally).  Clobbers: HL, DE.
 982  9F47              ;   Algorithm: point HL at the error-vector table entry (BDOS_ERRVEC_SELECT) and fall into the
 983  9F47              ;              dispatch-by-pointer tail BDOS_VECTOR_JUMP. [RE] One of the BDOS_ERR_VECTORS entry
 984  9F47              ;              points.
 985  9F47              ;   [?] Exact reason-code mapping is encoded by which vector slot the caller chose.
 986  9F47              ; ----------------------------------------------------------------------
 987  9F47              BDOS_ERR_SELECT:
 988  9F47 21 0B 9C             LD HL,BDOS_ERRVEC_SELECT
 989  9F4A              ; ----------------------------------------------------------------------
 990  9F4A              ; BDOS_VECTOR_JUMP -- jump through a 2-byte pointer pointed to by HL.
 991  9F4A              ;   In: HL -> a little-endian routine pointer.  Out: control transferred to (HL); does not return
 992  9F4A              ;       here.
 993  9F4A              ;   Clobbers: DE, HL.
 994  9F4A              ;   Algorithm: load DE from (HL), EX DE,HL, JP (HL) -- an indirect call/jump. [RE] Shared
 995  9F4A              ;              indirect-dispatch
 996  9F4A              ;              tail used by the BDOS error/random-record paths.
 997  9F4A              ; ----------------------------------------------------------------------
 998  9F4A              BDOS_VECTOR_JUMP:
 999  9F4A 5E                   LD E,(HL)
1000  9F4B 23                   INC HL
1001  9F4C 56                   LD D,(HL)
1002  9F4D EB                   EX DE,HL
1003  9F4E E9                   JP (HL)
1004  9F4F              ; ----------------------------------------------------------------------
1005  9F4F              ; BLOCK_COPY_INCC -- copy (C+1) bytes from (DE) to (HL); pre-increment entry.
1006  9F4F              ;   In: C = count-1, DE = source, HL = destination.  Out: bytes copied; DE/HL advanced past the
1007  9F4F              ;       block.
1008  9F4F              ;   Clobbers: AF, C, DE, HL.
1009  9F4F              ;   Algorithm: INC C so the following DEC-C-test loop runs C+1 times, copying one byte per pass.
1010  9F4F              ;   [RE] Small memory-copy helper used by the BDOS DPB / random-record setup.
1011  9F4F              ; ----------------------------------------------------------------------
1012  9F4F              BLOCK_COPY_INCC:
1013  9F4F 0C                   INC C
1014  9F50              ; ----------------------------------------------------------------------
1015  9F50              ; BLOCK_COPY_LOOP -- byte-copy loop body for BLOCK_COPY_INCC.
1016  9F50              ;   In: C = remaining count, DE = source, HL = destination.  Out: copies bytes until C decrements to
1017  9F50              ;       zero.
1018  9F50              ;   Clobbers: AF, C, DE, HL.
1019  9F50              ;   Algorithm: DEC C; if zero return; copy (DE)->(HL); INC DE; INC HL; loop. [RE]

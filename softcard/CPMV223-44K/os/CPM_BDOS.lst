 888  9EFE              ; F_CONSTAT_H -- BDOS function 11 handler: get console status.
 889  9EFE              ;   In: none.  Out: BDOS result = 1 if a console char is ready, else 0.  Clobbers: AF.
 890  9EFE              ;   Algorithm: CON_POLL_STATUS to test readiness (handling Ctrl-S/Ctrl-C), then fall into
 891  9EFE              ;              BDOS_RET_RESULT to store the 0/1 status. [RE] Dispatch entry for function 11.
 892  9EFE              ; ----------------------------------------------------------------------
 893  9EFE              F_CONSTAT_H:
 894  9EFE CD 23 9D             CALL CON_POLL_STATUS
 895  9F01              ; ----------------------------------------------------------------------
 896  9F01              ; BDOS_RET_RESULT -- store A as the BDOS function return value and return.
 897  9F01              ;   In: A = result byte.  Out: BDOS_RETVAL (BDOS return cell) = A.  Clobbers: none beyond the cell.
 898  9F01              ;   Algorithm: write A to the return-value cell; common tail of many handlers. The bare RET at $9F04
 899  9F01              ;              (the next byte) is the dispatch-table target for fns 38/39 (the 2.20 twin names that
 900  9F01              ;              RET
 901  9F01              ;              'BDOS_RET_NOP'). [RE] The BDOS result sink read by BDOS_DISPATCH on exit.
 902  9F01              ; ----------------------------------------------------------------------
 903  9F01              BDOS_RET_RESULT:
 904  9F01 32 45 9F             LD (BDOS_RETVAL),A
 905  9F04 C9                   RET
 906  9F05              ; ----------------------------------------------------------------------
 907  9F05              ; BDOS_RET_ONE -- set the BDOS return value to 1 and exit.
 908  9F05              ;   In: none.  Out: BDOS result (BDOS_RETVAL) = 1.  Clobbers: AF.
 909  9F05              ;   Algorithm: load A=1 and join BDOS_RET_RESULT. [RE] Used by handlers reporting a fixed 1.
 910  9F05              ; ----------------------------------------------------------------------
 911  9F05              BDOS_RET_ONE:
 912  9F05 3E 01                LD A,$01
 913  9F07 C3 01 9F             JP BDOS_RET_RESULT
 914  9F0A              ; ----------------------------------------------------------------------
 915  9F0A              ; CON_SAVED_COL -- saved cursor column for line-editor redisplay/reposition.
 916  9F0A              ;   Also doubles as a 'suppress status-poll/echo' flag inside CON_PUT_COL.
 917  9F0A              ;   [RE] BDOS console state byte; zero when not repositioning.
 918  9F0A              ; ----------------------------------------------------------------------
 919  9F0A              CON_SAVED_COL:
 920  9F0A 00                   DEFB    "\0"
 921  9F0B              ; ----------------------------------------------------------------------
 922  9F0B              ; CON_LINE_START_COL -- column at the start of the current input line (echoed-count base).
 923  9F0B              ;   [RE] Used by the line editor to know how far back Ctrl-X / DEL may erase.
 924  9F0B              ; ----------------------------------------------------------------------
 925  9F0B              CON_LINE_START_COL:
 926  9F0B 00                   DEFB    "\0"
 927  9F0C              ; ----------------------------------------------------------------------
 928  9F0C              ; CON_COL -- current console output column counter.
 929  9F0C              ;   [RE] Incremented per printable char, reset by LF; drives tab expansion and editing.
 930  9F0C              ; ----------------------------------------------------------------------
 931  9F0C              CON_COL:
 932  9F0C 00                   DEFB    "\0"
 933  9F0D              ; ----------------------------------------------------------------------
 934  9F0D              ; CON_LIST_ECHO -- printer (list device) echo flag; nonzero => mirror console output.
 935  9F0D              ;   [RE] Toggled by the line editor's Ctrl-P.
 936  9F0D              ; ----------------------------------------------------------------------
 937  9F0D              CON_LIST_ECHO:
 938  9F0D 00                   DEFB    "\0"

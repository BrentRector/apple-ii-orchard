 942  9F0E              ; ----------------------------------------------------------------------
 943  9F0E              CON_PENDING_CHAR:
 944  9F0E 00                   DEFB    "\0"
 945  9F0F              ; ----------------------------------------------------------------------
 946  9F0F              ; BDOS_SAVED_SP -- caller's stack pointer saved on BDOS entry (then BDOS-local stack slack).
 947  9F0F              ;   [RE] BDOS_DISPATCH saves SP here and switches to the BDOS-local stack; restored on exit. The
 948  9F0F              ;        trailing DEFS reserves the BDOS local stack space below BDOS_USER_NUM.
 949  9F0F              ; ----------------------------------------------------------------------
 950  9F0F              BDOS_SAVED_SP:
 951  9F0F 00 00 00...          DEFS    50, $00                  ; fill
 952  9F41              ; ----------------------------------------------------------------------
 953  9F41              ; BDOS_USER_NUM -- top of the BDOS private stack (SP loaded here on entry).
 954  9F41              ;   [RE] BDOS_DISPATCH does LD SP,BDOS_USER_NUM before dispatching a function.
 955  9F41              ; ----------------------------------------------------------------------
 956  9F41              BDOS_USER_NUM:
 957  9F41 00                   DEFB    "\0"
 958  9F42              ; ----------------------------------------------------------------------
 959  9F42              ; BDOS_CUR_DRIVE -- current selected drive index (0=A) for error reporting and disk ops.
 960  9F42              ;   [RE] Used to form the error-banner drive letter and as the drive arg in random-record / DPB
 961  9F42              ;   setup.
 962  9F42              ; ----------------------------------------------------------------------
 963  9F42              BDOS_CUR_DRIVE:
 964  9F42 00                   DEFB    "\0"
 965  9F43              ; ----------------------------------------------------------------------
 966  9F43              ; BDOS_PARAM_PTR -- saved DE parameter pointer from the BDOS call (FCB / DMA / buffer).
 967  9F43              ;   [RE] BDOS_DISPATCH stashes the incoming DE here; consumers reload it as the operand pointer.
 968  9F43              ;   16-bit cell.
 969  9F43              ; ----------------------------------------------------------------------
 970  9F43              BDOS_PARAM_PTR:
 971  9F43 00 00                DEFB    "\0\0"
 972  9F45              ; ----------------------------------------------------------------------
 973  9F45              ; BDOS_RETVAL -- BDOS function return value (16-bit: low byte = A result, high = B).

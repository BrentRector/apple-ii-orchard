# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.23 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 2.23-44K BIOS runs at z80 $FA00-$FFFF (6 pages) = Apple $0A00-$0FFF LOW RAM
   5  0000              ; (NOT $AA00 like 2.20 -- a different mechanism). Decoded against the de-skewed
   6  0000              ; runtime image; the disk producer re-applies the sector skew (deskew.py ::
   7  0000              ; BIOS_PAGE_TO_SECTOR_223). $FA00 = the 15-entry BIOS jump vector.
   8  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
   9  0000              ; being enriched to the C-level bar.
  10  0000              ; ============================================================================
  11  0000
  12  0000                  IFNDEF CPM_LINK
  13  0000                  DEVICE NOSLOT64K
  14  0000                  ORG $FA00
  15  FA00                  ENDIF
  16  FA00
  17  FA00              ; ----------------------------------------------------------------------
  18  FA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector (2.23-44K, runtime $FA00).
  19  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  20  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  21  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  22  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  23  FA00              ;   Note: the CONOUT target ($FB4D) is the second-instruction entry of
  24  FA00              ;         CONOUT_DISPATCH (skips its leading LD C,A); see flags. [RE]
  25  FA00              ; ----------------------------------------------------------------------
  26  FA00              BIOS_VECTOR:
  27  FA00                      ; entry 0 = cold boot (BOOT, lives in the $FE85 band, out of this scope)
  28  FA00 C3 D1 FE             JP BOOT
  29  FA03              ; ----------------------------------------------------------------------
  30  FA03              ; BIOS_VECTOR_WBOOT -- jump-table entries 1..14 (WBOOT .. WRITE).
  31  FA03              ;   Same 14-entry layout as the 2.20-44K twin; only the target addresses move
  32  FA03              ;   ($FA-band, not $AA). CONOUT ($FA0C) targets CONOUT_DISPATCH+1 ($FB4D). [RE]
  33  FA03              ; ----------------------------------------------------------------------
  34  FA03              BIOS_VECTOR_WBOOT:
  35  FA03                      ; jump table
  36  FA03                      ; entry 1 = WBOOT: reload CCP, rebuild page zero
  37  FA03 C3 B8 FA             JP      WBOOT
  38  FA06                      ; entry 2 = CONST: console status via IOBYTE
  39  FA06 C3 10 FB             JP      CONST
  40  FA09                      ; entry 3 = CONIN: dispatch + function/arrow remap
  41  FA09 C3 1A FB             JP      CONIN
  42  FA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  43  FA0C C3 4D FB             JP      $FB4D
  44  FA0F                      ; entry 5 = LIST: route by IOBYTE LIST field
  45  FA0F C3 70 FB             JP      LIST
  46  FA12                      ; entry 6 = PUNCH: route by IOBYTE PUNCH field
  47  FA12 C3 7F FB             JP      PUNCH
  48  FA15                      ; entry 7 = READER: route by IOBYTE READER field
  49  FA15 C3 91 FB             JP      READER
  50  FA18                      ; entry 8 = HOME (out of this scope, $FDB0 band)
  51  FA18 C3 6C FE             JP      HOME
  52  FA1B                      ; entry 9 = SELDSK (out of this scope, $FE85 band)
  53  FA1B C3 8E FE             JP      SELDSK
  54  FA1E                      ; entry 10 = SETTRK (out of this scope, $FE77)
  55  FA1E C3 77 FE             JP      $FE77
  56  FA21                      ; entry 11 = SETSEC: store sector into deblock scratch
  57  FA21 C3 F4 FB             JP      SETSEC
  58  FA24                      ; entry 12 = SETDMA: store DMA address into deblock scratch
  59  FA24 C3 F9 FB             JP      SETDMA
  60  FA27                      ; entry 13 = READ (out of this scope, $FE85 band)
  61  FA27 C3 BD FE             JP      READ
  62  FA2A                      ; entry 14 = WRITE (out of this scope, $FE85 band)
  63  FA2A C3 C0 FE             JP      WRITE
  64  FA2D              ; ----------------------------------------------------------------------
  65  FA2D              ; The last two jump-table slots are not JPs: both handlers are short enough to sit
  66  FA2D              ; INLINE in the table, which is legal because nothing after entry 16 needs a fixed
  67  FA2D              ; offset. They used to be dumped here as an opaque DEFB run described as a
  68  FA2D              ; "post-vector trailer ... not reached as code here", which was wrong twice over:
  69  FA2D              ; the BDOS reaches both through the jump table, and the bytes are ordinary Z-80. [RE]
  70  FA2D              ; ----------------------------------------------------------------------
  71  FA2D              ; LISTST -- entry 15: return the list device's ready status.
  72  FA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
  73  FA2D              ;   Algorithm: XOR A / RET. A is $00 whatever the printer is doing. Under the
  74  FA2D              ;     CP/M 2.2 convention $00 means NOT ready and $FF means ready, so this
  75  FA2D              ;     reports "not ready" unconditionally.
  76  FA2D              ;     That is the whole of what these two bytes support. WHO consults LISTST, and
  77  FA2D              ;     what they do with the answer, is NOT determinable from this image, and the
  78  FA2D              ;     SoftCard manual set in softcard/reference/ does not document LISTST at all
  79  FA2D              ;     -- so no claim is made here about callers or about anything blocking. Same two bytes in the 2.20-44K and 2.23-60K twins. [RE]
  80  FA2D              ; ----------------------------------------------------------------------
  81  FA2D              LISTST:
  82  FA2D AF                   XOR A
  83  FA2E C9                   RET
  84  FA2F 00                   DEFB    $00                      ; pad: realigns SECTRAN onto the 3-byte slot grid
  85  FA30              ; ----------------------------------------------------------------------
  86  FA30              ; SECTRAN -- entry 16: logical-to-physical sector translate (identity).
  87  FA30              ;   In:  BC = logical sector, DE = translate-table address (ignored).
  88  FA30              ;   Out: HL = BC (physical == logical).  Clobbers: H, L.
  89  FA30              ;   Algorithm: LD H,B / LD L,C / RET. The DPH XLT field is 0 for every drive, so the
  90  FA30              ;     BDOS asks for no translation and this returns its argument unchanged; the skew
  91  FA30              ;     is applied by the disk producer, off-image. Same three bytes in both twins. [RE]
  92  FA30              ; ----------------------------------------------------------------------
  93  FA30              SECTRAN:
  94  FA30 60                   LD H,B
  95  FA31 69                   LD L,C
  96  FA32 C9                   RET
  97  FA33              ; ----------------------------------------------------------------------
  98  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
  99  FA33              ;   drive 0..3; 2.23 supports 4 drives, vs 6 in the 2.20 twin). SELDSK returns
 100  FA33              ;   DPH_TABLE + 16*drive. Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV,
 101  FA33              ;   ALV. XLT = 0 (no SECTRAN translate). All drives share one DIRBUF and one DPB.
 102  FA33              ;   The per-drive strides are the DPB's own fields: CSV is CKS = 12 bytes, ALV is
 103  FA33              ;   DSM/8 + 1 = 139/8 + 1 = 18 bytes. [RE]
 104  FA33              ; ----------------------------------------------------------------------
 105  FA33              ; DIRBUF, ALV_VECTORS and CSV_VECTORS are the BDOS scratch buffers this table hands out.
 106  FA33              ; They are declared at the foot of this file (see "BDOS scratch overlay"), because they
 107  FA33              ; are a SECOND tenant of bytes the cold-boot code owns: the layout is set out there with
 108  FA33              ; its own ORG, so each field is a real label rather than a magic address.
 109  FA33              DPH_TABLE:
 110  FA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
 110  FA37 00 00 00 00
 110  FA3B E4 FE 73 FA
 110  FA3F AC FF 64 FF
 111  FA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+18   ; drive 1
 111  FA47 00 00 00 00
 111  FA4B E4 FE 73 FA
 111  FA4F B8 FF 76 FF
 112  FA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+36   ; drive 2
 112  FA57 00 00 00 00
 112  FA5B E4 FE 73 FA
 112  FA5F C4 FF 88 FF
 113  FA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+54   ; drive 3
 113  FA67 00 00 00 00
 113  FA6B E4 FE 73 FA
 113  FA6F D0 FF 9A FF
 114  FA73              ; ----------------------------------------------------------------------
 115  FA73              ; DPB -- the shared Disk Parameter Block (5.25" floppy; every DPH points here).
 116  FA73              ;   One label per field, so the field names are symbols rather than prose. The ten names
 117  FA73              ;   are Digital Research's CP/M 2.2 DPB field names. Not [DOC]-citable from THIS archive
 118  FA73              ;   -- the SoftCard set bundles DRI's CP/M 2.2 *Reference Manual*, which documents only
 119  FA73              ;   the BDOS call that RETURNS a DPB pointer (fn 31, Get Addr (disk parms)), not the
 120  FA73              ;   block's layout. The layout IS normatively specified by a DRI manual not in the box:
 121  FA73              ;   the CP/M 2.2 *Alteration Guide* (1979), sec. Disk Parameter Tables. SoftCard CP/M is
 122  FA73              ;   licensed DRI CP/M 2.2, so that manual governs this block. [DOC CPMAG "Disk Parameter
 123  FA73              ;   Tables"]  NOTE: the Guide defines every field but NEVER spells the acronyms out; the
 124  FA73              ;   expansions in the comments below are the conventional readings, not DRI's. [?]
 125  FA73              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 126  FA73              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track. [RE]
 127  FA73              ;   This block is byte-identical to the 2.20-44K twin's except for DSM (see below). [RE]
 128  FA73              ; ----------------------------------------------------------------------
 129  FA73              DPB:
 130  FA73 20 00        SPT:    DEFW    $0020                    ; Sectors Per Track: counts 128-byte RECORDS, not 256-byte sectors -> 32
 131  FA75 03           BSH:    DEFB    $03                      ; Block SHift: log2(records per block) -> 8 records
 132  FA76 07           BLM:    DEFB    $07                      ; BLock Mask: (records per block) - 1 -> 1 KB blocks
 133  FA77 00           EXM:    DEFB    $00                      ; EXtent Mask
 134  FA78              ; DSM is the ONLY byte in which this DPB differs from the 2.20-44K twin ($7F there).
 135  FA78              ;   The arithmetic does not close: 140 blocks / 4 blocks per track = 35 tracks of file
 136  FA78              ;   area, which with OFF=3 implies a 38-track disk; the medium is 35 tracks total. The
 137  FA78              ;   twin's $7F gives 32 + 3 = 35 exactly. What absorbs the surplus is a directory entry
 138  FA78              ;   present on every 2.23 disk: user byte $1F, lowercase name "cp/m    sys", allocation
 139  FA78              ;   list exactly blocks 128-139 -- the twelve blocks past the twin's 128. The BDOS's
 140  FA78              ;   allocation-vector rebuild skips only $E5 entries and does not range-check the user
 141  FA78              ;   number, so that entry is honoured and those twelve blocks stay marked in use.
 142  FA78              ;   RESOLVED (2026-07-31), and the answer is neither: BLOCKS 128-139 ARE THE SYSTEM TRACKS.
 143  FA78              ;   The 2.23 deblock (CPM_BootLoader_DiskXlate.asm, SM_NOFLUSH at $BCDA) folds any requested
 144  FA78              ;   track >= 35 back by 35, GATED ON THE DPB's DSM BYTE BEING $8B. The arithmetic is exact:
 145  FA78              ;   block 128 -> record 1024 -> OFF + 1024/SPT = track 35 -> 0; block 139 -> track 37 -> 2.
 146  FA78              ;   Twelve blocks = 12 KB = tracks 0,1,2 = 12,288 bytes, no remainder. So DSM=$8B deliberately
 147  FA78              ;   extends the disk by exactly the reserved area, making it addressable through the ordinary
 148  FA78              ;   file system, and "cp/m    sys" is the directory entry that NAMES it. The gate is the proof
 149  FA78              ;   of intent: a defensive clamp would not need to test DSM.
 150  FA78              ;   That entry is written by two shipped tools -- CPM60.COM (CPMV223-60K/CPM60_installer.asm)
 151  FA78              ;   and COPY.COM on its /S path (CPMV223-44K/utilities/COPY.asm $037F).
 152  FA78              ;   On a DATA disk the aliasing is the point: it recovers the boot area as 12 KB of usable
 153  FA78              ;   storage. [DOC CiderPress2 CP/M format notes] describes this same entry independently and
 154  FA78              ;   attributes the technique to the Microsoft SoftCard, "used to allow extra storage on
 155  FA78              ;   non-bootable disks".
 156  FA78              ;   CONSEQUENCE, and the hazard is SPECIFIC: a disk carrying a boot image but NOT the
 157  FA78              ;   protecting entry -- every 2.20-lineage system disk (DSM=$7F, so it never needed one) read
 158  FA78              ;   on a 2.23 system. Once blocks 0-127 are full the allocator hands out 128-139, and the write
 159  FA78              ;   does not fail and does not reach a drive error: it SILENTLY OVERWRITES TRACKS 0-2 and
 160  FA78              ;   destroys the boot pipeline. Verified in the emulator: SAVE into block 128 reported success
 161  FA78              ;   and changed 689 bytes of track 0. A non-bootable data disk is NOT at risk. See
 162  FA78              ;   docs/CPM_Disk_Creation.md and docs/CPM_Source_Changes_For_Narratives.md Parts 5 and 7. [RE]
 163  FA78 8B 00        DSM:    DEFW    $008B                    ; Disk Size Max: highest allocation block number: 139 -> 140 blocks
 164  FA7A 2F 00        DRM:    DEFW    $002F                    ; DiRectory Max: highest directory entry number: 47 -> 48 entries
 165  FA7C C0           AL0:    DEFB    $C0                      ; ALlocation bitmap, directory-reserved blocks, high byte -> 2
 166  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 167  FA7E 0C 00        CKS:    DEFW    $000C                    ; ChecKSum: directory checksum bytes
 168  FA80 03 00        OFF:    DEFW    $0003                    ; OFFset: reserved tracks before the file area
 169  FA82              ; ----------------------------------------------------------------------
 170  FA82              ; PROBE_DEVICES -- scan the SoftCard device/config area and mark presence.
 171  FA82              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 172  FA82              ;   Out: config bytes updated in place; per-device init called when a device is found.
 173  FA82              ;   Clobbers: A,DE,HL.
 174  FA82              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E].  If it equals 3 the slot
 175  FA82              ;     holds a recognized device, so call SLOT_IO_ADDR and store $03 then $15 into the
 176  FA82              ;     cell to flag it configured.  A secondary DEC A test (original value 4, e.g. a
 177  FA82              ;     Videx-class 80-col console) runs SET_SCREEN_BASE and claims the $C800 shared
 178  FA82              ;     expansion-ROM window via RPC_TRIGGER; a value-2 path repoints a vector via
 179  FA82              ;     PLOT_CHAR_RPC ($0DD0 param).  Same shape as the 2.20 twin's PROBE_DEVICES. [RE]
 180  FA82              ; ----------------------------------------------------------------------
 181  FA82              PROBE_DEVICES:
 182  FA82                      ; DE = 7 entries to scan (index walks down to 1)
 183  FA82 11 07 00             LD DE,$0007
 184  FA85              PROBE_DEVICES_LOOP:
 185  FA85                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 186  FA85 21 B8 F3             LD HL,$F3B8
 187  FA88 19                   ADD HL,DE
 188  FA89 7E                   LD A,(HL)
 189  FA8A                      ; config value 3 = a recognized/present device in this slot
 190  FA8A D6 03                SUB $03
 191  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 192  FA8E                      ; build the slot I/O base for the found device (SLOT_IO_ADDR)
 193  FA8E CD 81 FE             CALL SLOT_IO_ADDR
 194  FA91                      ; rewrite the cell: $03 then $15 = mark this device configured
 195  FA91 36 03                LD (HL),$03
 196  FA93 36 15                LD (HL),$15
 197  FA95              PROBE_DEVICES_CHK4:
 198  FA95                      ; after the SUB, A==1 means the original value was 4 (Videx-class 80-col console)
 199  FA95 3D                   DEC A
 200  FA96 20 0B                JR NZ,PROBE_DEVICES_CHK2
 201  FA98                      ; console probe / select the 80-col screen base (SET_SCREEN_BASE)
 202  FA98 CD 83 FD             CALL SET_SCREEN_BASE
 203  FA9B                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 204  FA9B 21 00 C8             LD HL,$C800
 205  FA9E CD 45 FB             CALL RPC_TRIGGER
 206  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 207  FAA3              PROBE_DEVICES_CHK2:
 208  FAA3                      ; value 2 = a different device class (e.g. printer/serial); takes the PLOT_CHAR_RPC path
 209  FAA3 FE 02                CP $02
 210  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 211  FAA7                      ; param for the value-2 vector init ($0DD0)
 212  FAA7 21 D0 0D             LD HL,$0DD0
 213  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 214  FAAD              PROBE_DEVICES_NEXT:
 215  FAAD                      ; next config entry; loop until all 7 scanned
 216  FAAD 1D                   DEC E
 217  FAAE 20 D5                JR NZ,PROBE_DEVICES_LOOP
 218  FAB0 C9                   RET
 219  FAB1              ; ----------------------------------------------------------------------
 220  FAB1              ; DEVICE_IO_BASE -- form a SoftCard I/O / soft-switch address from a device/offset index.
 221  FAB1              ;   In:  E = low offset within the I/O page.
 222  FAB1              ;   Out: HL = ((E | $E0) << 8), an address in z80 $E000-$EFFF = Apple I/O $C000-$CFFF;
 223  FAB1              ;        A clobbered.
 224  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 225  FAB1              ;        page, then H = A.  Used to reach keyboard / soft switches / slot I/O.
 226  FAB1              ;        Same as the 2.20 twin's DEVICE_IO_BASE (distinct from SLOT_IO_ADDR at $FE81). [RE]
 227  FAB1              ; ----------------------------------------------------------------------
 228  FAB1              DEVICE_IO_BASE:
 229  FAB1                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 230  FAB1 21 00 E0             LD HL,$E000
 231  FAB4 7B                   LD A,E
 232  FAB5                      ; force the high byte into the $C0xx I/O range
 233  FAB5 B4                   OR H
 234  FAB6 67                   LD H,A
 235  FAB7 C9                   RET
 236  FAB8              ; ----------------------------------------------------------------------
 237  FAB8              ; WBOOT -- CP/M warm boot: re-init the console, rebuild page zero, re-enter the CCP.
 238  FAB8              ;   In:  none.  Out: jumps to the CCP at $9300; does not return.  Clobbers: all.
 239  FAB8              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 240  FAB8              ;     (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 241  FAB8              ;     PROBE_DEVICES.  If the CCP image signature at $9C08 is intact ($9C) it falls
 242  FAB8              ;     into PAGEZERO_REBUILD; otherwise it reloads the CCP/system via a page-zero JP.
 243  FAB8              ;   Note: 2.23 reloads through a self-built $000B jump and enters the CCP at $9300
 244  FAB8              ;     (the 2.20 twin used $9400). [RE]
 245  FAB8              ; ----------------------------------------------------------------------
 246  FAB8              WBOOT:
 247  FAB8                      ; stack at the default DMA buffer top (page-zero $0080)
 248  FAB8 31 80 00             LD SP,$0080
 249  FABB                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 250  FABB 3A 51 E0             LD A,($E051)
 251  FABE 21 00 0E             LD HL,$0E00
 252  FAC1                      ; re-init the console I/O vectors (RPC_TRIGGER) for warm restart
 253  FAC1 CD 45 FB             CALL RPC_TRIGGER
 254  FAC4                      ; re-scan devices so warm boot rebuilds the I/O table
 255  FAC4 CD 82 FA             CALL PROBE_DEVICES
 256  FAC7                      ; read the CCP-image signature byte at $9C08
 257  FAC7 3A 08 9C             LD A,($9C08)
 258  FACA                      ; signature $9C present = CCP image intact, skip the reload
 259  FACA FE 9C                CP $9C
 260  FACC 28 11                JR Z,PAGEZERO_REBUILD
 261  FACE 21 59 FF             LD HL,SIGNON_PRINT
 262  FAD1 22 D0 F3             LD ($F3D0),HL
 263  FAD4 2A DE F3             LD HL,($F3DE)
 264  FAD7 3E 77                LD A,$77
 265  FAD9                      ; plant a $77 byte at page-zero $000B to bridge into the reload path
 266  FAD9 32 0B 00             LD ($000B),A
 267  FADC                      ; jump into the self-built page-zero reload bridge
 268  FADC C3 0B 00             JP $000B
 269  FADF              ; ----------------------------------------------------------------------
 270  FADF              ; PAGEZERO_REBUILD -- clear the CCP-restart flag, then write the page-zero hooks.
 271  FADF              ;   In:  none.  Out: falls into CCP_LAUNCH; no return.  Clobbers: A,HL,BC.
 272  FADF              ;   Algorithm: zero the CCP restart flag at $9307, then (PAGEZERO_REBUILD_HOOKS)
 273  FADF              ;     plant JP ($C3) at $0000 -> the BIOS WBOOT entry (BIOS_VECTOR+3, BIOS_VECTOR_WBOOT) and
 274  FADF              ;     JP at $0005 -> the BDOS entry $9C06; clear two self-modified BIOS state cells
 275  FADF              ;     ($FEDD/$FED8); set the default DMA to $0080 via SETDMA. [RE]
 276  FADF              ; ----------------------------------------------------------------------
 277  FADF              PAGEZERO_REBUILD:
 278  FADF AF                   XOR A
 279  FAE0                      ; clear the CCP restart/cold flag at $9307
 280  FAE0 32 07 93             LD ($9307),A
 281  FAE3              PAGEZERO_REBUILD_HOOKS:
 282  FAE3 AF                   XOR A
 283  FAE4                      ; clear a self-modified BIOS state cell ($FEDD)
 284  FAE4 32 DD FE             LD (BOOT_TMPL_IOBYTE),A
 285  FAE7                      ; clear a self-modified BIOS state cell ($FED8)
 286  FAE7 32 D8 FE             LD (DISK_HSTACT),A
 287  FAEA                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 288  FAEA 3E C3                LD A,$C3
 289  FAEC                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 290  FAEC 32 00 00             LD ($0000),A
 291  FAEF                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 292  FAEF 21 03 FA             LD HL,BIOS_VECTOR_WBOOT
 293  FAF2 22 01 00             LD ($0001),HL
 294  FAF5                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 295  FAF5 32 05 00             LD ($0005),A
 296  FAF8                      ; BDOS entry point ($9C06) for the $0005 hook
 297  FAF8 21 06 9C             LD HL,$9C06
 298  FAFB 22 06 00             LD ($0006),HL
 299  FAFE                      ; default DMA address = $0080 (page-zero buffer)
 300  FAFE 01 80 00             LD BC,$0080
 301  FB01                      ; install the default DMA pointer (SETDMA)
 302  FB01 CD F9 FB             CALL SETDMA
 303  FB04              ; ----------------------------------------------------------------------
 304  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, jump to the CCP.
 305  FB04              ;   In:  none.  Out: JP $9300 (CCP cold/warm entry); no return.  Clobbers: A,C.
 306  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $974E, pass the current default
 307  FB04              ;     drive (page-zero $0004) in C, and jump to the CCP at $9300. [RE]
 308  FB04              ; ----------------------------------------------------------------------
 309  FB04              CCP_LAUNCH:
 310  FB04                      ; CCP-mode flag value
 311  FB04 3E 01                LD A,$01
 312  FB06                      ; store the CCP entry/mode flag into CCP workspace at $974E
 313  FB06 32 4E 97             LD ($974E),A
 314  FB09                      ; page-zero $0004 = current default drive byte
 315  FB09 3A 04 00             LD A,($0004)
 316  FB0C 4F                   LD C,A
 317  FB0D                      ; enter the CCP at $9300, C = default drive (2.20 used $9400)
 318  FB0D C3 00 93             JP $9300
 319  FB10              ; ----------------------------------------------------------------------
 320  FB10              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 321  FB10              ;   In:  none.  Out: A = $FF (ready) / $00 (not).  Clobbers: A,HL.
 322  FB10              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 323  FB10              ;     cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler, which
 324  FB10              ;     returns the status in A.  Same as the 2.20 twin's CONST. [RE]
 325  FB10              ; ----------------------------------------------------------------------
 326  FB10              CONST:
 327  FB10                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 328  FB10 2A 80 F3             LD HL,($F380)
 329  FB13                      ; dispatch to the selected console-status handler (returns A)
 330  FB13 E9                   JP (HL)
 331  FB14              ; ----------------------------------------------------------------------
 332  FB14              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 333  FB14              ;   In:  none.  Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 334  FB14              ;   Clobbers: A.
 335  FB14              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard register; RLA shifts bit 7
 336  FB14              ;     (key-ready) into carry; SBC A,A expands carry to $FF/$00.  The built-in 40-col
 337  FB14              ;     CONST path used when no Videx/80-col card supplies the status vector. [RE]
 338  FB14              ; ----------------------------------------------------------------------
 339  FB14              KBD_STATUS_40COL:
 340  FB14                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 341  FB14 3A 00 E0             LD A,($E000)
 342  FB17                      ; rotate key-ready bit 7 into carry
 343  FB17 17                   RLA
 344  FB18                      ; carry -> A = $FF (ready) or $00 (none)
 345  FB18 9F                   SBC A,A
 346  FB19 C9                   RET
 347  FB1A              ; ----------------------------------------------------------------------
 348  FB1A              ; CONIN -- read a console character: IOBYTE-route the input, then remap the key.
 349  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,DE,HL.
 350  FB1A              ;   Algorithm: CALL CONIN_DISPATCH to fetch a raw key (routed by the IOBYTE CONSOLE
 351  FB1A              ;     field); clear the high bit; then scan a small remap table at Apple $03AB
 352  FB1A              ;     (z80 $F3AB) of up to 6 entries (function/arrow keys), returning the paired
 353  FB1A              ;     replacement byte on a match, else the raw key.
 354  FB1A              ;   Note: 2.23's CONIN jump-vector entry runs this remap wrapper; the 2.20 twin's
 355  FB1A              ;     equivalent is CONSOLE_IN_40COL.  Differs from a bare dispatcher. [RE]
 356  FB1A              ; ----------------------------------------------------------------------
 357  FB1A              CONIN:
 358  FB1A                      ; fetch a raw key in A via the IOBYTE-routed CONIN dispatcher
 359  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 360  FB1D                      ; strip the high bit (7-bit ASCII)
 361  FB1D E6 7F                AND $7F
 362  FB1F                      ; HL = key-remap table base (z80 $F3AB = Apple $03AB; first entry pair at $03AC)
 363  FB1F 21 AB F3             LD HL,$F3AB
 364  FB22                      ; up to 6 remap-table entries
 365  FB22 06 06                LD B,$06
 366  FB24                      ; C = raw key
 367  FB24 4F                   LD C,A
 368  FB25              ; ----------------------------------------------------------------------
 369  FB25              ; CONIN_XLATE_LOOP -- scan the function/arrow-key remap table.
 370  FB25              ;   In:  C = raw key; B = entry count; HL -> table base.
 371  FB25              ;   Out: A = translated key on match (returns), else loops; A = C on table end.
 372  FB25              ;   Algorithm: each entry = [match byte, replacement byte]; a high-bit sentinel
 373  FB25              ;     match byte ends the table. [RE]
 374  FB25              ; ----------------------------------------------------------------------
 375  FB25              CONIN_XLATE_LOOP:
 376  FB25 23                   INC HL
 377  FB26                      ; entry's match byte
 378  FB26 7E                   LD A,(HL)
 379  FB27 23                   INC HL
 380  FB28 B7                   OR A
 381  FB29                      ; high-bit sentinel ends the table
 382  FB29 FA 31 FB             JP M,CONIN_XLATE_DONE
 383  FB2C                      ; raw key == this entry?
 384  FB2C B9                   CP C
 385  FB2D                      ; paired replacement byte
 386  FB2D 7E                   LD A,(HL)
 387  FB2E                      ; match -> return the translated key
 388  FB2E C8                   RET Z
 389  FB2F 10 F4                DJNZ CONIN_XLATE_LOOP
 390  FB31              ; ----------------------------------------------------------------------
 391  FB31              ; CONIN_XLATE_DONE -- no remap match: return the raw key in A. [RE]
 392  FB31              ; ----------------------------------------------------------------------
 393  FB31              CONIN_XLATE_DONE:
 394  FB31                      ; no match -> return the raw key
 395  FB31 79                   LD A,C
 396  FB32 C9                   RET
 397  FB33              ; ----------------------------------------------------------------------
 398  FB33              ; CONIN_KEYWAIT -- seed the keyboard-wait dispatch index, then wait for a key.
 399  FB33              ;   In:  none.  Out: A = 7-bit key (via KBD_WAIT_KEY).  Clobbers: A,DE.
 400  FB33              ;   Algorithm: load DE = 3 (the default console index), then JP through the
 401  FB33              ;     self-modified CONIN_DISPATCH cell; at boot that target is patched to the
 402  FB33              ;     selected keyboard-wait handler (default KBD_WAIT_KEY). [RE]
 403  FB33              ; ----------------------------------------------------------------------
 404  FB33              CONIN_KEYWAIT:
 405  FB33                      ; DE = 3 = default console-device index
 406  FB33 11 03 00             LD DE,$0003
 407  FB36              ; ----------------------------------------------------------------------
 408  FB36              ; CONIN_DISPATCH -- self-modified keyboard-wait vector.
 409  FB36              ;   The JP target ($FB39 / KBD_WAIT_KEY by default) is patched at boot per the
 410  FB36              ;   selected console card.  Referenced as CONIN_DISPATCH+1 by the patch site. [RE]
 411  FB36              ; ----------------------------------------------------------------------
 412  FB36              CONIN_DISPATCH:
 413  FB36                      ; target (CONIN_DISPATCH+1) patched at boot to the chosen keyboard-wait handler
 414  FB36 C3 39 FB             JP KBD_WAIT_KEY
 415  FB39              ; ----------------------------------------------------------------------
 416  FB39              ; KBD_WAIT_KEY -- spin on the Apple keyboard register until a key is down.
 417  FB39              ;   In:  none.  Out: A = 7-bit key (high bit cleared).  Clobbers: A.
 418  FB39              ;   Algorithm: poll z80 $E000 = Apple $C000; RLA puts key-ready (bit 7) into carry,
 419  FB39              ;     spin while clear; on a key, clear the strobe at $E010 = Apple $C010 and return
 420  FB39              ;     the 7-bit key (CCF/RRA). [RE]
 421  FB39              ; ----------------------------------------------------------------------
 422  FB39              KBD_WAIT_KEY:
 423  FB39                      ; poll z80 $E000 = Apple $C000 keyboard register
 424  FB39 3A 00 E0             LD A,($E000)
 425  FB3C                      ; key-ready (bit 7) -> carry
 426  FB3C 17                   RLA
 427  FB3D                      ; spin until a key is down
 428  FB3D 30 FA                JR NC,KBD_WAIT_KEY
 429  FB3F                      ; clear the keyboard strobe (z80 $E010 = Apple $C010)
 430  FB3F 32 10 E0             LD ($E010),A
 431  FB42 3F                   CCF
 432  FB43                      ; A = 7-bit key
 433  FB43 1F                   RRA
 434  FB44 C9                   RET
 435  FB45              ; ----------------------------------------------------------------------
 436  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC.
 437  FB45              ;   In:  HL = command/params; A = trigger value.  Out: per the 6502 service routine.
 438  FB45              ;   Algorithm: stash HL to the command mailbox (z80 $F3D0 = Apple $03D0), then poke
 439  FB45              ;     the trigger cell.  The trigger store-address ($0000 here) is self-modified per
 440  FB45              ;     config at boot, so the store site is RPC_TRIGGER_STORE+1. [RE]
 441  FB45              ; ----------------------------------------------------------------------
 442  FB45              RPC_TRIGGER:
 443  FB45                      ; z80 $F3D0 = Apple $03D0 = RPC command/params mailbox
 444  FB45 22 D0 F3             LD ($F3D0),HL
 445  FB48              RPC_TRIGGER_STORE:
 446  FB48 32 00 00             LD ($0000),A
 447  FB4B C9                   RET
 448  FB4C              ; ----------------------------------------------------------------------
 449  FB4C              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE.
 450  FB4C              ;   In:  A = character (the BIOS CONOUT arg).  The jump-vector CONOUT entry targets
 451  FB4C              ;        CONOUT_DISPATCH+1 ($FB4D), skipping the leading LD C,A; the fall-through
 452  FB4C              ;        entry here (from the dispatcher) keeps it.
 453  FB4C              ;   Out: none.  Clobbers: A,C,HL.
 454  FB4C              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03).  Field
 455  FB4C              ;     value 2 dispatches through the SoftCard I/O vector at $F392 (Apple $0392) with
 456  FB4C              ;     JP (HL); otherwise fall into the column/tab filter. [RE]
 457  FB4C              ; ----------------------------------------------------------------------
 458  FB4C              CONOUT_DISPATCH:
 459  FB4C                      ; save the character to emit in C for the filter path (skipped by the +1 entry)
 460  FB4C 4F                   LD C,A
 461  FB4D                      ; read the CP/M IOBYTE (page-zero $0003)
 462  FB4D 3A 03 00             LD A,($0003)
 463  FB50                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 464  FB50 E6 03                AND $03
 465  FB52                      ; device value 2 = direct console; anything else takes the filter path
 466  FB52 FE 02                CP $02
 467  FB54 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 468  FB56              CONOUT_VIA_VEC_F392:
 469  FB56                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 470  FB56 2A 92 F3             LD HL,($F392)
 471  FB59 E9                   JP (HL)
 472  FB5A              ; ----------------------------------------------------------------------
 473  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE CONSOLE field.
 474  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 475  FB5A              ;   Algorithm: read IOBYTE, mask the CONSOLE field (AND $03).  Value 2 uses vector
 476  FB5A              ;     $F38A; the high value ($02<x) uses the preloaded $F384; low values use $F382;
 477  FB5A              ;     then JP (HL) into the chosen handler.  ($F38x = Apple $038x I/O vector.)
 478  FB5A              ;     Called by CONIN (the remap wrapper) and reused by READER. [RE]
 479  FB5A              ; ----------------------------------------------------------------------
 480  FB5A              CONIN_DISPATCH_IOBYTE:
 481  FB5A                      ; read the CP/M IOBYTE
 482  FB5A 3A 03 00             LD A,($0003)
 483  FB5D                      ; isolate the 2-bit CONSOLE device field
 484  FB5D E6 03                AND $03
 485  FB5F FE 02                CP $02
 486  FB61                      ; preload the input vector for the high CONSOLE value ($F384 = Apple $0384)
 487  FB61 2A 84 F3             LD HL,($F384)
 488  FB64 28 06                JR Z,CONIN_VIA_VEC_F38A
 489  FB66 30 07                JR NC,DISPATCH_VIA_HL
 490  FB68              CONIN_VIA_VEC_F382:
 491  FB68                      ; input vector for the low CONSOLE values ($F382 = Apple $0382)
 492  FB68 2A 82 F3             LD HL,($F382)
 493  FB6B E9                   JP (HL)
 494  FB6C              CONIN_VIA_VEC_F38A:
 495  FB6C                      ; input vector for CONSOLE value 2 ($F38A = Apple $038A)
 496  FB6C 2A 8A F3             LD HL,($F38A)
 497  FB6F              DISPATCH_VIA_HL:
 498  FB6F E9                   JP (HL)
 499  FB70              ; ----------------------------------------------------------------------
 500  FB70              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 501  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 502  FB70              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0).  Below $80
 503  FB70              ;     routes to the column/tab filter; == $80 reuses the console vector path
 504  FB70              ;     (CONOUT_VIA_VEC_F392); higher values dispatch through list vector $F394
 505  FB70              ;     (Apple $0394). [RE]
 506  FB70              ; ----------------------------------------------------------------------
 507  FB70              LIST:
 508  FB70 3A 03 00             LD A,($0003)
 509  FB73                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 510  FB73 E6 C0                AND $C0
 511  FB75 FE 80                CP $80
 512  FB77                      ; field < $80 -> no-device / filter path
 513  FB77 38 27                JR C,DISPATCH_NODEV
 514  FB79                      ; field == $80 -> reuse the console output vector path
 515  FB79 28 DB                JR Z,CONOUT_VIA_VEC_F392
 516  FB7B                      ; list-handler vector ($F394 = Apple $0394)
 517  FB7B 2A 94 F3             LD HL,($F394)
 518  FB7E E9                   JP (HL)
 519  FB7F              ; ----------------------------------------------------------------------
 520  FB7F              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 521  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 522  FB7F              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30).  Below $10 takes the
 523  FB7F              ;     column/tab filter; == $10 dispatches through vector $F38E; higher values use
 524  FB7F              ;     vector $F390.  ($F38E/$F390 = Apple $038E/$0390.) [RE]
 525  FB7F              ; ----------------------------------------------------------------------
 526  FB7F              PUNCH:
 527  FB7F 3A 03 00             LD A,($0003)
 528  FB82                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 529  FB82 E6 30                AND $30
 530  FB84 FE 10                CP $10
 531  FB86                      ; field < $10 -> no-device / filter path
 532  FB86 38 18                JR C,DISPATCH_NODEV
 533  FB88                      ; punch vector for the higher PUNCH values ($F38E = Apple $038E)
 534  FB88 2A 8E F3             LD HL,($F38E)
 535  FB8B                      ; field == $10 -> use the $F390 vector below
 536  FB8B 28 E2                JR Z,DISPATCH_VIA_HL
 537  FB8D                      ; punch vector for PUNCH value $10 ($F390 = Apple $0390)
 538  FB8D 2A 90 F3             LD HL,($F390)
 539  FB90 E9                   JP (HL)
 540  FB91              ; ----------------------------------------------------------------------
 541  FB91              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 542  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 543  FB91              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C), compare against $08. Field
 544  FB91              ;     < $08 ($00/$04) reuses the CONIN $F382 vector; == $08 reuses the CONIN $F38A vector;
 545  FB91              ;     > $08 ($0C) uses the reader vector $F38C (Apple $038C). [RE]
 546  FB91              ; ----------------------------------------------------------------------
 547  FB91              READER:
 548  FB91 3A 03 00             LD A,($0003)
 549  FB94                      ; isolate the 2-bit READER device field of the IOBYTE
 550  FB94 E6 0C                AND $0C
 551  FB96 FE 08                CP $08
 552  FB98                      ; field < $08 ($00/$04) -> reuse the CONIN $F382 vector path
 553  FB98 38 CE                JR C,CONIN_VIA_VEC_F382
 554  FB9A                      ; field == $08 -> reuse the CONIN $F38A vector path
 555  FB9A 28 D0                JR Z,CONIN_VIA_VEC_F38A
 556  FB9C                      ; reader-handler vector ($F38C = Apple $038C)
 557  FB9C 2A 8C F3             LD HL,($F38C)
 558  FB9F E9                   JP (HL)
 559  FBA0              ; ----------------------------------------------------------------------
 560  FBA0              ; DISPATCH_NODEV -- IOBYTE field selects no physical device: fall into the filter.
 561  FBA0              ;   In:  carry set by the caller (no-device).  Out: enters CONOUT_FILTER_NOEXPAND
 562  FBA0              ;        with the carry folded into the COL_FLAG byte.  Clobbers: A,HL.
 563  FBA0              ;   Algorithm: SCF then (CONOUT_FILTER_NOEXPAND) SBC A,A turns carry into a 0/$FF
 564  FBA0              ;     flag stored in COL_FLAG ($FECB); clear bit 7 of the char in C; if the pending-
 565  FBA0              ;     column counter ($FECC) is nonzero, apply a config-driven column offset, else
 566  FBA0              ;     fall through to the tab/control expansion (SETDMA_1). [RE]
 567  FBA0              ; ----------------------------------------------------------------------
 568  FBA0              DISPATCH_NODEV:
 569  FBA0                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 570  FBA0 37                   SCF
 571  FBA1              CONOUT_FILTER_NOEXPAND:
 572  FBA1                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 573  FBA1 9F                   SBC A,A
 574  FBA2 21 A2 F3             LD HL,$F3A2
 575  FBA5 6E                   LD L,(HL)
 576  FBA6 2C                   INC L
 577  FBA7 CA A4 FC             JP Z,SCREEN_EMIT
 578  FBAA                      ; HL -> COL_FLAG cell ($FECB)
 579  FBAA 21 CB FE             LD HL,COL_FLAG
 580  FBAD                      ; store the entry flag into COL_FLAG
 581  FBAD 77                   LD (HL),A
 582  FBAE                      ; strip the high bit of the character (7-bit ASCII)
 583  FBAE CB B9                RES 7,C
 584  FBB0 23                   INC HL
 585  FBB1                      ; load COL_PENDING (pending column-skip / fill count, $FECC)
 586  FBB1 7E                   LD A,(HL)
 587  FBB2 B7                   OR A
 588  FBB3                      ; no pending column work -> run tab/control expansion
 589  FBB3 CA 56 FC             JP Z,SETDMA_1
 590  FBB6                      ; consume one pending column step
 591  FBB6 35                   DEC (HL)
 592  FBB7                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 593  FBB7 3A 96 F3             LD A,($F396)
 594  FBBA                      ; HL -> the column cell in the $FE85 deblock/screen-state band ($FED4)
 595  FBBA 21 D4 FE             LD HL,BOOT_TMPL_XORA
 596  FBBD                      ; config byte zero -> derive the offset from the running width
 597  FBBD 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 598  FBBF B7                   OR A
 599  FBC0 F2 C6 FB             JP P,COL_APPLY_OFFSET_RAW
 600  FBC3 2B                   DEC HL
 601  FBC4              ; ----------------------------------------------------------------------
 602  FBC4              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 603  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 604  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 605  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude, subtract it from the
 606  FBC4              ;     current column in C, store the new column.  Reached when the config byte's sign
 607  FBC4              ;     indicates a subtractive column adjust. [RE]
 608  FBC4              ; ----------------------------------------------------------------------
 609  FBC4              COL_APPLY_OFFSET:
 610  FBC4                      ; drop the sign bit to get the offset magnitude
 611  FBC4 E6 7F                AND $7F
 612  FBC6              COL_APPLY_OFFSET_RAW:
 613  FBC6 5F                   LD E,A
 614  FBC7 79                   LD A,C
 615  FBC8                      ; new column = current column (C) minus the offset
 616  FBC8 93                   SUB E
 617  FBC9                      ; store the updated column position
 618  FBC9 77                   LD (HL),A
 619  FBCA C9                   RET
 620  FBCB              ; ----------------------------------------------------------------------
 621  FBCB              ; COL_OFFSET_FROM_WIDTH -- derive the column offset from the running screen width.
 622  FBCB              ;   In:  C = current column; the BOOT-overlaid base word at (BOOT+2).
 623  FBCB              ;   Out: updates the column and emits via SCREEN_EMIT; combines a base address with
 624  FBCB              ;        the offset.  Clobbers: A,B,C,DE,HL.
 625  FBCB              ;   Algorithm: pick the column cell by the config sign, CALL COL_APPLY_OFFSET, then
 626  FBCB              ;     load the base word (BOOT+2 = the cold-boot operand reused as deblock
 627  FBCB              ;     scratch), fold in config $F3A1, and ADD to form the screen address before
 628  FBCB              ;     emitting (SCREEN_EMIT). [RE]
 629  FBCB              ; ----------------------------------------------------------------------
 630  FBCB              COL_OFFSET_FROM_WIDTH:
 631  FBCB B7                   OR A
 632  FBCC                      ; config sign negative -> keep the higher column cell
 633  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH_1
 634  FBCF 2B                   DEC HL
 635  FBD0              COL_OFFSET_FROM_WIDTH_1:
 636  FBD0                      ; apply the signed column offset (COL_APPLY_OFFSET)
 637  FBD0 CD C4 FB             CALL COL_APPLY_OFFSET
 638  FBD3                      ; base word = the BOOT-overlaid deblock scratch ($FED3)
 639  FBD3 2A D3 FE             LD HL,(BOOT+2)
 640  FBD6                      ; config byte $F3A1 = Apple $03A1 (screen-base modifier)
 641  FBD6 3A A1 F3             LD A,($F3A1)
 642  FBD9 B7                   OR A
 643  FBDA                      ; config positive -> use HL as-is, skip the byte swap
 644  FBDA F2 E2 FB             JP P,COL_COMBINE_BASE
 645  FBDD                      ; negative: drop the sign bit, then swap H<->L below
 646  FBDD E6 7F                AND $7F
 647  FBDF 5D                   LD E,L
 648  FBE0 6C                   LD L,H
 649  FBE1 63                   LD H,E
 650  FBE2              ; ----------------------------------------------------------------------
 651  FBE2              ; COL_COMBINE_BASE -- fold the config offset into the base address, emit the char.
 652  FBE2              ;   In:  A = config offset; HL = base word; C will receive the high result.
 653  FBE2              ;   Out: pushes the low result, emits via SCREEN_EMIT with B=7, then re-enters the
 654  FBE2              ;        emit path with B=$0A.  Clobbers: A,B,C,DE,HL.
 655  FBE2              ;   Algorithm: C = offset + H; A = offset + L; CALL SCREEN_EMIT (B=7), then fall into
 656  FBE2              ;     CONOUT_EMIT_B with B=$0A. [RE]
 657  FBE2              ; ----------------------------------------------------------------------
 658  FBE2              COL_COMBINE_BASE:
 659  FBE2 5F                   LD E,A
 660  FBE3                      ; C = config offset + base high byte
 661  FBE3 84                   ADD A,H
 662  FBE4 4F                   LD C,A
 663  FBE5 7B                   LD A,E
 664  FBE6                      ; A = config offset + base low byte
 665  FBE6 85                   ADD A,L
 666  FBE7 F5                   PUSH AF
 667  FBE8                      ; mode/count code 7 for the screen emit
 668  FBE8 06 07                LD B,$07
 669  FBEA                      ; emit via the screen handler (SCREEN_EMIT)
 670  FBEA CD A4 FC             CALL SCREEN_EMIT
 671  FBED F1                   POP AF
 672  FBEE                      ; mode/count code $0A for the follow-up emit
 673  FBEE 06 0A                LD B,$0A
 674  FBF0              CHAR_C_TO_SCREEN:
 675  FBF0 4F                   LD C,A
 676  FBF1 C3 A4 FC             JP SCREEN_EMIT
 677  FBF4              ; ----------------------------------------------------------------------
 678  FBF4              ; SETSEC -- BIOS jump-vector entry 11 ($FA24 -> $FBF4): set the requested sector.
 679  FBF4              ;   In:  C = sector number. Out: none. Clobbers: A.
 680  FBF4              ;   Algorithm: store C into the sector cell BOOT+1 ($FED2 = the cold-boot LD SP operand
 681  FBF4              ;        low byte, reused post-boot as the requested-sector cell). The off-image RWTS
 682  FBF4              ;        ($AC39/$AC49) is the consumer; this image only WRITES it. Mirrors 2.20 SETSEC.
 683  FBF4              ;        [RE, transferred from 2.20; the off-image consumer is not in this image]
 684  FBF4              ; ----------------------------------------------------------------------
 685  FBF4              SETSEC:
 686  FBF4 79                   LD A,C
 687  FBF5                      ; store the requested sector into BOOT+1 (reused as the seksec cell)
 688  FBF5 32 D2 FE             LD (BOOT+1),A
 689  FBF8 C9                   RET
 690  FBF9              ; ----------------------------------------------------------------------
 691  FBF9              ; SETDMA -- BIOS jump-vector entry 12 ($FA27 -> $FBF9): set the DMA address.
 692  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 693  FBF9              ;   Out: none. Clobbers: none.
 694  FBF9              ;   Algorithm: store BC into the dmaadr cell (SECTOR_BLOCK_PATCH+2 = $FEE1, the
 695  FBF9              ;        operand region of the install-template 'LD ($0003),A'). The OFF-IMAGE
 696  FBF9              ;        deblock copy uses dmaadr as the host<->record transfer endpoint. The 2.20
 697  FBF9              ;        deblock did the LDIR itself; in 2.23 the value is read off-image. [RE]
 698  FBF9              ; ----------------------------------------------------------------------
 699  FBF9              SETDMA:
 700  FBF9                      ; store BC into dmaadr ($FEE1, overlaid on the install-template LD ($0003),A operand)
 701  FBF9 ED 43 E1 FE          LD (DISK_DMAADR+2),BC
 702  FBFD C9                   RET
 703  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 704  FC56              SETDMA_1:
 705  FC56 47                   LD B,A
 706  FC57 21 CD FE             LD HL,COL_STATE
 707  FC5A 7E                   LD A,(HL)
 708  FC5B 5F                   LD E,A
 709  FC5C B7                   OR A
 710  FC5D 20 12                JR NZ,SETDMA_3
 711  FC5F 3A 97 F3             LD A,($F397)
 712  FC62 B7                   OR A
 713  FC63 28 06                JR Z,SETDMA_2
 714  FC65 B9                   CP C
 715  FC66 20 03                JR NZ,SETDMA_2
 716  FC68 36 80                LD (HL),$80
 717  FC6A C9                   RET
 718  FC6B              SETDMA_2:
 719  FC6B 3E 1F                LD A,$1F
 720  FC6D B9                   CP C
 721  FC6E DA A4 FC             JP C,SCREEN_EMIT
 722  FC71              SETDMA_3:
 723  FC71 21 A0 F3             LD HL,$F3A0
 724  FC74 06 09                LD B,$09
 725  FC76              SETDMA_4:
 726  FC76 7E                   LD A,(HL)
 727  FC77 B7                   OR A
 728  FC78 28 04                JR Z,SETDMA_5

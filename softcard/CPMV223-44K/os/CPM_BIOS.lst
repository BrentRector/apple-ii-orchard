 802  FD9C 1E 03                LD E,$03
 803  FD9E 3E 01                LD A,$01
 804  FDA0 CD AD FD             CALL SET_CURSOR_COL_AND_BASE
 805  FDA3 3A 48 F0             LD A,($F048)
 806  FDA6 1F                   RRA
 807  FDA7 9F                   SBC A,A

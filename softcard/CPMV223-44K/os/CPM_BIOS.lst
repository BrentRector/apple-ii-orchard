 848  FDC1              ; SCREEN_RPC_HELPER -- read back a screen byte via the RPC: position, fire the RPC, fetch.
 849  FDC1              SCREEN_RPC_HELPER:
 850  FDC1 CD 83 FD             CALL SET_SCREEN_BASE                    ; compute the screen base for the current row
 851  FDC4 21 4D C8             LD HL,$C84D                      ; 6502 RPC parameter (Apple expansion-ROM addr)

 836  FDC1              ; SCREEN_RPC_HELPER -- read back a screen byte via the RPC: position, fire the RPC, fetch.
 837  FDC1              SCREEN_RPC_HELPER:
 838  FDC1 CD 83 FD             CALL SET_SCREEN_BASE                    ; compute the screen base for the current row
 839  FDC4 21 4D C8             LD HL,$C84D                      ; 6502 RPC parameter (Apple expansion-ROM addr)
 840  FDC7 CD 45 FB             CALL RPC_TRIGGER                 ; run the embedded 6502 service on the 6502
 841  FDCA 21 78 F6             LD HL,$F678                      ; HL = row buffer base (Apple $0678)
 842  FDCD 19                   ADD HL,DE
 843  FDCE 7E                   LD A,(HL)                        ; read back the character
 844  FDCF C9                   RET
 845  FDD0              ; RPC6502_SERVICE_223 -- the embedded 6502 RPC service ($FDD0-$FE41 = Apple $0DD0); its
 846  FDD0              ; own ca65 source CPM_RPC6502_223.s is sub-assembled and INCBIN'd here (the 2.20
 847  FDD0              ; CPM_RPC6502 pattern). It forms a slot-ROM pointer ($CFFF disables expansion ROM),
 848  FDD0              ; LDA ($F6),Y, and JMP ($00F6) dispatches into the selected slot-ROM/firmware routine.
 849  FDD0              RPC6502_SERVICE_223:
 850  FDD0              ;   >>> CPM_RPC6502_223.s -- verbatim listing of the INCBIN'd source (regen: inject_incbin_listing) >>>
 851  FDD0              ;
 852  FDD0              ; .org $0DD0
 853  FDD0              ;
 854  FDD0              ; L_0DD0:
 855  FDD0              ;         PHA                          ; $0DD0  48
 856  FDD0              ;         JSR SUB_0E1D                 ; $0DD1  20 1D 0E
 857  FDD0              ;         LDY #$0D                     ; $0DD4  A0 0D
 858  FDD0              ; L_0DD6:
 859  FDD0              ;         LDA ($F6),Y                  ; $0DD6  B1 F6
 860  FDD0              ;         STA $F6                      ; $0DD8  85 F6
 861  FDD0              ;         LDY $06F8                    ; $0DDA  AC F8 06
 862  FDD0              ;         PLA                          ; $0DDD  68
 863  FDD0              ;         JMP ($00F6)                ; $0DDE  6C F6 00
 864  FDD0              ; L_0DE1:
 865  FDD0              ;         PHA                          ; $0DE1  48
 866  FDD0              ;         LDA #$00                     ; $0DE2  A9 00
 867  FDD0              ;         JSR SUB_0DEF                 ; $0DE4  20 EF 0D
 868  FDD0              ;         JSR SUB_0E1D                 ; $0DE7  20 1D 0E
 869  FDD0              ;         LDY #$0F                     ; $0DEA  A0 0F
 870  FDD0              ;         JMP L_0DD6                   ; $0DEC  4C D6 0D
 871  FDD0              ; SUB_0DEF:
 872  FDD0              ;         STY $F5                      ; $0DEF  84 F5
 873  FDD0              ;         PHA                          ; $0DF1  48
 874  FDD0              ;         JSR SUB_0E14                 ; $0DF2  20 14 0E
 875  FDD0              ;         PLA                          ; $0DF5  68
 876  FDD0              ;         LDY $F5                      ; $0DF6  A4 F5
 877  FDD0              ;         BCC SUB_0DEF                 ; $0DF8  90 F5
 878  FDD0              ;         RTS                          ; $0DFA  60
 879  FDD0              ;         .byte   $00, $00, $00, $00, $00, $4C, $E9, $BB, $4C, $04, $BE, $A9, $01, $20, $EF, $0D ; $0DFB
 880  FDD0              ;         .byte   $20, $1D, $0E, $48, $A0, $0E, $4C, $D6, $0D      ; $0E0B
 881  FDD0              ; SUB_0E14:
 882  FDD0              ;         PHA                          ; $0E14  48
 883  FDD0              ;         JSR SUB_0E1D                 ; $0E15  20 1D 0E
 884  FDD0              ;         LDY #$10                     ; $0E18  A0 10
 885  FDD0              ;         JMP L_0DD6                   ; $0E1A  4C D6 0D
 886  FDD0              ; SUB_0E1D:
 887  FDD0              ;         TYA                          ; $0E1D  98
 888  FDD0              ;         ORA #$C0                     ; $0E1E  09 C0
 889  FDD0              ;         TAX                          ; $0E20  AA
 890  FDD0              ;         TYA                          ; $0E21  98
 891  FDD0              ;         ASL                          ; $0E22  0A
 892  FDD0              ;         ASL                          ; $0E23  0A
 893  FDD0              ;         ASL                          ; $0E24  0A
 894  FDD0              ;         ASL                          ; $0E25  0A
 895  FDD0              ;         TAY                          ; $0E26  A8
 896  FDD0              ;         STY $06F8                    ; $0E27  8C F8 06
 897  FDD0              ;         LDA #$00                     ; $0E2A  A9 00
 898  FDD0              ;         STA $F6                      ; $0E2C  85 F6
 899  FDD0              ;         STX $F7                      ; $0E2E  86 F7
 900  FDD0              ;         LDA $CFFF                    ; $0E30  AD FF CF
 901  FDD0              ;         LDA ($F6),Y                  ; $0E33  B1 F6
 902  FDD0              ;         RTS                          ; $0E35  60
 903  FDD0              ; SUB_0E1D_1:
 904  FDD0              ;         LDA $48                      ; $0E36  A5 48
 905  FDD0              ;         PHA                          ; $0E38  48
 906  FDD0              ;         LDA $45                      ; $0E39  A5 45
 907  FDD0              ;         LDX $46                      ; $0E3B  A6 46
 908  FDD0              ;         LDY $47                      ; $0E3D  A4 47
 909  FDD0              ;         PLP                          ; $0E3F  28
 910  FDD0              ;         CLI                          ; $0E40  58
 911  FDD0              ;         RTS                          ; $0E41  60
 912  FDD0              ;   <<< end listing <<<
 913  FDD0                      INCBIN "CPM_RPC6502_223.bin"     ; 114 bytes of 6502 (runs on the 6502 via the RPC)
 914  FE42              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 915  FE42              DEV_READ_BIT:
 916  FE42 CD 81 FE             CALL SLOT_IO_ADDR
 917  FE45              DEV_READ_WAIT:
 918  FE45 7E                   LD A,(HL)
 919  FE46 1F                   RRA                              ; ready bit -> carry
 920  FE47 30 FC                JR NC,DEV_READ_WAIT
 921  FE49 2C                   INC L
 922  FE4A 7E                   LD A,(HL)                        ; read the data byte
 923  FE4B C9                   RET
 924  FE4C              DEV_OUT_1:                               ; default I/O vector handler (LIST stub)
 925  FE4C 11 01 00             LD DE,$0001
 926  FE4F              DEV_OUT_1_JP:
 927  FE4F C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 928  FE52              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 929  FE52              DEV_WR_BIT:
 930  FE52 CD B1 FA             CALL DEVICE_IO_BASE
 931  FE55 2E C1                LD L,$C1
 932  FE57              DEV_WR_WAIT:
 933  FE57 7E                   LD A,(HL)
 934  FE58 17                   RLA                              ; ready bit -> carry
 935  FE59 38 FC                JR C,DEV_WR_WAIT
 936  FE5B CD 7C FE             CALL SLOT_IO_ADDR_W
 937  FE5E 71                   LD (HL),C
 938  FE5F              DEV_RET:
 939  FE5F C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 940  FE60              DEV_OUT_2:                               ; default I/O vector handler (PUNCH stub)
 941  FE60 11 02 00             LD DE,$0002
 942  FE63              DEV_OUT_2_JP:
 943  FE63 C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 944  FE66              DEV_OUT_3:                               ; default I/O vector handler (READER stub)
 945  FE66 11 02 00             LD DE,$0002
 946  FE69              DEV_OUT_3_JP:
 947  FE69 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 948  FE6C              ; ----------------------------------------------------------------------
 949  FE6C              ; HOME -- BIOS jump-vector entry 8 ($FA18): seek the selected drive to track 0. [RE]
 950  FE6C              ;   In:  none. Out: none. Clobbers: A,C.
 951  FE6C              ;   Algorithm: if the host buffer still holds a pending write (hstwrt nonzero) leave
 952  FE6C              ;     hstact set so the dirty buffer is not dropped; else clear hstact (host buffer
 953  FE6C              ;     inactive). Then fall through into SETTRK_STORE with track 0. Mirrors the 2.20
 954  FE6C              ;     twin HOME exactly; the actual head step happens later in the deblock path. [RE]
 955  FE6C              ; ----------------------------------------------------------------------
 956  FE6C              HOME:
 957  FE6C                      ; read hstwrt (host-write-pending flag; lives in the BOOT install-template cells)
 958  FE6C 3A D9 FE             LD A,(DISK_HSTWRT)
 959  FE6F B7                   OR A
 960  FE70                      ; pending write -> keep hstact set, skip the clear
 961  FE70 20 03                JR NZ,SETTRK_STORE
 962  FE72                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 963  FE72 32 D8 FE             LD (DISK_HSTACT),A
 964  FE75              ; ----------------------------------------------------------------------
 965  FE75              ; SETTRK_STORE -- HOME falls in here with track 0; common tail with SETTRK. [RE]
 966  FE75              ;   In:  (HOME path) forces C=0. Out: stores sektrk. Clobbers: A,C.
 967  FE75              ;   Algorithm: load C=0, then fall into SETTRK's store (the $FE77 vector body) which
 968  FE75              ;     writes the track into the BOOT 'LD SP' operand byte reused as sektrk. [RE]
 969  FE75              ; ----------------------------------------------------------------------
 970  FE75              SETTRK_STORE:
 971  FE75                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 972  FE75 0E 00                LD C,$00
 973  FE77                      ; SETTRK (vector entry 10, JP $FE77): track number from BDOS in C
 974  FE77 79                   LD A,C
 975  FE78                      ; store sektrk into BOOT's LD SP operand byte (BOOT cell reused post-boot as sektrk)
 976  FE78 32 D1 FE             LD (BOOT),A
 977  FE7B C9                   RET
 978  FE7C              ; ----------------------------------------------------------------------
 979  FE7C              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 980  FE7C              ;   In:  E = slot/drive index (0..15). Out: HL = $E080 + (E<<4). Clobbers: A,L.
 981  FE7C              ;   Algorithm: load the $C08x write/control-bank base (z80 $E080 = Apple $C080), then
 982  FE7C              ;     fall into the shared index scaler (SLOT_IO_SCALE, the ADD A,A x4 at $FE85).
 983  FE7C              ;     Twin of 2.20 SLOT_IO_ADDR_W. [RE]
 984  FE7C              ; ----------------------------------------------------------------------
 985  FE7C              SLOT_IO_ADDR_W:
 986  FE7C                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 987  FE7C 21 80 E0             LD HL,$E080
 988  FE7F 18 03                JR SLOT_IO_SCALE_E
 989  FE81              ; ----------------------------------------------------------------------
 990  FE81              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch base ($C08E bank).
 991  FE81              ;   In:  E = slot/drive index (0..15). Out: HL = $E08E + (E<<4). Clobbers: A,L.
 992  FE81              ;   Algorithm: load the $C08E base, fall into SLOT_IO_SCALE_E. z80 $E08E = Apple $C08E.
 993  FE81              ;     Twin of 2.20 SLOT_IO_ADDR. [RE]
 994  FE81              ; ----------------------------------------------------------------------
 995  FE81              SLOT_IO_ADDR:
 996  FE81                      ; z80 $E08E = Apple $C08E slot-I/O base
 997  FE81 21 8E E0             LD HL,$E08E
 998  FE84              ; ----------------------------------------------------------------------
 999  FE84              ; SLOT_IO_SCALE_E -- load the slot/drive index into A, then fall into SLOT_IO_SCALE.
1000  FE84              ;   In:  E = index. Out: continues into the scaler. Twin of 2.20 SLOT_IO_SCALE_E. [RE]
1001  FE84              ; ----------------------------------------------------------------------
1002  FE84              SLOT_IO_SCALE_E:
1003  FE84                      ; slot/drive index into A for the scaler
1004  FE84 7B                   LD A,E
1005  FE85              ; ----------------------------------------------------------------------
1006  FE85              ; SLOT_IO_SCALE -- shift the index in A left by 4 and add it to L (index a $C0n0..$C0nF
1007  FE85              ;     16-byte slot-I/O block, or a *16-stride table). [RE]
1008  FE85              ;   In:  A = index, L = base low byte. Out: L += A*16; A preserved. Clobbers: A,L.
1009  FE85              ;   Algorithm: ADD A,A four times (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET.
1010  FE85              ;     Shared by SLOT_IO_ADDR/_W and by SELDSK (DPH-table index) and the device probe.
1011  FE85              ;     Twin of 2.20 SLOT_IO_SCALE. [RE]
1012  FE85              ; ----------------------------------------------------------------------
1013  FE85              SLOT_IO_SCALE:
1014  FE85                      ; A *= 16 over the four ADD A,A (slot block is 16 bytes; DPH stride is 16)
1015  FE85 87                   ADD A,A
1016  FE86 87                   ADD A,A
1017  FE87 87                   ADD A,A
1018  FE88 87                   ADD A,A
1019  FE89 F5                   PUSH AF
1020  FE8A                      ; L = base + index*16
1021  FE8A 85                   ADD A,L
1022  FE8B 6F                   LD L,A
1023  FE8C F1                   POP AF
1024  FE8D C9                   RET
1025  FE8E              ; ----------------------------------------------------------------------
1026  FE8E              ; SELDSK -- BIOS jump-vector entry 9 ($FA1B): select the disk drive for subsequent I/O.
1027  FE8E              ;   In:  C = disk number (0-based). Out: HL = DPH address for drive C, or HL=0 if out
1028  FE8E              ;     of range. Clobbers: A,DE,HL.
1029  FE8E              ;   Algorithm: DE -> the sekdsk build site (DISK_SEKDSK, an install-template cell reused
1030  FE8E              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
1031  FE8E              ;     block (z80 $F3B8 = Apple $03B8); if C >= count return HL=0. Else record the disk
1032  FE8E              ;     number, index the DPH table at DPH_TABLE by C*16 (CALL SLOT_IO_SCALE), pull a per-drive
1033  FE8E              ;     disk-parameter byte and self-modify the install template SECTOR_BLOCK_PATCH+1 with it.
1034  FE8E              ;     Twin of 2.20 SELDSK. [RE]
1035  FE8E              ; ----------------------------------------------------------------------
1036  FE8E              SELDSK:
1037  FE8E                      ; DE -> sekdsk build site (install-template cell reused as disk-select scratch)
1038  FE8E 11 D5 FE             LD DE,DISK_SEKDSK
1039  FE91 21 04 00             LD HL,$0004
1040  FE94                      ; configured drive count from the SoftCard config block (Apple $03B8)
1041  FE94 3A B8 F3             LD A,($F3B8)
1042  FE97 3D                   DEC A
1043  FE98                      ; requested drive vs (count-1); carry => out of range
1044  FE98 B9                   CP C
1045  FE99                      ; out of range -> SELDSK_BAD_DRIVE (returns HL=0)
1046  FE99 38 1D                JR C,SELDSK_BAD_DRIVE
1047  FE9B 7E                   LD A,(HL)
1048  FE9C 12                   LD (DE),A
1049  FE9D 13                   INC DE
1050  FE9E 79                   LD A,C
1051  FE9F 12                   LD (DE),A
1052  FEA0                      ; HL = DPH table base ($FA33); CALL SLOT_IO_SCALE indexes it by C*16
1053  FEA0 21 33 FA             LD HL,DPH_TABLE
1054  FEA3 CD 85 FE             CALL SLOT_IO_SCALE
1055  FEA6 E5                   PUSH HL
1056  FEA7 11 0A 00             LD DE,$000A
1057  FEAA 19                   ADD HL,DE
1058  FEAB 5E                   LD E,(HL)
1059  FEAC 23                   INC HL
1060  FEAD 56                   LD D,(HL)
1061  FEAE 21 05 00             LD HL,$0005
1062  FEB1 19                   ADD HL,DE
1063  FEB2 7E                   LD A,(HL)
1064  FEB3                      ; self-modify: store the per-drive disk-parameter byte into the install template's LD
1065  FEB3                      ; HL,(nn) operand [RE]
1066  FEB3 32 E3 FE             LD (SECTOR_BLOCK_PATCH+1),A
1067  FEB6 E1                   POP HL
1068  FEB7 C9                   RET
1069  FEB8              ; ----------------------------------------------------------------------
1070  FEB8              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH). [RE]
1071  FEB8              ;   In:  DE -> sekdsk build site. Out: HL=0. Clobbers: A,L.
1072  FEB8              ;   Twin of 2.20 SELDSK_BAD_DRIVE. [RE]
1073  FEB8              ; ----------------------------------------------------------------------
1074  FEB8              SELDSK_BAD_DRIVE:
1075  FEB8 1A                   LD A,(DE)
1076  FEB9 77                   LD (HL),A
1077  FEBA                      ; HL=0 signals an invalid drive to the BDOS
1078  FEBA 2E 00                LD L,$00
1079  FEBC C9                   RET
1080  FEBD              ; ----------------------------------------------------------------------
1081  FEBD              ; READ -- BIOS jump-vector entry 13 ($FA27): read one 128-byte CP/M record.
1082  FEBD              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1083  FEBD              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS read core at $AC39, which sits
1084  FEBD              ;     in the system-image region BELOW the BIOS (not inside $FA00-$FFFF). FLAG: unlike
1085  FEBD              ;     the 2.20 twin, the 2.23 BIOS does NOT carry the deblock or the $03E0-IOB RWTS RPC
1086  FEBD              ;     in-image; READ/WRITE delegate to the $ACxx host-sector routines. [RE] -- see flags.
1087  FEBD              ; ----------------------------------------------------------------------
1088  FEBD              READ:
1089  FEBD                      ; off-image jump to the deblock/RWTS read core at $AC39 (system-image region, not BIOS) [RE]
1090  FEBD C3 39 AC             JP $AC39
1091  FEC0              ; ----------------------------------------------------------------------
1092  FEC0              ; WRITE -- BIOS jump-vector entry 14 ($FA2A): write one 128-byte CP/M record.
1093  FEC0              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1094  FEC0              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS write core at $AC49 (system-image
1095  FEC0              ;     region below the BIOS). Same off-image RWTS delegation as READ_RECORD. [RE]
1096  FEC0              ;   NOTE: the bytes at $FEC3-$FECA ($C3 $45 $FB $2A $0D $9C $E9 $C9) immediately after
1097  FEC0              ;     this JP are NOT executed on the WRITE path; they are install/handler scratch -- see flags.
1098  FEC0              ; ----------------------------------------------------------------------
1099  FEC0              WRITE:
1100  FEC0                      ; off-image jump to the deblock/RWTS write core at $AC49 (system-image region, not BIOS)
1101  FEC0                      ; [RE]
1102  FEC0 C3 49 AC             JP $AC49
1103  FEC3 C3 45 FB 2A          DEFB    $C3,$45,$FB,$2A,$0D      ; "CE{*"
1103  FEC7 0D
1104  FEC8 9C E9 C9             DEFB    $9C,$E9,$C9
1105  FECB              COL_FLAG:
1106  FECB 00                   DEFB    "\0"
1107  FECC              COL_PENDING:
1108  FECC 00                   DEFB    "\0"
1109  FECD              COL_STATE:
1110  FECD 00                   DEFB    "\0"
1111  FECE              SCREEN_CURSOR_PTR:
1112  FECE D0 FE                DEFB    $D0,$FE
1113  FED0              SCREEN_CHAR:
1114  FED0 00                   DEFB    "\0"
1115  FED1              ; ----------------------------------------------------------------------
1116  FED1              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector entry 0; $FA00 -> here at $FED1).
1117  FED1              ;   In:  none. Out: does not return through here (falls into the install engine).
1118  FED1              ;   Clobbers: all.
1119  FED1              ;   DUAL USE of the operand bytes: this 'LD SP,$0100' executes ONCE at cold boot to set
1120  FED1              ;     the Z-80 stack; afterwards BOOT (the $00 operand byte) is reused as sektrk and
1121  FED1              ;     BOOT+1 as seksec (SETTRK stores BOOT at $FE78, SETSEC stores
1122  FED1              ;     BOOT+1 at $FBF5), and BOOT+2 ($FED3) is read as a console cursor word
1123  FED1              ;     ($FBD3 LD HL,(BOOT+2)). Valid SP-init bytes only during the single cold-boot
1124  FED1              ;     pass; thereafter disk/console scratch, never re-executed. Twin of 2.20 BOOT. [RE]
1125  FED1              ;   Algorithm: set SP, then fall through into the self-modifying install engine
1126  FED1              ;     (BOOT_TMPL_XORA..SECTOR_BLOCK_PATCH are template-instruction cells whose operands double as
1127  FED1              ;     disk-deblock state).
1128  FED1              ; ----------------------------------------------------------------------
1129  FED1              BOOT:
1130  FED1                      ; init Z-80 stack; BOOT/+1/+2 reused post-boot as sektrk/seksec and a console cursor word
1131  FED1 31 00 01             LD SP,$0100
1132  FED4              ; ----------------------------------------------------------------------
1133  FED4              ; BOOT_TMPL_XORA -- cold-boot install template 'XOR A'; operationally a disk-state cell.
1134  FED4              ;   Boot tenant: 'XOR A' clears A as the install engine starts the page-clear. Operational
1135  FED4              ;   tenant: this cell is referenced as a console/disk scratch base (LD HL,BOOT_TMPL_XORA at
1136  FED4              ;   $FBBA in the console path). Twin region of 2.20 DISK_SELDSK_SAVE. [RE]
1137  FED4              ; ----------------------------------------------------------------------
1138  FED4              BOOT_TMPL_XORA:
1139  FED4 AF                   XOR A
1140  FED5              ; ----------------------------------------------------------------------
1141  FED5              ; DISK_SEKDSK -- cold-boot install template 'LD HL,BIOS_VECTOR'; operationally the sekdsk cell.
1142  FED5              ;   Boot tenant: 'LD HL,nn' template the install engine steps over. Operational tenant:
1143  FED5              ;   SELDSK uses DE=DISK_SEKDSK as the sekdsk build site (selected disk number). Twin of
1144  FED5              ;   2.20 DISK_SEKDSK. [RE]
1145  FED5              ; ----------------------------------------------------------------------
1146  FED5              DISK_SEKDSK:
1147  FED5 21 00 FA             LD HL,BIOS_VECTOR
1148  FED8              ; ----------------------------------------------------------------------
1149  FED8              ; DISK_HSTACT -- cold-boot install template 'LD (HL),A'; operationally the hstact flag.
1150  FED8              ;   Boot tenant: part of the page-zero/template clear. Operational tenant: host-buffer-
1151  FED8              ;   active flag, cleared by HOME ($FE72) and by PAGEZERO_REBUILD ($FAE7), set when a host
1152  FED8              ;   sector is staged. Twin of 2.20 DISK_HSTWRT-area hstact. [RE]
1153  FED8              ; ----------------------------------------------------------------------
1154  FED8              DISK_HSTACT:
1155  FED8 77                   LD (HL),A
1156  FED9              ; ----------------------------------------------------------------------
1157  FED9              ; DISK_HSTWRT -- cold-boot install template 'INC HL'; operationally the hstwrt flag.
1158  FED9              ;   Boot tenant: 'INC HL' advances the install-clear pointer. Operational tenant: host-
1159  FED9              ;   buffer-dirty flag, read by HOME ($FE6C). Twin of 2.20 DISK_HSTWRT. [RE]
1160  FED9              ; ----------------------------------------------------------------------
1161  FED9              DISK_HSTWRT:
1162  FED9 23                   INC HL
1163  FEDA 77                   LD (HL),A
1164  FEDB 23                   INC HL
1165  FEDC 77                   LD (HL),A
1166  FEDD              ; ----------------------------------------------------------------------
1167  FEDD              ; BOOT_TMPL_IOBYTE -- cold-boot install template 'LD A,$95' (default IOBYTE immediate).
1168  FEDD              ;   Boot tenant: loads the default IOBYTE value $95 into A. Operational tenant: this cell
1169  FEDD              ;   is cleared by PAGEZERO_REBUILD ($FAE4) and used as a console-state byte. Twin of the
1170  FEDD              ;   2.20 DISK_HSTWRT 'LD A,$95' default-IOBYTE template. [RE]
1171  FEDD              ; ----------------------------------------------------------------------
1172  FEDD              BOOT_TMPL_IOBYTE:
1173  FEDD                      ; default CP/M IOBYTE immediate ($95) loaded at cold boot
1174  FEDD 3E 95                LD A,$95
1175  FEDF              ; ----------------------------------------------------------------------
1176  FEDF              ; DISK_DMAADR -- cold-boot install template 'LD ($0003),A' (store default IOBYTE);
1177  FEDF              ;     +2 operand reused as dmaadr.
1178  FEDF              ;   Boot tenant: stores the default IOBYTE into page-zero $0003 at cold boot. Operational
1179  FEDF              ;   tenant: SETDMA writes BC into DISK_DMAADR+2 ($FEE1) as the current DMA buffer address
1180  FEDF              ;   (SETDMA 'LD (DISK_DMAADR+2),BC'); the deblock record copy uses it. Twin of the 2.20
1181  FEDF              ;   DISK_WRTYPE/DISK_DMAADR overlay. [RE]
1182  FEDF              ; ----------------------------------------------------------------------
1183  FEDF              DISK_DMAADR:
1184  FEDF                      ; store the default IOBYTE into page-zero $0003; the operand cell (+2) doubles as dmaadr
1185  FEDF 32 03 00             LD ($0003),A
1186  FEE2              ; ----------------------------------------------------------------------
1187  FEE2              ; DISK_PARAM_TMPL -- cold-boot install template 'LD HL,($F3DE)'; SELDSK self-modifies +1.
1188  FEE2              ;   Boot tenant: 'LD HL,(nn)' loads a config word; the install engine continues at $FEE5.
1189  FEE2              ;   Operational tenant: SELDSK patches DISK_PARAM_TMPL+1 ($FEE3) with a per-drive disk-
1190  FEE2              ;   parameter byte. From $FEE5 the cold-boot INSTALL ENGINE proper runs (see body). Twin
1191  FEE2              ;   of 2.20 DISK_UNADSK template + the DEV_INSTALL flow. [RE]
1192  FEE2              ;   Algorithm (install engine from $FEE5): copy the RPC-trigger store address into
1193  FEE2              ;     RPC_TRIGGER_STORE+1; clear page-zero $0004; read the console card class from config
1194  FEE2              ;     $F3BB; for the device-6/Pascal-class console install the $FD99 status handler into
1195  FEE2              ;     the $F380 vector, else for the Videx/40-col classes self-modify the CONST handler
1196  FEE2              ;     (KBD_STATUS_40COL+1) so status reads come from the card; then install CONOUT/CONIN handler
1197  FEE2              ;     vectors via the handler lookups, print the sign-on banner, and enter the CCP.
1198  FEE2              ; ----------------------------------------------------------------------
1199  FEE2              SECTOR_BLOCK_PATCH:
1200  FEE2                      ; install template: load a config word (operand at +1 is self-modified by SELDSK with the
1201  FEE2                      ; disk param)
1202  FEE2 2A DE F3             LD HL,($F3DE)
1203  FEE5                      ; self-modify: write the SoftCard RPC-trigger store address into RPC_TRIGGER_STORE's LD
1204  FEE5                      ; (nn),A operand [RE]
1205  FEE5 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1206  FEE8 AF                   XOR A
1207  FEE9                      ; clear page-zero $0004 (current default drive)
1208  FEE9 32 04 00             LD ($0004),A
1209  FEEC                      ; read the configured console card class from the config block (Apple $03BB)
1210  FEEC 3A BB F3             LD A,($F3BB)
1211  FEEF                      ; card class 6 = device-6 / Pascal-firmware console (post-1980 path; absent in the 1980
1212  FEEF                      ; manual) [RE]
1213  FEEF FE 06                CP $06
1214  FEF1 20 0A                JR NZ,DEV_INSTALL_LIST
1215  FEF3                      ; device-6 console: install the $FD99 status handler
1216  FEF3 21 99 FD             LD HL,SET_SCREEN_BASE_1
1217  FEF6                      ; store it into the SoftCard console-status I/O vector cell (Apple $0380)
1218  FEF6 22 80 F3             LD ($F380),HL
1219  FEF9 D6 03                SUB $03
1220  FEFB 18 13                JR DEV_INSTALL_PUNCH
1221  FEFD              ; ----------------------------------------------------------------------
1222  FEFD              ; DEV_INSTALL_LIST -- install the LIST device-output handler from the config class. [RE]
1223  FEFD              ;   In:  install engine running. Out: patches the LIST output stub vector. Clobbers: A,HL.
1224  FEFD              ;   Algorithm: read the LIST card class (config $F3B9 = Apple $03B9), bias by 3; if a
1225  FEFD              ;     real device is configured, look up its handler (CALL HANDLER_LOOKUP) and store it
1226  FEFD              ;     into the LIST stub vector (DEV_OUT_1_JP+1). Twin of 2.20 DEV_INSTALL flow. [RE]
1227  FEFD              ; ----------------------------------------------------------------------
1228  FEFD              DEV_INSTALL_LIST:
1229  FEFD FE 05                CP $05
1230  FEFF 28 22                JR Z,DEV_INSTALL_READER
1231  FF01 D6 03                SUB $03
1232  FF03 38 1E                JR C,DEV_INSTALL_READER
1233  FF05 20 09                JR NZ,DEV_INSTALL_PUNCH
1234  FF07 21 15 FB             LD HL,KBD_STATUS_40COL+1
1235  FF0A 36 BE                LD (HL),$BE
1236  FF0C 23                   INC HL
1237  FF0D 23                   INC HL
1238  FF0E 36 1F                LD (HL),$1F
1239  FF10              ; ----------------------------------------------------------------------
1240  FF10              ; DEV_INSTALL_PUNCH -- install the PUNCH device-output handler from the config class. [RE]
1241  FF10              ;   Algorithm: read the PUNCH card class (config $F3BA = Apple $03BA), bias by 3; if
1242  FF10              ;     configured, look up the handler and store it into the PUNCH stub vector (DEV_OUT_2_JP+1); for
1243  FF10              ;     the higher class value also install a secondary handler into DEV_OUT_3_JP+1. Twin of 2.20
1244  FF10              ;     DEV_INSTALL flow. [RE]
1245  FF10              ; ----------------------------------------------------------------------
1246  FF10              DEV_INSTALL_PUNCH:
1247  FF10 F5                   PUSH AF
1248  FF11 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1249  FF14 F1                   POP AF
1250  FF15 22 B9 FC             LD (SCREEN_EMIT_3+1),HL
1251  FF18                      ; secondary handler lookup via the skip-idiom entry (HANDLER_LOOKUP_B); the FD cover byte at
1252  FF18                      ; DEV_HANDLER_LOOKUP_B is skipped [RE]
1253  FF18 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1254  FF1B 22 37 FB             LD (CONIN_DISPATCH+1),HL
1255  FF1E 3E 03                LD A,$03
1256  FF20 32 05 FB             LD (CCP_LAUNCH+1),A
1257  FF23              ; ----------------------------------------------------------------------
1258  FF23              ; DEV_INSTALL_READER -- build the default READER/list-output stub when none is configured.
1259  FF23              ;   Algorithm: when no real device class is configured, build the no-op stub at DEV_OUT_3_JP:
1260  FF23              ;     store $1A3E ('LD A,$1A' opcode+immediate) then $C9 ('RET') so the device returns a
1261  FF23              ;     constant. Twin of 2.20 DEV_INSTALL_4's DEV_OUT_3 build. [RE]
1262  FF23              ; ----------------------------------------------------------------------
1263  FF23              DEV_INSTALL_READER:
1264  FF23 3A B9 F3             LD A,($F3B9)
1265  FF26 D6 03                SUB $03
1266  FF28 38 06                JR C,INSTALL_DONE_DEVICES
1267  FF2A CD 84 FF             CALL DEV_HANDLER_LOOKUP
1268  FF2D 22 50 FE             LD (DEV_OUT_1_JP+1),HL
1269  FF30              ; ----------------------------------------------------------------------
1270  FF30              ; INSTALL_DONE_DEVICES -- run the device probe after the per-device installs. [RE]
1271  FF30              ;   Algorithm: CALL PROBE_DEVICES (PROBE_DEVICES) to scan the 7 SoftCard config slots and
1272  FF30              ;     mark/init each present card before the banner is printed. Twin of 2.20 DEV_INSTALL_6
1273  FF30              ;     PROBE_DEVICES call. [RE]
1274  FF30              ; ----------------------------------------------------------------------
1275  FF30              INSTALL_DONE_DEVICES:
1276  FF30 3A BA F3             LD A,($F3BA)
1277  FF33 D6 03                SUB $03
1278  FF35 38 14                JR C,SLOT_IO_SCALE_17
1279  FF37 F5                   PUSH AF
1280  FF38 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1281  FF3B 22 64 FE             LD (DEV_OUT_2_JP+1),HL
1282  FF3E F1                   POP AF
1283  FF3F FE 02                CP $02
1284  FF41 28 08                JR Z,SLOT_IO_SCALE_17
1285  FF43 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1286  FF46 22 6A FE             LD (DEV_OUT_3_JP+1),HL
1287  FF49 18 0B                JR SLOT_IO_SCALE_18
1288  FF4B              SLOT_IO_SCALE_17:
1289  FF4B 21 3E 1A             LD HL,$1A3E
1290  FF4E 22 69 FE             LD (DEV_OUT_3_JP),HL
1291  FF51 3E C9                LD A,$C9
1292  FF53 32 6B FE             LD (DEV_OUT_3_JP+2),A
1293  FF56              SLOT_IO_SCALE_18:
1294  FF56                      ; scan + init the 7 SoftCard config slots (device probe) before the sign-on
1295  FF56 CD 82 FA             CALL PROBE_DEVICES
1296  FF59              ; ----------------------------------------------------------------------
1297  FF59              ; SIGNON_PRINT -- emit the two config-derived sign-on prefix chars, then the banner. [RE]
1298  FF59              ;   In:  none. Out: prints the sign-on. Clobbers: A,HL.
1299  FF59              ;   Algorithm: read config $F398 (Apple $0398), pass it to the CONOUT writer (CONOUT_DISPATCH),
1300  FF59              ;     then walk SIGNON_BANNER (SIGNON_BANNER) char-by-char through CONOUT until the $00
1301  FF59              ;     terminator, then enter PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS). Twin of the 2.20
1302  FF59              ;     DEV_INSTALL_6/
1303  FF59              ;     DEV_INSTALL_7 banner loop (here it routes through CONOUT directly, not SIGNON_EMIT).
1304  FF59              ;     NOTE: WBOOT (WBOOT) also stashes SIGNON_PRINT into the $F3D0 RPC mailbox at
1305  FF59              ;     $FACE for a re-init path. [RE]
1306  FF59              ; ----------------------------------------------------------------------
1307  FF59              SIGNON_PRINT:
1308  FF59                      ; first config-derived sign-on char (Apple $0398)
1309  FF59 3A 98 F3             LD A,($F398)
1310  FF5C                      ; emit it via SIGNON_EMIT (prefixes a config char if bit7 set), routed through CONOUT
1311  FF5C CD 8F FF             CALL SIGNON_EMIT
1312  FF5F                      ; HL -> the cold-boot sign-on banner string
1313  FF5F 21 9E FF             LD HL,SIGNON_BANNER
1314  FF62              ; ----------------------------------------------------------------------
1315  FF62              ; SIGNON_BANNER_LOOP -- print SIGNON_BANNER char-by-char until the $00 terminator. [RE]
1316  FF62              ;   In:  HL -> banner. Out: jumps to PAGEZERO_REBUILD at the terminator. Clobbers: A,HL.
1317  FF62              ;   Algorithm: load (HL); if $00 jump to PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS) to finish cold
1318  FF62              ;     boot; else push HL, CALL CONOUT (CONOUT_DISPATCH), pop, INC HL, repeat. Twin of 2.20
1319  FF62              ;     DEV_INSTALL_7. [RE]
1320  FF62              ; ----------------------------------------------------------------------
1321  FF62              SIGNON_BANNER_LOOP:
1322  FF62 7E                   LD A,(HL)
1323  FF63 B7                   OR A
1324  FF64                      ; banner terminator -> PAGEZERO_REBUILD (write page-zero hooks, enter the CCP)
1325  FF64 CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1326  FF67 E5                   PUSH HL
1327  FF68                      ; emit one banner char via CONOUT
1328  FF68 CD 4C FB             CALL CONOUT_DISPATCH
1329  FF6B E1                   POP HL
1330  FF6C 23                   INC HL
1331  FF6D 18 F3                JR SIGNON_BANNER_LOOP
1332  FF6F              SLOT_IO_SCALE_21:
1333  FF6F 0E FD                LD C,$FD
1334  FF71 71                   LD (HL),C
1335  FF72 FD                   DEFB $FD  ; ignored IY prefix; inner: LD D,D
1336  FF73 52                   LD D,D
1337  FF74 FE A9                CP $A9
1338  FF76 FD                   DEFB $FD  ; ignored IY prefix; inner: LD B,D
1339  FF77              SLOT_IO_SCALE_22:
1340  FF77 42                   LD B,D
1341  FF78 FE C1                CP $C1
1342  FF7A FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1343  FF7B B7                   OR A
1344  FF7C FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1345  FF7D B7                   OR A
1346  FF7E              ; ----------------------------------------------------------------------
1347  FF7E              ; DEV_HANDLER_LOOKUP_B -- secondary-table handler lookup, entered at +1 via a skip idiom.
1348  FF7E              ;   In:  A = entry index. Out: HL = handler address from the secondary table. Clobbers: A,HL.
1349  FF7E              ;   SKIP IDIOM: the byte at DEV_HANDLER_LOOKUP_B ($FF7E) is an $FD cover (reads as 'LD IY,$FF77'
1350  FF7E              ;     when fallen into); every CALLER targets DEV_HANDLER_LOOKUP_B+1 ($FF7F) which executes
1351  FF7E              ;     'LD HL,SLOT_IO_SCALE_22' (the secondary DEV_HANDLER_PTRS_B base) then 'JR DEV_HANDLER_
1352  FF7E              ;     LOOKUP_IDX'. Twin of 2.20 DEV_HANDLER_LOOKUP_B (there a clean 'LD HL,..; JR'). [RE]
1353  FF7E              ;   -- see flags for the cover byte and the surrounding DEFB-as-code handler table.
1354  FF7E              ; ----------------------------------------------------------------------
1355  FF7E              DEV_HANDLER_LOOKUP_B:
1356  FF7E                      ; COVER: the FD prefix makes this 'LD IY,$FF77' on fall-in; callers enter at +1 => 'LD
1357  FF7E                      ;        HL,SLOT_IO_SCALE_22' (secondary table base) [RE]
1358  FF7E FD 21 77 FF          LD IY,SLOT_IO_SCALE_22
1359  FF82                      ; join the shared index tail (HL += A*2; load the word)
1360  FF82 18 03                JR DEV_HANDLER_LOOKUP_IDX
1361  FF84              ; ----------------------------------------------------------------------
1362  FF84              ; DEV_HANDLER_LOOKUP -- fetch a device-handler address from the primary pointer table.
1363  FF84              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1364  FF84              ;   Algorithm: HL = DEV_HANDLER_PTRS base (SLOT_IO_SCALE_21); fall into the shared scaler
1365  FF84              ;     (ADD A,A; ADD A,L; LD L,A) then load the 16-bit word at that slot (low then high).
1366  FF84              ;     The secondary-table entry is HANDLER_LOOKUP_B at DEV_HANDLER_LOOKUP_B+1 (skip idiom). Twin
1367  FF84              ;     of 2.20 DEV_HANDLER_LOOKUP. [RE]
1368  FF84              ; ----------------------------------------------------------------------
1369  FF84              DEV_HANDLER_LOOKUP:
1370  FF84                      ; select the primary device-handler pointer table
1371  FF84 21 6F FF             LD HL,SLOT_IO_SCALE_21
1372  FF87              ; ----------------------------------------------------------------------
1373  FF87              ; DEV_HANDLER_LOOKUP_IDX -- shared table-index tail: HL += A*2; HL = word at that slot.
1374  FF87              ;   In:  A = index, HL = table base. Out: HL = the 16-bit handler address. Clobbers: A,HL.
1375  FF87              ;   Twin of 2.20 DISK_RTN_LOOKUP_IDX. [RE]
1376  FF87              ; ----------------------------------------------------------------------
1377  FF87              DEV_HANDLER_LOOKUP_IDX:
1378  FF87                      ; index*2 for 16-bit (word) table entries
1379  FF87 87                   ADD A,A
1380  FF88 85                   ADD A,L
1381  FF89 6F                   LD L,A
1382  FF8A                      ; load handler address low byte
1383  FF8A 7E                   LD A,(HL)
1384  FF8B 2C                   INC L
1385  FF8C                      ; load handler address high byte -> HL = handler entry
1386  FF8C 66                   LD H,(HL)
1387  FF8D 6F                   LD L,A
1388  FF8E C9                   RET
1389  FF8F              ; ----------------------------------------------------------------------
1390  FF8F              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1391  FF8F              ;   In:  A = byte/flag. Out: prints via CONOUT (CONOUT_DISPATCH). Clobbers: A,HL.
1392  FF8F              ;   Algorithm: if A is positive (bit7 clear) emit it directly via CONOUT; if negative,
1393  FF8F              ;     first emit the prefix char from config $F397 (Apple $0397), then tail-jump to
1394  FF8F              ;     CONOUT to emit A. Twin of 2.20 SIGNON_EMIT. [RE]
1395  FF8F              ; ----------------------------------------------------------------------
1396  FF8F              SIGNON_EMIT:
1397  FF8F B7                   OR A
1398  FF90                      ; bit7 clear -> emit the char directly via CONOUT
1399  FF90 F2 9B FF             JP P,SIGNON_EMIT_CHAR
1400  FF93 F5                   PUSH AF
1401  FF94                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1402  FF94 3A 97 F3             LD A,($F397)
1403  FF97                      ; emit the prefix char via CONOUT
1404  FF97 CD 4C FB             CALL CONOUT_DISPATCH
1405  FF9A F1                   POP AF
1406  FF9B              ; ----------------------------------------------------------------------
1407  FF9B              ; SIGNON_EMIT_CHAR -- tail of SIGNON_EMIT: emit the original char via CONOUT. [RE]
1408  FF9B              ; ----------------------------------------------------------------------
1409  FF9B              SIGNON_EMIT_CHAR:
1410  FF9B                      ; tail-call CONOUT to emit the char
1411  FF9B C3 4C FB             JP CONOUT_DISPATCH
1412  FF9E              ; ----------------------------------------------------------------------
1413  FF9E              ; SIGNON_BANNER -- the cold-boot sign-on string, printed by SIGNON_BANNER_LOOP until $00.
1414  FF9E              ;   Reads (40-col uppercase / Videx mixed-case): CR/LF/LF/LF, '     Softcard CP/M', CR/LF,
1415  FF9E              ;   '     44K Ver. 2.23', CR/LF, '(c) 1980,1982 Microsoft', CR, LF/CR/LF, $00. DATA.
1416  FF9E              ;   NOTE: the 40-col Apple screen is uppercase-only so it renders 'SOFTCARD'; the Videx
1417  FF9E              ;   80-col card renders the mixed-case 'Softcard'. The trailing bytes from $FFE6 ($FA $E5
1418  FF9E              ;   ...) are NOT banner text -- they are an in-image copy of handler/lookup code; see flags.
1419  FF9E              ;   Twin of 2.20 SIGNON_BANNER (which reads 'Apple ][ CP/M' / '44K Ver. 2.20' /
1420  FF9E              ;   '(C) 1980 Microsoft'). [RE]
1421  FF9E              ; ----------------------------------------------------------------------
1422  FF9E              SIGNON_BANNER:
1423  FF9E 0D 0A 0A 0A          DEFB    "\r\n\n\n"
1424  FFA2 20 20 20 20          DEFB    "     Softcard CP/M"     ; string
1424  FFA6 20 53 6F 66
1424  FFAA 74 63 61 72
1424  FFAE 64 20 43 50
1424  FFB2 2F 4D
1425  FFB4 0D                   DEFB    $0D                      ; terminator
1426  FFB5 0A                   DEFB    "\n"
1427  FFB6 20 20 20 20          DEFB    "     44K Ver. 2.23"     ; string
1427  FFBA 20 34 34 4B
1427  FFBE 20 56 65 72
1427  FFC2 2E 20 32 2E
1427  FFC6 32 33
1428  FFC8 0D                   DEFB    $0D                      ; terminator
1429  FFC9 0A                   DEFB    "\n"
1430  FFCA 28 63 29 20          DEFB    "(c) 1980,1982 Microsoft" ; string
1430  FFCE 31 39 38 30
1430  FFD2 2C 31 39 38
1430  FFD6 32 20 4D 69
1430  FFDA 63 72 6F 73
1430  FFDE 6F 66 74
1431  FFE1 0D                   DEFB    $0D                      ; terminator
1432  FFE2 0A 0D 0A 00          DEFB    $0A,$0D,$0A,$00,$FA,$E5,$CD,$4C,$FB,$E1,$23,$18,$F3,$0E,$FD,$71
1432  FFE6 FA E5 CD 4C
1432  FFEA FB E1 23 18
1432  FFEE F3 0E FD 71
1433  FFF2 FD 52 FE A9          DEFB    $FD,$52,$FE,$A9,$FD,$42,$FE,$C1,$FD,$B7,$FD,$B7,$FD,$21
1433  FFF6 FD 42 FE C1
1433  FFFA FD B7 FD B7
1433  FFFE FD 21
1434  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1435  0000
1436  0000                  SAVEBIN "{out_bin}", $FA00, $0600
1437  0000                  IFNDEF CPM_LINK
1438  0000                  ; image size from bracketing labels; $FA00 = the ORG base (image wraps to $0000)
1439  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1440  0000                  ENDIF
1441  0000
1442  0000              ; ----------------------------------------------------------------------
1443  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEE4-$FFDB.
1444  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above. It runs once at cold
1445  0000              ;   start; only afterwards does the disk system reuse them as the buffers DPH_TABLE
1446  0000              ;   hands out. The two tenants are never live at the same time.
1447  0000              ;
1448  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1449  0000              ;   at the overlay base, then one label per field with its extent carried in the
1450  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1451  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1452  0000              ;   the image, and the ORG leaves the emitted output untouched.
1453  0000              ;
1454  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1455  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1456  0000              ;   cold boot has finished. The sizes are the DPB's own values, so they cannot drift
1457  0000              ;   from the DPB this BIOS publishes. Same shape and names as the 2.20-44K and
1458  0000              ;   2.23-60K twins; only the addresses and the drive count differ. [RE]
1459  0000              ; ----------------------------------------------------------------------
1460  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1461  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1462  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1463  0000              CSV_SIZE     EQU 12                   ; = CKS
1464  0000
1465  0000                      ORG $FEE4                     ; the one given: where the author placed the overlay
1466  FEE4              DIRBUF:                               ; shared directory buffer, one per system
1467  FEE4                      ORG DIRBUF + DIRBUF_SIZE
1468  FF64              ALV_VECTORS:                          ; per-drive allocation vectors ($FF64..)
1469  FF64                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1470  FFAC              CSV_VECTORS:                          ; per-drive checksum vectors ($FFAC..)
1471  FFAC                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1472  FFDC              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFDC)
1473  FFDC
1474  FFDC                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1475  FFDC                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1476  FFDC                  ASSERT ALV_VECTORS == $FF64
1477  FFDC                  ASSERT CSV_VECTORS == $FFAC
1478  FFDC                  ASSERT BIOS_SCRATCH_END == $FFDC
1479  FFDC
# file closed: CPM_BIOS.asm

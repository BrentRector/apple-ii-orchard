# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.23 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 2.23-44K BIOS runs at z80 $FA00-$FFFF (6 pages) = Apple $0A00-$0FFF LOW RAM
   5  0000              ; (NOT $AA00 like 2.20 -- a different mechanism). Decoded against the de-skewed
   6  0000              ; runtime image; the disk producer re-applies the sector skew (deskew.py ::
   7  0000              ; BIOS_PAGE_TO_SECTOR_223). $FA00 = the 15-entry BIOS jump vector.
   8  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
   9  0000              ; being enriched to the C-level bar.
  10  0000              ; ============================================================================
  11  0000
  12  0000                  IFNDEF CPM_LINK
  13  0000                  DEVICE NOSLOT64K
  14  0000                  ORG $FA00
  15  FA00                  ENDIF
  16  FA00
  17  FA00              ; ----------------------------------------------------------------------
  18  FA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector (2.23-44K, runtime $FA00).
  19  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  20  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  21  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  22  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  23  FA00              ;   Note: the CONOUT target ($FB4D) is the second-instruction entry of
  24  FA00              ;         CONOUT_DISPATCH (skips its leading LD C,A); see flags. [RE]
  25  FA00              ; ----------------------------------------------------------------------
  26  FA00              BIOS_VECTOR:
  27  FA00                      ; entry 0 = cold boot (BOOT, lives in the $FE85 band, out of this scope)
  28  FA00 C3 D1 FE             JP BOOT
  29  FA03              ; ----------------------------------------------------------------------
  30  FA03              ; BIOS_VECTOR_WBOOT -- jump-table entries 1..14 (WBOOT .. WRITE).
  31  FA03              ;   Same 14-entry layout as the 2.20-44K twin; only the target addresses move
  32  FA03              ;   ($FA-band, not $AA). CONOUT ($FA0C) targets CONOUT_DISPATCH+1 ($FB4D). [RE]
  33  FA03              ; ----------------------------------------------------------------------
  34  FA03              BIOS_VECTOR_WBOOT:
  35  FA03                      ; jump table
  36  FA03                      ; entry 1 = WBOOT: reload CCP, rebuild page zero
  37  FA03 C3 B8 FA             JP      WBOOT
  38  FA06                      ; entry 2 = CONST: console status via IOBYTE
  39  FA06 C3 10 FB             JP      CONST
  40  FA09                      ; entry 3 = CONIN: dispatch + function/arrow remap
  41  FA09 C3 1A FB             JP      CONIN
  42  FA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  43  FA0C C3 4D FB             JP      $FB4D
  44  FA0F                      ; entry 5 = LIST: route by IOBYTE LIST field
  45  FA0F C3 70 FB             JP      LIST
  46  FA12                      ; entry 6 = PUNCH: route by IOBYTE PUNCH field
  47  FA12 C3 7F FB             JP      PUNCH
  48  FA15                      ; entry 7 = READER: route by IOBYTE READER field
  49  FA15 C3 91 FB             JP      READER
  50  FA18                      ; entry 8 = HOME (out of this scope, $FDB0 band)
  51  FA18 C3 6C FE             JP      HOME
  52  FA1B                      ; entry 9 = SELDSK (out of this scope, $FE85 band)
  53  FA1B C3 8E FE             JP      SELDSK
  54  FA1E                      ; entry 10 = SETTRK (out of this scope, $FE77)
  55  FA1E C3 77 FE             JP      $FE77
  56  FA21                      ; entry 11 = SETSEC: store sector into deblock scratch
  57  FA21 C3 F4 FB             JP      SETSEC
  58  FA24                      ; entry 12 = SETDMA: store DMA address into deblock scratch
  59  FA24 C3 F9 FB             JP      SETDMA
  60  FA27                      ; entry 13 = READ (out of this scope, $FE85 band)
  61  FA27 C3 BD FE             JP      READ
  62  FA2A                      ; entry 14 = WRITE (out of this scope, $FE85 band)
  63  FA2A C3 C0 FE             JP      WRITE
  64  FA2D                      ; post-vector trailer: $AF $C9 (XOR A / RET) then 4 opaque bytes $00,$60,$69,$C9;
  65  FA2D                      ; the same 6 bytes as 2.20's $AA2D trailer. [RE] not reached as code here.
  66  FA2D AF C9 00 60          DEFB    $AF,$C9,$00,$60,$69,$C9
  66  FA31 69 C9
  67  FA33              ; ----------------------------------------------------------------------
  68  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
  69  FA33              ;   drive 0..3; 2.23 supports 4 drives, vs 6 in the 2.20 twin). SELDSK returns
  70  FA33              ;   DPH_TABLE + 16*drive. Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV,
  71  FA33              ;   ALV. XLT = 0 (no SECTRAN translate). All drives share one DIRBUF ($FEE4, in the
  72  FA33              ;   install/deblock band) and one DPB. The per-drive CSV (checksum) / ALV (allocation)
  73  FA33              ;   vectors live in the BIOS's $FF RAM, reused as scratch after boot; kept literal. [RE]
  74  FA33              ; ----------------------------------------------------------------------
  75  FA33              DPH_TABLE:
  76  FA33 00 00 00 00          DEFW    0,0,0,0,$FEE4,DPB,$FFAC,$FF64   ; drive 0: DIRBUF, DPB, CSV=$FFAC, ALV=$FF64
  76  FA37 00 00 00 00
  76  FA3B E4 FE 73 FA
  76  FA3F AC FF 64 FF
  77  FA43 00 00 00 00          DEFW    0,0,0,0,$FEE4,DPB,$FFB8,$FF76   ; drive 1
  77  FA47 00 00 00 00
  77  FA4B E4 FE 73 FA
  77  FA4F B8 FF 76 FF
  78  FA53 00 00 00 00          DEFW    0,0,0,0,$FEE4,DPB,$FFC4,$FF88   ; drive 2
  78  FA57 00 00 00 00
  78  FA5B E4 FE 73 FA
  78  FA5F C4 FF 88 FF
  79  FA63 00 00 00 00          DEFW    0,0,0,0,$FEE4,DPB,$FFD0,$FF9A   ; drive 3
  79  FA67 00 00 00 00
  79  FA6B E4 FE 73 FA
  79  FA6F D0 FF 9A FF
  80  FA73              ; ----------------------------------------------------------------------
  81  FA73              ; DPB -- the shared Disk Parameter Block (5.25" floppy; every DPH points here).
  82  FA73              ;   One label per field, so the field names are symbols rather than prose. The ten names
  83  FA73              ;   are Digital Research's CP/M 2.2 DPB field names. NOT [DOC]-citable from this archive:
  84  FA73              ;   the SoftCard manual set documents only the BDOS call that RETURNS a DPB pointer
  85  FA73              ;   (fn 31, Get Addr (disk parms)), not the block's layout.
  86  FA73              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
  87  FA73              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track. [RE]
  88  FA73              ;   This block is byte-identical to the 2.20-44K twin's except for DSM (see below). [RE]
  89  FA73              ; ----------------------------------------------------------------------
  90  FA73              DPB:
  91  FA73 20 00        SPT:    DEFW    $0020                    ; records per track: 32 x 128-byte records
  92  FA75 03           BSH:    DEFB    $03                      ; block shift: log2(records per block) -> 8 records
  93  FA76 07           BLM:    DEFB    $07                      ; block mask: (records per block) - 1 -> 1 KB blocks
  94  FA77 00           EXM:    DEFB    $00                      ; extent mask
  95  FA78              ; DSM is the ONLY byte in which this DPB differs from the 2.20-44K twin ($7F there).
  96  FA78              ;   The arithmetic does not close: 140 blocks / 4 blocks per track = 35 tracks of file
  97  FA78              ;   area, which with OFF=3 implies a 38-track disk; the medium is 35 tracks total. The
  98  FA78              ;   twin's $7F gives 32 + 3 = 35 exactly. What absorbs the surplus is a directory entry
  99  FA78              ;   present on every 2.23 disk: user byte $1F, lowercase name "cp/m    sys", allocation
 100  FA78              ;   list exactly blocks 128-139 -- the twelve blocks past the twin's 128. The BDOS's
 101  FA78              ;   allocation-vector rebuild skips only $E5 entries and does not range-check the user
 102  FA78              ;   number, so that entry is honoured and those twelve blocks stay marked in use.
 103  FA78              ;   Whether $8B is an error masked by that entry or a deliberate convention is NOT
 104  FA78              ;   determinable from any byte on these disks. [RE]
 105  FA78 8B 00        DSM:    DEFW    $008B                    ; highest allocation block number: 139 -> 140 blocks
 106  FA7A 2F 00        DRM:    DEFW    $002F                    ; highest directory entry number: 47 -> 48 entries
 107  FA7C C0           AL0:    DEFB    $C0                      ; directory-reserved blocks, bitmap, high byte -> 2
 108  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 109  FA7E 0C 00        CKS:    DEFW    $000C                    ; directory checksum bytes
 110  FA80 03 00        OFF:    DEFW    $0003                    ; reserved tracks before the file area
 111  FA82              ; ----------------------------------------------------------------------
 112  FA82              ; PROBE_DEVICES -- scan the SoftCard device/config area and mark presence.
 113  FA82              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 114  FA82              ;   Out: config bytes updated in place; per-device init called when a device is found.
 115  FA82              ;   Clobbers: A,DE,HL.
 116  FA82              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E].  If it equals 3 the slot
 117  FA82              ;     holds a recognized device, so call SLOT_IO_ADDR and store $03 then $15 into the
 118  FA82              ;     cell to flag it configured.  A secondary DEC A test (original value 4, e.g. a
 119  FA82              ;     Videx-class 80-col console) runs SET_SCREEN_BASE and claims the $C800 shared
 120  FA82              ;     expansion-ROM window via RPC_TRIGGER; a value-2 path repoints a vector via
 121  FA82              ;     PLOT_CHAR_RPC ($0DD0 param).  Same shape as the 2.20 twin's PROBE_DEVICES. [RE]
 122  FA82              ; ----------------------------------------------------------------------
 123  FA82              PROBE_DEVICES:
 124  FA82                      ; DE = 7 entries to scan (index walks down to 1)
 125  FA82 11 07 00             LD DE,$0007
 126  FA85              PROBE_DEVICES_LOOP:
 127  FA85                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 128  FA85 21 B8 F3             LD HL,$F3B8
 129  FA88 19                   ADD HL,DE
 130  FA89 7E                   LD A,(HL)
 131  FA8A                      ; config value 3 = a recognized/present device in this slot
 132  FA8A D6 03                SUB $03
 133  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 134  FA8E                      ; build the slot I/O base for the found device (SLOT_IO_ADDR)
 135  FA8E CD 81 FE             CALL SLOT_IO_ADDR
 136  FA91                      ; rewrite the cell: $03 then $15 = mark this device configured
 137  FA91 36 03                LD (HL),$03
 138  FA93 36 15                LD (HL),$15
 139  FA95              PROBE_DEVICES_CHK4:
 140  FA95                      ; after the SUB, A==1 means the original value was 4 (Videx-class 80-col console)
 141  FA95 3D                   DEC A
 142  FA96 20 0B                JR NZ,PROBE_DEVICES_CHK2
 143  FA98                      ; console probe / select the 80-col screen base (SET_SCREEN_BASE)
 144  FA98 CD 83 FD             CALL SET_SCREEN_BASE
 145  FA9B                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 146  FA9B 21 00 C8             LD HL,$C800
 147  FA9E CD 45 FB             CALL RPC_TRIGGER
 148  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 149  FAA3              PROBE_DEVICES_CHK2:
 150  FAA3                      ; value 2 = a different device class (e.g. printer/serial); takes the PLOT_CHAR_RPC path
 151  FAA3 FE 02                CP $02
 152  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 153  FAA7                      ; param for the value-2 vector init ($0DD0)
 154  FAA7 21 D0 0D             LD HL,$0DD0
 155  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 156  FAAD              PROBE_DEVICES_NEXT:
 157  FAAD                      ; next config entry; loop until all 7 scanned
 158  FAAD 1D                   DEC E
 159  FAAE 20 D5                JR NZ,PROBE_DEVICES_LOOP
 160  FAB0 C9                   RET
 161  FAB1              ; ----------------------------------------------------------------------
 162  FAB1              ; DEVICE_IO_BASE -- form a SoftCard I/O / soft-switch address from a device/offset index.
 163  FAB1              ;   In:  E = low offset within the I/O page.
 164  FAB1              ;   Out: HL = ((E | $E0) << 8), an address in z80 $E000-$EFFF = Apple I/O $C000-$CFFF;
 165  FAB1              ;        A clobbered.
 166  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 167  FAB1              ;        page, then H = A.  Used to reach keyboard / soft switches / slot I/O.
 168  FAB1              ;        Same as the 2.20 twin's DEVICE_IO_BASE (distinct from SLOT_IO_ADDR at $FE81). [RE]
 169  FAB1              ; ----------------------------------------------------------------------
 170  FAB1              DEVICE_IO_BASE:
 171  FAB1                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 172  FAB1 21 00 E0             LD HL,$E000
 173  FAB4 7B                   LD A,E
 174  FAB5                      ; force the high byte into the $C0xx I/O range
 175  FAB5 B4                   OR H
 176  FAB6 67                   LD H,A
 177  FAB7 C9                   RET
 178  FAB8              ; ----------------------------------------------------------------------
 179  FAB8              ; WBOOT -- CP/M warm boot: re-init the console, rebuild page zero, re-enter the CCP.
 180  FAB8              ;   In:  none.  Out: jumps to the CCP at $9300; does not return.  Clobbers: all.
 181  FAB8              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 182  FAB8              ;     (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 183  FAB8              ;     PROBE_DEVICES.  If the CCP image signature at $9C08 is intact ($9C) it falls
 184  FAB8              ;     into PAGEZERO_REBUILD; otherwise it reloads the CCP/system via a page-zero JP.
 185  FAB8              ;   Note: 2.23 reloads through a self-built $000B jump and enters the CCP at $9300
 186  FAB8              ;     (the 2.20 twin used $9400). [RE]
 187  FAB8              ; ----------------------------------------------------------------------
 188  FAB8              WBOOT:
 189  FAB8                      ; stack at the default DMA buffer top (page-zero $0080)
 190  FAB8 31 80 00             LD SP,$0080
 191  FABB                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 192  FABB 3A 51 E0             LD A,($E051)
 193  FABE 21 00 0E             LD HL,$0E00
 194  FAC1                      ; re-init the console I/O vectors (RPC_TRIGGER) for warm restart
 195  FAC1 CD 45 FB             CALL RPC_TRIGGER
 196  FAC4                      ; re-scan devices so warm boot rebuilds the I/O table
 197  FAC4 CD 82 FA             CALL PROBE_DEVICES
 198  FAC7                      ; read the CCP-image signature byte at $9C08
 199  FAC7 3A 08 9C             LD A,($9C08)
 200  FACA                      ; signature $9C present = CCP image intact, skip the reload
 201  FACA FE 9C                CP $9C
 202  FACC 28 11                JR Z,PAGEZERO_REBUILD
 203  FACE 21 59 FF             LD HL,SIGNON_PRINT
 204  FAD1 22 D0 F3             LD ($F3D0),HL
 205  FAD4 2A DE F3             LD HL,($F3DE)
 206  FAD7 3E 77                LD A,$77
 207  FAD9                      ; plant a $77 byte at page-zero $000B to bridge into the reload path
 208  FAD9 32 0B 00             LD ($000B),A
 209  FADC                      ; jump into the self-built page-zero reload bridge
 210  FADC C3 0B 00             JP $000B
 211  FADF              ; ----------------------------------------------------------------------
 212  FADF              ; PAGEZERO_REBUILD -- clear the CCP-restart flag, then write the page-zero hooks.
 213  FADF              ;   In:  none.  Out: falls into CCP_LAUNCH; no return.  Clobbers: A,HL,BC.
 214  FADF              ;   Algorithm: zero the CCP restart flag at $9307, then (PAGEZERO_REBUILD_HOOKS)
 215  FADF              ;     plant JP ($C3) at $0000 -> the BIOS WBOOT entry (BIOS_VECTOR+3, BIOS_VECTOR_WBOOT) and
 216  FADF              ;     JP at $0005 -> the BDOS entry $9C06; clear two self-modified BIOS state cells
 217  FADF              ;     ($FEDD/$FED8); set the default DMA to $0080 via SETDMA. [RE]
 218  FADF              ; ----------------------------------------------------------------------
 219  FADF              PAGEZERO_REBUILD:
 220  FADF AF                   XOR A
 221  FAE0                      ; clear the CCP restart/cold flag at $9307
 222  FAE0 32 07 93             LD ($9307),A
 223  FAE3              PAGEZERO_REBUILD_HOOKS:
 224  FAE3 AF                   XOR A
 225  FAE4                      ; clear a self-modified BIOS state cell ($FEDD)
 226  FAE4 32 DD FE             LD (BOOT_TMPL_IOBYTE),A
 227  FAE7                      ; clear a self-modified BIOS state cell ($FED8)
 228  FAE7 32 D8 FE             LD (DISK_HSTACT),A
 229  FAEA                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 230  FAEA 3E C3                LD A,$C3
 231  FAEC                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 232  FAEC 32 00 00             LD ($0000),A
 233  FAEF                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 234  FAEF 21 03 FA             LD HL,BIOS_VECTOR_WBOOT
 235  FAF2 22 01 00             LD ($0001),HL
 236  FAF5                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 237  FAF5 32 05 00             LD ($0005),A
 238  FAF8                      ; BDOS entry point ($9C06) for the $0005 hook
 239  FAF8 21 06 9C             LD HL,$9C06
 240  FAFB 22 06 00             LD ($0006),HL
 241  FAFE                      ; default DMA address = $0080 (page-zero buffer)
 242  FAFE 01 80 00             LD BC,$0080
 243  FB01                      ; install the default DMA pointer (SETDMA)
 244  FB01 CD F9 FB             CALL SETDMA
 245  FB04              ; ----------------------------------------------------------------------
 246  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, jump to the CCP.
 247  FB04              ;   In:  none.  Out: JP $9300 (CCP cold/warm entry); no return.  Clobbers: A,C.
 248  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $974E, pass the current default
 249  FB04              ;     drive (page-zero $0004) in C, and jump to the CCP at $9300. [RE]
 250  FB04              ; ----------------------------------------------------------------------
 251  FB04              CCP_LAUNCH:
 252  FB04                      ; CCP-mode flag value
 253  FB04 3E 01                LD A,$01
 254  FB06                      ; store the CCP entry/mode flag into CCP workspace at $974E
 255  FB06 32 4E 97             LD ($974E),A
 256  FB09                      ; page-zero $0004 = current default drive byte
 257  FB09 3A 04 00             LD A,($0004)
 258  FB0C 4F                   LD C,A
 259  FB0D                      ; enter the CCP at $9300, C = default drive (2.20 used $9400)
 260  FB0D C3 00 93             JP $9300
 261  FB10              ; ----------------------------------------------------------------------
 262  FB10              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 263  FB10              ;   In:  none.  Out: A = $FF (ready) / $00 (not).  Clobbers: A,HL.
 264  FB10              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 265  FB10              ;     cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler, which
 266  FB10              ;     returns the status in A.  Same as the 2.20 twin's CONST. [RE]
 267  FB10              ; ----------------------------------------------------------------------
 268  FB10              CONST:
 269  FB10                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 270  FB10 2A 80 F3             LD HL,($F380)
 271  FB13                      ; dispatch to the selected console-status handler (returns A)
 272  FB13 E9                   JP (HL)
 273  FB14              ; ----------------------------------------------------------------------
 274  FB14              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 275  FB14              ;   In:  none.  Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 276  FB14              ;   Clobbers: A.
 277  FB14              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard register; RLA shifts bit 7
 278  FB14              ;     (key-ready) into carry; SBC A,A expands carry to $FF/$00.  The built-in 40-col
 279  FB14              ;     CONST path used when no Videx/80-col card supplies the status vector. [RE]
 280  FB14              ; ----------------------------------------------------------------------
 281  FB14              KBD_STATUS_40COL:
 282  FB14                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 283  FB14 3A 00 E0             LD A,($E000)
 284  FB17                      ; rotate key-ready bit 7 into carry
 285  FB17 17                   RLA
 286  FB18                      ; carry -> A = $FF (ready) or $00 (none)
 287  FB18 9F                   SBC A,A
 288  FB19 C9                   RET
 289  FB1A              ; ----------------------------------------------------------------------
 290  FB1A              ; CONIN -- read a console character: IOBYTE-route the input, then remap the key.
 291  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,DE,HL.
 292  FB1A              ;   Algorithm: CALL CONIN_DISPATCH to fetch a raw key (routed by the IOBYTE CONSOLE
 293  FB1A              ;     field); clear the high bit; then scan a small remap table at Apple $03AB
 294  FB1A              ;     (z80 $F3AB) of up to 6 entries (function/arrow keys), returning the paired
 295  FB1A              ;     replacement byte on a match, else the raw key.
 296  FB1A              ;   Note: 2.23's CONIN jump-vector entry runs this remap wrapper; the 2.20 twin's
 297  FB1A              ;     equivalent is CONSOLE_IN_40COL.  Differs from a bare dispatcher. [RE]
 298  FB1A              ; ----------------------------------------------------------------------
 299  FB1A              CONIN:
 300  FB1A                      ; fetch a raw key in A via the IOBYTE-routed CONIN dispatcher
 301  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 302  FB1D                      ; strip the high bit (7-bit ASCII)
 303  FB1D E6 7F                AND $7F
 304  FB1F                      ; HL = key-remap table base (z80 $F3AB = Apple $03AB; first entry pair at $03AC)
 305  FB1F 21 AB F3             LD HL,$F3AB
 306  FB22                      ; up to 6 remap-table entries
 307  FB22 06 06                LD B,$06
 308  FB24                      ; C = raw key
 309  FB24 4F                   LD C,A
 310  FB25              ; ----------------------------------------------------------------------
 311  FB25              ; CONIN_XLATE_LOOP -- scan the function/arrow-key remap table.
 312  FB25              ;   In:  C = raw key; B = entry count; HL -> table base.
 313  FB25              ;   Out: A = translated key on match (returns), else loops; A = C on table end.
 314  FB25              ;   Algorithm: each entry = [match byte, replacement byte]; a high-bit sentinel
 315  FB25              ;     match byte ends the table. [RE]
 316  FB25              ; ----------------------------------------------------------------------
 317  FB25              CONIN_XLATE_LOOP:
 318  FB25 23                   INC HL
 319  FB26                      ; entry's match byte
 320  FB26 7E                   LD A,(HL)
 321  FB27 23                   INC HL
 322  FB28 B7                   OR A
 323  FB29                      ; high-bit sentinel ends the table
 324  FB29 FA 31 FB             JP M,CONIN_XLATE_DONE
 325  FB2C                      ; raw key == this entry?
 326  FB2C B9                   CP C
 327  FB2D                      ; paired replacement byte
 328  FB2D 7E                   LD A,(HL)
 329  FB2E                      ; match -> return the translated key
 330  FB2E C8                   RET Z
 331  FB2F 10 F4                DJNZ CONIN_XLATE_LOOP
 332  FB31              ; ----------------------------------------------------------------------
 333  FB31              ; CONIN_XLATE_DONE -- no remap match: return the raw key in A. [RE]
 334  FB31              ; ----------------------------------------------------------------------
 335  FB31              CONIN_XLATE_DONE:
 336  FB31                      ; no match -> return the raw key
 337  FB31 79                   LD A,C
 338  FB32 C9                   RET
 339  FB33              ; ----------------------------------------------------------------------
 340  FB33              ; CONIN_KEYWAIT -- seed the keyboard-wait dispatch index, then wait for a key.
 341  FB33              ;   In:  none.  Out: A = 7-bit key (via KBD_WAIT_KEY).  Clobbers: A,DE.
 342  FB33              ;   Algorithm: load DE = 3 (the default console index), then JP through the
 343  FB33              ;     self-modified CONIN_DISPATCH cell; at boot that target is patched to the
 344  FB33              ;     selected keyboard-wait handler (default KBD_WAIT_KEY). [RE]
 345  FB33              ; ----------------------------------------------------------------------
 346  FB33              CONIN_KEYWAIT:
 347  FB33                      ; DE = 3 = default console-device index
 348  FB33 11 03 00             LD DE,$0003
 349  FB36              ; ----------------------------------------------------------------------
 350  FB36              ; CONIN_DISPATCH -- self-modified keyboard-wait vector.
 351  FB36              ;   The JP target ($FB39 / KBD_WAIT_KEY by default) is patched at boot per the
 352  FB36              ;   selected console card.  Referenced as CONIN_DISPATCH+1 by the patch site. [RE]
 353  FB36              ; ----------------------------------------------------------------------
 354  FB36              CONIN_DISPATCH:
 355  FB36                      ; target (CONIN_DISPATCH+1) patched at boot to the chosen keyboard-wait handler
 356  FB36 C3 39 FB             JP KBD_WAIT_KEY
 357  FB39              ; ----------------------------------------------------------------------
 358  FB39              ; KBD_WAIT_KEY -- spin on the Apple keyboard register until a key is down.
 359  FB39              ;   In:  none.  Out: A = 7-bit key (high bit cleared).  Clobbers: A.
 360  FB39              ;   Algorithm: poll z80 $E000 = Apple $C000; RLA puts key-ready (bit 7) into carry,
 361  FB39              ;     spin while clear; on a key, clear the strobe at $E010 = Apple $C010 and return
 362  FB39              ;     the 7-bit key (CCF/RRA). [RE]
 363  FB39              ; ----------------------------------------------------------------------
 364  FB39              KBD_WAIT_KEY:
 365  FB39                      ; poll z80 $E000 = Apple $C000 keyboard register
 366  FB39 3A 00 E0             LD A,($E000)
 367  FB3C                      ; key-ready (bit 7) -> carry
 368  FB3C 17                   RLA
 369  FB3D                      ; spin until a key is down
 370  FB3D 30 FA                JR NC,KBD_WAIT_KEY
 371  FB3F                      ; clear the keyboard strobe (z80 $E010 = Apple $C010)
 372  FB3F 32 10 E0             LD ($E010),A
 373  FB42 3F                   CCF
 374  FB43                      ; A = 7-bit key
 375  FB43 1F                   RRA
 376  FB44 C9                   RET
 377  FB45              ; ----------------------------------------------------------------------
 378  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC.
 379  FB45              ;   In:  HL = command/params; A = trigger value.  Out: per the 6502 service routine.
 380  FB45              ;   Algorithm: stash HL to the command mailbox (z80 $F3D0 = Apple $03D0), then poke
 381  FB45              ;     the trigger cell.  The trigger store-address ($0000 here) is self-modified per
 382  FB45              ;     config at boot, so the store site is RPC_TRIGGER_STORE+1. [RE]
 383  FB45              ; ----------------------------------------------------------------------
 384  FB45              RPC_TRIGGER:
 385  FB45                      ; z80 $F3D0 = Apple $03D0 = RPC command/params mailbox
 386  FB45 22 D0 F3             LD ($F3D0),HL
 387  FB48              RPC_TRIGGER_STORE:
 388  FB48 32 00 00             LD ($0000),A
 389  FB4B C9                   RET
 390  FB4C              ; ----------------------------------------------------------------------
 391  FB4C              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE.
 392  FB4C              ;   In:  A = character (the BIOS CONOUT arg).  The jump-vector CONOUT entry targets
 393  FB4C              ;        CONOUT_DISPATCH+1 ($FB4D), skipping the leading LD C,A; the fall-through
 394  FB4C              ;        entry here (from the dispatcher) keeps it.
 395  FB4C              ;   Out: none.  Clobbers: A,C,HL.
 396  FB4C              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03).  Field
 397  FB4C              ;     value 2 dispatches through the SoftCard I/O vector at $F392 (Apple $0392) with
 398  FB4C              ;     JP (HL); otherwise fall into the column/tab filter. [RE]
 399  FB4C              ; ----------------------------------------------------------------------
 400  FB4C              CONOUT_DISPATCH:
 401  FB4C                      ; save the character to emit in C for the filter path (skipped by the +1 entry)
 402  FB4C 4F                   LD C,A
 403  FB4D                      ; read the CP/M IOBYTE (page-zero $0003)
 404  FB4D 3A 03 00             LD A,($0003)
 405  FB50                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 406  FB50 E6 03                AND $03
 407  FB52                      ; device value 2 = direct console; anything else takes the filter path
 408  FB52 FE 02                CP $02
 409  FB54 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 410  FB56              CONOUT_VIA_VEC_F392:
 411  FB56                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 412  FB56 2A 92 F3             LD HL,($F392)
 413  FB59 E9                   JP (HL)
 414  FB5A              ; ----------------------------------------------------------------------
 415  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE CONSOLE field.
 416  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 417  FB5A              ;   Algorithm: read IOBYTE, mask the CONSOLE field (AND $03).  Value 2 uses vector
 418  FB5A              ;     $F38A; the high value ($02<x) uses the preloaded $F384; low values use $F382;
 419  FB5A              ;     then JP (HL) into the chosen handler.  ($F38x = Apple $038x I/O vector.)
 420  FB5A              ;     Called by CONIN (the remap wrapper) and reused by READER. [RE]
 421  FB5A              ; ----------------------------------------------------------------------
 422  FB5A              CONIN_DISPATCH_IOBYTE:
 423  FB5A                      ; read the CP/M IOBYTE
 424  FB5A 3A 03 00             LD A,($0003)
 425  FB5D                      ; isolate the 2-bit CONSOLE device field
 426  FB5D E6 03                AND $03
 427  FB5F FE 02                CP $02
 428  FB61                      ; preload the input vector for the high CONSOLE value ($F384 = Apple $0384)
 429  FB61 2A 84 F3             LD HL,($F384)
 430  FB64 28 06                JR Z,CONIN_VIA_VEC_F38A
 431  FB66 30 07                JR NC,DISPATCH_VIA_HL
 432  FB68              CONIN_VIA_VEC_F382:
 433  FB68                      ; input vector for the low CONSOLE values ($F382 = Apple $0382)
 434  FB68 2A 82 F3             LD HL,($F382)
 435  FB6B E9                   JP (HL)
 436  FB6C              CONIN_VIA_VEC_F38A:
 437  FB6C                      ; input vector for CONSOLE value 2 ($F38A = Apple $038A)
 438  FB6C 2A 8A F3             LD HL,($F38A)
 439  FB6F              DISPATCH_VIA_HL:
 440  FB6F E9                   JP (HL)
 441  FB70              ; ----------------------------------------------------------------------
 442  FB70              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 443  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 444  FB70              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0).  Below $80
 445  FB70              ;     routes to the column/tab filter; == $80 reuses the console vector path
 446  FB70              ;     (CONOUT_VIA_VEC_F392); higher values dispatch through list vector $F394
 447  FB70              ;     (Apple $0394). [RE]
 448  FB70              ; ----------------------------------------------------------------------
 449  FB70              LIST:
 450  FB70 3A 03 00             LD A,($0003)
 451  FB73                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 452  FB73 E6 C0                AND $C0
 453  FB75 FE 80                CP $80
 454  FB77                      ; field < $80 -> no-device / filter path
 455  FB77 38 27                JR C,DISPATCH_NODEV
 456  FB79                      ; field == $80 -> reuse the console output vector path
 457  FB79 28 DB                JR Z,CONOUT_VIA_VEC_F392
 458  FB7B                      ; list-handler vector ($F394 = Apple $0394)
 459  FB7B 2A 94 F3             LD HL,($F394)
 460  FB7E E9                   JP (HL)
 461  FB7F              ; ----------------------------------------------------------------------
 462  FB7F              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 463  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 464  FB7F              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30).  Below $10 takes the
 465  FB7F              ;     column/tab filter; == $10 dispatches through vector $F38E; higher values use
 466  FB7F              ;     vector $F390.  ($F38E/$F390 = Apple $038E/$0390.) [RE]
 467  FB7F              ; ----------------------------------------------------------------------
 468  FB7F              PUNCH:
 469  FB7F 3A 03 00             LD A,($0003)
 470  FB82                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 471  FB82 E6 30                AND $30
 472  FB84 FE 10                CP $10
 473  FB86                      ; field < $10 -> no-device / filter path
 474  FB86 38 18                JR C,DISPATCH_NODEV
 475  FB88                      ; punch vector for the higher PUNCH values ($F38E = Apple $038E)
 476  FB88 2A 8E F3             LD HL,($F38E)
 477  FB8B                      ; field == $10 -> use the $F390 vector below
 478  FB8B 28 E2                JR Z,DISPATCH_VIA_HL
 479  FB8D                      ; punch vector for PUNCH value $10 ($F390 = Apple $0390)
 480  FB8D 2A 90 F3             LD HL,($F390)
 481  FB90 E9                   JP (HL)
 482  FB91              ; ----------------------------------------------------------------------
 483  FB91              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 484  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 485  FB91              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C), compare against $08. Field
 486  FB91              ;     < $08 ($00/$04) reuses the CONIN $F382 vector; == $08 reuses the CONIN $F38A vector;
 487  FB91              ;     > $08 ($0C) uses the reader vector $F38C (Apple $038C). [RE]
 488  FB91              ; ----------------------------------------------------------------------
 489  FB91              READER:
 490  FB91 3A 03 00             LD A,($0003)
 491  FB94                      ; isolate the 2-bit READER device field of the IOBYTE
 492  FB94 E6 0C                AND $0C
 493  FB96 FE 08                CP $08
 494  FB98                      ; field < $08 ($00/$04) -> reuse the CONIN $F382 vector path
 495  FB98 38 CE                JR C,CONIN_VIA_VEC_F382
 496  FB9A                      ; field == $08 -> reuse the CONIN $F38A vector path
 497  FB9A 28 D0                JR Z,CONIN_VIA_VEC_F38A
 498  FB9C                      ; reader-handler vector ($F38C = Apple $038C)
 499  FB9C 2A 8C F3             LD HL,($F38C)
 500  FB9F E9                   JP (HL)
 501  FBA0              ; ----------------------------------------------------------------------
 502  FBA0              ; DISPATCH_NODEV -- IOBYTE field selects no physical device: fall into the filter.
 503  FBA0              ;   In:  carry set by the caller (no-device).  Out: enters CONOUT_FILTER_NOEXPAND
 504  FBA0              ;        with the carry folded into the COL_FLAG byte.  Clobbers: A,HL.
 505  FBA0              ;   Algorithm: SCF then (CONOUT_FILTER_NOEXPAND) SBC A,A turns carry into a 0/$FF
 506  FBA0              ;     flag stored in COL_FLAG ($FECB); clear bit 7 of the char in C; if the pending-
 507  FBA0              ;     column counter ($FECC) is nonzero, apply a config-driven column offset, else
 508  FBA0              ;     fall through to the tab/control expansion (SETDMA_1). [RE]
 509  FBA0              ; ----------------------------------------------------------------------
 510  FBA0              DISPATCH_NODEV:
 511  FBA0                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 512  FBA0 37                   SCF
 513  FBA1              CONOUT_FILTER_NOEXPAND:
 514  FBA1                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 515  FBA1 9F                   SBC A,A
 516  FBA2 21 A2 F3             LD HL,$F3A2
 517  FBA5 6E                   LD L,(HL)
 518  FBA6 2C                   INC L
 519  FBA7 CA A4 FC             JP Z,SCREEN_EMIT
 520  FBAA                      ; HL -> COL_FLAG cell ($FECB)
 521  FBAA 21 CB FE             LD HL,COL_FLAG
 522  FBAD                      ; store the entry flag into COL_FLAG
 523  FBAD 77                   LD (HL),A
 524  FBAE                      ; strip the high bit of the character (7-bit ASCII)
 525  FBAE CB B9                RES 7,C
 526  FBB0 23                   INC HL
 527  FBB1                      ; load COL_PENDING (pending column-skip / fill count, $FECC)
 528  FBB1 7E                   LD A,(HL)
 529  FBB2 B7                   OR A
 530  FBB3                      ; no pending column work -> run tab/control expansion
 531  FBB3 CA 56 FC             JP Z,SETDMA_1
 532  FBB6                      ; consume one pending column step
 533  FBB6 35                   DEC (HL)
 534  FBB7                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 535  FBB7 3A 96 F3             LD A,($F396)
 536  FBBA                      ; HL -> the column cell in the $FE85 deblock/screen-state band ($FED4)
 537  FBBA 21 D4 FE             LD HL,BOOT_TMPL_XORA
 538  FBBD                      ; config byte zero -> derive the offset from the running width
 539  FBBD 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 540  FBBF B7                   OR A
 541  FBC0 F2 C6 FB             JP P,COL_APPLY_OFFSET_RAW
 542  FBC3 2B                   DEC HL
 543  FBC4              ; ----------------------------------------------------------------------
 544  FBC4              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 545  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 546  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 547  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude, subtract it from the
 548  FBC4              ;     current column in C, store the new column.  Reached when the config byte's sign
 549  FBC4              ;     indicates a subtractive column adjust. [RE]
 550  FBC4              ; ----------------------------------------------------------------------
 551  FBC4              COL_APPLY_OFFSET:
 552  FBC4                      ; drop the sign bit to get the offset magnitude
 553  FBC4 E6 7F                AND $7F
 554  FBC6              COL_APPLY_OFFSET_RAW:
 555  FBC6 5F                   LD E,A
 556  FBC7 79                   LD A,C
 557  FBC8                      ; new column = current column (C) minus the offset
 558  FBC8 93                   SUB E
 559  FBC9                      ; store the updated column position
 560  FBC9 77                   LD (HL),A
 561  FBCA C9                   RET
 562  FBCB              ; ----------------------------------------------------------------------
 563  FBCB              ; COL_OFFSET_FROM_WIDTH -- derive the column offset from the running screen width.
 564  FBCB              ;   In:  C = current column; the BOOT-overlaid base word at (BOOT+2).
 565  FBCB              ;   Out: updates the column and emits via SCREEN_EMIT; combines a base address with
 566  FBCB              ;        the offset.  Clobbers: A,B,C,DE,HL.
 567  FBCB              ;   Algorithm: pick the column cell by the config sign, CALL COL_APPLY_OFFSET, then
 568  FBCB              ;     load the base word (BOOT+2 = the cold-boot operand reused as deblock
 569  FBCB              ;     scratch), fold in config $F3A1, and ADD to form the screen address before
 570  FBCB              ;     emitting (SCREEN_EMIT). [RE]
 571  FBCB              ; ----------------------------------------------------------------------
 572  FBCB              COL_OFFSET_FROM_WIDTH:
 573  FBCB B7                   OR A
 574  FBCC                      ; config sign negative -> keep the higher column cell
 575  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH_1
 576  FBCF 2B                   DEC HL
 577  FBD0              COL_OFFSET_FROM_WIDTH_1:
 578  FBD0                      ; apply the signed column offset (COL_APPLY_OFFSET)
 579  FBD0 CD C4 FB             CALL COL_APPLY_OFFSET
 580  FBD3                      ; base word = the BOOT-overlaid deblock scratch ($FED3)
 581  FBD3 2A D3 FE             LD HL,(BOOT+2)
 582  FBD6                      ; config byte $F3A1 = Apple $03A1 (screen-base modifier)
 583  FBD6 3A A1 F3             LD A,($F3A1)
 584  FBD9 B7                   OR A
 585  FBDA                      ; config positive -> use HL as-is, skip the byte swap
 586  FBDA F2 E2 FB             JP P,COL_COMBINE_BASE
 587  FBDD                      ; negative: drop the sign bit, then swap H<->L below
 588  FBDD E6 7F                AND $7F
 589  FBDF 5D                   LD E,L
 590  FBE0 6C                   LD L,H
 591  FBE1 63                   LD H,E
 592  FBE2              ; ----------------------------------------------------------------------
 593  FBE2              ; COL_COMBINE_BASE -- fold the config offset into the base address, emit the char.
 594  FBE2              ;   In:  A = config offset; HL = base word; C will receive the high result.
 595  FBE2              ;   Out: pushes the low result, emits via SCREEN_EMIT with B=7, then re-enters the
 596  FBE2              ;        emit path with B=$0A.  Clobbers: A,B,C,DE,HL.
 597  FBE2              ;   Algorithm: C = offset + H; A = offset + L; CALL SCREEN_EMIT (B=7), then fall into
 598  FBE2              ;     CONOUT_EMIT_B with B=$0A. [RE]
 599  FBE2              ; ----------------------------------------------------------------------
 600  FBE2              COL_COMBINE_BASE:
 601  FBE2 5F                   LD E,A
 602  FBE3                      ; C = config offset + base high byte
 603  FBE3 84                   ADD A,H
 604  FBE4 4F                   LD C,A
 605  FBE5 7B                   LD A,E
 606  FBE6                      ; A = config offset + base low byte
 607  FBE6 85                   ADD A,L
 608  FBE7 F5                   PUSH AF
 609  FBE8                      ; mode/count code 7 for the screen emit
 610  FBE8 06 07                LD B,$07
 611  FBEA                      ; emit via the screen handler (SCREEN_EMIT)
 612  FBEA CD A4 FC             CALL SCREEN_EMIT
 613  FBED F1                   POP AF
 614  FBEE                      ; mode/count code $0A for the follow-up emit
 615  FBEE 06 0A                LD B,$0A
 616  FBF0              CHAR_C_TO_SCREEN:
 617  FBF0 4F                   LD C,A
 618  FBF1 C3 A4 FC             JP SCREEN_EMIT
 619  FBF4              ; ----------------------------------------------------------------------
 620  FBF4              ; SETSEC -- BIOS jump-vector entry 11 ($FA24 -> $FBF4): set the requested sector.
 621  FBF4              ;   In:  C = sector number. Out: none. Clobbers: A.
 622  FBF4              ;   Algorithm: store C into the sector cell BOOT+1 ($FED2 = the cold-boot LD SP operand
 623  FBF4              ;        low byte, reused post-boot as the requested-sector cell). The off-image RWTS
 624  FBF4              ;        ($AC39/$AC49) is the consumer; this image only WRITES it. Mirrors 2.20 SETSEC.
 625  FBF4              ;        [RE, transferred from 2.20; the off-image consumer is not in this image]
 626  FBF4              ; ----------------------------------------------------------------------
 627  FBF4              SETSEC:
 628  FBF4 79                   LD A,C
 629  FBF5                      ; store the requested sector into BOOT+1 (reused as the seksec cell)
 630  FBF5 32 D2 FE             LD (BOOT+1),A
 631  FBF8 C9                   RET
 632  FBF9              ; ----------------------------------------------------------------------
 633  FBF9              ; SETDMA -- BIOS jump-vector entry 12 ($FA27 -> $FBF9): set the DMA address.
 634  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 635  FBF9              ;   Out: none. Clobbers: none.
 636  FBF9              ;   Algorithm: store BC into the dmaadr cell (SECTOR_BLOCK_PATCH+2 = $FEE1, the
 637  FBF9              ;        operand region of the install-template 'LD ($0003),A'). The OFF-IMAGE
 638  FBF9              ;        deblock copy uses dmaadr as the host<->record transfer endpoint. The 2.20
 639  FBF9              ;        deblock did the LDIR itself; in 2.23 the value is read off-image. [RE]
 640  FBF9              ; ----------------------------------------------------------------------
 641  FBF9              SETDMA:
 642  FBF9                      ; store BC into dmaadr ($FEE1, overlaid on the install-template LD ($0003),A operand)
 643  FBF9 ED 43 E1 FE          LD (DISK_DMAADR+2),BC
 644  FBFD C9                   RET
 645  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 646  FC56              SETDMA_1:
 647  FC56 47                   LD B,A
 648  FC57 21 CD FE             LD HL,COL_STATE
 649  FC5A 7E                   LD A,(HL)
 650  FC5B 5F                   LD E,A
 651  FC5C B7                   OR A
 652  FC5D 20 12                JR NZ,SETDMA_3
 653  FC5F 3A 97 F3             LD A,($F397)
 654  FC62 B7                   OR A
 655  FC63 28 06                JR Z,SETDMA_2
 656  FC65 B9                   CP C
 657  FC66 20 03                JR NZ,SETDMA_2
 658  FC68 36 80                LD (HL),$80
 659  FC6A C9                   RET
 660  FC6B              SETDMA_2:
 661  FC6B 3E 1F                LD A,$1F
 662  FC6D B9                   CP C
 663  FC6E DA A4 FC             JP C,SCREEN_EMIT
 664  FC71              SETDMA_3:
 665  FC71 21 A0 F3             LD HL,$F3A0
 666  FC74 06 09                LD B,$09
 667  FC76              SETDMA_4:
 668  FC76 7E                   LD A,(HL)
 669  FC77 B7                   OR A
 670  FC78 28 04                JR Z,SETDMA_5
 671  FC7A AB                   XOR E
 672  FC7B B9                   CP C
 673  FC7C 28 05                JR Z,SETDMA_6
 674  FC7E              SETDMA_5:
 675  FC7E 2B                   DEC HL
 676  FC7F 10 F5                DJNZ SETDMA_4
 677  FC81 18 21                JR SCREEN_EMIT
 678  FC83              SETDMA_6:
 679  FC83 11 0B 00             LD DE,$000B
 680  FC86 19                   ADD HL,DE
 681  FC87 7E                   LD A,(HL)
 682  FC88 B7                   OR A
 683  FC89 4F                   LD C,A
 684  FC8A F2 9A FC             JP P,SETDMA_7
 685  FC8D E6 7F                AND $7F
 686  FC8F 4F                   LD C,A
 687  FC90 C5                   PUSH BC
 688  FC91 3A A2 F3             LD A,($F3A2)
 689  FC94 06 07                LD B,$07
 690  FC96 CD F0 FB             CALL CHAR_C_TO_SCREEN
 691  FC99 C1                   POP BC
 692  FC9A              SETDMA_7:
 693  FC9A 78                   LD A,B
 694  FC9B FE 07                CP $07
 695  FC9D 20 05                JR NZ,SCREEN_EMIT
 696  FC9F 3E 02                LD A,$02
 697  FCA1 32 CC FE             LD (COL_PENDING),A
 698  FCA4              SCREEN_EMIT:
 699  FCA4 AF                   XOR A
 700  FCA5 32 CD FE             LD (COL_STATE),A
 701  FCA8 3A CB FE             LD A,(COL_FLAG)
 702  FCAB B7                   OR A
 703  FCAC 2A 88 F3             LD HL,($F388)
 704  FCAF 28 03                JR Z,SCREEN_EMIT_1
 705  FCB1 2A 86 F3             LD HL,($F386)
 706  FCB4              SCREEN_EMIT_1:
 707  FCB4 E9                   JP (HL)
 708  FCB5              SCREEN_EMIT_2:
 709  FCB5 11 03 00             LD DE,$0003
 710  FCB8              SCREEN_EMIT_3:
 711  FCB8 C3 BB FC             JP SCREEN_EMIT_4
 712  FCBB              SCREEN_EMIT_4:
 713  FCBB 2A CE FE             LD HL,(SCREEN_CURSOR_PTR)
 714  FCBE 3A D0 FE             LD A,(SCREEN_CHAR)
 715  FCC1 77                   LD (HL),A
 716  FCC2 CD E2 FC             CALL CTRL_CHAR_DISPATCH
 717  FCC5 2A 28 F0             LD HL,($F028)
 718  FCC8 3A 24 F0             LD A,($F024)
 719  FCCB 5F                   LD E,A
 720  FCCC 16 F0                LD D,$F0
 721  FCCE 19                   ADD HL,DE
 722  FCCF 22 CE FE             LD (SCREEN_CURSOR_PTR),HL
 723  FCD2 7E                   LD A,(HL)
 724  FCD3 32 D0 FE             LD (SCREEN_CHAR),A
 725  FCD6 FE E0                CP $E0
 726  FCD8 38 02                JR C,SCREEN_EMIT_5
 727  FCDA EE 20                XOR $20
 728  FCDC              SCREEN_EMIT_5:
 729  FCDC E6 3F                AND $3F
 730  FCDE F6 40                OR $40
 731  FCE0 77                   LD (HL),A
 732  FCE1 C9                   RET
 733  FCE2              CTRL_CHAR_DISPATCH:
 734  FCE2 78                   LD A,B
 735  FCE3 B7                   OR A
 736  FCE4 28 0B                JR Z,CTRL_PLAIN_CHAR
 737  FCE6 21 45 FB             LD HL,RPC_TRIGGER
 738  FCE9 E5                   PUSH HL
 739  FCEA 21 66 FD             LD HL,CTRL_HANDLER_OFFSET_TBL
 740  FCED 85                   ADD A,L
 741  FCEE 6F 6E E9             DEFB    $6F,$6E,$E9
 742  FCF1              CTRL_PLAIN_CHAR:
 743  FCF1 79 FE 0D 20          DEFB    $79,$FE,$0D,$20,$05
 743  FCF5 05
 744  FCF6 AF 32 24 F0          DEFB    $AF,$32,$24,$F0,$C9,$F6,$80 ; "/2$pIv"
 744  FCFA C9 F6 80
 745  FCFD FE E0 38 04          DEFB    $FE,$E0,$38,$04
 746  FD01 21 DD F3 AE          DEFB    $21,$DD,$F3,$AE,$32,$45,$F0,$21,$F0,$FD,$C3,$80 ; "!]s.2Ep!p}C"
 746  FD05 32 45 F0 21
 746  FD09 F0 FD C3 80
 747  FD0D FD CD 81 FE          DEFB    $FD,$CD,$81,$FE,$C6,$8F
 747  FD11 C6 8F
 748  FD13 CB 4E 28 FC          DEFB    $CB,$4E,$28,$FC,$21,$2F,$F0,$36,$60,$2B,$36,$C0,$2B,$77,$2B,$36 ; "KN(|!/p6`+6@+w+6"
 748  FD17 21 2F F0 36
 748  FD1B 60 2B 36 C0
 748  FD1F 2B 77 2B 36
 749  FD23 8D                   DEFB    $8D
 750  FD24 62 C3 7C FD          DEFB    $62,$C3,$7C,$FD,$3E,$FF,$01,$3E,$3F,$32,$32,$F0,$E1,$C9,$21,$F4

 898  FDD0              ; SUB_0E1D:
 899  FDD0              ;         TYA                          ; $0E1D  98
 900  FDD0              ;         ORA #$C0                     ; $0E1E  09 C0
 901  FDD0              ;         TAX                          ; $0E20  AA
 902  FDD0              ;         TYA                          ; $0E21  98
 903  FDD0              ;         ASL                          ; $0E22  0A
 904  FDD0              ;         ASL                          ; $0E23  0A
 905  FDD0              ;         ASL                          ; $0E24  0A
 906  FDD0              ;         ASL                          ; $0E25  0A
 907  FDD0              ;         TAY                          ; $0E26  A8
 908  FDD0              ;         STY $06F8                    ; $0E27  8C F8 06
 909  FDD0              ;         LDA #$00                     ; $0E2A  A9 00
 910  FDD0              ;         STA $F6                      ; $0E2C  85 F6
 911  FDD0              ;         STX $F7                      ; $0E2E  86 F7

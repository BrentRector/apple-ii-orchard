 824  FDC1              ; SCREEN_RPC_HELPER -- read back a screen byte via the RPC: position, fire the RPC, fetch.
 825  FDC1              SCREEN_RPC_HELPER:
 826  FDC1 CD 83 FD             CALL SET_SCREEN_BASE                    ; compute the screen base for the current row
 827  FDC4 21 4D C8             LD HL,$C84D                      ; 6502 RPC parameter (Apple expansion-ROM addr)
 828  FDC7 CD 45 FB             CALL RPC_TRIGGER                 ; run the embedded 6502 service on the 6502
 829  FDCA 21 78 F6             LD HL,$F678                      ; HL = row buffer base (Apple $0678)
 830  FDCD 19                   ADD HL,DE
 831  FDCE 7E                   LD A,(HL)                        ; read back the character
 832  FDCF C9                   RET
 833  FDD0              ; RPC6502_SERVICE_223 -- the embedded 6502 RPC service ($FDD0-$FE41 = Apple $0DD0); its
 834  FDD0              ; own ca65 source CPM_RPC6502_223.s is sub-assembled and INCBIN'd here (the 2.20
 835  FDD0              ; CPM_RPC6502 pattern). It forms a slot-ROM pointer ($CFFF disables expansion ROM),
 836  FDD0              ; LDA ($F6),Y, and JMP ($00F6) dispatches into the selected slot-ROM/firmware routine.
 837  FDD0              RPC6502_SERVICE_223:
 838  FDD0              ;   >>> CPM_RPC6502_223.s -- verbatim listing of the INCBIN'd source (regen: inject_incbin_listing) >>>
 839  FDD0              ;
 840  FDD0              ; .org $0DD0
 841  FDD0              ;
 842  FDD0              ; L_0DD0:
 843  FDD0              ;         PHA                          ; $0DD0  48
 844  FDD0              ;         JSR SUB_0E1D                 ; $0DD1  20 1D 0E
 845  FDD0              ;         LDY #$0D                     ; $0DD4  A0 0D
 846  FDD0              ; L_0DD6:
 847  FDD0              ;         LDA ($F6),Y                  ; $0DD6  B1 F6
 848  FDD0              ;         STA $F6                      ; $0DD8  85 F6
 849  FDD0              ;         LDY $06F8                    ; $0DDA  AC F8 06
 850  FDD0              ;         PLA                          ; $0DDD  68
 851  FDD0              ;         JMP ($00F6)                ; $0DDE  6C F6 00
 852  FDD0              ; L_0DE1:
 853  FDD0              ;         PHA                          ; $0DE1  48
 854  FDD0              ;         LDA #$00                     ; $0DE2  A9 00
 855  FDD0              ;         JSR SUB_0DEF                 ; $0DE4  20 EF 0D
 856  FDD0              ;         JSR SUB_0E1D                 ; $0DE7  20 1D 0E
 857  FDD0              ;         LDY #$0F                     ; $0DEA  A0 0F
 858  FDD0              ;         JMP L_0DD6                   ; $0DEC  4C D6 0D
 859  FDD0              ; SUB_0DEF:
 860  FDD0              ;         STY $F5                      ; $0DEF  84 F5
 861  FDD0              ;         PHA                          ; $0DF1  48
 862  FDD0              ;         JSR SUB_0E14                 ; $0DF2  20 14 0E
 863  FDD0              ;         PLA                          ; $0DF5  68
 864  FDD0              ;         LDY $F5                      ; $0DF6  A4 F5
 865  FDD0              ;         BCC SUB_0DEF                 ; $0DF8  90 F5
 866  FDD0              ;         RTS                          ; $0DFA  60
 867  FDD0              ;         .byte   $00, $00, $00, $00, $00, $4C, $E9, $BB, $4C, $04, $BE, $A9, $01, $20, $EF, $0D ; $0DFB
 868  FDD0              ;         .byte   $20, $1D, $0E, $48, $A0, $0E, $4C, $D6, $0D      ; $0E0B
 869  FDD0              ; SUB_0E14:
 870  FDD0              ;         PHA                          ; $0E14  48
 871  FDD0              ;         JSR SUB_0E1D                 ; $0E15  20 1D 0E
 872  FDD0              ;         LDY #$10                     ; $0E18  A0 10
 873  FDD0              ;         JMP L_0DD6                   ; $0E1A  4C D6 0D
 874  FDD0              ; SUB_0E1D:
 875  FDD0              ;         TYA                          ; $0E1D  98
 876  FDD0              ;         ORA #$C0                     ; $0E1E  09 C0
 877  FDD0              ;         TAX                          ; $0E20  AA
 878  FDD0              ;         TYA                          ; $0E21  98
 879  FDD0              ;         ASL                          ; $0E22  0A
 880  FDD0              ;         ASL                          ; $0E23  0A
 881  FDD0              ;         ASL                          ; $0E24  0A
 882  FDD0              ;         ASL                          ; $0E25  0A
 883  FDD0              ;         TAY                          ; $0E26  A8
 884  FDD0              ;         STY $06F8                    ; $0E27  8C F8 06
 885  FDD0              ;         LDA #$00                     ; $0E2A  A9 00
 886  FDD0              ;         STA $F6                      ; $0E2C  85 F6
 887  FDD0              ;         STX $F7                      ; $0E2E  86 F7
 888  FDD0              ;         LDA $CFFF                    ; $0E30  AD FF CF
 889  FDD0              ;         LDA ($F6),Y                  ; $0E33  B1 F6
 890  FDD0              ;         RTS                          ; $0E35  60
 891  FDD0              ; SUB_0E1D_1:
 892  FDD0              ;         LDA $48                      ; $0E36  A5 48
 893  FDD0              ;         PHA                          ; $0E38  48
 894  FDD0              ;         LDA $45                      ; $0E39  A5 45
 895  FDD0              ;         LDX $46                      ; $0E3B  A6 46
 896  FDD0              ;         LDY $47                      ; $0E3D  A4 47
 897  FDD0              ;         PLP                          ; $0E3F  28
 898  FDD0              ;         CLI                          ; $0E40  58
 899  FDD0              ;         RTS                          ; $0E41  60
 900  FDD0              ;   <<< end listing <<<
 901  FDD0                      INCBIN "CPM_RPC6502_223.bin"     ; 114 bytes of 6502 (runs on the 6502 via the RPC)
 902  FE42              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 903  FE42              DEV_READ_BIT:
 904  FE42 CD 81 FE             CALL SLOT_IO_ADDR
 905  FE45              DEV_READ_WAIT:
 906  FE45 7E                   LD A,(HL)
 907  FE46 1F                   RRA                              ; ready bit -> carry
 908  FE47 30 FC                JR NC,DEV_READ_WAIT
 909  FE49 2C                   INC L
 910  FE4A 7E                   LD A,(HL)                        ; read the data byte
 911  FE4B C9                   RET
 912  FE4C              DEV_OUT_1:                               ; default I/O vector handler (LIST stub)
 913  FE4C 11 01 00             LD DE,$0001
 914  FE4F              DEV_OUT_1_JP:
 915  FE4F C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 916  FE52              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 917  FE52              DEV_WR_BIT:
 918  FE52 CD B1 FA             CALL DEVICE_IO_BASE
 919  FE55 2E C1                LD L,$C1
 920  FE57              DEV_WR_WAIT:
 921  FE57 7E                   LD A,(HL)
 922  FE58 17                   RLA                              ; ready bit -> carry
 923  FE59 38 FC                JR C,DEV_WR_WAIT
 924  FE5B CD 7C FE             CALL SLOT_IO_ADDR_W
 925  FE5E 71                   LD (HL),C
 926  FE5F              DEV_RET:
 927  FE5F C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 928  FE60              DEV_OUT_2:                               ; default I/O vector handler (PUNCH stub)
 929  FE60 11 02 00             LD DE,$0002
 930  FE63              DEV_OUT_2_JP:
 931  FE63 C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 932  FE66              DEV_OUT_3:                               ; default I/O vector handler (READER stub)
 933  FE66 11 02 00             LD DE,$0002
 934  FE69              DEV_OUT_3_JP:
 935  FE69 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 936  FE6C              ; ----------------------------------------------------------------------
 937  FE6C              ; HOME -- BIOS jump-vector entry 8 ($FA18): seek the selected drive to track 0. [RE]
 938  FE6C              ;   In:  none. Out: none. Clobbers: A,C.
 939  FE6C              ;   Algorithm: if the host buffer still holds a pending write (hstwrt nonzero) leave
 940  FE6C              ;     hstact set so the dirty buffer is not dropped; else clear hstact (host buffer
 941  FE6C              ;     inactive). Then fall through into SETTRK_STORE with track 0. Mirrors the 2.20
 942  FE6C              ;     twin HOME exactly; the actual head step happens later in the deblock path. [RE]
 943  FE6C              ; ----------------------------------------------------------------------
 944  FE6C              HOME:
 945  FE6C                      ; read hstwrt (host-write-pending flag; lives in the BOOT install-template cells)
 946  FE6C 3A D9 FE             LD A,(DISK_HSTWRT)
 947  FE6F B7                   OR A
 948  FE70                      ; pending write -> keep hstact set, skip the clear
 949  FE70 20 03                JR NZ,SETTRK_STORE
 950  FE72                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 951  FE72 32 D8 FE             LD (DISK_HSTACT),A
 952  FE75              ; ----------------------------------------------------------------------
 953  FE75              ; SETTRK_STORE -- HOME falls in here with track 0; common tail with SETTRK. [RE]
 954  FE75              ;   In:  (HOME path) forces C=0. Out: stores sektrk. Clobbers: A,C.
 955  FE75              ;   Algorithm: load C=0, then fall into SETTRK's store (the $FE77 vector body) which
 956  FE75              ;     writes the track into the BOOT 'LD SP' operand byte reused as sektrk. [RE]
 957  FE75              ; ----------------------------------------------------------------------
 958  FE75              SETTRK_STORE:
 959  FE75                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 960  FE75 0E 00                LD C,$00
 961  FE77                      ; SETTRK (vector entry 10, JP $FE77): track number from BDOS in C
 962  FE77 79                   LD A,C
 963  FE78                      ; store sektrk into BOOT's LD SP operand byte (BOOT cell reused post-boot as sektrk)
 964  FE78 32 D1 FE             LD (BOOT),A
 965  FE7B C9                   RET
 966  FE7C              ; ----------------------------------------------------------------------
 967  FE7C              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 968  FE7C              ;   In:  E = slot/drive index (0..15). Out: HL = $E080 + (E<<4). Clobbers: A,L.
 969  FE7C              ;   Algorithm: load the $C08x write/control-bank base (z80 $E080 = Apple $C080), then
 970  FE7C              ;     fall into the shared index scaler (SLOT_IO_SCALE, the ADD A,A x4 at $FE85).
 971  FE7C              ;     Twin of 2.20 SLOT_IO_ADDR_W. [RE]
 972  FE7C              ; ----------------------------------------------------------------------
 973  FE7C              SLOT_IO_ADDR_W:
 974  FE7C                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 975  FE7C 21 80 E0             LD HL,$E080
 976  FE7F 18 03                JR SLOT_IO_SCALE_E
 977  FE81              ; ----------------------------------------------------------------------
 978  FE81              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch base ($C08E bank).
 979  FE81              ;   In:  E = slot/drive index (0..15). Out: HL = $E08E + (E<<4). Clobbers: A,L.
 980  FE81              ;   Algorithm: load the $C08E base, fall into SLOT_IO_SCALE_E. z80 $E08E = Apple $C08E.
 981  FE81              ;     Twin of 2.20 SLOT_IO_ADDR. [RE]
 982  FE81              ; ----------------------------------------------------------------------
 983  FE81              SLOT_IO_ADDR:
 984  FE81                      ; z80 $E08E = Apple $C08E slot-I/O base
 985  FE81 21 8E E0             LD HL,$E08E
 986  FE84              ; ----------------------------------------------------------------------
 987  FE84              ; SLOT_IO_SCALE_E -- load the slot/drive index into A, then fall into SLOT_IO_SCALE.
 988  FE84              ;   In:  E = index. Out: continues into the scaler. Twin of 2.20 SLOT_IO_SCALE_E. [RE]
 989  FE84              ; ----------------------------------------------------------------------
 990  FE84              SLOT_IO_SCALE_E:
 991  FE84                      ; slot/drive index into A for the scaler
 992  FE84 7B                   LD A,E
 993  FE85              ; ----------------------------------------------------------------------
 994  FE85              ; SLOT_IO_SCALE -- shift the index in A left by 4 and add it to L (index a $C0n0..$C0nF
 995  FE85              ;     16-byte slot-I/O block, or a *16-stride table). [RE]
 996  FE85              ;   In:  A = index, L = base low byte. Out: L += A*16; A preserved. Clobbers: A,L.
 997  FE85              ;   Algorithm: ADD A,A four times (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET.
 998  FE85              ;     Shared by SLOT_IO_ADDR/_W and by SELDSK (DPH-table index) and the device probe.
 999  FE85              ;     Twin of 2.20 SLOT_IO_SCALE. [RE]
1000  FE85              ; ----------------------------------------------------------------------
1001  FE85              SLOT_IO_SCALE:
1002  FE85                      ; A *= 16 over the four ADD A,A (slot block is 16 bytes; DPH stride is 16)
1003  FE85 87                   ADD A,A
1004  FE86 87                   ADD A,A
1005  FE87 87                   ADD A,A
1006  FE88 87                   ADD A,A
1007  FE89 F5                   PUSH AF
1008  FE8A                      ; L = base + index*16
1009  FE8A 85                   ADD A,L
1010  FE8B 6F                   LD L,A
1011  FE8C F1                   POP AF
1012  FE8D C9                   RET
1013  FE8E              ; ----------------------------------------------------------------------
1014  FE8E              ; SELDSK -- BIOS jump-vector entry 9 ($FA1B): select the disk drive for subsequent I/O.
1015  FE8E              ;   In:  C = disk number (0-based). Out: HL = DPH address for drive C, or HL=0 if out
1016  FE8E              ;     of range. Clobbers: A,DE,HL.
1017  FE8E              ;   Algorithm: DE -> the sekdsk build site (DISK_SEKDSK, an install-template cell reused
1018  FE8E              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
1019  FE8E              ;     block (z80 $F3B8 = Apple $03B8); if C >= count return HL=0. Else record the disk
1020  FE8E              ;     number, index the DPH table at DPH_TABLE by C*16 (CALL SLOT_IO_SCALE), pull a per-drive
1021  FE8E              ;     disk-parameter byte and self-modify the install template SECTOR_BLOCK_PATCH+1 with it.
1022  FE8E              ;     Twin of 2.20 SELDSK. [RE]
1023  FE8E              ; ----------------------------------------------------------------------
1024  FE8E              SELDSK:
1025  FE8E                      ; DE -> sekdsk build site (install-template cell reused as disk-select scratch)
1026  FE8E 11 D5 FE             LD DE,DISK_SEKDSK
1027  FE91 21 04 00             LD HL,$0004
1028  FE94                      ; configured drive count from the SoftCard config block (Apple $03B8)
1029  FE94 3A B8 F3             LD A,($F3B8)
1030  FE97 3D                   DEC A
1031  FE98                      ; requested drive vs (count-1); carry => out of range
1032  FE98 B9                   CP C
1033  FE99                      ; out of range -> SELDSK_BAD_DRIVE (returns HL=0)
1034  FE99 38 1D                JR C,SELDSK_BAD_DRIVE
1035  FE9B 7E                   LD A,(HL)
1036  FE9C 12                   LD (DE),A
1037  FE9D 13                   INC DE
1038  FE9E 79                   LD A,C
1039  FE9F 12                   LD (DE),A
1040  FEA0                      ; HL = DPH table base ($FA33); CALL SLOT_IO_SCALE indexes it by C*16
1041  FEA0 21 33 FA             LD HL,DPH_TABLE
1042  FEA3 CD 85 FE             CALL SLOT_IO_SCALE
1043  FEA6 E5                   PUSH HL
1044  FEA7 11 0A 00             LD DE,$000A
1045  FEAA 19                   ADD HL,DE
1046  FEAB 5E                   LD E,(HL)
1047  FEAC 23                   INC HL
1048  FEAD 56                   LD D,(HL)
1049  FEAE 21 05 00             LD HL,$0005
1050  FEB1 19                   ADD HL,DE
1051  FEB2 7E                   LD A,(HL)
1052  FEB3                      ; self-modify: store the per-drive disk-parameter byte into the install template's LD
1053  FEB3                      ; HL,(nn) operand [RE]
1054  FEB3 32 E3 FE             LD (SECTOR_BLOCK_PATCH+1),A
1055  FEB6 E1                   POP HL
1056  FEB7 C9                   RET
1057  FEB8              ; ----------------------------------------------------------------------
1058  FEB8              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH). [RE]
1059  FEB8              ;   In:  DE -> sekdsk build site. Out: HL=0. Clobbers: A,L.
1060  FEB8              ;   Twin of 2.20 SELDSK_BAD_DRIVE. [RE]
1061  FEB8              ; ----------------------------------------------------------------------
1062  FEB8              SELDSK_BAD_DRIVE:
1063  FEB8 1A                   LD A,(DE)
1064  FEB9 77                   LD (HL),A
1065  FEBA                      ; HL=0 signals an invalid drive to the BDOS
1066  FEBA 2E 00                LD L,$00
1067  FEBC C9                   RET
1068  FEBD              ; ----------------------------------------------------------------------
1069  FEBD              ; READ -- BIOS jump-vector entry 13 ($FA27): read one 128-byte CP/M record.
1070  FEBD              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1071  FEBD              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS read core at $AC39, which sits
1072  FEBD              ;     in the system-image region BELOW the BIOS (not inside $FA00-$FFFF). FLAG: unlike
1073  FEBD              ;     the 2.20 twin, the 2.23 BIOS does NOT carry the deblock or the $03E0-IOB RWTS RPC
1074  FEBD              ;     in-image; READ/WRITE delegate to the $ACxx host-sector routines. [RE] -- see flags.
1075  FEBD              ; ----------------------------------------------------------------------
1076  FEBD              READ:
1077  FEBD                      ; off-image jump to the deblock/RWTS read core at $AC39 (system-image region, not BIOS) [RE]
1078  FEBD C3 39 AC             JP $AC39
1079  FEC0              ; ----------------------------------------------------------------------
1080  FEC0              ; WRITE -- BIOS jump-vector entry 14 ($FA2A): write one 128-byte CP/M record.
1081  FEC0              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1082  FEC0              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS write core at $AC49 (system-image
1083  FEC0              ;     region below the BIOS). Same off-image RWTS delegation as READ_RECORD. [RE]
1084  FEC0              ;   NOTE: the bytes at $FEC3-$FECA ($C3 $45 $FB $2A $0D $9C $E9 $C9) immediately after
1085  FEC0              ;     this JP are NOT executed on the WRITE path; they are install/handler scratch -- see flags.
1086  FEC0              ; ----------------------------------------------------------------------
1087  FEC0              WRITE:
1088  FEC0                      ; off-image jump to the deblock/RWTS write core at $AC49 (system-image region, not BIOS)
1089  FEC0                      ; [RE]
1090  FEC0 C3 49 AC             JP $AC49
1091  FEC3 C3 45 FB 2A          DEFB    $C3,$45,$FB,$2A,$0D      ; "CE{*"
1091  FEC7 0D
1092  FEC8 9C E9 C9             DEFB    $9C,$E9,$C9
1093  FECB              COL_FLAG:
1094  FECB 00                   DEFB    "\0"
1095  FECC              COL_PENDING:
1096  FECC 00                   DEFB    "\0"
1097  FECD              COL_STATE:
1098  FECD 00                   DEFB    "\0"
1099  FECE              SCREEN_CURSOR_PTR:
1100  FECE D0 FE                DEFB    $D0,$FE
1101  FED0              SCREEN_CHAR:
1102  FED0 00                   DEFB    "\0"
1103  FED1              ; ----------------------------------------------------------------------
1104  FED1              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector entry 0; $FA00 -> here at $FED1).
1105  FED1              ;   In:  none. Out: does not return through here (falls into the install engine).
1106  FED1              ;   Clobbers: all.
1107  FED1              ;   DUAL USE of the operand bytes: this 'LD SP,$0100' executes ONCE at cold boot to set
1108  FED1              ;     the Z-80 stack; afterwards BOOT (the $00 operand byte) is reused as sektrk and
1109  FED1              ;     BOOT+1 as seksec (SETTRK stores BOOT at $FE78, SETSEC stores
1110  FED1              ;     BOOT+1 at $FBF5), and BOOT+2 ($FED3) is read as a console cursor word
1111  FED1              ;     ($FBD3 LD HL,(BOOT+2)). Valid SP-init bytes only during the single cold-boot
1112  FED1              ;     pass; thereafter disk/console scratch, never re-executed. Twin of 2.20 BOOT. [RE]
1113  FED1              ;   Algorithm: set SP, then fall through into the self-modifying install engine
1114  FED1              ;     (BOOT_TMPL_XORA..SECTOR_BLOCK_PATCH are template-instruction cells whose operands double as
1115  FED1              ;     disk-deblock state).
1116  FED1              ; ----------------------------------------------------------------------
1117  FED1              BOOT:
1118  FED1                      ; init Z-80 stack; BOOT/+1/+2 reused post-boot as sektrk/seksec and a console cursor word
1119  FED1 31 00 01             LD SP,$0100
1120  FED4              ; ----------------------------------------------------------------------
1121  FED4              ; BOOT_TMPL_XORA -- cold-boot install template 'XOR A'; operationally a disk-state cell.
1122  FED4              ;   Boot tenant: 'XOR A' clears A as the install engine starts the page-clear. Operational
1123  FED4              ;   tenant: this cell is referenced as a console/disk scratch base (LD HL,BOOT_TMPL_XORA at
1124  FED4              ;   $FBBA in the console path). Twin region of 2.20 DISK_SELDSK_SAVE. [RE]
1125  FED4              ; ----------------------------------------------------------------------
1126  FED4              BOOT_TMPL_XORA:
1127  FED4 AF                   XOR A
1128  FED5              ; ----------------------------------------------------------------------
1129  FED5              ; DISK_SEKDSK -- cold-boot install template 'LD HL,BIOS_VECTOR'; operationally the sekdsk cell.
1130  FED5              ;   Boot tenant: 'LD HL,nn' template the install engine steps over. Operational tenant:
1131  FED5              ;   SELDSK uses DE=DISK_SEKDSK as the sekdsk build site (selected disk number). Twin of
1132  FED5              ;   2.20 DISK_SEKDSK. [RE]
1133  FED5              ; ----------------------------------------------------------------------
1134  FED5              DISK_SEKDSK:
1135  FED5 21 00 FA             LD HL,BIOS_VECTOR
1136  FED8              ; ----------------------------------------------------------------------
1137  FED8              ; DISK_HSTACT -- cold-boot install template 'LD (HL),A'; operationally the hstact flag.
1138  FED8              ;   Boot tenant: part of the page-zero/template clear. Operational tenant: host-buffer-
1139  FED8              ;   active flag, cleared by HOME ($FE72) and by PAGEZERO_REBUILD ($FAE7), set when a host
1140  FED8              ;   sector is staged. Twin of 2.20 DISK_HSTWRT-area hstact. [RE]
1141  FED8              ; ----------------------------------------------------------------------
1142  FED8              DISK_HSTACT:
1143  FED8 77                   LD (HL),A
1144  FED9              ; ----------------------------------------------------------------------
1145  FED9              ; DISK_HSTWRT -- cold-boot install template 'INC HL'; operationally the hstwrt flag.
1146  FED9              ;   Boot tenant: 'INC HL' advances the install-clear pointer. Operational tenant: host-
1147  FED9              ;   buffer-dirty flag, read by HOME ($FE6C). Twin of 2.20 DISK_HSTWRT. [RE]
1148  FED9              ; ----------------------------------------------------------------------
1149  FED9              DISK_HSTWRT:
1150  FED9 23                   INC HL
1151  FEDA 77                   LD (HL),A
1152  FEDB 23                   INC HL
1153  FEDC 77                   LD (HL),A
1154  FEDD              ; ----------------------------------------------------------------------
1155  FEDD              ; BOOT_TMPL_IOBYTE -- cold-boot install template 'LD A,$95' (default IOBYTE immediate).
1156  FEDD              ;   Boot tenant: loads the default IOBYTE value $95 into A. Operational tenant: this cell
1157  FEDD              ;   is cleared by PAGEZERO_REBUILD ($FAE4) and used as a console-state byte. Twin of the
1158  FEDD              ;   2.20 DISK_HSTWRT 'LD A,$95' default-IOBYTE template. [RE]
1159  FEDD              ; ----------------------------------------------------------------------
1160  FEDD              BOOT_TMPL_IOBYTE:
1161  FEDD                      ; default CP/M IOBYTE immediate ($95) loaded at cold boot
1162  FEDD 3E 95                LD A,$95
1163  FEDF              ; ----------------------------------------------------------------------
1164  FEDF              ; DISK_DMAADR -- cold-boot install template 'LD ($0003),A' (store default IOBYTE);
1165  FEDF              ;     +2 operand reused as dmaadr.
1166  FEDF              ;   Boot tenant: stores the default IOBYTE into page-zero $0003 at cold boot. Operational
1167  FEDF              ;   tenant: SETDMA writes BC into DISK_DMAADR+2 ($FEE1) as the current DMA buffer address
1168  FEDF              ;   (SETDMA 'LD (DISK_DMAADR+2),BC'); the deblock record copy uses it. Twin of the 2.20
1169  FEDF              ;   DISK_WRTYPE/DISK_DMAADR overlay. [RE]
1170  FEDF              ; ----------------------------------------------------------------------
1171  FEDF              DISK_DMAADR:
1172  FEDF                      ; store the default IOBYTE into page-zero $0003; the operand cell (+2) doubles as dmaadr
1173  FEDF 32 03 00             LD ($0003),A
1174  FEE2              ; ----------------------------------------------------------------------
1175  FEE2              ; DISK_PARAM_TMPL -- cold-boot install template 'LD HL,($F3DE)'; SELDSK self-modifies +1.
1176  FEE2              ;   Boot tenant: 'LD HL,(nn)' loads a config word; the install engine continues at $FEE5.
1177  FEE2              ;   Operational tenant: SELDSK patches DISK_PARAM_TMPL+1 ($FEE3) with a per-drive disk-
1178  FEE2              ;   parameter byte. From $FEE5 the cold-boot INSTALL ENGINE proper runs (see body). Twin
1179  FEE2              ;   of 2.20 DISK_UNADSK template + the DEV_INSTALL flow. [RE]
1180  FEE2              ;   Algorithm (install engine from $FEE5): copy the RPC-trigger store address into
1181  FEE2              ;     RPC_TRIGGER_STORE+1; clear page-zero $0004; read the console card class from config
1182  FEE2              ;     $F3BB; for the device-6/Pascal-class console install the $FD99 status handler into
1183  FEE2              ;     the $F380 vector, else for the Videx/40-col classes self-modify the CONST handler
1184  FEE2              ;     (KBD_STATUS_40COL+1) so status reads come from the card; then install CONOUT/CONIN handler
1185  FEE2              ;     vectors via the handler lookups, print the sign-on banner, and enter the CCP.
1186  FEE2              ; ----------------------------------------------------------------------
1187  FEE2              SECTOR_BLOCK_PATCH:
1188  FEE2                      ; install template: load a config word (operand at +1 is self-modified by SELDSK with the
1189  FEE2                      ; disk param)
1190  FEE2 2A DE F3             LD HL,($F3DE)
1191  FEE5                      ; self-modify: write the SoftCard RPC-trigger store address into RPC_TRIGGER_STORE's LD
1192  FEE5                      ; (nn),A operand [RE]
1193  FEE5 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1194  FEE8 AF                   XOR A
1195  FEE9                      ; clear page-zero $0004 (current default drive)
1196  FEE9 32 04 00             LD ($0004),A
1197  FEEC                      ; read the configured console card class from the config block (Apple $03BB)
1198  FEEC 3A BB F3             LD A,($F3BB)
1199  FEEF                      ; card class 6 = device-6 / Pascal-firmware console (post-1980 path; absent in the 1980
1200  FEEF                      ; manual) [RE]
1201  FEEF FE 06                CP $06
1202  FEF1 20 0A                JR NZ,DEV_INSTALL_LIST
1203  FEF3                      ; device-6 console: install the $FD99 status handler
1204  FEF3 21 99 FD             LD HL,SET_SCREEN_BASE_1
1205  FEF6                      ; store it into the SoftCard console-status I/O vector cell (Apple $0380)
1206  FEF6 22 80 F3             LD ($F380),HL
1207  FEF9 D6 03                SUB $03
1208  FEFB 18 13                JR DEV_INSTALL_PUNCH
1209  FEFD              ; ----------------------------------------------------------------------
1210  FEFD              ; DEV_INSTALL_LIST -- install the LIST device-output handler from the config class. [RE]
1211  FEFD              ;   In:  install engine running. Out: patches the LIST output stub vector. Clobbers: A,HL.
1212  FEFD              ;   Algorithm: read the LIST card class (config $F3B9 = Apple $03B9), bias by 3; if a
1213  FEFD              ;     real device is configured, look up its handler (CALL HANDLER_LOOKUP) and store it
1214  FEFD              ;     into the LIST stub vector (DEV_OUT_1_JP+1). Twin of 2.20 DEV_INSTALL flow. [RE]
1215  FEFD              ; ----------------------------------------------------------------------
1216  FEFD              DEV_INSTALL_LIST:
1217  FEFD FE 05                CP $05
1218  FEFF 28 22                JR Z,DEV_INSTALL_READER
1219  FF01 D6 03                SUB $03
1220  FF03 38 1E                JR C,DEV_INSTALL_READER
1221  FF05 20 09                JR NZ,DEV_INSTALL_PUNCH
1222  FF07 21 15 FB             LD HL,KBD_STATUS_40COL+1
1223  FF0A 36 BE                LD (HL),$BE
1224  FF0C 23                   INC HL
1225  FF0D 23                   INC HL
1226  FF0E 36 1F                LD (HL),$1F
1227  FF10              ; ----------------------------------------------------------------------
1228  FF10              ; DEV_INSTALL_PUNCH -- install the PUNCH device-output handler from the config class. [RE]
1229  FF10              ;   Algorithm: read the PUNCH card class (config $F3BA = Apple $03BA), bias by 3; if
1230  FF10              ;     configured, look up the handler and store it into the PUNCH stub vector (DEV_OUT_2_JP+1); for
1231  FF10              ;     the higher class value also install a secondary handler into DEV_OUT_3_JP+1. Twin of 2.20
1232  FF10              ;     DEV_INSTALL flow. [RE]
1233  FF10              ; ----------------------------------------------------------------------
1234  FF10              DEV_INSTALL_PUNCH:
1235  FF10 F5                   PUSH AF
1236  FF11 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1237  FF14 F1                   POP AF
1238  FF15 22 B9 FC             LD (SCREEN_EMIT_3+1),HL
1239  FF18                      ; secondary handler lookup via the skip-idiom entry (HANDLER_LOOKUP_B); the FD cover byte at
1240  FF18                      ; DEV_HANDLER_LOOKUP_B is skipped [RE]
1241  FF18 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1242  FF1B 22 37 FB             LD (CONIN_DISPATCH+1),HL
1243  FF1E 3E 03                LD A,$03
1244  FF20 32 05 FB             LD (CCP_LAUNCH+1),A
1245  FF23              ; ----------------------------------------------------------------------
1246  FF23              ; DEV_INSTALL_READER -- build the default READER/list-output stub when none is configured.
1247  FF23              ;   Algorithm: when no real device class is configured, build the no-op stub at DEV_OUT_3_JP:
1248  FF23              ;     store $1A3E ('LD A,$1A' opcode+immediate) then $C9 ('RET') so the device returns a
1249  FF23              ;     constant. Twin of 2.20 DEV_INSTALL_4's DEV_OUT_3 build. [RE]
1250  FF23              ; ----------------------------------------------------------------------
1251  FF23              DEV_INSTALL_READER:
1252  FF23 3A B9 F3             LD A,($F3B9)
1253  FF26 D6 03                SUB $03
1254  FF28 38 06                JR C,INSTALL_DONE_DEVICES
1255  FF2A CD 84 FF             CALL DEV_HANDLER_LOOKUP
1256  FF2D 22 50 FE             LD (DEV_OUT_1_JP+1),HL
1257  FF30              ; ----------------------------------------------------------------------
1258  FF30              ; INSTALL_DONE_DEVICES -- run the device probe after the per-device installs. [RE]
1259  FF30              ;   Algorithm: CALL PROBE_DEVICES (PROBE_DEVICES) to scan the 7 SoftCard config slots and
1260  FF30              ;     mark/init each present card before the banner is printed. Twin of 2.20 DEV_INSTALL_6
1261  FF30              ;     PROBE_DEVICES call. [RE]
1262  FF30              ; ----------------------------------------------------------------------
1263  FF30              INSTALL_DONE_DEVICES:
1264  FF30 3A BA F3             LD A,($F3BA)
1265  FF33 D6 03                SUB $03
1266  FF35 38 14                JR C,SLOT_IO_SCALE_17
1267  FF37 F5                   PUSH AF
1268  FF38 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1269  FF3B 22 64 FE             LD (DEV_OUT_2_JP+1),HL
1270  FF3E F1                   POP AF
1271  FF3F FE 02                CP $02
1272  FF41 28 08                JR Z,SLOT_IO_SCALE_17
1273  FF43 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1274  FF46 22 6A FE             LD (DEV_OUT_3_JP+1),HL
1275  FF49 18 0B                JR SLOT_IO_SCALE_18
1276  FF4B              SLOT_IO_SCALE_17:
1277  FF4B 21 3E 1A             LD HL,$1A3E
1278  FF4E 22 69 FE             LD (DEV_OUT_3_JP),HL
1279  FF51 3E C9                LD A,$C9
1280  FF53 32 6B FE             LD (DEV_OUT_3_JP+2),A
1281  FF56              SLOT_IO_SCALE_18:
1282  FF56                      ; scan + init the 7 SoftCard config slots (device probe) before the sign-on
1283  FF56 CD 82 FA             CALL PROBE_DEVICES
1284  FF59              ; ----------------------------------------------------------------------
1285  FF59              ; SIGNON_PRINT -- emit the two config-derived sign-on prefix chars, then the banner. [RE]
1286  FF59              ;   In:  none. Out: prints the sign-on. Clobbers: A,HL.
1287  FF59              ;   Algorithm: read config $F398 (Apple $0398), pass it to the CONOUT writer (CONOUT_DISPATCH),
1288  FF59              ;     then walk SIGNON_BANNER (SIGNON_BANNER) char-by-char through CONOUT until the $00
1289  FF59              ;     terminator, then enter PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS). Twin of the 2.20
1290  FF59              ;     DEV_INSTALL_6/
1291  FF59              ;     DEV_INSTALL_7 banner loop (here it routes through CONOUT directly, not SIGNON_EMIT).
1292  FF59              ;     NOTE: WBOOT (WBOOT) also stashes SIGNON_PRINT into the $F3D0 RPC mailbox at
1293  FF59              ;     $FACE for a re-init path. [RE]
1294  FF59              ; ----------------------------------------------------------------------
1295  FF59              SIGNON_PRINT:
1296  FF59                      ; first config-derived sign-on char (Apple $0398)
1297  FF59 3A 98 F3             LD A,($F398)
1298  FF5C                      ; emit it via SIGNON_EMIT (prefixes a config char if bit7 set), routed through CONOUT
1299  FF5C CD 8F FF             CALL SIGNON_EMIT
1300  FF5F                      ; HL -> the cold-boot sign-on banner string
1301  FF5F 21 9E FF             LD HL,SIGNON_BANNER
1302  FF62              ; ----------------------------------------------------------------------
1303  FF62              ; SIGNON_BANNER_LOOP -- print SIGNON_BANNER char-by-char until the $00 terminator. [RE]
1304  FF62              ;   In:  HL -> banner. Out: jumps to PAGEZERO_REBUILD at the terminator. Clobbers: A,HL.
1305  FF62              ;   Algorithm: load (HL); if $00 jump to PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS) to finish cold
1306  FF62              ;     boot; else push HL, CALL CONOUT (CONOUT_DISPATCH), pop, INC HL, repeat. Twin of 2.20
1307  FF62              ;     DEV_INSTALL_7. [RE]
1308  FF62              ; ----------------------------------------------------------------------
1309  FF62              SIGNON_BANNER_LOOP:
1310  FF62 7E                   LD A,(HL)
1311  FF63 B7                   OR A
1312  FF64                      ; banner terminator -> PAGEZERO_REBUILD (write page-zero hooks, enter the CCP)
1313  FF64 CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1314  FF67 E5                   PUSH HL
1315  FF68                      ; emit one banner char via CONOUT
1316  FF68 CD 4C FB             CALL CONOUT_DISPATCH
1317  FF6B E1                   POP HL
1318  FF6C 23                   INC HL
1319  FF6D 18 F3                JR SIGNON_BANNER_LOOP
1320  FF6F              SLOT_IO_SCALE_21:
1321  FF6F 0E FD                LD C,$FD
1322  FF71 71                   LD (HL),C
1323  FF72 FD                   DEFB $FD  ; ignored IY prefix; inner: LD D,D
1324  FF73 52                   LD D,D
1325  FF74 FE A9                CP $A9
1326  FF76 FD                   DEFB $FD  ; ignored IY prefix; inner: LD B,D
1327  FF77              SLOT_IO_SCALE_22:
1328  FF77 42                   LD B,D
1329  FF78 FE C1                CP $C1
1330  FF7A FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1331  FF7B B7                   OR A
1332  FF7C FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1333  FF7D B7                   OR A
1334  FF7E              ; ----------------------------------------------------------------------
1335  FF7E              ; DEV_HANDLER_LOOKUP_B -- secondary-table handler lookup, entered at +1 via a skip idiom.
1336  FF7E              ;   In:  A = entry index. Out: HL = handler address from the secondary table. Clobbers: A,HL.
1337  FF7E              ;   SKIP IDIOM: the byte at DEV_HANDLER_LOOKUP_B ($FF7E) is an $FD cover (reads as 'LD IY,$FF77'
1338  FF7E              ;     when fallen into); every CALLER targets DEV_HANDLER_LOOKUP_B+1 ($FF7F) which executes
1339  FF7E              ;     'LD HL,SLOT_IO_SCALE_22' (the secondary DEV_HANDLER_PTRS_B base) then 'JR DEV_HANDLER_
1340  FF7E              ;     LOOKUP_IDX'. Twin of 2.20 DEV_HANDLER_LOOKUP_B (there a clean 'LD HL,..; JR'). [RE]
1341  FF7E              ;   -- see flags for the cover byte and the surrounding DEFB-as-code handler table.
1342  FF7E              ; ----------------------------------------------------------------------
1343  FF7E              DEV_HANDLER_LOOKUP_B:
1344  FF7E                      ; COVER: the FD prefix makes this 'LD IY,$FF77' on fall-in; callers enter at +1 => 'LD
1345  FF7E                      ;        HL,SLOT_IO_SCALE_22' (secondary table base) [RE]
1346  FF7E FD 21 77 FF          LD IY,SLOT_IO_SCALE_22
1347  FF82                      ; join the shared index tail (HL += A*2; load the word)
1348  FF82 18 03                JR DEV_HANDLER_LOOKUP_IDX
1349  FF84              ; ----------------------------------------------------------------------
1350  FF84              ; DEV_HANDLER_LOOKUP -- fetch a device-handler address from the primary pointer table.
1351  FF84              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1352  FF84              ;   Algorithm: HL = DEV_HANDLER_PTRS base (SLOT_IO_SCALE_21); fall into the shared scaler
1353  FF84              ;     (ADD A,A; ADD A,L; LD L,A) then load the 16-bit word at that slot (low then high).
1354  FF84              ;     The secondary-table entry is HANDLER_LOOKUP_B at DEV_HANDLER_LOOKUP_B+1 (skip idiom). Twin
1355  FF84              ;     of 2.20 DEV_HANDLER_LOOKUP. [RE]
1356  FF84              ; ----------------------------------------------------------------------
1357  FF84              DEV_HANDLER_LOOKUP:
1358  FF84                      ; select the primary device-handler pointer table
1359  FF84 21 6F FF             LD HL,SLOT_IO_SCALE_21
1360  FF87              ; ----------------------------------------------------------------------
1361  FF87              ; DEV_HANDLER_LOOKUP_IDX -- shared table-index tail: HL += A*2; HL = word at that slot.
1362  FF87              ;   In:  A = index, HL = table base. Out: HL = the 16-bit handler address. Clobbers: A,HL.
1363  FF87              ;   Twin of 2.20 DISK_RTN_LOOKUP_IDX. [RE]
1364  FF87              ; ----------------------------------------------------------------------
1365  FF87              DEV_HANDLER_LOOKUP_IDX:
1366  FF87                      ; index*2 for 16-bit (word) table entries
1367  FF87 87                   ADD A,A
1368  FF88 85                   ADD A,L
1369  FF89 6F                   LD L,A
1370  FF8A                      ; load handler address low byte
1371  FF8A 7E                   LD A,(HL)
1372  FF8B 2C                   INC L
1373  FF8C                      ; load handler address high byte -> HL = handler entry
1374  FF8C 66                   LD H,(HL)
1375  FF8D 6F                   LD L,A
1376  FF8E C9                   RET
1377  FF8F              ; ----------------------------------------------------------------------
1378  FF8F              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1379  FF8F              ;   In:  A = byte/flag. Out: prints via CONOUT (CONOUT_DISPATCH). Clobbers: A,HL.
1380  FF8F              ;   Algorithm: if A is positive (bit7 clear) emit it directly via CONOUT; if negative,
1381  FF8F              ;     first emit the prefix char from config $F397 (Apple $0397), then tail-jump to
1382  FF8F              ;     CONOUT to emit A. Twin of 2.20 SIGNON_EMIT. [RE]
1383  FF8F              ; ----------------------------------------------------------------------
1384  FF8F              SIGNON_EMIT:
1385  FF8F B7                   OR A
1386  FF90                      ; bit7 clear -> emit the char directly via CONOUT
1387  FF90 F2 9B FF             JP P,SIGNON_EMIT_CHAR
1388  FF93 F5                   PUSH AF
1389  FF94                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1390  FF94 3A 97 F3             LD A,($F397)
1391  FF97                      ; emit the prefix char via CONOUT
1392  FF97 CD 4C FB             CALL CONOUT_DISPATCH
1393  FF9A F1                   POP AF
1394  FF9B              ; ----------------------------------------------------------------------
1395  FF9B              ; SIGNON_EMIT_CHAR -- tail of SIGNON_EMIT: emit the original char via CONOUT. [RE]
1396  FF9B              ; ----------------------------------------------------------------------
1397  FF9B              SIGNON_EMIT_CHAR:
1398  FF9B                      ; tail-call CONOUT to emit the char
1399  FF9B C3 4C FB             JP CONOUT_DISPATCH
1400  FF9E              ; ----------------------------------------------------------------------
1401  FF9E              ; SIGNON_BANNER -- the cold-boot sign-on string, printed by SIGNON_BANNER_LOOP until $00.
1402  FF9E              ;   Reads (40-col uppercase / Videx mixed-case): CR/LF/LF/LF, '     Softcard CP/M', CR/LF,
1403  FF9E              ;   '     44K Ver. 2.23', CR/LF, '(c) 1980,1982 Microsoft', CR, LF/CR/LF, $00. DATA.
1404  FF9E              ;   NOTE: the 40-col Apple screen is uppercase-only so it renders 'SOFTCARD'; the Videx
1405  FF9E              ;   80-col card renders the mixed-case 'Softcard'. The trailing bytes from $FFE6 ($FA $E5
1406  FF9E              ;   ...) are NOT banner text -- they are an in-image copy of handler/lookup code; see flags.
1407  FF9E              ;   Twin of 2.20 SIGNON_BANNER (which reads 'Apple ][ CP/M' / '44K Ver. 2.20' /
1408  FF9E              ;   '(C) 1980 Microsoft'). [RE]
1409  FF9E              ; ----------------------------------------------------------------------
1410  FF9E              SIGNON_BANNER:
1411  FF9E 0D 0A 0A 0A          DEFB    "\r\n\n\n"
1412  FFA2 20 20 20 20          DEFB    "     Softcard CP/M"     ; string
1412  FFA6 20 53 6F 66
1412  FFAA 74 63 61 72
1412  FFAE 64 20 43 50
1412  FFB2 2F 4D
1413  FFB4 0D                   DEFB    $0D                      ; terminator
1414  FFB5 0A                   DEFB    "\n"
1415  FFB6 20 20 20 20          DEFB    "     44K Ver. 2.23"     ; string
1415  FFBA 20 34 34 4B
1415  FFBE 20 56 65 72
1415  FFC2 2E 20 32 2E
1415  FFC6 32 33
1416  FFC8 0D                   DEFB    $0D                      ; terminator
1417  FFC9 0A                   DEFB    "\n"
1418  FFCA 28 63 29 20          DEFB    "(c) 1980,1982 Microsoft" ; string
1418  FFCE 31 39 38 30
1418  FFD2 2C 31 39 38
1418  FFD6 32 20 4D 69
1418  FFDA 63 72 6F 73
1418  FFDE 6F 66 74
1419  FFE1 0D                   DEFB    $0D                      ; terminator
1420  FFE2 0A 0D 0A 00          DEFB    $0A,$0D,$0A,$00,$FA,$E5,$CD,$4C,$FB,$E1,$23,$18,$F3,$0E,$FD,$71
1420  FFE6 FA E5 CD 4C
1420  FFEA FB E1 23 18
1420  FFEE F3 0E FD 71
1421  FFF2 FD 52 FE A9          DEFB    $FD,$52,$FE,$A9,$FD,$42,$FE,$C1,$FD,$B7,$FD,$B7,$FD,$21
1421  FFF6 FD 42 FE C1
1421  FFFA FD B7 FD B7
1421  FFFE FD 21
1422  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1423  0000
1424  0000                  SAVEBIN "{out_bin}", $FA00, $0600
1425  0000                  IFNDEF CPM_LINK
1426  0000                  ; image size from bracketing labels; $FA00 = the ORG base (image wraps to $0000)
1427  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1428  0000                  ENDIF
1429  0000
1430  0000              ; ----------------------------------------------------------------------
1431  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEE4-$FFDB.
1432  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above. It runs once at cold
1433  0000              ;   start; only afterwards does the disk system reuse them as the buffers DPH_TABLE
1434  0000              ;   hands out. The two tenants are never live at the same time.
1435  0000              ;
1436  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1437  0000              ;   at the overlay base, then one label per field with its extent carried in the
1438  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1439  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1440  0000              ;   the image, and the ORG leaves the emitted output untouched.
1441  0000              ;
1442  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1443  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1444  0000              ;   cold boot has finished. The sizes are the DPB's own values, so they cannot drift
1445  0000              ;   from the DPB this BIOS publishes. Same shape and names as the 2.20-44K and
1446  0000              ;   2.23-60K twins; only the addresses and the drive count differ. [RE]
1447  0000              ; ----------------------------------------------------------------------
1448  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1449  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1450  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1451  0000              CSV_SIZE     EQU 12                   ; = CKS
1452  0000
1453  0000                      ORG $FEE4                     ; the one given: where the author placed the overlay
1454  FEE4              DIRBUF:                               ; shared directory buffer, one per system
1455  FEE4                      ORG DIRBUF + DIRBUF_SIZE
1456  FF64              ALV_VECTORS:                          ; per-drive allocation vectors ($FF64..)
1457  FF64                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1458  FFAC              CSV_VECTORS:                          ; per-drive checksum vectors ($FFAC..)
1459  FFAC                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1460  FFDC              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFDC)
1461  FFDC
1462  FFDC                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1463  FFDC                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1464  FFDC                  ASSERT ALV_VECTORS == $FF64
1465  FFDC                  ASSERT CSV_VECTORS == $FFAC
1466  FFDC                  ASSERT BIOS_SCRATCH_END == $FFDC
1467  FFDC
# file closed: CPM_BIOS.asm

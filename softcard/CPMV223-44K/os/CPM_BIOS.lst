 794  FDC1              ; SCREEN_RPC_HELPER -- read back a screen byte via the RPC: position, fire the RPC, fetch.
 795  FDC1              SCREEN_RPC_HELPER:
 796  FDC1 CD 83 FD             CALL SET_SCREEN_BASE                    ; compute the screen base for the current row
 797  FDC4 21 4D C8             LD HL,$C84D                      ; 6502 RPC parameter (Apple expansion-ROM addr)
 798  FDC7 CD 45 FB             CALL RPC_TRIGGER                 ; run the embedded 6502 service on the 6502
 799  FDCA 21 78 F6             LD HL,$F678                      ; HL = row buffer base (Apple $0678)
 800  FDCD 19                   ADD HL,DE
 801  FDCE 7E                   LD A,(HL)                        ; read back the character
 802  FDCF C9                   RET
 803  FDD0              ; RPC6502_SERVICE_223 -- the embedded 6502 RPC service ($FDD0-$FE41 = Apple $0DD0); its
 804  FDD0              ; own ca65 source CPM_RPC6502_223.s is sub-assembled and INCBIN'd here (the 2.20
 805  FDD0              ; CPM_RPC6502 pattern). It forms a slot-ROM pointer ($CFFF disables expansion ROM),
 806  FDD0              ; LDA ($F6),Y, and JMP ($00F6) dispatches into the selected slot-ROM/firmware routine.
 807  FDD0              RPC6502_SERVICE_223:
 808  FDD0              ;   >>> CPM_RPC6502_223.s -- verbatim listing of the INCBIN'd source (regen: inject_incbin_listing) >>>
 809  FDD0              ;
 810  FDD0              ; .org $0DD0
 811  FDD0              ;
 812  FDD0              ; L_0DD0:
 813  FDD0              ;         PHA                          ; $0DD0  48
 814  FDD0              ;         JSR SUB_0E1D                 ; $0DD1  20 1D 0E
 815  FDD0              ;         LDY #$0D                     ; $0DD4  A0 0D
 816  FDD0              ; L_0DD6:
 817  FDD0              ;         LDA ($F6),Y                  ; $0DD6  B1 F6
 818  FDD0              ;         STA $F6                      ; $0DD8  85 F6
 819  FDD0              ;         LDY $06F8                    ; $0DDA  AC F8 06
 820  FDD0              ;         PLA                          ; $0DDD  68
 821  FDD0              ;         JMP ($00F6)                ; $0DDE  6C F6 00
 822  FDD0              ; L_0DE1:
 823  FDD0              ;         PHA                          ; $0DE1  48
 824  FDD0              ;         LDA #$00                     ; $0DE2  A9 00
 825  FDD0              ;         JSR SUB_0DEF                 ; $0DE4  20 EF 0D
 826  FDD0              ;         JSR SUB_0E1D                 ; $0DE7  20 1D 0E
 827  FDD0              ;         LDY #$0F                     ; $0DEA  A0 0F
 828  FDD0              ;         JMP L_0DD6                   ; $0DEC  4C D6 0D
 829  FDD0              ; SUB_0DEF:
 830  FDD0              ;         STY $F5                      ; $0DEF  84 F5
 831  FDD0              ;         PHA                          ; $0DF1  48
 832  FDD0              ;         JSR SUB_0E14                 ; $0DF2  20 14 0E
 833  FDD0              ;         PLA                          ; $0DF5  68
 834  FDD0              ;         LDY $F5                      ; $0DF6  A4 F5
 835  FDD0              ;         BCC SUB_0DEF                 ; $0DF8  90 F5
 836  FDD0              ;         RTS                          ; $0DFA  60
 837  FDD0              ;         .byte   $00, $00, $00, $00, $00, $4C, $E9, $BB, $4C, $04, $BE, $A9, $01, $20, $EF, $0D ; $0DFB
 838  FDD0              ;         .byte   $20, $1D, $0E, $48, $A0, $0E, $4C, $D6, $0D      ; $0E0B
 839  FDD0              ; SUB_0E14:
 840  FDD0              ;         PHA                          ; $0E14  48
 841  FDD0              ;         JSR SUB_0E1D                 ; $0E15  20 1D 0E
 842  FDD0              ;         LDY #$10                     ; $0E18  A0 10
 843  FDD0              ;         JMP L_0DD6                   ; $0E1A  4C D6 0D
 844  FDD0              ; SUB_0E1D:
 845  FDD0              ;         TYA                          ; $0E1D  98
 846  FDD0              ;         ORA #$C0                     ; $0E1E  09 C0
 847  FDD0              ;         TAX                          ; $0E20  AA
 848  FDD0              ;         TYA                          ; $0E21  98
 849  FDD0              ;         ASL                          ; $0E22  0A
 850  FDD0              ;         ASL                          ; $0E23  0A
 851  FDD0              ;         ASL                          ; $0E24  0A
 852  FDD0              ;         ASL                          ; $0E25  0A
 853  FDD0              ;         TAY                          ; $0E26  A8
 854  FDD0              ;         STY $06F8                    ; $0E27  8C F8 06
 855  FDD0              ;         LDA #$00                     ; $0E2A  A9 00
 856  FDD0              ;         STA $F6                      ; $0E2C  85 F6
 857  FDD0              ;         STX $F7                      ; $0E2E  86 F7
 858  FDD0              ;         LDA $CFFF                    ; $0E30  AD FF CF
 859  FDD0              ;         LDA ($F6),Y                  ; $0E33  B1 F6
 860  FDD0              ;         RTS                          ; $0E35  60
 861  FDD0              ; SUB_0E1D_1:
 862  FDD0              ;         LDA $48                      ; $0E36  A5 48
 863  FDD0              ;         PHA                          ; $0E38  48
 864  FDD0              ;         LDA $45                      ; $0E39  A5 45
 865  FDD0              ;         LDX $46                      ; $0E3B  A6 46
 866  FDD0              ;         LDY $47                      ; $0E3D  A4 47
 867  FDD0              ;         PLP                          ; $0E3F  28
 868  FDD0              ;         CLI                          ; $0E40  58
 869  FDD0              ;         RTS                          ; $0E41  60
 870  FDD0              ;   <<< end listing <<<
 871  FDD0                      INCBIN "CPM_RPC6502_223.bin"     ; 114 bytes of 6502 (runs on the 6502 via the RPC)
 872  FE42              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 873  FE42              DEV_READ_BIT:
 874  FE42 CD 81 FE             CALL SLOT_IO_ADDR
 875  FE45              DEV_READ_WAIT:
 876  FE45 7E                   LD A,(HL)
 877  FE46 1F                   RRA                              ; ready bit -> carry
 878  FE47 30 FC                JR NC,DEV_READ_WAIT
 879  FE49 2C                   INC L
 880  FE4A 7E                   LD A,(HL)                        ; read the data byte
 881  FE4B C9                   RET
 882  FE4C              DEV_OUT_1:                               ; default I/O vector handler (LIST stub)
 883  FE4C 11 01 00             LD DE,$0001
 884  FE4F              DEV_OUT_1_JP:
 885  FE4F C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 886  FE52              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 887  FE52              DEV_WR_BIT:
 888  FE52 CD B1 FA             CALL DEVICE_IO_BASE
 889  FE55 2E C1                LD L,$C1
 890  FE57              DEV_WR_WAIT:
 891  FE57 7E                   LD A,(HL)
 892  FE58 17                   RLA                              ; ready bit -> carry
 893  FE59 38 FC                JR C,DEV_WR_WAIT
 894  FE5B CD 7C FE             CALL SLOT_IO_ADDR_W
 895  FE5E 71                   LD (HL),C
 896  FE5F              DEV_RET:
 897  FE5F C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 898  FE60              DEV_OUT_2:                               ; default I/O vector handler (PUNCH stub)
 899  FE60 11 02 00             LD DE,$0002
 900  FE63              DEV_OUT_2_JP:
 901  FE63 C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 902  FE66              DEV_OUT_3:                               ; default I/O vector handler (READER stub)
 903  FE66 11 02 00             LD DE,$0002
 904  FE69              DEV_OUT_3_JP:
 905  FE69 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 906  FE6C              ; ----------------------------------------------------------------------
 907  FE6C              ; HOME -- BIOS jump-vector entry 8 ($FA18): seek the selected drive to track 0. [RE]
 908  FE6C              ;   In:  none. Out: none. Clobbers: A,C.
 909  FE6C              ;   Algorithm: if the host buffer still holds a pending write (hstwrt nonzero) leave
 910  FE6C              ;     hstact set so the dirty buffer is not dropped; else clear hstact (host buffer
 911  FE6C              ;     inactive). Then fall through into SETTRK_STORE with track 0. Mirrors the 2.20
 912  FE6C              ;     twin HOME exactly; the actual head step happens later in the deblock path. [RE]
 913  FE6C              ; ----------------------------------------------------------------------
 914  FE6C              HOME:
 915  FE6C                      ; read hstwrt (host-write-pending flag; lives in the BOOT install-template cells)
 916  FE6C 3A D9 FE             LD A,(DISK_HSTWRT)
 917  FE6F B7                   OR A
 918  FE70                      ; pending write -> keep hstact set, skip the clear
 919  FE70 20 03                JR NZ,SETTRK_STORE
 920  FE72                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 921  FE72 32 D8 FE             LD (DISK_HSTACT),A
 922  FE75              ; ----------------------------------------------------------------------
 923  FE75              ; SETTRK_STORE -- HOME falls in here with track 0; common tail with SETTRK. [RE]
 924  FE75              ;   In:  (HOME path) forces C=0. Out: stores sektrk. Clobbers: A,C.
 925  FE75              ;   Algorithm: load C=0, then fall into SETTRK's store (the $FE77 vector body) which
 926  FE75              ;     writes the track into the BOOT 'LD SP' operand byte reused as sektrk. [RE]
 927  FE75              ; ----------------------------------------------------------------------
 928  FE75              SETTRK_STORE:
 929  FE75                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 930  FE75 0E 00                LD C,$00
 931  FE77                      ; SETTRK (vector entry 10, JP $FE77): track number from BDOS in C
 932  FE77 79                   LD A,C
 933  FE78                      ; store sektrk into BOOT's LD SP operand byte (BOOT cell reused post-boot as sektrk)
 934  FE78 32 D1 FE             LD (BOOT),A
 935  FE7B C9                   RET
 936  FE7C              ; ----------------------------------------------------------------------
 937  FE7C              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 938  FE7C              ;   In:  E = slot/drive index (0..15). Out: HL = $E080 + (E<<4). Clobbers: A,L.
 939  FE7C              ;   Algorithm: load the $C08x write/control-bank base (z80 $E080 = Apple $C080), then
 940  FE7C              ;     fall into the shared index scaler (SLOT_IO_SCALE, the ADD A,A x4 at $FE85).
 941  FE7C              ;     Twin of 2.20 SLOT_IO_ADDR_W. [RE]
 942  FE7C              ; ----------------------------------------------------------------------
 943  FE7C              SLOT_IO_ADDR_W:
 944  FE7C                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 945  FE7C 21 80 E0             LD HL,$E080
 946  FE7F 18 03                JR SLOT_IO_SCALE_E
 947  FE81              ; ----------------------------------------------------------------------
 948  FE81              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch base ($C08E bank).
 949  FE81              ;   In:  E = slot/drive index (0..15). Out: HL = $E08E + (E<<4). Clobbers: A,L.
 950  FE81              ;   Algorithm: load the $C08E base, fall into SLOT_IO_SCALE_E. z80 $E08E = Apple $C08E.
 951  FE81              ;     Twin of 2.20 SLOT_IO_ADDR. [RE]
 952  FE81              ; ----------------------------------------------------------------------
 953  FE81              SLOT_IO_ADDR:
 954  FE81                      ; z80 $E08E = Apple $C08E slot-I/O base
 955  FE81 21 8E E0             LD HL,$E08E
 956  FE84              ; ----------------------------------------------------------------------
 957  FE84              ; SLOT_IO_SCALE_E -- load the slot/drive index into A, then fall into SLOT_IO_SCALE.
 958  FE84              ;   In:  E = index. Out: continues into the scaler. Twin of 2.20 SLOT_IO_SCALE_E. [RE]
 959  FE84              ; ----------------------------------------------------------------------
 960  FE84              SLOT_IO_SCALE_E:
 961  FE84                      ; slot/drive index into A for the scaler
 962  FE84 7B                   LD A,E
 963  FE85              ; ----------------------------------------------------------------------
 964  FE85              ; SLOT_IO_SCALE -- shift the index in A left by 4 and add it to L (index a $C0n0..$C0nF
 965  FE85              ;     16-byte slot-I/O block, or a *16-stride table). [RE]
 966  FE85              ;   In:  A = index, L = base low byte. Out: L += A*16; A preserved. Clobbers: A,L.
 967  FE85              ;   Algorithm: ADD A,A four times (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET.
 968  FE85              ;     Shared by SLOT_IO_ADDR/_W and by SELDSK (DPH-table index) and the device probe.
 969  FE85              ;     Twin of 2.20 SLOT_IO_SCALE. [RE]
 970  FE85              ; ----------------------------------------------------------------------
 971  FE85              SLOT_IO_SCALE:
 972  FE85                      ; A *= 16 over the four ADD A,A (slot block is 16 bytes; DPH stride is 16)
 973  FE85 87                   ADD A,A
 974  FE86 87                   ADD A,A
 975  FE87 87                   ADD A,A
 976  FE88 87                   ADD A,A
 977  FE89 F5                   PUSH AF
 978  FE8A                      ; L = base + index*16
 979  FE8A 85                   ADD A,L
 980  FE8B 6F                   LD L,A
 981  FE8C F1                   POP AF
 982  FE8D C9                   RET
 983  FE8E              ; ----------------------------------------------------------------------
 984  FE8E              ; SELDSK -- BIOS jump-vector entry 9 ($FA1B): select the disk drive for subsequent I/O.
 985  FE8E              ;   In:  C = disk number (0-based). Out: HL = DPH address for drive C, or HL=0 if out
 986  FE8E              ;     of range. Clobbers: A,DE,HL.
 987  FE8E              ;   Algorithm: DE -> the sekdsk build site (DISK_SEKDSK, an install-template cell reused
 988  FE8E              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
 989  FE8E              ;     block (z80 $F3B8 = Apple $03B8); if C >= count return HL=0. Else record the disk
 990  FE8E              ;     number, index the DPH table at DPH_TABLE by C*16 (CALL SLOT_IO_SCALE), pull a per-drive
 991  FE8E              ;     disk-parameter byte and self-modify the install template SECTOR_BLOCK_PATCH+1 with it.
 992  FE8E              ;     Twin of 2.20 SELDSK. [RE]
 993  FE8E              ; ----------------------------------------------------------------------
 994  FE8E              SELDSK:
 995  FE8E                      ; DE -> sekdsk build site (install-template cell reused as disk-select scratch)
 996  FE8E 11 D5 FE             LD DE,DISK_SEKDSK
 997  FE91 21 04 00             LD HL,$0004
 998  FE94                      ; configured drive count from the SoftCard config block (Apple $03B8)
 999  FE94 3A B8 F3             LD A,($F3B8)
1000  FE97 3D                   DEC A
1001  FE98                      ; requested drive vs (count-1); carry => out of range
1002  FE98 B9                   CP C
1003  FE99                      ; out of range -> SELDSK_BAD_DRIVE (returns HL=0)
1004  FE99 38 1D                JR C,SELDSK_BAD_DRIVE
1005  FE9B 7E                   LD A,(HL)
1006  FE9C 12                   LD (DE),A
1007  FE9D 13                   INC DE
1008  FE9E 79                   LD A,C
1009  FE9F 12                   LD (DE),A
1010  FEA0                      ; HL = DPH table base ($FA33); CALL SLOT_IO_SCALE indexes it by C*16
1011  FEA0 21 33 FA             LD HL,DPH_TABLE
1012  FEA3 CD 85 FE             CALL SLOT_IO_SCALE
1013  FEA6 E5                   PUSH HL
1014  FEA7 11 0A 00             LD DE,$000A
1015  FEAA 19                   ADD HL,DE
1016  FEAB 5E                   LD E,(HL)
1017  FEAC 23                   INC HL
1018  FEAD 56                   LD D,(HL)
1019  FEAE 21 05 00             LD HL,$0005
1020  FEB1 19                   ADD HL,DE
1021  FEB2 7E                   LD A,(HL)
1022  FEB3                      ; self-modify: store the per-drive disk-parameter byte into the install template's LD
1023  FEB3                      ; HL,(nn) operand [RE]
1024  FEB3 32 E3 FE             LD (SECTOR_BLOCK_PATCH+1),A
1025  FEB6 E1                   POP HL
1026  FEB7 C9                   RET
1027  FEB8              ; ----------------------------------------------------------------------
1028  FEB8              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH). [RE]
1029  FEB8              ;   In:  DE -> sekdsk build site. Out: HL=0. Clobbers: A,L.
1030  FEB8              ;   Twin of 2.20 SELDSK_BAD_DRIVE. [RE]
1031  FEB8              ; ----------------------------------------------------------------------
1032  FEB8              SELDSK_BAD_DRIVE:
1033  FEB8 1A                   LD A,(DE)
1034  FEB9 77                   LD (HL),A
1035  FEBA                      ; HL=0 signals an invalid drive to the BDOS
1036  FEBA 2E 00                LD L,$00
1037  FEBC C9                   RET
1038  FEBD              ; ----------------------------------------------------------------------
1039  FEBD              ; READ -- BIOS jump-vector entry 13 ($FA27): read one 128-byte CP/M record.
1040  FEBD              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1041  FEBD              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS read core at $AC39, which sits
1042  FEBD              ;     in the system-image region BELOW the BIOS (not inside $FA00-$FFFF). FLAG: unlike
1043  FEBD              ;     the 2.20 twin, the 2.23 BIOS does NOT carry the deblock or the $03E0-IOB RWTS RPC
1044  FEBD              ;     in-image; READ/WRITE delegate to the $ACxx host-sector routines. [RE] -- see flags.
1045  FEBD              ; ----------------------------------------------------------------------
1046  FEBD              READ:
1047  FEBD                      ; off-image jump to the deblock/RWTS read core at $AC39 (system-image region, not BIOS) [RE]
1048  FEBD C3 39 AC             JP $AC39
1049  FEC0              ; ----------------------------------------------------------------------
1050  FEC0              ; WRITE -- BIOS jump-vector entry 14 ($FA2A): write one 128-byte CP/M record.
1051  FEC0              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1052  FEC0              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS write core at $AC49 (system-image
1053  FEC0              ;     region below the BIOS). Same off-image RWTS delegation as READ_RECORD. [RE]
1054  FEC0              ;   NOTE: the bytes at $FEC3-$FECA ($C3 $45 $FB $2A $0D $9C $E9 $C9) immediately after
1055  FEC0              ;     this JP are NOT executed on the WRITE path; they are install/handler scratch -- see flags.
1056  FEC0              ; ----------------------------------------------------------------------
1057  FEC0              WRITE:
1058  FEC0                      ; off-image jump to the deblock/RWTS write core at $AC49 (system-image region, not BIOS)
1059  FEC0                      ; [RE]
1060  FEC0 C3 49 AC             JP $AC49
1061  FEC3 C3 45 FB 2A          DEFB    $C3,$45,$FB,$2A,$0D      ; "CE{*"
1061  FEC7 0D
1062  FEC8 9C E9 C9             DEFB    $9C,$E9,$C9
1063  FECB              COL_FLAG:
1064  FECB 00                   DEFB    "\0"
1065  FECC              COL_PENDING:
1066  FECC 00                   DEFB    "\0"
1067  FECD              COL_STATE:
1068  FECD 00                   DEFB    "\0"
1069  FECE              SCREEN_CURSOR_PTR:
1070  FECE D0 FE                DEFB    $D0,$FE
1071  FED0              SCREEN_CHAR:
1072  FED0 00                   DEFB    "\0"
1073  FED1              ; ----------------------------------------------------------------------
1074  FED1              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector entry 0; $FA00 -> here at $FED1).
1075  FED1              ;   In:  none. Out: does not return through here (falls into the install engine).
1076  FED1              ;   Clobbers: all.
1077  FED1              ;   DUAL USE of the operand bytes: this 'LD SP,$0100' executes ONCE at cold boot to set
1078  FED1              ;     the Z-80 stack; afterwards BOOT (the $00 operand byte) is reused as sektrk and
1079  FED1              ;     BOOT+1 as seksec (SETTRK stores BOOT at $FE78, SETSEC stores
1080  FED1              ;     BOOT+1 at $FBF5), and BOOT+2 ($FED3) is read as a console cursor word
1081  FED1              ;     ($FBD3 LD HL,(BOOT+2)). Valid SP-init bytes only during the single cold-boot
1082  FED1              ;     pass; thereafter disk/console scratch, never re-executed. Twin of 2.20 BOOT. [RE]
1083  FED1              ;   Algorithm: set SP, then fall through into the self-modifying install engine
1084  FED1              ;     (BOOT_TMPL_XORA..SECTOR_BLOCK_PATCH are template-instruction cells whose operands double as
1085  FED1              ;     disk-deblock state).
1086  FED1              ; ----------------------------------------------------------------------
1087  FED1              BOOT:
1088  FED1                      ; init Z-80 stack; BOOT/+1/+2 reused post-boot as sektrk/seksec and a console cursor word
1089  FED1 31 00 01             LD SP,$0100
1090  FED4              ; ----------------------------------------------------------------------
1091  FED4              ; BOOT_TMPL_XORA -- cold-boot install template 'XOR A'; operationally a disk-state cell.
1092  FED4              ;   Boot tenant: 'XOR A' clears A as the install engine starts the page-clear. Operational
1093  FED4              ;   tenant: this cell is referenced as a console/disk scratch base (LD HL,BOOT_TMPL_XORA at
1094  FED4              ;   $FBBA in the console path). Twin region of 2.20 DISK_SELDSK_SAVE. [RE]
1095  FED4              ; ----------------------------------------------------------------------
1096  FED4              BOOT_TMPL_XORA:
1097  FED4 AF                   XOR A
1098  FED5              ; ----------------------------------------------------------------------
1099  FED5              ; DISK_SEKDSK -- cold-boot install template 'LD HL,BIOS_VECTOR'; operationally the sekdsk cell.
1100  FED5              ;   Boot tenant: 'LD HL,nn' template the install engine steps over. Operational tenant:
1101  FED5              ;   SELDSK uses DE=DISK_SEKDSK as the sekdsk build site (selected disk number). Twin of
1102  FED5              ;   2.20 DISK_SEKDSK. [RE]
1103  FED5              ; ----------------------------------------------------------------------
1104  FED5              DISK_SEKDSK:
1105  FED5 21 00 FA             LD HL,BIOS_VECTOR
1106  FED8              ; ----------------------------------------------------------------------
1107  FED8              ; DISK_HSTACT -- cold-boot install template 'LD (HL),A'; operationally the hstact flag.
1108  FED8              ;   Boot tenant: part of the page-zero/template clear. Operational tenant: host-buffer-
1109  FED8              ;   active flag, cleared by HOME ($FE72) and by PAGEZERO_REBUILD ($FAE7), set when a host
1110  FED8              ;   sector is staged. Twin of 2.20 DISK_HSTWRT-area hstact. [RE]
1111  FED8              ; ----------------------------------------------------------------------
1112  FED8              DISK_HSTACT:
1113  FED8 77                   LD (HL),A
1114  FED9              ; ----------------------------------------------------------------------
1115  FED9              ; DISK_HSTWRT -- cold-boot install template 'INC HL'; operationally the hstwrt flag.
1116  FED9              ;   Boot tenant: 'INC HL' advances the install-clear pointer. Operational tenant: host-
1117  FED9              ;   buffer-dirty flag, read by HOME ($FE6C). Twin of 2.20 DISK_HSTWRT. [RE]
1118  FED9              ; ----------------------------------------------------------------------
1119  FED9              DISK_HSTWRT:
1120  FED9 23                   INC HL
1121  FEDA 77                   LD (HL),A
1122  FEDB 23                   INC HL
1123  FEDC 77                   LD (HL),A
1124  FEDD              ; ----------------------------------------------------------------------
1125  FEDD              ; BOOT_TMPL_IOBYTE -- cold-boot install template 'LD A,$95' (default IOBYTE immediate).
1126  FEDD              ;   Boot tenant: loads the default IOBYTE value $95 into A. Operational tenant: this cell
1127  FEDD              ;   is cleared by PAGEZERO_REBUILD ($FAE4) and used as a console-state byte. Twin of the
1128  FEDD              ;   2.20 DISK_HSTWRT 'LD A,$95' default-IOBYTE template. [RE]
1129  FEDD              ; ----------------------------------------------------------------------
1130  FEDD              BOOT_TMPL_IOBYTE:
1131  FEDD                      ; default CP/M IOBYTE immediate ($95) loaded at cold boot
1132  FEDD 3E 95                LD A,$95
1133  FEDF              ; ----------------------------------------------------------------------
1134  FEDF              ; DISK_DMAADR -- cold-boot install template 'LD ($0003),A' (store default IOBYTE);
1135  FEDF              ;     +2 operand reused as dmaadr.
1136  FEDF              ;   Boot tenant: stores the default IOBYTE into page-zero $0003 at cold boot. Operational
1137  FEDF              ;   tenant: SETDMA writes BC into DISK_DMAADR+2 ($FEE1) as the current DMA buffer address
1138  FEDF              ;   (SETDMA 'LD (DISK_DMAADR+2),BC'); the deblock record copy uses it. Twin of the 2.20
1139  FEDF              ;   DISK_WRTYPE/DISK_DMAADR overlay. [RE]
1140  FEDF              ; ----------------------------------------------------------------------
1141  FEDF              DISK_DMAADR:
1142  FEDF                      ; store the default IOBYTE into page-zero $0003; the operand cell (+2) doubles as dmaadr
1143  FEDF 32 03 00             LD ($0003),A
1144  FEE2              ; ----------------------------------------------------------------------
1145  FEE2              ; DISK_PARAM_TMPL -- cold-boot install template 'LD HL,($F3DE)'; SELDSK self-modifies +1.
1146  FEE2              ;   Boot tenant: 'LD HL,(nn)' loads a config word; the install engine continues at $FEE5.
1147  FEE2              ;   Operational tenant: SELDSK patches DISK_PARAM_TMPL+1 ($FEE3) with a per-drive disk-
1148  FEE2              ;   parameter byte. From $FEE5 the cold-boot INSTALL ENGINE proper runs (see body). Twin
1149  FEE2              ;   of 2.20 DISK_UNADSK template + the DEV_INSTALL flow. [RE]
1150  FEE2              ;   Algorithm (install engine from $FEE5): copy the RPC-trigger store address into
1151  FEE2              ;     RPC_TRIGGER_STORE+1; clear page-zero $0004; read the console card class from config
1152  FEE2              ;     $F3BB; for the device-6/Pascal-class console install the $FD99 status handler into
1153  FEE2              ;     the $F380 vector, else for the Videx/40-col classes self-modify the CONST handler
1154  FEE2              ;     (KBD_STATUS_40COL+1) so status reads come from the card; then install CONOUT/CONIN handler
1155  FEE2              ;     vectors via the handler lookups, print the sign-on banner, and enter the CCP.
1156  FEE2              ; ----------------------------------------------------------------------
1157  FEE2              SECTOR_BLOCK_PATCH:
1158  FEE2                      ; install template: load a config word (operand at +1 is self-modified by SELDSK with the
1159  FEE2                      ; disk param)
1160  FEE2 2A DE F3             LD HL,($F3DE)
1161  FEE5                      ; self-modify: write the SoftCard RPC-trigger store address into RPC_TRIGGER_STORE's LD
1162  FEE5                      ; (nn),A operand [RE]
1163  FEE5 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1164  FEE8 AF                   XOR A
1165  FEE9                      ; clear page-zero $0004 (current default drive)
1166  FEE9 32 04 00             LD ($0004),A
1167  FEEC                      ; read the configured console card class from the config block (Apple $03BB)
1168  FEEC 3A BB F3             LD A,($F3BB)
1169  FEEF                      ; card class 6 = device-6 / Pascal-firmware console (post-1980 path; absent in the 1980
1170  FEEF                      ; manual) [RE]
1171  FEEF FE 06                CP $06
1172  FEF1 20 0A                JR NZ,DEV_INSTALL_LIST
1173  FEF3                      ; device-6 console: install the $FD99 status handler
1174  FEF3 21 99 FD             LD HL,SET_SCREEN_BASE_1
1175  FEF6                      ; store it into the SoftCard console-status I/O vector cell (Apple $0380)
1176  FEF6 22 80 F3             LD ($F380),HL
1177  FEF9 D6 03                SUB $03
1178  FEFB 18 13                JR DEV_INSTALL_PUNCH
1179  FEFD              ; ----------------------------------------------------------------------
1180  FEFD              ; DEV_INSTALL_LIST -- install the LIST device-output handler from the config class. [RE]
1181  FEFD              ;   In:  install engine running. Out: patches the LIST output stub vector. Clobbers: A,HL.
1182  FEFD              ;   Algorithm: read the LIST card class (config $F3B9 = Apple $03B9), bias by 3; if a
1183  FEFD              ;     real device is configured, look up its handler (CALL HANDLER_LOOKUP) and store it
1184  FEFD              ;     into the LIST stub vector (DEV_OUT_1_JP+1). Twin of 2.20 DEV_INSTALL flow. [RE]
1185  FEFD              ; ----------------------------------------------------------------------
1186  FEFD              DEV_INSTALL_LIST:
1187  FEFD FE 05                CP $05
1188  FEFF 28 22                JR Z,DEV_INSTALL_READER
1189  FF01 D6 03                SUB $03
1190  FF03 38 1E                JR C,DEV_INSTALL_READER
1191  FF05 20 09                JR NZ,DEV_INSTALL_PUNCH
1192  FF07 21 15 FB             LD HL,KBD_STATUS_40COL+1
1193  FF0A 36 BE                LD (HL),$BE
1194  FF0C 23                   INC HL
1195  FF0D 23                   INC HL
1196  FF0E 36 1F                LD (HL),$1F
1197  FF10              ; ----------------------------------------------------------------------
1198  FF10              ; DEV_INSTALL_PUNCH -- install the PUNCH device-output handler from the config class. [RE]
1199  FF10              ;   Algorithm: read the PUNCH card class (config $F3BA = Apple $03BA), bias by 3; if
1200  FF10              ;     configured, look up the handler and store it into the PUNCH stub vector (DEV_OUT_2_JP+1); for
1201  FF10              ;     the higher class value also install a secondary handler into DEV_OUT_3_JP+1. Twin of 2.20
1202  FF10              ;     DEV_INSTALL flow. [RE]
1203  FF10              ; ----------------------------------------------------------------------
1204  FF10              DEV_INSTALL_PUNCH:
1205  FF10 F5                   PUSH AF
1206  FF11 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1207  FF14 F1                   POP AF
1208  FF15 22 B9 FC             LD (SCREEN_EMIT_3+1),HL
1209  FF18                      ; secondary handler lookup via the skip-idiom entry (HANDLER_LOOKUP_B); the FD cover byte at
1210  FF18                      ; DEV_HANDLER_LOOKUP_B is skipped [RE]
1211  FF18 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1212  FF1B 22 37 FB             LD (CONIN_DISPATCH+1),HL
1213  FF1E 3E 03                LD A,$03
1214  FF20 32 05 FB             LD (CCP_LAUNCH+1),A
1215  FF23              ; ----------------------------------------------------------------------
1216  FF23              ; DEV_INSTALL_READER -- build the default READER/list-output stub when none is configured.
1217  FF23              ;   Algorithm: when no real device class is configured, build the no-op stub at DEV_OUT_3_JP:
1218  FF23              ;     store $1A3E ('LD A,$1A' opcode+immediate) then $C9 ('RET') so the device returns a
1219  FF23              ;     constant. Twin of 2.20 DEV_INSTALL_4's DEV_OUT_3 build. [RE]
1220  FF23              ; ----------------------------------------------------------------------
1221  FF23              DEV_INSTALL_READER:
1222  FF23 3A B9 F3             LD A,($F3B9)
1223  FF26 D6 03                SUB $03
1224  FF28 38 06                JR C,INSTALL_DONE_DEVICES
1225  FF2A CD 84 FF             CALL DEV_HANDLER_LOOKUP
1226  FF2D 22 50 FE             LD (DEV_OUT_1_JP+1),HL
1227  FF30              ; ----------------------------------------------------------------------
1228  FF30              ; INSTALL_DONE_DEVICES -- run the device probe after the per-device installs. [RE]
1229  FF30              ;   Algorithm: CALL PROBE_DEVICES (PROBE_DEVICES) to scan the 7 SoftCard config slots and
1230  FF30              ;     mark/init each present card before the banner is printed. Twin of 2.20 DEV_INSTALL_6
1231  FF30              ;     PROBE_DEVICES call. [RE]
1232  FF30              ; ----------------------------------------------------------------------
1233  FF30              INSTALL_DONE_DEVICES:
1234  FF30 3A BA F3             LD A,($F3BA)
1235  FF33 D6 03                SUB $03
1236  FF35 38 14                JR C,SLOT_IO_SCALE_17
1237  FF37 F5                   PUSH AF
1238  FF38 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1239  FF3B 22 64 FE             LD (DEV_OUT_2_JP+1),HL
1240  FF3E F1                   POP AF
1241  FF3F FE 02                CP $02
1242  FF41 28 08                JR Z,SLOT_IO_SCALE_17
1243  FF43 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1244  FF46 22 6A FE             LD (DEV_OUT_3_JP+1),HL
1245  FF49 18 0B                JR SLOT_IO_SCALE_18
1246  FF4B              SLOT_IO_SCALE_17:
1247  FF4B 21 3E 1A             LD HL,$1A3E
1248  FF4E 22 69 FE             LD (DEV_OUT_3_JP),HL
1249  FF51 3E C9                LD A,$C9
1250  FF53 32 6B FE             LD (DEV_OUT_3_JP+2),A
1251  FF56              SLOT_IO_SCALE_18:
1252  FF56                      ; scan + init the 7 SoftCard config slots (device probe) before the sign-on
1253  FF56 CD 82 FA             CALL PROBE_DEVICES
1254  FF59              ; ----------------------------------------------------------------------
1255  FF59              ; SIGNON_PRINT -- emit the two config-derived sign-on prefix chars, then the banner. [RE]
1256  FF59              ;   In:  none. Out: prints the sign-on. Clobbers: A,HL.
1257  FF59              ;   Algorithm: read config $F398 (Apple $0398), pass it to the CONOUT writer (CONOUT_DISPATCH),
1258  FF59              ;     then walk SIGNON_BANNER (SIGNON_BANNER) char-by-char through CONOUT until the $00
1259  FF59              ;     terminator, then enter PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS). Twin of the 2.20
1260  FF59              ;     DEV_INSTALL_6/
1261  FF59              ;     DEV_INSTALL_7 banner loop (here it routes through CONOUT directly, not SIGNON_EMIT).
1262  FF59              ;     NOTE: WBOOT (WBOOT) also stashes SIGNON_PRINT into the $F3D0 RPC mailbox at
1263  FF59              ;     $FACE for a re-init path. [RE]
1264  FF59              ; ----------------------------------------------------------------------
1265  FF59              SIGNON_PRINT:
1266  FF59                      ; first config-derived sign-on char (Apple $0398)
1267  FF59 3A 98 F3             LD A,($F398)
1268  FF5C                      ; emit it via SIGNON_EMIT (prefixes a config char if bit7 set), routed through CONOUT
1269  FF5C CD 8F FF             CALL SIGNON_EMIT
1270  FF5F                      ; HL -> the cold-boot sign-on banner string
1271  FF5F 21 9E FF             LD HL,SIGNON_BANNER
1272  FF62              ; ----------------------------------------------------------------------
1273  FF62              ; SIGNON_BANNER_LOOP -- print SIGNON_BANNER char-by-char until the $00 terminator. [RE]
1274  FF62              ;   In:  HL -> banner. Out: jumps to PAGEZERO_REBUILD at the terminator. Clobbers: A,HL.
1275  FF62              ;   Algorithm: load (HL); if $00 jump to PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS) to finish cold
1276  FF62              ;     boot; else push HL, CALL CONOUT (CONOUT_DISPATCH), pop, INC HL, repeat. Twin of 2.20
1277  FF62              ;     DEV_INSTALL_7. [RE]
1278  FF62              ; ----------------------------------------------------------------------
1279  FF62              SIGNON_BANNER_LOOP:
1280  FF62 7E                   LD A,(HL)
1281  FF63 B7                   OR A
1282  FF64                      ; banner terminator -> PAGEZERO_REBUILD (write page-zero hooks, enter the CCP)
1283  FF64 CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1284  FF67 E5                   PUSH HL
1285  FF68                      ; emit one banner char via CONOUT
1286  FF68 CD 4C FB             CALL CONOUT_DISPATCH
1287  FF6B E1                   POP HL
1288  FF6C 23                   INC HL
1289  FF6D 18 F3                JR SIGNON_BANNER_LOOP
1290  FF6F              SLOT_IO_SCALE_21:
1291  FF6F 0E FD                LD C,$FD
1292  FF71 71                   LD (HL),C
1293  FF72 FD                   DEFB $FD  ; ignored IY prefix; inner: LD D,D
1294  FF73 52                   LD D,D
1295  FF74 FE A9                CP $A9
1296  FF76 FD                   DEFB $FD  ; ignored IY prefix; inner: LD B,D
1297  FF77              SLOT_IO_SCALE_22:
1298  FF77 42                   LD B,D
1299  FF78 FE C1                CP $C1
1300  FF7A FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1301  FF7B B7                   OR A
1302  FF7C FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1303  FF7D B7                   OR A
1304  FF7E              ; ----------------------------------------------------------------------
1305  FF7E              ; DEV_HANDLER_LOOKUP_B -- secondary-table handler lookup, entered at +1 via a skip idiom.
1306  FF7E              ;   In:  A = entry index. Out: HL = handler address from the secondary table. Clobbers: A,HL.
1307  FF7E              ;   SKIP IDIOM: the byte at DEV_HANDLER_LOOKUP_B ($FF7E) is an $FD cover (reads as 'LD IY,$FF77'
1308  FF7E              ;     when fallen into); every CALLER targets DEV_HANDLER_LOOKUP_B+1 ($FF7F) which executes
1309  FF7E              ;     'LD HL,SLOT_IO_SCALE_22' (the secondary DEV_HANDLER_PTRS_B base) then 'JR DEV_HANDLER_
1310  FF7E              ;     LOOKUP_IDX'. Twin of 2.20 DEV_HANDLER_LOOKUP_B (there a clean 'LD HL,..; JR'). [RE]
1311  FF7E              ;   -- see flags for the cover byte and the surrounding DEFB-as-code handler table.
1312  FF7E              ; ----------------------------------------------------------------------
1313  FF7E              DEV_HANDLER_LOOKUP_B:
1314  FF7E                      ; COVER: the FD prefix makes this 'LD IY,$FF77' on fall-in; callers enter at +1 => 'LD
1315  FF7E                      ;        HL,SLOT_IO_SCALE_22' (secondary table base) [RE]
1316  FF7E FD 21 77 FF          LD IY,SLOT_IO_SCALE_22
1317  FF82                      ; join the shared index tail (HL += A*2; load the word)
1318  FF82 18 03                JR DEV_HANDLER_LOOKUP_IDX
1319  FF84              ; ----------------------------------------------------------------------
1320  FF84              ; DEV_HANDLER_LOOKUP -- fetch a device-handler address from the primary pointer table.
1321  FF84              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1322  FF84              ;   Algorithm: HL = DEV_HANDLER_PTRS base (SLOT_IO_SCALE_21); fall into the shared scaler
1323  FF84              ;     (ADD A,A; ADD A,L; LD L,A) then load the 16-bit word at that slot (low then high).
1324  FF84              ;     The secondary-table entry is HANDLER_LOOKUP_B at DEV_HANDLER_LOOKUP_B+1 (skip idiom). Twin
1325  FF84              ;     of 2.20 DEV_HANDLER_LOOKUP. [RE]
1326  FF84              ; ----------------------------------------------------------------------
1327  FF84              DEV_HANDLER_LOOKUP:
1328  FF84                      ; select the primary device-handler pointer table
1329  FF84 21 6F FF             LD HL,SLOT_IO_SCALE_21
1330  FF87              ; ----------------------------------------------------------------------
1331  FF87              ; DEV_HANDLER_LOOKUP_IDX -- shared table-index tail: HL += A*2; HL = word at that slot.
1332  FF87              ;   In:  A = index, HL = table base. Out: HL = the 16-bit handler address. Clobbers: A,HL.
1333  FF87              ;   Twin of 2.20 DISK_RTN_LOOKUP_IDX. [RE]
1334  FF87              ; ----------------------------------------------------------------------
1335  FF87              DEV_HANDLER_LOOKUP_IDX:
1336  FF87                      ; index*2 for 16-bit (word) table entries
1337  FF87 87                   ADD A,A
1338  FF88 85                   ADD A,L
1339  FF89 6F                   LD L,A
1340  FF8A                      ; load handler address low byte
1341  FF8A 7E                   LD A,(HL)
1342  FF8B 2C                   INC L
1343  FF8C                      ; load handler address high byte -> HL = handler entry
1344  FF8C 66                   LD H,(HL)
1345  FF8D 6F                   LD L,A
1346  FF8E C9                   RET
1347  FF8F              ; ----------------------------------------------------------------------
1348  FF8F              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1349  FF8F              ;   In:  A = byte/flag. Out: prints via CONOUT (CONOUT_DISPATCH). Clobbers: A,HL.
1350  FF8F              ;   Algorithm: if A is positive (bit7 clear) emit it directly via CONOUT; if negative,
1351  FF8F              ;     first emit the prefix char from config $F397 (Apple $0397), then tail-jump to
1352  FF8F              ;     CONOUT to emit A. Twin of 2.20 SIGNON_EMIT. [RE]
1353  FF8F              ; ----------------------------------------------------------------------
1354  FF8F              SIGNON_EMIT:
1355  FF8F B7                   OR A
1356  FF90                      ; bit7 clear -> emit the char directly via CONOUT
1357  FF90 F2 9B FF             JP P,SIGNON_EMIT_CHAR
1358  FF93 F5                   PUSH AF
1359  FF94                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1360  FF94 3A 97 F3             LD A,($F397)
1361  FF97                      ; emit the prefix char via CONOUT
1362  FF97 CD 4C FB             CALL CONOUT_DISPATCH
1363  FF9A F1                   POP AF
1364  FF9B              ; ----------------------------------------------------------------------
1365  FF9B              ; SIGNON_EMIT_CHAR -- tail of SIGNON_EMIT: emit the original char via CONOUT. [RE]
1366  FF9B              ; ----------------------------------------------------------------------
1367  FF9B              SIGNON_EMIT_CHAR:
1368  FF9B                      ; tail-call CONOUT to emit the char
1369  FF9B C3 4C FB             JP CONOUT_DISPATCH
1370  FF9E              ; ----------------------------------------------------------------------
1371  FF9E              ; SIGNON_BANNER -- the cold-boot sign-on string, printed by SIGNON_BANNER_LOOP until $00.
1372  FF9E              ;   Reads (40-col uppercase / Videx mixed-case): CR/LF/LF/LF, '     Softcard CP/M', CR/LF,
1373  FF9E              ;   '     44K Ver. 2.23', CR/LF, '(c) 1980,1982 Microsoft', CR, LF/CR/LF, $00. DATA.
1374  FF9E              ;   NOTE: the 40-col Apple screen is uppercase-only so it renders 'SOFTCARD'; the Videx
1375  FF9E              ;   80-col card renders the mixed-case 'Softcard'. The trailing bytes from $FFE6 ($FA $E5
1376  FF9E              ;   ...) are NOT banner text -- they are an in-image copy of handler/lookup code; see flags.
1377  FF9E              ;   Twin of 2.20 SIGNON_BANNER (which reads 'Apple ][ CP/M' / '44K Ver. 2.20' /
1378  FF9E              ;   '(C) 1980 Microsoft'). [RE]
1379  FF9E              ; ----------------------------------------------------------------------
1380  FF9E              SIGNON_BANNER:
1381  FF9E 0D 0A 0A 0A          DEFB    "\r\n\n\n"
1382  FFA2 20 20 20 20          DEFB    "     Softcard CP/M"     ; string
1382  FFA6 20 53 6F 66
1382  FFAA 74 63 61 72
1382  FFAE 64 20 43 50
1382  FFB2 2F 4D
1383  FFB4 0D                   DEFB    $0D                      ; terminator
1384  FFB5 0A                   DEFB    "\n"
1385  FFB6 20 20 20 20          DEFB    "     44K Ver. 2.23"     ; string
1385  FFBA 20 34 34 4B
1385  FFBE 20 56 65 72
1385  FFC2 2E 20 32 2E
1385  FFC6 32 33
1386  FFC8 0D                   DEFB    $0D                      ; terminator
1387  FFC9 0A                   DEFB    "\n"
1388  FFCA 28 63 29 20          DEFB    "(c) 1980,1982 Microsoft" ; string
1388  FFCE 31 39 38 30
1388  FFD2 2C 31 39 38
1388  FFD6 32 20 4D 69
1388  FFDA 63 72 6F 73
1388  FFDE 6F 66 74
1389  FFE1 0D                   DEFB    $0D                      ; terminator
1390  FFE2 0A 0D 0A 00          DEFB    $0A,$0D,$0A,$00,$FA,$E5,$CD,$4C,$FB,$E1,$23,$18,$F3,$0E,$FD,$71
1390  FFE6 FA E5 CD 4C
1390  FFEA FB E1 23 18
1390  FFEE F3 0E FD 71
1391  FFF2 FD 52 FE A9          DEFB    $FD,$52,$FE,$A9,$FD,$42,$FE,$C1,$FD,$B7,$FD,$B7,$FD,$21
1391  FFF6 FD 42 FE C1
1391  FFFA FD B7 FD B7
1391  FFFE FD 21
1392  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1393  0000
1394  0000                  SAVEBIN "{out_bin}", $FA00, $0600
1395  0000                  IFNDEF CPM_LINK
1396  0000                  ; image size from bracketing labels; $FA00 = the ORG base (image wraps to $0000)
1397  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1398  0000                  ENDIF
1399  0000
1400  0000              ; ----------------------------------------------------------------------
1401  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEE4-$FFDB.
1402  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above. It runs once at cold
1403  0000              ;   start; only afterwards does the disk system reuse them as the buffers DPH_TABLE
1404  0000              ;   hands out. The two tenants are never live at the same time.
1405  0000              ;
1406  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1407  0000              ;   at the overlay base, then one label per field with its extent carried in the
1408  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1409  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1410  0000              ;   the image, and the ORG leaves the emitted output untouched.
1411  0000              ;
1412  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1413  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1414  0000              ;   cold boot has finished. The sizes are the DPB's own values, so they cannot drift
1415  0000              ;   from the DPB this BIOS publishes. Same shape and names as the 2.20-44K and
1416  0000              ;   2.23-60K twins; only the addresses and the drive count differ. [RE]
1417  0000              ; ----------------------------------------------------------------------
1418  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1419  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1420  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1421  0000              CSV_SIZE     EQU 12                   ; = CKS
1422  0000
1423  0000                      ORG $FEE4                     ; the one given: where the author placed the overlay
1424  FEE4              DIRBUF:                               ; shared directory buffer, one per system
1425  FEE4                      ORG DIRBUF + DIRBUF_SIZE
1426  FF64              ALV_VECTORS:                          ; per-drive allocation vectors ($FF64..)
1427  FF64                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1428  FFAC              CSV_VECTORS:                          ; per-drive checksum vectors ($FFAC..)
1429  FFAC                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1430  FFDC              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFDC)
1431  FFDC
1432  FFDC                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1433  FFDC                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1434  FFDC                  ASSERT ALV_VECTORS == $FF64
1435  FFDC                  ASSERT CSV_VECTORS == $FFAC
1436  FFDC                  ASSERT BIOS_SCRATCH_END == $FFDC
1437  FFDC
# file closed: CPM_BIOS.asm

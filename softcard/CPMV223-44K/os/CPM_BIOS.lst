 925  FDD0                      INCBIN "CPM_RPC6502_223.bin"     ; 114 bytes of 6502 (runs on the 6502 via the RPC)
 926  FE42              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 927  FE42              DEV_READ_BIT:
 928  FE42 CD 81 FE             CALL SLOT_IO_ADDR
 929  FE45              DEV_READ_WAIT:
 930  FE45 7E                   LD A,(HL)
 931  FE46 1F                   RRA                              ; ready bit -> carry
 932  FE47 30 FC                JR NC,DEV_READ_WAIT
 933  FE49 2C                   INC L
 934  FE4A 7E                   LD A,(HL)                        ; read the data byte
 935  FE4B C9                   RET
 936  FE4C              DEV_OUT_1:                               ; default I/O vector handler (LIST stub)
 937  FE4C 11 01 00             LD DE,$0001
 938  FE4F              DEV_OUT_1_JP:
 939  FE4F C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 940  FE52              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 941  FE52              DEV_WR_BIT:
 942  FE52 CD B1 FA             CALL DEVICE_IO_BASE
 943  FE55 2E C1                LD L,$C1
 944  FE57              DEV_WR_WAIT:
 945  FE57 7E                   LD A,(HL)
 946  FE58 17                   RLA                              ; ready bit -> carry
 947  FE59 38 FC                JR C,DEV_WR_WAIT
 948  FE5B CD 7C FE             CALL SLOT_IO_ADDR_W
 949  FE5E 71                   LD (HL),C
 950  FE5F              DEV_RET:
 951  FE5F C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 952  FE60              DEV_OUT_2:                               ; default I/O vector handler (PUNCH stub)
 953  FE60 11 02 00             LD DE,$0002
 954  FE63              DEV_OUT_2_JP:
 955  FE63 C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 956  FE66              DEV_OUT_3:                               ; default I/O vector handler (READER stub)
 957  FE66 11 02 00             LD DE,$0002
 958  FE69              DEV_OUT_3_JP:
 959  FE69 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 960  FE6C              ; ----------------------------------------------------------------------
 961  FE6C              ; HOME -- BIOS jump-vector entry 8 ($FA18): seek the selected drive to track 0. [RE]
 962  FE6C              ;   In:  none. Out: none. Clobbers: A,C.
 963  FE6C              ;   Algorithm: if the host buffer still holds a pending write (hstwrt nonzero) leave
 964  FE6C              ;     hstact set so the dirty buffer is not dropped; else clear hstact (host buffer
 965  FE6C              ;     inactive). Then fall through into SETTRK_STORE with track 0. Mirrors the 2.20
 966  FE6C              ;     twin HOME exactly; the actual head step happens later in the deblock path. [RE]
 967  FE6C              ; ----------------------------------------------------------------------
 968  FE6C              HOME:
 969  FE6C                      ; read hstwrt (host-write-pending flag; lives in the BOOT install-template cells)
 970  FE6C 3A D9 FE             LD A,(DISK_HSTWRT)
 971  FE6F B7                   OR A
 972  FE70                      ; pending write -> keep hstact set, skip the clear
 973  FE70 20 03                JR NZ,SETTRK_STORE
 974  FE72                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 975  FE72 32 D8 FE             LD (DISK_HSTACT),A
 976  FE75              ; ----------------------------------------------------------------------
 977  FE75              ; SETTRK_STORE -- HOME falls in here with track 0; common tail with SETTRK. [RE]
 978  FE75              ;   In:  (HOME path) forces C=0. Out: stores sektrk. Clobbers: A,C.
 979  FE75              ;   Algorithm: load C=0, then fall into SETTRK's store (the $FE77 vector body) which
 980  FE75              ;     writes the track into the BOOT 'LD SP' operand byte reused as sektrk. [RE]
 981  FE75              ; ----------------------------------------------------------------------
 982  FE75              SETTRK_STORE:
 983  FE75                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 984  FE75 0E 00                LD C,$00
 985  FE77                      ; SETTRK (vector entry 10, JP $FE77): track number from BDOS in C
 986  FE77 79                   LD A,C
 987  FE78                      ; store sektrk into BOOT's LD SP operand byte (BOOT cell reused post-boot as sektrk)
 988  FE78 32 D1 FE             LD (BOOT),A
 989  FE7B C9                   RET
 990  FE7C              ; ----------------------------------------------------------------------
 991  FE7C              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 992  FE7C              ;   In:  E = slot/drive index (0..15). Out: HL = $E080 + (E<<4). Clobbers: A,L.
 993  FE7C              ;   Algorithm: load the $C08x write/control-bank base (z80 $E080 = Apple $C080), then
 994  FE7C              ;     fall into the shared index scaler (SLOT_IO_SCALE, the ADD A,A x4 at $FE85).
 995  FE7C              ;     Twin of 2.20 SLOT_IO_ADDR_W. [RE]
 996  FE7C              ; ----------------------------------------------------------------------
 997  FE7C              SLOT_IO_ADDR_W:
 998  FE7C                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 999  FE7C 21 80 E0             LD HL,$E080
1000  FE7F 18 03                JR SLOT_IO_SCALE_E
1001  FE81              ; ----------------------------------------------------------------------
1002  FE81              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch base ($C08E bank).
1003  FE81              ;   In:  E = slot/drive index (0..15). Out: HL = $E08E + (E<<4). Clobbers: A,L.
1004  FE81              ;   Algorithm: load the $C08E base, fall into SLOT_IO_SCALE_E. z80 $E08E = Apple $C08E.
1005  FE81              ;     Twin of 2.20 SLOT_IO_ADDR. [RE]
1006  FE81              ; ----------------------------------------------------------------------
1007  FE81              SLOT_IO_ADDR:
1008  FE81                      ; z80 $E08E = Apple $C08E slot-I/O base
1009  FE81 21 8E E0             LD HL,$E08E
1010  FE84              ; ----------------------------------------------------------------------
1011  FE84              ; SLOT_IO_SCALE_E -- load the slot/drive index into A, then fall into SLOT_IO_SCALE.
1012  FE84              ;   In:  E = index. Out: continues into the scaler. Twin of 2.20 SLOT_IO_SCALE_E. [RE]
1013  FE84              ; ----------------------------------------------------------------------
1014  FE84              SLOT_IO_SCALE_E:
1015  FE84                      ; slot/drive index into A for the scaler
1016  FE84 7B                   LD A,E
1017  FE85              ; ----------------------------------------------------------------------
1018  FE85              ; SLOT_IO_SCALE -- shift the index in A left by 4 and add it to L (index a $C0n0..$C0nF
1019  FE85              ;     16-byte slot-I/O block, or a *16-stride table). [RE]
1020  FE85              ;   In:  A = index, L = base low byte. Out: L += A*16; A preserved. Clobbers: A,L.
1021  FE85              ;   Algorithm: ADD A,A four times (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET.
1022  FE85              ;     Shared by SLOT_IO_ADDR/_W and by SELDSK (DPH-table index) and the device probe.
1023  FE85              ;     Twin of 2.20 SLOT_IO_SCALE. [RE]
1024  FE85              ; ----------------------------------------------------------------------
1025  FE85              SLOT_IO_SCALE:
1026  FE85                      ; A *= 16 over the four ADD A,A (slot block is 16 bytes; DPH stride is 16)
1027  FE85 87                   ADD A,A
1028  FE86 87                   ADD A,A
1029  FE87 87                   ADD A,A
1030  FE88 87                   ADD A,A
1031  FE89 F5                   PUSH AF
1032  FE8A                      ; L = base + index*16
1033  FE8A 85                   ADD A,L
1034  FE8B 6F                   LD L,A
1035  FE8C F1                   POP AF
1036  FE8D C9                   RET
1037  FE8E              ; ----------------------------------------------------------------------
1038  FE8E              ; SELDSK -- BIOS jump-vector entry 9 ($FA1B): select the disk drive for subsequent I/O.
1039  FE8E              ;   In:  C = disk number (0-based). Out: HL = DPH address for drive C, or HL=0 if out
1040  FE8E              ;     of range. Clobbers: A,DE,HL.
1041  FE8E              ;   Algorithm: DE -> the sekdsk build site (DISK_SEKDSK, an install-template cell reused
1042  FE8E              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
1043  FE8E              ;     block (z80 $F3B8 = Apple $03B8); if C >= count return HL=0. Else record the disk
1044  FE8E              ;     number, index the DPH table at DPH_TABLE by C*16 (CALL SLOT_IO_SCALE), pull a per-drive
1045  FE8E              ;     disk-parameter byte and self-modify the install template SECTOR_BLOCK_PATCH+1 with it.
1046  FE8E              ;     Twin of 2.20 SELDSK. [RE]
1047  FE8E              ; ----------------------------------------------------------------------
1048  FE8E              SELDSK:
1049  FE8E                      ; DE -> sekdsk build site (install-template cell reused as disk-select scratch)
1050  FE8E 11 D5 FE             LD DE,DISK_SEKDSK
1051  FE91 21 04 00             LD HL,$0004
1052  FE94                      ; configured drive count from the SoftCard config block (Apple $03B8)
1053  FE94 3A B8 F3             LD A,($F3B8)
1054  FE97 3D                   DEC A
1055  FE98                      ; requested drive vs (count-1); carry => out of range
1056  FE98 B9                   CP C
1057  FE99                      ; out of range -> SELDSK_BAD_DRIVE (returns HL=0)
1058  FE99 38 1D                JR C,SELDSK_BAD_DRIVE
1059  FE9B 7E                   LD A,(HL)
1060  FE9C 12                   LD (DE),A
1061  FE9D 13                   INC DE
1062  FE9E 79                   LD A,C
1063  FE9F 12                   LD (DE),A
1064  FEA0                      ; HL = DPH table base ($FA33); CALL SLOT_IO_SCALE indexes it by C*16
1065  FEA0 21 33 FA             LD HL,DPH_TABLE
1066  FEA3 CD 85 FE             CALL SLOT_IO_SCALE
1067  FEA6 E5                   PUSH HL
1068  FEA7 11 0A 00             LD DE,$000A
1069  FEAA 19                   ADD HL,DE
1070  FEAB 5E                   LD E,(HL)
1071  FEAC 23                   INC HL
1072  FEAD 56                   LD D,(HL)
1073  FEAE 21 05 00             LD HL,$0005
1074  FEB1 19                   ADD HL,DE
1075  FEB2 7E                   LD A,(HL)
1076  FEB3                      ; self-modify: store the per-drive disk-parameter byte into the install template's LD
1077  FEB3                      ; HL,(nn) operand [RE]
1078  FEB3 32 E3 FE             LD (SECTOR_BLOCK_PATCH+1),A
1079  FEB6 E1                   POP HL
1080  FEB7 C9                   RET
1081  FEB8              ; ----------------------------------------------------------------------
1082  FEB8              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH). [RE]
1083  FEB8              ;   In:  DE -> sekdsk build site. Out: HL=0. Clobbers: A,L.
1084  FEB8              ;   Twin of 2.20 SELDSK_BAD_DRIVE. [RE]
1085  FEB8              ; ----------------------------------------------------------------------
1086  FEB8              SELDSK_BAD_DRIVE:
1087  FEB8 1A                   LD A,(DE)
1088  FEB9 77                   LD (HL),A
1089  FEBA                      ; HL=0 signals an invalid drive to the BDOS
1090  FEBA 2E 00                LD L,$00
1091  FEBC C9                   RET
1092  FEBD              ; ----------------------------------------------------------------------
1093  FEBD              ; READ -- BIOS jump-vector entry 13 ($FA27): read one 128-byte CP/M record.
1094  FEBD              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1095  FEBD              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS read core at $AC39, which sits
1096  FEBD              ;     in the system-image region BELOW the BIOS (not inside $FA00-$FFFF). FLAG: unlike
1097  FEBD              ;     the 2.20 twin, the 2.23 BIOS does NOT carry the deblock or the $03E0-IOB RWTS RPC
1098  FEBD              ;     in-image; READ/WRITE delegate to the $ACxx host-sector routines. [RE] -- see flags.
1099  FEBD              ; ----------------------------------------------------------------------
1100  FEBD              READ:
1101  FEBD                      ; off-image jump to the deblock/RWTS read core at $AC39 (system-image region, not BIOS) [RE]
1102  FEBD C3 39 AC             JP $AC39
1103  FEC0              ; ----------------------------------------------------------------------
1104  FEC0              ; WRITE -- BIOS jump-vector entry 14 ($FA2A): write one 128-byte CP/M record.
1105  FEC0              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1106  FEC0              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS write core at $AC49 (system-image
1107  FEC0              ;     region below the BIOS). Same off-image RWTS delegation as READ_RECORD. [RE]
1108  FEC0              ;   NOTE: the bytes at $FEC3-$FECA ($C3 $45 $FB $2A $0D $9C $E9 $C9) immediately after
1109  FEC0              ;     this JP are NOT executed on the WRITE path; they are install/handler scratch -- see flags.
1110  FEC0              ; ----------------------------------------------------------------------
1111  FEC0              WRITE:
1112  FEC0                      ; off-image jump to the deblock/RWTS write core at $AC49 (system-image region, not BIOS)
1113  FEC0                      ; [RE]
1114  FEC0 C3 49 AC             JP $AC49
1115  FEC3 C3 45 FB 2A          DEFB    $C3,$45,$FB,$2A,$0D      ; "CE{*"
1115  FEC7 0D
1116  FEC8 9C E9 C9             DEFB    $9C,$E9,$C9
1117  FECB              COL_FLAG:
1118  FECB 00                   DEFB    "\0"
1119  FECC              COL_PENDING:
1120  FECC 00                   DEFB    "\0"
1121  FECD              COL_STATE:
1122  FECD 00                   DEFB    "\0"
1123  FECE              SCREEN_CURSOR_PTR:
1124  FECE D0 FE                DEFB    $D0,$FE
1125  FED0              SCREEN_CHAR:
1126  FED0 00                   DEFB    "\0"
1127  FED1              ; ----------------------------------------------------------------------
1128  FED1              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector entry 0; $FA00 -> here at $FED1).
1129  FED1              ;   In:  none. Out: does not return through here (falls into the install engine).
1130  FED1              ;   Clobbers: all.
1131  FED1              ;   DUAL USE of the operand bytes: this 'LD SP,$0100' executes ONCE at cold boot to set
1132  FED1              ;     the Z-80 stack; afterwards BOOT (the $00 operand byte) is reused as sektrk and
1133  FED1              ;     BOOT+1 as seksec (SETTRK stores BOOT at $FE78, SETSEC stores
1134  FED1              ;     BOOT+1 at $FBF5), and BOOT+2 ($FED3) is read as a console cursor word
1135  FED1              ;     ($FBD3 LD HL,(BOOT+2)). Valid SP-init bytes only during the single cold-boot
1136  FED1              ;     pass; thereafter disk/console scratch, never re-executed. Twin of 2.20 BOOT. [RE]
1137  FED1              ;   Algorithm: set SP, then fall through into the self-modifying install engine
1138  FED1              ;     (BOOT_TMPL_XORA..SECTOR_BLOCK_PATCH are template-instruction cells whose operands double as
1139  FED1              ;     disk-deblock state).
1140  FED1              ; ----------------------------------------------------------------------
1141  FED1              BOOT:
1142  FED1                      ; init Z-80 stack; BOOT/+1/+2 reused post-boot as sektrk/seksec and a console cursor word
1143  FED1 31 00 01             LD SP,$0100
1144  FED4              ; ----------------------------------------------------------------------
1145  FED4              ; BOOT_TMPL_XORA -- cold-boot install template 'XOR A'; operationally a disk-state cell.
1146  FED4              ;   Boot tenant: 'XOR A' clears A as the install engine starts the page-clear. Operational
1147  FED4              ;   tenant: this cell is referenced as a console/disk scratch base (LD HL,BOOT_TMPL_XORA at
1148  FED4              ;   $FBBA in the console path). Twin region of 2.20 DISK_SELDSK_SAVE. [RE]
1149  FED4              ; ----------------------------------------------------------------------
1150  FED4              BOOT_TMPL_XORA:
1151  FED4 AF                   XOR A
1152  FED5              ; ----------------------------------------------------------------------
1153  FED5              ; DISK_SEKDSK -- cold-boot install template 'LD HL,BIOS_VECTOR'; operationally the sekdsk cell.
1154  FED5              ;   Boot tenant: 'LD HL,nn' template the install engine steps over. Operational tenant:
1155  FED5              ;   SELDSK uses DE=DISK_SEKDSK as the sekdsk build site (selected disk number). Twin of
1156  FED5              ;   2.20 DISK_SEKDSK. [RE]
1157  FED5              ; ----------------------------------------------------------------------
1158  FED5              DISK_SEKDSK:
1159  FED5 21 00 FA             LD HL,BIOS_VECTOR
1160  FED8              ; ----------------------------------------------------------------------
1161  FED8              ; DISK_HSTACT -- cold-boot install template 'LD (HL),A'; operationally the hstact flag.
1162  FED8              ;   Boot tenant: part of the page-zero/template clear. Operational tenant: host-buffer-
1163  FED8              ;   active flag, cleared by HOME ($FE72) and by PAGEZERO_REBUILD ($FAE7), set when a host
1164  FED8              ;   sector is staged. Twin of 2.20 DISK_HSTWRT-area hstact. [RE]
1165  FED8              ; ----------------------------------------------------------------------
1166  FED8              DISK_HSTACT:
1167  FED8 77                   LD (HL),A
1168  FED9              ; ----------------------------------------------------------------------
1169  FED9              ; DISK_HSTWRT -- cold-boot install template 'INC HL'; operationally the hstwrt flag.
1170  FED9              ;   Boot tenant: 'INC HL' advances the install-clear pointer. Operational tenant: host-
1171  FED9              ;   buffer-dirty flag, read by HOME ($FE6C). Twin of 2.20 DISK_HSTWRT. [RE]
1172  FED9              ; ----------------------------------------------------------------------
1173  FED9              DISK_HSTWRT:
1174  FED9 23                   INC HL
1175  FEDA 77                   LD (HL),A
1176  FEDB 23                   INC HL
1177  FEDC 77                   LD (HL),A
1178  FEDD              ; ----------------------------------------------------------------------
1179  FEDD              ; BOOT_TMPL_IOBYTE -- cold-boot install template 'LD A,$95' (default IOBYTE immediate).
1180  FEDD              ;   Boot tenant: loads the default IOBYTE value $95 into A. Operational tenant: this cell
1181  FEDD              ;   is cleared by PAGEZERO_REBUILD ($FAE4) and used as a console-state byte. Twin of the
1182  FEDD              ;   2.20 DISK_HSTWRT 'LD A,$95' default-IOBYTE template. [RE]
1183  FEDD              ; ----------------------------------------------------------------------
1184  FEDD              BOOT_TMPL_IOBYTE:
1185  FEDD                      ; default CP/M IOBYTE immediate ($95) loaded at cold boot
1186  FEDD 3E 95                LD A,$95
1187  FEDF              ; ----------------------------------------------------------------------
1188  FEDF              ; DISK_DMAADR -- cold-boot install template 'LD ($0003),A' (store default IOBYTE);
1189  FEDF              ;     +2 operand reused as dmaadr.
1190  FEDF              ;   Boot tenant: stores the default IOBYTE into page-zero $0003 at cold boot. Operational
1191  FEDF              ;   tenant: SETDMA writes BC into DISK_DMAADR+2 ($FEE1) as the current DMA buffer address
1192  FEDF              ;   (SETDMA 'LD (DISK_DMAADR+2),BC'); the deblock record copy uses it. Twin of the 2.20
1193  FEDF              ;   DISK_WRTYPE/DISK_DMAADR overlay. [RE]
1194  FEDF              ; ----------------------------------------------------------------------
1195  FEDF              DISK_DMAADR:
1196  FEDF                      ; store the default IOBYTE into page-zero $0003; the operand cell (+2) doubles as dmaadr
1197  FEDF 32 03 00             LD ($0003),A
1198  FEE2              ; ----------------------------------------------------------------------
1199  FEE2              ; DISK_PARAM_TMPL -- cold-boot install template 'LD HL,($F3DE)'; SELDSK self-modifies +1.
1200  FEE2              ;   Boot tenant: 'LD HL,(nn)' loads a config word; the install engine continues at $FEE5.
1201  FEE2              ;   Operational tenant: SELDSK patches DISK_PARAM_TMPL+1 ($FEE3) with a per-drive disk-
1202  FEE2              ;   parameter byte. From $FEE5 the cold-boot INSTALL ENGINE proper runs (see body). Twin
1203  FEE2              ;   of 2.20 DISK_UNADSK template + the DEV_INSTALL flow. [RE]
1204  FEE2              ;   Algorithm (install engine from $FEE5): copy the RPC-trigger store address into
1205  FEE2              ;     RPC_TRIGGER_STORE+1; clear page-zero $0004; read the console card class from config
1206  FEE2              ;     $F3BB; for the device-6/Pascal-class console install the $FD99 status handler into
1207  FEE2              ;     the $F380 vector, else for the Videx/40-col classes self-modify the CONST handler
1208  FEE2              ;     (KBD_STATUS_40COL+1) so status reads come from the card; then install CONOUT/CONIN handler
1209  FEE2              ;     vectors via the handler lookups, print the sign-on banner, and enter the CCP.
1210  FEE2              ; ----------------------------------------------------------------------
1211  FEE2              SECTOR_BLOCK_PATCH:
1212  FEE2                      ; install template: load a config word (operand at +1 is self-modified by SELDSK with the
1213  FEE2                      ; disk param)
1214  FEE2 2A DE F3             LD HL,($F3DE)
1215  FEE5                      ; self-modify: write the SoftCard RPC-trigger store address into RPC_TRIGGER_STORE's LD
1216  FEE5                      ; (nn),A operand [RE]
1217  FEE5 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1218  FEE8 AF                   XOR A
1219  FEE9                      ; clear page-zero $0004 (current default drive)
1220  FEE9 32 04 00             LD ($0004),A
1221  FEEC                      ; read the configured console card class from the config block (Apple $03BB)
1222  FEEC 3A BB F3             LD A,($F3BB)
1223  FEEF                      ; card class 6 = device-6 / Pascal-firmware console (post-1980 path; absent in the 1980
1224  FEEF                      ; manual) [RE]
1225  FEEF FE 06                CP $06
1226  FEF1 20 0A                JR NZ,DEV_INSTALL_LIST
1227  FEF3                      ; device-6 console: install the $FD99 status handler
1228  FEF3 21 99 FD             LD HL,SET_SCREEN_BASE_1
1229  FEF6                      ; store it into the SoftCard console-status I/O vector cell (Apple $0380)
1230  FEF6 22 80 F3             LD ($F380),HL
1231  FEF9 D6 03                SUB $03
1232  FEFB 18 13                JR DEV_INSTALL_PUNCH
1233  FEFD              ; ----------------------------------------------------------------------
1234  FEFD              ; DEV_INSTALL_LIST -- install the LIST device-output handler from the config class. [RE]
1235  FEFD              ;   In:  install engine running. Out: patches the LIST output stub vector. Clobbers: A,HL.
1236  FEFD              ;   Algorithm: read the LIST card class (config $F3B9 = Apple $03B9), bias by 3; if a
1237  FEFD              ;     real device is configured, look up its handler (CALL HANDLER_LOOKUP) and store it
1238  FEFD              ;     into the LIST stub vector (DEV_OUT_1_JP+1). Twin of 2.20 DEV_INSTALL flow. [RE]
1239  FEFD              ; ----------------------------------------------------------------------
1240  FEFD              DEV_INSTALL_LIST:
1241  FEFD FE 05                CP $05
1242  FEFF 28 22                JR Z,DEV_INSTALL_READER
1243  FF01 D6 03                SUB $03
1244  FF03 38 1E                JR C,DEV_INSTALL_READER
1245  FF05 20 09                JR NZ,DEV_INSTALL_PUNCH
1246  FF07 21 15 FB             LD HL,KBD_STATUS_40COL+1
1247  FF0A 36 BE                LD (HL),$BE
1248  FF0C 23                   INC HL
1249  FF0D 23                   INC HL
1250  FF0E 36 1F                LD (HL),$1F
1251  FF10              ; ----------------------------------------------------------------------
1252  FF10              ; DEV_INSTALL_PUNCH -- install the PUNCH device-output handler from the config class. [RE]
1253  FF10              ;   Algorithm: read the PUNCH card class (config $F3BA = Apple $03BA), bias by 3; if
1254  FF10              ;     configured, look up the handler and store it into the PUNCH stub vector (DEV_OUT_2_JP+1); for
1255  FF10              ;     the higher class value also install a secondary handler into DEV_OUT_3_JP+1. Twin of 2.20
1256  FF10              ;     DEV_INSTALL flow. [RE]
1257  FF10              ; ----------------------------------------------------------------------
1258  FF10              DEV_INSTALL_PUNCH:
1259  FF10 F5                   PUSH AF
1260  FF11 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1261  FF14 F1                   POP AF
1262  FF15 22 B9 FC             LD (SCREEN_EMIT_3+1),HL
1263  FF18                      ; secondary handler lookup via the skip-idiom entry (HANDLER_LOOKUP_B); the FD cover byte at
1264  FF18                      ; DEV_HANDLER_LOOKUP_B is skipped [RE]
1265  FF18 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1266  FF1B 22 37 FB             LD (CONIN_DISPATCH+1),HL
1267  FF1E 3E 03                LD A,$03
1268  FF20 32 05 FB             LD (CCP_LAUNCH+1),A
1269  FF23              ; ----------------------------------------------------------------------
1270  FF23              ; DEV_INSTALL_READER -- build the default READER/list-output stub when none is configured.
1271  FF23              ;   Algorithm: when no real device class is configured, build the no-op stub at DEV_OUT_3_JP:
1272  FF23              ;     store $1A3E ('LD A,$1A' opcode+immediate) then $C9 ('RET') so the device returns a
1273  FF23              ;     constant. Twin of 2.20 DEV_INSTALL_4's DEV_OUT_3 build. [RE]
1274  FF23              ; ----------------------------------------------------------------------
1275  FF23              DEV_INSTALL_READER:
1276  FF23 3A B9 F3             LD A,($F3B9)
1277  FF26 D6 03                SUB $03
1278  FF28 38 06                JR C,INSTALL_DONE_DEVICES
1279  FF2A CD 84 FF             CALL DEV_HANDLER_LOOKUP
1280  FF2D 22 50 FE             LD (DEV_OUT_1_JP+1),HL
1281  FF30              ; ----------------------------------------------------------------------
1282  FF30              ; INSTALL_DONE_DEVICES -- run the device probe after the per-device installs. [RE]
1283  FF30              ;   Algorithm: CALL PROBE_DEVICES (PROBE_DEVICES) to scan the 7 SoftCard config slots and
1284  FF30              ;     mark/init each present card before the banner is printed. Twin of 2.20 DEV_INSTALL_6
1285  FF30              ;     PROBE_DEVICES call. [RE]
1286  FF30              ; ----------------------------------------------------------------------
1287  FF30              INSTALL_DONE_DEVICES:
1288  FF30 3A BA F3             LD A,($F3BA)
1289  FF33 D6 03                SUB $03
1290  FF35 38 14                JR C,SLOT_IO_SCALE_17
1291  FF37 F5                   PUSH AF
1292  FF38 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1293  FF3B 22 64 FE             LD (DEV_OUT_2_JP+1),HL
1294  FF3E F1                   POP AF
1295  FF3F FE 02                CP $02
1296  FF41 28 08                JR Z,SLOT_IO_SCALE_17
1297  FF43 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1298  FF46 22 6A FE             LD (DEV_OUT_3_JP+1),HL
1299  FF49 18 0B                JR SLOT_IO_SCALE_18
1300  FF4B              SLOT_IO_SCALE_17:
1301  FF4B 21 3E 1A             LD HL,$1A3E
1302  FF4E 22 69 FE             LD (DEV_OUT_3_JP),HL
1303  FF51 3E C9                LD A,$C9
1304  FF53 32 6B FE             LD (DEV_OUT_3_JP+2),A
1305  FF56              SLOT_IO_SCALE_18:
1306  FF56                      ; scan + init the 7 SoftCard config slots (device probe) before the sign-on
1307  FF56 CD 82 FA             CALL PROBE_DEVICES
1308  FF59              ; ----------------------------------------------------------------------
1309  FF59              ; SIGNON_PRINT -- emit the two config-derived sign-on prefix chars, then the banner. [RE]
1310  FF59              ;   In:  none. Out: prints the sign-on. Clobbers: A,HL.
1311  FF59              ;   Algorithm: read config $F398 (Apple $0398), pass it to the CONOUT writer (CONOUT_DISPATCH),
1312  FF59              ;     then walk SIGNON_BANNER (SIGNON_BANNER) char-by-char through CONOUT until the $00
1313  FF59              ;     terminator, then enter PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS). Twin of the 2.20
1314  FF59              ;     DEV_INSTALL_6/
1315  FF59              ;     DEV_INSTALL_7 banner loop (here it routes through CONOUT directly, not SIGNON_EMIT).
1316  FF59              ;     NOTE: WBOOT (WBOOT) also stashes SIGNON_PRINT into the $F3D0 RPC mailbox at
1317  FF59              ;     $FACE for a re-init path. [RE]
1318  FF59              ; ----------------------------------------------------------------------
1319  FF59              SIGNON_PRINT:
1320  FF59                      ; first config-derived sign-on char (Apple $0398)
1321  FF59 3A 98 F3             LD A,($F398)
1322  FF5C                      ; emit it via SIGNON_EMIT (prefixes a config char if bit7 set), routed through CONOUT
1323  FF5C CD 8F FF             CALL SIGNON_EMIT
1324  FF5F                      ; HL -> the cold-boot sign-on banner string
1325  FF5F 21 9E FF             LD HL,SIGNON_BANNER
1326  FF62              ; ----------------------------------------------------------------------
1327  FF62              ; SIGNON_BANNER_LOOP -- print SIGNON_BANNER char-by-char until the $00 terminator. [RE]
1328  FF62              ;   In:  HL -> banner. Out: jumps to PAGEZERO_REBUILD at the terminator. Clobbers: A,HL.
1329  FF62              ;   Algorithm: load (HL); if $00 jump to PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS) to finish cold
1330  FF62              ;     boot; else push HL, CALL CONOUT (CONOUT_DISPATCH), pop, INC HL, repeat. Twin of 2.20
1331  FF62              ;     DEV_INSTALL_7. [RE]
1332  FF62              ; ----------------------------------------------------------------------
1333  FF62              SIGNON_BANNER_LOOP:
1334  FF62 7E                   LD A,(HL)
1335  FF63 B7                   OR A
1336  FF64                      ; banner terminator -> PAGEZERO_REBUILD (write page-zero hooks, enter the CCP)
1337  FF64 CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1338  FF67 E5                   PUSH HL
1339  FF68                      ; emit one banner char via CONOUT
1340  FF68 CD 4C FB             CALL CONOUT_DISPATCH
1341  FF6B E1                   POP HL
1342  FF6C 23                   INC HL
1343  FF6D 18 F3                JR SIGNON_BANNER_LOOP
1344  FF6F              SLOT_IO_SCALE_21:
1345  FF6F 0E FD                LD C,$FD
1346  FF71 71                   LD (HL),C
1347  FF72 FD                   DEFB $FD  ; ignored IY prefix; inner: LD D,D
1348  FF73 52                   LD D,D
1349  FF74 FE A9                CP $A9
1350  FF76 FD                   DEFB $FD  ; ignored IY prefix; inner: LD B,D
1351  FF77              SLOT_IO_SCALE_22:
1352  FF77 42                   LD B,D
1353  FF78 FE C1                CP $C1
1354  FF7A FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1355  FF7B B7                   OR A
1356  FF7C FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1357  FF7D B7                   OR A
1358  FF7E              ; ----------------------------------------------------------------------
1359  FF7E              ; DEV_HANDLER_LOOKUP_B -- secondary-table handler lookup, entered at +1 via a skip idiom.
1360  FF7E              ;   In:  A = entry index. Out: HL = handler address from the secondary table. Clobbers: A,HL.
1361  FF7E              ;   SKIP IDIOM: the byte at DEV_HANDLER_LOOKUP_B ($FF7E) is an $FD cover (reads as 'LD IY,$FF77'
1362  FF7E              ;     when fallen into); every CALLER targets DEV_HANDLER_LOOKUP_B+1 ($FF7F) which executes
1363  FF7E              ;     'LD HL,SLOT_IO_SCALE_22' (the secondary DEV_HANDLER_PTRS_B base) then 'JR DEV_HANDLER_
1364  FF7E              ;     LOOKUP_IDX'. Twin of 2.20 DEV_HANDLER_LOOKUP_B (there a clean 'LD HL,..; JR'). [RE]
1365  FF7E              ;   -- see flags for the cover byte and the surrounding DEFB-as-code handler table.
1366  FF7E              ; ----------------------------------------------------------------------
1367  FF7E              DEV_HANDLER_LOOKUP_B:
1368  FF7E                      ; COVER: the FD prefix makes this 'LD IY,$FF77' on fall-in; callers enter at +1 => 'LD
1369  FF7E                      ;        HL,SLOT_IO_SCALE_22' (secondary table base) [RE]
1370  FF7E FD 21 77 FF          LD IY,SLOT_IO_SCALE_22
1371  FF82                      ; join the shared index tail (HL += A*2; load the word)
1372  FF82 18 03                JR DEV_HANDLER_LOOKUP_IDX
1373  FF84              ; ----------------------------------------------------------------------
1374  FF84              ; DEV_HANDLER_LOOKUP -- fetch a device-handler address from the primary pointer table.
1375  FF84              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1376  FF84              ;   Algorithm: HL = DEV_HANDLER_PTRS base (SLOT_IO_SCALE_21); fall into the shared scaler
1377  FF84              ;     (ADD A,A; ADD A,L; LD L,A) then load the 16-bit word at that slot (low then high).
1378  FF84              ;     The secondary-table entry is HANDLER_LOOKUP_B at DEV_HANDLER_LOOKUP_B+1 (skip idiom). Twin
1379  FF84              ;     of 2.20 DEV_HANDLER_LOOKUP. [RE]
1380  FF84              ; ----------------------------------------------------------------------
1381  FF84              DEV_HANDLER_LOOKUP:
1382  FF84                      ; select the primary device-handler pointer table
1383  FF84 21 6F FF             LD HL,SLOT_IO_SCALE_21
1384  FF87              ; ----------------------------------------------------------------------
1385  FF87              ; DEV_HANDLER_LOOKUP_IDX -- shared table-index tail: HL += A*2; HL = word at that slot.
1386  FF87              ;   In:  A = index, HL = table base. Out: HL = the 16-bit handler address. Clobbers: A,HL.
1387  FF87              ;   Twin of 2.20 DISK_RTN_LOOKUP_IDX. [RE]
1388  FF87              ; ----------------------------------------------------------------------
1389  FF87              DEV_HANDLER_LOOKUP_IDX:
1390  FF87                      ; index*2 for 16-bit (word) table entries
1391  FF87 87                   ADD A,A
1392  FF88 85                   ADD A,L
1393  FF89 6F                   LD L,A
1394  FF8A                      ; load handler address low byte
1395  FF8A 7E                   LD A,(HL)
1396  FF8B 2C                   INC L
1397  FF8C                      ; load handler address high byte -> HL = handler entry
1398  FF8C 66                   LD H,(HL)
1399  FF8D 6F                   LD L,A
1400  FF8E C9                   RET
1401  FF8F              ; ----------------------------------------------------------------------
1402  FF8F              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1403  FF8F              ;   In:  A = byte/flag. Out: prints via CONOUT (CONOUT_DISPATCH). Clobbers: A,HL.
1404  FF8F              ;   Algorithm: if A is positive (bit7 clear) emit it directly via CONOUT; if negative,
1405  FF8F              ;     first emit the prefix char from config $F397 (Apple $0397), then tail-jump to
1406  FF8F              ;     CONOUT to emit A. Twin of 2.20 SIGNON_EMIT. [RE]
1407  FF8F              ; ----------------------------------------------------------------------
1408  FF8F              SIGNON_EMIT:
1409  FF8F B7                   OR A
1410  FF90                      ; bit7 clear -> emit the char directly via CONOUT
1411  FF90 F2 9B FF             JP P,SIGNON_EMIT_CHAR
1412  FF93 F5                   PUSH AF
1413  FF94                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1414  FF94 3A 97 F3             LD A,($F397)
1415  FF97                      ; emit the prefix char via CONOUT
1416  FF97 CD 4C FB             CALL CONOUT_DISPATCH
1417  FF9A F1                   POP AF
1418  FF9B              ; ----------------------------------------------------------------------
1419  FF9B              ; SIGNON_EMIT_CHAR -- tail of SIGNON_EMIT: emit the original char via CONOUT. [RE]
1420  FF9B              ; ----------------------------------------------------------------------
1421  FF9B              SIGNON_EMIT_CHAR:
1422  FF9B                      ; tail-call CONOUT to emit the char
1423  FF9B C3 4C FB             JP CONOUT_DISPATCH
1424  FF9E              ; ----------------------------------------------------------------------
1425  FF9E              ; SIGNON_BANNER -- the cold-boot sign-on string, printed by SIGNON_BANNER_LOOP until $00.
1426  FF9E              ;   Reads (40-col uppercase / Videx mixed-case): CR/LF/LF/LF, '     Softcard CP/M', CR/LF,
1427  FF9E              ;   '     44K Ver. 2.23', CR/LF, '(c) 1980,1982 Microsoft', CR, LF/CR/LF, $00. DATA.
1428  FF9E              ;   NOTE: the 40-col Apple screen is uppercase-only so it renders 'SOFTCARD'; the Videx
1429  FF9E              ;   80-col card renders the mixed-case 'Softcard'. The trailing bytes from $FFE6 ($FA $E5
1430  FF9E              ;   ...) are NOT banner text -- they are an in-image copy of handler/lookup code; see flags.
1431  FF9E              ;   Twin of 2.20 SIGNON_BANNER (which reads 'Apple ][ CP/M' / '44K Ver. 2.20' /
1432  FF9E              ;   '(C) 1980 Microsoft'). [RE]
1433  FF9E              ; ----------------------------------------------------------------------
1434  FF9E              SIGNON_BANNER:
1435  FF9E 0D 0A 0A 0A          DEFB    "\r\n\n\n"
1436  FFA2 20 20 20 20          DEFB    "     Softcard CP/M"     ; string
1436  FFA6 20 53 6F 66
1436  FFAA 74 63 61 72
1436  FFAE 64 20 43 50
1436  FFB2 2F 4D
1437  FFB4 0D                   DEFB    $0D                      ; terminator
1438  FFB5 0A                   DEFB    "\n"
1439  FFB6 20 20 20 20          DEFB    "     44K Ver. 2.23"     ; string
1439  FFBA 20 34 34 4B
1439  FFBE 20 56 65 72
1439  FFC2 2E 20 32 2E
1439  FFC6 32 33
1440  FFC8 0D                   DEFB    $0D                      ; terminator
1441  FFC9 0A                   DEFB    "\n"
1442  FFCA 28 63 29 20          DEFB    "(c) 1980,1982 Microsoft" ; string
1442  FFCE 31 39 38 30
1442  FFD2 2C 31 39 38
1442  FFD6 32 20 4D 69
1442  FFDA 63 72 6F 73
1442  FFDE 6F 66 74
1443  FFE1 0D                   DEFB    $0D                      ; terminator
1444  FFE2 0A 0D 0A 00          DEFB    $0A,$0D,$0A,$00,$FA,$E5,$CD,$4C,$FB,$E1,$23,$18,$F3,$0E,$FD,$71
1444  FFE6 FA E5 CD 4C
1444  FFEA FB E1 23 18
1444  FFEE F3 0E FD 71
1445  FFF2 FD 52 FE A9          DEFB    $FD,$52,$FE,$A9,$FD,$42,$FE,$C1,$FD,$B7,$FD,$B7,$FD,$21
1445  FFF6 FD 42 FE C1
1445  FFFA FD B7 FD B7
1445  FFFE FD 21
1446  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1447  0000
1448  0000                  SAVEBIN "{out_bin}", $FA00, $0600
1449  0000                  IFNDEF CPM_LINK
1450  0000                  ; image size from bracketing labels; $FA00 = the ORG base (image wraps to $0000)
1451  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1452  0000                  ENDIF
1453  0000
1454  0000              ; ----------------------------------------------------------------------
1455  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEE4-$FFDB.
1456  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above. It runs once at cold
1457  0000              ;   start; only afterwards does the disk system reuse them as the buffers DPH_TABLE
1458  0000              ;   hands out. The two tenants are never live at the same time.
1459  0000              ;
1460  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1461  0000              ;   at the overlay base, then one label per field with its extent carried in the
1462  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1463  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1464  0000              ;   the image, and the ORG leaves the emitted output untouched.
1465  0000              ;
1466  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1467  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1468  0000              ;   cold boot has finished. The sizes are the DPB's own values, so they cannot drift
1469  0000              ;   from the DPB this BIOS publishes. Same shape and names as the 2.20-44K and
1470  0000              ;   2.23-60K twins; only the addresses and the drive count differ. [RE]
1471  0000              ; ----------------------------------------------------------------------
1472  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1473  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1474  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1475  0000              CSV_SIZE     EQU 12                   ; = CKS
1476  0000
1477  0000                      ORG $FEE4                     ; the one given: where the author placed the overlay
1478  FEE4              DIRBUF:                               ; shared directory buffer, one per system
1479  FEE4                      ORG DIRBUF + DIRBUF_SIZE
1480  FF64              ALV_VECTORS:                          ; per-drive allocation vectors ($FF64..)
1481  FF64                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1482  FFAC              CSV_VECTORS:                          ; per-drive checksum vectors ($FFAC..)
1483  FFAC                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1484  FFDC              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFDC)
1485  FFDC
1486  FFDC                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1487  FFDC                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1488  FFDC                  ASSERT ALV_VECTORS == $FF64
1489  FFDC                  ASSERT CSV_VECTORS == $FFAC
1490  FFDC                  ASSERT BIOS_SCRATCH_END == $FFDC
1491  FFDC
# file closed: CPM_BIOS.asm

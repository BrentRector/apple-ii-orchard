# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.23 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 2.23-44K BIOS runs at z80 $FA00-$FFFF (6 pages) = Apple $0A00-$0FFF LOW RAM
   5  0000              ; (NOT $AA00 like 2.20 -- a different mechanism). Decoded against the de-skewed
   6  0000              ; runtime image; the disk producer re-applies the sector skew (deskew.py ::
   7  0000              ; BIOS_PAGE_TO_SECTOR_223). $FA00 = the 15-entry BIOS jump vector.
   8  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
   9  0000              ; being enriched to the C-level bar.
  10  0000              ; ============================================================================
  11  0000
  12  0000                  IFNDEF CPM_LINK
  13  0000                  DEVICE NOSLOT64K
  14  0000                  ORG $FA00
  15  FA00                  ENDIF
  16  FA00
  17  FA00              ; ----------------------------------------------------------------------
  18  FA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector (2.23-44K, runtime $FA00).
  19  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  20  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  21  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  22  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  23  FA00              ;   Note: the CONOUT target ($FB4D) is the second-instruction entry of
  24  FA00              ;         CONOUT_DISPATCH (skips its leading LD C,A); see flags. [RE]
  25  FA00              ; ----------------------------------------------------------------------
  26  FA00              BIOS_VECTOR:
  27  FA00                      ; entry 0 = cold boot (BOOT, lives in the $FE85 band, out of this scope)
  28  FA00 C3 D1 FE             JP BOOT
  29  FA03              ; ----------------------------------------------------------------------
  30  FA03              ; BIOS_VECTOR_WBOOT -- jump-table entries 1..14 (WBOOT .. WRITE).
  31  FA03              ;   Same 14-entry layout as the 2.20-44K twin; only the target addresses move
  32  FA03              ;   ($FA-band, not $AA). CONOUT ($FA0C) targets CONOUT_DISPATCH+1 ($FB4D). [RE]
  33  FA03              ; ----------------------------------------------------------------------
  34  FA03              BIOS_VECTOR_WBOOT:
  35  FA03                      ; jump table
  36  FA03                      ; entry 1 = WBOOT: reload CCP, rebuild page zero
  37  FA03 C3 B8 FA             JP      WBOOT
  38  FA06                      ; entry 2 = CONST: console status via IOBYTE
  39  FA06 C3 10 FB             JP      CONST
  40  FA09                      ; entry 3 = CONIN: dispatch + function/arrow remap
  41  FA09 C3 1A FB             JP      CONIN
  42  FA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  43  FA0C C3 4D FB             JP      $FB4D
  44  FA0F                      ; entry 5 = LIST: route by IOBYTE LIST field
  45  FA0F C3 70 FB             JP      LIST
  46  FA12                      ; entry 6 = PUNCH: route by IOBYTE PUNCH field
  47  FA12 C3 7F FB             JP      PUNCH
  48  FA15                      ; entry 7 = READER: route by IOBYTE READER field
  49  FA15 C3 91 FB             JP      READER
  50  FA18                      ; entry 8 = HOME (out of this scope, $FDB0 band)
  51  FA18 C3 6C FE             JP      HOME
  52  FA1B                      ; entry 9 = SELDSK (out of this scope, $FE85 band)
  53  FA1B C3 8E FE             JP      SELDSK
  54  FA1E                      ; entry 10 = SETTRK (out of this scope, $FE77)
  55  FA1E C3 77 FE             JP      $FE77
  56  FA21                      ; entry 11 = SETSEC: store sector into deblock scratch
  57  FA21 C3 F4 FB             JP      SETSEC
  58  FA24                      ; entry 12 = SETDMA: store DMA address into deblock scratch
  59  FA24 C3 F9 FB             JP      SETDMA
  60  FA27                      ; entry 13 = READ (out of this scope, $FE85 band)
  61  FA27 C3 BD FE             JP      READ
  62  FA2A                      ; entry 14 = WRITE (out of this scope, $FE85 band)
  63  FA2A C3 C0 FE             JP      WRITE
  64  FA2D              ; ----------------------------------------------------------------------
  65  FA2D              ; The last two jump-table slots are not JPs: both handlers are short enough to sit
  66  FA2D              ; INLINE in the table, which is legal because nothing after entry 16 needs a fixed
  67  FA2D              ; offset. They used to be dumped here as an opaque DEFB run described as a
  68  FA2D              ; "post-vector trailer ... not reached as code here", which was wrong twice over:
  69  FA2D              ; the BDOS reaches both through the jump table, and the bytes are ordinary Z-80. [RE]
  70  FA2D              ; ----------------------------------------------------------------------
  71  FA2D              ; LISTST -- entry 15: return the list device's ready status.
  72  FA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
  73  FA2D              ;   Algorithm: XOR A / RET. A is $00 whatever the printer is doing. Under the
  74  FA2D              ;     CP/M 2.2 convention $00 means NOT ready and $FF means ready, so this
  75  FA2D              ;     reports "not ready" unconditionally.
  76  FA2D              ;     That is the whole of what these two bytes support. WHO consults LISTST, and
  77  FA2D              ;     what they do with the answer, is NOT determinable from this image, and the
  78  FA2D              ;     SoftCard manual set in softcard/reference/ does not document LISTST at all
  79  FA2D              ;     -- so no claim is made here about callers or about anything blocking. Same two bytes in the 2.20-44K and 2.23-60K twins. [RE]
  80  FA2D              ; ----------------------------------------------------------------------
  81  FA2D              LISTST:
  82  FA2D AF                   XOR A
  83  FA2E C9                   RET
  84  FA2F 00                   DEFB    $00                      ; pad: realigns SECTRAN onto the 3-byte slot grid
  85  FA30              ; ----------------------------------------------------------------------
  86  FA30              ; SECTRAN -- entry 16: logical-to-physical sector translate (identity).
  87  FA30              ;   In:  BC = logical sector, DE = translate-table address (ignored).
  88  FA30              ;   Out: HL = BC (physical == logical).  Clobbers: H, L.
  89  FA30              ;   Algorithm: LD H,B / LD L,C / RET. The DPH XLT field is 0 for every drive, so the
  90  FA30              ;     BDOS asks for no translation and this returns its argument unchanged; the skew
  91  FA30              ;     is applied by the disk producer, off-image. Same three bytes in both twins. [RE]
  92  FA30              ; ----------------------------------------------------------------------
  93  FA30              SECTRAN:
  94  FA30 60                   LD H,B
  95  FA31 69                   LD L,C
  96  FA32 C9                   RET
  97  FA33              ; ----------------------------------------------------------------------
  98  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
  99  FA33              ;   drive 0..3; 2.23 supports 4 drives, vs 6 in the 2.20 twin). SELDSK returns
 100  FA33              ;   DPH_TABLE + 16*drive. Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV,
 101  FA33              ;   ALV. XLT = 0 (no SECTRAN translate). All drives share one DIRBUF and one DPB.
 102  FA33              ;   The per-drive strides are the DPB's own fields: CSV is CKS = 12 bytes, ALV is
 103  FA33              ;   DSM/8 + 1 = 139/8 + 1 = 18 bytes. [RE]
 104  FA33              ; ----------------------------------------------------------------------
 105  FA33              ; DIRBUF, ALV_VECTORS and CSV_VECTORS are the BDOS scratch buffers this table hands out.
 106  FA33              ; They are declared at the foot of this file (see "BDOS scratch overlay"), because they
 107  FA33              ; are a SECOND tenant of bytes the cold-boot code owns: the layout is set out there with
 108  FA33              ; its own ORG, so each field is a real label rather than a magic address.
 109  FA33              DPH_TABLE:
 110  FA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
 110  FA37 00 00 00 00
 110  FA3B E4 FE 73 FA
 110  FA3F AC FF 64 FF
 111  FA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+18   ; drive 1
 111  FA47 00 00 00 00
 111  FA4B E4 FE 73 FA
 111  FA4F B8 FF 76 FF
 112  FA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+36   ; drive 2
 112  FA57 00 00 00 00
 112  FA5B E4 FE 73 FA
 112  FA5F C4 FF 88 FF
 113  FA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+54   ; drive 3
 113  FA67 00 00 00 00
 113  FA6B E4 FE 73 FA
 113  FA6F D0 FF 9A FF
 114  FA73              ; ----------------------------------------------------------------------
 115  FA73              ; DPB -- the shared Disk Parameter Block (5.25" floppy; every DPH points here).
 116  FA73              ;   One label per field, so the field names are symbols rather than prose. The ten names
 117  FA73              ;   are Digital Research's CP/M 2.2 DPB field names. Not [DOC]-citable from THIS archive
 118  FA73              ;   -- the SoftCard set bundles DRI's CP/M 2.2 *Reference Manual*, which documents only
 119  FA73              ;   the BDOS call that RETURNS a DPB pointer (fn 31, Get Addr (disk parms)), not the
 120  FA73              ;   block's layout. The layout IS normatively specified by a DRI manual not in the box:
 121  FA73              ;   the CP/M 2.2 *Alteration Guide* (1979), sec. Disk Parameter Tables. SoftCard CP/M is
 122  FA73              ;   licensed DRI CP/M 2.2, so that manual governs this block. [DOC CPMAG "Disk Parameter
 123  FA73              ;   Tables"]  NOTE: the Guide defines every field but NEVER spells the acronyms out; the
 124  FA73              ;   expansions in the comments below are the conventional readings, not DRI's. [?]
 125  FA73              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 126  FA73              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track. [RE]
 127  FA73              ;   This block is byte-identical to the 2.20-44K twin's except for DSM (see below). [RE]
 128  FA73              ; ----------------------------------------------------------------------
 129  FA73              DPB:
 130  FA73 20 00        SPT:    DEFW    $0020                    ; Sectors Per Track: counts 128-byte RECORDS, not 256-byte sectors -> 32
 131  FA75 03           BSH:    DEFB    $03                      ; Block SHift: log2(records per block) -> 8 records
 132  FA76 07           BLM:    DEFB    $07                      ; BLock Mask: (records per block) - 1 -> 1 KB blocks
 133  FA77 00           EXM:    DEFB    $00                      ; EXtent Mask
 134  FA78              ; DSM is the ONLY byte in which this DPB differs from the 2.20-44K twin ($7F there).
 135  FA78              ;   The arithmetic does not close: 140 blocks / 4 blocks per track = 35 tracks of file
 136  FA78              ;   area, which with OFF=3 implies a 38-track disk; the medium is 35 tracks total. The
 137  FA78              ;   twin's $7F gives 32 + 3 = 35 exactly. What absorbs the surplus is a directory entry
 138  FA78              ;   present on every 2.23 disk: user byte $1F, lowercase name "cp/m    sys", allocation
 139  FA78              ;   list exactly blocks 128-139 -- the twelve blocks past the twin's 128. The BDOS's
 140  FA78              ;   allocation-vector rebuild skips only $E5 entries and does not range-check the user
 141  FA78              ;   number, so that entry is honoured and those twelve blocks stay marked in use.
 142  FA78              ;   RESOLVED (2026-07-31), and the answer is neither: BLOCKS 128-139 ARE THE SYSTEM TRACKS.
 143  FA78              ;   The 2.23 deblock (CPM_BootLoader_DiskXlate.asm, SM_NOFLUSH at $BCDA) folds any requested
 144  FA78              ;   track >= 35 back by 35, GATED ON THE DPB's DSM BYTE BEING $8B. The arithmetic is exact:
 145  FA78              ;   block 128 -> record 1024 -> OFF + 1024/SPT = track 35 -> 0; block 139 -> track 37 -> 2.
 146  FA78              ;   Twelve blocks = 12 KB = tracks 0,1,2 = 12,288 bytes, no remainder. So DSM=$8B deliberately
 147  FA78              ;   extends the disk by exactly the reserved area, making it addressable through the ordinary
 148  FA78              ;   file system, and "cp/m    sys" is the directory entry that NAMES it. The gate is the proof
 149  FA78              ;   of intent: a defensive clamp would not need to test DSM.
 150  FA78              ;   That entry is written by two shipped tools -- CPM60.COM (CPMV223-60K/CPM60_installer.asm)
 151  FA78              ;   and COPY.COM on its /S path (CPMV223-44K/utilities/COPY.asm $037F).
 152  FA78              ;   CONSEQUENCE: a disk with NO such entry (every 2.20-lineage disk; any disk made with
 153  FA78              ;   COPY /F rather than /S) lets the allocator hand out blocks 128-139 once 0-127 are full.
 154  FA78              ;   Writing there does not fail and does not reach a drive error -- it SILENTLY OVERWRITES
 155  FA78              ;   TRACKS 0-2 and destroys the boot pipeline. Verified in the emulator: SAVE into block 128
 156  FA78              ;   reported success and changed 689 bytes of track 0. See docs/CPM_Disk_Creation.md and
 157  FA78              ;   docs/CPM_Source_Changes_For_Narratives.md Part 5. [RE]
 158  FA78 8B 00        DSM:    DEFW    $008B                    ; Disk Size Max: highest allocation block number: 139 -> 140 blocks
 159  FA7A 2F 00        DRM:    DEFW    $002F                    ; DiRectory Max: highest directory entry number: 47 -> 48 entries
 160  FA7C C0           AL0:    DEFB    $C0                      ; ALlocation bitmap, directory-reserved blocks, high byte -> 2
 161  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 162  FA7E 0C 00        CKS:    DEFW    $000C                    ; ChecKSum: directory checksum bytes
 163  FA80 03 00        OFF:    DEFW    $0003                    ; OFFset: reserved tracks before the file area
 164  FA82              ; ----------------------------------------------------------------------
 165  FA82              ; PROBE_DEVICES -- scan the SoftCard device/config area and mark presence.
 166  FA82              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 167  FA82              ;   Out: config bytes updated in place; per-device init called when a device is found.
 168  FA82              ;   Clobbers: A,DE,HL.
 169  FA82              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E].  If it equals 3 the slot
 170  FA82              ;     holds a recognized device, so call SLOT_IO_ADDR and store $03 then $15 into the
 171  FA82              ;     cell to flag it configured.  A secondary DEC A test (original value 4, e.g. a
 172  FA82              ;     Videx-class 80-col console) runs SET_SCREEN_BASE and claims the $C800 shared
 173  FA82              ;     expansion-ROM window via RPC_TRIGGER; a value-2 path repoints a vector via
 174  FA82              ;     PLOT_CHAR_RPC ($0DD0 param).  Same shape as the 2.20 twin's PROBE_DEVICES. [RE]
 175  FA82              ; ----------------------------------------------------------------------
 176  FA82              PROBE_DEVICES:
 177  FA82                      ; DE = 7 entries to scan (index walks down to 1)
 178  FA82 11 07 00             LD DE,$0007
 179  FA85              PROBE_DEVICES_LOOP:
 180  FA85                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 181  FA85 21 B8 F3             LD HL,$F3B8
 182  FA88 19                   ADD HL,DE
 183  FA89 7E                   LD A,(HL)
 184  FA8A                      ; config value 3 = a recognized/present device in this slot
 185  FA8A D6 03                SUB $03
 186  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 187  FA8E                      ; build the slot I/O base for the found device (SLOT_IO_ADDR)
 188  FA8E CD 81 FE             CALL SLOT_IO_ADDR
 189  FA91                      ; rewrite the cell: $03 then $15 = mark this device configured
 190  FA91 36 03                LD (HL),$03
 191  FA93 36 15                LD (HL),$15
 192  FA95              PROBE_DEVICES_CHK4:
 193  FA95                      ; after the SUB, A==1 means the original value was 4 (Videx-class 80-col console)
 194  FA95 3D                   DEC A
 195  FA96 20 0B                JR NZ,PROBE_DEVICES_CHK2
 196  FA98                      ; console probe / select the 80-col screen base (SET_SCREEN_BASE)
 197  FA98 CD 83 FD             CALL SET_SCREEN_BASE
 198  FA9B                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 199  FA9B 21 00 C8             LD HL,$C800
 200  FA9E CD 45 FB             CALL RPC_TRIGGER
 201  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 202  FAA3              PROBE_DEVICES_CHK2:
 203  FAA3                      ; value 2 = a different device class (e.g. printer/serial); takes the PLOT_CHAR_RPC path
 204  FAA3 FE 02                CP $02
 205  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 206  FAA7                      ; param for the value-2 vector init ($0DD0)
 207  FAA7 21 D0 0D             LD HL,$0DD0
 208  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 209  FAAD              PROBE_DEVICES_NEXT:
 210  FAAD                      ; next config entry; loop until all 7 scanned
 211  FAAD 1D                   DEC E
 212  FAAE 20 D5                JR NZ,PROBE_DEVICES_LOOP
 213  FAB0 C9                   RET
 214  FAB1              ; ----------------------------------------------------------------------
 215  FAB1              ; DEVICE_IO_BASE -- form a SoftCard I/O / soft-switch address from a device/offset index.
 216  FAB1              ;   In:  E = low offset within the I/O page.
 217  FAB1              ;   Out: HL = ((E | $E0) << 8), an address in z80 $E000-$EFFF = Apple I/O $C000-$CFFF;
 218  FAB1              ;        A clobbered.
 219  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 220  FAB1              ;        page, then H = A.  Used to reach keyboard / soft switches / slot I/O.
 221  FAB1              ;        Same as the 2.20 twin's DEVICE_IO_BASE (distinct from SLOT_IO_ADDR at $FE81). [RE]
 222  FAB1              ; ----------------------------------------------------------------------
 223  FAB1              DEVICE_IO_BASE:
 224  FAB1                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 225  FAB1 21 00 E0             LD HL,$E000
 226  FAB4 7B                   LD A,E
 227  FAB5                      ; force the high byte into the $C0xx I/O range
 228  FAB5 B4                   OR H
 229  FAB6 67                   LD H,A
 230  FAB7 C9                   RET
 231  FAB8              ; ----------------------------------------------------------------------
 232  FAB8              ; WBOOT -- CP/M warm boot: re-init the console, rebuild page zero, re-enter the CCP.
 233  FAB8              ;   In:  none.  Out: jumps to the CCP at $9300; does not return.  Clobbers: all.
 234  FAB8              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 235  FAB8              ;     (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 236  FAB8              ;     PROBE_DEVICES.  If the CCP image signature at $9C08 is intact ($9C) it falls
 237  FAB8              ;     into PAGEZERO_REBUILD; otherwise it reloads the CCP/system via a page-zero JP.
 238  FAB8              ;   Note: 2.23 reloads through a self-built $000B jump and enters the CCP at $9300
 239  FAB8              ;     (the 2.20 twin used $9400). [RE]
 240  FAB8              ; ----------------------------------------------------------------------
 241  FAB8              WBOOT:
 242  FAB8                      ; stack at the default DMA buffer top (page-zero $0080)
 243  FAB8 31 80 00             LD SP,$0080
 244  FABB                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 245  FABB 3A 51 E0             LD A,($E051)
 246  FABE 21 00 0E             LD HL,$0E00
 247  FAC1                      ; re-init the console I/O vectors (RPC_TRIGGER) for warm restart
 248  FAC1 CD 45 FB             CALL RPC_TRIGGER
 249  FAC4                      ; re-scan devices so warm boot rebuilds the I/O table
 250  FAC4 CD 82 FA             CALL PROBE_DEVICES
 251  FAC7                      ; read the CCP-image signature byte at $9C08
 252  FAC7 3A 08 9C             LD A,($9C08)
 253  FACA                      ; signature $9C present = CCP image intact, skip the reload
 254  FACA FE 9C                CP $9C
 255  FACC 28 11                JR Z,PAGEZERO_REBUILD
 256  FACE 21 59 FF             LD HL,SIGNON_PRINT
 257  FAD1 22 D0 F3             LD ($F3D0),HL
 258  FAD4 2A DE F3             LD HL,($F3DE)
 259  FAD7 3E 77                LD A,$77
 260  FAD9                      ; plant a $77 byte at page-zero $000B to bridge into the reload path
 261  FAD9 32 0B 00             LD ($000B),A
 262  FADC                      ; jump into the self-built page-zero reload bridge
 263  FADC C3 0B 00             JP $000B
 264  FADF              ; ----------------------------------------------------------------------
 265  FADF              ; PAGEZERO_REBUILD -- clear the CCP-restart flag, then write the page-zero hooks.
 266  FADF              ;   In:  none.  Out: falls into CCP_LAUNCH; no return.  Clobbers: A,HL,BC.
 267  FADF              ;   Algorithm: zero the CCP restart flag at $9307, then (PAGEZERO_REBUILD_HOOKS)
 268  FADF              ;     plant JP ($C3) at $0000 -> the BIOS WBOOT entry (BIOS_VECTOR+3, BIOS_VECTOR_WBOOT) and
 269  FADF              ;     JP at $0005 -> the BDOS entry $9C06; clear two self-modified BIOS state cells
 270  FADF              ;     ($FEDD/$FED8); set the default DMA to $0080 via SETDMA. [RE]
 271  FADF              ; ----------------------------------------------------------------------
 272  FADF              PAGEZERO_REBUILD:
 273  FADF AF                   XOR A
 274  FAE0                      ; clear the CCP restart/cold flag at $9307
 275  FAE0 32 07 93             LD ($9307),A
 276  FAE3              PAGEZERO_REBUILD_HOOKS:
 277  FAE3 AF                   XOR A
 278  FAE4                      ; clear a self-modified BIOS state cell ($FEDD)
 279  FAE4 32 DD FE             LD (BOOT_TMPL_IOBYTE),A
 280  FAE7                      ; clear a self-modified BIOS state cell ($FED8)
 281  FAE7 32 D8 FE             LD (DISK_HSTACT),A
 282  FAEA                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 283  FAEA 3E C3                LD A,$C3
 284  FAEC                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 285  FAEC 32 00 00             LD ($0000),A
 286  FAEF                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 287  FAEF 21 03 FA             LD HL,BIOS_VECTOR_WBOOT
 288  FAF2 22 01 00             LD ($0001),HL
 289  FAF5                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 290  FAF5 32 05 00             LD ($0005),A
 291  FAF8                      ; BDOS entry point ($9C06) for the $0005 hook
 292  FAF8 21 06 9C             LD HL,$9C06
 293  FAFB 22 06 00             LD ($0006),HL
 294  FAFE                      ; default DMA address = $0080 (page-zero buffer)
 295  FAFE 01 80 00             LD BC,$0080
 296  FB01                      ; install the default DMA pointer (SETDMA)
 297  FB01 CD F9 FB             CALL SETDMA
 298  FB04              ; ----------------------------------------------------------------------
 299  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, jump to the CCP.
 300  FB04              ;   In:  none.  Out: JP $9300 (CCP cold/warm entry); no return.  Clobbers: A,C.
 301  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $974E, pass the current default
 302  FB04              ;     drive (page-zero $0004) in C, and jump to the CCP at $9300. [RE]
 303  FB04              ; ----------------------------------------------------------------------
 304  FB04              CCP_LAUNCH:
 305  FB04                      ; CCP-mode flag value
 306  FB04 3E 01                LD A,$01
 307  FB06                      ; store the CCP entry/mode flag into CCP workspace at $974E
 308  FB06 32 4E 97             LD ($974E),A
 309  FB09                      ; page-zero $0004 = current default drive byte
 310  FB09 3A 04 00             LD A,($0004)
 311  FB0C 4F                   LD C,A
 312  FB0D                      ; enter the CCP at $9300, C = default drive (2.20 used $9400)
 313  FB0D C3 00 93             JP $9300
 314  FB10              ; ----------------------------------------------------------------------
 315  FB10              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 316  FB10              ;   In:  none.  Out: A = $FF (ready) / $00 (not).  Clobbers: A,HL.
 317  FB10              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 318  FB10              ;     cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler, which
 319  FB10              ;     returns the status in A.  Same as the 2.20 twin's CONST. [RE]
 320  FB10              ; ----------------------------------------------------------------------
 321  FB10              CONST:
 322  FB10                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 323  FB10 2A 80 F3             LD HL,($F380)
 324  FB13                      ; dispatch to the selected console-status handler (returns A)
 325  FB13 E9                   JP (HL)
 326  FB14              ; ----------------------------------------------------------------------
 327  FB14              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 328  FB14              ;   In:  none.  Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 329  FB14              ;   Clobbers: A.
 330  FB14              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard register; RLA shifts bit 7
 331  FB14              ;     (key-ready) into carry; SBC A,A expands carry to $FF/$00.  The built-in 40-col
 332  FB14              ;     CONST path used when no Videx/80-col card supplies the status vector. [RE]
 333  FB14              ; ----------------------------------------------------------------------
 334  FB14              KBD_STATUS_40COL:
 335  FB14                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 336  FB14 3A 00 E0             LD A,($E000)
 337  FB17                      ; rotate key-ready bit 7 into carry
 338  FB17 17                   RLA
 339  FB18                      ; carry -> A = $FF (ready) or $00 (none)
 340  FB18 9F                   SBC A,A
 341  FB19 C9                   RET
 342  FB1A              ; ----------------------------------------------------------------------
 343  FB1A              ; CONIN -- read a console character: IOBYTE-route the input, then remap the key.
 344  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,DE,HL.
 345  FB1A              ;   Algorithm: CALL CONIN_DISPATCH to fetch a raw key (routed by the IOBYTE CONSOLE
 346  FB1A              ;     field); clear the high bit; then scan a small remap table at Apple $03AB
 347  FB1A              ;     (z80 $F3AB) of up to 6 entries (function/arrow keys), returning the paired
 348  FB1A              ;     replacement byte on a match, else the raw key.
 349  FB1A              ;   Note: 2.23's CONIN jump-vector entry runs this remap wrapper; the 2.20 twin's
 350  FB1A              ;     equivalent is CONSOLE_IN_40COL.  Differs from a bare dispatcher. [RE]
 351  FB1A              ; ----------------------------------------------------------------------
 352  FB1A              CONIN:
 353  FB1A                      ; fetch a raw key in A via the IOBYTE-routed CONIN dispatcher
 354  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 355  FB1D                      ; strip the high bit (7-bit ASCII)
 356  FB1D E6 7F                AND $7F
 357  FB1F                      ; HL = key-remap table base (z80 $F3AB = Apple $03AB; first entry pair at $03AC)
 358  FB1F 21 AB F3             LD HL,$F3AB
 359  FB22                      ; up to 6 remap-table entries
 360  FB22 06 06                LD B,$06
 361  FB24                      ; C = raw key
 362  FB24 4F                   LD C,A
 363  FB25              ; ----------------------------------------------------------------------
 364  FB25              ; CONIN_XLATE_LOOP -- scan the function/arrow-key remap table.
 365  FB25              ;   In:  C = raw key; B = entry count; HL -> table base.
 366  FB25              ;   Out: A = translated key on match (returns), else loops; A = C on table end.
 367  FB25              ;   Algorithm: each entry = [match byte, replacement byte]; a high-bit sentinel
 368  FB25              ;     match byte ends the table. [RE]
 369  FB25              ; ----------------------------------------------------------------------
 370  FB25              CONIN_XLATE_LOOP:
 371  FB25 23                   INC HL
 372  FB26                      ; entry's match byte
 373  FB26 7E                   LD A,(HL)
 374  FB27 23                   INC HL
 375  FB28 B7                   OR A
 376  FB29                      ; high-bit sentinel ends the table
 377  FB29 FA 31 FB             JP M,CONIN_XLATE_DONE
 378  FB2C                      ; raw key == this entry?
 379  FB2C B9                   CP C
 380  FB2D                      ; paired replacement byte
 381  FB2D 7E                   LD A,(HL)
 382  FB2E                      ; match -> return the translated key
 383  FB2E C8                   RET Z
 384  FB2F 10 F4                DJNZ CONIN_XLATE_LOOP
 385  FB31              ; ----------------------------------------------------------------------
 386  FB31              ; CONIN_XLATE_DONE -- no remap match: return the raw key in A. [RE]
 387  FB31              ; ----------------------------------------------------------------------
 388  FB31              CONIN_XLATE_DONE:
 389  FB31                      ; no match -> return the raw key
 390  FB31 79                   LD A,C
 391  FB32 C9                   RET
 392  FB33              ; ----------------------------------------------------------------------
 393  FB33              ; CONIN_KEYWAIT -- seed the keyboard-wait dispatch index, then wait for a key.
 394  FB33              ;   In:  none.  Out: A = 7-bit key (via KBD_WAIT_KEY).  Clobbers: A,DE.
 395  FB33              ;   Algorithm: load DE = 3 (the default console index), then JP through the
 396  FB33              ;     self-modified CONIN_DISPATCH cell; at boot that target is patched to the
 397  FB33              ;     selected keyboard-wait handler (default KBD_WAIT_KEY). [RE]
 398  FB33              ; ----------------------------------------------------------------------
 399  FB33              CONIN_KEYWAIT:
 400  FB33                      ; DE = 3 = default console-device index
 401  FB33 11 03 00             LD DE,$0003
 402  FB36              ; ----------------------------------------------------------------------
 403  FB36              ; CONIN_DISPATCH -- self-modified keyboard-wait vector.
 404  FB36              ;   The JP target ($FB39 / KBD_WAIT_KEY by default) is patched at boot per the
 405  FB36              ;   selected console card.  Referenced as CONIN_DISPATCH+1 by the patch site. [RE]
 406  FB36              ; ----------------------------------------------------------------------
 407  FB36              CONIN_DISPATCH:
 408  FB36                      ; target (CONIN_DISPATCH+1) patched at boot to the chosen keyboard-wait handler
 409  FB36 C3 39 FB             JP KBD_WAIT_KEY
 410  FB39              ; ----------------------------------------------------------------------
 411  FB39              ; KBD_WAIT_KEY -- spin on the Apple keyboard register until a key is down.
 412  FB39              ;   In:  none.  Out: A = 7-bit key (high bit cleared).  Clobbers: A.
 413  FB39              ;   Algorithm: poll z80 $E000 = Apple $C000; RLA puts key-ready (bit 7) into carry,
 414  FB39              ;     spin while clear; on a key, clear the strobe at $E010 = Apple $C010 and return
 415  FB39              ;     the 7-bit key (CCF/RRA). [RE]
 416  FB39              ; ----------------------------------------------------------------------
 417  FB39              KBD_WAIT_KEY:
 418  FB39                      ; poll z80 $E000 = Apple $C000 keyboard register
 419  FB39 3A 00 E0             LD A,($E000)
 420  FB3C                      ; key-ready (bit 7) -> carry
 421  FB3C 17                   RLA
 422  FB3D                      ; spin until a key is down
 423  FB3D 30 FA                JR NC,KBD_WAIT_KEY
 424  FB3F                      ; clear the keyboard strobe (z80 $E010 = Apple $C010)
 425  FB3F 32 10 E0             LD ($E010),A
 426  FB42 3F                   CCF
 427  FB43                      ; A = 7-bit key
 428  FB43 1F                   RRA
 429  FB44 C9                   RET
 430  FB45              ; ----------------------------------------------------------------------
 431  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC.
 432  FB45              ;   In:  HL = command/params; A = trigger value.  Out: per the 6502 service routine.
 433  FB45              ;   Algorithm: stash HL to the command mailbox (z80 $F3D0 = Apple $03D0), then poke
 434  FB45              ;     the trigger cell.  The trigger store-address ($0000 here) is self-modified per
 435  FB45              ;     config at boot, so the store site is RPC_TRIGGER_STORE+1. [RE]
 436  FB45              ; ----------------------------------------------------------------------
 437  FB45              RPC_TRIGGER:
 438  FB45                      ; z80 $F3D0 = Apple $03D0 = RPC command/params mailbox
 439  FB45 22 D0 F3             LD ($F3D0),HL
 440  FB48              RPC_TRIGGER_STORE:
 441  FB48 32 00 00             LD ($0000),A
 442  FB4B C9                   RET
 443  FB4C              ; ----------------------------------------------------------------------
 444  FB4C              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE.
 445  FB4C              ;   In:  A = character (the BIOS CONOUT arg).  The jump-vector CONOUT entry targets
 446  FB4C              ;        CONOUT_DISPATCH+1 ($FB4D), skipping the leading LD C,A; the fall-through
 447  FB4C              ;        entry here (from the dispatcher) keeps it.
 448  FB4C              ;   Out: none.  Clobbers: A,C,HL.
 449  FB4C              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03).  Field
 450  FB4C              ;     value 2 dispatches through the SoftCard I/O vector at $F392 (Apple $0392) with
 451  FB4C              ;     JP (HL); otherwise fall into the column/tab filter. [RE]
 452  FB4C              ; ----------------------------------------------------------------------
 453  FB4C              CONOUT_DISPATCH:
 454  FB4C                      ; save the character to emit in C for the filter path (skipped by the +1 entry)
 455  FB4C 4F                   LD C,A
 456  FB4D                      ; read the CP/M IOBYTE (page-zero $0003)
 457  FB4D 3A 03 00             LD A,($0003)
 458  FB50                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 459  FB50 E6 03                AND $03
 460  FB52                      ; device value 2 = direct console; anything else takes the filter path
 461  FB52 FE 02                CP $02
 462  FB54 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 463  FB56              CONOUT_VIA_VEC_F392:
 464  FB56                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 465  FB56 2A 92 F3             LD HL,($F392)
 466  FB59 E9                   JP (HL)
 467  FB5A              ; ----------------------------------------------------------------------
 468  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE CONSOLE field.
 469  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 470  FB5A              ;   Algorithm: read IOBYTE, mask the CONSOLE field (AND $03).  Value 2 uses vector
 471  FB5A              ;     $F38A; the high value ($02<x) uses the preloaded $F384; low values use $F382;
 472  FB5A              ;     then JP (HL) into the chosen handler.  ($F38x = Apple $038x I/O vector.)
 473  FB5A              ;     Called by CONIN (the remap wrapper) and reused by READER. [RE]
 474  FB5A              ; ----------------------------------------------------------------------
 475  FB5A              CONIN_DISPATCH_IOBYTE:
 476  FB5A                      ; read the CP/M IOBYTE
 477  FB5A 3A 03 00             LD A,($0003)
 478  FB5D                      ; isolate the 2-bit CONSOLE device field
 479  FB5D E6 03                AND $03
 480  FB5F FE 02                CP $02
 481  FB61                      ; preload the input vector for the high CONSOLE value ($F384 = Apple $0384)
 482  FB61 2A 84 F3             LD HL,($F384)
 483  FB64 28 06                JR Z,CONIN_VIA_VEC_F38A
 484  FB66 30 07                JR NC,DISPATCH_VIA_HL
 485  FB68              CONIN_VIA_VEC_F382:
 486  FB68                      ; input vector for the low CONSOLE values ($F382 = Apple $0382)
 487  FB68 2A 82 F3             LD HL,($F382)
 488  FB6B E9                   JP (HL)
 489  FB6C              CONIN_VIA_VEC_F38A:
 490  FB6C                      ; input vector for CONSOLE value 2 ($F38A = Apple $038A)
 491  FB6C 2A 8A F3             LD HL,($F38A)
 492  FB6F              DISPATCH_VIA_HL:
 493  FB6F E9                   JP (HL)
 494  FB70              ; ----------------------------------------------------------------------
 495  FB70              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 496  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 497  FB70              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0).  Below $80
 498  FB70              ;     routes to the column/tab filter; == $80 reuses the console vector path
 499  FB70              ;     (CONOUT_VIA_VEC_F392); higher values dispatch through list vector $F394
 500  FB70              ;     (Apple $0394). [RE]
 501  FB70              ; ----------------------------------------------------------------------
 502  FB70              LIST:
 503  FB70 3A 03 00             LD A,($0003)
 504  FB73                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 505  FB73 E6 C0                AND $C0
 506  FB75 FE 80                CP $80
 507  FB77                      ; field < $80 -> no-device / filter path
 508  FB77 38 27                JR C,DISPATCH_NODEV
 509  FB79                      ; field == $80 -> reuse the console output vector path
 510  FB79 28 DB                JR Z,CONOUT_VIA_VEC_F392
 511  FB7B                      ; list-handler vector ($F394 = Apple $0394)
 512  FB7B 2A 94 F3             LD HL,($F394)
 513  FB7E E9                   JP (HL)
 514  FB7F              ; ----------------------------------------------------------------------
 515  FB7F              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 516  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 517  FB7F              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30).  Below $10 takes the
 518  FB7F              ;     column/tab filter; == $10 dispatches through vector $F38E; higher values use
 519  FB7F              ;     vector $F390.  ($F38E/$F390 = Apple $038E/$0390.) [RE]
 520  FB7F              ; ----------------------------------------------------------------------
 521  FB7F              PUNCH:
 522  FB7F 3A 03 00             LD A,($0003)
 523  FB82                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 524  FB82 E6 30                AND $30
 525  FB84 FE 10                CP $10
 526  FB86                      ; field < $10 -> no-device / filter path
 527  FB86 38 18                JR C,DISPATCH_NODEV
 528  FB88                      ; punch vector for the higher PUNCH values ($F38E = Apple $038E)
 529  FB88 2A 8E F3             LD HL,($F38E)
 530  FB8B                      ; field == $10 -> use the $F390 vector below
 531  FB8B 28 E2                JR Z,DISPATCH_VIA_HL
 532  FB8D                      ; punch vector for PUNCH value $10 ($F390 = Apple $0390)
 533  FB8D 2A 90 F3             LD HL,($F390)
 534  FB90 E9                   JP (HL)
 535  FB91              ; ----------------------------------------------------------------------
 536  FB91              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 537  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 538  FB91              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C), compare against $08. Field
 539  FB91              ;     < $08 ($00/$04) reuses the CONIN $F382 vector; == $08 reuses the CONIN $F38A vector;
 540  FB91              ;     > $08 ($0C) uses the reader vector $F38C (Apple $038C). [RE]
 541  FB91              ; ----------------------------------------------------------------------
 542  FB91              READER:
 543  FB91 3A 03 00             LD A,($0003)
 544  FB94                      ; isolate the 2-bit READER device field of the IOBYTE
 545  FB94 E6 0C                AND $0C
 546  FB96 FE 08                CP $08
 547  FB98                      ; field < $08 ($00/$04) -> reuse the CONIN $F382 vector path
 548  FB98 38 CE                JR C,CONIN_VIA_VEC_F382
 549  FB9A                      ; field == $08 -> reuse the CONIN $F38A vector path
 550  FB9A 28 D0                JR Z,CONIN_VIA_VEC_F38A
 551  FB9C                      ; reader-handler vector ($F38C = Apple $038C)
 552  FB9C 2A 8C F3             LD HL,($F38C)
 553  FB9F E9                   JP (HL)
 554  FBA0              ; ----------------------------------------------------------------------
 555  FBA0              ; DISPATCH_NODEV -- IOBYTE field selects no physical device: fall into the filter.
 556  FBA0              ;   In:  carry set by the caller (no-device).  Out: enters CONOUT_FILTER_NOEXPAND
 557  FBA0              ;        with the carry folded into the COL_FLAG byte.  Clobbers: A,HL.
 558  FBA0              ;   Algorithm: SCF then (CONOUT_FILTER_NOEXPAND) SBC A,A turns carry into a 0/$FF
 559  FBA0              ;     flag stored in COL_FLAG ($FECB); clear bit 7 of the char in C; if the pending-
 560  FBA0              ;     column counter ($FECC) is nonzero, apply a config-driven column offset, else
 561  FBA0              ;     fall through to the tab/control expansion (SETDMA_1). [RE]
 562  FBA0              ; ----------------------------------------------------------------------
 563  FBA0              DISPATCH_NODEV:
 564  FBA0                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 565  FBA0 37                   SCF
 566  FBA1              CONOUT_FILTER_NOEXPAND:
 567  FBA1                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 568  FBA1 9F                   SBC A,A
 569  FBA2 21 A2 F3             LD HL,$F3A2
 570  FBA5 6E                   LD L,(HL)
 571  FBA6 2C                   INC L
 572  FBA7 CA A4 FC             JP Z,SCREEN_EMIT
 573  FBAA                      ; HL -> COL_FLAG cell ($FECB)
 574  FBAA 21 CB FE             LD HL,COL_FLAG
 575  FBAD                      ; store the entry flag into COL_FLAG
 576  FBAD 77                   LD (HL),A
 577  FBAE                      ; strip the high bit of the character (7-bit ASCII)
 578  FBAE CB B9                RES 7,C
 579  FBB0 23                   INC HL
 580  FBB1                      ; load COL_PENDING (pending column-skip / fill count, $FECC)
 581  FBB1 7E                   LD A,(HL)
 582  FBB2 B7                   OR A
 583  FBB3                      ; no pending column work -> run tab/control expansion
 584  FBB3 CA 56 FC             JP Z,SETDMA_1
 585  FBB6                      ; consume one pending column step
 586  FBB6 35                   DEC (HL)
 587  FBB7                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 588  FBB7 3A 96 F3             LD A,($F396)
 589  FBBA                      ; HL -> the column cell in the $FE85 deblock/screen-state band ($FED4)
 590  FBBA 21 D4 FE             LD HL,BOOT_TMPL_XORA
 591  FBBD                      ; config byte zero -> derive the offset from the running width
 592  FBBD 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 593  FBBF B7                   OR A
 594  FBC0 F2 C6 FB             JP P,COL_APPLY_OFFSET_RAW
 595  FBC3 2B                   DEC HL
 596  FBC4              ; ----------------------------------------------------------------------
 597  FBC4              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 598  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 599  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 600  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude, subtract it from the
 601  FBC4              ;     current column in C, store the new column.  Reached when the config byte's sign
 602  FBC4              ;     indicates a subtractive column adjust. [RE]
 603  FBC4              ; ----------------------------------------------------------------------
 604  FBC4              COL_APPLY_OFFSET:
 605  FBC4                      ; drop the sign bit to get the offset magnitude
 606  FBC4 E6 7F                AND $7F
 607  FBC6              COL_APPLY_OFFSET_RAW:
 608  FBC6 5F                   LD E,A
 609  FBC7 79                   LD A,C
 610  FBC8                      ; new column = current column (C) minus the offset
 611  FBC8 93                   SUB E
 612  FBC9                      ; store the updated column position
 613  FBC9 77                   LD (HL),A
 614  FBCA C9                   RET
 615  FBCB              ; ----------------------------------------------------------------------
 616  FBCB              ; COL_OFFSET_FROM_WIDTH -- derive the column offset from the running screen width.
 617  FBCB              ;   In:  C = current column; the BOOT-overlaid base word at (BOOT+2).
 618  FBCB              ;   Out: updates the column and emits via SCREEN_EMIT; combines a base address with
 619  FBCB              ;        the offset.  Clobbers: A,B,C,DE,HL.
 620  FBCB              ;   Algorithm: pick the column cell by the config sign, CALL COL_APPLY_OFFSET, then
 621  FBCB              ;     load the base word (BOOT+2 = the cold-boot operand reused as deblock
 622  FBCB              ;     scratch), fold in config $F3A1, and ADD to form the screen address before
 623  FBCB              ;     emitting (SCREEN_EMIT). [RE]
 624  FBCB              ; ----------------------------------------------------------------------
 625  FBCB              COL_OFFSET_FROM_WIDTH:
 626  FBCB B7                   OR A
 627  FBCC                      ; config sign negative -> keep the higher column cell
 628  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH_1
 629  FBCF 2B                   DEC HL
 630  FBD0              COL_OFFSET_FROM_WIDTH_1:
 631  FBD0                      ; apply the signed column offset (COL_APPLY_OFFSET)
 632  FBD0 CD C4 FB             CALL COL_APPLY_OFFSET
 633  FBD3                      ; base word = the BOOT-overlaid deblock scratch ($FED3)
 634  FBD3 2A D3 FE             LD HL,(BOOT+2)
 635  FBD6                      ; config byte $F3A1 = Apple $03A1 (screen-base modifier)
 636  FBD6 3A A1 F3             LD A,($F3A1)
 637  FBD9 B7                   OR A
 638  FBDA                      ; config positive -> use HL as-is, skip the byte swap
 639  FBDA F2 E2 FB             JP P,COL_COMBINE_BASE
 640  FBDD                      ; negative: drop the sign bit, then swap H<->L below
 641  FBDD E6 7F                AND $7F
 642  FBDF 5D                   LD E,L
 643  FBE0 6C                   LD L,H
 644  FBE1 63                   LD H,E
 645  FBE2              ; ----------------------------------------------------------------------
 646  FBE2              ; COL_COMBINE_BASE -- fold the config offset into the base address, emit the char.
 647  FBE2              ;   In:  A = config offset; HL = base word; C will receive the high result.
 648  FBE2              ;   Out: pushes the low result, emits via SCREEN_EMIT with B=7, then re-enters the
 649  FBE2              ;        emit path with B=$0A.  Clobbers: A,B,C,DE,HL.
 650  FBE2              ;   Algorithm: C = offset + H; A = offset + L; CALL SCREEN_EMIT (B=7), then fall into
 651  FBE2              ;     CONOUT_EMIT_B with B=$0A. [RE]
 652  FBE2              ; ----------------------------------------------------------------------
 653  FBE2              COL_COMBINE_BASE:
 654  FBE2 5F                   LD E,A
 655  FBE3                      ; C = config offset + base high byte
 656  FBE3 84                   ADD A,H
 657  FBE4 4F                   LD C,A
 658  FBE5 7B                   LD A,E
 659  FBE6                      ; A = config offset + base low byte
 660  FBE6 85                   ADD A,L
 661  FBE7 F5                   PUSH AF
 662  FBE8                      ; mode/count code 7 for the screen emit
 663  FBE8 06 07                LD B,$07
 664  FBEA                      ; emit via the screen handler (SCREEN_EMIT)
 665  FBEA CD A4 FC             CALL SCREEN_EMIT
 666  FBED F1                   POP AF
 667  FBEE                      ; mode/count code $0A for the follow-up emit
 668  FBEE 06 0A                LD B,$0A
 669  FBF0              CHAR_C_TO_SCREEN:
 670  FBF0 4F                   LD C,A
 671  FBF1 C3 A4 FC             JP SCREEN_EMIT
 672  FBF4              ; ----------------------------------------------------------------------
 673  FBF4              ; SETSEC -- BIOS jump-vector entry 11 ($FA24 -> $FBF4): set the requested sector.
 674  FBF4              ;   In:  C = sector number. Out: none. Clobbers: A.
 675  FBF4              ;   Algorithm: store C into the sector cell BOOT+1 ($FED2 = the cold-boot LD SP operand
 676  FBF4              ;        low byte, reused post-boot as the requested-sector cell). The off-image RWTS
 677  FBF4              ;        ($AC39/$AC49) is the consumer; this image only WRITES it. Mirrors 2.20 SETSEC.
 678  FBF4              ;        [RE, transferred from 2.20; the off-image consumer is not in this image]
 679  FBF4              ; ----------------------------------------------------------------------
 680  FBF4              SETSEC:
 681  FBF4 79                   LD A,C
 682  FBF5                      ; store the requested sector into BOOT+1 (reused as the seksec cell)
 683  FBF5 32 D2 FE             LD (BOOT+1),A
 684  FBF8 C9                   RET
 685  FBF9              ; ----------------------------------------------------------------------
 686  FBF9              ; SETDMA -- BIOS jump-vector entry 12 ($FA27 -> $FBF9): set the DMA address.
 687  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 688  FBF9              ;   Out: none. Clobbers: none.
 689  FBF9              ;   Algorithm: store BC into the dmaadr cell (SECTOR_BLOCK_PATCH+2 = $FEE1, the
 690  FBF9              ;        operand region of the install-template 'LD ($0003),A'). The OFF-IMAGE
 691  FBF9              ;        deblock copy uses dmaadr as the host<->record transfer endpoint. The 2.20
 692  FBF9              ;        deblock did the LDIR itself; in 2.23 the value is read off-image. [RE]
 693  FBF9              ; ----------------------------------------------------------------------
 694  FBF9              SETDMA:
 695  FBF9                      ; store BC into dmaadr ($FEE1, overlaid on the install-template LD ($0003),A operand)
 696  FBF9 ED 43 E1 FE          LD (DISK_DMAADR+2),BC
 697  FBFD C9                   RET
 698  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 699  FC56              SETDMA_1:
 700  FC56 47                   LD B,A
 701  FC57 21 CD FE             LD HL,COL_STATE
 702  FC5A 7E                   LD A,(HL)
 703  FC5B 5F                   LD E,A
 704  FC5C B7                   OR A
 705  FC5D 20 12                JR NZ,SETDMA_3
 706  FC5F 3A 97 F3             LD A,($F397)
 707  FC62 B7                   OR A
 708  FC63 28 06                JR Z,SETDMA_2
 709  FC65 B9                   CP C
 710  FC66 20 03                JR NZ,SETDMA_2
 711  FC68 36 80                LD (HL),$80
 712  FC6A C9                   RET
 713  FC6B              SETDMA_2:
 714  FC6B 3E 1F                LD A,$1F
 715  FC6D B9                   CP C
 716  FC6E DA A4 FC             JP C,SCREEN_EMIT
 717  FC71              SETDMA_3:
 718  FC71 21 A0 F3             LD HL,$F3A0
 719  FC74 06 09                LD B,$09
 720  FC76              SETDMA_4:
 721  FC76 7E                   LD A,(HL)
 722  FC77 B7                   OR A
 723  FC78 28 04                JR Z,SETDMA_5
 724  FC7A AB                   XOR E
 725  FC7B B9                   CP C
 726  FC7C 28 05                JR Z,SETDMA_6
 727  FC7E              SETDMA_5:
 728  FC7E 2B                   DEC HL
 729  FC7F 10 F5                DJNZ SETDMA_4
 730  FC81 18 21                JR SCREEN_EMIT
 731  FC83              SETDMA_6:
 732  FC83 11 0B 00             LD DE,$000B
 733  FC86 19                   ADD HL,DE
 734  FC87 7E                   LD A,(HL)
 735  FC88 B7                   OR A

# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.23 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 2.23-44K BIOS runs at z80 $FA00-$FFFF (6 pages) = Apple $0A00-$0FFF LOW RAM
   5  0000              ; (NOT $AA00 like 2.20 -- a different mechanism). Decoded against the de-skewed
   6  0000              ; runtime image; the disk producer re-applies the sector skew (deskew.py ::
   7  0000              ; BIOS_PAGE_TO_SECTOR_223). $FA00 = the 15-entry BIOS jump vector.
   8  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
   9  0000              ; being enriched to the C-level bar.
  10  0000              ; ============================================================================
  11  0000
  12  0000                  IFNDEF CPM_LINK
  13  0000                  DEVICE NOSLOT64K
  14  0000                  INCLUDE "cpm22.inc"          ; CP/M 2.2 ABI + the DPB_LAYOUT / DPH_LAYOUT structures
# file opened: cpm22.inc
   1+ 0000              ; cpm22.inc -- canonical Digital Research CP/M 2.2 definitions shared by SoftCard
   2+ 0000              ; CP/M sources.  Defined ONCE here and INCLUDEd by each source rather than re-deriving
   3+ 0000              ; magic numbers per file.  EQUs are zero-width, so including this is byte-identical.
   4+ 0000              ; This is the OS/ABI counterpart to apple_softcard.inc (which holds the Apple/SoftCard
   5+ 0000              ; HARDWARE externals); keep the two concerns separate.
   6+ 0000              ;
   7+ 0000              ; Source: CP/M 2.2 Interface Guide / "CP/M Reference Manual" [DOC CPMREF] (in the
   8+ 0000              ; archive at softcard/reference/softcard-cpm-archive/manuals/transcribed/).
   9+ 0000              ;
  10+ 0000              ; NOTE on the base page: $0000 (warm-boot JP) and $0005 (BDOS JP) are implementation
  11+ 0000              ; LABELS inside the BIOS/CCP/BDOS modules but CALL TARGETS in transient programs.  The
  12+ 0000              ; cell EQUs below are for the transient-program (caller) view; an OS module that DEFINES
  13+ 0000              ; these vectors as its own labels should not also pull in this base-page section.
  14+ 0000
  15+ 0000              ; ---- base page (transient-program view) ----------------------------------------
  16+ 0000                  IFNDEF CPM22_INC
  17+ 0000                  DEFINE CPM22_INC
  18+ 0000
  19+ 0000              WBOOTV      EQU $0000      ; warm-boot vector: JP WBOOT (a CALL/JP $0000 restarts CP/M)
  20+ 0000              IOBYTE_ADDR EQU $0003      ; [DOC S&HD 2-18] logical<->physical device map: four 2-bit
  21+ 0000                                         ;   fields, CONSOLE (0-1), READER (2-3), PUNCH (4-5), LIST
  22+ 0000                                         ;   (6-7); set via STAT or BDOS fns 7/8. Each field selects
  23+ 0000                                         ;   which I/O Vector Table entry (#1 or #2) is used.
  24+ 0000              CDISK_ADDR  EQU $0004      ; current drive (low nibble) / user (high nibble)
  25+ 0000              BDOS        EQU $0005      ; BDOS entry vector: CALL BDOS with C=function, DE=arg
  26+ 0000              RST2_VEC    EQU $0010      ; Z-80 RST 2 ($10) restart vector (8 bytes); CP/M leaves it for the app/debugger
  27+ 0000              RST4_VEC    EQU $0020      ; Z-80 RST 4 ($20) restart vector (8 bytes); CP/M leaves it for the app/debugger
  28+ 0000              TFCB        EQU $005C      ; default FCB parsed from the command tail
  29+ 0000              TFCB2       EQU $006C      ; second parsed FCB (overlaps TFCB+16)
  30+ 0000              TBUFF       EQU $0080      ; default DMA buffer (128 B); also the command-tail buffer
  31+ 0000              CMDLINE     EQU $0081      ; command-tail characters (TBUFF+1): $0080 = length, $0081+ = the upper-cased tail
  32+ 0000              TPA         EQU $0100      ; transient program area / load address
  33+ 0000
  34+ 0000              ; ---- BDOS function numbers (register C) ----------------------------------------
  35+ 0000              P_TERMCPM   EQU 0          ; system reset (return to CCP)
  36+ 0000              C_READ      EQU 1          ; console input (echoed) -> A
  37+ 0000              C_WRITE     EQU 2          ; console output (E = char)
  38+ 0000              A_READ      EQU 3          ; reader (AUX) input -> A
  39+ 0000              A_WRITE     EQU 4          ; punch (AUX) output (E = char)
  40+ 0000              L_WRITE     EQU 5          ; list (printer) output (E = char)
  41+ 0000              C_RAWIO     EQU 6          ; direct console I/O (E=$FF read / else write)
  42+ 0000              A_STATIN    EQU 7          ; get IOBYTE -> A
  43+ 0000              A_STATOUT   EQU 8          ; set IOBYTE (E = value)
  44+ 0000              C_WRITESTR  EQU 9          ; print '$'-terminated string (DE -> string)
  45+ 0000              C_READSTR   EQU 10         ; buffered console line input (DE -> buffer)
  46+ 0000              C_STAT      EQU 11         ; console status -> A (0 = none ready)
  47+ 0000              S_BDOSVER   EQU 12         ; return BDOS version -> HL
  48+ 0000              DRV_ALLRESET EQU 13        ; reset disk system
  49+ 0000              DRV_SET     EQU 14         ; select drive (E = 0=A..15=P)
  50+ 0000              F_OPEN      EQU 15         ; open file (DE -> FCB)
  51+ 0000              F_CLOSE     EQU 16         ; close file (DE -> FCB)
  52+ 0000              F_SFIRST    EQU 17         ; search for first (DE -> FCB)
  53+ 0000              F_SNEXT     EQU 18         ; search for next
  54+ 0000              F_DELETE    EQU 19         ; delete file (DE -> FCB)
  55+ 0000              F_READ      EQU 20         ; read sequential (DE -> FCB)
  56+ 0000              F_WRITE     EQU 21         ; write sequential (DE -> FCB)
  57+ 0000              F_MAKE      EQU 22         ; create file (DE -> FCB)
  58+ 0000              F_RENAME    EQU 23         ; rename file (DE -> FCB)
  59+ 0000              DRV_LOGINVEC EQU 24        ; return login vector -> HL
  60+ 0000              DRV_GET     EQU 25         ; return current drive -> A
  61+ 0000              F_DMAOFF    EQU 26         ; set DMA address (DE)
  62+ 0000              DRV_ALLOCVEC EQU 27        ; return allocation vector -> HL
  63+ 0000              DRV_SETRO   EQU 28         ; write-protect current drive
  64+ 0000              DRV_ROVEC   EQU 29         ; return read-only vector -> HL
  65+ 0000              F_ATTRIB    EQU 30         ; set file attributes (DE -> FCB)
  66+ 0000              DRV_DPB     EQU 31         ; return DPB address -> HL
  67+ 0000              F_USERNUM   EQU 32         ; get/set user number (E=$FF get / else set)
  68+ 0000              F_READRAND  EQU 33         ; read random (DE -> FCB)
  69+ 0000              F_WRITERAND EQU 34         ; write random (DE -> FCB)
  70+ 0000              F_SIZE      EQU 35         ; compute file size (DE -> FCB)
  71+ 0000              F_RANDREC   EQU 36         ; set random record (DE -> FCB)
  72+ 0000              DRV_RESET   EQU 37         ; reset drives (DE = drive vector)
  73+ 0000              F_WRITEZF   EQU 40         ; write random with zero fill (DE -> FCB)
  74+ 0000
  75+ 0000              ; ---- FCB field offsets (from the start of a 36-byte FCB) ------------------------
  76+ 0000              ; ---------------------------------------------------------------------------
  77+ 0000              ; CP/M 2.2 on-disk / in-memory STRUCTURES.
  78+ 0000              ;
  79+ 0000              ; These replace the flat FCB_* offset EQUs that used to live here. A structure
  80+ 0000              ; gives the field a NAME at the use site instead of a bare number, and it lets a
  81+ 0000              ; step between two fields be written as arithmetic on the names, which a magic
  82+ 0000              ; number cannot be checked against. That is the same rule the repo already
  83+ 0000              ; applies to code sizes (a size is label-after minus label-on-first-byte).
  84+ 0000              ;
  85+ 0000              ; It is not cosmetic. Every structure below had a field mislabelled in the
  86+ 0000              ; sources at some point, and each time the cause was the same: the operand was a
  87+ 0000              ; bare number, so nothing contradicted a wrong comment. FCB offset 12 was called
  88+ 0000              ; "the current-record byte" at twelve sites across two trees; the DPB byte the
  89+ 0000              ; deblock tests was called a "deblock flag"; the DPH word holding the DPB pointer
  90+ 0000              ; was reached by an unnamed +10.
  91+ 0000              ;
  92+ 0000              ; A DIRECTORY ENTRY and an FCB are the same 32 bytes, with the FCB adding four.
  93+ 0000              ; The STRUCT carries the spelled-out name and the FIELDS keep their CP/M manual names.
  94+ 0000              ; EX and RC and AL only ever looked opaque because they sat on a bare number; read as
  95+ 0000              ; FCB.DIRECTORY_ENTRY.EX the path supplies the context the abbreviation assumes:
  96+ 0000              ;
  97+ 0000              ;      0                              31 32   33 34 35
  98+ 0000              ;     +--------------------------------+-----+--------+
  99+ 0000              ;     |      DIRECTORY_ENTRY (32)      | CR  | R0 R1 R2|
 100+ 0000              ;     +--------------------------------+-----+--------+
 101+ 0000              ;     |<---------- FCB (36) ---------------------------->|
 102+ 0000              ;
 103+ 0000              ; So reach a shared field through the structure you actually hold:
 104+ 0000              ;   holding an FCB          ->  FCB.DIRECTORY_ENTRY.EX
 105+ 0000              ;   holding a directory     ->  DIRECTORY_ENTRY.EX           (e.g. in DIRBUF)
 106+ 0000              ; Both are 12. The difference is that the NAME states which one the code has,
 107+ 0000              ; and that distinction is real: ALLOC_FROM_FCB, despite its name, walks a
 108+ 0000              ; DIRECTORY ENTRY out of DIRBUF, not a user FCB.
 109+ 0000              ; ---------------------------------------------------------------------------
 110+ 0000                  STRUCT DIRECTORY_ENTRY
 111+ 0000 ~            ST      BYTE           ; 0   status. In a DIRECTORY entry this is the user number
 112+ 0000 ~                                   ;     (0..31), or $E5 for a free/deleted slot. In an FCB the
 113+ 0000 ~                                   ;     same byte is DRI's DR, the drive code (0 = default,
 114+ 0000 ~                                   ;     1..16 = A..P). One byte, two meanings, and which one
 115+ 0000 ~                                   ;     applies is exactly what the struct path now states.
 116+ 0000 ~            FN      BLOCK 8        ; 1   filename, space-padded
 117+ 0000 ~            FT      BLOCK 3        ; 9   filetype; high bits flag R/O, SYS, archive
 118+ 0000 ~            EX      BYTE           ; 12  extent number, LOW 5 BITS ONLY. The extent is a PAIR:
 119+ 0000 ~                                   ;     EX + 32*S2. This is NOT the current record; that is CR
 120+ 0000 ~                                   ;     at offset 32, and it is 7 bits (0..127).
 121+ 0000 ~            S1      BYTE           ; 13  reserved
 122+ 0000 ~            S2      BYTE           ; 14  extent number, high bits (see EX)
 123+ 0000 ~            RC      BYTE           ; 15  records in the current extent (0..128)
 124+ 0000 ~            AL      BLOCK 16       ; 16  allocation map: 16 block bytes, or 8 block WORDS when
 125+ 0000 ~                                   ;     DSM > 255 (see BLOCK_WIDTH_FLAG)
 126+ 0000                  ENDS               ; = 32
 127+ 0000
 128+ 0000                  STRUCT FCB
 129+ 0000 ~            DIRECTORY_ENTRY  DIRECTORY_ENTRY  ; 0  the directory-entry image, byte for byte
 130+ 0000 ~            CR      BYTE           ; 32  current record within the extent (0..127)
 131+ 0000 ~            R0      BYTE           ; 33  random record number, low byte
 132+ 0000 ~            R1      BYTE           ; 34  random record number, middle byte
 133+ 0000 ~            R2      BYTE           ; 35  random record number, high byte (overflow)
 134+ 0000                  ENDS               ; = 36
 135+ 0000
 136+ 0000                  ASSERT DIRECTORY_ENTRY == 32                  ; a directory entry is 32 bytes
 137+ 0000                  ASSERT FCB.CR == DIRECTORY_ENTRY              ; CR begins where the entry ends
 138+ 0000                  ASSERT FCB == DIRECTORY_ENTRY + 4
 139+ 0000                  ASSERT FCB.DIRECTORY_ENTRY.EX == DIRECTORY_ENTRY.EX
 140+ 0000
 141+ 0000              ; Disk Parameter Block, the 15 bytes the BIOS hands the BDOS per drive.
 142+ 0000              ; NAMED *_LAYOUT because the OS sources already use DPB, DPH_TABLE, SPT, DSM and OFF as
 143+ 0000              ; INSTANCE labels for the real data block in CPM_BIOS.asm. This is the TYPE, not the instance.
 144+ 0000                  STRUCT DPB_LAYOUT
 145+ 0000 ~            SPT     WORD           ; 0   128-byte RECORDS per track, not 256-byte sectors
 146+ 0000 ~            BSH     BYTE           ; 2   block shift: log2(records per block)
 147+ 0000 ~            BLM     BYTE           ; 3   block mask: (records per block) - 1
 148+ 0000 ~            EXM     BYTE           ; 4   extent mask
 149+ 0000 ~            DSM     WORD           ; 5   highest allocation block number
 150+ 0000 ~            DRM     WORD           ; 7   highest directory entry number
 151+ 0000 ~            AL0     BYTE           ; 9   directory-reserved block bitmap, high byte
 152+ 0000 ~            AL1     BYTE           ; 10  ditto, low byte
 153+ 0000 ~            CKS     WORD           ; 11  directory checksum vector size
 154+ 0000 ~            OFF     WORD           ; 13  reserved tracks before the file area
 155+ 0000                  ENDS               ; = 15
 156+ 0000
 157+ 0000                  ASSERT DPB_LAYOUT.DSM == 5     ; SELDSK reaches the DSM byte with a bare +5
 158+ 0000                  ASSERT DPB_LAYOUT == 15
 159+ 0000
 160+ 0000              ; Disk Parameter Header, one per drive, 16 bytes.
 161+ 0000                  STRUCT DPH_LAYOUT
 162+ 0000 ~            XLT     WORD           ; 0   sector-translate table, or 0 for none
 163+ 0000 ~            SCRATCH BLOCK 6        ; 2   three scratch words the BDOS owns
 164+ 0000 ~            DIRBUF  WORD           ; 8   -> the 128-byte directory buffer (one per system)
 165+ 0000 ~            DPB     WORD           ; 10  -> this drive's DPB
 166+ 0000 ~            CSV     WORD           ; 12  -> directory checksum vector
 167+ 0000 ~            ALV     WORD           ; 14  -> allocation vector
 168+ 0000                  ENDS               ; = 16
 169+ 0000
 170+ 0000                  ASSERT DPH_LAYOUT.DPB == 10    ; SELDSK reaches the DPB pointer with a bare +10
 171+ 0000                  ASSERT DPH_LAYOUT == 16
 172+ 0000
 173+ 0000
 174+ 0000                  ENDIF
 175+ 0000
# file closed: cpm22.inc
  15  0000                  ORG $FA00
  16  FA00                  ENDIF
  17  FA00
  18  FA00              ; ----------------------------------------------------------------------
  19  FA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector (2.23-44K, runtime $FA00).
  20  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  21  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  22  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  23  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  24  FA00              ;   Note: the CONOUT target ($FB4D) is the second-instruction entry of
  25  FA00              ;         CONOUT_DISPATCH (skips its leading LD C,A); see flags. [RE]
  26  FA00              ; ----------------------------------------------------------------------
  27  FA00              BIOS_VECTOR:
  28  FA00                      ; entry 0 = cold boot (BOOT, lives in the $FE85 band, out of this scope)
  29  FA00 C3 D1 FE             JP BOOT
  30  FA03              ; ----------------------------------------------------------------------
  31  FA03              ; BIOS_VECTOR_WBOOT -- jump-table entries 1..14 (WBOOT .. WRITE).
  32  FA03              ;   Same 14-entry layout as the 2.20-44K twin; only the target addresses move
  33  FA03              ;   ($FA-band, not $AA). CONOUT ($FA0C) targets CONOUT_DISPATCH+1 ($FB4D). [RE]
  34  FA03              ; ----------------------------------------------------------------------
  35  FA03              BIOS_VECTOR_WBOOT:
  36  FA03                      ; jump table
  37  FA03                      ; entry 1 = WBOOT: reload CCP, rebuild page zero
  38  FA03 C3 B8 FA             JP      WBOOT
  39  FA06                      ; entry 2 = CONST: console status via IOBYTE
  40  FA06 C3 10 FB             JP      CONST
  41  FA09                      ; entry 3 = CONIN: dispatch + function/arrow remap
  42  FA09 C3 1A FB             JP      CONIN
  43  FA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  44  FA0C C3 4D FB             JP      $FB4D
  45  FA0F                      ; entry 5 = LIST: route by IOBYTE LIST field
  46  FA0F C3 70 FB             JP      LIST
  47  FA12                      ; entry 6 = PUNCH: route by IOBYTE PUNCH field
  48  FA12 C3 7F FB             JP      PUNCH
  49  FA15                      ; entry 7 = READER: route by IOBYTE READER field
  50  FA15 C3 91 FB             JP      READER
  51  FA18                      ; entry 8 = HOME (out of this scope, $FDB0 band)
  52  FA18 C3 6C FE             JP      HOME
  53  FA1B                      ; entry 9 = SELDSK (out of this scope, $FE85 band)
  54  FA1B C3 8E FE             JP      SELDSK
  55  FA1E                      ; entry 10 = SETTRK (out of this scope, $FE77)
  56  FA1E C3 77 FE             JP      $FE77
  57  FA21                      ; entry 11 = SETSEC: store sector into deblock scratch
  58  FA21 C3 F4 FB             JP      SETSEC
  59  FA24                      ; entry 12 = SETDMA: store DMA address into deblock scratch
  60  FA24 C3 F9 FB             JP      SETDMA
  61  FA27                      ; entry 13 = READ (out of this scope, $FE85 band)
  62  FA27 C3 BD FE             JP      READ
  63  FA2A                      ; entry 14 = WRITE (out of this scope, $FE85 band)
  64  FA2A C3 C0 FE             JP      WRITE
  65  FA2D              ; ----------------------------------------------------------------------
  66  FA2D              ; The last two jump-table slots are not JPs: both handlers are short enough to sit
  67  FA2D              ; INLINE in the table, which is legal because nothing after entry 16 needs a fixed
  68  FA2D              ; offset. They used to be dumped here as an opaque DEFB run described as a
  69  FA2D              ; "post-vector trailer ... not reached as code here", which was wrong twice over:
  70  FA2D              ; the BDOS reaches both through the jump table, and the bytes are ordinary Z-80. [RE]
  71  FA2D              ; ----------------------------------------------------------------------
  72  FA2D              ; LISTST -- entry 15: return the list device's ready status.
  73  FA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
  74  FA2D              ;   Algorithm: XOR A / RET. A is $00 whatever the printer is doing. Under the
  75  FA2D              ;     CP/M 2.2 convention $00 means NOT ready and $FF means ready, so this
  76  FA2D              ;     reports "not ready" unconditionally.
  77  FA2D              ;     That is the whole of what these two bytes support. WHO consults LISTST, and
  78  FA2D              ;     what they do with the answer, is NOT determinable from this image, and the
  79  FA2D              ;     SoftCard manual set in softcard/reference/ does not document LISTST at all
  80  FA2D              ;     -- so no claim is made here about callers or about anything blocking. Same two bytes in the 2.20-44K and 2.23-60K twins. [RE]
  81  FA2D              ; ----------------------------------------------------------------------
  82  FA2D              LISTST:
  83  FA2D AF                   XOR A
  84  FA2E C9                   RET
  85  FA2F 00                   DEFB    $00                      ; pad: realigns SECTRAN onto the 3-byte slot grid
  86  FA30              ; ----------------------------------------------------------------------
  87  FA30              ; SECTRAN -- entry 16: logical-to-physical sector translate (identity).
  88  FA30              ;   In:  BC = logical sector, DE = translate-table address (ignored).
  89  FA30              ;   Out: HL = BC (physical == logical).  Clobbers: H, L.
  90  FA30              ;   Algorithm: LD H,B / LD L,C / RET. The DPH XLT field is 0 for every drive, so the
  91  FA30              ;     BDOS asks for no translation and this returns its argument unchanged; the skew
  92  FA30              ;     is applied by the disk producer, off-image. Same three bytes in both twins. [RE]
  93  FA30              ; ----------------------------------------------------------------------
  94  FA30              SECTRAN:
  95  FA30 60                   LD H,B
  96  FA31 69                   LD L,C
  97  FA32 C9                   RET
  98  FA33              ; ----------------------------------------------------------------------
  99  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
 100  FA33              ;   drive 0..3; 2.23 supports 4 drives, vs 6 in the 2.20 twin). SELDSK returns
 101  FA33              ;   DPH_TABLE + 16*drive. Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV,
 102  FA33              ;   ALV. XLT = 0 (no SECTRAN translate). All drives share one DIRBUF and one DPB.
 103  FA33              ;   The per-drive strides are the DPB's own fields: CSV is CKS = 12 bytes, ALV is
 104  FA33              ;   DSM/8 + 1 = 139/8 + 1 = 18 bytes. [RE]
 105  FA33              ; ----------------------------------------------------------------------
 106  FA33              ; DIRBUF, ALV_VECTORS and CSV_VECTORS are the BDOS scratch buffers this table hands out.
 107  FA33              ; They are declared at the foot of this file (see "BDOS scratch overlay"), because they
 108  FA33              ; are a SECOND tenant of bytes the cold-boot code owns: the layout is set out there with
 109  FA33              ; its own ORG, so each field is a real label rather than a magic address.
 110  FA33              DPH_TABLE:
 111  FA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
 111  FA37 00 00 00 00
 111  FA3B E4 FE 73 FA
 111  FA3F AC FF 64 FF
 112  FA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+18   ; drive 1
 112  FA47 00 00 00 00
 112  FA4B E4 FE 73 FA
 112  FA4F B8 FF 76 FF
 113  FA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+36   ; drive 2
 113  FA57 00 00 00 00
 113  FA5B E4 FE 73 FA
 113  FA5F C4 FF 88 FF
 114  FA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+54   ; drive 3
 114  FA67 00 00 00 00
 114  FA6B E4 FE 73 FA
 114  FA6F D0 FF 9A FF
 115  FA73              ; ----------------------------------------------------------------------
 116  FA73              ; DPB -- the shared Disk Parameter Block (5.25" floppy; every DPH points here).
 117  FA73              ;   One label per field, so the field names are symbols rather than prose. The ten names
 118  FA73              ;   are Digital Research's CP/M 2.2 DPB field names. Not [DOC]-citable from THIS archive
 119  FA73              ;   -- the SoftCard set bundles DRI's CP/M 2.2 *Reference Manual*, which documents only
 120  FA73              ;   the BDOS call that RETURNS a DPB pointer (fn 31, Get Addr (disk parms)), not the
 121  FA73              ;   block's layout. The layout IS normatively specified by a DRI manual not in the box:
 122  FA73              ;   the CP/M 2.2 *Alteration Guide* (1979), sec. Disk Parameter Tables. SoftCard CP/M is
 123  FA73              ;   licensed DRI CP/M 2.2, so that manual governs this block. [DOC CPMAG "Disk Parameter
 124  FA73              ;   Tables"]  NOTE: the Guide defines every field but NEVER spells the acronyms out; the
 125  FA73              ;   expansions in the comments below are the conventional readings, not DRI's. [?]
 126  FA73              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 127  FA73              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track. [RE]
 128  FA73              ;   This block is byte-identical to the 2.20-44K twin's except for DSM (see below). [RE]
 129  FA73              ; ----------------------------------------------------------------------
 130  FA73              DPB:
 131  FA73 20 00        SPT:    DEFW    $0020                    ; Sectors Per Track: counts 128-byte RECORDS, not 256-byte sectors -> 32
 132  FA75 03           BSH:    DEFB    $03                      ; Block SHift: log2(records per block) -> 8 records
 133  FA76 07           BLM:    DEFB    $07                      ; BLock Mask: (records per block) - 1 -> 1 KB blocks
 134  FA77 00           EXM:    DEFB    $00                      ; EXtent Mask
 135  FA78              ; DSM is the ONLY byte in which this DPB differs from the 2.20-44K twin ($7F there).
 136  FA78              ;   The arithmetic does not close: 140 blocks / 4 blocks per track = 35 tracks of file
 137  FA78              ;   area, which with OFF=3 implies a 38-track disk; the medium is 35 tracks total. The
 138  FA78              ;   twin's $7F gives 32 + 3 = 35 exactly. What absorbs the surplus is a directory entry
 139  FA78              ;   present on every 2.23 disk: user byte $1F, lowercase name "cp/m    sys", allocation
 140  FA78              ;   list exactly blocks 128-139 -- the twelve blocks past the twin's 128. The BDOS's
 141  FA78              ;   allocation-vector rebuild skips only $E5 entries and does not range-check the user
 142  FA78              ;   number, so that entry is honoured and those twelve blocks stay marked in use.
 143  FA78              ;   RESOLVED (2026-07-31), and the answer is neither: BLOCKS 128-139 ARE THE SYSTEM TRACKS.
 144  FA78              ;   The 2.23 deblock (CPM_BootLoader_DiskXlate.asm, SM_NOFLUSH at $BCDA) folds any requested
 145  FA78              ;   track >= 35 back by 35, GATED ON THE DPB's DSM BYTE BEING $8B. The arithmetic is exact:
 146  FA78              ;   block 128 -> record 1024 -> OFF + 1024/SPT = track 35 -> 0; block 139 -> track 37 -> 2.
 147  FA78              ;   Twelve blocks = 12 KB = tracks 0,1,2 = 12,288 bytes, no remainder. So DSM=$8B deliberately
 148  FA78              ;   extends the disk by exactly the reserved area, making it addressable through the ordinary
 149  FA78              ;   file system, and "cp/m    sys" is the directory entry that NAMES it. The gate is the proof
 150  FA78              ;   of intent: a defensive clamp would not need to test DSM.
 151  FA78              ;   That entry is written by two shipped tools -- CPM60.COM (CPMV223-60K/CPM60_installer.asm)
 152  FA78              ;   and COPY.COM on its /S path (CPMV223-44K/utilities/COPY.asm $037F).
 153  FA78              ;   On a DATA disk the aliasing is the point: it recovers the boot area as 12 KB of usable
 154  FA78              ;   storage. [DOC CiderPress2 CP/M format notes] describes this same entry independently and
 155  FA78              ;   attributes the technique to the Microsoft SoftCard, "used to allow extra storage on
 156  FA78              ;   non-bootable disks".
 157  FA78              ;   CONSEQUENCE, and the hazard is SPECIFIC: a disk carrying a boot image but NOT the
 158  FA78              ;   protecting entry -- every 2.20-lineage system disk (DSM=$7F, so it never needed one) read
 159  FA78              ;   on a 2.23 system. Once blocks 0-127 are full the allocator hands out 128-139, and the write
 160  FA78              ;   does not fail and does not reach a drive error: it SILENTLY OVERWRITES TRACKS 0-2 and
 161  FA78              ;   destroys the boot pipeline. Verified in the emulator: SAVE into block 128 reported success
 162  FA78              ;   and changed 689 bytes of track 0. A non-bootable data disk is NOT at risk. See
 163  FA78              ;   docs/CPM_Disk_Creation.md and docs/CPM_Source_Changes_For_Narratives.md Parts 5 and 7. [RE]
 164  FA78 8B 00        DSM:    DEFW    $008B                    ; Disk Size Max: highest allocation block number: 139 -> 140 blocks
 165  FA7A 2F 00        DRM:    DEFW    $002F                    ; DiRectory Max: highest directory entry number: 47 -> 48 entries
 166  FA7C C0           AL0:    DEFB    $C0                      ; ALlocation bitmap, directory-reserved blocks, high byte -> 2
 167  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 168  FA7E 0C 00        CKS:    DEFW    $000C                    ; ChecKSum: directory checksum bytes
 169  FA80 03 00        OFF:    DEFW    $0003                    ; OFFset: reserved tracks before the file area
 170  FA82              ; ----------------------------------------------------------------------
 171  FA82              ; PROBE_DEVICES -- scan the SoftCard device/config area and mark presence.
 172  FA82              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 173  FA82              ;   Out: config bytes updated in place; per-device init called when a device is found.
 174  FA82              ;   Clobbers: A,DE,HL.
 175  FA82              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E].  If it equals 3 the slot
 176  FA82              ;     holds a recognized device, so call SLOT_IO_ADDR and store $03 then $15 into the
 177  FA82              ;     cell to flag it configured.  A secondary DEC A test (original value 4, e.g. a
 178  FA82              ;     Videx-class 80-col console) runs SET_SCREEN_BASE and claims the $C800 shared
 179  FA82              ;     expansion-ROM window via RPC_TRIGGER; a value-2 path repoints a vector via
 180  FA82              ;     PLOT_CHAR_RPC ($0DD0 param).  Same shape as the 2.20 twin's PROBE_DEVICES. [RE]
 181  FA82              ; ----------------------------------------------------------------------
 182  FA82              PROBE_DEVICES:
 183  FA82                      ; DE = 7 entries to scan (index walks down to 1)
 184  FA82 11 07 00             LD DE,$0007
 185  FA85              PROBE_DEVICES_LOOP:
 186  FA85                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 187  FA85 21 B8 F3             LD HL,$F3B8
 188  FA88 19                   ADD HL,DE
 189  FA89 7E                   LD A,(HL)
 190  FA8A                      ; config value 3 = a recognized/present device in this slot
 191  FA8A D6 03                SUB $03
 192  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 193  FA8E                      ; build the slot I/O base for the found device (SLOT_IO_ADDR)
 194  FA8E CD 81 FE             CALL SLOT_IO_ADDR
 195  FA91                      ; rewrite the cell: $03 then $15 = mark this device configured
 196  FA91 36 03                LD (HL),$03
 197  FA93 36 15                LD (HL),$15
 198  FA95              PROBE_DEVICES_CHK4:
 199  FA95                      ; after the SUB, A==1 means the original value was 4 (Videx-class 80-col console)
 200  FA95 3D                   DEC A
 201  FA96 20 0B                JR NZ,PROBE_DEVICES_CHK2
 202  FA98                      ; console probe / select the 80-col screen base (SET_SCREEN_BASE)
 203  FA98 CD 83 FD             CALL SET_SCREEN_BASE
 204  FA9B                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 205  FA9B 21 00 C8             LD HL,$C800
 206  FA9E CD 45 FB             CALL RPC_TRIGGER
 207  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 208  FAA3              PROBE_DEVICES_CHK2:
 209  FAA3                      ; value 2 = a different device class (e.g. printer/serial); takes the PLOT_CHAR_RPC path
 210  FAA3 FE 02                CP $02
 211  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 212  FAA7                      ; param for the value-2 vector init ($0DD0)
 213  FAA7 21 D0 0D             LD HL,$0DD0
 214  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 215  FAAD              PROBE_DEVICES_NEXT:
 216  FAAD                      ; next config entry; loop until all 7 scanned
 217  FAAD 1D                   DEC E
 218  FAAE 20 D5                JR NZ,PROBE_DEVICES_LOOP
 219  FAB0 C9                   RET
 220  FAB1              ; ----------------------------------------------------------------------
 221  FAB1              ; DEVICE_IO_BASE -- form a SoftCard I/O / soft-switch address from a device/offset index.
 222  FAB1              ;   In:  E = low offset within the I/O page.
 223  FAB1              ;   Out: HL = ((E | $E0) << 8), an address in z80 $E000-$EFFF = Apple I/O $C000-$CFFF;
 224  FAB1              ;        A clobbered.
 225  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 226  FAB1              ;        page, then H = A.  Used to reach keyboard / soft switches / slot I/O.
 227  FAB1              ;        Same as the 2.20 twin's DEVICE_IO_BASE (distinct from SLOT_IO_ADDR at $FE81). [RE]
 228  FAB1              ; ----------------------------------------------------------------------
 229  FAB1              DEVICE_IO_BASE:
 230  FAB1                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 231  FAB1 21 00 E0             LD HL,$E000
 232  FAB4 7B                   LD A,E
 233  FAB5                      ; force the high byte into the $C0xx I/O range
 234  FAB5 B4                   OR H
 235  FAB6 67                   LD H,A
 236  FAB7 C9                   RET
 237  FAB8              ; ----------------------------------------------------------------------
 238  FAB8              ; WBOOT -- CP/M warm boot: re-init the console, rebuild page zero, re-enter the CCP.
 239  FAB8              ;   In:  none.  Out: jumps to the CCP at $9300; does not return.  Clobbers: all.
 240  FAB8              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 241  FAB8              ;     (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 242  FAB8              ;     PROBE_DEVICES.  If the CCP image signature at $9C08 is intact ($9C) it falls
 243  FAB8              ;     into PAGEZERO_REBUILD; otherwise it reloads the CCP/system via a page-zero JP.
 244  FAB8              ;   Note: 2.23 reloads through a self-built $000B jump and enters the CCP at $9300
 245  FAB8              ;     (the 2.20 twin used $9400). [RE]
 246  FAB8              ; ----------------------------------------------------------------------
 247  FAB8              WBOOT:
 248  FAB8                      ; stack at the default DMA buffer top (page-zero $0080)
 249  FAB8 31 80 00             LD SP,$0080
 250  FABB                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 251  FABB 3A 51 E0             LD A,($E051)
 252  FABE 21 00 0E             LD HL,$0E00
 253  FAC1                      ; re-init the console I/O vectors (RPC_TRIGGER) for warm restart
 254  FAC1 CD 45 FB             CALL RPC_TRIGGER
 255  FAC4                      ; re-scan devices so warm boot rebuilds the I/O table
 256  FAC4 CD 82 FA             CALL PROBE_DEVICES
 257  FAC7                      ; read the CCP-image signature byte at $9C08
 258  FAC7 3A 08 9C             LD A,($9C08)
 259  FACA                      ; signature $9C present = CCP image intact, skip the reload
 260  FACA FE 9C                CP $9C
 261  FACC 28 11                JR Z,PAGEZERO_REBUILD
 262  FACE 21 59 FF             LD HL,SIGNON_PRINT
 263  FAD1 22 D0 F3             LD ($F3D0),HL
 264  FAD4 2A DE F3             LD HL,($F3DE)
 265  FAD7 3E 77                LD A,$77
 266  FAD9                      ; plant a $77 byte at page-zero $000B to bridge into the reload path
 267  FAD9 32 0B 00             LD ($000B),A
 268  FADC                      ; jump into the self-built page-zero reload bridge
 269  FADC C3 0B 00             JP $000B
 270  FADF              ; ----------------------------------------------------------------------
 271  FADF              ; PAGEZERO_REBUILD -- clear the CCP-restart flag, then write the page-zero hooks.
 272  FADF              ;   In:  none.  Out: falls into CCP_LAUNCH; no return.  Clobbers: A,HL,BC.
 273  FADF              ;   Algorithm: zero the CCP restart flag at $9307, then (PAGEZERO_REBUILD_HOOKS)
 274  FADF              ;     plant JP ($C3) at $0000 -> the BIOS WBOOT entry (BIOS_VECTOR+3, BIOS_VECTOR_WBOOT) and
 275  FADF              ;     JP at $0005 -> the BDOS entry $9C06; clear two self-modified BIOS state cells
 276  FADF              ;     ($FEDD/$FED8); set the default DMA to $0080 via SETDMA. [RE]
 277  FADF              ; ----------------------------------------------------------------------
 278  FADF              PAGEZERO_REBUILD:
 279  FADF AF                   XOR A
 280  FAE0                      ; clear the CCP restart/cold flag at $9307
 281  FAE0 32 07 93             LD ($9307),A
 282  FAE3              PAGEZERO_REBUILD_HOOKS:
 283  FAE3 AF                   XOR A
 284  FAE4                      ; clear a self-modified BIOS state cell ($FEDD)
 285  FAE4 32 DD FE             LD (BOOT_TMPL_IOBYTE),A
 286  FAE7                      ; clear a self-modified BIOS state cell ($FED8)
 287  FAE7 32 D8 FE             LD (DISK_HSTACT),A
 288  FAEA                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 289  FAEA 3E C3                LD A,$C3
 290  FAEC                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 291  FAEC 32 00 00             LD ($0000),A
 292  FAEF                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 293  FAEF 21 03 FA             LD HL,BIOS_VECTOR_WBOOT
 294  FAF2 22 01 00             LD ($0001),HL
 295  FAF5                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 296  FAF5 32 05 00             LD ($0005),A
 297  FAF8                      ; BDOS entry point ($9C06) for the $0005 hook
 298  FAF8 21 06 9C             LD HL,$9C06
 299  FAFB 22 06 00             LD ($0006),HL
 300  FAFE                      ; default DMA address = $0080 (page-zero buffer)
 301  FAFE 01 80 00             LD BC,$0080
 302  FB01                      ; install the default DMA pointer (SETDMA)
 303  FB01 CD F9 FB             CALL SETDMA
 304  FB04              ; ----------------------------------------------------------------------
 305  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, jump to the CCP.
 306  FB04              ;   In:  none.  Out: JP $9300 (CCP cold/warm entry); no return.  Clobbers: A,C.
 307  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $974E, pass the current default
 308  FB04              ;     drive (page-zero $0004) in C, and jump to the CCP at $9300. [RE]
 309  FB04              ; ----------------------------------------------------------------------
 310  FB04              CCP_LAUNCH:
 311  FB04                      ; CCP-mode flag value
 312  FB04 3E 01                LD A,$01
 313  FB06                      ; store the CCP entry/mode flag into CCP workspace at $974E
 314  FB06 32 4E 97             LD ($974E),A
 315  FB09                      ; page-zero $0004 = current default drive byte
 316  FB09 3A 04 00             LD A,($0004)
 317  FB0C 4F                   LD C,A
 318  FB0D                      ; enter the CCP at $9300, C = default drive (2.20 used $9400)
 319  FB0D C3 00 93             JP $9300
 320  FB10              ; ----------------------------------------------------------------------
 321  FB10              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 322  FB10              ;   In:  none.  Out: A = $FF (ready) / $00 (not).  Clobbers: A,HL.
 323  FB10              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 324  FB10              ;     cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler, which
 325  FB10              ;     returns the status in A.  Same as the 2.20 twin's CONST. [RE]
 326  FB10              ; ----------------------------------------------------------------------
 327  FB10              CONST:
 328  FB10                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 329  FB10 2A 80 F3             LD HL,($F380)
 330  FB13                      ; dispatch to the selected console-status handler (returns A)
 331  FB13 E9                   JP (HL)
 332  FB14              ; ----------------------------------------------------------------------
 333  FB14              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 334  FB14              ;   In:  none.  Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 335  FB14              ;   Clobbers: A.
 336  FB14              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard register; RLA shifts bit 7
 337  FB14              ;     (key-ready) into carry; SBC A,A expands carry to $FF/$00.  The built-in 40-col
 338  FB14              ;     CONST path used when no Videx/80-col card supplies the status vector. [RE]
 339  FB14              ; ----------------------------------------------------------------------
 340  FB14              KBD_STATUS_40COL:
 341  FB14                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 342  FB14 3A 00 E0             LD A,($E000)
 343  FB17                      ; rotate key-ready bit 7 into carry
 344  FB17 17                   RLA
 345  FB18                      ; carry -> A = $FF (ready) or $00 (none)
 346  FB18 9F                   SBC A,A
 347  FB19 C9                   RET
 348  FB1A              ; ----------------------------------------------------------------------
 349  FB1A              ; CONIN -- read a console character: IOBYTE-route the input, then remap the key.
 350  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,DE,HL.
 351  FB1A              ;   Algorithm: CALL CONIN_DISPATCH to fetch a raw key (routed by the IOBYTE CONSOLE
 352  FB1A              ;     field); clear the high bit; then scan a small remap table at Apple $03AB
 353  FB1A              ;     (z80 $F3AB) of up to 6 entries (function/arrow keys), returning the paired
 354  FB1A              ;     replacement byte on a match, else the raw key.
 355  FB1A              ;   Note: 2.23's CONIN jump-vector entry runs this remap wrapper; the 2.20 twin's
 356  FB1A              ;     equivalent is CONSOLE_IN_40COL.  Differs from a bare dispatcher. [RE]
 357  FB1A              ; ----------------------------------------------------------------------
 358  FB1A              CONIN:
 359  FB1A                      ; fetch a raw key in A via the IOBYTE-routed CONIN dispatcher
 360  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 361  FB1D                      ; strip the high bit (7-bit ASCII)
 362  FB1D E6 7F                AND $7F
 363  FB1F                      ; HL = key-remap table base (z80 $F3AB = Apple $03AB; first entry pair at $03AC)
 364  FB1F 21 AB F3             LD HL,$F3AB
 365  FB22                      ; up to 6 remap-table entries
 366  FB22 06 06                LD B,$06
 367  FB24                      ; C = raw key
 368  FB24 4F                   LD C,A
 369  FB25              ; ----------------------------------------------------------------------
 370  FB25              ; CONIN_XLATE_LOOP -- scan the function/arrow-key remap table.
 371  FB25              ;   In:  C = raw key; B = entry count; HL -> table base.
 372  FB25              ;   Out: A = translated key on match (returns), else loops; A = C on table end.
 373  FB25              ;   Algorithm: each entry = [match byte, replacement byte]; a high-bit sentinel
 374  FB25              ;     match byte ends the table. [RE]
 375  FB25              ; ----------------------------------------------------------------------
 376  FB25              CONIN_XLATE_LOOP:
 377  FB25 23                   INC HL
 378  FB26                      ; entry's match byte
 379  FB26 7E                   LD A,(HL)
 380  FB27 23                   INC HL
 381  FB28 B7                   OR A
 382  FB29                      ; high-bit sentinel ends the table
 383  FB29 FA 31 FB             JP M,CONIN_XLATE_DONE
 384  FB2C                      ; raw key == this entry?
 385  FB2C B9                   CP C
 386  FB2D                      ; paired replacement byte
 387  FB2D 7E                   LD A,(HL)
 388  FB2E                      ; match -> return the translated key
 389  FB2E C8                   RET Z
 390  FB2F 10 F4                DJNZ CONIN_XLATE_LOOP
 391  FB31              ; ----------------------------------------------------------------------
 392  FB31              ; CONIN_XLATE_DONE -- no remap match: return the raw key in A. [RE]
 393  FB31              ; ----------------------------------------------------------------------
 394  FB31              CONIN_XLATE_DONE:
 395  FB31                      ; no match -> return the raw key
 396  FB31 79                   LD A,C
 397  FB32 C9                   RET
 398  FB33              ; ----------------------------------------------------------------------
 399  FB33              ; CONIN_KEYWAIT -- seed the keyboard-wait dispatch index, then wait for a key.
 400  FB33              ;   In:  none.  Out: A = 7-bit key (via KBD_WAIT_KEY).  Clobbers: A,DE.
 401  FB33              ;   Algorithm: load DE = 3 (the default console index), then JP through the
 402  FB33              ;     self-modified CONIN_DISPATCH cell; at boot that target is patched to the
 403  FB33              ;     selected keyboard-wait handler (default KBD_WAIT_KEY). [RE]
 404  FB33              ; ----------------------------------------------------------------------
 405  FB33              CONIN_KEYWAIT:
 406  FB33                      ; DE = 3 = default console-device index
 407  FB33 11 03 00             LD DE,$0003
 408  FB36              ; ----------------------------------------------------------------------
 409  FB36              ; CONIN_DISPATCH -- self-modified keyboard-wait vector.
 410  FB36              ;   The JP target ($FB39 / KBD_WAIT_KEY by default) is patched at boot per the
 411  FB36              ;   selected console card.  Referenced as CONIN_DISPATCH+1 by the patch site. [RE]
 412  FB36              ; ----------------------------------------------------------------------
 413  FB36              CONIN_DISPATCH:
 414  FB36                      ; target (CONIN_DISPATCH+1) patched at boot to the chosen keyboard-wait handler
 415  FB36 C3 39 FB             JP KBD_WAIT_KEY
 416  FB39              ; ----------------------------------------------------------------------
 417  FB39              ; KBD_WAIT_KEY -- spin on the Apple keyboard register until a key is down.
 418  FB39              ;   In:  none.  Out: A = 7-bit key (high bit cleared).  Clobbers: A.
 419  FB39              ;   Algorithm: poll z80 $E000 = Apple $C000; RLA puts key-ready (bit 7) into carry,
 420  FB39              ;     spin while clear; on a key, clear the strobe at $E010 = Apple $C010 and return
 421  FB39              ;     the 7-bit key (CCF/RRA). [RE]
 422  FB39              ; ----------------------------------------------------------------------
 423  FB39              KBD_WAIT_KEY:
 424  FB39                      ; poll z80 $E000 = Apple $C000 keyboard register
 425  FB39 3A 00 E0             LD A,($E000)
 426  FB3C                      ; key-ready (bit 7) -> carry
 427  FB3C 17                   RLA
 428  FB3D                      ; spin until a key is down
 429  FB3D 30 FA                JR NC,KBD_WAIT_KEY
 430  FB3F                      ; clear the keyboard strobe (z80 $E010 = Apple $C010)
 431  FB3F 32 10 E0             LD ($E010),A
 432  FB42 3F                   CCF
 433  FB43                      ; A = 7-bit key
 434  FB43 1F                   RRA
 435  FB44 C9                   RET
 436  FB45              ; ----------------------------------------------------------------------
 437  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC.
 438  FB45              ;   In:  HL = command/params; A = trigger value.  Out: per the 6502 service routine.
 439  FB45              ;   Algorithm: stash HL to the command mailbox (z80 $F3D0 = Apple $03D0), then poke
 440  FB45              ;     the trigger cell.  The trigger store-address ($0000 here) is self-modified per
 441  FB45              ;     config at boot, so the store site is RPC_TRIGGER_STORE+1. [RE]
 442  FB45              ; ----------------------------------------------------------------------
 443  FB45              RPC_TRIGGER:
 444  FB45                      ; z80 $F3D0 = Apple $03D0 = RPC command/params mailbox
 445  FB45 22 D0 F3             LD ($F3D0),HL
 446  FB48              RPC_TRIGGER_STORE:
 447  FB48 32 00 00             LD ($0000),A
 448  FB4B C9                   RET
 449  FB4C              ; ----------------------------------------------------------------------
 450  FB4C              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE.
 451  FB4C              ;   In:  A = character (the BIOS CONOUT arg).  The jump-vector CONOUT entry targets
 452  FB4C              ;        CONOUT_DISPATCH+1 ($FB4D), skipping the leading LD C,A; the fall-through
 453  FB4C              ;        entry here (from the dispatcher) keeps it.
 454  FB4C              ;   Out: none.  Clobbers: A,C,HL.
 455  FB4C              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03).  Field
 456  FB4C              ;     value 2 dispatches through the SoftCard I/O vector at $F392 (Apple $0392) with
 457  FB4C              ;     JP (HL); otherwise fall into the column/tab filter. [RE]
 458  FB4C              ; ----------------------------------------------------------------------
 459  FB4C              CONOUT_DISPATCH:
 460  FB4C                      ; save the character to emit in C for the filter path (skipped by the +1 entry)
 461  FB4C 4F                   LD C,A
 462  FB4D                      ; read the CP/M IOBYTE (page-zero $0003)
 463  FB4D 3A 03 00             LD A,($0003)
 464  FB50                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 465  FB50 E6 03                AND $03
 466  FB52                      ; device value 2 = direct console; anything else takes the filter path
 467  FB52 FE 02                CP $02
 468  FB54 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 469  FB56              CONOUT_VIA_VEC_F392:
 470  FB56                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 471  FB56 2A 92 F3             LD HL,($F392)
 472  FB59 E9                   JP (HL)
 473  FB5A              ; ----------------------------------------------------------------------
 474  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE CONSOLE field.
 475  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 476  FB5A              ;   Algorithm: read IOBYTE, mask the CONSOLE field (AND $03).  Value 2 uses vector
 477  FB5A              ;     $F38A; the high value ($02<x) uses the preloaded $F384; low values use $F382;
 478  FB5A              ;     then JP (HL) into the chosen handler.  ($F38x = Apple $038x I/O vector.)
 479  FB5A              ;     Called by CONIN (the remap wrapper) and reused by READER. [RE]
 480  FB5A              ; ----------------------------------------------------------------------
 481  FB5A              CONIN_DISPATCH_IOBYTE:
 482  FB5A                      ; read the CP/M IOBYTE
 483  FB5A 3A 03 00             LD A,($0003)
 484  FB5D                      ; isolate the 2-bit CONSOLE device field
 485  FB5D E6 03                AND $03
 486  FB5F FE 02                CP $02
 487  FB61                      ; preload the input vector for the high CONSOLE value ($F384 = Apple $0384)
 488  FB61 2A 84 F3             LD HL,($F384)
 489  FB64 28 06                JR Z,CONIN_VIA_VEC_F38A
 490  FB66 30 07                JR NC,DISPATCH_VIA_HL
 491  FB68              CONIN_VIA_VEC_F382:
 492  FB68                      ; input vector for the low CONSOLE values ($F382 = Apple $0382)
 493  FB68 2A 82 F3             LD HL,($F382)
 494  FB6B E9                   JP (HL)
 495  FB6C              CONIN_VIA_VEC_F38A:
 496  FB6C                      ; input vector for CONSOLE value 2 ($F38A = Apple $038A)
 497  FB6C 2A 8A F3             LD HL,($F38A)
 498  FB6F              DISPATCH_VIA_HL:
 499  FB6F E9                   JP (HL)
 500  FB70              ; ----------------------------------------------------------------------
 501  FB70              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 502  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 503  FB70              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0).  Below $80
 504  FB70              ;     routes to the column/tab filter; == $80 reuses the console vector path
 505  FB70              ;     (CONOUT_VIA_VEC_F392); higher values dispatch through list vector $F394
 506  FB70              ;     (Apple $0394). [RE]
 507  FB70              ; ----------------------------------------------------------------------
 508  FB70              LIST:
 509  FB70 3A 03 00             LD A,($0003)
 510  FB73                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 511  FB73 E6 C0                AND $C0
 512  FB75 FE 80                CP $80
 513  FB77                      ; field < $80 -> no-device / filter path
 514  FB77 38 27                JR C,DISPATCH_NODEV
 515  FB79                      ; field == $80 -> reuse the console output vector path
 516  FB79 28 DB                JR Z,CONOUT_VIA_VEC_F392
 517  FB7B                      ; list-handler vector ($F394 = Apple $0394)
 518  FB7B 2A 94 F3             LD HL,($F394)
 519  FB7E E9                   JP (HL)
 520  FB7F              ; ----------------------------------------------------------------------
 521  FB7F              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 522  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 523  FB7F              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30).  Below $10 takes the
 524  FB7F              ;     column/tab filter; == $10 dispatches through vector $F38E; higher values use
 525  FB7F              ;     vector $F390.  ($F38E/$F390 = Apple $038E/$0390.) [RE]
 526  FB7F              ; ----------------------------------------------------------------------
 527  FB7F              PUNCH:
 528  FB7F 3A 03 00             LD A,($0003)
 529  FB82                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 530  FB82 E6 30                AND $30
 531  FB84 FE 10                CP $10
 532  FB86                      ; field < $10 -> no-device / filter path
 533  FB86 38 18                JR C,DISPATCH_NODEV
 534  FB88                      ; punch vector for the higher PUNCH values ($F38E = Apple $038E)
 535  FB88 2A 8E F3             LD HL,($F38E)
 536  FB8B                      ; field == $10 -> use the $F390 vector below
 537  FB8B 28 E2                JR Z,DISPATCH_VIA_HL
 538  FB8D                      ; punch vector for PUNCH value $10 ($F390 = Apple $0390)
 539  FB8D 2A 90 F3             LD HL,($F390)
 540  FB90 E9                   JP (HL)
 541  FB91              ; ----------------------------------------------------------------------
 542  FB91              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 543  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 544  FB91              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C), compare against $08. Field
 545  FB91              ;     < $08 ($00/$04) reuses the CONIN $F382 vector; == $08 reuses the CONIN $F38A vector;
 546  FB91              ;     > $08 ($0C) uses the reader vector $F38C (Apple $038C). [RE]
 547  FB91              ; ----------------------------------------------------------------------
 548  FB91              READER:
 549  FB91 3A 03 00             LD A,($0003)
 550  FB94                      ; isolate the 2-bit READER device field of the IOBYTE
 551  FB94 E6 0C                AND $0C
 552  FB96 FE 08                CP $08
 553  FB98                      ; field < $08 ($00/$04) -> reuse the CONIN $F382 vector path
 554  FB98 38 CE                JR C,CONIN_VIA_VEC_F382
 555  FB9A                      ; field == $08 -> reuse the CONIN $F38A vector path
 556  FB9A 28 D0                JR Z,CONIN_VIA_VEC_F38A
 557  FB9C                      ; reader-handler vector ($F38C = Apple $038C)
 558  FB9C 2A 8C F3             LD HL,($F38C)
 559  FB9F E9                   JP (HL)
 560  FBA0              ; ----------------------------------------------------------------------
 561  FBA0              ; DISPATCH_NODEV -- IOBYTE field selects no physical device: fall into the filter.
 562  FBA0              ;   In:  carry set by the caller (no-device).  Out: enters CONOUT_FILTER_NOEXPAND
 563  FBA0              ;        with the carry folded into the COL_FLAG byte.  Clobbers: A,HL.
 564  FBA0              ;   Algorithm: SCF then (CONOUT_FILTER_NOEXPAND) SBC A,A turns carry into a 0/$FF
 565  FBA0              ;     flag stored in COL_FLAG ($FECB); clear bit 7 of the char in C; if the pending-
 566  FBA0              ;     column counter ($FECC) is nonzero, apply a config-driven column offset, else
 567  FBA0              ;     fall through to the tab/control expansion (SETDMA_1). [RE]
 568  FBA0              ; ----------------------------------------------------------------------
 569  FBA0              DISPATCH_NODEV:
 570  FBA0                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 571  FBA0 37                   SCF
 572  FBA1              CONOUT_FILTER_NOEXPAND:
 573  FBA1                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 574  FBA1 9F                   SBC A,A
 575  FBA2 21 A2 F3             LD HL,$F3A2
 576  FBA5 6E                   LD L,(HL)
 577  FBA6 2C                   INC L
 578  FBA7 CA A4 FC             JP Z,SCREEN_EMIT
 579  FBAA                      ; HL -> COL_FLAG cell ($FECB)
 580  FBAA 21 CB FE             LD HL,COL_FLAG
 581  FBAD                      ; store the entry flag into COL_FLAG
 582  FBAD 77                   LD (HL),A
 583  FBAE                      ; strip the high bit of the character (7-bit ASCII)
 584  FBAE CB B9                RES 7,C
 585  FBB0 23                   INC HL
 586  FBB1                      ; load COL_PENDING (pending column-skip / fill count, $FECC)
 587  FBB1 7E                   LD A,(HL)
 588  FBB2 B7                   OR A
 589  FBB3                      ; no pending column work -> run tab/control expansion
 590  FBB3 CA 56 FC             JP Z,SETDMA_1
 591  FBB6                      ; consume one pending column step
 592  FBB6 35                   DEC (HL)
 593  FBB7                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 594  FBB7 3A 96 F3             LD A,($F396)
 595  FBBA                      ; HL -> the column cell in the $FE85 deblock/screen-state band ($FED4)
 596  FBBA 21 D4 FE             LD HL,BOOT_TMPL_XORA
 597  FBBD                      ; config byte zero -> derive the offset from the running width
 598  FBBD 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 599  FBBF B7                   OR A
 600  FBC0 F2 C6 FB             JP P,COL_APPLY_OFFSET_RAW
 601  FBC3 2B                   DEC HL
 602  FBC4              ; ----------------------------------------------------------------------
 603  FBC4              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 604  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 605  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 606  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude, subtract it from the
 607  FBC4              ;     current column in C, store the new column.  Reached when the config byte's sign
 608  FBC4              ;     indicates a subtractive column adjust. [RE]
 609  FBC4              ; ----------------------------------------------------------------------
 610  FBC4              COL_APPLY_OFFSET:
 611  FBC4                      ; drop the sign bit to get the offset magnitude
 612  FBC4 E6 7F                AND $7F
 613  FBC6              COL_APPLY_OFFSET_RAW:
 614  FBC6 5F                   LD E,A
 615  FBC7 79                   LD A,C
 616  FBC8                      ; new column = current column (C) minus the offset
 617  FBC8 93                   SUB E
 618  FBC9                      ; store the updated column position
 619  FBC9 77                   LD (HL),A
 620  FBCA C9                   RET
 621  FBCB              ; ----------------------------------------------------------------------
 622  FBCB              ; COL_OFFSET_FROM_WIDTH -- derive the column offset from the running screen width.
 623  FBCB              ;   In:  C = current column; the BOOT-overlaid base word at (BOOT+2).
 624  FBCB              ;   Out: updates the column and emits via SCREEN_EMIT; combines a base address with
 625  FBCB              ;        the offset.  Clobbers: A,B,C,DE,HL.
 626  FBCB              ;   Algorithm: pick the column cell by the config sign, CALL COL_APPLY_OFFSET, then
 627  FBCB              ;     load the base word (BOOT+2 = the cold-boot operand reused as deblock
 628  FBCB              ;     scratch), fold in config $F3A1, and ADD to form the screen address before
 629  FBCB              ;     emitting (SCREEN_EMIT). [RE]
 630  FBCB              ; ----------------------------------------------------------------------
 631  FBCB              COL_OFFSET_FROM_WIDTH:
 632  FBCB B7                   OR A
 633  FBCC                      ; config sign negative -> keep the higher column cell
 634  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH_1
 635  FBCF 2B                   DEC HL
 636  FBD0              COL_OFFSET_FROM_WIDTH_1:
 637  FBD0                      ; apply the signed column offset (COL_APPLY_OFFSET)
 638  FBD0 CD C4 FB             CALL COL_APPLY_OFFSET
 639  FBD3                      ; base word = the BOOT-overlaid deblock scratch ($FED3)
 640  FBD3 2A D3 FE             LD HL,(BOOT+2)
 641  FBD6                      ; config byte $F3A1 = Apple $03A1 (screen-base modifier)
 642  FBD6 3A A1 F3             LD A,($F3A1)
 643  FBD9 B7                   OR A
 644  FBDA                      ; config positive -> use HL as-is, skip the byte swap
 645  FBDA F2 E2 FB             JP P,COL_COMBINE_BASE
 646  FBDD                      ; negative: drop the sign bit, then swap H<->L below
 647  FBDD E6 7F                AND $7F
 648  FBDF 5D                   LD E,L
 649  FBE0 6C                   LD L,H
 650  FBE1 63                   LD H,E
 651  FBE2              ; ----------------------------------------------------------------------
 652  FBE2              ; COL_COMBINE_BASE -- fold the config offset into the base address, emit the char.
 653  FBE2              ;   In:  A = config offset; HL = base word; C will receive the high result.
 654  FBE2              ;   Out: pushes the low result, emits via SCREEN_EMIT with B=7, then re-enters the
 655  FBE2              ;        emit path with B=$0A.  Clobbers: A,B,C,DE,HL.
 656  FBE2              ;   Algorithm: C = offset + H; A = offset + L; CALL SCREEN_EMIT (B=7), then fall into
 657  FBE2              ;     CONOUT_EMIT_B with B=$0A. [RE]
 658  FBE2              ; ----------------------------------------------------------------------
 659  FBE2              COL_COMBINE_BASE:
 660  FBE2 5F                   LD E,A
 661  FBE3                      ; C = config offset + base high byte
 662  FBE3 84                   ADD A,H
 663  FBE4 4F                   LD C,A
 664  FBE5 7B                   LD A,E
 665  FBE6                      ; A = config offset + base low byte
 666  FBE6 85                   ADD A,L
 667  FBE7 F5                   PUSH AF
 668  FBE8                      ; mode/count code 7 for the screen emit
 669  FBE8 06 07                LD B,$07
 670  FBEA                      ; emit via the screen handler (SCREEN_EMIT)
 671  FBEA CD A4 FC             CALL SCREEN_EMIT
 672  FBED F1                   POP AF
 673  FBEE                      ; mode/count code $0A for the follow-up emit
 674  FBEE 06 0A                LD B,$0A
 675  FBF0              CHAR_C_TO_SCREEN:
 676  FBF0 4F                   LD C,A
 677  FBF1 C3 A4 FC             JP SCREEN_EMIT
 678  FBF4              ; ----------------------------------------------------------------------
 679  FBF4              ; SETSEC -- BIOS jump-vector entry 11 ($FA24 -> $FBF4): set the requested sector.
 680  FBF4              ;   In:  C = sector number. Out: none. Clobbers: A.
 681  FBF4              ;   Algorithm: store C into the sector cell BOOT+1 ($FED2 = the cold-boot LD SP operand
 682  FBF4              ;        low byte, reused post-boot as the requested-sector cell). The off-image RWTS
 683  FBF4              ;        ($AC39/$AC49) is the consumer; this image only WRITES it. Mirrors 2.20 SETSEC.
 684  FBF4              ;        [RE, transferred from 2.20; the off-image consumer is not in this image]
 685  FBF4              ; ----------------------------------------------------------------------
 686  FBF4              SETSEC:
 687  FBF4 79                   LD A,C
 688  FBF5                      ; store the requested sector into BOOT+1 (reused as the seksec cell)
 689  FBF5 32 D2 FE             LD (BOOT+1),A
 690  FBF8 C9                   RET
 691  FBF9              ; ----------------------------------------------------------------------
 692  FBF9              ; SETDMA -- BIOS jump-vector entry 12 ($FA27 -> $FBF9): set the DMA address.
 693  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 694  FBF9              ;   Out: none. Clobbers: none.
 695  FBF9              ;   Algorithm: store BC into the dmaadr cell (SECTOR_BLOCK_PATCH+2 = $FEE1, the
 696  FBF9              ;        operand region of the install-template 'LD ($0003),A'). The OFF-IMAGE
 697  FBF9              ;        deblock copy uses dmaadr as the host<->record transfer endpoint. The 2.20
 698  FBF9              ;        deblock did the LDIR itself; in 2.23 the value is read off-image. [RE]
 699  FBF9              ; ----------------------------------------------------------------------
 700  FBF9              SETDMA:
 701  FBF9                      ; store BC into dmaadr ($FEE1, overlaid on the install-template LD ($0003),A operand)
 702  FBF9 ED 43 E1 FE          LD (DISK_DMAADR+2),BC
 703  FBFD C9                   RET
 704  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 705  FC56              SETDMA_1:
 706  FC56 47                   LD B,A
 707  FC57 21 CD FE             LD HL,COL_STATE
 708  FC5A 7E                   LD A,(HL)
 709  FC5B 5F                   LD E,A
 710  FC5C B7                   OR A
 711  FC5D 20 12                JR NZ,SETDMA_3
 712  FC5F 3A 97 F3             LD A,($F397)
 713  FC62 B7                   OR A
 714  FC63 28 06                JR Z,SETDMA_2
 715  FC65 B9                   CP C
 716  FC66 20 03                JR NZ,SETDMA_2
 717  FC68 36 80                LD (HL),$80
 718  FC6A C9                   RET
 719  FC6B              SETDMA_2:
 720  FC6B 3E 1F                LD A,$1F
 721  FC6D B9                   CP C
 722  FC6E DA A4 FC             JP C,SCREEN_EMIT
 723  FC71              SETDMA_3:
 724  FC71 21 A0 F3             LD HL,$F3A0
 725  FC74 06 09                LD B,$09
 726  FC76              SETDMA_4:
 727  FC76 7E                   LD A,(HL)
 728  FC77 B7                   OR A
 729  FC78 28 04                JR Z,SETDMA_5
 730  FC7A AB                   XOR E
 731  FC7B B9                   CP C
 732  FC7C 28 05                JR Z,SETDMA_6
 733  FC7E              SETDMA_5:
 734  FC7E 2B                   DEC HL
 735  FC7F 10 F5                DJNZ SETDMA_4
 736  FC81 18 21                JR SCREEN_EMIT
 737  FC83              SETDMA_6:
 738  FC83 11 0B 00             LD DE,$000B
 739  FC86 19                   ADD HL,DE
 740  FC87 7E                   LD A,(HL)
 741  FC88 B7                   OR A
 742  FC89 4F                   LD C,A
 743  FC8A F2 9A FC             JP P,SETDMA_7
 744  FC8D E6 7F                AND $7F
 745  FC8F 4F                   LD C,A
 746  FC90 C5                   PUSH BC
 747  FC91 3A A2 F3             LD A,($F3A2)
 748  FC94 06 07                LD B,$07
 749  FC96 CD F0 FB             CALL CHAR_C_TO_SCREEN
 750  FC99 C1                   POP BC
 751  FC9A              SETDMA_7:
 752  FC9A 78                   LD A,B
 753  FC9B FE 07                CP $07
 754  FC9D 20 05                JR NZ,SCREEN_EMIT
 755  FC9F 3E 02                LD A,$02
 756  FCA1 32 CC FE             LD (COL_PENDING),A
 757  FCA4              SCREEN_EMIT:
 758  FCA4 AF                   XOR A
 759  FCA5 32 CD FE             LD (COL_STATE),A
 760  FCA8 3A CB FE             LD A,(COL_FLAG)
 761  FCAB B7                   OR A
 762  FCAC 2A 88 F3             LD HL,($F388)
 763  FCAF 28 03                JR Z,SCREEN_EMIT_1
 764  FCB1 2A 86 F3             LD HL,($F386)
 765  FCB4              SCREEN_EMIT_1:
 766  FCB4 E9                   JP (HL)
 767  FCB5              SCREEN_EMIT_2:
 768  FCB5 11 03 00             LD DE,$0003
 769  FCB8              SCREEN_EMIT_3:
 770  FCB8 C3 BB FC             JP SCREEN_EMIT_4
 771  FCBB              SCREEN_EMIT_4:
 772  FCBB 2A CE FE             LD HL,(SCREEN_CURSOR_PTR)
 773  FCBE 3A D0 FE             LD A,(SCREEN_CHAR)
 774  FCC1 77                   LD (HL),A
 775  FCC2 CD E2 FC             CALL CTRL_CHAR_DISPATCH
 776  FCC5 2A 28 F0             LD HL,($F028)
 777  FCC8 3A 24 F0             LD A,($F024)
 778  FCCB 5F                   LD E,A
 779  FCCC 16 F0                LD D,$F0
 780  FCCE 19                   ADD HL,DE
 781  FCCF 22 CE FE             LD (SCREEN_CURSOR_PTR),HL
 782  FCD2 7E                   LD A,(HL)
 783  FCD3 32 D0 FE             LD (SCREEN_CHAR),A
 784  FCD6 FE E0                CP $E0
 785  FCD8 38 02                JR C,SCREEN_EMIT_5
 786  FCDA EE 20                XOR $20
 787  FCDC              SCREEN_EMIT_5:
 788  FCDC E6 3F                AND $3F
 789  FCDE F6 40                OR $40
 790  FCE0 77                   LD (HL),A
 791  FCE1 C9                   RET
 792  FCE2              CTRL_CHAR_DISPATCH:
 793  FCE2 78                   LD A,B
 794  FCE3 B7                   OR A
 795  FCE4 28 0B                JR Z,CTRL_PLAIN_CHAR
 796  FCE6 21 45 FB             LD HL,RPC_TRIGGER
 797  FCE9 E5                   PUSH HL
 798  FCEA 21 66 FD             LD HL,CTRL_HANDLER_OFFSET_TBL
 799  FCED 85                   ADD A,L
 800  FCEE 6F 6E E9             DEFB    $6F,$6E,$E9
 801  FCF1              CTRL_PLAIN_CHAR:
 802  FCF1 79 FE 0D 20          DEFB    $79,$FE,$0D,$20,$05
 802  FCF5 05
 803  FCF6 AF 32 24 F0          DEFB    $AF,$32,$24,$F0,$C9,$F6,$80 ; "/2$pIv"
 803  FCFA C9 F6 80
 804  FCFD FE E0 38 04          DEFB    $FE,$E0,$38,$04
 805  FD01 21 DD F3 AE          DEFB    $21,$DD,$F3,$AE,$32,$45,$F0,$21,$F0,$FD,$C3,$80 ; "!]s.2Ep!p}C"
 805  FD05 32 45 F0 21
 805  FD09 F0 FD C3 80
 806  FD0D FD CD 81 FE          DEFB    $FD,$CD,$81,$FE,$C6,$8F
 806  FD11 C6 8F
 807  FD13 CB 4E 28 FC          DEFB    $CB,$4E,$28,$FC,$21,$2F,$F0,$36,$60,$2B,$36,$C0,$2B,$77,$2B,$36 ; "KN(|!/p6`+6@+w+6"
 807  FD17 21 2F F0 36
 807  FD1B 60 2B 36 C0
 807  FD1F 2B 77 2B 36
 808  FD23 8D                   DEFB    $8D
 809  FD24 62 C3 7C FD          DEFB    $62,$C3,$7C,$FD,$3E,$FF,$01,$3E,$3F,$32,$32,$F0,$E1,$C9,$21,$F4

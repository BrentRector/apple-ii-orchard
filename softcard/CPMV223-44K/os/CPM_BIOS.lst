 780  FDAD 32 45 F0             LD ($F045),A
 781  FDB0              PLOT_CHAR_RPC:
 782  FDB0 7B                   LD A,E
 783  FDB1 32 47 F0             LD ($F047),A
 784  FDB4 C3 45 FB             JP RPC_TRIGGER
 785  FDB7              PLOT_CHAR_RPC_1:

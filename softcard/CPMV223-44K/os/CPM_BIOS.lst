 790  FDC1              ; SCREEN_RPC_HELPER -- read back a screen byte via the RPC: position, fire the RPC, fetch.
 791  FDC1              SCREEN_RPC_HELPER:
 792  FDC1 CD 83 FD             CALL SET_SCREEN_BASE                    ; compute the screen base for the current row
 793  FDC4 21 4D C8             LD HL,$C84D                      ; 6502 RPC parameter (Apple expansion-ROM addr)
 794  FDC7 CD 45 FB             CALL RPC_TRIGGER                 ; run the embedded 6502 service on the 6502
 795  FDCA 21 78 F6             LD HL,$F678                      ; HL = row buffer base (Apple $0678)
 796  FDCD 19                   ADD HL,DE
 797  FDCE 7E                   LD A,(HL)                        ; read back the character
 798  FDCF C9                   RET
 799  FDD0              ; RPC6502_SERVICE_223 -- the embedded 6502 RPC service ($FDD0-$FE41 = Apple $0DD0); its
 800  FDD0              ; own ca65 source CPM_RPC6502_223.s is sub-assembled and INCBIN'd here (the 2.20
 801  FDD0              ; CPM_RPC6502 pattern). It forms a slot-ROM pointer ($CFFF disables expansion ROM),
 802  FDD0              ; LDA ($F6),Y, and JMP ($00F6) dispatches into the selected slot-ROM/firmware routine.
 803  FDD0              RPC6502_SERVICE_223:
 804  FDD0              ;   >>> CPM_RPC6502_223.s -- verbatim listing of the INCBIN'd source (regen: inject_incbin_listing) >>>
 805  FDD0              ;
 806  FDD0              ; .org $0DD0
 807  FDD0              ;
 808  FDD0              ; L_0DD0:
 809  FDD0              ;         PHA                          ; $0DD0  48
 810  FDD0              ;         JSR SUB_0E1D                 ; $0DD1  20 1D 0E
 811  FDD0              ;         LDY #$0D                     ; $0DD4  A0 0D
 812  FDD0              ; L_0DD6:
 813  FDD0              ;         LDA ($F6),Y                  ; $0DD6  B1 F6
 814  FDD0              ;         STA $F6                      ; $0DD8  85 F6
 815  FDD0              ;         LDY $06F8                    ; $0DDA  AC F8 06
 816  FDD0              ;         PLA                          ; $0DDD  68
 817  FDD0              ;         JMP ($00F6)                ; $0DDE  6C F6 00
 818  FDD0              ; L_0DE1:
 819  FDD0              ;         PHA                          ; $0DE1  48
 820  FDD0              ;         LDA #$00                     ; $0DE2  A9 00
 821  FDD0              ;         JSR SUB_0DEF                 ; $0DE4  20 EF 0D
 822  FDD0              ;         JSR SUB_0E1D                 ; $0DE7  20 1D 0E
 823  FDD0              ;         LDY #$0F                     ; $0DEA  A0 0F
 824  FDD0              ;         JMP L_0DD6                   ; $0DEC  4C D6 0D
 825  FDD0              ; SUB_0DEF:
 826  FDD0              ;         STY $F5                      ; $0DEF  84 F5
 827  FDD0              ;         PHA                          ; $0DF1  48
 828  FDD0              ;         JSR SUB_0E14                 ; $0DF2  20 14 0E
 829  FDD0              ;         PLA                          ; $0DF5  68
 830  FDD0              ;         LDY $F5                      ; $0DF6  A4 F5
 831  FDD0              ;         BCC SUB_0DEF                 ; $0DF8  90 F5
 832  FDD0              ;         RTS                          ; $0DFA  60
 833  FDD0              ;         .byte   $00, $00, $00, $00, $00, $4C, $E9, $BB, $4C, $04, $BE, $A9, $01, $20, $EF, $0D ; $0DFB
 834  FDD0              ;         .byte   $20, $1D, $0E, $48, $A0, $0E, $4C, $D6, $0D      ; $0E0B
 835  FDD0              ; SUB_0E14:
 836  FDD0              ;         PHA                          ; $0E14  48
 837  FDD0              ;         JSR SUB_0E1D                 ; $0E15  20 1D 0E
 838  FDD0              ;         LDY #$10                     ; $0E18  A0 10
 839  FDD0              ;         JMP L_0DD6                   ; $0E1A  4C D6 0D
 840  FDD0              ; SUB_0E1D:
 841  FDD0              ;         TYA                          ; $0E1D  98
 842  FDD0              ;         ORA #$C0                     ; $0E1E  09 C0
 843  FDD0              ;         TAX                          ; $0E20  AA
 844  FDD0              ;         TYA                          ; $0E21  98
 845  FDD0              ;         ASL                          ; $0E22  0A
 846  FDD0              ;         ASL                          ; $0E23  0A
 847  FDD0              ;         ASL                          ; $0E24  0A
 848  FDD0              ;         ASL                          ; $0E25  0A
 849  FDD0              ;         TAY                          ; $0E26  A8
 850  FDD0              ;         STY $06F8                    ; $0E27  8C F8 06
 851  FDD0              ;         LDA #$00                     ; $0E2A  A9 00
 852  FDD0              ;         STA $F6                      ; $0E2C  85 F6
 853  FDD0              ;         STX $F7                      ; $0E2E  86 F7
 854  FDD0              ;         LDA $CFFF                    ; $0E30  AD FF CF
 855  FDD0              ;         LDA ($F6),Y                  ; $0E33  B1 F6
 856  FDD0              ;         RTS                          ; $0E35  60
 857  FDD0              ; SUB_0E1D_1:
 858  FDD0              ;         LDA $48                      ; $0E36  A5 48
 859  FDD0              ;         PHA                          ; $0E38  48
 860  FDD0              ;         LDA $45                      ; $0E39  A5 45
 861  FDD0              ;         LDX $46                      ; $0E3B  A6 46
 862  FDD0              ;         LDY $47                      ; $0E3D  A4 47
 863  FDD0              ;         PLP                          ; $0E3F  28
 864  FDD0              ;         CLI                          ; $0E40  58
 865  FDD0              ;         RTS                          ; $0E41  60
 866  FDD0              ;   <<< end listing <<<
 867  FDD0                      INCBIN "CPM_RPC6502_223.bin"     ; 114 bytes of 6502 (runs on the 6502 via the RPC)
 868  FE42              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 869  FE42              DEV_READ_BIT:
 870  FE42 CD 81 FE             CALL SLOT_IO_ADDR
 871  FE45              DEV_READ_WAIT:
 872  FE45 7E                   LD A,(HL)
 873  FE46 1F                   RRA                              ; ready bit -> carry
 874  FE47 30 FC                JR NC,DEV_READ_WAIT
 875  FE49 2C                   INC L
 876  FE4A 7E                   LD A,(HL)                        ; read the data byte
 877  FE4B C9                   RET
 878  FE4C              DEV_OUT_1:                               ; default I/O vector handler (LIST stub)
 879  FE4C 11 01 00             LD DE,$0001
 880  FE4F              DEV_OUT_1_JP:
 881  FE4F C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 882  FE52              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 883  FE52              DEV_WR_BIT:
 884  FE52 CD B1 FA             CALL DEVICE_IO_BASE
 885  FE55 2E C1                LD L,$C1
 886  FE57              DEV_WR_WAIT:
 887  FE57 7E                   LD A,(HL)
 888  FE58 17                   RLA                              ; ready bit -> carry
 889  FE59 38 FC                JR C,DEV_WR_WAIT
 890  FE5B CD 7C FE             CALL SLOT_IO_ADDR_W
 891  FE5E 71                   LD (HL),C
 892  FE5F              DEV_RET:
 893  FE5F C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 894  FE60              DEV_OUT_2:                               ; default I/O vector handler (PUNCH stub)
 895  FE60 11 02 00             LD DE,$0002
 896  FE63              DEV_OUT_2_JP:
 897  FE63 C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 898  FE66              DEV_OUT_3:                               ; default I/O vector handler (READER stub)
 899  FE66 11 02 00             LD DE,$0002
 900  FE69              DEV_OUT_3_JP:
 901  FE69 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 902  FE6C              ; ----------------------------------------------------------------------
 903  FE6C              ; HOME -- BIOS jump-vector entry 8 ($FA18): seek the selected drive to track 0. [RE]
 904  FE6C              ;   In:  none. Out: none. Clobbers: A,C.
 905  FE6C              ;   Algorithm: if the host buffer still holds a pending write (hstwrt nonzero) leave
 906  FE6C              ;     hstact set so the dirty buffer is not dropped; else clear hstact (host buffer
 907  FE6C              ;     inactive). Then fall through into SETTRK_STORE with track 0. Mirrors the 2.20
 908  FE6C              ;     twin HOME exactly; the actual head step happens later in the deblock path. [RE]
 909  FE6C              ; ----------------------------------------------------------------------
 910  FE6C              HOME:
 911  FE6C                      ; read hstwrt (host-write-pending flag; lives in the BOOT install-template cells)
 912  FE6C 3A D9 FE             LD A,(DISK_HSTWRT)
 913  FE6F B7                   OR A
 914  FE70                      ; pending write -> keep hstact set, skip the clear
 915  FE70 20 03                JR NZ,SETTRK_STORE
 916  FE72                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 917  FE72 32 D8 FE             LD (DISK_HSTACT),A
 918  FE75              ; ----------------------------------------------------------------------
 919  FE75              ; SETTRK_STORE -- HOME falls in here with track 0; common tail with SETTRK. [RE]
 920  FE75              ;   In:  (HOME path) forces C=0. Out: stores sektrk. Clobbers: A,C.
 921  FE75              ;   Algorithm: load C=0, then fall into SETTRK's store (the $FE77 vector body) which
 922  FE75              ;     writes the track into the BOOT 'LD SP' operand byte reused as sektrk. [RE]
 923  FE75              ; ----------------------------------------------------------------------
 924  FE75              SETTRK_STORE:
 925  FE75                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 926  FE75 0E 00                LD C,$00
 927  FE77                      ; SETTRK (vector entry 10, JP $FE77): track number from BDOS in C
 928  FE77 79                   LD A,C
 929  FE78                      ; store sektrk into BOOT's LD SP operand byte (BOOT cell reused post-boot as sektrk)
 930  FE78 32 D1 FE             LD (BOOT),A
 931  FE7B C9                   RET
 932  FE7C              ; ----------------------------------------------------------------------
 933  FE7C              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 934  FE7C              ;   In:  E = slot/drive index (0..15). Out: HL = $E080 + (E<<4). Clobbers: A,L.
 935  FE7C              ;   Algorithm: load the $C08x write/control-bank base (z80 $E080 = Apple $C080), then
 936  FE7C              ;     fall into the shared index scaler (SLOT_IO_SCALE, the ADD A,A x4 at $FE85).
 937  FE7C              ;     Twin of 2.20 SLOT_IO_ADDR_W. [RE]
 938  FE7C              ; ----------------------------------------------------------------------
 939  FE7C              SLOT_IO_ADDR_W:
 940  FE7C                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 941  FE7C 21 80 E0             LD HL,$E080
 942  FE7F 18 03                JR SLOT_IO_SCALE_E
 943  FE81              ; ----------------------------------------------------------------------
 944  FE81              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch base ($C08E bank).
 945  FE81              ;   In:  E = slot/drive index (0..15). Out: HL = $E08E + (E<<4). Clobbers: A,L.
 946  FE81              ;   Algorithm: load the $C08E base, fall into SLOT_IO_SCALE_E. z80 $E08E = Apple $C08E.
 947  FE81              ;     Twin of 2.20 SLOT_IO_ADDR. [RE]
 948  FE81              ; ----------------------------------------------------------------------
 949  FE81              SLOT_IO_ADDR:
 950  FE81                      ; z80 $E08E = Apple $C08E slot-I/O base
 951  FE81 21 8E E0             LD HL,$E08E
 952  FE84              ; ----------------------------------------------------------------------
 953  FE84              ; SLOT_IO_SCALE_E -- load the slot/drive index into A, then fall into SLOT_IO_SCALE.
 954  FE84              ;   In:  E = index. Out: continues into the scaler. Twin of 2.20 SLOT_IO_SCALE_E. [RE]
 955  FE84              ; ----------------------------------------------------------------------
 956  FE84              SLOT_IO_SCALE_E:
 957  FE84                      ; slot/drive index into A for the scaler
 958  FE84 7B                   LD A,E
 959  FE85              ; ----------------------------------------------------------------------
 960  FE85              ; SLOT_IO_SCALE -- shift the index in A left by 4 and add it to L (index a $C0n0..$C0nF
 961  FE85              ;     16-byte slot-I/O block, or a *16-stride table). [RE]
 962  FE85              ;   In:  A = index, L = base low byte. Out: L += A*16; A preserved. Clobbers: A,L.
 963  FE85              ;   Algorithm: ADD A,A four times (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET.
 964  FE85              ;     Shared by SLOT_IO_ADDR/_W and by SELDSK (DPH-table index) and the device probe.
 965  FE85              ;     Twin of 2.20 SLOT_IO_SCALE. [RE]
 966  FE85              ; ----------------------------------------------------------------------
 967  FE85              SLOT_IO_SCALE:
 968  FE85                      ; A *= 16 over the four ADD A,A (slot block is 16 bytes; DPH stride is 16)
 969  FE85 87                   ADD A,A
 970  FE86 87                   ADD A,A
 971  FE87 87                   ADD A,A
 972  FE88 87                   ADD A,A
 973  FE89 F5                   PUSH AF
 974  FE8A                      ; L = base + index*16
 975  FE8A 85                   ADD A,L
 976  FE8B 6F                   LD L,A
 977  FE8C F1                   POP AF
 978  FE8D C9                   RET
 979  FE8E              ; ----------------------------------------------------------------------
 980  FE8E              ; SELDSK -- BIOS jump-vector entry 9 ($FA1B): select the disk drive for subsequent I/O.
 981  FE8E              ;   In:  C = disk number (0-based). Out: HL = DPH address for drive C, or HL=0 if out
 982  FE8E              ;     of range. Clobbers: A,DE,HL.
 983  FE8E              ;   Algorithm: DE -> the sekdsk build site (DISK_SEKDSK, an install-template cell reused
 984  FE8E              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
 985  FE8E              ;     block (z80 $F3B8 = Apple $03B8); if C >= count return HL=0. Else record the disk
 986  FE8E              ;     number, index the DPH table at DPH_TABLE by C*16 (CALL SLOT_IO_SCALE), pull a per-drive
 987  FE8E              ;     disk-parameter byte and self-modify the install template SECTOR_BLOCK_PATCH+1 with it.
 988  FE8E              ;     Twin of 2.20 SELDSK. [RE]
 989  FE8E              ; ----------------------------------------------------------------------
 990  FE8E              SELDSK:
 991  FE8E                      ; DE -> sekdsk build site (install-template cell reused as disk-select scratch)
 992  FE8E 11 D5 FE             LD DE,DISK_SEKDSK
 993  FE91 21 04 00             LD HL,$0004
 994  FE94                      ; configured drive count from the SoftCard config block (Apple $03B8)
 995  FE94 3A B8 F3             LD A,($F3B8)
 996  FE97 3D                   DEC A
 997  FE98                      ; requested drive vs (count-1); carry => out of range
 998  FE98 B9                   CP C
 999  FE99                      ; out of range -> SELDSK_BAD_DRIVE (returns HL=0)
1000  FE99 38 1D                JR C,SELDSK_BAD_DRIVE
1001  FE9B 7E                   LD A,(HL)
1002  FE9C 12                   LD (DE),A
1003  FE9D 13                   INC DE
1004  FE9E 79                   LD A,C
1005  FE9F 12                   LD (DE),A
1006  FEA0                      ; HL = DPH table base ($FA33); CALL SLOT_IO_SCALE indexes it by C*16
1007  FEA0 21 33 FA             LD HL,DPH_TABLE
1008  FEA3 CD 85 FE             CALL SLOT_IO_SCALE
1009  FEA6 E5                   PUSH HL
1010  FEA7 11 0A 00             LD DE,$000A
1011  FEAA 19                   ADD HL,DE
1012  FEAB 5E                   LD E,(HL)
1013  FEAC 23                   INC HL
1014  FEAD 56                   LD D,(HL)
1015  FEAE 21 05 00             LD HL,$0005
1016  FEB1 19                   ADD HL,DE
1017  FEB2 7E                   LD A,(HL)
1018  FEB3                      ; self-modify: store the per-drive disk-parameter byte into the install template's LD
1019  FEB3                      ; HL,(nn) operand [RE]
1020  FEB3 32 E3 FE             LD (SECTOR_BLOCK_PATCH+1),A
1021  FEB6 E1                   POP HL
1022  FEB7 C9                   RET
1023  FEB8              ; ----------------------------------------------------------------------
1024  FEB8              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH). [RE]
1025  FEB8              ;   In:  DE -> sekdsk build site. Out: HL=0. Clobbers: A,L.
1026  FEB8              ;   Twin of 2.20 SELDSK_BAD_DRIVE. [RE]
1027  FEB8              ; ----------------------------------------------------------------------
1028  FEB8              SELDSK_BAD_DRIVE:
1029  FEB8 1A                   LD A,(DE)
1030  FEB9 77                   LD (HL),A
1031  FEBA                      ; HL=0 signals an invalid drive to the BDOS
1032  FEBA 2E 00                LD L,$00
1033  FEBC C9                   RET
1034  FEBD              ; ----------------------------------------------------------------------
1035  FEBD              ; READ -- BIOS jump-vector entry 13 ($FA27): read one 128-byte CP/M record.
1036  FEBD              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1037  FEBD              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS read core at $AC39, which sits
1038  FEBD              ;     in the system-image region BELOW the BIOS (not inside $FA00-$FFFF). FLAG: unlike
1039  FEBD              ;     the 2.20 twin, the 2.23 BIOS does NOT carry the deblock or the $03E0-IOB RWTS RPC
1040  FEBD              ;     in-image; READ/WRITE delegate to the $ACxx host-sector routines. [RE] -- see flags.
1041  FEBD              ; ----------------------------------------------------------------------
1042  FEBD              READ:
1043  FEBD                      ; off-image jump to the deblock/RWTS read core at $AC39 (system-image region, not BIOS) [RE]
1044  FEBD C3 39 AC             JP $AC39
1045  FEC0              ; ----------------------------------------------------------------------
1046  FEC0              ; WRITE -- BIOS jump-vector entry 14 ($FA2A): write one 128-byte CP/M record.
1047  FEC0              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1048  FEC0              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS write core at $AC49 (system-image
1049  FEC0              ;     region below the BIOS). Same off-image RWTS delegation as READ_RECORD. [RE]
1050  FEC0              ;   NOTE: the bytes at $FEC3-$FECA ($C3 $45 $FB $2A $0D $9C $E9 $C9) immediately after
1051  FEC0              ;     this JP are NOT executed on the WRITE path; they are install/handler scratch -- see flags.
1052  FEC0              ; ----------------------------------------------------------------------
1053  FEC0              WRITE:
1054  FEC0                      ; off-image jump to the deblock/RWTS write core at $AC49 (system-image region, not BIOS)
1055  FEC0                      ; [RE]
1056  FEC0 C3 49 AC             JP $AC49
1057  FEC3 C3 45 FB 2A          DEFB    $C3,$45,$FB,$2A,$0D      ; "CE{*"
1057  FEC7 0D
1058  FEC8 9C E9 C9             DEFB    $9C,$E9,$C9
1059  FECB              COL_FLAG:
1060  FECB 00                   DEFB    "\0"
1061  FECC              COL_PENDING:
1062  FECC 00                   DEFB    "\0"
1063  FECD              COL_STATE:
1064  FECD 00                   DEFB    "\0"
1065  FECE              SCREEN_CURSOR_PTR:
1066  FECE D0 FE                DEFB    $D0,$FE
1067  FED0              SCREEN_CHAR:
1068  FED0 00                   DEFB    "\0"
1069  FED1              ; ----------------------------------------------------------------------
1070  FED1              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector entry 0; $FA00 -> here at $FED1).
1071  FED1              ;   In:  none. Out: does not return through here (falls into the install engine).
1072  FED1              ;   Clobbers: all.
1073  FED1              ;   DUAL USE of the operand bytes: this 'LD SP,$0100' executes ONCE at cold boot to set
1074  FED1              ;     the Z-80 stack; afterwards BOOT (the $00 operand byte) is reused as sektrk and
1075  FED1              ;     BOOT+1 as seksec (SETTRK stores BOOT at $FE78, SETSEC stores
1076  FED1              ;     BOOT+1 at $FBF5), and BOOT+2 ($FED3) is read as a console cursor word
1077  FED1              ;     ($FBD3 LD HL,(BOOT+2)). Valid SP-init bytes only during the single cold-boot
1078  FED1              ;     pass; thereafter disk/console scratch, never re-executed. Twin of 2.20 BOOT. [RE]
1079  FED1              ;   Algorithm: set SP, then fall through into the self-modifying install engine
1080  FED1              ;     (BOOT_TMPL_XORA..SECTOR_BLOCK_PATCH are template-instruction cells whose operands double as
1081  FED1              ;     disk-deblock state).
1082  FED1              ; ----------------------------------------------------------------------
1083  FED1              BOOT:
1084  FED1                      ; init Z-80 stack; BOOT/+1/+2 reused post-boot as sektrk/seksec and a console cursor word
1085  FED1 31 00 01             LD SP,$0100
1086  FED4              ; ----------------------------------------------------------------------
1087  FED4              ; BOOT_TMPL_XORA -- cold-boot install template 'XOR A'; operationally a disk-state cell.
1088  FED4              ;   Boot tenant: 'XOR A' clears A as the install engine starts the page-clear. Operational
1089  FED4              ;   tenant: this cell is referenced as a console/disk scratch base (LD HL,BOOT_TMPL_XORA at
1090  FED4              ;   $FBBA in the console path). Twin region of 2.20 DISK_SELDSK_SAVE. [RE]
1091  FED4              ; ----------------------------------------------------------------------
1092  FED4              BOOT_TMPL_XORA:
1093  FED4 AF                   XOR A
1094  FED5              ; ----------------------------------------------------------------------
1095  FED5              ; DISK_SEKDSK -- cold-boot install template 'LD HL,BIOS_VECTOR'; operationally the sekdsk cell.
1096  FED5              ;   Boot tenant: 'LD HL,nn' template the install engine steps over. Operational tenant:
1097  FED5              ;   SELDSK uses DE=DISK_SEKDSK as the sekdsk build site (selected disk number). Twin of
1098  FED5              ;   2.20 DISK_SEKDSK. [RE]
1099  FED5              ; ----------------------------------------------------------------------
1100  FED5              DISK_SEKDSK:
1101  FED5 21 00 FA             LD HL,BIOS_VECTOR
1102  FED8              ; ----------------------------------------------------------------------
1103  FED8              ; DISK_HSTACT -- cold-boot install template 'LD (HL),A'; operationally the hstact flag.
1104  FED8              ;   Boot tenant: part of the page-zero/template clear. Operational tenant: host-buffer-
1105  FED8              ;   active flag, cleared by HOME ($FE72) and by PAGEZERO_REBUILD ($FAE7), set when a host
1106  FED8              ;   sector is staged. Twin of 2.20 DISK_HSTWRT-area hstact. [RE]
1107  FED8              ; ----------------------------------------------------------------------
1108  FED8              DISK_HSTACT:
1109  FED8 77                   LD (HL),A
1110  FED9              ; ----------------------------------------------------------------------
1111  FED9              ; DISK_HSTWRT -- cold-boot install template 'INC HL'; operationally the hstwrt flag.
1112  FED9              ;   Boot tenant: 'INC HL' advances the install-clear pointer. Operational tenant: host-
1113  FED9              ;   buffer-dirty flag, read by HOME ($FE6C). Twin of 2.20 DISK_HSTWRT. [RE]
1114  FED9              ; ----------------------------------------------------------------------
1115  FED9              DISK_HSTWRT:
1116  FED9 23                   INC HL
1117  FEDA 77                   LD (HL),A
1118  FEDB 23                   INC HL
1119  FEDC 77                   LD (HL),A
1120  FEDD              ; ----------------------------------------------------------------------
1121  FEDD              ; BOOT_TMPL_IOBYTE -- cold-boot install template 'LD A,$95' (default IOBYTE immediate).
1122  FEDD              ;   Boot tenant: loads the default IOBYTE value $95 into A. Operational tenant: this cell
1123  FEDD              ;   is cleared by PAGEZERO_REBUILD ($FAE4) and used as a console-state byte. Twin of the
1124  FEDD              ;   2.20 DISK_HSTWRT 'LD A,$95' default-IOBYTE template. [RE]
1125  FEDD              ; ----------------------------------------------------------------------
1126  FEDD              BOOT_TMPL_IOBYTE:
1127  FEDD                      ; default CP/M IOBYTE immediate ($95) loaded at cold boot
1128  FEDD 3E 95                LD A,$95
1129  FEDF              ; ----------------------------------------------------------------------
1130  FEDF              ; DISK_DMAADR -- cold-boot install template 'LD ($0003),A' (store default IOBYTE);
1131  FEDF              ;     +2 operand reused as dmaadr.
1132  FEDF              ;   Boot tenant: stores the default IOBYTE into page-zero $0003 at cold boot. Operational
1133  FEDF              ;   tenant: SETDMA writes BC into DISK_DMAADR+2 ($FEE1) as the current DMA buffer address
1134  FEDF              ;   (SETDMA 'LD (DISK_DMAADR+2),BC'); the deblock record copy uses it. Twin of the 2.20
1135  FEDF              ;   DISK_WRTYPE/DISK_DMAADR overlay. [RE]
1136  FEDF              ; ----------------------------------------------------------------------
1137  FEDF              DISK_DMAADR:
1138  FEDF                      ; store the default IOBYTE into page-zero $0003; the operand cell (+2) doubles as dmaadr
1139  FEDF 32 03 00             LD ($0003),A
1140  FEE2              ; ----------------------------------------------------------------------
1141  FEE2              ; DISK_PARAM_TMPL -- cold-boot install template 'LD HL,($F3DE)'; SELDSK self-modifies +1.
1142  FEE2              ;   Boot tenant: 'LD HL,(nn)' loads a config word; the install engine continues at $FEE5.
1143  FEE2              ;   Operational tenant: SELDSK patches DISK_PARAM_TMPL+1 ($FEE3) with a per-drive disk-
1144  FEE2              ;   parameter byte. From $FEE5 the cold-boot INSTALL ENGINE proper runs (see body). Twin
1145  FEE2              ;   of 2.20 DISK_UNADSK template + the DEV_INSTALL flow. [RE]
1146  FEE2              ;   Algorithm (install engine from $FEE5): copy the RPC-trigger store address into
1147  FEE2              ;     RPC_TRIGGER_STORE+1; clear page-zero $0004; read the console card class from config
1148  FEE2              ;     $F3BB; for the device-6/Pascal-class console install the $FD99 status handler into
1149  FEE2              ;     the $F380 vector, else for the Videx/40-col classes self-modify the CONST handler
1150  FEE2              ;     (KBD_STATUS_40COL+1) so status reads come from the card; then install CONOUT/CONIN handler
1151  FEE2              ;     vectors via the handler lookups, print the sign-on banner, and enter the CCP.
1152  FEE2              ; ----------------------------------------------------------------------
1153  FEE2              SECTOR_BLOCK_PATCH:
1154  FEE2                      ; install template: load a config word (operand at +1 is self-modified by SELDSK with the
1155  FEE2                      ; disk param)
1156  FEE2 2A DE F3             LD HL,($F3DE)
1157  FEE5                      ; self-modify: write the SoftCard RPC-trigger store address into RPC_TRIGGER_STORE's LD
1158  FEE5                      ; (nn),A operand [RE]
1159  FEE5 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1160  FEE8 AF                   XOR A
1161  FEE9                      ; clear page-zero $0004 (current default drive)
1162  FEE9 32 04 00             LD ($0004),A
1163  FEEC                      ; read the configured console card class from the config block (Apple $03BB)
1164  FEEC 3A BB F3             LD A,($F3BB)
1165  FEEF                      ; card class 6 = device-6 / Pascal-firmware console (post-1980 path; absent in the 1980
1166  FEEF                      ; manual) [RE]
1167  FEEF FE 06                CP $06
1168  FEF1 20 0A                JR NZ,DEV_INSTALL_LIST
1169  FEF3                      ; device-6 console: install the $FD99 status handler
1170  FEF3 21 99 FD             LD HL,SET_SCREEN_BASE_1
1171  FEF6                      ; store it into the SoftCard console-status I/O vector cell (Apple $0380)
1172  FEF6 22 80 F3             LD ($F380),HL
1173  FEF9 D6 03                SUB $03
1174  FEFB 18 13                JR DEV_INSTALL_PUNCH
1175  FEFD              ; ----------------------------------------------------------------------
1176  FEFD              ; DEV_INSTALL_LIST -- install the LIST device-output handler from the config class. [RE]
1177  FEFD              ;   In:  install engine running. Out: patches the LIST output stub vector. Clobbers: A,HL.
1178  FEFD              ;   Algorithm: read the LIST card class (config $F3B9 = Apple $03B9), bias by 3; if a
1179  FEFD              ;     real device is configured, look up its handler (CALL HANDLER_LOOKUP) and store it
1180  FEFD              ;     into the LIST stub vector (DEV_OUT_1_JP+1). Twin of 2.20 DEV_INSTALL flow. [RE]
1181  FEFD              ; ----------------------------------------------------------------------
1182  FEFD              DEV_INSTALL_LIST:
1183  FEFD FE 05                CP $05
1184  FEFF 28 22                JR Z,DEV_INSTALL_READER
1185  FF01 D6 03                SUB $03
1186  FF03 38 1E                JR C,DEV_INSTALL_READER
1187  FF05 20 09                JR NZ,DEV_INSTALL_PUNCH
1188  FF07 21 15 FB             LD HL,KBD_STATUS_40COL+1
1189  FF0A 36 BE                LD (HL),$BE
1190  FF0C 23                   INC HL
1191  FF0D 23                   INC HL
1192  FF0E 36 1F                LD (HL),$1F
1193  FF10              ; ----------------------------------------------------------------------
1194  FF10              ; DEV_INSTALL_PUNCH -- install the PUNCH device-output handler from the config class. [RE]
1195  FF10              ;   Algorithm: read the PUNCH card class (config $F3BA = Apple $03BA), bias by 3; if
1196  FF10              ;     configured, look up the handler and store it into the PUNCH stub vector (DEV_OUT_2_JP+1); for
1197  FF10              ;     the higher class value also install a secondary handler into DEV_OUT_3_JP+1. Twin of 2.20
1198  FF10              ;     DEV_INSTALL flow. [RE]
1199  FF10              ; ----------------------------------------------------------------------
1200  FF10              DEV_INSTALL_PUNCH:
1201  FF10 F5                   PUSH AF
1202  FF11 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1203  FF14 F1                   POP AF
1204  FF15 22 B9 FC             LD (SCREEN_EMIT_3+1),HL
1205  FF18                      ; secondary handler lookup via the skip-idiom entry (HANDLER_LOOKUP_B); the FD cover byte at
1206  FF18                      ; DEV_HANDLER_LOOKUP_B is skipped [RE]
1207  FF18 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1208  FF1B 22 37 FB             LD (CONIN_DISPATCH+1),HL
1209  FF1E 3E 03                LD A,$03
1210  FF20 32 05 FB             LD (CCP_LAUNCH+1),A
1211  FF23              ; ----------------------------------------------------------------------
1212  FF23              ; DEV_INSTALL_READER -- build the default READER/list-output stub when none is configured.
1213  FF23              ;   Algorithm: when no real device class is configured, build the no-op stub at DEV_OUT_3_JP:
1214  FF23              ;     store $1A3E ('LD A,$1A' opcode+immediate) then $C9 ('RET') so the device returns a
1215  FF23              ;     constant. Twin of 2.20 DEV_INSTALL_4's DEV_OUT_3 build. [RE]
1216  FF23              ; ----------------------------------------------------------------------
1217  FF23              DEV_INSTALL_READER:
1218  FF23 3A B9 F3             LD A,($F3B9)
1219  FF26 D6 03                SUB $03
1220  FF28 38 06                JR C,INSTALL_DONE_DEVICES
1221  FF2A CD 84 FF             CALL DEV_HANDLER_LOOKUP
1222  FF2D 22 50 FE             LD (DEV_OUT_1_JP+1),HL
1223  FF30              ; ----------------------------------------------------------------------
1224  FF30              ; INSTALL_DONE_DEVICES -- run the device probe after the per-device installs. [RE]
1225  FF30              ;   Algorithm: CALL PROBE_DEVICES (PROBE_DEVICES) to scan the 7 SoftCard config slots and
1226  FF30              ;     mark/init each present card before the banner is printed. Twin of 2.20 DEV_INSTALL_6
1227  FF30              ;     PROBE_DEVICES call. [RE]
1228  FF30              ; ----------------------------------------------------------------------
1229  FF30              INSTALL_DONE_DEVICES:
1230  FF30 3A BA F3             LD A,($F3BA)
1231  FF33 D6 03                SUB $03
1232  FF35 38 14                JR C,SLOT_IO_SCALE_17
1233  FF37 F5                   PUSH AF
1234  FF38 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1235  FF3B 22 64 FE             LD (DEV_OUT_2_JP+1),HL
1236  FF3E F1                   POP AF
1237  FF3F FE 02                CP $02
1238  FF41 28 08                JR Z,SLOT_IO_SCALE_17
1239  FF43 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1240  FF46 22 6A FE             LD (DEV_OUT_3_JP+1),HL
1241  FF49 18 0B                JR SLOT_IO_SCALE_18
1242  FF4B              SLOT_IO_SCALE_17:
1243  FF4B 21 3E 1A             LD HL,$1A3E
1244  FF4E 22 69 FE             LD (DEV_OUT_3_JP),HL
1245  FF51 3E C9                LD A,$C9
1246  FF53 32 6B FE             LD (DEV_OUT_3_JP+2),A
1247  FF56              SLOT_IO_SCALE_18:
1248  FF56                      ; scan + init the 7 SoftCard config slots (device probe) before the sign-on
1249  FF56 CD 82 FA             CALL PROBE_DEVICES
1250  FF59              ; ----------------------------------------------------------------------
1251  FF59              ; SIGNON_PRINT -- emit the two config-derived sign-on prefix chars, then the banner. [RE]
1252  FF59              ;   In:  none. Out: prints the sign-on. Clobbers: A,HL.
1253  FF59              ;   Algorithm: read config $F398 (Apple $0398), pass it to the CONOUT writer (CONOUT_DISPATCH),
1254  FF59              ;     then walk SIGNON_BANNER (SIGNON_BANNER) char-by-char through CONOUT until the $00
1255  FF59              ;     terminator, then enter PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS). Twin of the 2.20
1256  FF59              ;     DEV_INSTALL_6/
1257  FF59              ;     DEV_INSTALL_7 banner loop (here it routes through CONOUT directly, not SIGNON_EMIT).
1258  FF59              ;     NOTE: WBOOT (WBOOT) also stashes SIGNON_PRINT into the $F3D0 RPC mailbox at
1259  FF59              ;     $FACE for a re-init path. [RE]
1260  FF59              ; ----------------------------------------------------------------------
1261  FF59              SIGNON_PRINT:
1262  FF59                      ; first config-derived sign-on char (Apple $0398)
1263  FF59 3A 98 F3             LD A,($F398)
1264  FF5C                      ; emit it via SIGNON_EMIT (prefixes a config char if bit7 set), routed through CONOUT
1265  FF5C CD 8F FF             CALL SIGNON_EMIT
1266  FF5F                      ; HL -> the cold-boot sign-on banner string
1267  FF5F 21 9E FF             LD HL,SIGNON_BANNER
1268  FF62              ; ----------------------------------------------------------------------
1269  FF62              ; SIGNON_BANNER_LOOP -- print SIGNON_BANNER char-by-char until the $00 terminator. [RE]
1270  FF62              ;   In:  HL -> banner. Out: jumps to PAGEZERO_REBUILD at the terminator. Clobbers: A,HL.
1271  FF62              ;   Algorithm: load (HL); if $00 jump to PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS) to finish cold
1272  FF62              ;     boot; else push HL, CALL CONOUT (CONOUT_DISPATCH), pop, INC HL, repeat. Twin of 2.20
1273  FF62              ;     DEV_INSTALL_7. [RE]
1274  FF62              ; ----------------------------------------------------------------------
1275  FF62              SIGNON_BANNER_LOOP:
1276  FF62 7E                   LD A,(HL)
1277  FF63 B7                   OR A
1278  FF64                      ; banner terminator -> PAGEZERO_REBUILD (write page-zero hooks, enter the CCP)
1279  FF64 CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1280  FF67 E5                   PUSH HL
1281  FF68                      ; emit one banner char via CONOUT
1282  FF68 CD 4C FB             CALL CONOUT_DISPATCH
1283  FF6B E1                   POP HL
1284  FF6C 23                   INC HL
1285  FF6D 18 F3                JR SIGNON_BANNER_LOOP
1286  FF6F              SLOT_IO_SCALE_21:
1287  FF6F 0E FD                LD C,$FD
1288  FF71 71                   LD (HL),C
1289  FF72 FD                   DEFB $FD  ; ignored IY prefix; inner: LD D,D
1290  FF73 52                   LD D,D
1291  FF74 FE A9                CP $A9
1292  FF76 FD                   DEFB $FD  ; ignored IY prefix; inner: LD B,D
1293  FF77              SLOT_IO_SCALE_22:
1294  FF77 42                   LD B,D
1295  FF78 FE C1                CP $C1
1296  FF7A FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1297  FF7B B7                   OR A
1298  FF7C FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1299  FF7D B7                   OR A
1300  FF7E              ; ----------------------------------------------------------------------
1301  FF7E              ; DEV_HANDLER_LOOKUP_B -- secondary-table handler lookup, entered at +1 via a skip idiom.
1302  FF7E              ;   In:  A = entry index. Out: HL = handler address from the secondary table. Clobbers: A,HL.
1303  FF7E              ;   SKIP IDIOM: the byte at DEV_HANDLER_LOOKUP_B ($FF7E) is an $FD cover (reads as 'LD IY,$FF77'
1304  FF7E              ;     when fallen into); every CALLER targets DEV_HANDLER_LOOKUP_B+1 ($FF7F) which executes
1305  FF7E              ;     'LD HL,SLOT_IO_SCALE_22' (the secondary DEV_HANDLER_PTRS_B base) then 'JR DEV_HANDLER_
1306  FF7E              ;     LOOKUP_IDX'. Twin of 2.20 DEV_HANDLER_LOOKUP_B (there a clean 'LD HL,..; JR'). [RE]
1307  FF7E              ;   -- see flags for the cover byte and the surrounding DEFB-as-code handler table.
1308  FF7E              ; ----------------------------------------------------------------------
1309  FF7E              DEV_HANDLER_LOOKUP_B:
1310  FF7E                      ; COVER: the FD prefix makes this 'LD IY,$FF77' on fall-in; callers enter at +1 => 'LD
1311  FF7E                      ;        HL,SLOT_IO_SCALE_22' (secondary table base) [RE]
1312  FF7E FD 21 77 FF          LD IY,SLOT_IO_SCALE_22
1313  FF82                      ; join the shared index tail (HL += A*2; load the word)
1314  FF82 18 03                JR DEV_HANDLER_LOOKUP_IDX
1315  FF84              ; ----------------------------------------------------------------------
1316  FF84              ; DEV_HANDLER_LOOKUP -- fetch a device-handler address from the primary pointer table.
1317  FF84              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1318  FF84              ;   Algorithm: HL = DEV_HANDLER_PTRS base (SLOT_IO_SCALE_21); fall into the shared scaler
1319  FF84              ;     (ADD A,A; ADD A,L; LD L,A) then load the 16-bit word at that slot (low then high).
1320  FF84              ;     The secondary-table entry is HANDLER_LOOKUP_B at DEV_HANDLER_LOOKUP_B+1 (skip idiom). Twin
1321  FF84              ;     of 2.20 DEV_HANDLER_LOOKUP. [RE]
1322  FF84              ; ----------------------------------------------------------------------
1323  FF84              DEV_HANDLER_LOOKUP:
1324  FF84                      ; select the primary device-handler pointer table
1325  FF84 21 6F FF             LD HL,SLOT_IO_SCALE_21
1326  FF87              ; ----------------------------------------------------------------------
1327  FF87              ; DEV_HANDLER_LOOKUP_IDX -- shared table-index tail: HL += A*2; HL = word at that slot.
1328  FF87              ;   In:  A = index, HL = table base. Out: HL = the 16-bit handler address. Clobbers: A,HL.
1329  FF87              ;   Twin of 2.20 DISK_RTN_LOOKUP_IDX. [RE]
1330  FF87              ; ----------------------------------------------------------------------
1331  FF87              DEV_HANDLER_LOOKUP_IDX:
1332  FF87                      ; index*2 for 16-bit (word) table entries
1333  FF87 87                   ADD A,A
1334  FF88 85                   ADD A,L
1335  FF89 6F                   LD L,A
1336  FF8A                      ; load handler address low byte
1337  FF8A 7E                   LD A,(HL)
1338  FF8B 2C                   INC L
1339  FF8C                      ; load handler address high byte -> HL = handler entry
1340  FF8C 66                   LD H,(HL)
1341  FF8D 6F                   LD L,A
1342  FF8E C9                   RET
1343  FF8F              ; ----------------------------------------------------------------------
1344  FF8F              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1345  FF8F              ;   In:  A = byte/flag. Out: prints via CONOUT (CONOUT_DISPATCH). Clobbers: A,HL.
1346  FF8F              ;   Algorithm: if A is positive (bit7 clear) emit it directly via CONOUT; if negative,
1347  FF8F              ;     first emit the prefix char from config $F397 (Apple $0397), then tail-jump to
1348  FF8F              ;     CONOUT to emit A. Twin of 2.20 SIGNON_EMIT. [RE]
1349  FF8F              ; ----------------------------------------------------------------------
1350  FF8F              SIGNON_EMIT:
1351  FF8F B7                   OR A
1352  FF90                      ; bit7 clear -> emit the char directly via CONOUT
1353  FF90 F2 9B FF             JP P,SIGNON_EMIT_CHAR
1354  FF93 F5                   PUSH AF
1355  FF94                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1356  FF94 3A 97 F3             LD A,($F397)
1357  FF97                      ; emit the prefix char via CONOUT
1358  FF97 CD 4C FB             CALL CONOUT_DISPATCH
1359  FF9A F1                   POP AF
1360  FF9B              ; ----------------------------------------------------------------------
1361  FF9B              ; SIGNON_EMIT_CHAR -- tail of SIGNON_EMIT: emit the original char via CONOUT. [RE]
1362  FF9B              ; ----------------------------------------------------------------------
1363  FF9B              SIGNON_EMIT_CHAR:
1364  FF9B                      ; tail-call CONOUT to emit the char
1365  FF9B C3 4C FB             JP CONOUT_DISPATCH
1366  FF9E              ; ----------------------------------------------------------------------
1367  FF9E              ; SIGNON_BANNER -- the cold-boot sign-on string, printed by SIGNON_BANNER_LOOP until $00.
1368  FF9E              ;   Reads (40-col uppercase / Videx mixed-case): CR/LF/LF/LF, '     Softcard CP/M', CR/LF,
1369  FF9E              ;   '     44K Ver. 2.23', CR/LF, '(c) 1980,1982 Microsoft', CR, LF/CR/LF, $00. DATA.
1370  FF9E              ;   NOTE: the 40-col Apple screen is uppercase-only so it renders 'SOFTCARD'; the Videx
1371  FF9E              ;   80-col card renders the mixed-case 'Softcard'. The trailing bytes from $FFE6 ($FA $E5
1372  FF9E              ;   ...) are NOT banner text -- they are an in-image copy of handler/lookup code; see flags.
1373  FF9E              ;   Twin of 2.20 SIGNON_BANNER (which reads 'Apple ][ CP/M' / '44K Ver. 2.20' /
1374  FF9E              ;   '(C) 1980 Microsoft'). [RE]
1375  FF9E              ; ----------------------------------------------------------------------
1376  FF9E              SIGNON_BANNER:
1377  FF9E 0D 0A 0A 0A          DEFB    "\r\n\n\n"
1378  FFA2 20 20 20 20          DEFB    "     Softcard CP/M"     ; string
1378  FFA6 20 53 6F 66
1378  FFAA 74 63 61 72
1378  FFAE 64 20 43 50
1378  FFB2 2F 4D
1379  FFB4 0D                   DEFB    $0D                      ; terminator
1380  FFB5 0A                   DEFB    "\n"
1381  FFB6 20 20 20 20          DEFB    "     44K Ver. 2.23"     ; string
1381  FFBA 20 34 34 4B
1381  FFBE 20 56 65 72
1381  FFC2 2E 20 32 2E
1381  FFC6 32 33
1382  FFC8 0D                   DEFB    $0D                      ; terminator
1383  FFC9 0A                   DEFB    "\n"
1384  FFCA 28 63 29 20          DEFB    "(c) 1980,1982 Microsoft" ; string
1384  FFCE 31 39 38 30
1384  FFD2 2C 31 39 38
1384  FFD6 32 20 4D 69
1384  FFDA 63 72 6F 73
1384  FFDE 6F 66 74
1385  FFE1 0D                   DEFB    $0D                      ; terminator
1386  FFE2 0A 0D 0A 00          DEFB    $0A,$0D,$0A,$00,$FA,$E5,$CD,$4C,$FB,$E1,$23,$18,$F3,$0E,$FD,$71
1386  FFE6 FA E5 CD 4C
1386  FFEA FB E1 23 18
1386  FFEE F3 0E FD 71
1387  FFF2 FD 52 FE A9          DEFB    $FD,$52,$FE,$A9,$FD,$42,$FE,$C1,$FD,$B7,$FD,$B7,$FD,$21
1387  FFF6 FD 42 FE C1
1387  FFFA FD B7 FD B7
1387  FFFE FD 21
1388  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1389  0000
1390  0000                  SAVEBIN "{out_bin}", $FA00, $0600
1391  0000                  IFNDEF CPM_LINK
1392  0000                  ; image size from bracketing labels; $FA00 = the ORG base (image wraps to $0000)
1393  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1394  0000                  ENDIF
1395  0000
# file closed: CPM_BIOS.asm

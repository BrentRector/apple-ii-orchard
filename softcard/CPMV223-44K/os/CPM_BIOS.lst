 818  FD83              SET_SCREEN_BASE:
 819  FD83 CD 7C FE             CALL SLOT_IO_ADDR_W
 820  FD86 32 F8 F6             LD ($F6F8),A
 821  FD89 32 47 F0             LD ($F047),A
 822  FD8C 3A FF EF             LD A,($EFFF)
 823  FD8F CD B1 FA             CALL DEVICE_IO_BASE
 824  FD92 D6 20                SUB $20
 825  FD94 32 46 F0             LD ($F046),A
 826  FD97 7E                   LD A,(HL)
 827  FD98 C9                   RET
 828  FD99              SET_SCREEN_BASE_1:
 829  FD99 21 14 0E             LD HL,$0E14
 830  FD9C 1E 03                LD E,$03
 831  FD9E 3E 01                LD A,$01
 832  FDA0 CD AD FD             CALL SET_CURSOR_COL_AND_BASE
 833  FDA3 3A 48 F0             LD A,($F048)
 834  FDA6 1F                   RRA
 835  FDA7 9F                   SBC A,A
 836  FDA8 C9                   RET
 837  FDA9 21 E1 0D 79          DEFB    $21,$E1,$0D,$79

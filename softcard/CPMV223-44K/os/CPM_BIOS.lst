 812  FD54 7D FE 28 38          DEFB    $7D,$FE,$28,$38,$02,$2E,$00,$7C,$FE,$18,$38,$02,$26,$00,$22,$24
 812  FD58 02 2E 00 7C
 812  FD5C FE 18 38 02

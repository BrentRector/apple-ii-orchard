 843  FDC1              ; SCREEN_RPC_HELPER -- read back a screen byte via the RPC: position, fire the RPC, fetch.
 844  FDC1              SCREEN_RPC_HELPER:
 845  FDC1 CD 83 FD             CALL SET_SCREEN_BASE                    ; compute the screen base for the current row
 846  FDC4 21 4D C8             LD HL,$C84D                      ; 6502 RPC parameter (Apple expansion-ROM addr)
 847  FDC7 CD 45 FB             CALL RPC_TRIGGER                 ; run the embedded 6502 service on the 6502
 848  FDCA 21 78 F6             LD HL,$F678                      ; HL = row buffer base (Apple $0678)
 849  FDCD 19                   ADD HL,DE
 850  FDCE 7E                   LD A,(HL)                        ; read back the character
 851  FDCF C9                   RET
 852  FDD0              ; RPC6502_SERVICE_223 -- the embedded 6502 RPC service ($FDD0-$FE41 = Apple $0DD0); its
 853  FDD0              ; own ca65 source CPM_RPC6502_223.s is sub-assembled and INCBIN'd here (the 2.20
 854  FDD0              ; CPM_RPC6502 pattern). It forms a slot-ROM pointer ($CFFF disables expansion ROM),
 855  FDD0              ; LDA ($F6),Y, and JMP ($00F6) dispatches into the selected slot-ROM/firmware routine.
 856  FDD0              RPC6502_SERVICE_223:
 857  FDD0              ;   >>> CPM_RPC6502_223.s -- verbatim listing of the INCBIN'd source (regen: inject_incbin_listing) >>>
 858  FDD0              ;
 859  FDD0              ; .org $0DD0
 860  FDD0              ;
 861  FDD0              ; L_0DD0:
 862  FDD0              ;         PHA                          ; $0DD0  48
 863  FDD0              ;         JSR SUB_0E1D                 ; $0DD1  20 1D 0E
 864  FDD0              ;         LDY #$0D                     ; $0DD4  A0 0D
 865  FDD0              ; L_0DD6:
 866  FDD0              ;         LDA ($F6),Y                  ; $0DD6  B1 F6
 867  FDD0              ;         STA $F6                      ; $0DD8  85 F6
 868  FDD0              ;         LDY $06F8                    ; $0DDA  AC F8 06
 869  FDD0              ;         PLA                          ; $0DDD  68
 870  FDD0              ;         JMP ($00F6)                ; $0DDE  6C F6 00
 871  FDD0              ; L_0DE1:
 872  FDD0              ;         PHA                          ; $0DE1  48
 873  FDD0              ;         LDA #$00                     ; $0DE2  A9 00
 874  FDD0              ;         JSR SUB_0DEF                 ; $0DE4  20 EF 0D
 875  FDD0              ;         JSR SUB_0E1D                 ; $0DE7  20 1D 0E
 876  FDD0              ;         LDY #$0F                     ; $0DEA  A0 0F
 877  FDD0              ;         JMP L_0DD6                   ; $0DEC  4C D6 0D
 878  FDD0              ; SUB_0DEF:
 879  FDD0              ;         STY $F5                      ; $0DEF  84 F5
 880  FDD0              ;         PHA                          ; $0DF1  48
 881  FDD0              ;         JSR SUB_0E14                 ; $0DF2  20 14 0E
 882  FDD0              ;         PLA                          ; $0DF5  68
 883  FDD0              ;         LDY $F5                      ; $0DF6  A4 F5
 884  FDD0              ;         BCC SUB_0DEF                 ; $0DF8  90 F5
 885  FDD0              ;         RTS                          ; $0DFA  60
 886  FDD0              ;         .byte   $00, $00, $00, $00, $00, $4C, $E9, $BB, $4C, $04, $BE, $A9, $01, $20, $EF, $0D ; $0DFB
 887  FDD0              ;         .byte   $20, $1D, $0E, $48, $A0, $0E, $4C, $D6, $0D      ; $0E0B
 888  FDD0              ; SUB_0E14:
 889  FDD0              ;         PHA                          ; $0E14  48
 890  FDD0              ;         JSR SUB_0E1D                 ; $0E15  20 1D 0E
 891  FDD0              ;         LDY #$10                     ; $0E18  A0 10
 892  FDD0              ;         JMP L_0DD6                   ; $0E1A  4C D6 0D
 893  FDD0              ; SUB_0E1D:
 894  FDD0              ;         TYA                          ; $0E1D  98
 895  FDD0              ;         ORA #$C0                     ; $0E1E  09 C0
 896  FDD0              ;         TAX                          ; $0E20  AA
 897  FDD0              ;         TYA                          ; $0E21  98
 898  FDD0              ;         ASL                          ; $0E22  0A
 899  FDD0              ;         ASL                          ; $0E23  0A
 900  FDD0              ;         ASL                          ; $0E24  0A
 901  FDD0              ;         ASL                          ; $0E25  0A
 902  FDD0              ;         TAY                          ; $0E26  A8
 903  FDD0              ;         STY $06F8                    ; $0E27  8C F8 06
 904  FDD0              ;         LDA #$00                     ; $0E2A  A9 00
 905  FDD0              ;         STA $F6                      ; $0E2C  85 F6
 906  FDD0              ;         STX $F7                      ; $0E2E  86 F7
 907  FDD0              ;         LDA $CFFF                    ; $0E30  AD FF CF
 908  FDD0              ;         LDA ($F6),Y                  ; $0E33  B1 F6
 909  FDD0              ;         RTS                          ; $0E35  60
 910  FDD0              ; SUB_0E1D_1:
 911  FDD0              ;         LDA $48                      ; $0E36  A5 48
 912  FDD0              ;         PHA                          ; $0E38  48
 913  FDD0              ;         LDA $45                      ; $0E39  A5 45
 914  FDD0              ;         LDX $46                      ; $0E3B  A6 46
 915  FDD0              ;         LDY $47                      ; $0E3D  A4 47
 916  FDD0              ;         PLP                          ; $0E3F  28

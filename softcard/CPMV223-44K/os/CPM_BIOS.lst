 784  FDAD 32 45 F0             LD ($F045),A
 785  FDB0              PLOT_CHAR_RPC:
 786  FDB0 7B                   LD A,E
 787  FDB1 32 47 F0             LD ($F047),A
 788  FDB4 C3 45 FB             JP RPC_TRIGGER
 789  FDB7              PLOT_CHAR_RPC_1:

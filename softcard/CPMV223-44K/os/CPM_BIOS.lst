# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.23 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 2.23-44K BIOS runs at z80 $FA00-$FFFF (6 pages) = Apple $0A00-$0FFF LOW RAM
   5  0000              ; (NOT $AA00 like 2.20 -- a different mechanism). Decoded against the de-skewed
   6  0000              ; runtime image; the disk producer re-applies the sector skew (deskew.py ::
   7  0000              ; BIOS_PAGE_TO_SECTOR_223). $FA00 = the 15-entry BIOS jump vector.
   8  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
   9  0000              ; being enriched to the C-level bar.
  10  0000              ; ============================================================================
  11  0000
  12  0000                  IFNDEF CPM_LINK
  13  0000                  DEVICE NOSLOT64K
  14  0000                  ORG $FA00
  15  FA00                  ENDIF
  16  FA00
  17  FA00              ; ----------------------------------------------------------------------
  18  FA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector (2.23-44K, runtime $FA00).
  19  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  20  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  21  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  22  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  23  FA00              ;   Note: the CONOUT target ($FB4D) is the second-instruction entry of
  24  FA00              ;         CONOUT_DISPATCH (skips its leading LD C,A); see flags. [RE]
  25  FA00              ; ----------------------------------------------------------------------
  26  FA00              BIOS_VECTOR:
  27  FA00                      ; entry 0 = cold boot (BOOT, lives in the $FE85 band, out of this scope)
  28  FA00 C3 D1 FE             JP BOOT
  29  FA03              ; ----------------------------------------------------------------------
  30  FA03              ; BIOS_VECTOR_WBOOT -- jump-table entries 1..14 (WBOOT .. WRITE).
  31  FA03              ;   Same 14-entry layout as the 2.20-44K twin; only the target addresses move
  32  FA03              ;   ($FA-band, not $AA). CONOUT ($FA0C) targets CONOUT_DISPATCH+1 ($FB4D). [RE]
  33  FA03              ; ----------------------------------------------------------------------
  34  FA03              BIOS_VECTOR_WBOOT:
  35  FA03                      ; jump table
  36  FA03                      ; entry 1 = WBOOT: reload CCP, rebuild page zero
  37  FA03 C3 B8 FA             JP      WBOOT
  38  FA06                      ; entry 2 = CONST: console status via IOBYTE
  39  FA06 C3 10 FB             JP      CONST
  40  FA09                      ; entry 3 = CONIN: dispatch + function/arrow remap
  41  FA09 C3 1A FB             JP      CONIN
  42  FA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  43  FA0C C3 4D FB             JP      $FB4D
  44  FA0F                      ; entry 5 = LIST: route by IOBYTE LIST field
  45  FA0F C3 70 FB             JP      LIST
  46  FA12                      ; entry 6 = PUNCH: route by IOBYTE PUNCH field
  47  FA12 C3 7F FB             JP      PUNCH
  48  FA15                      ; entry 7 = READER: route by IOBYTE READER field
  49  FA15 C3 91 FB             JP      READER
  50  FA18                      ; entry 8 = HOME (out of this scope, $FDB0 band)
  51  FA18 C3 6C FE             JP      HOME
  52  FA1B                      ; entry 9 = SELDSK (out of this scope, $FE85 band)
  53  FA1B C3 8E FE             JP      SELDSK
  54  FA1E                      ; entry 10 = SETTRK (out of this scope, $FE77)
  55  FA1E C3 77 FE             JP      $FE77
  56  FA21                      ; entry 11 = SETSEC: store sector into deblock scratch
  57  FA21 C3 F4 FB             JP      SETSEC
  58  FA24                      ; entry 12 = SETDMA: store DMA address into deblock scratch
  59  FA24 C3 F9 FB             JP      SETDMA
  60  FA27                      ; entry 13 = READ (out of this scope, $FE85 band)
  61  FA27 C3 BD FE             JP      READ
  62  FA2A                      ; entry 14 = WRITE (out of this scope, $FE85 band)
  63  FA2A C3 C0 FE             JP      WRITE
  64  FA2D              ; ----------------------------------------------------------------------
  65  FA2D              ; The last two jump-table slots are not JPs: both handlers are short enough to sit
  66  FA2D              ; INLINE in the table, which is legal because nothing after entry 16 needs a fixed
  67  FA2D              ; offset. They used to be dumped here as an opaque DEFB run described as a
  68  FA2D              ; "post-vector trailer ... not reached as code here", which was wrong twice over:
  69  FA2D              ; the BDOS reaches both through the jump table, and the bytes are ordinary Z-80. [RE]
  70  FA2D              ; ----------------------------------------------------------------------
  71  FA2D              ; LISTST -- entry 15: report list-device status.
  72  FA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
  73  FA2D              ;   Algorithm: XOR A / RET. A=0 means "not ready" per the CP/M 2.2 convention, and
  74  FA2D              ;     because it never returns $FF the BDOS never waits on printer status. The
  75  FA2D              ;     SoftCard has no list device to poll, so a constant answer is the whole
  76  FA2D              ;     implementation. Same two bytes in the 2.20-44K and 2.23-60K twins. [RE]
  77  FA2D              ; ----------------------------------------------------------------------
  78  FA2D              LISTST:
  79  FA2D AF                   XOR A
  80  FA2E C9                   RET
  81  FA2F 00                   DEFB    $00                      ; pad: realigns SECTRAN onto the 3-byte slot grid
  82  FA30              ; ----------------------------------------------------------------------
  83  FA30              ; SECTRAN -- entry 16: logical-to-physical sector translate (identity).
  84  FA30              ;   In:  BC = logical sector, DE = translate-table address (ignored).
  85  FA30              ;   Out: HL = BC (physical == logical).  Clobbers: H, L.
  86  FA30              ;   Algorithm: LD H,B / LD L,C / RET. The DPH XLT field is 0 for every drive, so the
  87  FA30              ;     BDOS asks for no translation and this returns its argument unchanged; the skew
  88  FA30              ;     is applied by the disk producer, off-image. Same three bytes in both twins. [RE]
  89  FA30              ; ----------------------------------------------------------------------
  90  FA30              SECTRAN:
  91  FA30 60                   LD H,B
  92  FA31 69                   LD L,C
  93  FA32 C9                   RET
  94  FA33              ; ----------------------------------------------------------------------
  95  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
  96  FA33              ;   drive 0..3; 2.23 supports 4 drives, vs 6 in the 2.20 twin). SELDSK returns
  97  FA33              ;   DPH_TABLE + 16*drive. Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV,
  98  FA33              ;   ALV. XLT = 0 (no SECTRAN translate). All drives share one DIRBUF and one DPB.
  99  FA33              ;   The per-drive strides are the DPB's own fields: CSV is CKS = 12 bytes, ALV is
 100  FA33              ;   DSM/8 + 1 = 139/8 + 1 = 18 bytes. [RE]
 101  FA33              ; ----------------------------------------------------------------------
 102  FA33              ; DIRBUF, ALV_VECTORS and CSV_VECTORS are the BDOS scratch buffers this table hands out.
 103  FA33              ; They are declared at the foot of this file (see "BDOS scratch overlay"), because they
 104  FA33              ; are a SECOND tenant of bytes the cold-boot code owns: the layout is set out there with
 105  FA33              ; its own ORG, so each field is a real label rather than a magic address.
 106  FA33              DPH_TABLE:
 107  FA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
 107  FA37 00 00 00 00
 107  FA3B E4 FE 73 FA
 107  FA3F AC FF 64 FF
 108  FA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+18   ; drive 1
 108  FA47 00 00 00 00
 108  FA4B E4 FE 73 FA
 108  FA4F B8 FF 76 FF
 109  FA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+36   ; drive 2
 109  FA57 00 00 00 00
 109  FA5B E4 FE 73 FA
 109  FA5F C4 FF 88 FF
 110  FA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+54   ; drive 3
 110  FA67 00 00 00 00
 110  FA6B E4 FE 73 FA
 110  FA6F D0 FF 9A FF
 111  FA73              ; ----------------------------------------------------------------------
 112  FA73              ; DPB -- the shared Disk Parameter Block (5.25" floppy; every DPH points here).
 113  FA73              ;   One label per field, so the field names are symbols rather than prose. The ten names
 114  FA73              ;   are Digital Research's CP/M 2.2 DPB field names. NOT [DOC]-citable from this archive:
 115  FA73              ;   the SoftCard manual set documents only the BDOS call that RETURNS a DPB pointer
 116  FA73              ;   (fn 31, Get Addr (disk parms)), not the block's layout.
 117  FA73              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 118  FA73              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track. [RE]
 119  FA73              ;   This block is byte-identical to the 2.20-44K twin's except for DSM (see below). [RE]
 120  FA73              ; ----------------------------------------------------------------------
 121  FA73              DPB:
 122  FA73 20 00        SPT:    DEFW    $0020                    ; records per track: 32 x 128-byte records
 123  FA75 03           BSH:    DEFB    $03                      ; block shift: log2(records per block) -> 8 records
 124  FA76 07           BLM:    DEFB    $07                      ; block mask: (records per block) - 1 -> 1 KB blocks
 125  FA77 00           EXM:    DEFB    $00                      ; extent mask
 126  FA78              ; DSM is the ONLY byte in which this DPB differs from the 2.20-44K twin ($7F there).
 127  FA78              ;   The arithmetic does not close: 140 blocks / 4 blocks per track = 35 tracks of file
 128  FA78              ;   area, which with OFF=3 implies a 38-track disk; the medium is 35 tracks total. The
 129  FA78              ;   twin's $7F gives 32 + 3 = 35 exactly. What absorbs the surplus is a directory entry
 130  FA78              ;   present on every 2.23 disk: user byte $1F, lowercase name "cp/m    sys", allocation
 131  FA78              ;   list exactly blocks 128-139 -- the twelve blocks past the twin's 128. The BDOS's
 132  FA78              ;   allocation-vector rebuild skips only $E5 entries and does not range-check the user
 133  FA78              ;   number, so that entry is honoured and those twelve blocks stay marked in use.
 134  FA78              ;   Whether $8B is an error masked by that entry or a deliberate convention is NOT
 135  FA78              ;   determinable from any byte on these disks. [RE]
 136  FA78 8B 00        DSM:    DEFW    $008B                    ; highest allocation block number: 139 -> 140 blocks
 137  FA7A 2F 00        DRM:    DEFW    $002F                    ; highest directory entry number: 47 -> 48 entries
 138  FA7C C0           AL0:    DEFB    $C0                      ; directory-reserved blocks, bitmap, high byte -> 2
 139  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 140  FA7E 0C 00        CKS:    DEFW    $000C                    ; directory checksum bytes
 141  FA80 03 00        OFF:    DEFW    $0003                    ; reserved tracks before the file area
 142  FA82              ; ----------------------------------------------------------------------
 143  FA82              ; PROBE_DEVICES -- scan the SoftCard device/config area and mark presence.
 144  FA82              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 145  FA82              ;   Out: config bytes updated in place; per-device init called when a device is found.
 146  FA82              ;   Clobbers: A,DE,HL.
 147  FA82              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E].  If it equals 3 the slot
 148  FA82              ;     holds a recognized device, so call SLOT_IO_ADDR and store $03 then $15 into the
 149  FA82              ;     cell to flag it configured.  A secondary DEC A test (original value 4, e.g. a
 150  FA82              ;     Videx-class 80-col console) runs SET_SCREEN_BASE and claims the $C800 shared
 151  FA82              ;     expansion-ROM window via RPC_TRIGGER; a value-2 path repoints a vector via
 152  FA82              ;     PLOT_CHAR_RPC ($0DD0 param).  Same shape as the 2.20 twin's PROBE_DEVICES. [RE]
 153  FA82              ; ----------------------------------------------------------------------
 154  FA82              PROBE_DEVICES:
 155  FA82                      ; DE = 7 entries to scan (index walks down to 1)
 156  FA82 11 07 00             LD DE,$0007
 157  FA85              PROBE_DEVICES_LOOP:
 158  FA85                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 159  FA85 21 B8 F3             LD HL,$F3B8
 160  FA88 19                   ADD HL,DE
 161  FA89 7E                   LD A,(HL)
 162  FA8A                      ; config value 3 = a recognized/present device in this slot
 163  FA8A D6 03                SUB $03
 164  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 165  FA8E                      ; build the slot I/O base for the found device (SLOT_IO_ADDR)
 166  FA8E CD 81 FE             CALL SLOT_IO_ADDR
 167  FA91                      ; rewrite the cell: $03 then $15 = mark this device configured
 168  FA91 36 03                LD (HL),$03
 169  FA93 36 15                LD (HL),$15
 170  FA95              PROBE_DEVICES_CHK4:
 171  FA95                      ; after the SUB, A==1 means the original value was 4 (Videx-class 80-col console)
 172  FA95 3D                   DEC A
 173  FA96 20 0B                JR NZ,PROBE_DEVICES_CHK2
 174  FA98                      ; console probe / select the 80-col screen base (SET_SCREEN_BASE)
 175  FA98 CD 83 FD             CALL SET_SCREEN_BASE
 176  FA9B                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 177  FA9B 21 00 C8             LD HL,$C800
 178  FA9E CD 45 FB             CALL RPC_TRIGGER
 179  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 180  FAA3              PROBE_DEVICES_CHK2:
 181  FAA3                      ; value 2 = a different device class (e.g. printer/serial); takes the PLOT_CHAR_RPC path
 182  FAA3 FE 02                CP $02
 183  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 184  FAA7                      ; param for the value-2 vector init ($0DD0)
 185  FAA7 21 D0 0D             LD HL,$0DD0
 186  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 187  FAAD              PROBE_DEVICES_NEXT:
 188  FAAD                      ; next config entry; loop until all 7 scanned
 189  FAAD 1D                   DEC E
 190  FAAE 20 D5                JR NZ,PROBE_DEVICES_LOOP
 191  FAB0 C9                   RET
 192  FAB1              ; ----------------------------------------------------------------------
 193  FAB1              ; DEVICE_IO_BASE -- form a SoftCard I/O / soft-switch address from a device/offset index.
 194  FAB1              ;   In:  E = low offset within the I/O page.
 195  FAB1              ;   Out: HL = ((E | $E0) << 8), an address in z80 $E000-$EFFF = Apple I/O $C000-$CFFF;
 196  FAB1              ;        A clobbered.
 197  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 198  FAB1              ;        page, then H = A.  Used to reach keyboard / soft switches / slot I/O.
 199  FAB1              ;        Same as the 2.20 twin's DEVICE_IO_BASE (distinct from SLOT_IO_ADDR at $FE81). [RE]
 200  FAB1              ; ----------------------------------------------------------------------
 201  FAB1              DEVICE_IO_BASE:
 202  FAB1                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 203  FAB1 21 00 E0             LD HL,$E000
 204  FAB4 7B                   LD A,E
 205  FAB5                      ; force the high byte into the $C0xx I/O range
 206  FAB5 B4                   OR H
 207  FAB6 67                   LD H,A
 208  FAB7 C9                   RET
 209  FAB8              ; ----------------------------------------------------------------------
 210  FAB8              ; WBOOT -- CP/M warm boot: re-init the console, rebuild page zero, re-enter the CCP.
 211  FAB8              ;   In:  none.  Out: jumps to the CCP at $9300; does not return.  Clobbers: all.
 212  FAB8              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 213  FAB8              ;     (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 214  FAB8              ;     PROBE_DEVICES.  If the CCP image signature at $9C08 is intact ($9C) it falls
 215  FAB8              ;     into PAGEZERO_REBUILD; otherwise it reloads the CCP/system via a page-zero JP.
 216  FAB8              ;   Note: 2.23 reloads through a self-built $000B jump and enters the CCP at $9300
 217  FAB8              ;     (the 2.20 twin used $9400). [RE]
 218  FAB8              ; ----------------------------------------------------------------------
 219  FAB8              WBOOT:
 220  FAB8                      ; stack at the default DMA buffer top (page-zero $0080)
 221  FAB8 31 80 00             LD SP,$0080
 222  FABB                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 223  FABB 3A 51 E0             LD A,($E051)
 224  FABE 21 00 0E             LD HL,$0E00
 225  FAC1                      ; re-init the console I/O vectors (RPC_TRIGGER) for warm restart
 226  FAC1 CD 45 FB             CALL RPC_TRIGGER
 227  FAC4                      ; re-scan devices so warm boot rebuilds the I/O table
 228  FAC4 CD 82 FA             CALL PROBE_DEVICES
 229  FAC7                      ; read the CCP-image signature byte at $9C08
 230  FAC7 3A 08 9C             LD A,($9C08)
 231  FACA                      ; signature $9C present = CCP image intact, skip the reload
 232  FACA FE 9C                CP $9C
 233  FACC 28 11                JR Z,PAGEZERO_REBUILD
 234  FACE 21 59 FF             LD HL,SIGNON_PRINT
 235  FAD1 22 D0 F3             LD ($F3D0),HL
 236  FAD4 2A DE F3             LD HL,($F3DE)
 237  FAD7 3E 77                LD A,$77
 238  FAD9                      ; plant a $77 byte at page-zero $000B to bridge into the reload path
 239  FAD9 32 0B 00             LD ($000B),A
 240  FADC                      ; jump into the self-built page-zero reload bridge
 241  FADC C3 0B 00             JP $000B
 242  FADF              ; ----------------------------------------------------------------------
 243  FADF              ; PAGEZERO_REBUILD -- clear the CCP-restart flag, then write the page-zero hooks.
 244  FADF              ;   In:  none.  Out: falls into CCP_LAUNCH; no return.  Clobbers: A,HL,BC.
 245  FADF              ;   Algorithm: zero the CCP restart flag at $9307, then (PAGEZERO_REBUILD_HOOKS)
 246  FADF              ;     plant JP ($C3) at $0000 -> the BIOS WBOOT entry (BIOS_VECTOR+3, BIOS_VECTOR_WBOOT) and
 247  FADF              ;     JP at $0005 -> the BDOS entry $9C06; clear two self-modified BIOS state cells
 248  FADF              ;     ($FEDD/$FED8); set the default DMA to $0080 via SETDMA. [RE]
 249  FADF              ; ----------------------------------------------------------------------
 250  FADF              PAGEZERO_REBUILD:
 251  FADF AF                   XOR A
 252  FAE0                      ; clear the CCP restart/cold flag at $9307
 253  FAE0 32 07 93             LD ($9307),A
 254  FAE3              PAGEZERO_REBUILD_HOOKS:
 255  FAE3 AF                   XOR A
 256  FAE4                      ; clear a self-modified BIOS state cell ($FEDD)
 257  FAE4 32 DD FE             LD (BOOT_TMPL_IOBYTE),A
 258  FAE7                      ; clear a self-modified BIOS state cell ($FED8)
 259  FAE7 32 D8 FE             LD (DISK_HSTACT),A
 260  FAEA                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 261  FAEA 3E C3                LD A,$C3
 262  FAEC                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 263  FAEC 32 00 00             LD ($0000),A
 264  FAEF                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 265  FAEF 21 03 FA             LD HL,BIOS_VECTOR_WBOOT
 266  FAF2 22 01 00             LD ($0001),HL
 267  FAF5                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 268  FAF5 32 05 00             LD ($0005),A
 269  FAF8                      ; BDOS entry point ($9C06) for the $0005 hook
 270  FAF8 21 06 9C             LD HL,$9C06
 271  FAFB 22 06 00             LD ($0006),HL
 272  FAFE                      ; default DMA address = $0080 (page-zero buffer)
 273  FAFE 01 80 00             LD BC,$0080
 274  FB01                      ; install the default DMA pointer (SETDMA)
 275  FB01 CD F9 FB             CALL SETDMA
 276  FB04              ; ----------------------------------------------------------------------
 277  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, jump to the CCP.
 278  FB04              ;   In:  none.  Out: JP $9300 (CCP cold/warm entry); no return.  Clobbers: A,C.
 279  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $974E, pass the current default
 280  FB04              ;     drive (page-zero $0004) in C, and jump to the CCP at $9300. [RE]
 281  FB04              ; ----------------------------------------------------------------------
 282  FB04              CCP_LAUNCH:
 283  FB04                      ; CCP-mode flag value
 284  FB04 3E 01                LD A,$01
 285  FB06                      ; store the CCP entry/mode flag into CCP workspace at $974E
 286  FB06 32 4E 97             LD ($974E),A
 287  FB09                      ; page-zero $0004 = current default drive byte
 288  FB09 3A 04 00             LD A,($0004)
 289  FB0C 4F                   LD C,A
 290  FB0D                      ; enter the CCP at $9300, C = default drive (2.20 used $9400)
 291  FB0D C3 00 93             JP $9300
 292  FB10              ; ----------------------------------------------------------------------
 293  FB10              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 294  FB10              ;   In:  none.  Out: A = $FF (ready) / $00 (not).  Clobbers: A,HL.
 295  FB10              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 296  FB10              ;     cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler, which
 297  FB10              ;     returns the status in A.  Same as the 2.20 twin's CONST. [RE]
 298  FB10              ; ----------------------------------------------------------------------
 299  FB10              CONST:
 300  FB10                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 301  FB10 2A 80 F3             LD HL,($F380)
 302  FB13                      ; dispatch to the selected console-status handler (returns A)
 303  FB13 E9                   JP (HL)
 304  FB14              ; ----------------------------------------------------------------------
 305  FB14              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 306  FB14              ;   In:  none.  Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 307  FB14              ;   Clobbers: A.
 308  FB14              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard register; RLA shifts bit 7
 309  FB14              ;     (key-ready) into carry; SBC A,A expands carry to $FF/$00.  The built-in 40-col
 310  FB14              ;     CONST path used when no Videx/80-col card supplies the status vector. [RE]
 311  FB14              ; ----------------------------------------------------------------------
 312  FB14              KBD_STATUS_40COL:
 313  FB14                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 314  FB14 3A 00 E0             LD A,($E000)
 315  FB17                      ; rotate key-ready bit 7 into carry
 316  FB17 17                   RLA
 317  FB18                      ; carry -> A = $FF (ready) or $00 (none)
 318  FB18 9F                   SBC A,A
 319  FB19 C9                   RET
 320  FB1A              ; ----------------------------------------------------------------------
 321  FB1A              ; CONIN -- read a console character: IOBYTE-route the input, then remap the key.
 322  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,DE,HL.
 323  FB1A              ;   Algorithm: CALL CONIN_DISPATCH to fetch a raw key (routed by the IOBYTE CONSOLE
 324  FB1A              ;     field); clear the high bit; then scan a small remap table at Apple $03AB
 325  FB1A              ;     (z80 $F3AB) of up to 6 entries (function/arrow keys), returning the paired
 326  FB1A              ;     replacement byte on a match, else the raw key.
 327  FB1A              ;   Note: 2.23's CONIN jump-vector entry runs this remap wrapper; the 2.20 twin's
 328  FB1A              ;     equivalent is CONSOLE_IN_40COL.  Differs from a bare dispatcher. [RE]
 329  FB1A              ; ----------------------------------------------------------------------
 330  FB1A              CONIN:
 331  FB1A                      ; fetch a raw key in A via the IOBYTE-routed CONIN dispatcher
 332  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 333  FB1D                      ; strip the high bit (7-bit ASCII)
 334  FB1D E6 7F                AND $7F
 335  FB1F                      ; HL = key-remap table base (z80 $F3AB = Apple $03AB; first entry pair at $03AC)
 336  FB1F 21 AB F3             LD HL,$F3AB
 337  FB22                      ; up to 6 remap-table entries
 338  FB22 06 06                LD B,$06
 339  FB24                      ; C = raw key
 340  FB24 4F                   LD C,A
 341  FB25              ; ----------------------------------------------------------------------
 342  FB25              ; CONIN_XLATE_LOOP -- scan the function/arrow-key remap table.
 343  FB25              ;   In:  C = raw key; B = entry count; HL -> table base.
 344  FB25              ;   Out: A = translated key on match (returns), else loops; A = C on table end.
 345  FB25              ;   Algorithm: each entry = [match byte, replacement byte]; a high-bit sentinel
 346  FB25              ;     match byte ends the table. [RE]
 347  FB25              ; ----------------------------------------------------------------------
 348  FB25              CONIN_XLATE_LOOP:
 349  FB25 23                   INC HL
 350  FB26                      ; entry's match byte
 351  FB26 7E                   LD A,(HL)
 352  FB27 23                   INC HL
 353  FB28 B7                   OR A
 354  FB29                      ; high-bit sentinel ends the table
 355  FB29 FA 31 FB             JP M,CONIN_XLATE_DONE
 356  FB2C                      ; raw key == this entry?
 357  FB2C B9                   CP C
 358  FB2D                      ; paired replacement byte
 359  FB2D 7E                   LD A,(HL)
 360  FB2E                      ; match -> return the translated key
 361  FB2E C8                   RET Z
 362  FB2F 10 F4                DJNZ CONIN_XLATE_LOOP
 363  FB31              ; ----------------------------------------------------------------------
 364  FB31              ; CONIN_XLATE_DONE -- no remap match: return the raw key in A. [RE]
 365  FB31              ; ----------------------------------------------------------------------
 366  FB31              CONIN_XLATE_DONE:
 367  FB31                      ; no match -> return the raw key
 368  FB31 79                   LD A,C
 369  FB32 C9                   RET
 370  FB33              ; ----------------------------------------------------------------------
 371  FB33              ; CONIN_KEYWAIT -- seed the keyboard-wait dispatch index, then wait for a key.
 372  FB33              ;   In:  none.  Out: A = 7-bit key (via KBD_WAIT_KEY).  Clobbers: A,DE.
 373  FB33              ;   Algorithm: load DE = 3 (the default console index), then JP through the
 374  FB33              ;     self-modified CONIN_DISPATCH cell; at boot that target is patched to the
 375  FB33              ;     selected keyboard-wait handler (default KBD_WAIT_KEY). [RE]
 376  FB33              ; ----------------------------------------------------------------------
 377  FB33              CONIN_KEYWAIT:
 378  FB33                      ; DE = 3 = default console-device index
 379  FB33 11 03 00             LD DE,$0003
 380  FB36              ; ----------------------------------------------------------------------
 381  FB36              ; CONIN_DISPATCH -- self-modified keyboard-wait vector.
 382  FB36              ;   The JP target ($FB39 / KBD_WAIT_KEY by default) is patched at boot per the
 383  FB36              ;   selected console card.  Referenced as CONIN_DISPATCH+1 by the patch site. [RE]
 384  FB36              ; ----------------------------------------------------------------------
 385  FB36              CONIN_DISPATCH:
 386  FB36                      ; target (CONIN_DISPATCH+1) patched at boot to the chosen keyboard-wait handler
 387  FB36 C3 39 FB             JP KBD_WAIT_KEY
 388  FB39              ; ----------------------------------------------------------------------
 389  FB39              ; KBD_WAIT_KEY -- spin on the Apple keyboard register until a key is down.
 390  FB39              ;   In:  none.  Out: A = 7-bit key (high bit cleared).  Clobbers: A.
 391  FB39              ;   Algorithm: poll z80 $E000 = Apple $C000; RLA puts key-ready (bit 7) into carry,
 392  FB39              ;     spin while clear; on a key, clear the strobe at $E010 = Apple $C010 and return
 393  FB39              ;     the 7-bit key (CCF/RRA). [RE]
 394  FB39              ; ----------------------------------------------------------------------
 395  FB39              KBD_WAIT_KEY:
 396  FB39                      ; poll z80 $E000 = Apple $C000 keyboard register
 397  FB39 3A 00 E0             LD A,($E000)
 398  FB3C                      ; key-ready (bit 7) -> carry
 399  FB3C 17                   RLA
 400  FB3D                      ; spin until a key is down
 401  FB3D 30 FA                JR NC,KBD_WAIT_KEY
 402  FB3F                      ; clear the keyboard strobe (z80 $E010 = Apple $C010)
 403  FB3F 32 10 E0             LD ($E010),A
 404  FB42 3F                   CCF
 405  FB43                      ; A = 7-bit key
 406  FB43 1F                   RRA
 407  FB44 C9                   RET
 408  FB45              ; ----------------------------------------------------------------------
 409  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC.
 410  FB45              ;   In:  HL = command/params; A = trigger value.  Out: per the 6502 service routine.
 411  FB45              ;   Algorithm: stash HL to the command mailbox (z80 $F3D0 = Apple $03D0), then poke
 412  FB45              ;     the trigger cell.  The trigger store-address ($0000 here) is self-modified per
 413  FB45              ;     config at boot, so the store site is RPC_TRIGGER_STORE+1. [RE]
 414  FB45              ; ----------------------------------------------------------------------
 415  FB45              RPC_TRIGGER:
 416  FB45                      ; z80 $F3D0 = Apple $03D0 = RPC command/params mailbox
 417  FB45 22 D0 F3             LD ($F3D0),HL
 418  FB48              RPC_TRIGGER_STORE:
 419  FB48 32 00 00             LD ($0000),A
 420  FB4B C9                   RET
 421  FB4C              ; ----------------------------------------------------------------------
 422  FB4C              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE.
 423  FB4C              ;   In:  A = character (the BIOS CONOUT arg).  The jump-vector CONOUT entry targets
 424  FB4C              ;        CONOUT_DISPATCH+1 ($FB4D), skipping the leading LD C,A; the fall-through
 425  FB4C              ;        entry here (from the dispatcher) keeps it.
 426  FB4C              ;   Out: none.  Clobbers: A,C,HL.
 427  FB4C              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03).  Field
 428  FB4C              ;     value 2 dispatches through the SoftCard I/O vector at $F392 (Apple $0392) with
 429  FB4C              ;     JP (HL); otherwise fall into the column/tab filter. [RE]
 430  FB4C              ; ----------------------------------------------------------------------
 431  FB4C              CONOUT_DISPATCH:
 432  FB4C                      ; save the character to emit in C for the filter path (skipped by the +1 entry)
 433  FB4C 4F                   LD C,A
 434  FB4D                      ; read the CP/M IOBYTE (page-zero $0003)
 435  FB4D 3A 03 00             LD A,($0003)
 436  FB50                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 437  FB50 E6 03                AND $03
 438  FB52                      ; device value 2 = direct console; anything else takes the filter path
 439  FB52 FE 02                CP $02
 440  FB54 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 441  FB56              CONOUT_VIA_VEC_F392:
 442  FB56                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 443  FB56 2A 92 F3             LD HL,($F392)
 444  FB59 E9                   JP (HL)
 445  FB5A              ; ----------------------------------------------------------------------
 446  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE CONSOLE field.
 447  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 448  FB5A              ;   Algorithm: read IOBYTE, mask the CONSOLE field (AND $03).  Value 2 uses vector
 449  FB5A              ;     $F38A; the high value ($02<x) uses the preloaded $F384; low values use $F382;
 450  FB5A              ;     then JP (HL) into the chosen handler.  ($F38x = Apple $038x I/O vector.)
 451  FB5A              ;     Called by CONIN (the remap wrapper) and reused by READER. [RE]
 452  FB5A              ; ----------------------------------------------------------------------
 453  FB5A              CONIN_DISPATCH_IOBYTE:
 454  FB5A                      ; read the CP/M IOBYTE
 455  FB5A 3A 03 00             LD A,($0003)
 456  FB5D                      ; isolate the 2-bit CONSOLE device field
 457  FB5D E6 03                AND $03
 458  FB5F FE 02                CP $02
 459  FB61                      ; preload the input vector for the high CONSOLE value ($F384 = Apple $0384)
 460  FB61 2A 84 F3             LD HL,($F384)
 461  FB64 28 06                JR Z,CONIN_VIA_VEC_F38A
 462  FB66 30 07                JR NC,DISPATCH_VIA_HL
 463  FB68              CONIN_VIA_VEC_F382:
 464  FB68                      ; input vector for the low CONSOLE values ($F382 = Apple $0382)
 465  FB68 2A 82 F3             LD HL,($F382)
 466  FB6B E9                   JP (HL)
 467  FB6C              CONIN_VIA_VEC_F38A:
 468  FB6C                      ; input vector for CONSOLE value 2 ($F38A = Apple $038A)
 469  FB6C 2A 8A F3             LD HL,($F38A)
 470  FB6F              DISPATCH_VIA_HL:
 471  FB6F E9                   JP (HL)
 472  FB70              ; ----------------------------------------------------------------------
 473  FB70              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 474  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 475  FB70              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0).  Below $80
 476  FB70              ;     routes to the column/tab filter; == $80 reuses the console vector path
 477  FB70              ;     (CONOUT_VIA_VEC_F392); higher values dispatch through list vector $F394
 478  FB70              ;     (Apple $0394). [RE]
 479  FB70              ; ----------------------------------------------------------------------
 480  FB70              LIST:
 481  FB70 3A 03 00             LD A,($0003)
 482  FB73                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 483  FB73 E6 C0                AND $C0
 484  FB75 FE 80                CP $80
 485  FB77                      ; field < $80 -> no-device / filter path
 486  FB77 38 27                JR C,DISPATCH_NODEV
 487  FB79                      ; field == $80 -> reuse the console output vector path
 488  FB79 28 DB                JR Z,CONOUT_VIA_VEC_F392
 489  FB7B                      ; list-handler vector ($F394 = Apple $0394)
 490  FB7B 2A 94 F3             LD HL,($F394)
 491  FB7E E9                   JP (HL)
 492  FB7F              ; ----------------------------------------------------------------------
 493  FB7F              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 494  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 495  FB7F              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30).  Below $10 takes the
 496  FB7F              ;     column/tab filter; == $10 dispatches through vector $F38E; higher values use
 497  FB7F              ;     vector $F390.  ($F38E/$F390 = Apple $038E/$0390.) [RE]
 498  FB7F              ; ----------------------------------------------------------------------
 499  FB7F              PUNCH:
 500  FB7F 3A 03 00             LD A,($0003)
 501  FB82                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 502  FB82 E6 30                AND $30
 503  FB84 FE 10                CP $10
 504  FB86                      ; field < $10 -> no-device / filter path
 505  FB86 38 18                JR C,DISPATCH_NODEV
 506  FB88                      ; punch vector for the higher PUNCH values ($F38E = Apple $038E)
 507  FB88 2A 8E F3             LD HL,($F38E)
 508  FB8B                      ; field == $10 -> use the $F390 vector below
 509  FB8B 28 E2                JR Z,DISPATCH_VIA_HL
 510  FB8D                      ; punch vector for PUNCH value $10 ($F390 = Apple $0390)
 511  FB8D 2A 90 F3             LD HL,($F390)
 512  FB90 E9                   JP (HL)
 513  FB91              ; ----------------------------------------------------------------------
 514  FB91              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 515  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 516  FB91              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C), compare against $08. Field
 517  FB91              ;     < $08 ($00/$04) reuses the CONIN $F382 vector; == $08 reuses the CONIN $F38A vector;
 518  FB91              ;     > $08 ($0C) uses the reader vector $F38C (Apple $038C). [RE]
 519  FB91              ; ----------------------------------------------------------------------
 520  FB91              READER:
 521  FB91 3A 03 00             LD A,($0003)
 522  FB94                      ; isolate the 2-bit READER device field of the IOBYTE
 523  FB94 E6 0C                AND $0C
 524  FB96 FE 08                CP $08
 525  FB98                      ; field < $08 ($00/$04) -> reuse the CONIN $F382 vector path
 526  FB98 38 CE                JR C,CONIN_VIA_VEC_F382
 527  FB9A                      ; field == $08 -> reuse the CONIN $F38A vector path
 528  FB9A 28 D0                JR Z,CONIN_VIA_VEC_F38A
 529  FB9C                      ; reader-handler vector ($F38C = Apple $038C)
 530  FB9C 2A 8C F3             LD HL,($F38C)
 531  FB9F E9                   JP (HL)
 532  FBA0              ; ----------------------------------------------------------------------
 533  FBA0              ; DISPATCH_NODEV -- IOBYTE field selects no physical device: fall into the filter.
 534  FBA0              ;   In:  carry set by the caller (no-device).  Out: enters CONOUT_FILTER_NOEXPAND
 535  FBA0              ;        with the carry folded into the COL_FLAG byte.  Clobbers: A,HL.
 536  FBA0              ;   Algorithm: SCF then (CONOUT_FILTER_NOEXPAND) SBC A,A turns carry into a 0/$FF
 537  FBA0              ;     flag stored in COL_FLAG ($FECB); clear bit 7 of the char in C; if the pending-
 538  FBA0              ;     column counter ($FECC) is nonzero, apply a config-driven column offset, else
 539  FBA0              ;     fall through to the tab/control expansion (SETDMA_1). [RE]
 540  FBA0              ; ----------------------------------------------------------------------
 541  FBA0              DISPATCH_NODEV:
 542  FBA0                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 543  FBA0 37                   SCF
 544  FBA1              CONOUT_FILTER_NOEXPAND:
 545  FBA1                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 546  FBA1 9F                   SBC A,A
 547  FBA2 21 A2 F3             LD HL,$F3A2
 548  FBA5 6E                   LD L,(HL)
 549  FBA6 2C                   INC L
 550  FBA7 CA A4 FC             JP Z,SCREEN_EMIT
 551  FBAA                      ; HL -> COL_FLAG cell ($FECB)
 552  FBAA 21 CB FE             LD HL,COL_FLAG
 553  FBAD                      ; store the entry flag into COL_FLAG
 554  FBAD 77                   LD (HL),A
 555  FBAE                      ; strip the high bit of the character (7-bit ASCII)
 556  FBAE CB B9                RES 7,C
 557  FBB0 23                   INC HL
 558  FBB1                      ; load COL_PENDING (pending column-skip / fill count, $FECC)
 559  FBB1 7E                   LD A,(HL)
 560  FBB2 B7                   OR A
 561  FBB3                      ; no pending column work -> run tab/control expansion
 562  FBB3 CA 56 FC             JP Z,SETDMA_1
 563  FBB6                      ; consume one pending column step
 564  FBB6 35                   DEC (HL)
 565  FBB7                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 566  FBB7 3A 96 F3             LD A,($F396)
 567  FBBA                      ; HL -> the column cell in the $FE85 deblock/screen-state band ($FED4)
 568  FBBA 21 D4 FE             LD HL,BOOT_TMPL_XORA
 569  FBBD                      ; config byte zero -> derive the offset from the running width
 570  FBBD 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 571  FBBF B7                   OR A
 572  FBC0 F2 C6 FB             JP P,COL_APPLY_OFFSET_RAW
 573  FBC3 2B                   DEC HL
 574  FBC4              ; ----------------------------------------------------------------------
 575  FBC4              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 576  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 577  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 578  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude, subtract it from the
 579  FBC4              ;     current column in C, store the new column.  Reached when the config byte's sign
 580  FBC4              ;     indicates a subtractive column adjust. [RE]
 581  FBC4              ; ----------------------------------------------------------------------
 582  FBC4              COL_APPLY_OFFSET:
 583  FBC4                      ; drop the sign bit to get the offset magnitude
 584  FBC4 E6 7F                AND $7F
 585  FBC6              COL_APPLY_OFFSET_RAW:
 586  FBC6 5F                   LD E,A
 587  FBC7 79                   LD A,C
 588  FBC8                      ; new column = current column (C) minus the offset
 589  FBC8 93                   SUB E
 590  FBC9                      ; store the updated column position
 591  FBC9 77                   LD (HL),A
 592  FBCA C9                   RET
 593  FBCB              ; ----------------------------------------------------------------------
 594  FBCB              ; COL_OFFSET_FROM_WIDTH -- derive the column offset from the running screen width.
 595  FBCB              ;   In:  C = current column; the BOOT-overlaid base word at (BOOT+2).
 596  FBCB              ;   Out: updates the column and emits via SCREEN_EMIT; combines a base address with
 597  FBCB              ;        the offset.  Clobbers: A,B,C,DE,HL.
 598  FBCB              ;   Algorithm: pick the column cell by the config sign, CALL COL_APPLY_OFFSET, then
 599  FBCB              ;     load the base word (BOOT+2 = the cold-boot operand reused as deblock
 600  FBCB              ;     scratch), fold in config $F3A1, and ADD to form the screen address before
 601  FBCB              ;     emitting (SCREEN_EMIT). [RE]
 602  FBCB              ; ----------------------------------------------------------------------
 603  FBCB              COL_OFFSET_FROM_WIDTH:
 604  FBCB B7                   OR A
 605  FBCC                      ; config sign negative -> keep the higher column cell
 606  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH_1
 607  FBCF 2B                   DEC HL
 608  FBD0              COL_OFFSET_FROM_WIDTH_1:
 609  FBD0                      ; apply the signed column offset (COL_APPLY_OFFSET)
 610  FBD0 CD C4 FB             CALL COL_APPLY_OFFSET
 611  FBD3                      ; base word = the BOOT-overlaid deblock scratch ($FED3)
 612  FBD3 2A D3 FE             LD HL,(BOOT+2)
 613  FBD6                      ; config byte $F3A1 = Apple $03A1 (screen-base modifier)
 614  FBD6 3A A1 F3             LD A,($F3A1)
 615  FBD9 B7                   OR A
 616  FBDA                      ; config positive -> use HL as-is, skip the byte swap
 617  FBDA F2 E2 FB             JP P,COL_COMBINE_BASE
 618  FBDD                      ; negative: drop the sign bit, then swap H<->L below
 619  FBDD E6 7F                AND $7F
 620  FBDF 5D                   LD E,L
 621  FBE0 6C                   LD L,H
 622  FBE1 63                   LD H,E
 623  FBE2              ; ----------------------------------------------------------------------
 624  FBE2              ; COL_COMBINE_BASE -- fold the config offset into the base address, emit the char.
 625  FBE2              ;   In:  A = config offset; HL = base word; C will receive the high result.
 626  FBE2              ;   Out: pushes the low result, emits via SCREEN_EMIT with B=7, then re-enters the
 627  FBE2              ;        emit path with B=$0A.  Clobbers: A,B,C,DE,HL.
 628  FBE2              ;   Algorithm: C = offset + H; A = offset + L; CALL SCREEN_EMIT (B=7), then fall into
 629  FBE2              ;     CONOUT_EMIT_B with B=$0A. [RE]
 630  FBE2              ; ----------------------------------------------------------------------
 631  FBE2              COL_COMBINE_BASE:
 632  FBE2 5F                   LD E,A
 633  FBE3                      ; C = config offset + base high byte
 634  FBE3 84                   ADD A,H
 635  FBE4 4F                   LD C,A
 636  FBE5 7B                   LD A,E
 637  FBE6                      ; A = config offset + base low byte
 638  FBE6 85                   ADD A,L
 639  FBE7 F5                   PUSH AF
 640  FBE8                      ; mode/count code 7 for the screen emit
 641  FBE8 06 07                LD B,$07
 642  FBEA                      ; emit via the screen handler (SCREEN_EMIT)
 643  FBEA CD A4 FC             CALL SCREEN_EMIT
 644  FBED F1                   POP AF
 645  FBEE                      ; mode/count code $0A for the follow-up emit
 646  FBEE 06 0A                LD B,$0A
 647  FBF0              CHAR_C_TO_SCREEN:
 648  FBF0 4F                   LD C,A
 649  FBF1 C3 A4 FC             JP SCREEN_EMIT
 650  FBF4              ; ----------------------------------------------------------------------
 651  FBF4              ; SETSEC -- BIOS jump-vector entry 11 ($FA24 -> $FBF4): set the requested sector.
 652  FBF4              ;   In:  C = sector number. Out: none. Clobbers: A.
 653  FBF4              ;   Algorithm: store C into the sector cell BOOT+1 ($FED2 = the cold-boot LD SP operand
 654  FBF4              ;        low byte, reused post-boot as the requested-sector cell). The off-image RWTS
 655  FBF4              ;        ($AC39/$AC49) is the consumer; this image only WRITES it. Mirrors 2.20 SETSEC.
 656  FBF4              ;        [RE, transferred from 2.20; the off-image consumer is not in this image]
 657  FBF4              ; ----------------------------------------------------------------------
 658  FBF4              SETSEC:
 659  FBF4 79                   LD A,C
 660  FBF5                      ; store the requested sector into BOOT+1 (reused as the seksec cell)
 661  FBF5 32 D2 FE             LD (BOOT+1),A
 662  FBF8 C9                   RET
 663  FBF9              ; ----------------------------------------------------------------------
 664  FBF9              ; SETDMA -- BIOS jump-vector entry 12 ($FA27 -> $FBF9): set the DMA address.
 665  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 666  FBF9              ;   Out: none. Clobbers: none.
 667  FBF9              ;   Algorithm: store BC into the dmaadr cell (SECTOR_BLOCK_PATCH+2 = $FEE1, the
 668  FBF9              ;        operand region of the install-template 'LD ($0003),A'). The OFF-IMAGE
 669  FBF9              ;        deblock copy uses dmaadr as the host<->record transfer endpoint. The 2.20
 670  FBF9              ;        deblock did the LDIR itself; in 2.23 the value is read off-image. [RE]
 671  FBF9              ; ----------------------------------------------------------------------
 672  FBF9              SETDMA:
 673  FBF9                      ; store BC into dmaadr ($FEE1, overlaid on the install-template LD ($0003),A operand)
 674  FBF9 ED 43 E1 FE          LD (DISK_DMAADR+2),BC
 675  FBFD C9                   RET
 676  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 677  FC56              SETDMA_1:
 678  FC56 47                   LD B,A
 679  FC57 21 CD FE             LD HL,COL_STATE
 680  FC5A 7E                   LD A,(HL)
 681  FC5B 5F                   LD E,A
 682  FC5C B7                   OR A
 683  FC5D 20 12                JR NZ,SETDMA_3
 684  FC5F 3A 97 F3             LD A,($F397)
 685  FC62 B7                   OR A
 686  FC63 28 06                JR Z,SETDMA_2
 687  FC65 B9                   CP C
 688  FC66 20 03                JR NZ,SETDMA_2
 689  FC68 36 80                LD (HL),$80
 690  FC6A C9                   RET
 691  FC6B              SETDMA_2:
 692  FC6B 3E 1F                LD A,$1F
 693  FC6D B9                   CP C
 694  FC6E DA A4 FC             JP C,SCREEN_EMIT
 695  FC71              SETDMA_3:
 696  FC71 21 A0 F3             LD HL,$F3A0
 697  FC74 06 09                LD B,$09
 698  FC76              SETDMA_4:
 699  FC76 7E                   LD A,(HL)
 700  FC77 B7                   OR A
 701  FC78 28 04                JR Z,SETDMA_5
 702  FC7A AB                   XOR E
 703  FC7B B9                   CP C
 704  FC7C 28 05                JR Z,SETDMA_6
 705  FC7E              SETDMA_5:
 706  FC7E 2B                   DEC HL
 707  FC7F 10 F5                DJNZ SETDMA_4
 708  FC81 18 21                JR SCREEN_EMIT
 709  FC83              SETDMA_6:
 710  FC83 11 0B 00             LD DE,$000B
 711  FC86 19                   ADD HL,DE
 712  FC87 7E                   LD A,(HL)
 713  FC88 B7                   OR A
 714  FC89 4F                   LD C,A
 715  FC8A F2 9A FC             JP P,SETDMA_7
 716  FC8D E6 7F                AND $7F
 717  FC8F 4F                   LD C,A
 718  FC90 C5                   PUSH BC
 719  FC91 3A A2 F3             LD A,($F3A2)
 720  FC94 06 07                LD B,$07
 721  FC96 CD F0 FB             CALL CHAR_C_TO_SCREEN
 722  FC99 C1                   POP BC
 723  FC9A              SETDMA_7:
 724  FC9A 78                   LD A,B
 725  FC9B FE 07                CP $07
 726  FC9D 20 05                JR NZ,SCREEN_EMIT
 727  FC9F 3E 02                LD A,$02
 728  FCA1 32 CC FE             LD (COL_PENDING),A
 729  FCA4              SCREEN_EMIT:
 730  FCA4 AF                   XOR A
 731  FCA5 32 CD FE             LD (COL_STATE),A
 732  FCA8 3A CB FE             LD A,(COL_FLAG)
 733  FCAB B7                   OR A
 734  FCAC 2A 88 F3             LD HL,($F388)
 735  FCAF 28 03                JR Z,SCREEN_EMIT_1
 736  FCB1 2A 86 F3             LD HL,($F386)
 737  FCB4              SCREEN_EMIT_1:
 738  FCB4 E9                   JP (HL)
 739  FCB5              SCREEN_EMIT_2:
 740  FCB5 11 03 00             LD DE,$0003
 741  FCB8              SCREEN_EMIT_3:
 742  FCB8 C3 BB FC             JP SCREEN_EMIT_4
 743  FCBB              SCREEN_EMIT_4:
 744  FCBB 2A CE FE             LD HL,(SCREEN_CURSOR_PTR)
 745  FCBE 3A D0 FE             LD A,(SCREEN_CHAR)
 746  FCC1 77                   LD (HL),A
 747  FCC2 CD E2 FC             CALL CTRL_CHAR_DISPATCH
 748  FCC5 2A 28 F0             LD HL,($F028)
 749  FCC8 3A 24 F0             LD A,($F024)
 750  FCCB 5F                   LD E,A
 751  FCCC 16 F0                LD D,$F0
 752  FCCE 19                   ADD HL,DE
 753  FCCF 22 CE FE             LD (SCREEN_CURSOR_PTR),HL
 754  FCD2 7E                   LD A,(HL)
 755  FCD3 32 D0 FE             LD (SCREEN_CHAR),A
 756  FCD6 FE E0                CP $E0
 757  FCD8 38 02                JR C,SCREEN_EMIT_5
 758  FCDA EE 20                XOR $20
 759  FCDC              SCREEN_EMIT_5:

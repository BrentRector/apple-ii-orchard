 759  FD83              SET_SCREEN_BASE:
 760  FD83 CD 7C FE             CALL SLOT_IO_ADDR_W
 761  FD86 32 F8 F6             LD ($F6F8),A
 762  FD89 32 47 F0             LD ($F047),A
 763  FD8C 3A FF EF             LD A,($EFFF)
 764  FD8F CD B1 FA             CALL DEVICE_IO_BASE
 765  FD92 D6 20                SUB $20
 766  FD94 32 46 F0             LD ($F046),A
 767  FD97 7E                   LD A,(HL)

 769  FD99              SET_SCREEN_BASE_1:
 770  FD99 21 14 0E             LD HL,$0E14
 771  FD9C 1E 03                LD E,$03
 772  FD9E 3E 01                LD A,$01
 773  FDA0 CD AD FD             CALL SET_CURSOR_COL_AND_BASE
 774  FDA3 3A 48 F0             LD A,($F048)
 775  FDA6 1F                   RRA
 776  FDA7 9F                   SBC A,A
 777  FDA8 C9                   RET
 778  FDA9 21 E1 0D 79          DEFB    $21,$E1,$0D,$79

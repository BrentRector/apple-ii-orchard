# file opened: CPM_BIOS.asm
   1  0000              ; ============================================================================
   2  0000              ; Microsoft SoftCard CP/M 2.23 (44K) -- BIOS, RUNTIME-ADDRESSED (de-skewed)
   3  0000              ; ----------------------------------------------------------------------------
   4  0000              ; The 2.23-44K BIOS runs at z80 $FA00-$FFFF (6 pages) = Apple $0A00-$0FFF LOW RAM
   5  0000              ; (NOT $AA00 like 2.20 -- a different mechanism). Decoded against the de-skewed
   6  0000              ; runtime image; the disk producer re-applies the sector skew (deskew.py ::
   7  0000              ; BIOS_PAGE_TO_SECTOR_223). $FA00 = the 15-entry BIOS jump vector.
   8  0000              ; DECODE IN PROGRESS: --auto-coverage --relocatable disassembly (byte-identical),
   9  0000              ; being enriched to the C-level bar.
  10  0000              ; ============================================================================
  11  0000
  12  0000                  IFNDEF CPM_LINK
  13  0000                  DEVICE NOSLOT64K
  14  0000                  ORG $FA00
  15  FA00                  ENDIF
  16  FA00
  17  FA00              ; ----------------------------------------------------------------------
  18  FA00              ; BIOS_VECTOR -- the CP/M 2.2 BIOS entry jump vector (2.23-44K, runtime $FA00).
  19  FA00              ;   15 three-byte JP entries the BDOS/CCP and the cold loader call by fixed
  20  FA00              ;   offset from the BIOS base: BOOT, WBOOT, CONST, CONIN, CONOUT, LIST, PUNCH,
  21  FA00              ;   READER, HOME, SELDSK, SETTRK, SETSEC, SETDMA, READ, WRITE.
  22  FA00              ;   In:  entered by JP/CALL to base+3*n.  Out: per the dispatched entry.
  23  FA00              ;   Note: the CONOUT target ($FB4D) is the second-instruction entry of
  24  FA00              ;         CONOUT_DISPATCH (skips its leading LD C,A); see flags. [RE]
  25  FA00              ; ----------------------------------------------------------------------
  26  FA00              BIOS_VECTOR:
  27  FA00                      ; entry 0 = cold boot (BOOT, lives in the $FE85 band, out of this scope)
  28  FA00 C3 D1 FE             JP BOOT
  29  FA03              ; ----------------------------------------------------------------------
  30  FA03              ; BIOS_VECTOR_WBOOT -- jump-table entries 1..14 (WBOOT .. WRITE).
  31  FA03              ;   Same 14-entry layout as the 2.20-44K twin; only the target addresses move
  32  FA03              ;   ($FA-band, not $AA). CONOUT ($FA0C) targets CONOUT_DISPATCH+1 ($FB4D). [RE]
  33  FA03              ; ----------------------------------------------------------------------
  34  FA03              BIOS_VECTOR_WBOOT:
  35  FA03                      ; jump table
  36  FA03                      ; entry 1 = WBOOT: reload CCP, rebuild page zero
  37  FA03 C3 B8 FA             JP      WBOOT
  38  FA06                      ; entry 2 = CONST: console status via IOBYTE
  39  FA06 C3 10 FB             JP      CONST
  40  FA09                      ; entry 3 = CONIN: dispatch + function/arrow remap
  41  FA09 C3 1A FB             JP      CONIN
  42  FA0C                      ; entry 4 = CONOUT; target CONOUT_DISPATCH+1 (skips its leading LD C,A)
  43  FA0C C3 4D FB             JP      $FB4D
  44  FA0F                      ; entry 5 = LIST: route by IOBYTE LIST field
  45  FA0F C3 70 FB             JP      LIST
  46  FA12                      ; entry 6 = PUNCH: route by IOBYTE PUNCH field
  47  FA12 C3 7F FB             JP      PUNCH
  48  FA15                      ; entry 7 = READER: route by IOBYTE READER field
  49  FA15 C3 91 FB             JP      READER
  50  FA18                      ; entry 8 = HOME (out of this scope, $FDB0 band)
  51  FA18 C3 6C FE             JP      HOME
  52  FA1B                      ; entry 9 = SELDSK (out of this scope, $FE85 band)
  53  FA1B C3 8E FE             JP      SELDSK
  54  FA1E                      ; entry 10 = SETTRK (out of this scope, $FE77)
  55  FA1E C3 77 FE             JP      $FE77
  56  FA21                      ; entry 11 = SETSEC: store sector into deblock scratch
  57  FA21 C3 F4 FB             JP      SETSEC
  58  FA24                      ; entry 12 = SETDMA: store DMA address into deblock scratch
  59  FA24 C3 F9 FB             JP      SETDMA
  60  FA27                      ; entry 13 = READ (out of this scope, $FE85 band)
  61  FA27 C3 BD FE             JP      READ
  62  FA2A                      ; entry 14 = WRITE (out of this scope, $FE85 band)
  63  FA2A C3 C0 FE             JP      WRITE
  64  FA2D              ; ----------------------------------------------------------------------
  65  FA2D              ; The last two jump-table slots are not JPs: both handlers are short enough to sit
  66  FA2D              ; INLINE in the table, which is legal because nothing after entry 16 needs a fixed
  67  FA2D              ; offset. They used to be dumped here as an opaque DEFB run described as a
  68  FA2D              ; "post-vector trailer ... not reached as code here", which was wrong twice over:
  69  FA2D              ; the BDOS reaches both through the jump table, and the bytes are ordinary Z-80. [RE]
  70  FA2D              ; ----------------------------------------------------------------------
  71  FA2D              ; LISTST -- entry 15: return the list device's ready status.
  72  FA2D              ;   In:  none.  Out: A = $00.  Clobbers: A, flags.
  73  FA2D              ;   Algorithm: XOR A / RET. A is $00 whatever the printer is doing. Under the
  74  FA2D              ;     CP/M 2.2 convention $00 means NOT ready and $FF means ready, so this
  75  FA2D              ;     reports "not ready" unconditionally.
  76  FA2D              ;     That is the whole of what these two bytes support. WHO consults LISTST, and
  77  FA2D              ;     what they do with the answer, is NOT determinable from this image, and the
  78  FA2D              ;     SoftCard manual set in softcard/reference/ does not document LISTST at all
  79  FA2D              ;     -- so no claim is made here about callers or about anything blocking. Same two bytes in the 2.20-44K and 2.23-60K twins. [RE]
  80  FA2D              ; ----------------------------------------------------------------------
  81  FA2D              LISTST:
  82  FA2D AF                   XOR A
  83  FA2E C9                   RET
  84  FA2F 00                   DEFB    $00                      ; pad: realigns SECTRAN onto the 3-byte slot grid
  85  FA30              ; ----------------------------------------------------------------------
  86  FA30              ; SECTRAN -- entry 16: logical-to-physical sector translate (identity).
  87  FA30              ;   In:  BC = logical sector, DE = translate-table address (ignored).
  88  FA30              ;   Out: HL = BC (physical == logical).  Clobbers: H, L.
  89  FA30              ;   Algorithm: LD H,B / LD L,C / RET. The DPH XLT field is 0 for every drive, so the
  90  FA30              ;     BDOS asks for no translation and this returns its argument unchanged; the skew
  91  FA30              ;     is applied by the disk producer, off-image. Same three bytes in both twins. [RE]
  92  FA30              ; ----------------------------------------------------------------------
  93  FA30              SECTRAN:
  94  FA30 60                   LD H,B
  95  FA31 69                   LD L,C
  96  FA32 C9                   RET
  97  FA33              ; ----------------------------------------------------------------------
  98  FA33              ; DPH_TABLE -- the CP/M 2.2 Disk Parameter Header array (one 16-byte DPH per logical
  99  FA33              ;   drive 0..3; 2.23 supports 4 drives, vs 6 in the 2.20 twin). SELDSK returns
 100  FA33              ;   DPH_TABLE + 16*drive. Each DPH = XLT, three BDOS scratch words, DIRBUF, DPB, CSV,
 101  FA33              ;   ALV. XLT = 0 (no SECTRAN translate). All drives share one DIRBUF and one DPB.
 102  FA33              ;   The per-drive strides are the DPB's own fields: CSV is CKS = 12 bytes, ALV is
 103  FA33              ;   DSM/8 + 1 = 139/8 + 1 = 18 bytes. [RE]
 104  FA33              ; ----------------------------------------------------------------------
 105  FA33              ; DIRBUF, ALV_VECTORS and CSV_VECTORS are the BDOS scratch buffers this table hands out.
 106  FA33              ; They are declared at the foot of this file (see "BDOS scratch overlay"), because they
 107  FA33              ; are a SECOND tenant of bytes the cold-boot code owns: the layout is set out there with
 108  FA33              ; its own ORG, so each field is a real label rather than a magic address.
 109  FA33              DPH_TABLE:
 110  FA33 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS,   ALV_VECTORS      ; drive 0
 110  FA37 00 00 00 00
 110  FA3B E4 FE 73 FA
 110  FA3F AC FF 64 FF
 111  FA43 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+12,ALV_VECTORS+18   ; drive 1
 111  FA47 00 00 00 00
 111  FA4B E4 FE 73 FA
 111  FA4F B8 FF 76 FF
 112  FA53 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+24,ALV_VECTORS+36   ; drive 2
 112  FA57 00 00 00 00
 112  FA5B E4 FE 73 FA
 112  FA5F C4 FF 88 FF
 113  FA63 00 00 00 00          DEFW    0,0,0,0,DIRBUF,DPB,CSV_VECTORS+36,ALV_VECTORS+54   ; drive 3
 113  FA67 00 00 00 00
 113  FA6B E4 FE 73 FA
 113  FA6F D0 FF 9A FF
 114  FA73              ; ----------------------------------------------------------------------
 115  FA73              ; DPB -- the shared Disk Parameter Block (5.25" floppy; every DPH points here).
 116  FA73              ;   One label per field, so the field names are symbols rather than prose. The ten names
 117  FA73              ;   are Digital Research's CP/M 2.2 DPB field names. NOT [DOC]-citable from this archive:
 118  FA73              ;   the SoftCard manual set documents only the BDOS call that RETURNS a DPB pointer
 119  FA73              ;   (fn 31, Get Addr (disk parms)), not the block's layout.
 120  FA73              ;   Geometry derived from these bytes: BSH=3/BLM=7 -> 8 records per allocation block =
 121  FA73              ;   1 KB blocks; SPT=32 records/track -> 4 blocks per track. [RE]
 122  FA73              ;   This block is byte-identical to the 2.20-44K twin's except for DSM (see below). [RE]
 123  FA73              ; ----------------------------------------------------------------------
 124  FA73              DPB:
 125  FA73 20 00        SPT:    DEFW    $0020                    ; records per track: 32 x 128-byte records
 126  FA75 03           BSH:    DEFB    $03                      ; block shift: log2(records per block) -> 8 records
 127  FA76 07           BLM:    DEFB    $07                      ; block mask: (records per block) - 1 -> 1 KB blocks
 128  FA77 00           EXM:    DEFB    $00                      ; extent mask
 129  FA78              ; DSM is the ONLY byte in which this DPB differs from the 2.20-44K twin ($7F there).
 130  FA78              ;   The arithmetic does not close: 140 blocks / 4 blocks per track = 35 tracks of file
 131  FA78              ;   area, which with OFF=3 implies a 38-track disk; the medium is 35 tracks total. The
 132  FA78              ;   twin's $7F gives 32 + 3 = 35 exactly. What absorbs the surplus is a directory entry
 133  FA78              ;   present on every 2.23 disk: user byte $1F, lowercase name "cp/m    sys", allocation
 134  FA78              ;   list exactly blocks 128-139 -- the twelve blocks past the twin's 128. The BDOS's
 135  FA78              ;   allocation-vector rebuild skips only $E5 entries and does not range-check the user
 136  FA78              ;   number, so that entry is honoured and those twelve blocks stay marked in use.
 137  FA78              ;   Whether $8B is an error masked by that entry or a deliberate convention is NOT
 138  FA78              ;   determinable from any byte on these disks. [RE]
 139  FA78 8B 00        DSM:    DEFW    $008B                    ; highest allocation block number: 139 -> 140 blocks
 140  FA7A 2F 00        DRM:    DEFW    $002F                    ; highest directory entry number: 47 -> 48 entries
 141  FA7C C0           AL0:    DEFB    $C0                      ; directory-reserved blocks, bitmap, high byte -> 2
 142  FA7D 00           AL1:    DEFB    $00                      ; ditto, low byte
 143  FA7E 0C 00        CKS:    DEFW    $000C                    ; directory checksum bytes
 144  FA80 03 00        OFF:    DEFW    $0003                    ; reserved tracks before the file area
 145  FA82              ; ----------------------------------------------------------------------
 146  FA82              ; PROBE_DEVICES -- scan the SoftCard device/config area and mark presence.
 147  FA82              ;   In:  none (walks Apple $03B8.. via z80 $F3B8 = the SoftCard config block).
 148  FA82              ;   Out: config bytes updated in place; per-device init called when a device is found.
 149  FA82              ;   Clobbers: A,DE,HL.
 150  FA82              ;   Algorithm: for E = 7 down to 1, read config[$F3B8 + E].  If it equals 3 the slot
 151  FA82              ;     holds a recognized device, so call SLOT_IO_ADDR and store $03 then $15 into the
 152  FA82              ;     cell to flag it configured.  A secondary DEC A test (original value 4, e.g. a
 153  FA82              ;     Videx-class 80-col console) runs SET_SCREEN_BASE and claims the $C800 shared
 154  FA82              ;     expansion-ROM window via RPC_TRIGGER; a value-2 path repoints a vector via
 155  FA82              ;     PLOT_CHAR_RPC ($0DD0 param).  Same shape as the 2.20 twin's PROBE_DEVICES. [RE]
 156  FA82              ; ----------------------------------------------------------------------
 157  FA82              PROBE_DEVICES:
 158  FA82                      ; DE = 7 entries to scan (index walks down to 1)
 159  FA82 11 07 00             LD DE,$0007
 160  FA85              PROBE_DEVICES_LOOP:
 161  FA85                      ; z80 $F3B8 = Apple $03B8 = base of the SoftCard device config block
 162  FA85 21 B8 F3             LD HL,$F3B8
 163  FA88 19                   ADD HL,DE
 164  FA89 7E                   LD A,(HL)
 165  FA8A                      ; config value 3 = a recognized/present device in this slot
 166  FA8A D6 03                SUB $03
 167  FA8C 20 07                JR NZ,PROBE_DEVICES_CHK4
 168  FA8E                      ; build the slot I/O base for the found device (SLOT_IO_ADDR)
 169  FA8E CD 81 FE             CALL SLOT_IO_ADDR
 170  FA91                      ; rewrite the cell: $03 then $15 = mark this device configured
 171  FA91 36 03                LD (HL),$03
 172  FA93 36 15                LD (HL),$15
 173  FA95              PROBE_DEVICES_CHK4:
 174  FA95                      ; after the SUB, A==1 means the original value was 4 (Videx-class 80-col console)
 175  FA95 3D                   DEC A
 176  FA96 20 0B                JR NZ,PROBE_DEVICES_CHK2
 177  FA98                      ; console probe / select the 80-col screen base (SET_SCREEN_BASE)
 178  FA98 CD 83 FD             CALL SET_SCREEN_BASE
 179  FA9B                      ; z80 $C800 = Apple $C800 shared expansion-ROM window for the configured card
 180  FA9B 21 00 C8             LD HL,$C800
 181  FA9E CD 45 FB             CALL RPC_TRIGGER
 182  FAA1 18 0A                JR PROBE_DEVICES_NEXT
 183  FAA3              PROBE_DEVICES_CHK2:
 184  FAA3                      ; value 2 = a different device class (e.g. printer/serial); takes the PLOT_CHAR_RPC path
 185  FAA3 FE 02                CP $02
 186  FAA5 20 06                JR NZ,PROBE_DEVICES_NEXT
 187  FAA7                      ; param for the value-2 vector init ($0DD0)
 188  FAA7 21 D0 0D             LD HL,$0DD0
 189  FAAA CD B0 FD             CALL PLOT_CHAR_RPC
 190  FAAD              PROBE_DEVICES_NEXT:
 191  FAAD                      ; next config entry; loop until all 7 scanned
 192  FAAD 1D                   DEC E
 193  FAAE 20 D5                JR NZ,PROBE_DEVICES_LOOP
 194  FAB0 C9                   RET
 195  FAB1              ; ----------------------------------------------------------------------
 196  FAB1              ; DEVICE_IO_BASE -- form a SoftCard I/O / soft-switch address from a device/offset index.
 197  FAB1              ;   In:  E = low offset within the I/O page.
 198  FAB1              ;   Out: HL = ((E | $E0) << 8), an address in z80 $E000-$EFFF = Apple I/O $C000-$CFFF;
 199  FAB1              ;        A clobbered.
 200  FAB1              ;   Algorithm: H = $E0 base; A = E OR H forces the high nibble into the $C0xx I/O
 201  FAB1              ;        page, then H = A.  Used to reach keyboard / soft switches / slot I/O.
 202  FAB1              ;        Same as the 2.20 twin's DEVICE_IO_BASE (distinct from SLOT_IO_ADDR at $FE81). [RE]
 203  FAB1              ; ----------------------------------------------------------------------
 204  FAB1              DEVICE_IO_BASE:
 205  FAB1                      ; z80 $E000 = Apple $C000 = base of the soft-switch / slot I/O page
 206  FAB1 21 00 E0             LD HL,$E000
 207  FAB4 7B                   LD A,E
 208  FAB5                      ; force the high byte into the $C0xx I/O range
 209  FAB5 B4                   OR H
 210  FAB6 67                   LD H,A
 211  FAB7 C9                   RET
 212  FAB8              ; ----------------------------------------------------------------------
 213  FAB8              ; WBOOT -- CP/M warm boot: re-init the console, rebuild page zero, re-enter the CCP.
 214  FAB8              ;   In:  none.  Out: jumps to the CCP at $9300; does not return.  Clobbers: all.
 215  FAB8              ;   Algorithm: set SP to the default DMA top ($0080); touch the 80-col soft switch
 216  FAB8              ;     (z80 $E051 = Apple $C051 TXTSET); re-init the console via RPC_TRIGGER; re-run
 217  FAB8              ;     PROBE_DEVICES.  If the CCP image signature at $9C08 is intact ($9C) it falls
 218  FAB8              ;     into PAGEZERO_REBUILD; otherwise it reloads the CCP/system via a page-zero JP.
 219  FAB8              ;   Note: 2.23 reloads through a self-built $000B jump and enters the CCP at $9300
 220  FAB8              ;     (the 2.20 twin used $9400). [RE]
 221  FAB8              ; ----------------------------------------------------------------------
 222  FAB8              WBOOT:
 223  FAB8                      ; stack at the default DMA buffer top (page-zero $0080)
 224  FAB8 31 80 00             LD SP,$0080
 225  FABB                      ; z80 $E051 = Apple $C051 TXTSET soft switch (console video reset)
 226  FABB 3A 51 E0             LD A,($E051)
 227  FABE 21 00 0E             LD HL,$0E00
 228  FAC1                      ; re-init the console I/O vectors (RPC_TRIGGER) for warm restart
 229  FAC1 CD 45 FB             CALL RPC_TRIGGER
 230  FAC4                      ; re-scan devices so warm boot rebuilds the I/O table
 231  FAC4 CD 82 FA             CALL PROBE_DEVICES
 232  FAC7                      ; read the CCP-image signature byte at $9C08
 233  FAC7 3A 08 9C             LD A,($9C08)
 234  FACA                      ; signature $9C present = CCP image intact, skip the reload
 235  FACA FE 9C                CP $9C
 236  FACC 28 11                JR Z,PAGEZERO_REBUILD
 237  FACE 21 59 FF             LD HL,SIGNON_PRINT
 238  FAD1 22 D0 F3             LD ($F3D0),HL
 239  FAD4 2A DE F3             LD HL,($F3DE)
 240  FAD7 3E 77                LD A,$77
 241  FAD9                      ; plant a $77 byte at page-zero $000B to bridge into the reload path
 242  FAD9 32 0B 00             LD ($000B),A
 243  FADC                      ; jump into the self-built page-zero reload bridge
 244  FADC C3 0B 00             JP $000B
 245  FADF              ; ----------------------------------------------------------------------
 246  FADF              ; PAGEZERO_REBUILD -- clear the CCP-restart flag, then write the page-zero hooks.
 247  FADF              ;   In:  none.  Out: falls into CCP_LAUNCH; no return.  Clobbers: A,HL,BC.
 248  FADF              ;   Algorithm: zero the CCP restart flag at $9307, then (PAGEZERO_REBUILD_HOOKS)
 249  FADF              ;     plant JP ($C3) at $0000 -> the BIOS WBOOT entry (BIOS_VECTOR+3, BIOS_VECTOR_WBOOT) and
 250  FADF              ;     JP at $0005 -> the BDOS entry $9C06; clear two self-modified BIOS state cells
 251  FADF              ;     ($FEDD/$FED8); set the default DMA to $0080 via SETDMA. [RE]
 252  FADF              ; ----------------------------------------------------------------------
 253  FADF              PAGEZERO_REBUILD:
 254  FADF AF                   XOR A
 255  FAE0                      ; clear the CCP restart/cold flag at $9307
 256  FAE0 32 07 93             LD ($9307),A
 257  FAE3              PAGEZERO_REBUILD_HOOKS:
 258  FAE3 AF                   XOR A
 259  FAE4                      ; clear a self-modified BIOS state cell ($FEDD)
 260  FAE4 32 DD FE             LD (BOOT_TMPL_IOBYTE),A
 261  FAE7                      ; clear a self-modified BIOS state cell ($FED8)
 262  FAE7 32 D8 FE             LD (DISK_HSTACT),A
 263  FAEA                      ; $C3 = Z-80 JP opcode to plant at the page-zero hooks
 264  FAEA 3E C3                LD A,$C3
 265  FAEC                      ; page-zero $0000 = JP to WBOOT (CP/M warm-boot hook)
 266  FAEC 32 00 00             LD ($0000),A
 267  FAEF                      ; operand of the $0000 JP = BIOS vector+3 (WBOOT entry)
 268  FAEF 21 03 FA             LD HL,BIOS_VECTOR_WBOOT
 269  FAF2 22 01 00             LD ($0001),HL
 270  FAF5                      ; page-zero $0005 = JP to BDOS (the CP/M BDOS call hook)
 271  FAF5 32 05 00             LD ($0005),A
 272  FAF8                      ; BDOS entry point ($9C06) for the $0005 hook
 273  FAF8 21 06 9C             LD HL,$9C06
 274  FAFB 22 06 00             LD ($0006),HL
 275  FAFE                      ; default DMA address = $0080 (page-zero buffer)
 276  FAFE 01 80 00             LD BC,$0080
 277  FB01                      ; install the default DMA pointer (SETDMA)
 278  FB01 CD F9 FB             CALL SETDMA
 279  FB04              ; ----------------------------------------------------------------------
 280  FB04              ; CCP_LAUNCH -- final warm/cold-boot tail: set the CCP entry flag, jump to the CCP.
 281  FB04              ;   In:  none.  Out: JP $9300 (CCP cold/warm entry); no return.  Clobbers: A,C.
 282  FB04              ;   Algorithm: store a CCP-mode flag ($01) into $974E, pass the current default
 283  FB04              ;     drive (page-zero $0004) in C, and jump to the CCP at $9300. [RE]
 284  FB04              ; ----------------------------------------------------------------------
 285  FB04              CCP_LAUNCH:
 286  FB04                      ; CCP-mode flag value
 287  FB04 3E 01                LD A,$01
 288  FB06                      ; store the CCP entry/mode flag into CCP workspace at $974E
 289  FB06 32 4E 97             LD ($974E),A
 290  FB09                      ; page-zero $0004 = current default drive byte
 291  FB09 3A 04 00             LD A,($0004)
 292  FB0C 4F                   LD C,A
 293  FB0D                      ; enter the CCP at $9300, C = default drive (2.20 used $9400)
 294  FB0D C3 00 93             JP $9300
 295  FB10              ; ----------------------------------------------------------------------
 296  FB10              ; CONST -- CP/M console status: return $FF if a console char is ready, else $00.
 297  FB10              ;   In:  none.  Out: A = $FF (ready) / $00 (not).  Clobbers: A,HL.
 298  FB10              ;   Algorithm: load the console-status handler address from the SoftCard I/O vector
 299  FB10              ;     cell (z80 $F380 = Apple $0380) and JP (HL) to the 6502-serviced handler, which
 300  FB10              ;     returns the status in A.  Same as the 2.20 twin's CONST. [RE]
 301  FB10              ; ----------------------------------------------------------------------
 302  FB10              CONST:
 303  FB10                      ; z80 $F380 = Apple $0380 = console-status handler vector cell
 304  FB10 2A 80 F3             LD HL,($F380)
 305  FB13                      ; dispatch to the selected console-status handler (returns A)
 306  FB13 E9                   JP (HL)
 307  FB14              ; ----------------------------------------------------------------------
 308  FB14              ; KBD_STATUS_40COL -- 40-column console status via the Apple keyboard strobe.
 309  FB14              ;   In:  none.  Out: A = $FF if a key is waiting (bit 7 set at $C000), else $00.
 310  FB14              ;   Clobbers: A.
 311  FB14              ;   Algorithm: read z80 $E000 = Apple $C000 keyboard register; RLA shifts bit 7
 312  FB14              ;     (key-ready) into carry; SBC A,A expands carry to $FF/$00.  The built-in 40-col
 313  FB14              ;     CONST path used when no Videx/80-col card supplies the status vector. [RE]
 314  FB14              ; ----------------------------------------------------------------------
 315  FB14              KBD_STATUS_40COL:
 316  FB14                      ; z80 $E000 = Apple $C000 keyboard register (bit 7 = key ready)
 317  FB14 3A 00 E0             LD A,($E000)
 318  FB17                      ; rotate key-ready bit 7 into carry
 319  FB17 17                   RLA
 320  FB18                      ; carry -> A = $FF (ready) or $00 (none)
 321  FB18 9F                   SBC A,A
 322  FB19 C9                   RET
 323  FB1A              ; ----------------------------------------------------------------------
 324  FB1A              ; CONIN -- read a console character: IOBYTE-route the input, then remap the key.
 325  FB1A              ;   In:  none.  Out: A = (translated) key.  Clobbers: A,B,C,DE,HL.
 326  FB1A              ;   Algorithm: CALL CONIN_DISPATCH to fetch a raw key (routed by the IOBYTE CONSOLE
 327  FB1A              ;     field); clear the high bit; then scan a small remap table at Apple $03AB
 328  FB1A              ;     (z80 $F3AB) of up to 6 entries (function/arrow keys), returning the paired
 329  FB1A              ;     replacement byte on a match, else the raw key.
 330  FB1A              ;   Note: 2.23's CONIN jump-vector entry runs this remap wrapper; the 2.20 twin's
 331  FB1A              ;     equivalent is CONSOLE_IN_40COL.  Differs from a bare dispatcher. [RE]
 332  FB1A              ; ----------------------------------------------------------------------
 333  FB1A              CONIN:
 334  FB1A                      ; fetch a raw key in A via the IOBYTE-routed CONIN dispatcher
 335  FB1A CD 5A FB             CALL CONIN_DISPATCH_IOBYTE
 336  FB1D                      ; strip the high bit (7-bit ASCII)
 337  FB1D E6 7F                AND $7F
 338  FB1F                      ; HL = key-remap table base (z80 $F3AB = Apple $03AB; first entry pair at $03AC)
 339  FB1F 21 AB F3             LD HL,$F3AB
 340  FB22                      ; up to 6 remap-table entries
 341  FB22 06 06                LD B,$06
 342  FB24                      ; C = raw key
 343  FB24 4F                   LD C,A
 344  FB25              ; ----------------------------------------------------------------------
 345  FB25              ; CONIN_XLATE_LOOP -- scan the function/arrow-key remap table.
 346  FB25              ;   In:  C = raw key; B = entry count; HL -> table base.
 347  FB25              ;   Out: A = translated key on match (returns), else loops; A = C on table end.
 348  FB25              ;   Algorithm: each entry = [match byte, replacement byte]; a high-bit sentinel
 349  FB25              ;     match byte ends the table. [RE]
 350  FB25              ; ----------------------------------------------------------------------
 351  FB25              CONIN_XLATE_LOOP:
 352  FB25 23                   INC HL
 353  FB26                      ; entry's match byte
 354  FB26 7E                   LD A,(HL)
 355  FB27 23                   INC HL
 356  FB28 B7                   OR A
 357  FB29                      ; high-bit sentinel ends the table
 358  FB29 FA 31 FB             JP M,CONIN_XLATE_DONE
 359  FB2C                      ; raw key == this entry?
 360  FB2C B9                   CP C
 361  FB2D                      ; paired replacement byte
 362  FB2D 7E                   LD A,(HL)
 363  FB2E                      ; match -> return the translated key
 364  FB2E C8                   RET Z
 365  FB2F 10 F4                DJNZ CONIN_XLATE_LOOP
 366  FB31              ; ----------------------------------------------------------------------
 367  FB31              ; CONIN_XLATE_DONE -- no remap match: return the raw key in A. [RE]
 368  FB31              ; ----------------------------------------------------------------------
 369  FB31              CONIN_XLATE_DONE:
 370  FB31                      ; no match -> return the raw key
 371  FB31 79                   LD A,C
 372  FB32 C9                   RET
 373  FB33              ; ----------------------------------------------------------------------
 374  FB33              ; CONIN_KEYWAIT -- seed the keyboard-wait dispatch index, then wait for a key.
 375  FB33              ;   In:  none.  Out: A = 7-bit key (via KBD_WAIT_KEY).  Clobbers: A,DE.
 376  FB33              ;   Algorithm: load DE = 3 (the default console index), then JP through the
 377  FB33              ;     self-modified CONIN_DISPATCH cell; at boot that target is patched to the
 378  FB33              ;     selected keyboard-wait handler (default KBD_WAIT_KEY). [RE]
 379  FB33              ; ----------------------------------------------------------------------
 380  FB33              CONIN_KEYWAIT:
 381  FB33                      ; DE = 3 = default console-device index
 382  FB33 11 03 00             LD DE,$0003
 383  FB36              ; ----------------------------------------------------------------------
 384  FB36              ; CONIN_DISPATCH -- self-modified keyboard-wait vector.
 385  FB36              ;   The JP target ($FB39 / KBD_WAIT_KEY by default) is patched at boot per the
 386  FB36              ;   selected console card.  Referenced as CONIN_DISPATCH+1 by the patch site. [RE]
 387  FB36              ; ----------------------------------------------------------------------
 388  FB36              CONIN_DISPATCH:
 389  FB36                      ; target (CONIN_DISPATCH+1) patched at boot to the chosen keyboard-wait handler
 390  FB36 C3 39 FB             JP KBD_WAIT_KEY
 391  FB39              ; ----------------------------------------------------------------------
 392  FB39              ; KBD_WAIT_KEY -- spin on the Apple keyboard register until a key is down.
 393  FB39              ;   In:  none.  Out: A = 7-bit key (high bit cleared).  Clobbers: A.
 394  FB39              ;   Algorithm: poll z80 $E000 = Apple $C000; RLA puts key-ready (bit 7) into carry,
 395  FB39              ;     spin while clear; on a key, clear the strobe at $E010 = Apple $C010 and return
 396  FB39              ;     the 7-bit key (CCF/RRA). [RE]
 397  FB39              ; ----------------------------------------------------------------------
 398  FB39              KBD_WAIT_KEY:
 399  FB39                      ; poll z80 $E000 = Apple $C000 keyboard register
 400  FB39 3A 00 E0             LD A,($E000)
 401  FB3C                      ; key-ready (bit 7) -> carry
 402  FB3C 17                   RLA
 403  FB3D                      ; spin until a key is down
 404  FB3D 30 FA                JR NC,KBD_WAIT_KEY
 405  FB3F                      ; clear the keyboard strobe (z80 $E010 = Apple $C010)
 406  FB3F 32 10 E0             LD ($E010),A
 407  FB42 3F                   CCF
 408  FB43                      ; A = 7-bit key
 409  FB43 1F                   RRA
 410  FB44 C9                   RET
 411  FB45              ; ----------------------------------------------------------------------
 412  FB45              ; RPC_TRIGGER -- fire a SoftCard 6502<->Z80 RPC.
 413  FB45              ;   In:  HL = command/params; A = trigger value.  Out: per the 6502 service routine.
 414  FB45              ;   Algorithm: stash HL to the command mailbox (z80 $F3D0 = Apple $03D0), then poke
 415  FB45              ;     the trigger cell.  The trigger store-address ($0000 here) is self-modified per
 416  FB45              ;     config at boot, so the store site is RPC_TRIGGER_STORE+1. [RE]
 417  FB45              ; ----------------------------------------------------------------------
 418  FB45              RPC_TRIGGER:
 419  FB45                      ; z80 $F3D0 = Apple $03D0 = RPC command/params mailbox
 420  FB45 22 D0 F3             LD ($F3D0),HL
 421  FB48              RPC_TRIGGER_STORE:
 422  FB48 32 00 00             LD ($0000),A
 423  FB4B C9                   RET
 424  FB4C              ; ----------------------------------------------------------------------
 425  FB4C              ; CONOUT_DISPATCH -- emit a console character, routed by the CP/M IOBYTE.
 426  FB4C              ;   In:  A = character (the BIOS CONOUT arg).  The jump-vector CONOUT entry targets
 427  FB4C              ;        CONOUT_DISPATCH+1 ($FB4D), skipping the leading LD C,A; the fall-through
 428  FB4C              ;        entry here (from the dispatcher) keeps it.
 429  FB4C              ;   Out: none.  Clobbers: A,C,HL.
 430  FB4C              ;   Algorithm: read IOBYTE ($0003), mask the 2-bit CONSOLE field (AND $03).  Field
 431  FB4C              ;     value 2 dispatches through the SoftCard I/O vector at $F392 (Apple $0392) with
 432  FB4C              ;     JP (HL); otherwise fall into the column/tab filter. [RE]
 433  FB4C              ; ----------------------------------------------------------------------
 434  FB4C              CONOUT_DISPATCH:
 435  FB4C                      ; save the character to emit in C for the filter path (skipped by the +1 entry)
 436  FB4C 4F                   LD C,A
 437  FB4D                      ; read the CP/M IOBYTE (page-zero $0003)
 438  FB4D 3A 03 00             LD A,($0003)
 439  FB50                      ; isolate the 2-bit CONSOLE device field of the IOBYTE
 440  FB50 E6 03                AND $03
 441  FB52                      ; device value 2 = direct console; anything else takes the filter path
 442  FB52 FE 02                CP $02
 443  FB54 20 4B                JR NZ,CONOUT_FILTER_NOEXPAND
 444  FB56              CONOUT_VIA_VEC_F392:
 445  FB56                      ; load console-output handler addr from SoftCard I/O vector ($F392 = Apple $0392)
 446  FB56 2A 92 F3             LD HL,($F392)
 447  FB59 E9                   JP (HL)
 448  FB5A              ; ----------------------------------------------------------------------
 449  FB5A              ; CONIN_DISPATCH_IOBYTE -- read a console character, routed by the IOBYTE CONSOLE field.
 450  FB5A              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 451  FB5A              ;   Algorithm: read IOBYTE, mask the CONSOLE field (AND $03).  Value 2 uses vector
 452  FB5A              ;     $F38A; the high value ($02<x) uses the preloaded $F384; low values use $F382;
 453  FB5A              ;     then JP (HL) into the chosen handler.  ($F38x = Apple $038x I/O vector.)
 454  FB5A              ;     Called by CONIN (the remap wrapper) and reused by READER. [RE]
 455  FB5A              ; ----------------------------------------------------------------------
 456  FB5A              CONIN_DISPATCH_IOBYTE:
 457  FB5A                      ; read the CP/M IOBYTE
 458  FB5A 3A 03 00             LD A,($0003)
 459  FB5D                      ; isolate the 2-bit CONSOLE device field
 460  FB5D E6 03                AND $03
 461  FB5F FE 02                CP $02
 462  FB61                      ; preload the input vector for the high CONSOLE value ($F384 = Apple $0384)
 463  FB61 2A 84 F3             LD HL,($F384)
 464  FB64 28 06                JR Z,CONIN_VIA_VEC_F38A
 465  FB66 30 07                JR NC,DISPATCH_VIA_HL
 466  FB68              CONIN_VIA_VEC_F382:
 467  FB68                      ; input vector for the low CONSOLE values ($F382 = Apple $0382)
 468  FB68 2A 82 F3             LD HL,($F382)
 469  FB6B E9                   JP (HL)
 470  FB6C              CONIN_VIA_VEC_F38A:
 471  FB6C                      ; input vector for CONSOLE value 2 ($F38A = Apple $038A)
 472  FB6C 2A 8A F3             LD HL,($F38A)
 473  FB6F              DISPATCH_VIA_HL:
 474  FB6F E9                   JP (HL)
 475  FB70              ; ----------------------------------------------------------------------
 476  FB70              ; LIST -- emit a character to the list device, routed by the IOBYTE LIST field.
 477  FB70              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 478  FB70              ;   Algorithm: read IOBYTE, mask the top 2-bit LIST field (AND $C0).  Below $80
 479  FB70              ;     routes to the column/tab filter; == $80 reuses the console vector path
 480  FB70              ;     (CONOUT_VIA_VEC_F392); higher values dispatch through list vector $F394
 481  FB70              ;     (Apple $0394). [RE]
 482  FB70              ; ----------------------------------------------------------------------
 483  FB70              LIST:
 484  FB70 3A 03 00             LD A,($0003)
 485  FB73                      ; isolate the 2-bit LIST device field (top bits of the IOBYTE)
 486  FB73 E6 C0                AND $C0
 487  FB75 FE 80                CP $80
 488  FB77                      ; field < $80 -> no-device / filter path
 489  FB77 38 27                JR C,DISPATCH_NODEV
 490  FB79                      ; field == $80 -> reuse the console output vector path
 491  FB79 28 DB                JR Z,CONOUT_VIA_VEC_F392
 492  FB7B                      ; list-handler vector ($F394 = Apple $0394)
 493  FB7B 2A 94 F3             LD HL,($F394)
 494  FB7E E9                   JP (HL)
 495  FB7F              ; ----------------------------------------------------------------------
 496  FB7F              ; PUNCH -- emit a character to the punch device, routed by the IOBYTE PUNCH field.
 497  FB7F              ;   In:  C = character.  Out: none.  Clobbers: A,HL.
 498  FB7F              ;   Algorithm: read IOBYTE, mask the PUNCH field (AND $30).  Below $10 takes the
 499  FB7F              ;     column/tab filter; == $10 dispatches through vector $F38E; higher values use
 500  FB7F              ;     vector $F390.  ($F38E/$F390 = Apple $038E/$0390.) [RE]
 501  FB7F              ; ----------------------------------------------------------------------
 502  FB7F              PUNCH:
 503  FB7F 3A 03 00             LD A,($0003)
 504  FB82                      ; isolate the 2-bit PUNCH device field of the IOBYTE
 505  FB82 E6 30                AND $30
 506  FB84 FE 10                CP $10
 507  FB86                      ; field < $10 -> no-device / filter path
 508  FB86 38 18                JR C,DISPATCH_NODEV
 509  FB88                      ; punch vector for the higher PUNCH values ($F38E = Apple $038E)
 510  FB88 2A 8E F3             LD HL,($F38E)
 511  FB8B                      ; field == $10 -> use the $F390 vector below
 512  FB8B 28 E2                JR Z,DISPATCH_VIA_HL
 513  FB8D                      ; punch vector for PUNCH value $10 ($F390 = Apple $0390)
 514  FB8D 2A 90 F3             LD HL,($F390)
 515  FB90 E9                   JP (HL)
 516  FB91              ; ----------------------------------------------------------------------
 517  FB91              ; READER -- read a character from the reader device, routed by the IOBYTE READER field.
 518  FB91              ;   In:  none.  Out: A = character.  Clobbers: A,HL.
 519  FB91              ;   Algorithm: read IOBYTE, mask the READER field (AND $0C), compare against $08. Field
 520  FB91              ;     < $08 ($00/$04) reuses the CONIN $F382 vector; == $08 reuses the CONIN $F38A vector;
 521  FB91              ;     > $08 ($0C) uses the reader vector $F38C (Apple $038C). [RE]
 522  FB91              ; ----------------------------------------------------------------------
 523  FB91              READER:
 524  FB91 3A 03 00             LD A,($0003)
 525  FB94                      ; isolate the 2-bit READER device field of the IOBYTE
 526  FB94 E6 0C                AND $0C
 527  FB96 FE 08                CP $08
 528  FB98                      ; field < $08 ($00/$04) -> reuse the CONIN $F382 vector path
 529  FB98 38 CE                JR C,CONIN_VIA_VEC_F382
 530  FB9A                      ; field == $08 -> reuse the CONIN $F38A vector path
 531  FB9A 28 D0                JR Z,CONIN_VIA_VEC_F38A
 532  FB9C                      ; reader-handler vector ($F38C = Apple $038C)
 533  FB9C 2A 8C F3             LD HL,($F38C)
 534  FB9F E9                   JP (HL)
 535  FBA0              ; ----------------------------------------------------------------------
 536  FBA0              ; DISPATCH_NODEV -- IOBYTE field selects no physical device: fall into the filter.
 537  FBA0              ;   In:  carry set by the caller (no-device).  Out: enters CONOUT_FILTER_NOEXPAND
 538  FBA0              ;        with the carry folded into the COL_FLAG byte.  Clobbers: A,HL.
 539  FBA0              ;   Algorithm: SCF then (CONOUT_FILTER_NOEXPAND) SBC A,A turns carry into a 0/$FF
 540  FBA0              ;     flag stored in COL_FLAG ($FECB); clear bit 7 of the char in C; if the pending-
 541  FBA0              ;     column counter ($FECC) is nonzero, apply a config-driven column offset, else
 542  FBA0              ;     fall through to the tab/control expansion (SETDMA_1). [RE]
 543  FBA0              ; ----------------------------------------------------------------------
 544  FBA0              DISPATCH_NODEV:
 545  FBA0                      ; carry-set entry: mark the expand flag before SBC A,A turns it into $FF
 546  FBA0 37                   SCF
 547  FBA1              CONOUT_FILTER_NOEXPAND:
 548  FBA1                      ; convert carry into a 0/$FF flag byte for COL_FLAG
 549  FBA1 9F                   SBC A,A
 550  FBA2 21 A2 F3             LD HL,$F3A2
 551  FBA5 6E                   LD L,(HL)
 552  FBA6 2C                   INC L
 553  FBA7 CA A4 FC             JP Z,SCREEN_EMIT
 554  FBAA                      ; HL -> COL_FLAG cell ($FECB)
 555  FBAA 21 CB FE             LD HL,COL_FLAG
 556  FBAD                      ; store the entry flag into COL_FLAG
 557  FBAD 77                   LD (HL),A
 558  FBAE                      ; strip the high bit of the character (7-bit ASCII)
 559  FBAE CB B9                RES 7,C
 560  FBB0 23                   INC HL
 561  FBB1                      ; load COL_PENDING (pending column-skip / fill count, $FECC)
 562  FBB1 7E                   LD A,(HL)
 563  FBB2 B7                   OR A
 564  FBB3                      ; no pending column work -> run tab/control expansion
 565  FBB3 CA 56 FC             JP Z,SETDMA_1
 566  FBB6                      ; consume one pending column step
 567  FBB6 35                   DEC (HL)
 568  FBB7                      ; read screen-width / left-margin config byte ($F396 = Apple $0396)
 569  FBB7 3A 96 F3             LD A,($F396)
 570  FBBA                      ; HL -> the column cell in the $FE85 deblock/screen-state band ($FED4)
 571  FBBA 21 D4 FE             LD HL,BOOT_TMPL_XORA
 572  FBBD                      ; config byte zero -> derive the offset from the running width
 573  FBBD 28 0C                JR Z,COL_OFFSET_FROM_WIDTH
 574  FBBF B7                   OR A
 575  FBC0 F2 C6 FB             JP P,COL_APPLY_OFFSET_RAW
 576  FBC3 2B                   DEC HL
 577  FBC4              ; ----------------------------------------------------------------------
 578  FBC4              ; COL_APPLY_OFFSET -- apply a signed config offset to the running column position.
 579  FBC4              ;   In:  A = config byte (sign bit = direction); C = current column; HL -> column cell.
 580  FBC4              ;   Out: (HL) = C - offset.  Clobbers: A,E.
 581  FBC4              ;   Algorithm: AND $7F drops the sign bit to the magnitude, subtract it from the
 582  FBC4              ;     current column in C, store the new column.  Reached when the config byte's sign
 583  FBC4              ;     indicates a subtractive column adjust. [RE]
 584  FBC4              ; ----------------------------------------------------------------------
 585  FBC4              COL_APPLY_OFFSET:
 586  FBC4                      ; drop the sign bit to get the offset magnitude
 587  FBC4 E6 7F                AND $7F
 588  FBC6              COL_APPLY_OFFSET_RAW:
 589  FBC6 5F                   LD E,A
 590  FBC7 79                   LD A,C
 591  FBC8                      ; new column = current column (C) minus the offset
 592  FBC8 93                   SUB E
 593  FBC9                      ; store the updated column position
 594  FBC9 77                   LD (HL),A
 595  FBCA C9                   RET
 596  FBCB              ; ----------------------------------------------------------------------
 597  FBCB              ; COL_OFFSET_FROM_WIDTH -- derive the column offset from the running screen width.
 598  FBCB              ;   In:  C = current column; the BOOT-overlaid base word at (BOOT+2).
 599  FBCB              ;   Out: updates the column and emits via SCREEN_EMIT; combines a base address with
 600  FBCB              ;        the offset.  Clobbers: A,B,C,DE,HL.
 601  FBCB              ;   Algorithm: pick the column cell by the config sign, CALL COL_APPLY_OFFSET, then
 602  FBCB              ;     load the base word (BOOT+2 = the cold-boot operand reused as deblock
 603  FBCB              ;     scratch), fold in config $F3A1, and ADD to form the screen address before
 604  FBCB              ;     emitting (SCREEN_EMIT). [RE]
 605  FBCB              ; ----------------------------------------------------------------------
 606  FBCB              COL_OFFSET_FROM_WIDTH:
 607  FBCB B7                   OR A
 608  FBCC                      ; config sign negative -> keep the higher column cell
 609  FBCC FA D0 FB             JP M,COL_OFFSET_FROM_WIDTH_1
 610  FBCF 2B                   DEC HL
 611  FBD0              COL_OFFSET_FROM_WIDTH_1:
 612  FBD0                      ; apply the signed column offset (COL_APPLY_OFFSET)
 613  FBD0 CD C4 FB             CALL COL_APPLY_OFFSET
 614  FBD3                      ; base word = the BOOT-overlaid deblock scratch ($FED3)
 615  FBD3 2A D3 FE             LD HL,(BOOT+2)
 616  FBD6                      ; config byte $F3A1 = Apple $03A1 (screen-base modifier)
 617  FBD6 3A A1 F3             LD A,($F3A1)
 618  FBD9 B7                   OR A
 619  FBDA                      ; config positive -> use HL as-is, skip the byte swap
 620  FBDA F2 E2 FB             JP P,COL_COMBINE_BASE
 621  FBDD                      ; negative: drop the sign bit, then swap H<->L below
 622  FBDD E6 7F                AND $7F
 623  FBDF 5D                   LD E,L
 624  FBE0 6C                   LD L,H
 625  FBE1 63                   LD H,E
 626  FBE2              ; ----------------------------------------------------------------------
 627  FBE2              ; COL_COMBINE_BASE -- fold the config offset into the base address, emit the char.
 628  FBE2              ;   In:  A = config offset; HL = base word; C will receive the high result.
 629  FBE2              ;   Out: pushes the low result, emits via SCREEN_EMIT with B=7, then re-enters the
 630  FBE2              ;        emit path with B=$0A.  Clobbers: A,B,C,DE,HL.
 631  FBE2              ;   Algorithm: C = offset + H; A = offset + L; CALL SCREEN_EMIT (B=7), then fall into
 632  FBE2              ;     CONOUT_EMIT_B with B=$0A. [RE]
 633  FBE2              ; ----------------------------------------------------------------------
 634  FBE2              COL_COMBINE_BASE:
 635  FBE2 5F                   LD E,A
 636  FBE3                      ; C = config offset + base high byte
 637  FBE3 84                   ADD A,H
 638  FBE4 4F                   LD C,A
 639  FBE5 7B                   LD A,E
 640  FBE6                      ; A = config offset + base low byte
 641  FBE6 85                   ADD A,L
 642  FBE7 F5                   PUSH AF
 643  FBE8                      ; mode/count code 7 for the screen emit
 644  FBE8 06 07                LD B,$07
 645  FBEA                      ; emit via the screen handler (SCREEN_EMIT)
 646  FBEA CD A4 FC             CALL SCREEN_EMIT
 647  FBED F1                   POP AF
 648  FBEE                      ; mode/count code $0A for the follow-up emit
 649  FBEE 06 0A                LD B,$0A
 650  FBF0              CHAR_C_TO_SCREEN:
 651  FBF0 4F                   LD C,A
 652  FBF1 C3 A4 FC             JP SCREEN_EMIT
 653  FBF4              ; ----------------------------------------------------------------------
 654  FBF4              ; SETSEC -- BIOS jump-vector entry 11 ($FA24 -> $FBF4): set the requested sector.
 655  FBF4              ;   In:  C = sector number. Out: none. Clobbers: A.
 656  FBF4              ;   Algorithm: store C into the sector cell BOOT+1 ($FED2 = the cold-boot LD SP operand
 657  FBF4              ;        low byte, reused post-boot as the requested-sector cell). The off-image RWTS
 658  FBF4              ;        ($AC39/$AC49) is the consumer; this image only WRITES it. Mirrors 2.20 SETSEC.
 659  FBF4              ;        [RE, transferred from 2.20; the off-image consumer is not in this image]
 660  FBF4              ; ----------------------------------------------------------------------
 661  FBF4              SETSEC:
 662  FBF4 79                   LD A,C
 663  FBF5                      ; store the requested sector into BOOT+1 (reused as the seksec cell)
 664  FBF5 32 D2 FE             LD (BOOT+1),A
 665  FBF8 C9                   RET
 666  FBF9              ; ----------------------------------------------------------------------
 667  FBF9              ; SETDMA -- BIOS jump-vector entry 12 ($FA27 -> $FBF9): set the DMA address.
 668  FBF9              ;   In:  BC = DMA buffer address (the 128-byte CP/M record source/destination).
 669  FBF9              ;   Out: none. Clobbers: none.
 670  FBF9              ;   Algorithm: store BC into the dmaadr cell (SECTOR_BLOCK_PATCH+2 = $FEE1, the
 671  FBF9              ;        operand region of the install-template 'LD ($0003),A'). The OFF-IMAGE
 672  FBF9              ;        deblock copy uses dmaadr as the host<->record transfer endpoint. The 2.20
 673  FBF9              ;        deblock did the LDIR itself; in 2.23 the value is read off-image. [RE]
 674  FBF9              ; ----------------------------------------------------------------------
 675  FBF9              SETDMA:
 676  FBF9                      ; store BC into dmaadr ($FEE1, overlaid on the install-template LD ($0003),A operand)
 677  FBF9 ED 43 E1 FE          LD (DISK_DMAADR+2),BC
 678  FBFD C9                   RET
 679  FBFE 00 00 00...          DEFS    88, $00                  ; fill
 680  FC56              SETDMA_1:
 681  FC56 47                   LD B,A
 682  FC57 21 CD FE             LD HL,COL_STATE
 683  FC5A 7E                   LD A,(HL)
 684  FC5B 5F                   LD E,A
 685  FC5C B7                   OR A
 686  FC5D 20 12                JR NZ,SETDMA_3
 687  FC5F 3A 97 F3             LD A,($F397)
 688  FC62 B7                   OR A
 689  FC63 28 06                JR Z,SETDMA_2
 690  FC65 B9                   CP C
 691  FC66 20 03                JR NZ,SETDMA_2
 692  FC68 36 80                LD (HL),$80
 693  FC6A C9                   RET
 694  FC6B              SETDMA_2:
 695  FC6B 3E 1F                LD A,$1F
 696  FC6D B9                   CP C
 697  FC6E DA A4 FC             JP C,SCREEN_EMIT
 698  FC71              SETDMA_3:
 699  FC71 21 A0 F3             LD HL,$F3A0
 700  FC74 06 09                LD B,$09
 701  FC76              SETDMA_4:
 702  FC76 7E                   LD A,(HL)
 703  FC77 B7                   OR A
 704  FC78 28 04                JR Z,SETDMA_5
 705  FC7A AB                   XOR E
 706  FC7B B9                   CP C
 707  FC7C 28 05                JR Z,SETDMA_6
 708  FC7E              SETDMA_5:
 709  FC7E 2B                   DEC HL
 710  FC7F 10 F5                DJNZ SETDMA_4
 711  FC81 18 21                JR SCREEN_EMIT
 712  FC83              SETDMA_6:
 713  FC83 11 0B 00             LD DE,$000B
 714  FC86 19                   ADD HL,DE
 715  FC87 7E                   LD A,(HL)
 716  FC88 B7                   OR A
 717  FC89 4F                   LD C,A
 718  FC8A F2 9A FC             JP P,SETDMA_7
 719  FC8D E6 7F                AND $7F
 720  FC8F 4F                   LD C,A
 721  FC90 C5                   PUSH BC
 722  FC91 3A A2 F3             LD A,($F3A2)
 723  FC94 06 07                LD B,$07
 724  FC96 CD F0 FB             CALL CHAR_C_TO_SCREEN
 725  FC99 C1                   POP BC
 726  FC9A              SETDMA_7:
 727  FC9A 78                   LD A,B
 728  FC9B FE 07                CP $07
 729  FC9D 20 05                JR NZ,SCREEN_EMIT
 730  FC9F 3E 02                LD A,$02
 731  FCA1 32 CC FE             LD (COL_PENDING),A
 732  FCA4              SCREEN_EMIT:
 733  FCA4 AF                   XOR A
 734  FCA5 32 CD FE             LD (COL_STATE),A
 735  FCA8 3A CB FE             LD A,(COL_FLAG)
 736  FCAB B7                   OR A
 737  FCAC 2A 88 F3             LD HL,($F388)
 738  FCAF 28 03                JR Z,SCREEN_EMIT_1
 739  FCB1 2A 86 F3             LD HL,($F386)
 740  FCB4              SCREEN_EMIT_1:
 741  FCB4 E9                   JP (HL)
 742  FCB5              SCREEN_EMIT_2:
 743  FCB5 11 03 00             LD DE,$0003
 744  FCB8              SCREEN_EMIT_3:
 745  FCB8 C3 BB FC             JP SCREEN_EMIT_4
 746  FCBB              SCREEN_EMIT_4:
 747  FCBB 2A CE FE             LD HL,(SCREEN_CURSOR_PTR)
 748  FCBE 3A D0 FE             LD A,(SCREEN_CHAR)
 749  FCC1 77                   LD (HL),A
 750  FCC2 CD E2 FC             CALL CTRL_CHAR_DISPATCH
 751  FCC5 2A 28 F0             LD HL,($F028)
 752  FCC8 3A 24 F0             LD A,($F024)
 753  FCCB 5F                   LD E,A
 754  FCCC 16 F0                LD D,$F0
 755  FCCE 19                   ADD HL,DE

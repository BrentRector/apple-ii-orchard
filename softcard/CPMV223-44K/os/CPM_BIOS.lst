 821  FDC1              ; SCREEN_RPC_HELPER -- read back a screen byte via the RPC: position, fire the RPC, fetch.
 822  FDC1              SCREEN_RPC_HELPER:
 823  FDC1 CD 83 FD             CALL SET_SCREEN_BASE                    ; compute the screen base for the current row
 824  FDC4 21 4D C8             LD HL,$C84D                      ; 6502 RPC parameter (Apple expansion-ROM addr)
 825  FDC7 CD 45 FB             CALL RPC_TRIGGER                 ; run the embedded 6502 service on the 6502
 826  FDCA 21 78 F6             LD HL,$F678                      ; HL = row buffer base (Apple $0678)
 827  FDCD 19                   ADD HL,DE
 828  FDCE 7E                   LD A,(HL)                        ; read back the character
 829  FDCF C9                   RET
 830  FDD0              ; RPC6502_SERVICE_223 -- the embedded 6502 RPC service ($FDD0-$FE41 = Apple $0DD0); its
 831  FDD0              ; own ca65 source CPM_RPC6502_223.s is sub-assembled and INCBIN'd here (the 2.20
 832  FDD0              ; CPM_RPC6502 pattern). It forms a slot-ROM pointer ($CFFF disables expansion ROM),
 833  FDD0              ; LDA ($F6),Y, and JMP ($00F6) dispatches into the selected slot-ROM/firmware routine.
 834  FDD0              RPC6502_SERVICE_223:
 835  FDD0              ;   >>> CPM_RPC6502_223.s -- verbatim listing of the INCBIN'd source (regen: inject_incbin_listing) >>>
 836  FDD0              ;
 837  FDD0              ; .org $0DD0
 838  FDD0              ;
 839  FDD0              ; L_0DD0:
 840  FDD0              ;         PHA                          ; $0DD0  48
 841  FDD0              ;         JSR SUB_0E1D                 ; $0DD1  20 1D 0E
 842  FDD0              ;         LDY #$0D                     ; $0DD4  A0 0D
 843  FDD0              ; L_0DD6:
 844  FDD0              ;         LDA ($F6),Y                  ; $0DD6  B1 F6
 845  FDD0              ;         STA $F6                      ; $0DD8  85 F6
 846  FDD0              ;         LDY $06F8                    ; $0DDA  AC F8 06
 847  FDD0              ;         PLA                          ; $0DDD  68
 848  FDD0              ;         JMP ($00F6)                ; $0DDE  6C F6 00
 849  FDD0              ; L_0DE1:
 850  FDD0              ;         PHA                          ; $0DE1  48
 851  FDD0              ;         LDA #$00                     ; $0DE2  A9 00
 852  FDD0              ;         JSR SUB_0DEF                 ; $0DE4  20 EF 0D
 853  FDD0              ;         JSR SUB_0E1D                 ; $0DE7  20 1D 0E
 854  FDD0              ;         LDY #$0F                     ; $0DEA  A0 0F
 855  FDD0              ;         JMP L_0DD6                   ; $0DEC  4C D6 0D
 856  FDD0              ; SUB_0DEF:
 857  FDD0              ;         STY $F5                      ; $0DEF  84 F5
 858  FDD0              ;         PHA                          ; $0DF1  48
 859  FDD0              ;         JSR SUB_0E14                 ; $0DF2  20 14 0E
 860  FDD0              ;         PLA                          ; $0DF5  68
 861  FDD0              ;         LDY $F5                      ; $0DF6  A4 F5
 862  FDD0              ;         BCC SUB_0DEF                 ; $0DF8  90 F5
 863  FDD0              ;         RTS                          ; $0DFA  60
 864  FDD0              ;         .byte   $00, $00, $00, $00, $00, $4C, $E9, $BB, $4C, $04, $BE, $A9, $01, $20, $EF, $0D ; $0DFB
 865  FDD0              ;         .byte   $20, $1D, $0E, $48, $A0, $0E, $4C, $D6, $0D      ; $0E0B
 866  FDD0              ; SUB_0E14:
 867  FDD0              ;         PHA                          ; $0E14  48
 868  FDD0              ;         JSR SUB_0E1D                 ; $0E15  20 1D 0E
 869  FDD0              ;         LDY #$10                     ; $0E18  A0 10
 870  FDD0              ;         JMP L_0DD6                   ; $0E1A  4C D6 0D
 871  FDD0              ; SUB_0E1D:
 872  FDD0              ;         TYA                          ; $0E1D  98
 873  FDD0              ;         ORA #$C0                     ; $0E1E  09 C0
 874  FDD0              ;         TAX                          ; $0E20  AA
 875  FDD0              ;         TYA                          ; $0E21  98
 876  FDD0              ;         ASL                          ; $0E22  0A
 877  FDD0              ;         ASL                          ; $0E23  0A
 878  FDD0              ;         ASL                          ; $0E24  0A
 879  FDD0              ;         ASL                          ; $0E25  0A
 880  FDD0              ;         TAY                          ; $0E26  A8
 881  FDD0              ;         STY $06F8                    ; $0E27  8C F8 06
 882  FDD0              ;         LDA #$00                     ; $0E2A  A9 00
 883  FDD0              ;         STA $F6                      ; $0E2C  85 F6
 884  FDD0              ;         STX $F7                      ; $0E2E  86 F7
 885  FDD0              ;         LDA $CFFF                    ; $0E30  AD FF CF
 886  FDD0              ;         LDA ($F6),Y                  ; $0E33  B1 F6
 887  FDD0              ;         RTS                          ; $0E35  60
 888  FDD0              ; SUB_0E1D_1:
 889  FDD0              ;         LDA $48                      ; $0E36  A5 48
 890  FDD0              ;         PHA                          ; $0E38  48
 891  FDD0              ;         LDA $45                      ; $0E39  A5 45
 892  FDD0              ;         LDX $46                      ; $0E3B  A6 46
 893  FDD0              ;         LDY $47                      ; $0E3D  A4 47
 894  FDD0              ;         PLP                          ; $0E3F  28
 895  FDD0              ;         CLI                          ; $0E40  58
 896  FDD0              ;         RTS                          ; $0E41  60
 897  FDD0              ;   <<< end listing <<<
 898  FDD0                      INCBIN "CPM_RPC6502_223.bin"     ; 114 bytes of 6502 (runs on the 6502 via the RPC)
 899  FE42              ; DEV_READ_BIT -- device handler: poll a status bit until set, then read the data byte.
 900  FE42              DEV_READ_BIT:
 901  FE42 CD 81 FE             CALL SLOT_IO_ADDR
 902  FE45              DEV_READ_WAIT:
 903  FE45 7E                   LD A,(HL)
 904  FE46 1F                   RRA                              ; ready bit -> carry
 905  FE47 30 FC                JR NC,DEV_READ_WAIT
 906  FE49 2C                   INC L
 907  FE4A 7E                   LD A,(HL)                        ; read the data byte
 908  FE4B C9                   RET
 909  FE4C              DEV_OUT_1:                               ; default I/O vector handler (LIST stub)
 910  FE4C 11 01 00             LD DE,$0001
 911  FE4F              DEV_OUT_1_JP:
 912  FE4F C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_1_JP+1) patched at boot
 913  FE52              ; DEV_WR_BIT -- device handler: wait for ready, then write C to the slot I/O port.
 914  FE52              DEV_WR_BIT:
 915  FE52 CD B1 FA             CALL DEVICE_IO_BASE
 916  FE55 2E C1                LD L,$C1
 917  FE57              DEV_WR_WAIT:
 918  FE57 7E                   LD A,(HL)
 919  FE58 17                   RLA                              ; ready bit -> carry
 920  FE59 38 FC                JR C,DEV_WR_WAIT
 921  FE5B CD 7C FE             CALL SLOT_IO_ADDR_W
 922  FE5E 71                   LD (HL),C
 923  FE5F              DEV_RET:
 924  FE5F C9                   RET                              ; shared return (DEV_OUT_1/_2 JP here)
 925  FE60              DEV_OUT_2:                               ; default I/O vector handler (PUNCH stub)
 926  FE60 11 02 00             LD DE,$0002
 927  FE63              DEV_OUT_2_JP:
 928  FE63 C3 5F FE             JP DEV_RET                       ; target (DEV_OUT_2_JP+1) patched at boot
 929  FE66              DEV_OUT_3:                               ; default I/O vector handler (READER stub)
 930  FE66 11 02 00             LD DE,$0002
 931  FE69              DEV_OUT_3_JP:
 932  FE69 C3 00 00             JP $0000                         ; whole instruction built at boot (DEV_OUT_3_JP+0/+1/+2)
 933  FE6C              ; ----------------------------------------------------------------------
 934  FE6C              ; HOME -- BIOS jump-vector entry 8 ($FA18): seek the selected drive to track 0. [RE]
 935  FE6C              ;   In:  none. Out: none. Clobbers: A,C.
 936  FE6C              ;   Algorithm: if the host buffer still holds a pending write (hstwrt nonzero) leave
 937  FE6C              ;     hstact set so the dirty buffer is not dropped; else clear hstact (host buffer
 938  FE6C              ;     inactive). Then fall through into SETTRK_STORE with track 0. Mirrors the 2.20
 939  FE6C              ;     twin HOME exactly; the actual head step happens later in the deblock path. [RE]
 940  FE6C              ; ----------------------------------------------------------------------
 941  FE6C              HOME:
 942  FE6C                      ; read hstwrt (host-write-pending flag; lives in the BOOT install-template cells)
 943  FE6C 3A D9 FE             LD A,(DISK_HSTWRT)
 944  FE6F B7                   OR A
 945  FE70                      ; pending write -> keep hstact set, skip the clear
 946  FE70 20 03                JR NZ,SETTRK_STORE
 947  FE72                      ; no pending write: clear hstact so the host buffer is reloaded on next access
 948  FE72 32 D8 FE             LD (DISK_HSTACT),A
 949  FE75              ; ----------------------------------------------------------------------
 950  FE75              ; SETTRK_STORE -- HOME falls in here with track 0; common tail with SETTRK. [RE]
 951  FE75              ;   In:  (HOME path) forces C=0. Out: stores sektrk. Clobbers: A,C.
 952  FE75              ;   Algorithm: load C=0, then fall into SETTRK's store (the $FE77 vector body) which
 953  FE75              ;     writes the track into the BOOT 'LD SP' operand byte reused as sektrk. [RE]
 954  FE75              ; ----------------------------------------------------------------------
 955  FE75              SETTRK_STORE:
 956  FE75                      ; HOME enters here with track 0; SETTRK enters at the LD A,C below
 957  FE75 0E 00                LD C,$00
 958  FE77                      ; SETTRK (vector entry 10, JP $FE77): track number from BDOS in C
 959  FE77 79                   LD A,C
 960  FE78                      ; store sektrk into BOOT's LD SP operand byte (BOOT cell reused post-boot as sektrk)
 961  FE78 32 D1 FE             LD (BOOT),A
 962  FE7B C9                   RET
 963  FE7C              ; ----------------------------------------------------------------------
 964  FE7C              ; SLOT_IO_ADDR_W -- map a slot/drive index to an Apple write-side I/O soft-switch base.
 965  FE7C              ;   In:  E = slot/drive index (0..15). Out: HL = $E080 + (E<<4). Clobbers: A,L.
 966  FE7C              ;   Algorithm: load the $C08x write/control-bank base (z80 $E080 = Apple $C080), then
 967  FE7C              ;     fall into the shared index scaler (SLOT_IO_SCALE, the ADD A,A x4 at $FE85).
 968  FE7C              ;     Twin of 2.20 SLOT_IO_ADDR_W. [RE]
 969  FE7C              ; ----------------------------------------------------------------------
 970  FE7C              SLOT_IO_ADDR_W:
 971  FE7C                      ; z80 $E080 = Apple $C080 slot-I/O base (write/control bank)
 972  FE7C 21 80 E0             LD HL,$E080
 973  FE7F 18 03                JR SLOT_IO_SCALE_E
 974  FE81              ; ----------------------------------------------------------------------
 975  FE81              ; SLOT_IO_ADDR -- map a slot/drive index to an Apple I/O soft-switch base ($C08E bank).
 976  FE81              ;   In:  E = slot/drive index (0..15). Out: HL = $E08E + (E<<4). Clobbers: A,L.
 977  FE81              ;   Algorithm: load the $C08E base, fall into SLOT_IO_SCALE_E. z80 $E08E = Apple $C08E.
 978  FE81              ;     Twin of 2.20 SLOT_IO_ADDR. [RE]
 979  FE81              ; ----------------------------------------------------------------------
 980  FE81              SLOT_IO_ADDR:
 981  FE81                      ; z80 $E08E = Apple $C08E slot-I/O base
 982  FE81 21 8E E0             LD HL,$E08E
 983  FE84              ; ----------------------------------------------------------------------
 984  FE84              ; SLOT_IO_SCALE_E -- load the slot/drive index into A, then fall into SLOT_IO_SCALE.
 985  FE84              ;   In:  E = index. Out: continues into the scaler. Twin of 2.20 SLOT_IO_SCALE_E. [RE]
 986  FE84              ; ----------------------------------------------------------------------
 987  FE84              SLOT_IO_SCALE_E:
 988  FE84                      ; slot/drive index into A for the scaler
 989  FE84 7B                   LD A,E
 990  FE85              ; ----------------------------------------------------------------------
 991  FE85              ; SLOT_IO_SCALE -- shift the index in A left by 4 and add it to L (index a $C0n0..$C0nF
 992  FE85              ;     16-byte slot-I/O block, or a *16-stride table). [RE]
 993  FE85              ;   In:  A = index, L = base low byte. Out: L += A*16; A preserved. Clobbers: A,L.
 994  FE85              ;   Algorithm: ADD A,A four times (A*=16), PUSH AF, ADD A,L, LD L,A, POP AF, RET.
 995  FE85              ;     Shared by SLOT_IO_ADDR/_W and by SELDSK (DPH-table index) and the device probe.
 996  FE85              ;     Twin of 2.20 SLOT_IO_SCALE. [RE]
 997  FE85              ; ----------------------------------------------------------------------
 998  FE85              SLOT_IO_SCALE:
 999  FE85                      ; A *= 16 over the four ADD A,A (slot block is 16 bytes; DPH stride is 16)
1000  FE85 87                   ADD A,A
1001  FE86 87                   ADD A,A
1002  FE87 87                   ADD A,A
1003  FE88 87                   ADD A,A
1004  FE89 F5                   PUSH AF
1005  FE8A                      ; L = base + index*16
1006  FE8A 85                   ADD A,L
1007  FE8B 6F                   LD L,A
1008  FE8C F1                   POP AF
1009  FE8D C9                   RET
1010  FE8E              ; ----------------------------------------------------------------------
1011  FE8E              ; SELDSK -- BIOS jump-vector entry 9 ($FA1B): select the disk drive for subsequent I/O.
1012  FE8E              ;   In:  C = disk number (0-based). Out: HL = DPH address for drive C, or HL=0 if out
1013  FE8E              ;     of range. Clobbers: A,DE,HL.
1014  FE8E              ;   Algorithm: DE -> the sekdsk build site (DISK_SEKDSK, an install-template cell reused
1015  FE8E              ;     as disk-state scratch). Read the configured drive count from the SoftCard config
1016  FE8E              ;     block (z80 $F3B8 = Apple $03B8); if C >= count return HL=0. Else record the disk
1017  FE8E              ;     number, index the DPH table at DPH_TABLE by C*16 (CALL SLOT_IO_SCALE), pull a per-drive
1018  FE8E              ;     disk-parameter byte and self-modify the install template SECTOR_BLOCK_PATCH+1 with it.
1019  FE8E              ;     Twin of 2.20 SELDSK. [RE]
1020  FE8E              ; ----------------------------------------------------------------------
1021  FE8E              SELDSK:
1022  FE8E                      ; DE -> sekdsk build site (install-template cell reused as disk-select scratch)
1023  FE8E 11 D5 FE             LD DE,DISK_SEKDSK
1024  FE91 21 04 00             LD HL,$0004
1025  FE94                      ; configured drive count from the SoftCard config block (Apple $03B8)
1026  FE94 3A B8 F3             LD A,($F3B8)
1027  FE97 3D                   DEC A
1028  FE98                      ; requested drive vs (count-1); carry => out of range
1029  FE98 B9                   CP C
1030  FE99                      ; out of range -> SELDSK_BAD_DRIVE (returns HL=0)
1031  FE99 38 1D                JR C,SELDSK_BAD_DRIVE
1032  FE9B 7E                   LD A,(HL)
1033  FE9C 12                   LD (DE),A
1034  FE9D 13                   INC DE
1035  FE9E 79                   LD A,C
1036  FE9F 12                   LD (DE),A
1037  FEA0                      ; HL = DPH table base ($FA33); CALL SLOT_IO_SCALE indexes it by C*16
1038  FEA0 21 33 FA             LD HL,DPH_TABLE
1039  FEA3 CD 85 FE             CALL SLOT_IO_SCALE
1040  FEA6 E5                   PUSH HL
1041  FEA7 11 0A 00             LD DE,$000A
1042  FEAA 19                   ADD HL,DE
1043  FEAB 5E                   LD E,(HL)
1044  FEAC 23                   INC HL
1045  FEAD 56                   LD D,(HL)
1046  FEAE 21 05 00             LD HL,$0005
1047  FEB1 19                   ADD HL,DE
1048  FEB2 7E                   LD A,(HL)
1049  FEB3                      ; self-modify: store the per-drive disk-parameter byte into the install template's LD
1050  FEB3                      ; HL,(nn) operand [RE]
1051  FEB3 32 E3 FE             LD (SECTOR_BLOCK_PATCH+1),A
1052  FEB6 E1                   POP HL
1053  FEB7 C9                   RET
1054  FEB8              ; ----------------------------------------------------------------------
1055  FEB8              ; SELDSK_BAD_DRIVE -- out-of-range drive: return HL=0 (no DPH). [RE]
1056  FEB8              ;   In:  DE -> sekdsk build site. Out: HL=0. Clobbers: A,L.
1057  FEB8              ;   Twin of 2.20 SELDSK_BAD_DRIVE. [RE]
1058  FEB8              ; ----------------------------------------------------------------------
1059  FEB8              SELDSK_BAD_DRIVE:
1060  FEB8 1A                   LD A,(DE)
1061  FEB9 77                   LD (HL),A
1062  FEBA                      ; HL=0 signals an invalid drive to the BDOS
1063  FEBA 2E 00                LD L,$00
1064  FEBC C9                   RET
1065  FEBD              ; ----------------------------------------------------------------------
1066  FEBD              ; READ -- BIOS jump-vector entry 13 ($FA27): read one 128-byte CP/M record.
1067  FEBD              ;   In:  sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1068  FEBD              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS read core at $AC39, which sits
1069  FEBD              ;     in the system-image region BELOW the BIOS (not inside $FA00-$FFFF). FLAG: unlike
1070  FEBD              ;     the 2.20 twin, the 2.23 BIOS does NOT carry the deblock or the $03E0-IOB RWTS RPC
1071  FEBD              ;     in-image; READ/WRITE delegate to the $ACxx host-sector routines. [RE] -- see flags.
1072  FEBD              ; ----------------------------------------------------------------------
1073  FEBD              READ:
1074  FEBD                      ; off-image jump to the deblock/RWTS read core at $AC39 (system-image region, not BIOS) [RE]
1075  FEBD C3 39 AC             JP $AC39
1076  FEC0              ; ----------------------------------------------------------------------
1077  FEC0              ; WRITE -- BIOS jump-vector entry 14 ($FA2A): write one 128-byte CP/M record.
1078  FEC0              ;   In:  C = write type; sekdsk/sektrk/seksec/dmaadr previously set. Out: A=0 ok / 1 error.
1079  FEC0              ;   Algorithm: OFF-IMAGE tail-jump to the deblock/RWTS write core at $AC49 (system-image
1080  FEC0              ;     region below the BIOS). Same off-image RWTS delegation as READ_RECORD. [RE]
1081  FEC0              ;   NOTE: the bytes at $FEC3-$FECA ($C3 $45 $FB $2A $0D $9C $E9 $C9) immediately after
1082  FEC0              ;     this JP are NOT executed on the WRITE path; they are install/handler scratch -- see flags.
1083  FEC0              ; ----------------------------------------------------------------------
1084  FEC0              WRITE:
1085  FEC0                      ; off-image jump to the deblock/RWTS write core at $AC49 (system-image region, not BIOS)
1086  FEC0                      ; [RE]
1087  FEC0 C3 49 AC             JP $AC49
1088  FEC3 C3 45 FB 2A          DEFB    $C3,$45,$FB,$2A,$0D      ; "CE{*"
1088  FEC7 0D
1089  FEC8 9C E9 C9             DEFB    $9C,$E9,$C9
1090  FECB              COL_FLAG:
1091  FECB 00                   DEFB    "\0"
1092  FECC              COL_PENDING:
1093  FECC 00                   DEFB    "\0"
1094  FECD              COL_STATE:
1095  FECD 00                   DEFB    "\0"
1096  FECE              SCREEN_CURSOR_PTR:
1097  FECE D0 FE                DEFB    $D0,$FE
1098  FED0              SCREEN_CHAR:
1099  FED0 00                   DEFB    "\0"
1100  FED1              ; ----------------------------------------------------------------------
1101  FED1              ; BOOT -- CP/M cold-boot BIOS entry (jump-vector entry 0; $FA00 -> here at $FED1).
1102  FED1              ;   In:  none. Out: does not return through here (falls into the install engine).
1103  FED1              ;   Clobbers: all.
1104  FED1              ;   DUAL USE of the operand bytes: this 'LD SP,$0100' executes ONCE at cold boot to set
1105  FED1              ;     the Z-80 stack; afterwards BOOT (the $00 operand byte) is reused as sektrk and
1106  FED1              ;     BOOT+1 as seksec (SETTRK stores BOOT at $FE78, SETSEC stores
1107  FED1              ;     BOOT+1 at $FBF5), and BOOT+2 ($FED3) is read as a console cursor word
1108  FED1              ;     ($FBD3 LD HL,(BOOT+2)). Valid SP-init bytes only during the single cold-boot
1109  FED1              ;     pass; thereafter disk/console scratch, never re-executed. Twin of 2.20 BOOT. [RE]
1110  FED1              ;   Algorithm: set SP, then fall through into the self-modifying install engine
1111  FED1              ;     (BOOT_TMPL_XORA..SECTOR_BLOCK_PATCH are template-instruction cells whose operands double as
1112  FED1              ;     disk-deblock state).
1113  FED1              ; ----------------------------------------------------------------------
1114  FED1              BOOT:
1115  FED1                      ; init Z-80 stack; BOOT/+1/+2 reused post-boot as sektrk/seksec and a console cursor word
1116  FED1 31 00 01             LD SP,$0100
1117  FED4              ; ----------------------------------------------------------------------
1118  FED4              ; BOOT_TMPL_XORA -- cold-boot install template 'XOR A'; operationally a disk-state cell.
1119  FED4              ;   Boot tenant: 'XOR A' clears A as the install engine starts the page-clear. Operational
1120  FED4              ;   tenant: this cell is referenced as a console/disk scratch base (LD HL,BOOT_TMPL_XORA at
1121  FED4              ;   $FBBA in the console path). Twin region of 2.20 DISK_SELDSK_SAVE. [RE]
1122  FED4              ; ----------------------------------------------------------------------
1123  FED4              BOOT_TMPL_XORA:
1124  FED4 AF                   XOR A
1125  FED5              ; ----------------------------------------------------------------------
1126  FED5              ; DISK_SEKDSK -- cold-boot install template 'LD HL,BIOS_VECTOR'; operationally the sekdsk cell.
1127  FED5              ;   Boot tenant: 'LD HL,nn' template the install engine steps over. Operational tenant:
1128  FED5              ;   SELDSK uses DE=DISK_SEKDSK as the sekdsk build site (selected disk number). Twin of
1129  FED5              ;   2.20 DISK_SEKDSK. [RE]
1130  FED5              ; ----------------------------------------------------------------------
1131  FED5              DISK_SEKDSK:
1132  FED5 21 00 FA             LD HL,BIOS_VECTOR
1133  FED8              ; ----------------------------------------------------------------------
1134  FED8              ; DISK_HSTACT -- cold-boot install template 'LD (HL),A'; operationally the hstact flag.
1135  FED8              ;   Boot tenant: part of the page-zero/template clear. Operational tenant: host-buffer-
1136  FED8              ;   active flag, cleared by HOME ($FE72) and by PAGEZERO_REBUILD ($FAE7), set when a host
1137  FED8              ;   sector is staged. Twin of 2.20 DISK_HSTWRT-area hstact. [RE]
1138  FED8              ; ----------------------------------------------------------------------
1139  FED8              DISK_HSTACT:
1140  FED8 77                   LD (HL),A
1141  FED9              ; ----------------------------------------------------------------------
1142  FED9              ; DISK_HSTWRT -- cold-boot install template 'INC HL'; operationally the hstwrt flag.
1143  FED9              ;   Boot tenant: 'INC HL' advances the install-clear pointer. Operational tenant: host-
1144  FED9              ;   buffer-dirty flag, read by HOME ($FE6C). Twin of 2.20 DISK_HSTWRT. [RE]
1145  FED9              ; ----------------------------------------------------------------------
1146  FED9              DISK_HSTWRT:
1147  FED9 23                   INC HL
1148  FEDA 77                   LD (HL),A
1149  FEDB 23                   INC HL
1150  FEDC 77                   LD (HL),A
1151  FEDD              ; ----------------------------------------------------------------------
1152  FEDD              ; BOOT_TMPL_IOBYTE -- cold-boot install template 'LD A,$95' (default IOBYTE immediate).
1153  FEDD              ;   Boot tenant: loads the default IOBYTE value $95 into A. Operational tenant: this cell
1154  FEDD              ;   is cleared by PAGEZERO_REBUILD ($FAE4) and used as a console-state byte. Twin of the
1155  FEDD              ;   2.20 DISK_HSTWRT 'LD A,$95' default-IOBYTE template. [RE]
1156  FEDD              ; ----------------------------------------------------------------------
1157  FEDD              BOOT_TMPL_IOBYTE:
1158  FEDD                      ; default CP/M IOBYTE immediate ($95) loaded at cold boot
1159  FEDD 3E 95                LD A,$95
1160  FEDF              ; ----------------------------------------------------------------------
1161  FEDF              ; DISK_DMAADR -- cold-boot install template 'LD ($0003),A' (store default IOBYTE);
1162  FEDF              ;     +2 operand reused as dmaadr.
1163  FEDF              ;   Boot tenant: stores the default IOBYTE into page-zero $0003 at cold boot. Operational
1164  FEDF              ;   tenant: SETDMA writes BC into DISK_DMAADR+2 ($FEE1) as the current DMA buffer address
1165  FEDF              ;   (SETDMA 'LD (DISK_DMAADR+2),BC'); the deblock record copy uses it. Twin of the 2.20
1166  FEDF              ;   DISK_WRTYPE/DISK_DMAADR overlay. [RE]
1167  FEDF              ; ----------------------------------------------------------------------
1168  FEDF              DISK_DMAADR:
1169  FEDF                      ; store the default IOBYTE into page-zero $0003; the operand cell (+2) doubles as dmaadr
1170  FEDF 32 03 00             LD ($0003),A
1171  FEE2              ; ----------------------------------------------------------------------
1172  FEE2              ; DISK_PARAM_TMPL -- cold-boot install template 'LD HL,($F3DE)'; SELDSK self-modifies +1.
1173  FEE2              ;   Boot tenant: 'LD HL,(nn)' loads a config word; the install engine continues at $FEE5.
1174  FEE2              ;   Operational tenant: SELDSK patches DISK_PARAM_TMPL+1 ($FEE3) with a per-drive disk-
1175  FEE2              ;   parameter byte. From $FEE5 the cold-boot INSTALL ENGINE proper runs (see body). Twin
1176  FEE2              ;   of 2.20 DISK_UNADSK template + the DEV_INSTALL flow. [RE]
1177  FEE2              ;   Algorithm (install engine from $FEE5): copy the RPC-trigger store address into
1178  FEE2              ;     RPC_TRIGGER_STORE+1; clear page-zero $0004; read the console card class from config
1179  FEE2              ;     $F3BB; for the device-6/Pascal-class console install the $FD99 status handler into
1180  FEE2              ;     the $F380 vector, else for the Videx/40-col classes self-modify the CONST handler
1181  FEE2              ;     (KBD_STATUS_40COL+1) so status reads come from the card; then install CONOUT/CONIN handler
1182  FEE2              ;     vectors via the handler lookups, print the sign-on banner, and enter the CCP.
1183  FEE2              ; ----------------------------------------------------------------------
1184  FEE2              SECTOR_BLOCK_PATCH:
1185  FEE2                      ; install template: load a config word (operand at +1 is self-modified by SELDSK with the
1186  FEE2                      ; disk param)
1187  FEE2 2A DE F3             LD HL,($F3DE)
1188  FEE5                      ; self-modify: write the SoftCard RPC-trigger store address into RPC_TRIGGER_STORE's LD
1189  FEE5                      ; (nn),A operand [RE]
1190  FEE5 22 49 FB             LD (RPC_TRIGGER_STORE+1),HL
1191  FEE8 AF                   XOR A
1192  FEE9                      ; clear page-zero $0004 (current default drive)
1193  FEE9 32 04 00             LD ($0004),A
1194  FEEC                      ; read the configured console card class from the config block (Apple $03BB)
1195  FEEC 3A BB F3             LD A,($F3BB)
1196  FEEF                      ; card class 6 = device-6 / Pascal-firmware console (post-1980 path; absent in the 1980
1197  FEEF                      ; manual) [RE]
1198  FEEF FE 06                CP $06
1199  FEF1 20 0A                JR NZ,DEV_INSTALL_LIST
1200  FEF3                      ; device-6 console: install the $FD99 status handler
1201  FEF3 21 99 FD             LD HL,SET_SCREEN_BASE_1
1202  FEF6                      ; store it into the SoftCard console-status I/O vector cell (Apple $0380)
1203  FEF6 22 80 F3             LD ($F380),HL
1204  FEF9 D6 03                SUB $03
1205  FEFB 18 13                JR DEV_INSTALL_PUNCH
1206  FEFD              ; ----------------------------------------------------------------------
1207  FEFD              ; DEV_INSTALL_LIST -- install the LIST device-output handler from the config class. [RE]
1208  FEFD              ;   In:  install engine running. Out: patches the LIST output stub vector. Clobbers: A,HL.
1209  FEFD              ;   Algorithm: read the LIST card class (config $F3B9 = Apple $03B9), bias by 3; if a
1210  FEFD              ;     real device is configured, look up its handler (CALL HANDLER_LOOKUP) and store it
1211  FEFD              ;     into the LIST stub vector (DEV_OUT_1_JP+1). Twin of 2.20 DEV_INSTALL flow. [RE]
1212  FEFD              ; ----------------------------------------------------------------------
1213  FEFD              DEV_INSTALL_LIST:
1214  FEFD FE 05                CP $05
1215  FEFF 28 22                JR Z,DEV_INSTALL_READER
1216  FF01 D6 03                SUB $03
1217  FF03 38 1E                JR C,DEV_INSTALL_READER
1218  FF05 20 09                JR NZ,DEV_INSTALL_PUNCH
1219  FF07 21 15 FB             LD HL,KBD_STATUS_40COL+1
1220  FF0A 36 BE                LD (HL),$BE
1221  FF0C 23                   INC HL
1222  FF0D 23                   INC HL
1223  FF0E 36 1F                LD (HL),$1F
1224  FF10              ; ----------------------------------------------------------------------
1225  FF10              ; DEV_INSTALL_PUNCH -- install the PUNCH device-output handler from the config class. [RE]
1226  FF10              ;   Algorithm: read the PUNCH card class (config $F3BA = Apple $03BA), bias by 3; if
1227  FF10              ;     configured, look up the handler and store it into the PUNCH stub vector (DEV_OUT_2_JP+1); for
1228  FF10              ;     the higher class value also install a secondary handler into DEV_OUT_3_JP+1. Twin of 2.20
1229  FF10              ;     DEV_INSTALL flow. [RE]
1230  FF10              ; ----------------------------------------------------------------------
1231  FF10              DEV_INSTALL_PUNCH:
1232  FF10 F5                   PUSH AF
1233  FF11 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1234  FF14 F1                   POP AF
1235  FF15 22 B9 FC             LD (SCREEN_EMIT_3+1),HL
1236  FF18                      ; secondary handler lookup via the skip-idiom entry (HANDLER_LOOKUP_B); the FD cover byte at
1237  FF18                      ; DEV_HANDLER_LOOKUP_B is skipped [RE]
1238  FF18 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1239  FF1B 22 37 FB             LD (CONIN_DISPATCH+1),HL
1240  FF1E 3E 03                LD A,$03
1241  FF20 32 05 FB             LD (CCP_LAUNCH+1),A
1242  FF23              ; ----------------------------------------------------------------------
1243  FF23              ; DEV_INSTALL_READER -- build the default READER/list-output stub when none is configured.
1244  FF23              ;   Algorithm: when no real device class is configured, build the no-op stub at DEV_OUT_3_JP:
1245  FF23              ;     store $1A3E ('LD A,$1A' opcode+immediate) then $C9 ('RET') so the device returns a
1246  FF23              ;     constant. Twin of 2.20 DEV_INSTALL_4's DEV_OUT_3 build. [RE]
1247  FF23              ; ----------------------------------------------------------------------
1248  FF23              DEV_INSTALL_READER:
1249  FF23 3A B9 F3             LD A,($F3B9)
1250  FF26 D6 03                SUB $03
1251  FF28 38 06                JR C,INSTALL_DONE_DEVICES
1252  FF2A CD 84 FF             CALL DEV_HANDLER_LOOKUP
1253  FF2D 22 50 FE             LD (DEV_OUT_1_JP+1),HL
1254  FF30              ; ----------------------------------------------------------------------
1255  FF30              ; INSTALL_DONE_DEVICES -- run the device probe after the per-device installs. [RE]
1256  FF30              ;   Algorithm: CALL PROBE_DEVICES (PROBE_DEVICES) to scan the 7 SoftCard config slots and
1257  FF30              ;     mark/init each present card before the banner is printed. Twin of 2.20 DEV_INSTALL_6
1258  FF30              ;     PROBE_DEVICES call. [RE]
1259  FF30              ; ----------------------------------------------------------------------
1260  FF30              INSTALL_DONE_DEVICES:
1261  FF30 3A BA F3             LD A,($F3BA)
1262  FF33 D6 03                SUB $03
1263  FF35 38 14                JR C,SLOT_IO_SCALE_17
1264  FF37 F5                   PUSH AF
1265  FF38 CD 84 FF             CALL DEV_HANDLER_LOOKUP
1266  FF3B 22 64 FE             LD (DEV_OUT_2_JP+1),HL
1267  FF3E F1                   POP AF
1268  FF3F FE 02                CP $02
1269  FF41 28 08                JR Z,SLOT_IO_SCALE_17
1270  FF43 CD 7F FF             CALL DEV_HANDLER_LOOKUP_B+1
1271  FF46 22 6A FE             LD (DEV_OUT_3_JP+1),HL
1272  FF49 18 0B                JR SLOT_IO_SCALE_18
1273  FF4B              SLOT_IO_SCALE_17:
1274  FF4B 21 3E 1A             LD HL,$1A3E
1275  FF4E 22 69 FE             LD (DEV_OUT_3_JP),HL
1276  FF51 3E C9                LD A,$C9
1277  FF53 32 6B FE             LD (DEV_OUT_3_JP+2),A
1278  FF56              SLOT_IO_SCALE_18:
1279  FF56                      ; scan + init the 7 SoftCard config slots (device probe) before the sign-on
1280  FF56 CD 82 FA             CALL PROBE_DEVICES
1281  FF59              ; ----------------------------------------------------------------------
1282  FF59              ; SIGNON_PRINT -- emit the two config-derived sign-on prefix chars, then the banner. [RE]
1283  FF59              ;   In:  none. Out: prints the sign-on. Clobbers: A,HL.
1284  FF59              ;   Algorithm: read config $F398 (Apple $0398), pass it to the CONOUT writer (CONOUT_DISPATCH),
1285  FF59              ;     then walk SIGNON_BANNER (SIGNON_BANNER) char-by-char through CONOUT until the $00
1286  FF59              ;     terminator, then enter PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS). Twin of the 2.20
1287  FF59              ;     DEV_INSTALL_6/
1288  FF59              ;     DEV_INSTALL_7 banner loop (here it routes through CONOUT directly, not SIGNON_EMIT).
1289  FF59              ;     NOTE: WBOOT (WBOOT) also stashes SIGNON_PRINT into the $F3D0 RPC mailbox at
1290  FF59              ;     $FACE for a re-init path. [RE]
1291  FF59              ; ----------------------------------------------------------------------
1292  FF59              SIGNON_PRINT:
1293  FF59                      ; first config-derived sign-on char (Apple $0398)
1294  FF59 3A 98 F3             LD A,($F398)
1295  FF5C                      ; emit it via SIGNON_EMIT (prefixes a config char if bit7 set), routed through CONOUT
1296  FF5C CD 8F FF             CALL SIGNON_EMIT
1297  FF5F                      ; HL -> the cold-boot sign-on banner string
1298  FF5F 21 9E FF             LD HL,SIGNON_BANNER
1299  FF62              ; ----------------------------------------------------------------------
1300  FF62              ; SIGNON_BANNER_LOOP -- print SIGNON_BANNER char-by-char until the $00 terminator. [RE]
1301  FF62              ;   In:  HL -> banner. Out: jumps to PAGEZERO_REBUILD at the terminator. Clobbers: A,HL.
1302  FF62              ;   Algorithm: load (HL); if $00 jump to PAGEZERO_REBUILD (PAGEZERO_REBUILD_HOOKS) to finish cold
1303  FF62              ;     boot; else push HL, CALL CONOUT (CONOUT_DISPATCH), pop, INC HL, repeat. Twin of 2.20
1304  FF62              ;     DEV_INSTALL_7. [RE]
1305  FF62              ; ----------------------------------------------------------------------
1306  FF62              SIGNON_BANNER_LOOP:
1307  FF62 7E                   LD A,(HL)
1308  FF63 B7                   OR A
1309  FF64                      ; banner terminator -> PAGEZERO_REBUILD (write page-zero hooks, enter the CCP)
1310  FF64 CA E3 FA             JP Z,PAGEZERO_REBUILD_HOOKS
1311  FF67 E5                   PUSH HL
1312  FF68                      ; emit one banner char via CONOUT
1313  FF68 CD 4C FB             CALL CONOUT_DISPATCH
1314  FF6B E1                   POP HL
1315  FF6C 23                   INC HL
1316  FF6D 18 F3                JR SIGNON_BANNER_LOOP
1317  FF6F              SLOT_IO_SCALE_21:
1318  FF6F 0E FD                LD C,$FD
1319  FF71 71                   LD (HL),C
1320  FF72 FD                   DEFB $FD  ; ignored IY prefix; inner: LD D,D
1321  FF73 52                   LD D,D
1322  FF74 FE A9                CP $A9
1323  FF76 FD                   DEFB $FD  ; ignored IY prefix; inner: LD B,D
1324  FF77              SLOT_IO_SCALE_22:
1325  FF77 42                   LD B,D
1326  FF78 FE C1                CP $C1
1327  FF7A FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1328  FF7B B7                   OR A
1329  FF7C FD                   DEFB $FD  ; ignored IY prefix; inner: OR A
1330  FF7D B7                   OR A
1331  FF7E              ; ----------------------------------------------------------------------
1332  FF7E              ; DEV_HANDLER_LOOKUP_B -- secondary-table handler lookup, entered at +1 via a skip idiom.
1333  FF7E              ;   In:  A = entry index. Out: HL = handler address from the secondary table. Clobbers: A,HL.
1334  FF7E              ;   SKIP IDIOM: the byte at DEV_HANDLER_LOOKUP_B ($FF7E) is an $FD cover (reads as 'LD IY,$FF77'
1335  FF7E              ;     when fallen into); every CALLER targets DEV_HANDLER_LOOKUP_B+1 ($FF7F) which executes
1336  FF7E              ;     'LD HL,SLOT_IO_SCALE_22' (the secondary DEV_HANDLER_PTRS_B base) then 'JR DEV_HANDLER_
1337  FF7E              ;     LOOKUP_IDX'. Twin of 2.20 DEV_HANDLER_LOOKUP_B (there a clean 'LD HL,..; JR'). [RE]
1338  FF7E              ;   -- see flags for the cover byte and the surrounding DEFB-as-code handler table.
1339  FF7E              ; ----------------------------------------------------------------------
1340  FF7E              DEV_HANDLER_LOOKUP_B:
1341  FF7E                      ; COVER: the FD prefix makes this 'LD IY,$FF77' on fall-in; callers enter at +1 => 'LD
1342  FF7E                      ;        HL,SLOT_IO_SCALE_22' (secondary table base) [RE]
1343  FF7E FD 21 77 FF          LD IY,SLOT_IO_SCALE_22
1344  FF82                      ; join the shared index tail (HL += A*2; load the word)
1345  FF82 18 03                JR DEV_HANDLER_LOOKUP_IDX
1346  FF84              ; ----------------------------------------------------------------------
1347  FF84              ; DEV_HANDLER_LOOKUP -- fetch a device-handler address from the primary pointer table.
1348  FF84              ;   In:  A = entry index (0-based). Out: HL = handler address. Clobbers: A,HL.
1349  FF84              ;   Algorithm: HL = DEV_HANDLER_PTRS base (SLOT_IO_SCALE_21); fall into the shared scaler
1350  FF84              ;     (ADD A,A; ADD A,L; LD L,A) then load the 16-bit word at that slot (low then high).
1351  FF84              ;     The secondary-table entry is HANDLER_LOOKUP_B at DEV_HANDLER_LOOKUP_B+1 (skip idiom). Twin
1352  FF84              ;     of 2.20 DEV_HANDLER_LOOKUP. [RE]
1353  FF84              ; ----------------------------------------------------------------------
1354  FF84              DEV_HANDLER_LOOKUP:
1355  FF84                      ; select the primary device-handler pointer table
1356  FF84 21 6F FF             LD HL,SLOT_IO_SCALE_21
1357  FF87              ; ----------------------------------------------------------------------
1358  FF87              ; DEV_HANDLER_LOOKUP_IDX -- shared table-index tail: HL += A*2; HL = word at that slot.
1359  FF87              ;   In:  A = index, HL = table base. Out: HL = the 16-bit handler address. Clobbers: A,HL.
1360  FF87              ;   Twin of 2.20 DISK_RTN_LOOKUP_IDX. [RE]
1361  FF87              ; ----------------------------------------------------------------------
1362  FF87              DEV_HANDLER_LOOKUP_IDX:
1363  FF87                      ; index*2 for 16-bit (word) table entries
1364  FF87 87                   ADD A,A
1365  FF88 85                   ADD A,L
1366  FF89 6F                   LD L,A
1367  FF8A                      ; load handler address low byte
1368  FF8A 7E                   LD A,(HL)
1369  FF8B 2C                   INC L
1370  FF8C                      ; load handler address high byte -> HL = handler entry
1371  FF8C 66                   LD H,(HL)
1372  FF8D 6F                   LD L,A
1373  FF8E C9                   RET
1374  FF8F              ; ----------------------------------------------------------------------
1375  FF8F              ; SIGNON_EMIT -- emit one sign-on byte, optionally preceded by a fixed prefix char.
1376  FF8F              ;   In:  A = byte/flag. Out: prints via CONOUT (CONOUT_DISPATCH). Clobbers: A,HL.
1377  FF8F              ;   Algorithm: if A is positive (bit7 clear) emit it directly via CONOUT; if negative,
1378  FF8F              ;     first emit the prefix char from config $F397 (Apple $0397), then tail-jump to
1379  FF8F              ;     CONOUT to emit A. Twin of 2.20 SIGNON_EMIT. [RE]
1380  FF8F              ; ----------------------------------------------------------------------
1381  FF8F              SIGNON_EMIT:
1382  FF8F B7                   OR A
1383  FF90                      ; bit7 clear -> emit the char directly via CONOUT
1384  FF90 F2 9B FF             JP P,SIGNON_EMIT_CHAR
1385  FF93 F5                   PUSH AF
1386  FF94                      ; negative flag: fetch the prefix char from the config block (Apple $0397)
1387  FF94 3A 97 F3             LD A,($F397)
1388  FF97                      ; emit the prefix char via CONOUT
1389  FF97 CD 4C FB             CALL CONOUT_DISPATCH
1390  FF9A F1                   POP AF
1391  FF9B              ; ----------------------------------------------------------------------
1392  FF9B              ; SIGNON_EMIT_CHAR -- tail of SIGNON_EMIT: emit the original char via CONOUT. [RE]
1393  FF9B              ; ----------------------------------------------------------------------
1394  FF9B              SIGNON_EMIT_CHAR:
1395  FF9B                      ; tail-call CONOUT to emit the char
1396  FF9B C3 4C FB             JP CONOUT_DISPATCH
1397  FF9E              ; ----------------------------------------------------------------------
1398  FF9E              ; SIGNON_BANNER -- the cold-boot sign-on string, printed by SIGNON_BANNER_LOOP until $00.
1399  FF9E              ;   Reads (40-col uppercase / Videx mixed-case): CR/LF/LF/LF, '     Softcard CP/M', CR/LF,
1400  FF9E              ;   '     44K Ver. 2.23', CR/LF, '(c) 1980,1982 Microsoft', CR, LF/CR/LF, $00. DATA.
1401  FF9E              ;   NOTE: the 40-col Apple screen is uppercase-only so it renders 'SOFTCARD'; the Videx
1402  FF9E              ;   80-col card renders the mixed-case 'Softcard'. The trailing bytes from $FFE6 ($FA $E5
1403  FF9E              ;   ...) are NOT banner text -- they are an in-image copy of handler/lookup code; see flags.
1404  FF9E              ;   Twin of 2.20 SIGNON_BANNER (which reads 'Apple ][ CP/M' / '44K Ver. 2.20' /
1405  FF9E              ;   '(C) 1980 Microsoft'). [RE]
1406  FF9E              ; ----------------------------------------------------------------------
1407  FF9E              SIGNON_BANNER:
1408  FF9E 0D 0A 0A 0A          DEFB    "\r\n\n\n"
1409  FFA2 20 20 20 20          DEFB    "     Softcard CP/M"     ; string
1409  FFA6 20 53 6F 66
1409  FFAA 74 63 61 72
1409  FFAE 64 20 43 50
1409  FFB2 2F 4D
1410  FFB4 0D                   DEFB    $0D                      ; terminator
1411  FFB5 0A                   DEFB    "\n"
1412  FFB6 20 20 20 20          DEFB    "     44K Ver. 2.23"     ; string
1412  FFBA 20 34 34 4B
1412  FFBE 20 56 65 72
1412  FFC2 2E 20 32 2E
1412  FFC6 32 33
1413  FFC8 0D                   DEFB    $0D                      ; terminator
1414  FFC9 0A                   DEFB    "\n"
1415  FFCA 28 63 29 20          DEFB    "(c) 1980,1982 Microsoft" ; string
1415  FFCE 31 39 38 30
1415  FFD2 2C 31 39 38
1415  FFD6 32 20 4D 69
1415  FFDA 63 72 6F 73
1415  FFDE 6F 66 74
1416  FFE1 0D                   DEFB    $0D                      ; terminator
1417  FFE2 0A 0D 0A 00          DEFB    $0A,$0D,$0A,$00,$FA,$E5,$CD,$4C,$FB,$E1,$23,$18,$F3,$0E,$FD,$71
1417  FFE6 FA E5 CD 4C
1417  FFEA FB E1 23 18
1417  FFEE F3 0E FD 71
1418  FFF2 FD 52 FE A9          DEFB    $FD,$52,$FE,$A9,$FD,$42,$FE,$C1,$FD,$B7,$FD,$B7,$FD,$21
1418  FFF6 FD 42 FE C1
1418  FFFA FD B7 FD B7
1418  FFFE FD 21
1419  0000              BIOS_IMAGE_END:                          ; first byte past the BIOS image (wraps $10000->$0000)
1420  0000
1421  0000                  SAVEBIN "{out_bin}", $FA00, $0600
1422  0000                  IFNDEF CPM_LINK
1423  0000                  ; image size from bracketing labels; $FA00 = the ORG base (image wraps to $0000)
1424  0000                  SAVEBIN "{out_bin}", $FA00, BIOS_IMAGE_END - $FA00
1425  0000                  ENDIF
1426  0000
1427  0000              ; ----------------------------------------------------------------------
1428  0000              ; BDOS scratch overlay -- the SECOND tenant of $FEE4-$FFDB.
1429  0000              ;   Those bytes are the one-shot cold-boot / sign-on code above. It runs once at cold
1430  0000              ;   start; only afterwards does the disk system reuse them as the buffers DPH_TABLE
1431  0000              ;   hands out. The two tenants are never live at the same time.
1432  0000              ;
1433  0000              ;   The region is declared here as a LAYOUT, not as a set of magic addresses: one ORG
1434  0000              ;   at the overlay base, then one label per field with its extent carried in the
1435  0000              ;   arithmetic that advances to the next. Labels emit no bytes, so this names the
1436  0000              ;   region without writing to it -- the cold-boot code above still owns every byte of
1437  0000              ;   the image, and the ORG leaves the emitted output untouched.
1438  0000              ;
1439  0000              ;   Reference whichever tenant is live at the point of use: the cold-boot routines by
1440  0000              ;   their own labels, and these names from DPH_TABLE, which the BDOS reads long after
1441  0000              ;   cold boot has finished. The sizes are the DPB's own values, so they cannot drift
1442  0000              ;   from the DPB this BIOS publishes. Same shape and names as the 2.20-44K and
1443  0000              ;   2.23-60K twins; only the addresses and the drive count differ. [RE]
1444  0000              ; ----------------------------------------------------------------------
1445  0000              DRIVES       EQU 4                    ; four DPH entries in DPH_TABLE
1446  0000              DIRBUF_SIZE  EQU 128                  ; one 128-byte directory record
1447  0000              ALV_SIZE     EQU 139 / 8 + 1          ; = 18; 139 is DSM, the highest allocation block number
1448  0000              CSV_SIZE     EQU 12                   ; = CKS
1449  0000
1450  0000                      ORG $FEE4                     ; the one given: where the author placed the overlay
1451  FEE4              DIRBUF:                               ; shared directory buffer, one per system
1452  FEE4                      ORG DIRBUF + DIRBUF_SIZE
1453  FF64              ALV_VECTORS:                          ; per-drive allocation vectors ($FF64..)
1454  FF64                      ORG ALV_VECTORS + DRIVES * ALV_SIZE
1455  FFAC              CSV_VECTORS:                          ; per-drive checksum vectors ($FFAC..)
1456  FFAC                      ORG CSV_VECTORS + DRIVES * CSV_SIZE
1457  FFDC              BIOS_SCRATCH_END:                     ; first byte past the overlay ($FFDC)
1458  FFDC
1459  FFDC                  ; Pin the derived layout to the addresses the shipped image actually uses: change
1460  FFDC                  ; DRIVES or a size and the build fails here rather than silently moving a buffer.
1461  FFDC                  ASSERT ALV_VECTORS == $FF64
1462  FFDC                  ASSERT CSV_VECTORS == $FFAC
1463  FFDC                  ASSERT BIOS_SCRATCH_END == $FFDC
1464  FFDC
# file closed: CPM_BIOS.asm
